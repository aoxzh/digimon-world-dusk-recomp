+NdsColorLut build_swapped() {
+    NdsColorLut lut;
+    lut.size = 2;
+    lut.is_3d = true;
+    lut.title = "red/blue swap";
+    lut.data.resize(2u * 2u * 2u * 3u);
+    for (int blue = 0; blue < 2; ++blue) {
+        for (int green = 0; green < 2; ++green) {
+            for (int red = 0; red < 2; ++red) {
+                const std::size_t at =
+                    (((static_cast<std::size_t>(blue) * 2u + green) * 2u +
+                      red) *
+                     3u);
+                lut.data[at + 0u] = static_cast<float>(blue);
+                lut.data[at + 1u] = static_cast<float>(green);
+                lut.data[at + 2u] = static_cast<float>(red);
