+                         "note: this host refuses directory links, so the "
+                         "containment rule was checked as a missing file\n");
+        if (!require(count_rule(result, want) == 1 && result.files.empty()))
+            return fail("a path leaving the pack through a link is refused",
+                        describe(result));
+        ok("a path leaving the pack through a link is refused");
+
+        if (linked) {
+            const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+                first_rule(result, NdsModPackRule::PathOutsidePack);
+            if (!require(diagnostic != nullptr &&
+                         diagnostic->detail.find("outside") !=
+                             std::string::npos))
+                return fail("an escaping path is reported as outside the pack",
+                            describe(result));
+            ok("an escaping path is reported as outside the pack");
+        } else {
+            // Keep the check count stable on a host that cannot build a link.
+            if (!require(result.summary.enabled_packs == 1))
+                return fail("a missing link target only costs its entry",
+                            describe(result));
+            ok("a missing link target only costs its entry");
+        }
+    }
+
+    // ---- 11. Two packs fighting over one id. --------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-shadow", &mods))
+            return fail("the fixture made the shadow tree", "create failed");
+
+        // Created in reverse name order on purpose: the winner must come from
+        // the sort, not from the order the filesystem happens to hand back.
+        const fs::path second = make_pack(mods, "B-second");
+        const fs::path first = make_pack(mods, "A-first");
+        const std::vector<std::string> second_manifest = {
+            "[pack]", "name = \"Second\"", "id = \"second\"", "",
+            "[[file]]", "id = 7", "path = \"b.bin\"", "",
+            "[[music]]", "track = 3", "path = \"b.bin\"",
+        };
+        const std::vector<std::string> first_manifest = {
+            "[pack]", "name = \"First\"", "id = \"first\"", "",
+            "[[file]]", "id = 7", "path = \"a.bin\"", "",
+            "[[music]]", "track = 3", "path = \"a.bin\"",
+        };
+        if (!write_file(second / "b.bin", "b\n") ||
+            !write_file(first / "a.bin", "a\n") ||
+            !write_manifest(second / "mod.toml", second_manifest) ||
+            !write_manifest(first / "mod.toml", first_manifest))
+            return fail("the fixture wrote the shadow tree", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        if (!require(result.files.size() == 1 && result.music.size() == 1))
+            return fail("a contested id keeps one override", describe(result));
+        ok("a contested id keeps one override");
+
+        if (!require(result.files[0].pack == "A-first" &&
+                     result.files[0].path ==
+                         to_utf8(first / "a.bin")))
+            return fail("the first pack in name order wins a file id",
+                        describe_entries(result.files));
+        ok("the first pack in name order wins a file id");
+
+        if (!require(result.music[0].pack == "A-first"))
+            return fail("the first pack in name order wins a track",
+                        describe_entries(result.music));
+        ok("the first pack in name order wins a track");
+
+        // The player has to be able to see the fight, and which pack lost.
+        const nds_mod_packs::NdsModPackDiagnostic* shadowed =
+            first_rule(result, NdsModPackRule::ShadowedFile);
+        if (!require(shadowed != nullptr))
+            return fail("a shadowed file id is reported", describe(result));
+        ok("a shadowed file id is reported");
+
+        if (!require(shadowed->severity == NdsModPackSeverity::Warning &&
+                     shadowed->pack == "B-second" &&
+                     shadowed->line ==
+                         line_of(second_manifest, "path = \"b.bin\"") &&
+                     shadowed->detail.find("A-first") != std::string::npos))
+            return fail("a shadowed file id names both packs and its line",
+                        nds_mod_packs::nds_mod_pack_diagnostic_text(*shadowed));
+        ok("a shadowed file id names both packs and its line");
+
+        const nds_mod_packs::NdsModPackDiagnostic* shadowed_music =
+            first_rule(result, NdsModPackRule::ShadowedMusic);
+        if (!require(shadowed_music != nullptr &&
+                     shadowed_music->pack == "B-second" &&
+                     shadowed_music->detail.find("A-first") !=
+                         std::string::npos))
+            return fail("a shadowed track names both packs",
+                        describe(result));
+        ok("a shadowed track names both packs");
+
+        // Both packs are still enabled: the loser lost one entry, not the pack.
+        if (!require(result.summary.enabled_packs == 2))
+            return fail("shadowing leaves both packs enabled",
+                        std::to_string(result.summary.enabled_packs));
+        ok("shadowing leaves both packs enabled");
+    }
+
+    // ---- 12. One pack contradicting itself. ---------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-self", &mods))
+            return fail("the fixture made the self-conflict tree",
+                        "create failed");
+        const fs::path pack = make_pack(mods, "P");
+        const std::vector<std::string> manifest = {
+            "[pack]", "name = \"P\"", "id = \"p\"", "",
+            "[[file]]", "id = 5", "path = \"a.bin\"", "",
+            "[[file]]", "id = 5", "path = \"b.bin\"", "",
+            "[[music]]", "track = 9", "path = \"a.bin\"", "",
+            "[[music]]", "track = 9", "path = \"b.bin\"",
+        };
+        if (!write_file(pack / "a.bin", "a\n") ||
+            !write_file(pack / "b.bin", "b\n") ||
+            !write_manifest(pack / "mod.toml", manifest))
+            return fail("the fixture wrote the self-conflict manifest",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        if (!require(count_rule(result, NdsModPackRule::DuplicateFileId) == 1))
+            return fail("a duplicate file id in one pack is reported",
+                        describe(result));
+        ok("a duplicate file id in one pack is reported");
+
+        if (!require(count_rule(result, NdsModPackRule::DuplicateMusicTrack) ==
+                     1))
+            return fail("a duplicate track in one pack is reported",
+                        describe(result));
+        ok("a duplicate track in one pack is reported");
+
+        // The first spelling stays: a manifest is read top to bottom, so the
+        // earlier entry is the one the player wrote first.
+        if (!require(result.files.size() == 1 &&
+                     result.files[0].path == to_utf8(pack / "a.bin") &&
+                     result.music.size() == 1 &&
+                     result.music[0].path == to_utf8(pack / "a.bin")))
+            return fail("the first entry of a duplicate id wins",
+                        describe(result));
+        ok("the first entry of a duplicate id wins");
+
+        const nds_mod_packs::NdsModPackDiagnostic* duplicate =
+            first_rule(result, NdsModPackRule::DuplicateFileId);
+        const int want_line = line_of(manifest, "id = 5");
+        // The *second* occurrence is the one reported, so the line has to be
+        // the later table's, not the winner's.
+        if (!require(duplicate->line > want_line))
+            return fail("a duplicate id is reported at the later entry",
+                        std::to_string(duplicate->line) + " <= " +
+                            std::to_string(want_line));
+        ok("a duplicate id is reported at the later entry");
+
+        if (!require(result.summary.enabled_packs == 1 &&
+                     result.summary.file_overrides == 1))
+            return fail("a self-conflict leaves the pack enabled",
+                        describe(result));
+        ok("a self-conflict leaves the pack enabled");
+    }
+
+    // ---- 13. Two packs claiming the same pack id. ---------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-packid", &mods))
+            return fail("the fixture made the pack-id tree", "create failed");
+        const fs::path second = make_pack(mods, "Second");
+        const fs::path first = make_pack(mods, "First");
+        const std::vector<std::string> first_manifest = {
+            "[pack]", "name = \"One\"", "id = \"same\"", "",
+            "[[file]]", "id = 1", "path = \"a.bin\"",
+        };
+        const std::vector<std::string> second_manifest = {
+            "[pack]", "name = \"Two\"", "id = \"SAME\"", "",
+            "[[file]]", "id = 2", "path = \"b.bin\"",
+        };
+        if (!write_file(first / "a.bin", "a\n") ||
+            !write_file(second / "b.bin", "b\n") ||
+            !write_manifest(first / "mod.toml", first_manifest) ||
+            !write_manifest(second / "mod.toml", second_manifest))
+            return fail("the fixture wrote the pack-id tree", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        // Case-insensitive on purpose: two ids that differ only in case are the
+        // same pack id, and a player cannot tell them apart in a file manager.
+        if (!require(count_rule(result, NdsModPackRule::DuplicatePackId) == 1))
+            return fail("a duplicate pack id is reported", describe(result));
+        ok("a duplicate pack id is reported");
+
+        if (!require(result.summary.packs == 2 &&
+                     result.summary.enabled_packs == 1))
+            return fail("a duplicate pack id disables the later pack",
+                        describe(result));
+        ok("a duplicate pack id disables the later pack");
+
+        if (!require(result.files.size() == 1 && result.files[0].key == 1))
+            return fail("the disabled pack contributes no overrides",
+                        describe(result));
+        ok("the disabled pack contributes no overrides");
+
+        // Both directories are still listed: the player has two packs on disk.
+        if (!require(result.packs.size() == 2 && !result.packs[0].enabled ==
+                         false && result.packs[1].enabled == false))
+            return fail("a disabled pack is still listed", describe(result));
+        ok("a disabled pack is still listed");
+    }
+
+    // ---- 14. A directory that is not a pack. -------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-nomanifest", &mods))
+            return fail("the fixture made the manifest-missing tree",
+                        "create failed");
+        const fs::path pack = make_pack(mods, "Unzipped Wrong");
+        if (!write_file(pack / "readme.txt", "the manifest is missing\n"))
+            return fail("the fixture wrote the manifest-less pack",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+            first_rule(result, NdsModPackRule::DirectoryWithoutManifest);
+        if (!require(diagnostic != nullptr))
+            return fail("a directory without a manifest is recorded",
+                        describe(result));
+        ok("a directory without a manifest is recorded");
+
+        // Recorded, not fatal: this is a player who unzipped one level too
+        // deep, and the game still has to start.
+        if (!require(diagnostic->severity == NdsModPackSeverity::Warning &&
+                     result.summary.packs == 1 &&
+                     result.summary.enabled_packs == 0 &&
+                     result.summary.errors == 0))
+            return fail("a missing manifest is a warning, not a fatal error",
+                        describe(result));
+        ok("a missing manifest is a warning, not a fatal error");
+
+        if (!require(diagnostic->pack == "Unzipped Wrong" &&
+                     diagnostic->file == to_utf8(pack / "mod.toml") &&
+                     diagnostic->line == 0))
+            return fail("a missing manifest names where it was expected",
+                        nds_mod_packs::nds_mod_pack_diagnostic_text(
+                            *diagnostic));
+        ok("a missing manifest names where it was expected");
+
+        if (!require(!result.packs.empty() &&
+                     result.packs[0].directory == "Unzipped Wrong" &&
+                     !result.packs[0].enabled))
+            return fail("a manifest-less directory is listed as disabled",
+                        describe(result));
+        ok("a manifest-less directory is listed as disabled");
+    }
+
+    // ---- 15. Player names with spaces and non-ASCII. ----------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-names", &mods))
+            return fail("the fixture made the names tree", "create failed");
+
+        // "モッド" and "スプライト.bin" as explicit UTF-8 bytes, so the fixture
+        // does not depend on how this source file is stored on disk.
+        const std::string kPack = "\xE3\x83\xA2\xE3\x83\x83\xE3\x83\x89";
+        const std::string kFile = "\xE3\x82\xB9\xE3\x83\x97\xE3\x83\xA9" +
+                                  std::string("\xE3\x82\xA4\xE3\x83\x88") +
+                                  ".bin";
+        const fs::path spaced = make_pack(mods, "My Mods");
+        const fs::path unicode = make_pack(mods, kPack);
+        const std::vector<std::string> spaced_manifest = {
+            "[pack]", "name = \"My Mods\"", "id = \"my-mods\"", "",
+            "[[file]]", "id = 1", "path = \"art/great sprite.bin\"",
+        };
+        const std::vector<std::string> unicode_manifest = {
+            "[pack]",
+            std::string("name = \"") + kPack + "\"",
+            std::string("id = \"") + kPack + "\"",
+            "",
+            "[[file]]", "id = 2",
+            std::string("path = \"art/") + kFile + "\"",
+        };
+        if (!write_file(spaced / "art" / "great sprite.bin", "a\n") ||
+            !write_file(unicode / "art" / from_utf8(kFile), "b\n") ||
+            !write_manifest(spaced / "mod.toml", spaced_manifest) ||
+            !write_manifest(unicode / "mod.toml", unicode_manifest))
+            return fail("the fixture wrote the names tree", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        if (!require(result.diagnostics.empty()))
+            return fail("a space in a path is not special", describe(result));
+        ok("a space in a path is not special");
+
+        if (!require(result.files.size() == 2))
+            return fail("both named packs contribute", describe(result));
+        ok("both named packs contribute");
+
+        // Round trip: the path comes back byte-identical to the UTF-8 spelling
+        // of the file the fixture created.
+        if (!require(result.files[0].path ==
+                     to_utf8(spaced / "art" / "great sprite.bin")))
+            return fail("a path with a space round-trips",
+                        quote(result.files[0].path) + " != " +
+                            quote(to_utf8(spaced / "art" /
+                                          "great sprite.bin")));
+        ok("a path with a space round-trips");
+
+        if (!require(result.files[1].path ==
+                     to_utf8(unicode / "art" / from_utf8(kFile))))
+            return fail("a non-ASCII path round-trips",
+                        quote(result.files[1].path));
+        ok("a non-ASCII path round-trips");
+
+        if (!require(result.files[1].pack == kPack))
+            return fail("a non-ASCII pack directory round-trips",
+                        quote(result.files[1].pack));
+        ok("a non-ASCII pack directory round-trips");
+
+        // Sorted by byte order on the directory name, so "My Mods" ("M") comes
+        // before the UTF-8 bytes of "モッド" (0xE3).
+        if (!require(result.files[1].key == 2 && result.files[0].key == 1))
+            return fail("a non-ASCII directory keeps its place in the order",
+                        describe_entries(result.files));
+        ok("a non-ASCII directory keeps its place in the order");
+
+        if (!require(result.packs[0].directory == "My Mods" &&
+                     result.packs[1].name == kPack))
+            return fail("a non-ASCII pack name is readable",
+                        result.packs.empty() ? std::string("no packs")
+                                             : quote(result.packs[1].name));
+        ok("a non-ASCII pack name is readable");
+    }
+
+    // ---- 16. Determinism: creation order must not matter. ------------
+    {
+        const auto build = [](const fs::path& base, bool forward,
+                              std::string* out_root) -> bool {
+            namespace fsx = std::filesystem;
+            const fsx::path mods = base / "mods";
+            std::error_code error;
+            fsx::create_directories(mods, error);
+            if (error) return false;
+            // Mixed case on purpose. Directory iteration order is a host
+            // property -- NTFS hands entries back case-insensitively, so
+            // "apple" comes second and "Zebra" last -- while the rule the
+            // module promises is byte order. These three names disagree
+            // between the two, so the winner proves which ordering was used.
+            const std::vector<std::string> names = {"Zebra", "apple",
+                                                    "Bravo"};
+            std::vector<std::string> order = names;
+            if (!forward)
+                std::reverse(order.begin(), order.end());
+            for (const std::string& name : order) {
+                const fsx::path pack = mods / name;
+                fsx::create_directories(pack, error);
+                if (error) return false;
+                const std::vector<std::string> manifest = {
+                    "[pack]",
+                    "name = \"" + name + "\"",
+                    "id = \"" + name + "\"",
+                    "",
+                    "[[file]]",
+                    "id = 1",
+                    "path = \"shared.bin\"",
+                    "",
+                    "[[music]]",
+                    "track = 2",
+                    "path = \"shared.bin\"",
+                };
+                std::string text;
+                for (const std::string& line : manifest) {
+                    text += line;
+                    text += '\n';
+                }
+                if (!write_file(pack / "shared.bin", "x\n") ||
+                    !write_file(pack / "mod.toml", text))
+                    return false;
+            }
+            *out_root = to_utf8(base);
+            return true;
+        };
+
+        fs::path forward_root;
+        fs::path reverse_root;
+        std::string forward_text;
+        std::string reverse_text;
+        const std::string forward_name = "case-order-a";
+        const std::string reverse_name = "case-order-b";
+        if (!build(root / forward_name, true, &forward_text) ||
+            !build(root / reverse_name, false, &reverse_text))
+            return fail("the fixture built the order trees", "create failed");
+        forward_root = root / forward_name;
+        reverse_root = root / reverse_name;
+
+        const NdsModPacksResult forward =
+            load_utf8(forward_root / "mods");
+        const NdsModPacksResult reverse =
+            load_utf8(reverse_root / "mods");
+
+        // All three packs claim the same id on purpose: the winner is decided
+        // by the directory-name sort, which is exactly the thing creation order
+        // must not be able to change.
+        if (!require(forward.summary.enabled_packs == 3))
+            return fail("the order fixture enables all three packs",
+                        describe(forward));
+        ok("the order fixture enables all three packs");
+
+        if (!require(forward.diagnostics.size() == 4 &&
+                     count_rule(forward, NdsModPackRule::ShadowedFile) == 2 &&
+                     count_rule(forward, NdsModPackRule::ShadowedMusic) == 2))
+            return fail("the order fixture reports the same conflicts twice",
+                        describe(forward));
+        ok("the order fixture reports the same conflicts twice");
+
+        if (!require(forward.files.size() == 1 &&
+                     forward.music.size() == 1))
+            return fail("the order fixture has one winner per id",
+                        describe(forward));
+        ok("the order fixture has one winner per id");
+
+        // "Bravo" is first in byte order and last-but-one in the order this
+        // filesystem hands the entries back, so this is the assertion an
+        // implementation that forgot to sort cannot pass.
+        if (!require(forward.files[0].pack == "Bravo" &&
+                     forward.music[0].pack == "Bravo"))
+            return fail("the order fixture's winner is the byte-order first",
+                        describe_entries(forward.files));
+        ok("the order fixture's winner is the byte-order first");
+
+        // Same names, same winner, same diagnostics, same counts: everything a
+        // caller can see has to be equal.
+        const std::string a = dump(forward, forward_text);
+        const std::string b = dump(reverse, reverse_text);
+        if (!require(a == b))
+            return fail("directory creation order does not change the result",
+                        quote(a) + " != " + quote(b));
+        ok("directory creation order does not change the result");
+
+        // And the same tree loaded twice gives the same answer.
+        const NdsModPacksResult again =
+            load_utf8(forward_root / "mods");
+        if (!require(dump(again, forward_text) == a))
+            return fail("two loads of one tree are identical",
+                        quote(dump(again, forward_text)));
+        ok("two loads of one tree are identical");
+    }
+
+    // ---- 17. The override tables are ordered by key. -----------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-order", &mods))
+            return fail("the fixture made the key-order tree", "create failed");
+        const fs::path pack = make_pack(mods, "P");
+        const std::vector<std::string> manifest = {
+            "[pack]", "name = \"P\"", "id = \"p\"", "",
+            "[[file]]", "id = 300", "path = \"a.bin\"", "",
+            "[[file]]", "id = 2", "path = \"a.bin\"", "",
+            "[[file]]", "id = 75", "path = \"a.bin\"", "",
+            "[[music]]", "track = 40", "path = \"a.bin\"", "",
+            "[[music]]", "track = 5", "path = \"a.bin\"",
+        };
+        if (!write_file(pack / "a.bin", "x\n") ||
+            !write_manifest(pack / "mod.toml", manifest))
+            return fail("the fixture wrote the key-order manifest",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        if (!require(result.files.size() == 3))
+            return fail("every distinct file id is kept", describe(result));
+        ok("every distinct file id is kept");
+
+        // Ascending, not manifest order: a log line or a menu can then rely on
+        // the order without sorting again.
+        if (!require(result.files[0].key == 2 && result.files[1].key == 75 &&
+                     result.files[2].key == 300))
+            return fail("file overrides are sorted by content id",
+                        describe_entries(result.files));
+        ok("file overrides are sorted by content id");
+
+        if (!require(result.music[0].key == 5 && result.music[1].key == 40))
+            return fail("music overrides are sorted by track",
+                        describe_entries(result.music));
+        ok("music overrides are sorted by track");
+    }
+
+    // ---- 18. Lookups. -------------------------------------------------
+    {
+        const NdsModPacksResult empty;
+        if (!require(nds_mod_packs::nds_mod_packs_file_path(empty, 7) ==
+                     nullptr))
+            return fail("an empty table reports no file id", "non-null");
+        ok("an empty table reports no file id");
+
+        if (!require(nds_mod_packs::nds_mod_packs_music_path(empty, 7) ==
+                     nullptr))
+            return fail("an empty table reports no track", "non-null");
+        ok("an empty table reports no track");
+
+        fs::path mods;
+        if (!make_mods_dir(root, "case-lookup", &mods))
+            return fail("the fixture made the lookup tree", "create failed");
+        const fs::path pack = make_pack(mods, "P");
+        const std::vector<std::string> manifest = {
+            "[pack]", "name = \"P\"", "id = \"p\"", "",
+            "[[file]]", "id = 7", "path = \"a.bin\"", "",
+            "[[music]]", "track = 7", "path = \"a.bin\"",
+        };
+        if (!write_file(pack / "a.bin", "x\n") ||
+            !write_manifest(pack / "mod.toml", manifest))
+            return fail("the fixture wrote the lookup manifest",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        const std::string* file =
+            nds_mod_packs::nds_mod_packs_file_path(result, 7);
+        const std::string* music =
+            nds_mod_packs::nds_mod_packs_music_path(result, 7);
+        if (!require(file != nullptr && *file == to_utf8(pack / "a.bin")))
+            return fail("a file id resolves to its host path",
+                        file == nullptr ? std::string("null")
+                                        : quote(*file));
+        ok("a file id resolves to its host path");
+
+        if (!require(music != nullptr && *music == to_utf8(pack / "a.bin")))
+            return fail("a track resolves to its host path",
+                        music == nullptr ? std::string("null")
+                                         : quote(*music));
+        ok("a track resolves to its host path");
+
+        if (!require(nds_mod_packs::nds_mod_packs_file_path(result, 8) ==
+                     nullptr))
+            return fail("an unlisted file id resolves to nothing", "non-null");
+        ok("an unlisted file id resolves to nothing");
+
+        if (!require(nds_mod_packs::nds_mod_packs_music_path(result, 8) ==
+                     nullptr))
+            return fail("an unlisted track resolves to nothing", "non-null");
+        ok("an unlisted track resolves to nothing");
+
+        // The same number in the two tables is two different things: a content
+        // id and a track number never share a namespace.
+        if (!require(file != nullptr && music != nullptr))
+            return fail("file ids and tracks are separate namespaces",
+                        describe(result));
+        ok("file ids and tracks are separate namespaces");
+    }
+
+    // ---- 19. Diagnostic text. ----------------------------------------
+    {
+        nds_mod_packs::NdsModPackDiagnostic diagnostic;
+        diagnostic.severity = NdsModPackSeverity::Error;
+        diagnostic.rule = NdsModPackRule::PathMissing;
+        diagnostic.pack = "P";
+        diagnostic.file = "mods/P/mod.toml";
+        diagnostic.line = 7;
+        diagnostic.detail = "there is no file 'x.bin' in the pack";
+        const std::string full =
+            nds_mod_packs::nds_mod_pack_diagnostic_text(diagnostic);
+        if (!require(full == "error path_missing: there is no file 'x.bin' in "
+                             "the pack (mods/P/mod.toml:7)"))
+            return fail("a diagnostic renders severity, rule, detail and place",
+                        quote(full));
+        ok("a diagnostic renders severity, rule, detail and place");
+
+        // One line, always: a log file must not gain a blank line from a
+        // manifest the player wrote.
+        if (!require(full.find('\n') == std::string::npos))
+            return fail("a rendered diagnostic is one line", quote(full));
+        ok("a rendered diagnostic is one line");
+
+        diagnostic.line = 0;
+        const std::string no_line =
+            nds_mod_packs::nds_mod_pack_diagnostic_text(diagnostic);
+        if (!require(no_line == "error path_missing: there is no file 'x.bin' "
+                                "in the pack (mods/P/mod.toml)"))
+            return fail("a diagnostic without a line drops the colon",
+                        quote(no_line));
+        ok("a diagnostic without a line drops the colon");
+
+        diagnostic.file.clear();
+        const std::string bare =
+            nds_mod_packs::nds_mod_pack_diagnostic_text(diagnostic);
+        if (!require(bare == "error path_missing: there is no file 'x.bin' in "
+                             "the pack"))
+            return fail("a diagnostic with no file drops the location",
+                        quote(bare));
+        ok("a diagnostic with no file drops the location");
+
+        diagnostic.line = 12;
+        const std::string line_only =
+            nds_mod_packs::nds_mod_pack_diagnostic_text(diagnostic);
+        if (!require(line_only == "error path_missing: there is no file "
+                                  "'x.bin' in the pack (12)"))
+            return fail("a diagnostic with only a line renders the line",
+                        quote(line_only));
+        ok("a diagnostic with only a line renders the line");
+    }
+
+    // ---- 20. Every rule and severity has a stable name. ---------------
+    {
+        // The names are the tokens a log line, a test or a menu matches on, so
+        // a new rule that forgets its name has to fail here rather than show
+        // up as "unknown" in a player's log.
+        std::set<std::string> names;
+        const int rule_count =
+            static_cast<int>(NdsModPackRule::TooManyProblems) + 1;
+        bool all_named = true;
+        std::string offending;
+        for (int index = 0; index < rule_count; ++index) {
+            const char* const name = nds_mod_packs::nds_mod_pack_rule_name(
+                static_cast<NdsModPackRule>(index));
+            if (name == nullptr || *name == '\0' ||
+                std::string(name) == "unknown") {
+                all_named = false;
+                offending = std::to_string(index);
+                break;
+            }
+            names.insert(name);
+        }
+        if (!require(all_named))
+            return fail("every rule has a name",
+                        "rule index " + offending + " has none");
+        ok("every rule has a name");
+
+        if (!require(static_cast<int>(names.size()) == rule_count))
+            return fail("every rule name is distinct",
+                        std::to_string(names.size()) + " distinct of " +
+                            std::to_string(rule_count));
+        ok("every rule name is distinct");
+
+        bool shaped = true;
+        for (const std::string& name : names) {
+            for (const char ch : name) {
+                const bool legal = (ch >= 'a' && ch <= 'z') || ch == '_';
+                if (!legal) shaped = false;
+            }
+            if (name.size() > 32u) shaped = false;
+        }
+        if (!require(shaped))
+            return fail("a rule name is lowercase and underscore-joined",
+                        "a name uses another character or is over-long");
+        ok("a rule name is lowercase and underscore-joined");
+
+        const char* const warning =
+            nds_mod_packs::nds_mod_pack_severity_name(
+                NdsModPackSeverity::Warning);
+        const char* const error =
+            nds_mod_packs::nds_mod_pack_severity_name(
+                NdsModPackSeverity::Error);
+        if (!require(warning != nullptr && std::string(warning) == "warning"))
+            return fail("a warning is spelled 'warning'",
+                        warning == nullptr ? "null" : quote(warning));
+        ok("a warning is spelled 'warning'");
+
+        if (!require(error != nullptr && std::string(error) == "error"))
+            return fail("an error is spelled 'error'",
+                        error == nullptr ? "null" : quote(error));
+        ok("an error is spelled 'error'");
+
+        if (!require(warning != nullptr && error != nullptr &&
+                     std::string(warning) != std::string(error)))
+            return fail("the two severities are spelled differently", "same");
+        ok("the two severities are spelled differently");
+    }
+
+    // ---- 21. The summary agrees with the vectors. --------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-summary", &mods))
+            return fail("the fixture made the summary tree", "create failed");
+        const fs::path good = make_pack(mods, "Good");
+        const fs::path bad = make_pack(mods, "Bad");
+        const fs::path gone = make_pack(mods, "Gone");
+        const std::vector<std::string> good_manifest = {
+            "[pack]", "name = \"Good\"", "id = \"good\"", "",
+            "[[file]]", "id = 1", "path = \"a.bin\"", "",
+            "[[file]]", "id = 2", "path = \"missing.bin\"", "",
+            "[[music]]", "track = 1", "path = \"a.bin\"",
+        };
+        const std::vector<std::string> bad_manifest = {
+            "[pack]", "name = \"Bad\"", "id = \"bad\"", "[[file]]", "id = 1",
+        };
+        if (!write_file(good / "a.bin", "x\n") ||
+            !write_manifest(good / "mod.toml", good_manifest) ||
+            !write_manifest(bad / "mod.toml", bad_manifest) ||
+            !write_file(gone / "readme.txt", "no manifest\n"))
+            return fail("the fixture wrote the summary tree", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        if (!require(result.summary.packs == 3))
+            return fail("the summary counts every subdirectory",
+                        std::to_string(result.summary.packs));
+        ok("the summary counts every subdirectory");
+
+        if (!require(result.summary.enabled_packs == 1))
+            return fail("the summary counts only usable packs",
+                        std::to_string(result.summary.enabled_packs));
+        ok("the summary counts only usable packs");
+
+        if (!require(result.summary.file_overrides == 1 &&
+                     result.summary.music_overrides == 1))
+            return fail("the summary counts the surviving overrides",
+                        describe(result));
+        ok("the summary counts the surviving overrides");
+
+        if (!require(result.summary.warnings ==
+                         count_severity(result, NdsModPackSeverity::Warning) &&
+                     result.summary.errors ==
+                         count_severity(result, NdsModPackSeverity::Error)))
+            return fail("the summary agrees with the diagnostic list",
+                        describe(result));
+        ok("the summary agrees with the diagnostic list");
+
+        // Three things went wrong: one stale path, one rejected manifest, one
+        // missing manifest. Nothing else may be added to that count.
+        if (!require(result.summary.errors == 2 &&
+                     result.summary.warnings == 1))
+            return fail("the summary counts one problem per problem",
+                        describe(result));
+        ok("the summary counts one problem per problem");
+
+        // A rejected pack must not take the good one down with it.
+        if (!require(result.files.size() == 1 && result.files[0].key == 1))
+            return fail("one broken pack does not stop the others",
+                        describe(result));
+        ok("one broken pack does not stop the others");
+    }
+
+    // ---- 22. Volume limits. ------------------------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-huge", &mods))
+            return fail("the fixture made the size tree", "create failed");
+        const fs::path pack = make_pack(mods, "Huge");
+        std::string huge = "[pack]\nname = \"Huge\"\nid = \"huge\"\n";
+        // Comments, so the file is big without being a parse problem: this
+        // tests the size limit, not the gorwth of the diagnostic list.
+        huge += std::string(1024u * 1024u + 1u, '#');
+        huge += '\n';
+        if (!write_file(pack / "mod.toml", huge))
+            return fail("the fixture wrote an oversized manifest",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        if (!require(count_rule(result, NdsModPackRule::ManifestTooLarge) == 1))
+            return fail("an oversized manifest is refused, not read",
+                        describe(result));
+        ok("an oversized manifest is refused, not read");
+
+        if (!require(result.summary.enabled_packs == 0))
+            return fail("an oversized manifest does not enable its pack",
+                        describe(result));
+        ok("an oversized manifest does not enable its pack");
+
+        // A single line longer than any real manifest line: the parser refuses
+        // it by line number instead of building a multi-megabyte string.
+        fs::path long_mods;
+        if (!make_mods_dir(root, "case-longline", &long_mods))
+            return fail("the fixture made the long-line tree", "create failed");
+        const fs::path long_pack = make_pack(long_mods, "Long");
+        const std::vector<std::string> long_manifest = {
+            "[pack]",
+            "name = \"Long\"",
+            "id = \"long\"",
+            std::string(5000u, 'x'),
+        };
+        if (!write_manifest(long_pack / "mod.toml", long_manifest))
+            return fail("the fixture wrote a long line", "write failed");
+
+        const NdsModPacksResult long_result = load_utf8(long_mods);
+        const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+            first_rule(long_result, NdsModPackRule::ManifestSyntax);
+        if (!require(diagnostic != nullptr))
+            return fail("an over-long line is a syntax error",
+                        describe(long_result));
+        ok("an over-long line is a syntax error");
+
+        if (!require(diagnostic->line == 4))
+            return fail("an over-long line names its line",
+                        std::to_string(diagnostic->line));
+        ok("an over-long line names its line");
+    }
+
+    // ---- 23. A file named mod.toml that is a directory. --------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-manifest-dir", &mods))
+            return fail("the fixture made the manifest-directory tree",
+                        "create failed");
+        const fs::path pack = make_pack(mods, "P");
+        std::error_code error;
+        fs::create_directories(pack / "mod.toml", error);
+        if (error)
+            return fail("the fixture made a mod.toml directory",
+                        "create failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        // Not a manifest and not a parse problem: the same "you have no
+        // manifest here" warning, because that is what the player has.
+        if (!require(count_rule(result,
+                                NdsModPackRule::DirectoryWithoutManifest) == 1))
+            return fail("a directory called mod.toml is not a manifest",
+                        describe(result));
+        ok("a directory called mod.toml is not a manifest");
+
+        if (!require(result.summary.enabled_packs == 0 &&
+                     result.summary.errors == 0))
+            return fail("a directory called mod.toml is not an error",
+                        describe(result));
+        ok("a directory called mod.toml is not an error");
+    }
+
+    // ---- 24. The resolve helper a tool can call without a load. ------
+    {
+        fs::path pack_dir = root / "case-helper" / "P";
+        std::error_code error;
+        fs::create_directories(pack_dir / "sub", error);
+        if (error || !write_file(pack_dir / "a.bin", "x\n"))
+            return fail("the fixture made the helper tree", "create failed");
+
+        std::string resolved;
+        nds_mod_packs::NdsModPackRule rule =
+            NdsModPackRule::ManifestSyntax;
+        std::string detail;
+        const bool accepted = nds_mod_packs::nds_mod_pack_resolve_path(
+            to_utf8(pack_dir), "sub/../a.bin", &resolved, &rule, &detail);
+        // A ".." that stays inside the pack is still a traversal: the rule is
+        // lexical on purpose, so a pack authored to look one level up is
+        // refused even when it happens to be harmless.
+        if (!require(!accepted &&
+                     rule == NdsModPackRule::PathParentTraversal))
+            return fail("the helper refuses '..' even when it stays inside",
+                        quote(detail));
+        ok("the helper refuses '..' even when it stays inside");
+
+        const bool dotted = nds_mod_packs::nds_mod_pack_resolve_path(
+            to_utf8(pack_dir), "./a.bin", &resolved, &rule, &detail);
+        if (!require(dotted &&
+                     resolved == to_utf8(pack_dir / "a.bin")))
+            return fail("the helper normalises a './' prefix",
+                        dotted ? quote(resolved) : quote(detail));
+        ok("the helper normalises a './' prefix");
+
+        // A doubled separator is not an escape and normalises away.
+        const bool doubled = nds_mod_packs::nds_mod_pack_resolve_path(
+            to_utf8(pack_dir), "sub//inside.bin", nullptr, nullptr, nullptr);
+        if (!require(!doubled))
+            return fail("the helper reports a missing file as refused",
+                        "accepted a file that does not exist");
+        ok("the helper reports a missing file as refused");
+
+        if (!write_file(pack_dir / "sub" / "inside.bin", "y\n"))
+            return fail("the fixture wrote the nested file", "write failed");
+        const bool nested = nds_mod_packs::nds_mod_pack_resolve_path(
+            to_utf8(pack_dir), "sub//inside.bin", &resolved, &rule, &detail);
+        if (!require(nested &&
+                     resolved == to_utf8(pack_dir / "sub" / "inside.bin")))
+            return fail("the helper accepts a file below the pack",
+                        nested ? quote(resolved) : quote(detail));
+        ok("the helper accepts a file below the pack");
+    }
+
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// tried first, but a sandboxed run can refuse writes there, so the working
+// directory is tried second. Returns false only when neither location can hold
+// the tree, and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    namespace fs = std::filesystem;
+    const auto stamp = std::chrono::steady_clock::now()
+                           .time_since_epoch().count();
+    fs::path root;
+    if (!create_root("nds-mod-packs-test", std::to_string(stamp), &root))
+        return 1;
+
+    // Checks live in run_checks() so the temporary tree is removed on every
+    // exit path, including a failing one.
+    const int result = run_checks(root);
+    if (result == 0) std::printf("%d checks passed\n", g_checks);
+    std::error_code cleanup_error;
+    fs::remove_all(root, cleanup_error);
+    return result;
+}
diff --git a/runner/tests/nitrofs_test.cpp b/runner/tests/nitrofs_test.cpp
new file mode 100644
index 0000000..005a160
--- /dev/null
+++ b/runner/tests/nitrofs_test.cpp
@@ -0,0 +1,2399 @@
+// Pins the cartridge file table reader (nitrofs.h) and its override copy.
+//
+// The module exists for one job: take a game file the cartridge already
+// contains and put different bytes in its place, without moving anything. What
+// can go wrong is therefore not "the feature is missing" but "a player's mod
+// silently corrupts the cartridge", so the properties pinned here are:
+//
+//   * A hand-built file table is read to the exact byte range the allocation
+//     table gives, for the exact id the name table assigns. File ids are
+//     declared per directory and are NOT assumed to start at zero: the real
+//     cartridge gives ids 0..5 to the ARM9 overlays and starts naming files at
+//     6, so a reader that counted from zero would name the wrong file.
+//   * Nothing that a corrupted image can say is trusted. A cycle, a repeated
+//     directory, a name that runs off the end, an offset outside the image and
+//     an id outside the allocation table are each reported and each leave the
+//     rest readable, because a mod ROM that half-parses must not take the game
+//     down with it.
+//   * An override never changes a file's length. A longer replacement is
+//     refused by name and by size; a shorter one leaves the bytes it did not
+//     cover untouched. That is the entire safety argument for writing into a
+//     live cartridge image.
+//
+// The images here are built in memory rather than read from a cartridge, so
+// the test runs anywhere and every offset in it is a number the test chose.
+// Each assertion has its own nonzero return code and prints OK/FAIL with a
+// one-line detail, so a failure names itself without a debugger.
+
+#include "nitrofs.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace {
+
+namespace fs = std::filesystem;
+using nds_nitrofs::NdsNitroFs;
+using nds_nitrofs::NdsNitroFsDiagnostic;
+using nds_nitrofs::NdsNitroFsEntry;
+using nds_nitrofs::NdsNitroFsRule;
+
+int g_checks = 0;
+
+bool require(bool value) {
+    return value;
+}
+
+void ok(const char* name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name);
+}
+
+// Prints the failing check plus its detail and yields that check's exit code,
+// which is the ordinal of the check so it points at the OK numbering.
+int fail(const char* name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name, detail.c_str());
+    return g_checks + 1;
+}
+
+std::string number_text(std::uint64_t value) {
+    return std::to_string(value);
+}
+
+std::string hex_text(std::uint64_t value) {
+    std::string text = "0x";
+    if (value == 0u) return text + "0";
+    char digits[17] = {};
+    int count = 0;
+    while (value != 0u) {
+        const int digit = static_cast<int>(value & 0xFu);
+        digits[count++] =
+            static_cast<char>(digit < 10 ? '0' + digit : 'A' + digit - 10);
+        value >>= 4u;
+    }
+    while (count > 0) text.push_back(digits[--count]);
+    return text;
+}
+
+// Escapes a string so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\n') {
+            out += "\\n";
+        } else if (ch == '\r') {
+            out += "\\r";
+        } else if (ch == '\t') {
+            out += "\\t";
+        } else {
+            out.push_back(ch);
+        }
+    }
+    out += '"';
+    return out;
+}
+
+std::string describe(const NdsNitroFs& filesystem) {
+    std::string out = "ok=" + number_text(filesystem.ok ? 1u : 0u);
+    out += " files=" + number_text(filesystem.files.size());
+    out +=
+        " dirs=" + number_text(static_cast<std::uint64_t>(
+                     filesystem.directories));
+    out += " fat=" +
+           number_text(static_cast<std::uint64_t>(filesystem.fat_entries));
+    out += " diagnostics=[";
+    for (std::size_t i = 0; i < filesystem.diagnostics.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += nds_nitrofs::nitrofs_diagnostic_text(filesystem.diagnostics[i]);
+    }
+    out += "] files=[";
+    for (std::size_t i = 0; i < filesystem.files.size(); ++i) {
+        if (i != 0u) out += ", ";
+        const NdsNitroFsEntry& entry = filesystem.files[i];
+        out += number_text(static_cast<std::uint64_t>(entry.id));
+        out += ":";
+        out += quote(entry.path);
+        out += "@";
+        out += hex_text(entry.offset);
+        out += "+";
+        out += hex_text(entry.size);
+    }
+    out += "]";
+    return out;
+}
+
+const NdsNitroFsDiagnostic* first_rule(const NdsNitroFs& filesystem,
+                                       NdsNitroFsRule rule) {
+    for (const NdsNitroFsDiagnostic& diagnostic : filesystem.diagnostics) {
+        if (diagnostic.rule == rule) return &diagnostic;
+    }
+    return nullptr;
+}
+
+int count_rule(const NdsNitroFs& filesystem, NdsNitroFsRule rule) {
+    int count = 0;
+    for (const NdsNitroFsDiagnostic& diagnostic : filesystem.diagnostics) {
+        if (diagnostic.rule == rule) ++count;
+    }
+    return count;
+}
+
+// Every rule the header declares, so a section can loop over all of them
+// without a hand-copied list drifting out of date.
+std::vector<NdsNitroFsRule> all_rules() {
+    return {
+        NdsNitroFsRule::Unknown,
+        NdsNitroFsRule::ImageTooSmall,
+        NdsNitroFsRule::FileTableOutsideImage,
+        NdsNitroFsRule::FileTableEmpty,
+        NdsNitroFsRule::DirectoryTableTruncated,
+        NdsNitroFsRule::DirectoryOutsideFileTable,
+        NdsNitroFsRule::DirectoryUnterminated,
+        NdsNitroFsRule::DirectoryCycle,
+        NdsNitroFsRule::DirectoryRepeated,
+        NdsNitroFsRule::DirectoryTooDeep,
+        NdsNitroFsRule::EmptyName,
+        NdsNitroFsRule::InvalidName,
+        NdsNitroFsRule::DuplicatePath,
+        NdsNitroFsRule::FileIdOutOfRange,
+        NdsNitroFsRule::DuplicateFileId,
+        NdsNitroFsRule::FatOutsideImage,
+        NdsNitroFsRule::FatSizeNotMultipleOfEight,
+        NdsNitroFsRule::FatEmpty,
+        NdsNitroFsRule::FatEntryOutsideImage,
+        NdsNitroFsRule::FatEntryEmpty,
+        NdsNitroFsRule::TooManyFiles,
+        NdsNitroFsRule::TooManyProblems,
+    };
+}
+
+// ---------------------------------------------------------------------------
+// A cartridge image built in memory.
+//
+// Two tables matter here: the name table (FNT), a directory tree, and the
+// allocation table (FAT), which maps a file id to a byte range. The builder
+// writes both from a small tree description, so every offset in a test image
+// is a number the test chose and can assert on exactly.
+// ---------------------------------------------------------------------------
+
+struct FileSpec {
+    std::string name;
+    int id = 0;
+    std::uint32_t size = 0;
+    std::uint8_t fill = 0;
+    // When true the allocation table entry is whatever the test asked for,
+    // instead of the range the builder chose.
+    bool override_range = false;
+    std::uint32_t override_start = 0;
+    std::uint32_t override_stop = 0;
+};
+
+struct DirSpec {
+    std::string name;
+    std::vector<FileSpec> files;
+    std::vector<DirSpec> dirs;
+};
+
+struct RomSpec {
+    DirSpec root;
+    // Empty directories that nothing reaches, so a test can point a bad
+    // reference at a target whose own entry looks legal.
+    int extra_directories = 0;
+    // Image size in bytes; zero means "just large enough".
+    std::uint32_t image_size = 0;
+};
+
+struct BuiltRom {
+    std::vector<std::uint8_t> image;
+    std::uint32_t fnt_offset = 0;
+    std::uint32_t fnt_size = 0;
+    std::uint32_t fat_offset = 0;
+    std::uint32_t fat_entries = 0;
+    std::uint32_t directory_count = 0;
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> fat;
+};
+
+void put_u32(std::vector<std::uint8_t>* image, std::size_t at,
+             std::uint32_t value) {
+    (*image)[at + 0] = static_cast<std::uint8_t>(value & 0xFFu);
+    (*image)[at + 1] = static_cast<std::uint8_t>((value >> 8u) & 0xFFu);
+    (*image)[at + 2] = static_cast<std::uint8_t>((value >> 16u) & 0xFFu);
+    (*image)[at + 3] = static_cast<std::uint8_t>((value >> 24u) & 0xFFu);
+}
+
+void put_u16(std::vector<std::uint8_t>* image, std::size_t at,
+             std::uint16_t value) {
+    (*image)[at + 0] = static_cast<std::uint8_t>(value & 0xFFu);
+    (*image)[at + 1] = static_cast<std::uint8_t>((value >> 8u) & 0xFFu);
+}
+
+std::uint32_t read_u32_at(const std::vector<std::uint8_t>& image,
+                          std::size_t at) {
+    return static_cast<std::uint32_t>(image[at]) |
+           (static_cast<std::uint32_t>(image[at + 1]) << 8u) |
+           (static_cast<std::uint32_t>(image[at + 2]) << 16u) |
+           (static_cast<std::uint32_t>(image[at + 3]) << 24u);
+}
+
+std::uint32_t align_up(std::uint32_t value, std::uint32_t alignment) {
+    const std::uint32_t remainder = value % alignment;
+    return remainder == 0u ? value : value + (alignment - remainder);
+}
+
+void collect_directories(DirSpec* directory, int index,
+                         std::vector<DirSpec*>* order,
+                         std::vector<std::vector<int>>* children) {
+    if (static_cast<std::size_t>(index) >= order->size()) {
+        order->resize(static_cast<std::size_t>(index) + 1u);
+    }
+    (*order)[static_cast<std::size_t>(index)] = directory;
+    if (children->size() < order->size()) children->resize(order->size());
+    std::vector<int> mine;
+    for (DirSpec& child : directory->dirs) {
+        const int child_index = static_cast<int>(order->size());
+        order->push_back(nullptr);
+        mine.push_back(child_index);
+        collect_directories(&child, child_index, order, children);
+    }
+    (*children)[static_cast<std::size_t>(index)] = mine;
+    if (children->size() < order->size()) children->resize(order->size());
+}
+
+std::vector<std::uint8_t> encode_subtable(
+    const DirSpec& directory, const std::vector<int>& child_indices) {
+    std::vector<std::uint8_t> bytes;
+    for (const FileSpec& file : directory.files) {
+        bytes.push_back(static_cast<std::uint8_t>(file.name.size()));
+        for (const char ch : file.name)
+            bytes.push_back(static_cast<std::uint8_t>(ch));
+    }
+    for (std::size_t i = 0; i < directory.dirs.size(); ++i) {
+        const DirSpec& child = directory.dirs[i];
+        bytes.push_back(
+            static_cast<std::uint8_t>(0x80u | (child.name.size() & 0x7Fu)));
+        for (const char ch : child.name)
+            bytes.push_back(static_cast<std::uint8_t>(ch));
+        const std::uint16_t reference = static_cast<std::uint16_t>(
+            0xF000u | static_cast<std::uint16_t>(child_indices[i]));
+        bytes.push_back(static_cast<std::uint8_t>(reference & 0xFFu));
+        bytes.push_back(static_cast<std::uint8_t>((reference >> 8u) & 0xFFu));
+    }
+    bytes.push_back(0u);
+    return bytes;
+}
+
+BuiltRom build_rom(const RomSpec& spec) {
+    std::vector<DirSpec*> order;
+    std::vector<std::vector<int>> children;
+    order.push_back(nullptr);
+    children.resize(1);
+    DirSpec* root = const_cast<DirSpec*>(&spec.root);
+    collect_directories(root, 0, &order, &children);
+
+    // Unreachable directories exist so a bad reference has a legal-looking
+    // target index to point at; they are ordinary empty directories.
+    for (int i = 0; i < spec.extra_directories; ++i) order.push_back(nullptr);
+    if (children.size() < order.size()) children.resize(order.size());
+
+    const std::uint32_t directory_count =
+        static_cast<std::uint32_t>(order.size());
+    const std::uint32_t directory_table_size = directory_count * 8u;
+
+    std::vector<std::vector<std::uint8_t>> subtables(order.size());
+    for (std::size_t i = 0; i < order.size(); ++i) {
+        if (order[i] == nullptr) {
+            subtables[i].push_back(0u);
+            continue;
+        }
+        subtables[i] = encode_subtable(*order[i], children[i]);
+    }
+
+    BuiltRom built;
+    built.fnt_offset = 0x200u;
+    built.directory_count = directory_count;
+    std::vector<std::uint32_t> subtable_offsets(order.size(), 0u);
+    std::uint32_t cursor = directory_table_size;
+    for (std::size_t i = 0; i < order.size(); ++i) {
+        subtable_offsets[i] = cursor;
+        cursor += static_cast<std::uint32_t>(subtables[i].size());
+    }
+    built.fnt_size = cursor;
+    built.fat_offset = align_up(built.fnt_offset + built.fnt_size, 0x10u);
+
+    int max_id = -1;
+    std::vector<const FileSpec*> all_files;
+    for (std::size_t i = 0; i < order.size(); ++i) {
+        if (order[i] == nullptr) continue;
+        for (const FileSpec& file : order[i]->files) {
+            if (file.id > max_id) max_id = file.id;
+            all_files.push_back(&file);
+        }
+    }
+    built.fat_entries = static_cast<std::uint32_t>(max_id + 1);
+    if (built.fat_entries == 0u) built.fat_entries = 1u;
+
+    std::uint32_t data_cursor =
+        align_up(built.fat_offset + built.fat_entries * 8u, 0x10u);
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> ranges;
+    ranges.reserve(all_files.size());
+    for (const FileSpec* file : all_files) {
+        ranges.emplace_back(data_cursor, data_cursor + file->size);
+        data_cursor = align_up(data_cursor + file->size, 0x10u);
+    }
+    std::uint32_t image_size = data_cursor + 0x10u;
+    if (spec.image_size > image_size) image_size = spec.image_size;
+
+    built.image.assign(image_size, 0u);
+    const char title[] = "SYNTHETIC";
+    std::memcpy(built.image.data(), title, sizeof(title) - 1);
+    put_u32(&built.image, 0x40u, built.fnt_offset);
+    put_u32(&built.image, 0x44u, built.fnt_size);
+    put_u32(&built.image, 0x48u, built.fat_offset);
+    put_u32(&built.image, 0x4Cu, built.fat_entries * 8u);
+
+    put_u32(&built.image, built.fnt_offset, directory_table_size);
+    for (std::size_t i = 0; i < order.size(); ++i) {
+        const std::size_t at = built.fnt_offset + i * 8u;
+        put_u32(&built.image, at, subtable_offsets[i]);
+        int first_file = 0;
+        std::uint16_t parent = 0xF000u;
+        if (order[i] != nullptr && !order[i]->files.empty()) {
+            first_file = order[i]->files[0].id;
+        }
+        if (i == 0u) {
+            parent = static_cast<std::uint16_t>(directory_count);
+        }
+        put_u16(&built.image, at + 4u,
+                static_cast<std::uint16_t>(first_file));
+        put_u16(&built.image, at + 6u, parent);
+    }
+    for (std::size_t i = 0; i < order.size(); ++i) {
+        std::memcpy(built.image.data() + built.fnt_offset + subtable_offsets[i],
+                    subtables[i].data(), subtables[i].size());
+    }
+
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> entries(
+        built.fat_entries, std::make_pair(0u, 0u));
+    for (std::size_t i = 0; i < all_files.size(); ++i) {
+        const FileSpec& file = *all_files[i];
+        std::pair<std::uint32_t, std::uint32_t> range = ranges[i];
+        if (file.override_range) {
+            range = std::make_pair(file.override_start, file.override_stop);
+        }
+        if (file.id >= 0 &&
+            static_cast<std::uint32_t>(file.id) < built.fat_entries) {
+            entries[static_cast<std::size_t>(file.id)] = range;
+        }
+    }
+    for (std::uint32_t i = 0; i < built.fat_entries; ++i) {
+        const std::size_t at = built.fat_offset + i * 8u;
+        put_u32(&built.image, at, entries[i].first);
+        put_u32(&built.image, at + 4u, entries[i].second);
+    }
+
+    for (std::size_t i = 0; i < all_files.size(); ++i) {
+        const FileSpec& file = *all_files[i];
+        if (file.override_range) continue;
+        const std::pair<std::uint32_t, std::uint32_t> range = ranges[i];
+        if (range.second > image_size) continue;
+        for (std::uint32_t at = range.first; at < range.second; ++at) {
+            built.image[at] = static_cast<std::uint8_t>(
+                file.fill + static_cast<std::uint8_t>(at - range.first));
+        }
+    }
+    built.fat = entries;
+    return built;
+}
+
+// The image most tests start from: a root with one file and a subdirectory
+// with two, which is the smallest tree where a file id can only be right if
+// the declared first id is honoured rather than counted from zero.
+//
+//   TITLE.BIN       id 0
+//   DATA/ONE.BIN    id 1
+//   DATA/TWO.BIN    id 2
+RomSpec basic_spec() {
+    RomSpec spec;
+    spec.root.files.push_back(FileSpec{"TITLE.BIN", 0, 16u, 0x10u});
+    DirSpec data;
+    data.name = "DATA";
+    data.files.push_back(FileSpec{"ONE.BIN", 1, 32u, 0x20u});
+    data.files.push_back(FileSpec{"TWO.BIN", 2, 8u, 0x30u});
+    spec.root.dirs.push_back(data);
+    return spec;
+}
+
+// The shape the real cartridge has: the first ids belong to something the file
+// table does not name (the ARM9 overlays), so the root declares first id 3.
+//
+//   MAIN.BIN        id 3
+//   MSG/PAK00.PAK   id 4
+RomSpec overlay_spec() {
+    RomSpec spec;
+    spec.root.files.push_back(FileSpec{"MAIN.BIN", 3, 24u, 0x40u});
+    DirSpec msg;
+    msg.name = "MSG";
+    msg.files.push_back(FileSpec{"PAK00.PAK", 4, 12u, 0x50u});
+    spec.root.dirs.push_back(msg);
+    return spec;
+}
+
+std::uint32_t subtable_of(const BuiltRom& built, int directory) {
+    return read_u32_at(built.image,
+                       built.fnt_offset +
+                           static_cast<std::size_t>(directory) * 8u);
+}
+
+// Overwrite the u16 reference of the `ordinal`-th subdirectory named in a
+// subtable. Used to build the malformed trees a hostile image would have.
+bool patch_child_reference(BuiltRom* built, std::uint32_t subtable, int ordinal,
+                           std::uint16_t reference) {
+    std::size_t position = subtable;
+    int seen = 0;
+    while (position < built->fnt_size) {
+        const std::uint8_t type = built->image[built->fnt_offset + position];
+        if (type == 0u) return false;
+        const std::size_t length =
+            static_cast<std::size_t>(type & 0x7Fu);
+        position += 1u + length;
+        if ((type & 0x80u) == 0u) continue;
+        if (position + 2u > built->fnt_size) return false;
+        if (seen == ordinal) {
+            put_u16(&built->image, built->fnt_offset + position, reference);
+            return true;
+        }
+        ++seen;
+        position += 2u;
+    }
+    return false;
+}
+
+void patch_directory_subtable(BuiltRom* built, int directory,
+                              std::uint32_t value) {
+    const std::size_t at =
+        built->fnt_offset + static_cast<std::size_t>(directory) * 8u;
+    put_u32(&built->image, at, value);
+}
+
+void patch_directory_first_file(BuiltRom* built, int directory,
+                                std::uint16_t value) {
+    const std::size_t at =
+        built->fnt_offset + static_cast<std::size_t>(directory) * 8u + 4u;
+    put_u32(&built->image, at, value);
+}
+
+NdsNitroFs parse_of(const BuiltRom& built) {
+    return nds_nitrofs::nitrofs_parse(built.image.data(), built.image.size());
+}
+
+std::vector<std::uint8_t> bytes_of(const std::string& text) {
+    return std::vector<std::uint8_t>(text.begin(), text.end());
+}
+
+std::string show(const std::vector<std::string>& lines) {
+    std::string out = "[";
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += quote(lines[i]);
+    }
+    out += ']';
+    return out;
+}
+
+std::vector<std::uint8_t> read_range(const std::vector<std::uint8_t>& image,
+                                     std::uint32_t offset,
+                                     std::uint32_t length) {
+    std::vector<std::uint8_t> bytes;
+    if (static_cast<std::uint64_t>(offset) + length > image.size()) {
+        return bytes;
+    }
+    bytes.assign(image.begin() + offset, image.begin() + offset + length);
+    return bytes;
+}
+
+bool same_bytes(const std::vector<std::uint8_t>& left,
+                const std::vector<std::uint8_t>& right) {
+    if (left.size() != right.size()) return false;
+    for (std::size_t i = 0; i < left.size(); ++i) {
+        if (left[i] != right[i]) return false;
+    }
+    return true;
+}
+
+// A file name that differs from a legal one only in the byte handed in, so a
+// name-rule test can say exactly which byte it objects to.
+std::string name_with(char byte) {
+    std::string name = "BAD";
+    name.push_back(byte);
+    name += "NAME.BIN";
+    return name;
+}
+
+// A scratch directory, with a one-line note if TEMP is unusable.
+fs::path create_root() {
+    std::error_code error;
+    const fs::path temporary = fs::temp_directory_path(error);
+    if (!error) {
+        const fs::path root = temporary / "nitrofs_test_scratch";
+        fs::remove_all(root, error);
+        error.clear();
+        fs::create_directories(root, error);
+        if (!error) return root;
+    }
+    const fs::path here = fs::current_path(error);
+    const fs::path root = here / "nitrofs_test_scratch";
+    fs::remove_all(root, error);
+    fs::create_directories(root, error);
+    std::printf("note: using %s as the scratch directory\n",
+                root.string().c_str());
+    return root;
+}
+
+bool write_file(const fs::path& path, const std::vector<std::uint8_t>& bytes) {
+    std::error_code error;
+    fs::create_directories(path.parent_path(), error);
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    if (!file) return false;
+    if (!bytes.empty()) {
+        file.write(reinterpret_cast<const char*>(bytes.data()),
+                   static_cast<std::streamsize>(bytes.size()));
+    }
+    return static_cast<bool>(file);
+}
+
+int run_checks(const fs::path& root) {
+    // ---- 1. The image the other sections are built on. --------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        if (!require(built.image.size() == 0x2B0u))
+            return fail("the fixture image is the size the layout implies",
+                        hex_text(built.image.size()));
+        ok("the fixture image is the size the layout implies");
+
+        if (!require(built.fat_offset == 0x240u))
+            return fail("the fixture allocation table sits where the layout "
+                        "says",
+                        hex_text(built.fat_offset));
+        ok("the fixture allocation table sits where the layout says");
+
+        if (!require(built.fat.size() == 3u))
+            return fail("the fixture has one allocation entry per file id",
+                        number_text(built.fat.size()));
+        ok("the fixture has one allocation entry per file id");
+
+        if (!require(built.fat[0].first == 0x260u &&
+                     built.fat[0].second == 0x270u))
+            return fail("the first fixture file occupies 0x260..0x270",
+                        hex_text(built.fat[0].first) + ".." +
+                            hex_text(built.fat[0].second));
+        ok("the first fixture file occupies 0x260..0x270");
+
+        if (!require(built.fat[2].first == 0x290u &&
+                     built.fat[2].second == 0x298u))
+            return fail("the last fixture file occupies 0x290..0x298",
+                        hex_text(built.fat[2].first) + ".." +
+                            hex_text(built.fat[2].second));
+        ok("the last fixture file occupies 0x290..0x298");
+    }
+
+    // ---- 2. The well-formed tree. ----------------------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+
+        if (!require(parsed.ok))
+            return fail("a well-formed image parses without complaint",
+                        describe(parsed));
+        ok("a well-formed image parses without complaint");
+
+        if (!require(parsed.diagnostics.empty()))
+            return fail("a well-formed image yields no diagnostics",
+                        describe(parsed));
+        ok("a well-formed image yields no diagnostics");
+
+        if (!require(parsed.files.size() == 3u))
+            return fail("every named file is listed", describe(parsed));
+        ok("every named file is listed");
+
+        if (!require(parsed.fat_entries == 3))
+            return fail("the allocation table entry count is reported",
+                        describe(parsed));
+        ok("the allocation table entry count is reported");
+
+        if (!require(parsed.directories == 2))
+            return fail("the directories are counted as they are walked",
+                        describe(parsed));
+        ok("the directories are counted as they are walked");
+
+        if (!require(parsed.files[0].path == "TITLE.BIN" &&
+                     parsed.files[0].id == 0))
+            return fail("the root's file is named and numbered",
+                        describe(parsed));
+        ok("the root's file is named and numbered");
+
+        if (!require(parsed.files[1].path == "DATA/ONE.BIN" &&
+                     parsed.files[1].id == 1))
+            return fail("a subdirectory file carries its directory in the path",
+                        describe(parsed));
+        ok("a subdirectory file carries its directory in the path");
+
+        if (!require(parsed.files[2].path == "DATA/TWO.BIN" &&
+                     parsed.files[2].id == 2))
+            return fail("the second subdirectory file is numbered next",
+                        describe(parsed));
+        ok("the second subdirectory file is numbered next");
+
+        // The id is the index into the allocation table, so the byte range has
+        // to be the one that table gives -- not one derived from the name.
+        if (!require(parsed.files[0].offset == built.fat[0].first &&
+                     parsed.files[0].size == 16u))
+            return fail("the root file's byte range comes from the allocation "
+                        "table",
+                        hex_text(parsed.files[0].offset) + "+" +
+                            number_text(parsed.files[0].size));
+        ok("the root file's byte range comes from the allocation table");
+
+        if (!require(parsed.files[1].offset == built.fat[1].first &&
+                     parsed.files[1].size == 32u))
+            return fail("the first subdirectory file's byte range comes from "
+                        "the allocation table",
+                        hex_text(parsed.files[1].offset) + "+" +
+                            number_text(parsed.files[1].size));
+        ok("the first subdirectory file's byte range comes from the allocation "
+           "table");
+
+        if (!require(parsed.files[2].offset == built.fat[2].first &&
+                     parsed.files[2].size == 8u))
+            return fail("the second subdirectory file's byte range comes from "
+                        "the allocation table",
+                        hex_text(parsed.files[2].offset) + "+" +
+                            number_text(parsed.files[2].size));
+        ok("the second subdirectory file's byte range comes from the "
+           "allocation table");
+
+        // And the bytes there are the ones the fixture wrote, so the offset is
+        // not merely self-consistent.
+        const std::vector<std::uint8_t> title =
+            read_range(built.image, parsed.files[0].offset, 16u);
+        bool pattern_matches = title.size() == 16u;
+        if (pattern_matches) {
+            for (std::size_t i = 0; i < title.size(); ++i) {
+                if (title[i] != static_cast<std::uint8_t>(0x10u + i)) {
+                    pattern_matches = false;
+                    break;
+                }
+            }
+        }
+        if (!require(pattern_matches))
+            return fail("the bytes at the file's offset are the file's bytes",
+                        "got " + number_text(title.empty() ? 0u : title[0]));
+        ok("the bytes at the file's offset are the file's bytes");
+    }
+
+    // ---- 3. File ids that do not start at zero. --------------------------
+    {
+        const BuiltRom built = build_rom(overlay_spec());
+        const NdsNitroFs parsed = parse_of(built);
+
+        if (!require(parsed.ok))
+            return fail("ids that skip the first few still parse",
+                        describe(parsed));
+        ok("ids that skip the first few still parse");
+
+        if (!require(parsed.fat_entries == 5))
+            return fail("the allocation table is larger than the name table",
+                        describe(parsed));
+        ok("the allocation table is larger than the name table");
+
+        if (!require(parsed.files.size() == 2u))
+            return fail("ids the name table does not mention are not files",
+                        describe(parsed));
+        ok("ids the name table does not mention are not files");
+
+        if (!require(parsed.files[0].id == 3 &&
+                     parsed.files[0].path == "MAIN.BIN"))
+            return fail("the root's declared first id is honoured",
+                        describe(parsed));
+        ok("the root's declared first id is honoured");
+
+        if (!require(parsed.files[1].id == 4 &&
+                     parsed.files[1].path == "MSG/PAK00.PAK"))
+            return fail("a subdirectory's declared first id is honoured",
+                        describe(parsed));
+        ok("a subdirectory's declared first id is honoured");
+
+        if (!require(parsed.files[0].offset == built.fat[3].first &&
+                     parsed.files[1].offset == built.fat[4].first))
+            return fail("an id past the first files still indexes the table",
+                        describe(parsed));
+        ok("an id past the first files still indexes the table");
+
+        // A reader that counted from zero would have produced ids 0 and 1 here
+        // and silently replaced the wrong bytes. That is the failure this
+        // section exists to catch.
+        if (!require(nds_nitrofs::nitrofs_file_by_id(parsed, 0) == nullptr &&
+                     nds_nitrofs::nitrofs_file_by_id(parsed, 1) == nullptr &&
+                     nds_nitrofs::nitrofs_file_by_id(parsed, 2) == nullptr))
+            return fail("an unnamed id has no entry to look up",
+                        describe(parsed));
+        ok("an unnamed id has no entry to look up");
+    }
+
+    // ---- 4. Ordering. ----------------------------------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+        bool ascending = true;
+        for (std::size_t i = 1; i < parsed.files.size(); ++i) {
+            if (parsed.files[i - 1].id >= parsed.files[i].id) {
+                ascending = false;
+                break;
+            }
+        }
+        if (!require(ascending))
+            return fail("the file list is sorted by id", describe(parsed));
+        ok("the file list is sorted by id");
+
+        const NdsNitroFs again = parse_of(built);
+        if (!require(describe(again) == describe(parsed)))
+            return fail("parsing the same image twice gives the same answer",
+                        describe(again));
+        ok("parsing the same image twice gives the same answer");
+
+        const BuiltRom rebuilt = build_rom(basic_spec());
+        if (!require(describe(parse_of(rebuilt)) == describe(parsed)))
+            return fail("rebuilding the same tree gives the same answer",
+                        describe(parse_of(rebuilt)));
+        ok("rebuilding the same tree gives the same answer");
+
+        // A tree whose walk order is not id order: the root declares the high
+        // ids and a subdirectory declares the low ones, so the walker meets id
+        // 5 before id 0. A list that is merely in walk order is not sorted, and
+        // every caller above this module assumes sorted.
+        RomSpec unordered;
+        unordered.root.files.push_back(FileSpec{"HIGH.BIN", 5, 8u, 0x51u});
+        DirSpec low;
+        low.name = "LOW";
+        low.files.push_back(FileSpec{"LOW0.BIN", 0, 8u, 0x52u});
+        low.files.push_back(FileSpec{"LOW1.BIN", 1, 8u, 0x53u});
+        unordered.root.dirs.push_back(low);
+        const BuiltRom jumbled = build_rom(unordered);
+        const NdsNitroFs ordered = parse_of(jumbled);
+        if (!require(ordered.ok))
+            return fail("a tree walked out of id order still parses",
+                        describe(ordered));
+        ok("a tree walked out of id order still parses");
+
+        if (!require(ordered.files.size() == 3u &&
+                     ordered.files[0].id == 0 && ordered.files[1].id == 1 &&
+                     ordered.files[2].id == 5))
+            return fail("the file list is sorted even when the walk is not",
+                        describe(ordered));
+        ok("the file list is sorted even when the walk is not");
+
+        if (!require(ordered.files[0].path == "LOW/LOW0.BIN" &&
+                     ordered.files[2].path == "HIGH.BIN"))
+            return fail("sorting moves the entries, not their paths",
+                        describe(ordered));
+        ok("sorting moves the entries, not their paths");
+    }
+
+    // ---- 5. Lookup. ------------------------------------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+        NdsNitroFsEntry found;
+
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "TITLE.BIN", &found) &&
+                     found.id == 0 && found.size == 16u))
