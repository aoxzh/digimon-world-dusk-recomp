+            " \"counter\": \"c\", \"target\": 1}]}",
+        };
+        bool all_rejected = true;
+        std::string help;
+        for (const char* text : shapes) {
+            parsed.clear();
+            diagnostics.clear();
+            const bool loaded = parse_text(root, "badid.json", text, &parsed,
