+                                                           tiny.size()),
+                                NdsNitroFsRule::ImageTooSmall) == 1))
+            return fail("an image shorter than a header is refused", "");
+        ok("an image shorter than a header is refused");
+
+        const BuiltRom built = build_rom(basic_spec());
