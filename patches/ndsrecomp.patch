+
+int main() {
+    check_constants();
+    check_is_separate_windows();
+    check_pins();
+    check_pin_spare_index();
+    check_adaptive();
+    check_adaptive_refusals();
+    check_adaptive_boundaries();
+    check_scale_refusals();
+    check_second_monitor();
+    check_totality();
+    check_two_window();
+    check_hit_centres();
+    check_hit_pixel_roundtrip();
+    check_hit_corners();
+    check_hit_outside();
+    check_hit_margins();
+    check_hit_window_index();
+    check_hit_explicit_fields();
+    check_hit_refusals();
+    check_hit_logical_agreement();
+    check_hit_logical_adaptive();
+    check_hit_logical_resize();
+    check_hit_logical_refusals();
+    check_contract();
+    check_determinism();
+    check_frontend_calls();
+
+    if (g_failures == 0) {
+        std::printf("%d checks passed\n", g_checks);
+        return 0;
+    }
+    std::printf("%d of %d checks failed\n", g_failures, g_checks);
+    return g_first_failure;
+}
