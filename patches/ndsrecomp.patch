+// ---------------------------------------------------------------------------
+// Pixel-filter checks
+// ---------------------------------------------------------------------------
+
+// Names the first pixel of two same-sized flat images that differ, or "".
+std::string image_mismatch(const std::vector<uint32_t>& got,
+                           const uint32_t* want, int count) {
+    for (int i = 0; i < count; ++i) {
+        if (got[static_cast<std::size_t>(i)] != want[i]) {
+            return "[" + std::to_string(i) + "]: got " +
+                   hex32(got[static_cast<std::size_t>(i)]) + ", want " +
+                   hex32(want[i]);
+        }
+    }
+    return std::string();
+}
+
+bool run_filter(const std::vector<uint32_t>& in, Surface* out,
+                int pixel_filter) {
+    return apply_pixel_filter(in.data(), out->pixels.data(), out->width,
+                              out->height, pixel_filter);
+}
+
+
+// Counts output pixels whose value does not occur anywhere in the 3x3
+// neighbourhood of the same position in the source, i.e. colours the filter
+// made up. The blur invents them by construction -- that is what averaging is
+// -- and the edge-directed pair must never do it, which is the property that
+// separates the two families rather than just their parameter values.
+int clamp_index(int coordinate, int extent) {
+    if (coordinate < 0) return 0;
+    if (coordinate >= extent) return extent - 1;
+    return coordinate;
+}
+
+int invented_pixels(const std::vector<uint32_t>& in,
+                    const std::vector<uint32_t>& out, int width, int height) {
+    int invented = 0;
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            bool found = false;
+            for (int dy = -1; dy <= 1 && !found; ++dy) {
+                const int sample_y = clamp_index(y + dy, height);
+                for (int dx = -1; dx <= 1 && !found; ++dx) {
+                    const int sample_x = clamp_index(x + dx, width);
+                    const std::size_t at =
+                        static_cast<std::size_t>(sample_y) * width + sample_x;
+                    found = in[at] ==
+                            out[static_cast<std::size_t>(y) * width + x];
+                }
+            }
+            if (!found) ++invented;
+        }
+    }
+    return invented;
+}
+
+// The same count over colour bits only. Alpha is, by contract, always taken
+// from the centre pixel, so a substitution on a frame whose neighbours do not
+// share one alpha byte legitimately produces an ARGB word no source pixel had
+// -- 0xFF alpha paired with a 0x7F neighbour's RGB, say. That is a borrowed
+// colour wearing the centre's alpha, not an invented colour, so the property
+// is stated over RGB and the palette frame (one alpha value everywhere) is
+// where the stricter whole-word form is pinned.
+int invented_colors(const std::vector<uint32_t>& in,
+                    const std::vector<uint32_t>& out, int width, int height) {
+    int invented = 0;
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            const uint32_t want =
+                out[static_cast<std::size_t>(y) * width + x] & 0x00FFFFFFu;
+            bool found = false;
+            for (int dy = -1; dy <= 1 && !found; ++dy) {
+                const int sample_y = clamp_index(y + dy, height);
+                for (int dx = -1; dx <= 1 && !found; ++dx) {
+                    const int sample_x = clamp_index(x + dx, width);
+                    const std::size_t at =
+                        static_cast<std::size_t>(sample_y) * width + sample_x;
+                    found = (in[at] & 0x00FFFFFFu) == want;
+                }
+            }
+            if (!found) ++invented;
+        }
+    }
+    return invented;
+}
+
+// The palette frame with its alpha byte alternating 0xFF / 0x7F in a
+// checkerboard. Whole-ARGB comparison is then observable at frame scale: an
+// implementation that compared only the RGB bits would find many more agreeing
+// neighbour pairs and move more pixels, so the two variants hash apart.
+std::vector<uint32_t> palette_alpha_frame() {
+    std::vector<uint32_t> pixels = palette_frame();
+    for (int y = 0; y < kPaletteHeight; ++y) {
+        for (int x = 0; x < kPaletteWidth; ++x) {
+            const std::size_t at =
+                static_cast<std::size_t>(y) * kPaletteWidth + x;
+            const uint32_t alpha = ((x + y) & 1) != 0 ? 0x7F000000u
+                                                      : 0xFF000000u;
+            pixels[at] = alpha | (pixels[at] & 0x00FFFFFFu);
+        }
+    }
+    return pixels;
+}
+
+void check_pixel_filter_api() {
+    check(!pixel_filter_is_valid(-1), "filter -1 is invalid",
+          "reported valid");
+    check(pixel_filter_is_valid(kPixelFilterNearest),
+          "filter 0 is valid", "reported invalid");
+    check(pixel_filter_is_valid(kPixelFilterSharp),
+          "filter 2 is valid", "reported invalid");
+    check(pixel_filter_is_valid(kPixelFilterScale2x),
+          "filter 3 (Scale2x) is valid", "reported invalid");
+    check(pixel_filter_is_valid(kPixelFilterEpx),
+          "filter 4 (Epx) is valid", "reported invalid");
+    check(!pixel_filter_is_valid(kPixelFilterCount),
+          "filter 5 is invalid", "reported valid");
+    check(!pixel_filter_is_valid(-12345) && !pixel_filter_is_valid(9999),
+          "far out-of-range filters are invalid", "reported valid");
+
+    const char* const unknown = pixel_filter_name(-1);
+    check(unknown != nullptr, "pixel_filter_name(-1) is not null", "null");
+    check(unknown != nullptr && unknown[0] == '\0',
+          "pixel_filter_name(-1) is the empty string",
+          unknown == nullptr ? "null" : std::string(unknown));
+    const char* const beyond = pixel_filter_name(kPixelFilterCount);
+    check(beyond != nullptr && beyond[0] == '\0',
+          "pixel_filter_name(5) is the empty string",
+          beyond == nullptr ? "null" : std::string(beyond));
+
+    const char* const names[kPixelFilterCount] = {
+        pixel_filter_name(kPixelFilterNearest),
+        pixel_filter_name(kPixelFilterSmooth),
+        pixel_filter_name(kPixelFilterSharp),
+        pixel_filter_name(kPixelFilterScale2x),
+        pixel_filter_name(kPixelFilterEpx)};
+    check(std::string(names[0]) == "Nearest", "filter 0 is named Nearest",
+          names[0] == nullptr ? "null" : std::string(names[0]));
+    check(std::string(names[1]) == "Smooth", "filter 1 is named Smooth",
+          names[1] == nullptr ? "null" : std::string(names[1]));
+    check(std::string(names[2]) == "Sharp", "filter 2 is named Sharp",
+          names[2] == nullptr ? "null" : std::string(names[2]));
+    check(std::string(names[3]) == "Scale2x", "filter 3 is named Scale2x",
+          names[3] == nullptr ? "null" : std::string(names[3]));
+    check(std::string(names[4]) == "EPX", "filter 4 is named EPX",
+          names[4] == nullptr ? "null" : std::string(names[4]));
+
+    bool distinct = true;
+    for (int a = 0; a < kPixelFilterCount; ++a) {
+        if (names[a] == nullptr || names[a][0] == '\0') distinct = false;
+        for (int b = a + 1; b < kPixelFilterCount; ++b) {
+            if (names[a] != nullptr && names[b] != nullptr &&
+                std::string(names[a]) == std::string(names[b])) {
+                distinct = false;
+            }
+        }
+    }
+    check(distinct, "every filter has its own non-empty name",
+          "a name is null, empty or duplicated");
+}
+
+void check_filter_nearest() {
+    // ---- The extreme channel values, bit for bit. ----------------------
+    Surface out = make_surface(6, 1, 6);
+    const std::vector<uint32_t> extremes(kExtremeIn, kExtremeIn + 6);
+    check(run_filter(extremes, &out, kPixelFilterNearest),
+          "nearest accepts the extreme-pixel row", "returned false");
+    const std::string mismatch =
+        image_mismatch(out.pixels, kExtremeIn, 6);
+    check(mismatch.empty(),
+          "nearest reproduces the extreme pixels bit for bit", mismatch);
+
+    // ---- A full deterministic frame. ----------------------------------
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+    Surface frame = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    check(run_filter(source, &frame, kPixelFilterNearest),
+          "nearest accepts a 256x192 frame", "returned false");
+    const std::string frame_mismatch =
+        first_mismatch(source, frame.pixels, kFrameWidth, kFrameHeight,
+                       kFrameWidth, kFrameWidth);
+    check(frame_mismatch.empty(),
+          "nearest copies the whole frame bit for bit", frame_mismatch);
+    const uint64_t digest =
+        fnv1a64(frame.pixels.data(), kFrameWidth, kFrameHeight, kFrameWidth);
+    check(digest == kFilterNearestDigest,
+          "nearest hashes as the input frame",
+          hex64(digest) + ", want " + hex64(kFilterNearestDigest));
+
+    // ---- Degenerate shapes: 1-wide, 1-high, 1x1. -----------------------
+    const std::vector<uint32_t> column_in(kColumnIn, kColumnIn + 4);
+    Surface column = make_surface(1, 4, 1);
+    check(run_filter(column_in, &column, kPixelFilterNearest) &&
+              image_mismatch(column.pixels, kColumnIn, 4).empty(),
+          "nearest copies a 1x4 column unchanged", "a pixel differs");
+
+    Surface row = make_surface(4, 1, 4);
+    check(run_filter(column_in, &row, kPixelFilterNearest) &&
+              image_mismatch(row.pixels, kColumnIn, 4).empty(),
+          "nearest copies a 4x1 row unchanged", "a pixel differs");
+
+    Surface single = make_surface(1, 1, 1);
+    const std::vector<uint32_t> one(1, 0xFF123456u);
+    check(run_filter(one, &single, kPixelFilterNearest) &&
+              single.first(0) == 0xFF123456u,
+          "nearest copies a single pixel unchanged", hex32(single.first(0)));
+}
+
+void check_filter_smooth() {
+    // ---- Fixture A: the 3x3 red ramp, hand-computed. -------------------
+    Surface ramp = make_surface(3, 3, 3);
+    const std::vector<uint32_t> ramp_in(kRampIn, kRampIn + 9);
+    check(run_filter(ramp_in, &ramp, kPixelFilterSmooth),
+          "smooth accepts the 3x3 ramp fixture", "returned false");
+    const std::string mismatch =
+        image_mismatch(ramp.pixels, kRampSmoothWant, 9);
+    check(mismatch.empty(), "smooth matches the hand-computed ramp", mismatch);
+
+    // The blur sums themselves, so a wrong kernel shape fails here rather
+    // than only at the pixel comparison.
+    std::string bad;
+    for (int i = 0; i < 9 && bad.empty(); ++i) {
+        const int got = static_cast<int>((ramp.pixels[static_cast<std::size_t>(
+            i)] >> 16) & 0xFFu);
+        const BlurPin& pin = kRampBlurTable[i];
+        if (got != pin.blurred) {
+            bad = "pixel " + std::to_string(i) + ": red " +
+                  std::to_string(got) + ", want " +
+                  std::to_string(pin.blurred);
+        }
+    }
+    check(bad.empty(), "every smooth value is (sum + 8) >> 4 of its kernel sum",
+          bad);
+
+    // ---- Fixture B: all nine blurs are exact rounding ties. ------------
+    Surface spot = make_surface(3, 3, 3);
+    const std::vector<uint32_t> spot_in(kSpotIn, kSpotIn + 9);
+    check(run_filter(spot_in, &spot, kPixelFilterSmooth),
+          "smooth accepts the spot fixture", "returned false");
+    const std::string spot_mismatch =
+        image_mismatch(spot.pixels, kSpotSmoothWant, 9);
+    check(spot_mismatch.empty(),
+          "smooth rounds every tie up (255 -> 16, 510 -> 32, 1020 -> 64)",
+          spot_mismatch);
+
+    // ---- Degenerate shapes. -------------------------------------------
+    const std::vector<uint32_t> column_in(kColumnIn, kColumnIn + 4);
+    Surface column = make_surface(1, 4, 1);
+    check(run_filter(column_in, &column, kPixelFilterSmooth),
+          "smooth accepts a 1-wide image", "returned false");
+    const std::string column_mismatch =
+        image_mismatch(column.pixels, kColumnSmoothWant, 4);
+    check(column_mismatch.empty(),
+          "smooth replicates the border on a 1-wide image", column_mismatch);
+
+    Surface row = make_surface(4, 1, 4);
+    check(run_filter(column_in, &row, kPixelFilterSmooth),
+          "smooth accepts a 1-high image", "returned false");
+    check(image_mismatch(row.pixels, kColumnSmoothWant, 4).empty(),
+          "a 1-high image filters exactly like the 1-wide one",
+          image_mismatch(row.pixels, kColumnSmoothWant, 4));
+
+    Surface single = make_surface(1, 1, 1);
+    const std::vector<uint32_t> one(1, 0xFF123456u);
+    check(run_filter(one, &single, kPixelFilterSmooth) &&
+              single.first(0) == 0xFF123456u,
+          "smooth leaves a single pixel alone", hex32(single.first(0)));
+}
+
+void check_filter_sharp() {
+    // ---- Fixture A: the same ramp. ------------------------------------
+    Surface ramp = make_surface(3, 3, 3);
+    const std::vector<uint32_t> ramp_in(kRampIn, kRampIn + 9);
+    check(run_filter(ramp_in, &ramp, kPixelFilterSharp),
+          "sharp accepts the 3x3 ramp fixture", "returned false");
+    const std::string mismatch =
+        image_mismatch(ramp.pixels, kRampSharpWant, 9);
+    check(mismatch.empty(), "sharp matches the hand-computed ramp", mismatch);
+
+    // The corners sharpen below zero and must clamp rather than wrap.
+    check(((ramp.pixels[0] >> 16) & 0xFFu) == 0u,
+          "sharp clamps a negative channel to 0",
+          hex32(ramp.pixels[0]));
+
+    // ---- Fixture B: the centre saturates at 255. ----------------------
+    Surface spot = make_surface(3, 3, 3);
+    const std::vector<uint32_t> spot_in(kSpotIn, kSpotIn + 9);
+    check(run_filter(spot_in, &spot, kPixelFilterSharp),
+          "sharp accepts the spot fixture", "returned false");
+    const std::string spot_mismatch =
+        image_mismatch(spot.pixels, kSpotSharpWant, 9);
+    check(spot_mismatch.empty(),
+          "sharp clamps the saturating centre and the negative corners",
+          spot_mismatch);
+    check(((spot.pixels[4] >> 16) & 0xFFu) == 0xFFu,
+          "the bright centre stays at 255 rather than wrapping",
+          hex32(spot.pixels[4]));
+
+    // ---- Degenerate shapes. -------------------------------------------
+    const std::vector<uint32_t> sharp_column_in(kColumnIn, kColumnIn + 4);
+    Surface sharp_column = make_surface(1, 4, 1);
+    check(run_filter(sharp_column_in, &sharp_column, kPixelFilterSharp),
+          "sharp accepts a 1-wide image", "returned false");
+    const std::string column_mismatch =
+        image_mismatch(sharp_column.pixels, kColumnSharpWant, 4);
+    check(column_mismatch.empty(),
+          "sharp replicates the border on a 1-wide image", column_mismatch);
+}
+
+// ---- Fixture A: straight edges. ----------------------------------------
+//
+// Neither rule may move a pixel: every pixel of a run already holds the run's
+// colour, so the replacement is the value that was there.
+void check_filter_scale2x() {
+    // ---- Fixture Edge: a straight vertical and a straight horizontal edge.
+    Surface edge = make_surface(5, 5, 5);
+    const std::vector<uint32_t> edge_in(kEdgeIn, kEdgeIn + 25);
+    check(run_filter(edge_in, &edge, kPixelFilterScale2x),
+          "scale2x accepts the straight-edge fixture", "returned false");
+    const std::string edge_mismatch =
+        image_mismatch(edge.pixels, kEdgeScale2xWant, 25);
+    check(edge_mismatch.empty(),
+          "scale2x leaves a straight edge exactly where it was",
+          edge_mismatch);
+
+    // ---- Fixture Stair: exactly one pixel moves, at (1, 1). -------------
+    Surface stair = make_surface(5, 5, 5);
+    const std::vector<uint32_t> stair_in(kStairIn, kStairIn + 25);
+    check(run_filter(stair_in, &stair, kPixelFilterScale2x),
+          "scale2x accepts the staircase fixture", "returned false");
+    const std::string stair_mismatch =
+        image_mismatch(stair.pixels, kStairScale2xWant, 25);
+    check(stair_mismatch.empty(), "scale2x matches the hand-computed staircase",
+          stair_mismatch);
+    // The one pixel Scale2x repairs is the notch the staircase leaves at its
+    // top-left corner; the other three staircase pixels have no agreeing pair.
+    check(stair.at(0, 0) == 0xFF000000u && stair.at(1, 1) == 0xFF000000u &&
+              stair.at(2, 1) == 0xFFFFFFFFu,
+          "scale2x repairs (1, 1) and only (1, 1)",
+          hex32(stair.at(1, 1)) + ", " + hex32(stair.at(2, 1)));
+
+    // ---- Fixture Notch: detail survives untouched. ---------------------
+    Surface notch = make_surface(5, 5, 5);
+    const std::vector<uint32_t> notch_in(kNotchIn, kNotchIn + 25);
+    check(run_filter(notch_in, &notch, kPixelFilterScale2x),
+          "scale2x accepts the single-detail fixture", "returned false");
+    const std::string notch_mismatch =
+        image_mismatch(notch.pixels, kNotchScale2xWant, 25);
+    check(notch_mismatch.empty(),
+          "scale2x leaves a single pixel of detail untouched", notch_mismatch);
+
+    // ---- Fixture Corner: a corner can never move. ----------------------
+    Surface corner = make_surface(3, 3, 3);
+    const std::vector<uint32_t> corner_in(kCornerIn, kCornerIn + 9);
+    check(run_filter(corner_in, &corner, kPixelFilterScale2x),
+          "scale2x accepts the corner fixture", "returned false");
+    const std::string corner_mismatch =
+        image_mismatch(corner.pixels, kCornerScale2xWant, 9);
+    check(corner_mismatch.empty(),
+          "scale2x never moves a lone corner pixel", corner_mismatch);
+
+    // ---- Fixture Distinct: no two neighbours agree, nothing happens. ---
+    Surface distinct = make_surface(3, 3, 3);
+    const std::vector<uint32_t> distinct_in(kDistinctIn, kDistinctIn + 9);
+    check(run_filter(distinct_in, &distinct, kPixelFilterScale2x),
+          "scale2x accepts the all-different fixture", "returned false");
+    const std::string distinct_mismatch =
+        image_mismatch(distinct.pixels, kDistinctScale2xWant, 9);
+    check(distinct_mismatch.empty(),
+          "scale2x changes nothing when no neighbours agree",
+          distinct_mismatch);
+
+    // ---- Fixture BrokenRun: the run colour, not the run alpha. --------
+    Surface broken = make_surface(3, 3, 3);
+    const std::vector<uint32_t> broken_in(kBrokenRunIn, kBrokenRunIn + 9);
+    check(run_filter(broken_in, &broken, kPixelFilterScale2x),
+          "scale2x accepts the broken-run fixture", "returned false");
+    const std::string broken_mismatch =
+        image_mismatch(broken.pixels, kBrokenRunScale2xWant, 9);
+    check(broken_mismatch.empty(),
+          "scale2x repairs a one-pixel break in a run", broken_mismatch);
+
+    // ---- Fixture AlphaRun: the substituted colour keeps the centre's
+    // alpha, so 0xFF stays 0xFF even though the source colour had 0x40.
+    Surface alpha_run = make_surface(3, 3, 3);
+    const std::vector<uint32_t> alpha_run_in(kAlphaRunIn, kAlphaRunIn + 9);
+    check(run_filter(alpha_run_in, &alpha_run, kPixelFilterScale2x),
+          "scale2x accepts the alpha-run fixture", "returned false");
+    const std::string alpha_run_mismatch =
+        image_mismatch(alpha_run.pixels, kAlphaRunScale2xWant, 9);
+    check(alpha_run_mismatch.empty(),
+          "scale2x keeps the centre's alpha when it copies a colour",
+          alpha_run_mismatch);
+    check(alpha_run.pixels[4] == 0xFFFFFFFFu,
+          "the repaired pixel is 0xFFFFFFFF, not 0x40FFFFFF",
+          hex32(alpha_run.pixels[4]));
+
+    // ---- Fixtures AlphaTrap and StrictAlpha: whole-word equality. ------
+    // AlphaTrap compares 0x40FFFFFF with 0xFF000000 and 0xFFFFFFFF, so no
+    // pair agrees at the centre; AlphaRun above shows the RGB does not carry
+    // the decision on its own.
+    Surface trap = make_surface(3, 3, 3);
+    const std::vector<uint32_t> trap_in(kAlphaTrapIn, kAlphaTrapIn + 9);
+    check(run_filter(trap_in, &trap, kPixelFilterScale2x),
+          "scale2x accepts the alpha-trap fixture", "returned false");
+    const std::string trap_mismatch =
+        image_mismatch(trap.pixels, kAlphaTrapScale2xWant, 9);
+    check(trap_mismatch.empty(),
+          "scale2x compares alpha too, so an alpha-only difference blocks it",
+          trap_mismatch);
+
+    Surface strict = make_surface(3, 3, 3);
+    const std::vector<uint32_t> strict_in(kStrictAlphaIn, kStrictAlphaIn + 9);
+    check(run_filter(strict_in, &strict, kPixelFilterScale2x),
+          "scale2x accepts the strict-alpha fixture", "returned false");
+    const std::string strict_mismatch =
+        image_mismatch(strict.pixels, kStrictAlphaScale2xWant, 9);
+    check(strict_mismatch.empty(),
+          "scale2x stays put when only one side of the pair carries 0x40",
+          strict_mismatch);
+
+    // ---- Degenerate shapes: 1-wide, 1-high, 1x1. ----------------------
+    // On a 1-wide image both L and R clamp onto the centre's own pixel, so
+    // Scale2x's replacement is always the centre itself, and every Epx clause
+    // demands that two of L/U/R/D agree while another differs, which the
+    // clamped column cannot arrange. Both rules are therefore the identity.
+    // A 1-wide column of the ramp is exactly that case.
+    const std::vector<uint32_t> column_in(kColumnIn, kColumnIn + 4);
+    Surface column = make_surface(1, 4, 1);
+    check(run_filter(column_in, &column, kPixelFilterScale2x) &&
+              image_mismatch(column.pixels, kColumnIn, 4).empty(),
+          "scale2x copies a 1x4 column unchanged", "a pixel differs");
+    Surface row = make_surface(4, 1, 4);
+    check(run_filter(column_in, &row, kPixelFilterScale2x) &&
+              image_mismatch(row.pixels, kColumnIn, 4).empty(),
+          "scale2x copies a 4x1 row unchanged", "a pixel differs");
+    Surface single = make_surface(1, 1, 1);
+    const std::vector<uint32_t> one(1, 0xFF123456u);
+    check(run_filter(one, &single, kPixelFilterScale2x) &&
+              single.first(0) == 0xFF123456u,
+          "scale2x copies a single pixel unchanged", hex32(single.first(0)));
+
+    // ---- The palette frame, where the rule fires often. ---------------
+    Surface palette = make_surface(kPaletteWidth, kPaletteHeight,
+                                   kPaletteWidth);
+    const std::vector<uint32_t> palette_in = palette_frame();
+    check(run_filter(palette_in, &palette, kPixelFilterScale2x),
+          "scale2x accepts the 64x48 palette frame", "returned false");
+    const uint64_t digest =
+        fnv1a64(palette.pixels.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(digest == kPaletteScale2xDigest,
+          "scale2x hashes as the pinned palette frame",
+          hex64(digest) + ", want " + hex64(kPaletteScale2xDigest));
+    int moved = 0;
+    for (std::size_t i = 0; i < palette_in.size(); ++i) {
+        if (palette_in[i] != palette.pixels[i]) ++moved;
+    }
+    check(moved == kPaletteScale2xChanged,
+          "scale2x moves the pinned number of palette pixels",
+          std::to_string(moved) + ", want " +
+              std::to_string(kPaletteScale2xChanged));
+}
+
+// ---- Fixture B: the same pictures through Epx. ------------------------
+void check_filter_epx() {
+    Surface edge = make_surface(5, 5, 5);
+    const std::vector<uint32_t> edge_in(kEdgeIn, kEdgeIn + 25);
+    check(run_filter(edge_in, &edge, kPixelFilterEpx),
+          "epx accepts the straight-edge fixture", "returned false");
+    const std::string edge_mismatch =
+        image_mismatch(edge.pixels, kEdgeEpxWant, 25);
+    check(edge_mismatch.empty(),
+          "epx leaves a straight edge exactly where it was", edge_mismatch);
+
+    // Epx repairs the four staircase pixels around the corner, where Scale2x
+    // repairs only the corner itself: the two fixtures differ on exactly the
+    // pixels that distinguish the rules.
+    Surface stair = make_surface(5, 5, 5);
+    const std::vector<uint32_t> stair_in(kStairIn, kStairIn + 25);
+    check(run_filter(stair_in, &stair, kPixelFilterEpx),
+          "epx accepts the staircase fixture", "returned false");
+    const std::string stair_mismatch =
+        image_mismatch(stair.pixels, kStairEpxWant, 25);
+    check(stair_mismatch.empty(), "epx matches the hand-computed staircase",
+          stair_mismatch);
+    check(stair.at(1, 1) == 0xFFFFFFFFu && stair.at(2, 1) == 0xFF000000u,
+          "epx keeps the corner but repairs the pixel above-right of it",
+          hex32(stair.at(1, 1)) + ", " + hex32(stair.at(2, 1)));
+
+    // The single red pixel survives, but the two whites beside it are
+    // recoloured: with four comparisons Epx diagnoses the 2x2 corners the
+    // three-pixel blur would smear instead.
+    Surface notch = make_surface(5, 5, 5);
+    const std::vector<uint32_t> notch_in(kNotchIn, kNotchIn + 25);
+    check(run_filter(notch_in, &notch, kPixelFilterEpx),
+          "epx accepts the single-detail fixture", "returned false");
+    const std::string notch_mismatch =
+        image_mismatch(notch.pixels, kNotchEpxWant, 25);
+    check(notch_mismatch.empty(),
+          "epx repairs the corners around a single pixel of detail",
+          notch_mismatch);
+    check(notch.at(1, 1) == 0xFF000000u && notch.at(2, 2) == 0xFFFF0000u,
+          "epx still keeps the red pixel itself", hex32(notch.at(2, 2)));
+
+    Surface corner = make_surface(3, 3, 3);
+    const std::vector<uint32_t> corner_in(kCornerIn, kCornerIn + 9);
+    check(run_filter(corner_in, &corner, kPixelFilterEpx),
+          "epx accepts the corner fixture", "returned false");
+    const std::string corner_mismatch =
+        image_mismatch(corner.pixels, kCornerEpxWant, 9);
+    check(corner_mismatch.empty(),
+          "epx does recolour a lone corner, unlike scale2x", corner_mismatch);
+
+    Surface distinct = make_surface(3, 3, 3);
+    const std::vector<uint32_t> distinct_in(kDistinctIn, kDistinctIn + 9);
+    check(run_filter(distinct_in, &distinct, kPixelFilterEpx),
+          "epx accepts the all-different fixture", "returned false");
+    const std::string distinct_mismatch =
+        image_mismatch(distinct.pixels, kDistinctEpxWant, 9);
+    check(distinct_mismatch.empty(),
+          "epx changes nothing when no neighbours agree", distinct_mismatch);
+
+    Surface broken = make_surface(3, 3, 3);
+    const std::vector<uint32_t> broken_in(kBrokenRunIn, kBrokenRunIn + 9);
+    check(run_filter(broken_in, &broken, kPixelFilterEpx),
+          "epx accepts the broken-run fixture", "returned false");
+    const std::string broken_mismatch =
+        image_mismatch(broken.pixels, kBrokenRunEpxWant, 9);
+    check(broken_mismatch.empty(),
+          "epx repairs a one-pixel break in a run", broken_mismatch);
+
+    // AlphaTrap: Epx must not fire here either, because no pair agrees once
+    // the alpha byte is part of the comparison.
+    Surface trap = make_surface(3, 3, 3);
+    const std::vector<uint32_t> trap_in(kAlphaTrapIn, kAlphaTrapIn + 9);
+    check(run_filter(trap_in, &trap, kPixelFilterEpx),
+          "epx accepts the alpha-trap fixture", "returned false");
+    const std::string trap_mismatch =
+        image_mismatch(trap.pixels, kAlphaTrapEpxWant, 9);
+    check(trap_mismatch.empty(),
+          "epx compares alpha too, so an alpha-only difference blocks it",
+          trap_mismatch);
+
+    // AlphaRun through Epx: same picture as the strict-alpha one, but both
+    // neighbours carry 0x40 alpha, so no pair agrees at the centre and Epx
+    // must leave it red.
+    Surface alpha_run = make_surface(3, 3, 3);
+    const std::vector<uint32_t> alpha_run_in(kAlphaRunIn, kAlphaRunIn + 9);
+    check(run_filter(alpha_run_in, &alpha_run, kPixelFilterEpx),
+          "epx accepts the alpha-run fixture", "returned false");
+    const std::string alpha_run_mismatch =
+        image_mismatch(alpha_run.pixels, kAlphaRunEpxWant, 9);
+    check(alpha_run_mismatch.empty(),
+          "epx leaves the centre alone when its neighbours' alpha differs",
+          alpha_run_mismatch);
+
+    // StrictAlpha: Epx does fire at (0, 1) and (2, 1), and each result must
+    // keep its own centre's alpha -- 0x40 on the left, 0xFF on the right.
+    Surface strict = make_surface(3, 3, 3);
+    const std::vector<uint32_t> strict_in(kStrictAlphaIn, kStrictAlphaIn + 9);
+    check(run_filter(strict_in, &strict, kPixelFilterEpx),
+          "epx accepts the strict-alpha fixture", "returned false");
+    const std::string strict_mismatch =
+        image_mismatch(strict.pixels, kStrictAlphaEpxWant, 9);
+    check(strict_mismatch.empty(),
+          "epx keeps each centre's alpha when it copies a colour",
+          strict_mismatch);
+
+    const std::vector<uint32_t> column_in(kColumnIn, kColumnIn + 4);
+    Surface column = make_surface(1, 4, 1);
+    check(run_filter(column_in, &column, kPixelFilterEpx) &&
+              image_mismatch(column.pixels, kColumnIn, 4).empty(),
+          "epx copies a 1x4 column unchanged", "a pixel differs");
+    Surface row = make_surface(4, 1, 4);
+    check(run_filter(column_in, &row, kPixelFilterEpx) &&
+              image_mismatch(row.pixels, kColumnIn, 4).empty(),
+          "epx copies a 4x1 row unchanged", "a pixel differs");
+    Surface single = make_surface(1, 1, 1);
+    const std::vector<uint32_t> one(1, 0xFF123456u);
+    check(run_filter(one, &single, kPixelFilterEpx) &&
+              single.first(0) == 0xFF123456u,
+          "epx copies a single pixel unchanged", hex32(single.first(0)));
+
+    Surface palette = make_surface(kPaletteWidth, kPaletteHeight,
+                                   kPaletteWidth);
+    const std::vector<uint32_t> palette_in = palette_frame();
+    check(run_filter(palette_in, &palette, kPixelFilterEpx),
+          "epx accepts the 64x48 palette frame", "returned false");
+    const uint64_t digest =
+        fnv1a64(palette.pixels.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(digest == kPaletteEpxDigest,
+          "epx hashes as the pinned palette frame",
+          hex64(digest) + ", want " + hex64(kPaletteEpxDigest));
+    int moved = 0;
+    for (std::size_t i = 0; i < palette_in.size(); ++i) {
+        if (palette_in[i] != palette.pixels[i]) ++moved;
+    }
+    check(moved == kPaletteEpxChanged,
+          "epx moves the pinned number of palette pixels",
+          std::to_string(moved) + ", want " +
+              std::to_string(kPaletteEpxChanged));
+}
+
+// ---- Properties that hold for the whole edge-directed family. ---------
+void check_filter_edge_properties() {
+    // A uniform image is the fixed point of every mode: there is no edge to
+    // repair and no contrast to redistribute, so all five must copy it.
+    std::vector<uint32_t> flat(static_cast<std::size_t>(12) * 9, 0xFF3366CCu);
+    for (int filter = 0; filter < kPixelFilterCount; ++filter) {
+        Surface out = make_surface(12, 9, 12);
+        check(run_filter(flat, &out, filter) &&
+                  first_mismatch(flat, out.pixels, 12, 9, 12, 12).empty(),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " leaves a uniform image alone",
+              "a pixel moved");
+    }
+
+    const std::vector<uint32_t> palette_in = palette_frame();
+    // The generator itself is pinned, so a change to the seed or the palette
+    // can never masquerade as a filter regression.
+    const uint64_t palette_digest =
+        fnv1a64(palette_in.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(palette_digest == kPaletteDigest,
+          "the palette frame generator is unchanged",
+          hex64(palette_digest) + ", want " + hex64(kPaletteDigest));
+    Surface scale = make_surface(kPaletteWidth, kPaletteHeight, kPaletteWidth);
+    check(run_filter(palette_in, &scale, kPixelFilterScale2x),
+          "scale2x accepts the palette frame for the property checks",
+          "returned false");
+    Surface epx = make_surface(kPaletteWidth, kPaletteHeight, kPaletteWidth);
+    check(run_filter(palette_in, &epx, kPixelFilterEpx),
+          "epx accepts the palette frame for the property checks",
+          "returned false");
+    Surface smooth = make_surface(kPaletteWidth, kPaletteHeight,
+                                  kPaletteWidth);
+    check(run_filter(palette_in, &smooth, kPixelFilterSmooth),
+          "smooth accepts the palette frame for the contrast check",
+          "returned false");
+    const uint64_t smooth_digest =
+        fnv1a64(smooth.pixels.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(smooth_digest == kPaletteSmoothDigest,
+          "smooth hashes as the pinned palette frame",
+          hex64(smooth_digest) + ", want " + hex64(kPaletteSmoothDigest));
+    int smooth_moved = 0;
+    for (std::size_t i = 0; i < palette_in.size(); ++i) {
+        if (palette_in[i] != smooth.pixels[i]) ++smooth_moved;
+    }
+    check(smooth_moved == kPaletteSmoothChanged,
+          "smooth moves the pinned number of palette pixels",
+          std::to_string(smooth_moved) + ", want " +
+              std::to_string(kPaletteSmoothChanged));
+
+    // The property that defines the family: every output pixel is a value
+    // that was already in its own 3x3 neighbourhood. No new colour, ever.
+    const int scale_invented =
+        invented_pixels(palette_in, scale.pixels, kPaletteWidth,
+                        kPaletteHeight);
+    check(scale_invented == 0, "scale2x never invents a colour",
+          std::to_string(scale_invented) + " invented pixels");
+    const int epx_invented =
+        invented_pixels(palette_in, epx.pixels, kPaletteWidth, kPaletteHeight);
+    check(epx_invented == 0, "epx never invents a colour",
+          std::to_string(epx_invented) + " invented pixels");
+
+    // ... and the blur provably does invent them, so the property above is a
+    // real distinction between the two families and not something every
+    // filter satisfies.
+    const int smooth_invented =
+        invented_pixels(palette_in, smooth.pixels, kPaletteWidth,
+                        kPaletteHeight);
+    check(smooth_invented == kPaletteSmoothInvented &&
+              smooth_invented > 0,
+          "smooth does invent colours the neighbourhood did not contain",
+          std::to_string(smooth_invented) + ", want " +
+              std::to_string(kPaletteSmoothInvented));
+
+    // Alpha is never taken from a neighbour, in any mode.
+    for (int filter = 0; filter < kPixelFilterCount; ++filter) {
+        Surface out = make_surface(kPaletteWidth, kPaletteHeight,
+                                   kPaletteWidth);
+        check(run_filter(palette_in, &out, filter),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " accepts the palette frame for the alpha check",
+              "returned false");
+        std::string bad;
+        for (std::size_t i = 0; i < palette_in.size() && bad.empty(); ++i) {
+            if ((out.pixels[i] & 0xFF000000u) !=
+                (palette_in[i] & 0xFF000000u)) {
+                bad = "pixel " + std::to_string(i) + ": " +
+                      hex32(out.pixels[i]) + ", want alpha " +
+                      hex32(palette_in[i] & 0xFF000000u);
+            }
+        }
+        check(bad.empty(),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " copies every alpha",
+              bad);
+    }
+
+    // Whole-word comparison, at frame scale. This frame carries the same six
+    // RGB colours but alternates its alpha byte, so an implementation that
+    // compared only RGB would find extra agreeing pairs and move a different
+    // set of pixels; the digest below pins the strict form.
+    const std::vector<uint32_t> alpha_in = palette_alpha_frame();
+    Surface alpha_scale = make_surface(kPaletteWidth, kPaletteHeight,
+                                       kPaletteWidth);
+    check(run_filter(alpha_in, &alpha_scale, kPixelFilterScale2x),
+          "scale2x accepts the alpha-checkerboard frame", "returned false");
+    const uint64_t alpha_scale_digest =
+        fnv1a64(alpha_scale.pixels.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(alpha_scale_digest == kAlphaFrameScale2xDigest,
+          "scale2x compares the whole ARGB word, alpha included",
+          hex64(alpha_scale_digest) + ", want " +
+              hex64(kAlphaFrameScale2xDigest));
+    Surface alpha_epx = make_surface(kPaletteWidth, kPaletteHeight,
+                                     kPaletteWidth);
+    check(run_filter(alpha_in, &alpha_epx, kPixelFilterEpx),
+          "epx accepts the alpha-checkerboard frame", "returned false");
+    const uint64_t alpha_epx_digest =
+        fnv1a64(alpha_epx.pixels.data(), kPaletteWidth, kPaletteHeight,
+                kPaletteWidth);
+    check(alpha_epx_digest == kAlphaFrameEpxDigest,
+          "epx compares the whole ARGB word, alpha included",
+          hex64(alpha_epx_digest) + ", want " + hex64(kAlphaFrameEpxDigest));
+    const int alpha_scale_invented =
+        invented_colors(alpha_in, alpha_scale.pixels, kPaletteWidth,
+                        kPaletteHeight);
+    const int alpha_epx_invented =
+        invented_colors(alpha_in, alpha_epx.pixels, kPaletteWidth,
+                        kPaletteHeight);
+    check(alpha_scale_invented == 0 && alpha_epx_invented == 0,
+          "the strict pair still invents no colour on a varied-alpha frame",
+          std::to_string(alpha_scale_invented) + " and " +
+              std::to_string(alpha_epx_invented) + " invented pixels");
+
+    // The 256x192 pattern frame is dense noise: no three-in-a-row structure
+    // survives its channel ramps, so BOTH edge rules are the identity on it.
+    // Pinned because it is the frame every other filter is hashed on, and a
+    // rule that fired on noise would drag its digest away from nearest.
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+    for (const int filter : {kPixelFilterScale2x, kPixelFilterEpx}) {
+        Surface out = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+        check(run_filter(source, &out, filter),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " accepts the reference frame",
+              "returned false");
+        const std::string same = first_mismatch(
+            source, out.pixels, kFrameWidth, kFrameHeight, kFrameWidth,
+            kFrameWidth);
+        check(same.empty(),
+              std::string(pixel_filter_name(filter)) +
+                  " is the identity on the noise-like pattern frame",
+              same);
+    }
+}
+
+void check_filter_alpha() {
+    // A constant RGB field under an alpha ramp: the blur cannot move a channel,
+    // so every difference here is an alpha bug. The edge-directed pair has a
+    // second reason to hold still here: every neighbour differs by its alpha
+    // byte, so whole-word comparison finds no agreeing pair and copies nothing.
+    const std::vector<uint32_t> alpha_in(kAlphaIn, kAlphaIn + 9);
+    const int filters[kPixelFilterCount] = {
+        kPixelFilterNearest, kPixelFilterSmooth, kPixelFilterSharp,
+        kPixelFilterScale2x, kPixelFilterEpx};
+    for (const int filter : filters) {
+        Surface out = make_surface(3, 3, 3);
+        check(run_filter(alpha_in, &out, filter),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " accepts the alpha fixture",
+              "returned false");
+        std::string bad;
+        for (int i = 0; i < 9 && bad.empty(); ++i) {
+            const std::size_t at_i = static_cast<std::size_t>(i);
+            const uint32_t want_alpha = kAlphaIn[i] & 0xFF000000u;
+            const uint32_t got_alpha = out.pixels[at_i] & 0xFF000000u;
+            if (got_alpha != want_alpha) {
+                bad = "pixel " + std::to_string(i) + ": got " +
+                      hex32(out.pixels[at_i]) + ", want alpha " +
+                      hex32(want_alpha);
+            } else if ((out.pixels[at_i] & 0x00FFFFFFu) != 0x00808080u) {
+                bad = "pixel " + std::to_string(i) +
+                      " moved its RGB: " + hex32(out.pixels[at_i]);
+            }
+        }
+        check(bad.empty(),
+              std::string("filter ") + pixel_filter_name(filter) +
+                  " copies alpha and leaves a flat field flat",
+              bad);
+    }
+
+    // Alpha must also survive where the RGB is being pushed hard: the spot
+    // fixture saturates its centre, and every pixel must still carry the alpha
+    // its own centre pixel had.
+    const std::vector<uint32_t> spot_in(kSpotIn, kSpotIn + 9);
+    Surface spot = make_surface(3, 3, 3);
+    check(run_filter(spot_in, &spot, kPixelFilterSharp),
+          "sharp accepts the spot fixture for the alpha check",
+          "returned false");
+    std::string alpha_bad;
+    for (int i = 0; i < 9 && alpha_bad.empty(); ++i) {
+        const std::size_t at_i = static_cast<std::size_t>(i);
+        if ((spot.pixels[at_i] >> 24) != (kSpotIn[i] >> 24)) {
+            alpha_bad = "pixel " + std::to_string(i) + ": " +
+                        hex32(spot.pixels[at_i]) + ", want alpha " +
+                        hex32(kSpotIn[i] & 0xFF000000u);
+        }
+    }
+    check(alpha_bad.empty(), "sharp keeps each centre pixel's own alpha",
+          alpha_bad);
+}
+
+void check_filter_rejections() {
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+
+    // Every rejection must leave the entire output buffer untouched, not just
+    // the visible part: a half-written frame is a torn picture.
+    struct Case {
+        const char* name;
+        const uint32_t* in;
+        uint32_t* out;
+        int width;
+        int height;
+    };
+
+    Surface surface = make_surface(4, 2, 4);
+    std::vector<Case> cases;
+    cases.push_back({"a null input", nullptr, surface.pixels.data(), 4, 2});
+    cases.push_back({"a null output", source.data(), nullptr, 4, 2});
+    cases.push_back({"two null buffers", nullptr, nullptr, 4, 2});
+    cases.push_back({"width 0", source.data(), surface.pixels.data(), 0, 2});
+    cases.push_back({"width -1", source.data(), surface.pixels.data(), -1, 2});
+    cases.push_back({"height 0", source.data(), surface.pixels.data(), 4, 0});
+    cases.push_back({"height -1", source.data(), surface.pixels.data(), 4, -1});
+
+    for (const Case& tc : cases) {
+        surface.pixels.assign(surface.pixels.size(), kSentinel);
+        const bool accepted =
+            apply_pixel_filter(tc.in, tc.out, tc.width, tc.height,
+                               kPixelFilterSmooth);
+        check(!accepted, std::string("apply_pixel_filter() rejects ") + tc.name,
+              "returned true");
+        const std::string breaks = sentinel_breaks(surface.pixels, kSentinel);
+        check(breaks.empty(),
+              std::string("a rejected call (") + tc.name +
+                  ") leaves out untouched",
+              breaks);
+    }
+
+    // In-place is rejected by contract: the kernel needs its neighbours
+    // unfiltered. The buffer must come back exactly as it went in.
+    const std::vector<uint32_t> alias_in = pattern_frame(kFrameWidth);
+    std::vector<uint32_t> aliased = alias_in;
+    const bool aliased_ok =
+        apply_pixel_filter(aliased.data(), aliased.data(), kFrameWidth,
+                           kFrameHeight, kPixelFilterSmooth);
+    check(!aliased_ok, "apply_pixel_filter() rejects an aliased buffer",
+          "returned true");
+    const std::string alias_breaks =
+        first_mismatch(alias_in, aliased, kFrameWidth, kFrameHeight,
+                       kFrameWidth, kFrameWidth);
+    check(alias_breaks.empty(),
+          "a rejected aliased call leaves the buffer untouched", alias_breaks);
+
+    // An invalid filter is NOT a rejection: it behaves as nearest, so a
+    // hand-edited settings value cannot corrupt the picture.
+    Surface invalid = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    const bool accepted =
+        run_filter(source, &invalid, -7);
+    check(accepted, "an invalid filter is accepted, not rejected",
+          "returned false");
+
+    Surface nearest = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    check(run_filter(source, &nearest, kPixelFilterNearest),
+          "nearest accepts the reference frame", "returned false");
+    check(std::memcmp(invalid.pixels.data(), nearest.pixels.data(),
+                      invalid.pixels.size() * sizeof(uint32_t)) == 0,
+          "an invalid filter produces exactly the nearest output",
+          "the two outputs differ");
+
+    Surface beyond = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    check(run_filter(source, &beyond, kPixelFilterCount) &&
+              std::memcmp(beyond.pixels.data(), nearest.pixels.data(),
+                          nearest.pixels.size() * sizeof(uint32_t)) == 0,
+          "a filter one past the end behaves as nearest",
+          "the two outputs differ");
+}
+
+void check_filter_frames() {
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+    struct Case {
+        const char* name;
+        int filter;
+        uint64_t digest;
+    };
+    const Case cases[] = {
+        {"nearest", kPixelFilterNearest, kFilterNearestDigest},
+        {"smooth", kPixelFilterSmooth, kFilterSmoothDigest},
+        {"sharp", kPixelFilterSharp, kFilterSharpDigest},
+    };
+    for (const Case& tc : cases) {
+        Surface out = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+        const bool ok = run_filter(source, &out, tc.filter);
+        const std::string unwritten =
+            unwritten_pixels(out.pixels, kFrameWidth, kFrameHeight,
+                             kFrameWidth, kSentinel);
+        check(ok && unwritten.empty(),
+              std::string(tc.name) + ": every pixel is written", unwritten);
+        const uint64_t digest =
+            fnv1a64(out.pixels.data(), kFrameWidth, kFrameHeight,
+                    kFrameWidth);
+        check(digest == tc.digest,
+              std::string(tc.name) + " hashes as the pinned frame",
+              hex64(digest) + ", want " + hex64(tc.digest));
+    }
+
+    // The two spatial filters must actually change the picture, otherwise a
+    // "filter" that silently copied would pass every digest above by luck.
+    Surface smooth = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    check(run_filter(source, &smooth, kPixelFilterSmooth),
+          "smooth accepts the reference frame", "returned false");
+    const std::string smooth_same =
+        first_mismatch(source, smooth.pixels, kFrameWidth, kFrameHeight,
+                       kFrameWidth, kFrameWidth);
+    check(!smooth_same.empty(),
+          "smooth actually changes the frame", "the output equals the input");
+
+    Surface sharp = make_surface(kFrameWidth, kFrameHeight, kFrameWidth);
+    check(run_filter(source, &sharp, kPixelFilterSharp),
+          "sharp accepts the reference frame", "returned false");
+    const std::string sharp_same =
+        first_mismatch(source, sharp.pixels, kFrameWidth, kFrameHeight,
+                       kFrameWidth, kFrameWidth);
+    check(!sharp_same.empty(),
+          "sharp actually changes the frame", "the output equals the input");
+}
+
+int run_checks() {
+    check_mode_api();
+    check_lut();
+    check_identity_table();
+    check_rejections();
+    check_identity_apply();
+    check_grid();
+    check_aliasing();
+    check_frame_round_trip();
+    check_pixel_filter_api();
+    check_filter_nearest();
+    check_filter_smooth();
+    check_filter_sharp();
+    check_filter_scale2x();
+    check_filter_epx();
+    check_filter_edge_properties();
+    check_filter_alpha();
+    check_filter_rejections();
+    check_filter_frames();
+    return g_failures == 0 ? 0 : g_first_failure;
+}
+
+}  // namespace
+
+int main() {
+    const int result = run_checks();
+    if (result == 0) {
+        std::printf("%d checks passed\n", g_checks);
+    } else {
+        std::fprintf(stderr, "%d of %d checks FAILED (first at check %d)\n",
+                     g_failures, g_checks, result);
+    }
+    return result;
+}
diff --git a/runner/tests/frame_pacing_test.cpp b/runner/tests/frame_pacing_test.cpp
new file mode 100644
index 0000000..bfa02e8
--- /dev/null
+++ b/runner/tests/frame_pacing_test.cpp
@@ -0,0 +1,1557 @@
+// Pins the frame-pacing contract (frame_pacing.h).
+//
+// A frame cap is a fixed-point phase accumulator, and every wrong version of it
+// still looks plausible from the outside: the picture moves, the counter moves,
+// the log line reads fine. The failures are all second-order, so this file
+// pins them one at a time against a synthetic 1 us clock (kTickHz) where every
+// number is small enough to check by hand rather than against wall time:
+//
+//   * Rounding. One slot is ceil(ticks_per_second / cap), not floor: 60 fps at
+//     1 MHz is 16667 ticks and 144 fps is 6945. A floor implementation loses a
+//     fraction of a tick per frame, so the pinned digests here diverge within a
+//     few hundred frames even though no single deadline looks wrong.
+//   * Phase. A late frame advances the deadline by whole slots FROM THE
+//     DEADLINE, so a frame that arrives 3.4 slots late lands back on the
+//     original grid instead of sliding by the overshoot. Pinned by driving 600
+//     frames at exactly one slot per frame and requiring 600 presents and zero
+//     skips; an implementation that advances from `now` still passes a single
+//     late-frame check but fails the digest.
+//   * Bounded catch-up. A stall is worth exactly one present plus a skipped
+//     count, never a burst of presents. The stall fixture jumps by whole slots
+//     PLUS a remainder on purpose: anchoring to `now` and anchoring to the
+//     deadline agree on an exact multiple and disagree on a remainder, so the
+//     remainder is what makes the difference observable.
+//   * Sleep. suggested_sleep_ms rounds up (a floor returns 0 ms at 144 fps and
+//     spins the loop), never overshoots one slot, and is never 0 while a frame
+//     is genuinely pending.
+//   * Cap edits. Raising the cap must not release a backlog, lowering it must
+//     not stall for a whole new slot, and the counters must survive an edit but
+//     die on reset.
+//   * Degenerate input. A zero tick rate, a corrupt negative cap and a clock
+//     that runs backwards are all reachable from a hand-edited settings file or
+//     a sleep that overslept, and none of them may divide by zero or present a
+//     storm.
+//
+// The cap is a PRESENTATION cap, not an emulation-speed cap: the guest keeps
+// running at its native field rate and only the present is held back. That
+// distinction is not something one call can observe -- it lives in the frame
+// loop -- but two of its consequences are observable here and are pinned as
+// such: a cap at or above the native 60 Hz never holds a frame back when the
+// caller really is pacing at 60 Hz, and the pacer never mutates anything
+// outside its own struct (no globals, no clock reads), which the determinism
+// fixture relies on when it runs the same loop twice.
+//
+// measured_fps() is a since-reset average, not a sliding window -- the struct
+// has no field to slide -- so its fixtures say so explicitly: the value right
+// after a reset is biased high and a long pause reads far below the cap.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and every failure prints its own name and
+// numbers, so a failure names itself without a debugger.
+
+#include "frame_pacing.h"
+
+#include <algorithm>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+// The four constants below are also the persisted settings value, the menu
+// label text and the clamp window, so they are pinned at compile time.
+static_assert(nds_frame_pacing::kFrameCapUnlimited == 0, "unlimited is 0");
+static_assert(nds_frame_pacing::kFrameCapMin == 30, "floor is 30");
+static_assert(nds_frame_pacing::kFrameCapMax == 144, "ceiling is 144");
+static_assert(nds_frame_pacing::kNativeRefreshHz == 60, "native is 60");
+
+namespace {
+
+using nds_frame_pacing::NdsFramePacer;
+
+// 1 us per tick. A 60 fps slot is 16667 ticks and a 30 fps slot is 33334, which
+// is exactly two 60 Hz caller steps, so the "cap 30 on a 60 Hz caller" fixture
+// below is the one case where nothing is ever skipped and the comment says why.
+constexpr uint64_t kTickHz = 1000000;
+
+constexpr uint64_t kFnvSeed = 0xCBF29CE484222325ull;
+constexpr uint64_t kFnvPrime = 0x100000001B3ull;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const std::string& what,
+           const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what.c_str());
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::fprintf(stderr, "FAIL %s\n     %s\n", what.c_str(), detail.c_str());
+    return false;
+}
+
+std::string number(int value) { return std::to_string(value); }
+
+std::string u64(uint64_t value) {
+    return std::to_string(static_cast<unsigned long long>(value));
+}
+
+std::string hex64(uint64_t value) {
+    char text[24];
+    std::snprintf(text, sizeof(text), "0x%016llX",
+                  static_cast<unsigned long long>(value));
+    return std::string(text);
+}
+
+uint64_t fnv1a64(uint64_t hash, uint64_t value) {
+    for (int byte = 0; byte < 8; ++byte) {
+        hash ^= (value >> (byte * 8)) & 0xFFu;
+        hash *= kFnvPrime;
+    }
+    return hash;
+}
+
+// ---------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------
+
+NdsFramePacer make_pacer(int cap, uint64_t now, uint64_t ticks_per_second) {
+    NdsFramePacer pacer;
+    pacer.reset(cap, now, ticks_per_second);
+    return pacer;
+}
+
+// One should_present() call and the counters it left behind, so a fixture can
+// assert all three without losing the sequence of observations.
+struct Probe {
+    bool due;
+    uint32_t presented;
+    uint32_t skipped;
+};
+
+Probe probe(NdsFramePacer& pacer, uint64_t now) {
+    Probe out;
+    out.due = pacer.should_present(now);
+    out.presented = pacer.presented();
+    out.skipped = pacer.skipped_slots();
+    return out;
+}
+
+// A whole run of should_present() calls at a fixed cadence. `digest` folds in
+// the returned bool AND both counters after every call, so a fixture can pin
+// the entire per-step trajectory as one number instead of 600 lines of output.
+struct Cadence {
+    int steps;
+    int due_calls;
+    uint32_t presented;
+    uint32_t skipped;
+    uint64_t last_now;
+    uint64_t digest;
+};
+
+void fold(Cadence& run, const NdsFramePacer& pacer, bool due, uint64_t now) {
+    if (due) ++run.due_calls;
+    run.digest = fnv1a64(run.digest, due ? 1u : 0u);
+    run.digest = fnv1a64(run.digest, pacer.presented());
+    run.digest = fnv1a64(run.digest, pacer.skipped_slots());
+    run.last_now = now;
+}
+
+// Calls should_present() `steps` times, `step_ticks` apart, starting at
+// `start_now`. The clock advances AFTER each call, so step 0 happens at
+// `start_now` exactly.
+Cadence run_cadence(NdsFramePacer& pacer, int steps, uint64_t step_ticks,
+                    uint64_t start_now) {
+    Cadence run{steps, 0, 0, 0, start_now, kFnvSeed};
+    uint64_t now = start_now;
+    for (int i = 0; i < steps; ++i) {
+        const bool due = pacer.should_present(now);
+        fold(run, pacer, due, now);
+        now += step_ticks;
+    }
+    run.presented = pacer.presented();
+    run.skipped = pacer.skipped_slots();
+    return run;
+}
+
+// Same fold over a seeded walk of uneven steps, which is the closest thing to a
+// real frame loop: the caller is never exactly on time, so the pacer has to
+// absorb both early and late arrivals thousands of times in a row.
+Cadence run_walk(NdsFramePacer& pacer, int steps, uint64_t seed) {
+    Cadence run{steps, 0, 0, 0, 0, kFnvSeed};
+    uint64_t state = seed;
+    uint64_t now = 0;
+    for (int i = 0; i < steps; ++i) {
+        const bool due = pacer.should_present(now);
+        fold(run, pacer, due, now);
+        state = state * 6364136223846793005ull + 1442695040888963407ull;
+        now += 1000u + ((state >> 33) % 30000u);
+    }
+    run.presented = pacer.presented();
+    run.skipped = pacer.skipped_slots();
+    return run;
+}
+
+// Sweeps suggested_sleep_ms across a pending interval and returns the first
+// violation as a string (empty when the sweep is clean). The bounds are the
+// contract: at least 1 ms while a frame is pending, never more than one whole
+// slot, so one sleep can never overshoot the deadline by a slot.
+std::string sweep_sleep(const NdsFramePacer& pacer, uint64_t slot,
+                        uint32_t limit_ms) {
+    for (uint64_t now = 0; now < slot; ++now) {
+        const uint32_t slept = pacer.suggested_sleep_ms(now);
+        if (slept == 0) {
+            return "sleep 0 at now=" + u64(now) + " (spin)";
+        }
+        if (slept > limit_ms) {
+            return "sleep " + u64(slept) + " at now=" + u64(now) +
+                   " exceeds " + u64(limit_ms);
+        }
+    }
+    return std::string();
+}
+
+// ---------------------------------------------------------------------------
+// Cap table: clamping, menu order, names, snapping
+// ---------------------------------------------------------------------------
+
+void check_cap_clamp() {
+    struct Case {
+        int input;
+        int wanted;
+    };
+    const Case cases[] = {
+        {0, 0},       {1, 30},       {29, 30},      {30, 30},
+        {31, 31},     {55, 55},      {143, 143},    {144, 144},
+        {145, 144},   {1000, 144},   {-1, 30},      {-1000, 30},
+        {INT_MIN, 30}, {INT_MAX, 144},
+    };
+    for (const Case& tc : cases) {
+        const int got = nds_frame_pacing::frame_cap_clamp(tc.input);
+        check(got == tc.wanted,
+              "clamp(" + number(tc.input) + ") == " + number(tc.wanted),
+              "got " + number(got));
+    }
+    // 0 is the sentinel for "unlimited", not a request for 30 fps, so it has to
+    // survive the clamp untouched: a window that pulled 0 up to 30 would make
+    // the shipped default a 30 fps cap.
+    check(nds_frame_pacing::frame_cap_clamp(0) ==
+              nds_frame_pacing::kFrameCapUnlimited,
+          "clamp(0) stays unlimited", "0 was pulled into the window");
+    // A negative cap is a corrupt settings value. Repairing it to the floor is
+    // the safe choice; repairing it to 0 would silently mean "unlimited".
+    check(nds_frame_pacing::frame_cap_clamp(-1) ==
+              nds_frame_pacing::kFrameCapMin,
+          "clamp(-1) repairs to the floor, not to unlimited",
+          "got " + number(nds_frame_pacing::frame_cap_clamp(-1)));
+    // The clamp is a window, not a snap: an off-list value inside the window is
+    // kept as written, and only frame_cap_index() snaps it for the menu.
+    check(nds_frame_pacing::frame_cap_clamp(55) == 55,
+          "clamp keeps an off-list value inside the window",
+          "got " + number(nds_frame_pacing::frame_cap_clamp(55)));
+}
+
+void check_cap_list() {
+    const int caps[] = {0, 30, 45, 60, 75, 90, 100, 120, 144};
+    const char* const names[] = {"Unlimited", "30", "45",    "60",  "75",
+                                "90",        "100", "120", "144"};
+    const int count = nds_frame_pacing::frame_cap_count();
+    if (!check(count == 9, "the menu lists nine caps",
+               "got " + number(count))) {
+        return;
+    }
+    for (int i = 0; i < 9; ++i) {
+        const int cap = nds_frame_pacing::frame_cap_from_index(i);
+        check(cap == caps[i],
+              "from_index(" + number(i) + ") == " + number(caps[i]),
+              "got " + number(cap));
+        const int back = nds_frame_pacing::frame_cap_index(caps[i]);
+        check(back == i, "index(" + number(caps[i]) + ") == " + number(i),
+              "got " + number(back));
+        const char* name = nds_frame_pacing::frame_cap_name(caps[i]);
+        const bool named = name != nullptr && name[0] != '\0';
+        if (!check(named, "cap " + number(caps[i]) + " has a name",
+                   name == nullptr ? "returned nullptr" : "returned \"\"")) {
+            continue;
+        }
+        check(std::strcmp(name, names[i]) == 0,
+              "cap " + number(caps[i]) + " is named " + names[i],
+              std::string("got \"") + name + "\"");
+    }
+    // An out-of-range index is not an error: it means "Unlimited".
+    const int bad[] = {-1, 9, 99, INT_MIN};
+    for (int index : bad) {
+        const int cap = nds_frame_pacing::frame_cap_from_index(index);
+        check(cap == nds_frame_pacing::kFrameCapUnlimited,
+              "from_index(" + number(index) + ") is unlimited",
+              "got " + number(cap));
+    }
+    // An off-list cap inside the window snaps DOWN, not up: a player who wrote
+    // 55 asked for at most 55, and landing them on 60 hands back more frames
+    // than they asked for. 143 is the same trap one rung higher (143 -> 120,
+    // not 144), which is the case a "nearest" implementation gets wrong.
+    check(nds_frame_pacing::frame_cap_index(55) == 2,
+          "index(55) snaps down to the 45 row",
+          "got " + number(nds_frame_pacing::frame_cap_index(55)));
+    check(nds_frame_pacing::frame_cap_index(31) == 1,
+          "index(31) snaps down to the 30 row",
+          "got " + number(nds_frame_pacing::frame_cap_index(31)));
+    check(nds_frame_pacing::frame_cap_index(143) == 7,
+          "index(143) snaps down to the 120 row",
+          "got " + number(nds_frame_pacing::frame_cap_index(143)));
+    check(std::strcmp(nds_frame_pacing::frame_cap_name(55), "45") == 0,
+          "55 is named after its snapped row",
+          std::string("got \"") +
+              nds_frame_pacing::frame_cap_name(55) + "\"");
+    // Out-of-window caps are named after the value the clamp repairs them to,
+    // so the menu never shows a name for a cap that cannot be selected.
+    check(std::strcmp(nds_frame_pacing::frame_cap_name(1000), "144") == 0,
+          "1000 is named 144",
+          std::string("got \"") +
+              nds_frame_pacing::frame_cap_name(1000) + "\"");
+    check(std::strcmp(nds_frame_pacing::frame_cap_name(-1), "30") == 0,
+          "-1 is named 30", std::string("got \"") +
+              nds_frame_pacing::frame_cap_name(-1) + "\"");
+    check(std::strcmp(nds_frame_pacing::frame_cap_name(0), "Unlimited") == 0,
+          "0 is named Unlimited",
+          std::string("got \"") +
+              nds_frame_pacing::frame_cap_name(0) + "\"");
+}
+
+// ---------------------------------------------------------------------------
+// Slot arithmetic
+// ---------------------------------------------------------------------------
+
+void check_slot_arithmetic() {
+    struct Case {
+        int cap;
+        uint64_t ticks_per_second;
+        uint64_t wanted;
+    };
+    // Every entry is ceil(tps / cap); the fractional ones are the interesting
+    // ones (60 at 1 MHz is 16666.67 -> 16667, not 16666).
+    const Case cases[] = {
+        {0, kTickHz, 0},          {30, kTickHz, 33334},
+        {45, kTickHz, 22223},     {60, kTickHz, 16667},
+        {75, kTickHz, 13334},     {90, kTickHz, 11112},
+        {100, kTickHz, 10000},    {120, kTickHz, 8334},
+        {144, kTickHz, 6945},     {60, 3000000, 50000},
+        {45, 3000000, 66667},     {144, 3000000, 20834},
+        {60, 60000, 1000},        {144, 60, 1},
+    };
+    for (const Case& tc : cases) {
+        NdsFramePacer pacer = make_pacer(tc.cap, 0, tc.ticks_per_second);
+        const std::string what = "cap " + number(tc.cap) + " at " +
+                                 u64(tc.ticks_per_second) + " Hz";
+        check(pacer.slot_ticks() == tc.wanted,
+              what + " has a " + u64(tc.wanted) + "-tick slot",
+              "got " + u64(pacer.slot_ticks()));
+        check(pacer.ticks_per_second() == tc.ticks_per_second,
+              what + " keeps its tick rate",
+              "got " + u64(pacer.ticks_per_second()));
+        check(pacer.cap() == tc.cap, what + " keeps its cap",
+              "got " + number(pacer.cap()));
+    }
+    NdsFramePacer unlimited = make_pacer(0, 0, kTickHz);
+    check(!unlimited.active(), "cap 0 reports inactive", "active() is true");
+    check(unlimited.slot_ticks() == 0, "cap 0 has no slot",
+          "got " + u64(unlimited.slot_ticks()));
+    NdsFramePacer capped = make_pacer(60, 0, kTickHz);
+    check(capped.active(), "cap 60 reports active", "active() is false");
+    // A tick rate so coarse that one slot rounds up to a single tick is still a
+    // usable pacer: the guard only fires when the slot would be zero ticks.
+    NdsFramePacer coarse = make_pacer(144, 0, 60);
+    check(coarse.active() && coarse.slot_ticks() == 1,
+          "a 60 Hz tick rate still yields a 1-tick slot",
+          "active " + std::string(coarse.active() ? "true" : "false") +
+              ", slot " + u64(coarse.slot_ticks()));
+}
+
+// ---------------------------------------------------------------------------
+// should_present(): phase and the two-slot walk
+// ---------------------------------------------------------------------------
+
+void check_phase() {
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    Probe p = probe(pacer, 0);
+    check(p.due && p.presented == 1 && p.skipped == 0,
+          "the first frame after reset is due at the reset tick",
+          "due " + std::string(p.due ? "true" : "false") + ", presented " +
+              u64(p.presented) + ", skipped " + u64(p.skipped));
+    // One tick is enough to miss the slot, and two calls at the same tick can
+    // only ever produce one frame: the deadline moved, not the clock.
+    p = probe(pacer, 0);
+    check(!p.due && p.presented == 1,
+          "a second call at the same tick waits",
+          "due " + std::string(p.due ? "true" : "false") + ", presented " +
+              u64(p.presented));
+    p = probe(pacer, 16666);
+    check(!p.due && p.presented == 1 && p.skipped == 0,
+          "16666 ticks is one tick short of the 60 fps slot",
+          "due " + std::string(p.due ? "true" : "false") + ", presented " +
+              u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(pacer, 16667);
+    check(p.due && p.presented == 2 && p.skipped == 0,
+          "the slot boundary presents", "presented " + u64(p.presented) +
+              ", skipped " + u64(p.skipped));
+    p = probe(pacer, 33333);
+    check(!p.due && p.presented == 2,
+          "the next boundary is exactly one slot away", "due true early");
+    p = probe(pacer, 33334);
+    check(p.due && p.presented == 3 && p.skipped == 0,
+          "a caller that lands on every boundary never skips",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    // Cap 30: the same 1/60 s cadence is exactly half the slot rate, so the
+    // pacer presents every other call and still skips nothing.
+    NdsFramePacer half = make_pacer(30, 0, kTickHz);
+    p = probe(half, 0);
+    check(p.due && p.presented == 1, "cap 30 presents at the reset tick",
+          "due " + std::string(p.due ? "true" : "false"));
+    p = probe(half, 16667);
+    check(!p.due && p.presented == 1,
+          "cap 30 holds the second 60 Hz frame back", "presented " +
+              u64(p.presented));
+    p = probe(half, 33334);
+    check(p.due && p.presented == 2 && p.skipped == 0,
+          "cap 30 presents on the second 60 Hz frame",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+}
+
+// ---------------------------------------------------------------------------
+// Drift: 600 frames at a fixed cadence, pinned as a digest
+// ---------------------------------------------------------------------------
+
+// Pinned from the reference implementation, and cross-checked against a
+// separate model written from this header's contract alone (in Python) so the
+// numbers pin the DOCUMENTED behaviour rather than whatever the C++ happens to
+// do. Every step of each run is folded into these digests, so a changed
+// deadline, a changed rounding or a changed skip count anywhere in the 600
+// steps changes the number.
+constexpr uint64_t kDrift60Digest = 0xEA4B71B2CDB08D5Full;
+constexpr uint64_t kDrift30Digest = 0xE9219F8B1B3D244Dull;
+constexpr uint64_t kDrift144Digest = 0xA1D5C904A3AC18F8ull;
+
+void check_drift() {
+    constexpr int kSteps = 600;
+    constexpr uint64_t kCaller60Hz = 16667;
+
+    // 60 fps capped, driven at exactly one slot per frame: every call must
+    // present and nothing may be skipped. Any per-frame rounding drift shows up
+    // here as a false at some step, and any skip shows up in the digest.
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    Cadence run = run_cadence(pacer, kSteps, kCaller60Hz, 0);
+    check(run.due_calls == kSteps,
+          "600 frames at one slot each all present",
+          std::to_string(run.due_calls) + " presented");
+    check(run.presented == 600, "the cap-60 run counts 600 presents",
+          "got " + u64(run.presented));
+    check(run.skipped == 0, "the cap-60 run skips nothing",
+          "got " + u64(run.skipped));
+    check(run.digest == kDrift60Digest,
+          "the cap-60 trajectory matches the pinned digest",
+          hex64(run.digest) + ", want " + hex64(kDrift60Digest));
+    check(run.last_now == 599 * kCaller60Hz,
+          "the cap-60 run ends at the 600th tick stamp",
+          "got " + u64(run.last_now));
+
+    // Cap 30 on the same 60 Hz caller. One slot is exactly two caller steps
+    // (33334 = 2 * 16667), so the pacer presents every other call and, because
+    // every deadline is hit exactly, skips nothing: the cap bites as silence on
+    // every second call, not as skipped slots.
+    NdsFramePacer half = make_pacer(30, 0, kTickHz);
+    Cadence halved = run_cadence(half, kSteps, kCaller60Hz, 0);
+    check(halved.due_calls == 300, "cap 30 presents on half of 600 calls",
+          std::to_string(halved.due_calls) + " presented");
+    check(halved.presented == 300, "the cap-30 run counts 300 presents",
+          "got " + u64(halved.presented));
+    check(halved.skipped == 0,
+          "the cap-30 run skips nothing because its slot is two caller steps",
+          "got " + u64(halved.skipped));
+    check(halved.digest == kDrift30Digest,
+          "the cap-30 trajectory matches the pinned digest",
+          hex64(halved.digest) + ", want " + hex64(kDrift30Digest));
+
+    // Cap 144 is looser than the caller, so every call presents -- but the
+    // pacer still sees 2.4 slots go by per call and counts the unused ones.
+    // That count is a diagnostic of how far the cap sits above the caller, not
+    // a sign that frames were dropped.
+    NdsFramePacer fast = make_pacer(144, 0, kTickHz);
+    Cadence loose = run_cadence(fast, kSteps, kCaller60Hz, 0);
+    check(loose.due_calls == kSteps,
+          "cap 144 lets all 600 calls present",
+          std::to_string(loose.due_calls) + " presented");
+    check(loose.presented == 600, "the cap-144 run counts 600 presents",
+          "got " + u64(loose.presented));
+    check(loose.skipped > 0,
+          "cap 144 counts the slots a slower caller left unused",
+          "skipped " + u64(loose.skipped) + ", want > 0");
+    check(loose.digest == kDrift144Digest,
+          "the cap-144 trajectory matches the pinned digest",
+          hex64(loose.digest) + ", want " + hex64(kDrift144Digest));
+}
+
+// ---------------------------------------------------------------------------
+// Stalls: exactly one present, bounded skip count, phase preserved
+// ---------------------------------------------------------------------------
+
+void check_stall() {
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    Probe p = probe(pacer, 0);
+    if (!check(p.due && p.presented == 1, "the stall fixture presents once",
+               "due " + std::string(p.due ? "true" : "false"))) {
+        return;
+    }
+    // Away for exactly ten slots: one present now, nine slots written off.
+    const uint64_t ten_slots = 10 * 16667;
+    p = probe(pacer, ten_slots);
+    check(p.due && p.presented == 2 && p.skipped == 9,
+          "a ten-slot stall yields one present and nine skipped slots",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    // The second call at the same instant must wait: the deadline is now one
+    // slot in the future, so there is no burst of catch-up frames.
+    p = probe(pacer, ten_slots);
+    check(!p.due && p.presented == 2 && p.skipped == 9,
+          "the call after the stall waits instead of bursting",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    // And normal cadence resumes exactly one slot later, with no further skips.
+    p = probe(pacer, ten_slots + 16667);
+    check(p.due && p.presented == 3 && p.skipped == 9,
+          "normal cadence resumes one slot after the stall",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(pacer, ten_slots + 2 * 16667);
+    check(p.due && p.presented == 4 && p.skipped == 9,
+          "the frame after the stall is on the original grid",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+
+    // The same stall with a remainder. An implementation that advances the
+    // deadline from `now` instead of from the deadline lands on 171670 + 16667
+    // = 188337 here, so the present at 183337 below is what distinguishes them;
+    // an exact multiple of a slot would hide the bug entirely.
+    NdsFramePacer offset = make_pacer(60, 0, kTickHz);
+    probe(offset, 0);
+    p = probe(offset, ten_slots + 5000);
+    check(p.due && p.presented == 2 && p.skipped == 9,
+          "a stall with a 5000-tick remainder still skips exactly nine",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(offset, 10 * 16667 + 16667 - 1);
+    check(!p.due, "the deadline after a ragged stall stays on the old grid",
+          "presented early, which means the deadline moved to `now`");
+    p = probe(offset, 11 * 16667);
+    check(p.due && p.presented == 3,
+          "the ragged stall's next frame lands on the original grid",
+          "due " + std::string(p.due ? "true" : "false") + ", presented " +
+              u64(p.presented));
+    p = probe(offset, 12 * 16667);
+    check(p.due && p.presented == 4 && p.skipped == 9,
+          "the ragged stall recovers to a clean cadence",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+
+    // A stall long enough that the skipped count cannot fit in 32 bits: the
+    // count saturates instead of wrapping to a small number that would read as
+    // "nothing was skipped".
+    NdsFramePacer enormous = make_pacer(60, 0, kTickHz);
+    probe(enormous, 0);
+    p = probe(enormous, 1000000000000000000ull);
+    check(p.due && p.presented == 2,
+          "an eight-month stall still presents exactly once",
+          "presented " + u64(p.presented));
+    check(p.skipped == 0xFFFFFFFFu,
+          "an unspeakable skip count saturates at 0xFFFFFFFF",
+          "skipped " + hex64(p.skipped));
+    p = probe(enormous, 1000000000000000000ull);
+    check(!p.due && p.presented == 2,
+          "an eight-month stall does not cascade into a burst",
+          "presented " + u64(p.presented));
+}
+
+// The skip count for a table of stall lengths. This is the check that pins the
+// arithmetic itself rather than one hand-worked example: the saturating add in
+// should_present() was once tested against the truncated uint32_t, which made
+// EVERY stall of two or more slots report 0xFFFFFFFF. One row of this table
+// (N = 2, want 1) is all it takes to see that, where a single ten-slot example
+// only shows a confusing large number.
+void check_stall_table() {
+    // 300 is deliberate: its skip count (299) does not survive being truncated
+    // to eight bits, so a saturating add that tested the wrong width fails here
+    // even though the small rows all pass.
+    const int lengths[] = {2, 3, 4, 10, 100, 300};
+    for (int slots : lengths) {
+        NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+        probe(pacer, 0);
+        Probe p = probe(pacer, static_cast<uint64_t>(slots) * 16667);
+        const uint32_t wanted = static_cast<uint32_t>(slots - 1);
+        check(p.due && p.presented == 2,
+              "a " + number(slots) + "-slot stall presents exactly once",
+              "presented " + u64(p.presented));
+        if (!check(p.skipped == wanted,
+                   "a " + number(slots) + "-slot stall skips " +
+                       number(slots - 1) + " slot(s)",
+                   "skipped " + u64(p.skipped) + ", want " + u64(wanted))) {
+            // The whole point of the table is to name the first row that is
+            // wrong, so stop instead of printing four more copies.
+            return;
+        }
+    }
+    // The count accumulates across stalls instead of being replaced by the
+    // latest one, which is what makes it usable as a session diagnostic. Slot
+    // k begins at k * 16667: the present at 0 leaves the deadline on slot 1,
+    // the jump to slot 4 skips 3 (slots 1, 2, 3) and leaves the deadline on
+    // slot 5, and the jump to slot 7 skips 2 more (slots 5, 6).
+    NdsFramePacer repeated = make_pacer(60, 0, kTickHz);
+    probe(repeated, 0);
+    probe(repeated, 4 * 16667);
+    Probe p = probe(repeated, 7 * 16667);
+    check(p.skipped == 3 + 2, "two stalls of 3 and 2 slots accumulate 3 + 2",
+          "skipped " + u64(p.skipped));
+    // And it never overflows to a small number when the accumulation reaches
+    // the ceiling: saturate, do not wrap.
+    NdsFramePacer saturating = make_pacer(60, 0, kTickHz);
+    probe(saturating, 0);
+    probe(saturating, 1000000000000000000ull);
+    p = probe(saturating, 2000000000000000000ull);
+    check(p.skipped == 0xFFFFFFFFu,
+          "a second enormous stall keeps the count saturated",
+          "skipped " + hex64(p.skipped));
+}
+
+// A cap at or above the native field rate must never hold a frame back when the
+// caller really is pacing at that rate. The counter still shows the unused
+// slots (the cap sits above the caller), which is why this checks the returned
+// bool and the present count rather than skipped_slots().
+void check_presentation_cap() {
+    const int caps[] = {60, 75, 90, 100, 120, 144};
+    for (int cap : caps) {
+        NdsFramePacer pacer = make_pacer(cap, 0, kTickHz);
+        Cadence run = run_cadence(pacer, 600, 16667, 0);
+        check(run.due_calls == 600,
+              "a cap of " + number(cap) + " holds nothing back at 60 Hz",
+              std::to_string(run.due_calls) + " of 600 calls presented");
+        check(run.presented == 600,
+              "a cap of " + number(cap) + " counts 600 presents",
+              "got " + u64(run.presented));
+    }
+    // 30 is the only listed cap that actually holds frames back at the native
+    // cadence, and it holds back exactly every second one.
+    NdsFramePacer half = make_pacer(30, 0, kTickHz);
+    Cadence run = run_cadence(half, 600, 16667, 0);
+    check(run.due_calls == 300,
+          "a cap of 30 holds back half of a 60 Hz cadence",
+          std::to_string(run.due_calls) + " of 600 calls presented");
+}
+
+// ---------------------------------------------------------------------------
+// set_cap(): raise, lower, idempotence, disable, counters
+// ---------------------------------------------------------------------------
+
+void check_set_cap_raise() {
+    // Raising 30 -> 60 mid-run must take effect on the pending slot, not open
+    // the gates: the deadline was 33334 and stays 33334, so the call at 1000
+    // still waits. Anchoring to `now` would present here and release the frame
+    // early, which is the "burst" this check exists to catch.
+    NdsFramePacer pacer = make_pacer(30, 0, kTickHz);
+    Probe p = probe(pacer, 0);
+    if (!check(p.due && p.presented == 1, "the raise fixture presents once",
+               "due " + std::string(p.due ? "true" : "false"))) {
+        return;
+    }
+    pacer.set_cap(60, 1000);
+    check(pacer.slot_ticks() == 16667, "raising the cap shrinks the slot",
+          "slot " + u64(pacer.slot_ticks()));
+    p = probe(pacer, 1000);
+    check(!p.due && p.presented == 1,
+          "raising 30 -> 60 does not release a backlog",
+          "presented at 1000, which means the deadline moved to `now`");
+    p = probe(pacer, 33333);
+    check(!p.due, "the pending 30 fps deadline is still honoured",
+          "presented one tick early");
+    p = probe(pacer, 33334);
+    check(p.due && p.presented == 2 && p.skipped == 0,
+          "the pending deadline presents, then the 60 fps cadence starts",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(pacer, 50000);
+    check(!p.due, "the new 60 fps slot is measured from the pending deadline",
+          "presented early");
+    p = probe(pacer, 50001);
+    check(p.due && p.presented == 3 && p.skipped == 0,
+          "33334 + 16667 is the second presenting tick",
+          "presented " + u64(p.presented));
+}
+
+void check_set_cap_lower() {
+    // Lowering 120 -> 30 must not stall for a whole new slot. The pending
+    // deadline was 8334 (one 120 fps slot); the call at 5000 waits 3334 more
+    // ticks, which is less than one 30 fps slot (33334), and the deadline is
+    // kept rather than recomputed, so phase survives the edit.
+    NdsFramePacer pacer = make_pacer(120, 0, kTickHz);
+    Probe p = probe(pacer, 0);
+    if (!check(p.due && p.presented == 1, "the lower fixture presents once",
+               "due " + std::string(p.due ? "true" : "false"))) {
+        return;
+    }
+    pacer.set_cap(30, 5000);
+    check(pacer.slot_ticks() == 33334, "lowering the cap grows the slot",
+          "slot " + u64(pacer.slot_ticks()));
+    p = probe(pacer, 8333);
+    check(!p.due, "lowering 120 -> 30 does not present instantly",
+          "presented at 8333");
+    p = probe(pacer, 8334);
+    check(p.due && p.presented == 2 && p.skipped == 0,
+          "lowering the cap presents on the pending deadline",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(pacer, 8334 + 33333);
+    check(!p.due, "the next present is one full 30 fps slot later",
+          "presented a tick early");
+    p = probe(pacer, 8334 + 33334);
+    check(p.due && p.presented == 3,
+          "the 30 fps cadence is in effect after the lowered cap",
+          "presented " + u64(p.presented));
+}
+
+void check_set_cap_idempotent() {
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    probe(pacer, 0);
+    // Same cap twice while the frame is pending: the deadline must not move at
+    // all, so both calls present on the original boundary.
+    pacer.set_cap(60, 1000);
+    pacer.set_cap(60, 2000);
+    Probe p = probe(pacer, 16666);
+    check(!p.due, "a repeated set_cap leaves the deadline alone",
+          "presented a tick early");
+    p = probe(pacer, 16667);
+    check(p.due && p.presented == 2, "the original deadline still presents",
+          "presented " + u64(p.presented));
+    // The one case where a repeated set_cap *does* move the deadline: the
+    // caller is already behind, so the anchor is pulled forward to `now` rather
+    // than left in the past. That keeps the next frame honest (the deadline is
+    // in the future) and still costs no skipped slots, because a cap edit is a
+    // user action, not a stall.
+    pacer.set_cap(60, 50000);
+    p = probe(pacer, 49999);
+    check(!p.due, "a set_cap while behind anchors the deadline to `now`",
+          "presented before the new anchor");
+    p = probe(pacer, 50000);
+    check(p.due && p.presented == 3 && p.skipped == 0,
+          "a set_cap while behind does not charge skipped slots",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+}
+
+void check_set_cap_disable() {
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    probe(pacer, 0);
+    pacer.set_cap(0, 5000);
+    check(!pacer.active(), "set_cap(0) deactivates the pacer",
+          "active() is true");
+    check(pacer.cap() == 0, "set_cap(0) records the unlimited cap",
+          "cap " + number(pacer.cap()));
+    // The deadline is cleared as well as the cap. `next_slot_` is a public
+    // field -- the header exposes it "so the caller (and its tests) can reason
+    // about the same numbers the implementation uses" -- and leaving a stale
+    // tick in it is invisible through the other accessors today, because the
+    // re-enable below overwrites it. Pinning it keeps the clearing honest
+    // instead of letting a later refactor read a leftover deadline.
+    check(pacer.next_slot_ == 5000,
+          "set_cap(0) leaves no stale deadline behind",
+          "next_slot_ " + u64(pacer.next_slot_) + ", want 5000");
+    // Unlimited means every call presents, and the counters keep counting, so a
+    // settings panel can show the raw frame rate while the cap is off.
+    Probe p = probe(pacer, 5000);
+    check(p.due && p.presented == 2, "unlimited presents immediately",
+          "presented " + u64(p.presented));
+    p = probe(pacer, 5001);
+    check(p.due && p.presented == 3, "unlimited presents on the next tick",
+          "presented " + u64(p.presented));
+    p = probe(pacer, 5001);
+    check(p.due && p.presented == 4, "unlimited presents twice in one tick",
+          "presented " + u64(p.presented));
+    check(pacer.suggested_sleep_ms(5001) == 0,
+          "unlimited never asks the caller to sleep",
+          "sleep " + u64(pacer.suggested_sleep_ms(5001)));
+    check(pacer.measured_fps(5001) == 0.0,
+          "unlimited reports no measured rate", "measured_fps is non-zero");
+
+    // Back on: the first frame after re-enabling is due immediately. The
+    // re-enable here happens at a tick BEFORE the disable anchor, which is the
+    // only ordering that distinguishes "anchor to now" from "honour the stale
+    // deadline": a deadline set while pacing was off must never gate a frame.
+    NdsFramePacer revived = make_pacer(60, 0, kTickHz);
+    revived.set_cap(0, 20000);
+    revived.set_cap(60, 15000);
+    check(revived.active(), "set_cap(60) re-activates the pacer",
+          "active() is false");
+    Probe r = probe(revived, 15000);
+    check(r.due && r.presented == 1,
+          "re-enabling presents immediately instead of honouring the old "
+          "anchor",
+          "due " + std::string(r.due ? "true" : "false"));
+    r = probe(revived, 15000 + 16667);
+    check(r.due && r.presented == 2,
+          "the re-enabled pacer runs at the new cadence",
+          "presented " + u64(r.presented));
+}
+
+void check_set_cap_counters() {
+    NdsFramePacer pacer = make_pacer(30, 0, kTickHz);
+    probe(pacer, 0);
+    probe(pacer, 33334);
+    probe(pacer, 66668);
+    check(pacer.presented() == 3, "the counter fixture presented three times",
+          "got " + u64(pacer.presented()));
+    pacer.set_cap(60, 66668);
+    check(pacer.presented() == 3,
+          "set_cap keeps the present counter",
+          "got " + u64(pacer.presented()));
+    // The pending 30 fps deadline (100002) is still the anchor after the edit,
+    // so the next frame is due there and not one new 60 fps slot after `now`.
+    check(pacer.slot_ticks() == 16667,
+          "set_cap resizes the slot for the new cap",
+          "slot " + u64(pacer.slot_ticks()) + ", want 16667");
+    probe(pacer, 100002);
+    check(pacer.presented() == 4,
+          "the counter keeps counting after a cap edit",
+          "got " + u64(pacer.presented()));
+
+    // The slots themselves prove the resize: after the edit the deadline is
+    // still 33334 (the pending 30 fps one), but the slot that follows it is
+    // 16667, so the next two presents land one 60 fps slot apart. A stale
+    // 33334-tick slot would let the second one through only at 66668.
+    NdsFramePacer resized = make_pacer(30, 0, kTickHz);
+    probe(resized, 0);
+    resized.set_cap(60, 0);
+    probe(resized, 33334);
+    Probe r = probe(resized, 50000);
+    check(!r.due, "the resized slot still honours the pending deadline",
+          "presented at 50000, so the slot did not shrink");
+    r = probe(resized, 50001);
+    check(r.due && r.presented == 3,
+          "the resized slot lets the 60 fps cadence through after the edit",
+          "presented " + u64(r.presented) + ", due " +
+              std::string(r.due ? "true" : "false"));
+    pacer.reset(60, 0, kTickHz);
+    check(pacer.presented() == 0 && pacer.skipped_slots() == 0,
+          "reset clears both counters",
+          "presented " + u64(pacer.presented()) + ", skipped " +
+              u64(pacer.skipped_slots()));
+}
+
+// ---------------------------------------------------------------------------
+// suggested_sleep_ms()
+// ---------------------------------------------------------------------------
+
+void check_sleep() {
+    NdsFramePacer pacer = make_pacer(60, 0, kTickHz);
+    check(pacer.suggested_sleep_ms(0) == 0,
+          "a due frame asks for no sleep",
+          "sleep " + u64(pacer.suggested_sleep_ms(0)));
+    probe(pacer, 0);
+    // A whole 60 fps slot is 16.667 ms, which rounds UP to 17: a floor of 16
+    // would wake before the deadline and sleep again.
+    check(pacer.suggested_sleep_ms(0) == 17,
+          "the top of a 60 fps slot sleeps 17 ms",
+          "sleep " + u64(pacer.suggested_sleep_ms(0)));
+    check(pacer.suggested_sleep_ms(16666) == 1,
+          "the last tick before a deadline sleeps 1 ms, not 0",
+          "sleep " + u64(pacer.suggested_sleep_ms(16666)));
+    check(pacer.suggested_sleep_ms(10000) == 7,
+          "two thirds through the slot sleeps 7 ms",
+          "sleep " + u64(pacer.suggested_sleep_ms(10000)));
+    check(pacer.suggested_sleep_ms(16667) == 0,
+          "a frame that has come due asks for no sleep",
+          "sleep " + u64(pacer.suggested_sleep_ms(16667)));
+    check(pacer.suggested_sleep_ms(999999) == 0,
+          "an overdue frame asks for no sleep",
+          "sleep " + u64(pacer.suggested_sleep_ms(999999)));
+    // Monotone: the further the clock is from the deadline, the longer the
+    // sleep, up to one slot. A caller that sleeps the same amount at every
+    // offset either overshoots or spins.
+    const uint64_t offsets[] = {16666, 16000, 12000, 8000, 4000, 1, 0};
+    uint32_t previous = 0;
+    for (uint64_t now : offsets) {
+        const uint32_t slept = pacer.suggested_sleep_ms(now);
+        check(slept >= previous, "sleep is monotone at now=" + u64(now),
+              "sleep " + u64(slept) + " is shorter than the previous " +
+                  u64(previous));
+        previous = slept;
+    }
+    check(previous == 17, "the whole-slot sleep is the longest suggestion",
+          "got " + u64(previous));
+
+    // Sweeps over whole pending intervals: never 0 (that would spin), never
+    // more than one slot's milliseconds (that would overshoot by a slot).
+    NdsFramePacer sweep60 = make_pacer(60, 0, kTickHz);
+    probe(sweep60, 0);
+    std::string bad = sweep_sleep(sweep60, 16667, 17);
+    check(bad.empty(), "every cap-60 sleep is in 1..17 ms", bad);
+
+    NdsFramePacer sweep144 = make_pacer(144, 0, kTickHz);
+    probe(sweep144, 0);
+    check(sweep144.slot_ticks() == 6945, "the 144 fps slot is 6945 ticks",
+          "slot " + u64(sweep144.slot_ticks()));
+    bad = sweep_sleep(sweep144, 6945, 7);
+    check(bad.empty(), "every cap-144 sleep is in 1..7 ms", bad);
+
+    NdsFramePacer sweep30 = make_pacer(30, 0, kTickHz);
+    probe(sweep30, 0);
+    bad = sweep_sleep(sweep30, 33334, 34);
+    check(bad.empty(), "every cap-30 sleep is in 1..34 ms", bad);
+
+    // A nanosecond tick rate is where a floor turns the last tick into 0 ms and
+    // the frame loop spins at full tilt. Rounding up must return 1.
+    NdsFramePacer fine = make_pacer(144, 0, 1000000000);
+    probe(fine, 0);
+    const uint64_t fine_slot = fine.slot_ticks();
+    check(fine_slot == 6944445, "the nanosecond 144 fps slot is 6944445",
+          "slot " + u64(fine_slot));
+    check(fine.suggested_sleep_ms(fine_slot - 1) == 1,
+          "one nanosecond before the deadline still sleeps 1 ms",
+          "sleep " + u64(fine.suggested_sleep_ms(fine_slot - 1)));
+
+    // The one-clamp-at-a-slot bound is NOT only reachable from an on-time
+    // caller: while the pacing is normal the remaining time is always at most
+    // one slot, so `min(millis, slot_millis)` would look redundant. A clock
+    // that runs backwards makes the remaining time many slots wide, and that is
+    // when the bound is all that stops the caller from sleeping through the
+    // deadline. Reset at 100000, consume the first frame, then ask from tick 0:
+    // the raw remaining time is 116667 ticks = 117 ms, but one slot is 17 ms.
+    NdsFramePacer backwards = make_pacer(60, 100000, kTickHz);
+    probe(backwards, 100000);
+    check(backwards.suggested_sleep_ms(0) == 17,
+          "a backwards clock sleeps one slot, not the whole distance to the "
+          "deadline",
+          "sleep " + u64(backwards.suggested_sleep_ms(0)) +
+              ", want 17 (one slot)");
+
+    // The "at least 1 ms" bound is not decoration either. `remaining_ticks *
+    // 1000` is a 64-bit multiply, so a deadline far enough ahead wraps it to
+    // exactly zero: a reset at 2^61 ticks makes the remaining time 2^61 and
+    // 2^61 * 1000 == 125 * 2^64 == 0 (mod 2^64). The rounding then yields 0 ms
+    // for a frame that is genuinely pending -- a frame loop that spins -- which
+    // is the one case the clamp exists for.
+    constexpr uint64_t kOverflowTick = 1ull << 61;
+    NdsFramePacer wrapped = make_pacer(60, kOverflowTick, kTickHz);
+    check(wrapped.suggested_sleep_ms(0) == 1,
+          "a clock 2^61 ticks from the deadline still sleeps at least 1 ms",
+          "sleep " + u64(wrapped.suggested_sleep_ms(0)) +
+              " (the multiply wrapped to 0)");
+}
+
+// ---------------------------------------------------------------------------
+// suggested_sleep_ms() driven the way a frame loop drives it
+// ---------------------------------------------------------------------------
+//
+// `check_sleep()` above pins single calls: it asks the same pacer about many
+// clock readings and never advances anything. This fixture pins the LOOP
+// contract the header describes -- sleep as suggested, advance the clock by
+// what those milliseconds are worth, ask again -- because three failures only
+// appear once the sleep's return value is fed back into the clock:
+//
+//   * A sleep of 0 while a frame is pending is a spin: the loop burns a core at
+//     100% and the frame is still not due. A sleep longer than one slot is an
+//     overshoot: the caller sleeps through the deadline and, because the pacer
+//     counts missed slots, presents one frame and drops the rest. Neither shows
+//     up in a single call -- the first is legal on the very tick the frame is
+//     due, and the second is legal whenever the clock is over a slot away.
+//   * Sleeping the suggestion must land ON the deadline rather than just before
+//     it. Rounding down wakes one millisecond early, the loop sleeps again, and
+//     the number of loop iterations per present doubles -- which is why the
+//     pinned `steps` here is always `presents - 1` and a floor implementation
+//     reports 398 steps where this one reports 199.
+//   * A cap raised while the caller is asleep must not move the deadline the
+//     caller is already sleeping toward. `set_cap` re-anchors to
+//     `max(now, next_slot)`, so the wake still lands on the old deadline and
+//     the new slot length only affects the deadline after it.
+//
+// NOTE: as of this writing the frontend's frame loop does NOT call
+// suggested_sleep_ms(). The loop drains audio and lets the audio clock pace it,
+// and the only SDL_Delay on the frame path is the paused-menu one
+// (`frontend.cpp`, the `menu_holds_machine` branch). So these checks pin a
+// published part of the module's contract that has no caller in the tree yet.
+// They are a specification for wiring it up, and they hold regardless of
+// whether the call site is ever added: nothing here reads the frontend.
+//
+// The grid is every menu cap against four tick rates chosen for the arithmetic
+// they force, plus a zero tick rate where pacing is disabled and no frame can
+// ever be pending: 1000 (1 ms per tick, so a coarse 30 fps slot is 34 ticks),
+// 60000 (a realistic SDL counter rate, 60 fps slot exactly 1000 ticks), 1 MHz
+// (the rest of this file) and 3 MHz (a high-resolution counter where a 144 fps
+// slot is 20834 ticks, not a round number anywhere).
+
+// One slot's worth of milliseconds, rounded up the same way the module does.
+// Computed here rather than exposed by the module: it is the bound the loop is
+// allowed to sleep, and the test should not trust the module to hand it back.
+uint64_t slot_millis(const NdsFramePacer& pacer) {
+    const uint64_t ticks_per_second = pacer.ticks_per_second();
+    if (ticks_per_second == 0) return 0;
+    const uint64_t scaled = pacer.slot_ticks() * 1000u;
+    return scaled / ticks_per_second +
+           (scaled % ticks_per_second != 0 ? 1u : 0u);
+}
+
+// One frame loop, set AND driven by the module: the loop sleeps exactly as long
+// as it is told, advances the clock by the ticks those milliseconds are worth,
+// and asks again. `digest` folds in the sleep, the verdict and both counters
+// after every iteration, so a cell's whole trajectory is one number.
+struct LoopRun {
+    int steps;
+    int spins;      // sleeps that came back 0 while the frame was pending
+    uint32_t presented;
+    uint32_t skipped;
+    uint64_t now;
+    uint64_t digest;
+};
+
+LoopRun run_sleep_loop(NdsFramePacer& pacer, int presents) {
+    LoopRun run{0, 0, 0, 0, 0, kFnvSeed};
+    const uint64_t ticks_per_second = pacer.ticks_per_second();
+    uint64_t now = 0;
+    pacer.should_present(now);
+    int count = 1;
+    while (count < presents) {
+        const uint32_t slept = pacer.suggested_sleep_ms(now);
+        if (slept == 0) ++run.spins;
+        // A disabled pacer suggests 0 forever, so the loop has no sleep to
+        // advance by; one tick per iteration is the only thing that terminates.
+        // That cell is asserted separately rather than folded in here.
+        uint64_t advance = ticks_per_second == 0
+            ? 1u
+            : static_cast<uint64_t>(slept) * ticks_per_second / 1000u;
+        if (advance == 0) advance = 1;
+        now += advance;
+        const bool due = pacer.should_present(now);
+        run.digest = fnv1a64(run.digest, slept);
+        run.digest = fnv1a64(run.digest, due ? 1u : 0u);
+        run.digest = fnv1a64(run.digest, pacer.presented());
+        run.digest = fnv1a64(run.digest, pacer.skipped_slots());
+        ++run.steps;
+        if (due) ++count;
+        if (run.steps > 20000) break;
+    }
+    run.presented = pacer.presented();
+    run.skipped = pacer.skipped_slots();
+    run.now = now;
+    return run;
+}
+
+// Asks for a sleep at every clock reading from `remaining` slots before the
+// deadline down to `remaining = 1`, in `slot/7` steps, then once at the
+// deadline itself. Returns the first violation as text (empty when clean); the
+// four bounds are the loop's whole safety argument:
+//   * never 0 while the frame is pending (spin),
+//   * never more than one slot's milliseconds (overshoot),
+//   * waking from at most a slot away always reaches the deadline (no early
+//     wake, which costs an extra iteration),
+//   * waking from further away never lands a whole slot past it either.
+//
+// The pacer must have already presented once from a clock reading at least
+// `2 * slot` (the sweep clocks are unsigned, so a deadline near zero would
+// wrap), which is why the caller anchors it at kSweepAnchor.
+constexpr uint64_t kSweepAnchor = 4000000;  // > 2 slots at every rate below
+
+std::string sweep_sleep_to_deadline(NdsFramePacer& pacer) {
+    if (!pacer.active()) {
+        // No slot exists, so no frame can be pending and 0 is the only honest
+        // answer at every reading. The loop cell below covers this case.
+        for (uint64_t now = 0; now < 1000; now += 111) {
+            const uint32_t slept = pacer.suggested_sleep_ms(now);
+            if (slept != 0) {
+                return "inactive pacer slept " + u64(slept) +
+                       " ms at now=" + u64(now);
+            }
+        }
+        return std::string();
+    }
+    const uint64_t slot = pacer.slot_ticks();
+    const uint64_t bound = slot_millis(pacer);
+    const uint64_t deadline = pacer.next_slot_;
+    const uint64_t step = std::max<uint64_t>(1u, slot / 7u);
+    for (uint64_t remaining = 1; remaining <= 2 * slot; remaining += step) {
+        const uint64_t now = deadline - remaining;
+        const uint32_t slept = pacer.suggested_sleep_ms(now);
+        const uint64_t wake =
+            now + static_cast<uint64_t>(slept) *
+                      pacer.ticks_per_second() / 1000u;
+        if (slept == 0) {
+            return "sleep 0 while " + u64(remaining) +
+                   " ticks pending at now=" + u64(now);
+        }
+        if (slept > bound) {
+            return "sleep " + u64(slept) + " ms exceeds one slot (" +
+                   u64(bound) + " ms) at now=" + u64(now);
+        }
+        if (remaining <= slot && wake < deadline) {
+            return "woke " + u64(deadline - wake) +
+                   " ticks early from remaining=" + u64(remaining) +
+                   " (slept " + u64(slept) + " ms)";
+        }
+        if (remaining <= slot && wake - deadline >= slot) {
+            return "woke a whole slot past the deadline from remaining=" +
+                   u64(remaining) + " (overshot " + u64(wake - deadline) + ")";
+        }
+        if (remaining > slot && wake >= deadline + slot) {
+            return "woke " + u64(wake - deadline) +
+                   " ticks past the deadline, more than a slot, from "
+                   "remaining=" + u64(remaining);
+        }
+    }
+    if (pacer.suggested_sleep_ms(deadline) != 0) {
+        return "slept " + u64(pacer.suggested_sleep_ms(deadline)) +
+               " ms on a frame that is already due";
+    }
+    return std::string();
+}
+
+void check_suggested_sleep_in_loop() {
+    struct Cell {
+        int cap;
+        uint64_t ticks_per_second;
+        uint64_t now;      // clock reading after the last present
+        uint64_t digest;
+    };
+    // 200 presents per cell. Every cell reports 199 steps, so every sleep lands
+    // exactly on a deadline: a floor implementation reports 398 at cap 45/1 MHz
+    // and a slot-floor one reports 266 at cap 30/3 MHz.
+    const Cell cells[] = {
+        {30, 1000, 6766, 0x7585C43D6B647DAFull},
+        {30, 60000, 398040, 0x2204419ACB232FAFull},
+        {30, 1000000, 6634000, 0x72C876CF80D96AAFull},
+        {30, 3000000, 19902000, 0x2204419ACB232FAFull},
+        {45, 1000, 4577, 0xA9750D6F10EA6E1Aull},
+        {45, 60000, 265500, 0xAA462FBC87DAB09Aull},
+        {45, 1000000, 4423000, 0x3A14DDE817D1915Aull},
+        {45, 3000000, 13269000, 0x423FEF4DF94F82DAull},
+        {60, 1000, 3383, 0x28BB2D8FA7A59F1Cull},
+        {60, 60000, 199020, 0x6468109C1A4222DCull},
+        {60, 1000000, 3317000, 0x93A0EF7A5E460ADCull},
+        {60, 3000000, 9951000, 0x6468109C1A4222DCull},
+        {75, 1000, 2786, 0xB8E3D0C821E0C483ull},
+        {75, 60000, 159240, 0x595A6FCCC3CE2783ull},
+        {75, 1000000, 2654000, 0xAE439BADB9C0BB83ull},
+        {75, 3000000, 7962000, 0x595A6FCCC3CE2783ull},
+        {90, 1000, 2388, 0x32DB0C7E5F331181ull},
+        {90, 60000, 132780, 0x66729EF9A0DB8E06ull},
+        {90, 1000000, 2212000, 0x980AA388214AB081ull},
+        {90, 3000000, 6636000, 0xF8A770F5DDDC5201ull},
+        {100, 1000, 1990, 0xA0BE2C6C2145A887ull},
+        {100, 60000, 119400, 0xA0BE2C6C2145A887ull},
+        {100, 1000000, 1990000, 0xA0BE2C6C2145A887ull},
+        {100, 3000000, 5970000, 0xA0BE2C6C2145A887ull},
+        {120, 1000, 1791, 0x66375D83E79B4B04ull},
+        {120, 60000, 99540, 0x738E77C630749484ull},
+        {120, 1000000, 1659000, 0xEF34925D919AA504ull},
+        {120, 3000000, 4977000, 0x738E77C630749484ull},
+        {144, 1000, 1393, 0xB5986A115678CE0Aull},
+        {144, 60000, 83040, 0x1E09B8667F55890Bull},
+        {144, 1000000, 1383000, 0x2EE0C9EA1C935CCAull},
+        {144, 3000000, 4146000, 0x5F3AFF780DB9544Bull},
+    };
+    uint64_t grid = kFnvSeed;
+    for (const Cell& tc : cells) {
+        NdsFramePacer pacer = make_pacer(tc.cap, 0, tc.ticks_per_second);
+        const LoopRun run = run_sleep_loop(pacer, 200);
+        const std::string name = "cap " + number(tc.cap) + " at " +
+                                 u64(tc.ticks_per_second) + " Hz";
+        check(run.steps == 199 && run.presented == 200 && run.skipped == 0 &&
+                  run.spins == 0 && run.now == tc.now &&
+                  run.digest == tc.digest,
+              name + " sleeps exactly to its deadline 200 times",
+              "steps=" + number(run.steps) + " (want 199) presented=" +
+                  u64(run.presented) + " skipped=" + u64(run.skipped) +
+                  " spins=" + number(run.spins) + " now=" + u64(run.now) +
+                  " (want " + u64(tc.now) + ") digest=" + hex64(run.digest) +
+                  " (want " + hex64(tc.digest) + ")");
+        grid = fnv1a64(grid, run.digest);
+    }
+    // The whole 32-cell trajectory as one number. Each cell pins its own
+    // digest above; this catches a cell being dropped from the table, and it is
+    // the value an independent model written from the header reproduces.
+    check(grid == 0xCAC298ADF296DF3Aull,
+          "the 32 cells fold to the pinned loop digest",
+          "grid " + hex64(grid) + ", want 0xCAC298ADF296DF3A");
+
+    // The four invariants, swept at every clock reading near a deadline. This
+    // is the part a single-call fixture cannot do: it needs a pacer that has
+    // already presented once, so `next_slot_` is a real deadline rather than
+    // the reset anchor.
+    const int caps[] = {30, 45, 60, 75, 90, 100, 120, 144};
+    const uint64_t rates[] = {1000, 60000, 1000000, 3000000, 0};
+    for (int cap : caps) {
+        for (uint64_t rate : rates) {
+            NdsFramePacer pacer = make_pacer(cap, kSweepAnchor, rate);
+            pacer.should_present(kSweepAnchor);
+            const std::string bad = sweep_sleep_to_deadline(pacer);
+            const std::string label = "cap " + number(cap) + " at " +
+                                      u64(rate) + " Hz";
+            if (rate == 0) {
+                check(bad.empty(),
+                      label + " is inactive, so it never asks for a sleep",
+                      bad);
+            } else {
+                check(bad.empty(),
+                      label + " sleeps in 1.." +
+                          u64(slot_millis(pacer)) +
+                          " ms and always wakes on time",
+                      bad);
+            }
+        }
+    }
+
+    // A sleep at one tick before the deadline must not wake a whole tick short:
+    // the loop below only terminates when should_present() is true, so an early
+    // wake costs one extra iteration per frame at every cap. Asserted as its
+    // own check because the aggregate sweep above reports only the first
+    // violation.
+    bool edge_clean = true;
+    std::string edge_detail;
+    for (int cap : caps) {
+        NdsFramePacer pacer = make_pacer(cap, kSweepAnchor, kTickHz);
+        pacer.should_present(kSweepAnchor);
+        const uint64_t deadline = pacer.next_slot_;
+        const bool early = pacer.should_present(deadline - 1);
+        const bool on_time = pacer.should_present(deadline);
+        if (early || !on_time) {
+            edge_clean = false;
+            if (edge_detail.empty()) {
+                edge_detail = "cap " + number(cap) + " at deadline " +
+                              u64(deadline) + " early=" + number(early) +
+                              " on_time=" + number(on_time);
+            }
+        }
+        if (pacer.next_slot_ != deadline + pacer.slot_ticks()) {
+            edge_clean = false;
+            if (edge_detail.empty()) {
+                edge_detail = "cap " + number(cap) + " next_slot_ " +
+                              u64(pacer.next_slot_) + " after a present at " +
+                              u64(deadline) + " (want " +
+                              u64(deadline + pacer.slot_ticks()) + ")";
+            }
+        }
+    }
+    check(edge_clean,
+          "a present on the deadline advances exactly one slot, one tick "
+          "earlier presents nothing",
+          edge_detail);
+
+    // Raising the cap while the caller is asleep: the sleep it already took
+    // must not be wasted. At 40% of a 60 fps slot the caller has slept 11 ms
+    // toward tick 16667; set_cap(144) shrinks the slot to 6945 and re-anchors
+    // to `max(now, next_slot)` = 16667, so the wake still lands on 16667 and
+    // only the DEADLINE AFTER IT moves by the new slot. If set_cap re-anchored
+    // to `now` instead, the caller would present at 6666 and every frame after
+    // it would shift by however long it had already slept.
+    constexpr uint64_t kMidSleep = 6666;
+    NdsFramePacer raised = make_pacer(60, 0, kTickHz);
+    raised.should_present(0);
+    check(raised.next_slot_ == 16667, "the 60 fps deadline is 16667",
+          "next_slot_ " + u64(raised.next_slot_));
+    check(raised.suggested_sleep_ms(kMidSleep) == 11,
+          "40% into a 60 fps slot the loop is told to sleep 11 ms",
+          "sleep " + u64(raised.suggested_sleep_ms(kMidSleep)));
+    raised.set_cap(144, kMidSleep);
+    check(raised.slot_ticks() == 6945 && raised.next_slot_ == 16667,
+          "raising the cap mid-sleep keeps the deadline the caller slept "
+          "toward",
+          "slot " + u64(raised.slot_ticks()) + " next_slot_ " +
+              u64(raised.next_slot_) + " (want 6945 and 16667)");
+    check(!raised.should_present(kMidSleep),
+          "waking from the old sleep does not present at the mid-sleep tick",
+          "presented at " + u64(kMidSleep));
+    check(!raised.should_present(16666),
+          "the tick before the old deadline is still not due",
+          "presented at 16666");
+    check(raised.should_present(16667),
+          "the old deadline still releases exactly one frame",
+          "no present at 16667");
+    check(raised.next_slot_ == 16667 + 6945,
+          "the next deadline uses the new slot length",
+          "next_slot_ " + u64(raised.next_slot_) + " want " +
+              u64(16667 + 6945));
+
+    // The same sleep against a LOWER cap: the slot grows to 33334, which is
+    // longer than the 16667 the caller already waited, so the deadline it slept
+    // toward is still the right one to honour and the frame is due on it.
+    NdsFramePacer lowered = make_pacer(60, 0, kTickHz);
+    lowered.should_present(0);
+    lowered.set_cap(30, kMidSleep);
+    check(lowered.slot_ticks() == 33334 && lowered.next_slot_ == 16667,
+          "lowering the cap mid-sleep also keeps the deadline",
+          "slot " + u64(lowered.slot_ticks()) + " next_slot_ " +
+              u64(lowered.next_slot_));
+    check(lowered.should_present(16667) && lowered.next_slot_ == 50001,
+          "the lowered cap's first deadline advances by the 30 fps slot",
+          "next_slot_ " + u64(lowered.next_slot_) + " want 50001");
+
+    // A pacer that is inactive has no slot to sleep toward, and the loop must
+    // not be told to wait for a deadline that will never arrive.
+    NdsFramePacer off = make_pacer(0, 0, kTickHz);
+    off.should_present(0);
+    bool off_clean = true;
+    for (uint64_t now = 0; now < 100000; now += 1000) {
+        if (off.suggested_sleep_ms(now) != 0) off_clean = false;
+    }
+    check(off_clean, "cap 0 never asks the loop to sleep, at any clock reading",
+          "a cap-0 pacer returned a non-zero sleep");
+}
+
+// ---------------------------------------------------------------------------
+// Degenerate input: no tick rate, corrupt cap, backwards clock
+// ---------------------------------------------------------------------------
+
+void check_degenerate() {
+    // A zero tick rate cannot describe a slot, so pacing is off and the caller
+    // is never told to sleep: dividing by it would be a crash on the frame
+    // loop's first tick.
+    NdsFramePacer zero = make_pacer(60, 0, 0);
+    check(!zero.active(), "a zero tick rate disables pacing",
+          "active() is true");
+    check(zero.slot_ticks() == 0, "a zero tick rate has no slot",
+          "slot " + u64(zero.slot_ticks()));
+    Probe p = probe(zero, 0);
+    check(p.due, "a disabled pacer presents", "due false");
+    p = probe(zero, 0);
+    check(p.due && p.presented == 2, "a disabled pacer always presents",
+          "presented " + u64(p.presented));
+    check(zero.suggested_sleep_ms(0) == 0,
+          "a disabled pacer never sleeps",
+          "sleep " + u64(zero.suggested_sleep_ms(0)));
+    check(zero.measured_fps(1000000) == 0.0,
+          "a disabled pacer reports no measured rate",
+          "measured_fps is non-zero");
+
+    // A corrupt negative cap is repaired to the floor, not left negative (which
+    // would make a negative slot and a negative deadline).
+    NdsFramePacer negative = make_pacer(-5, 0, kTickHz);
+    check(negative.cap() == 30, "a negative cap repairs to 30",
+          "cap " + number(negative.cap()));
+    check(negative.slot_ticks() == 33334,
+          "a repaired negative cap has the 30 fps slot",
+          "slot " + u64(negative.slot_ticks()));
+    check(negative.active(), "a repaired negative cap is active",
+          "active() is false");
+
+    // Cap 0 with a valid tick rate is the shipped default: pacing off, frame
+    // counting on.
+    NdsFramePacer unlimited = make_pacer(0, 0, kTickHz);
+    check(!unlimited.active(), "cap 0 disables pacing with a valid tick rate",
+          "active() is true");
+    check(unlimited.suggested_sleep_ms(0) == 0,
+          "cap 0 never sleeps",
+          "sleep " + u64(unlimited.suggested_sleep_ms(0)));
+
+    // A clock that runs backwards is compared as an unsigned "too early", so
+    // the pacer simply waits for the deadline it already has. It must not
+    // reinterpret the difference as a huge lateness and present in a loop.
+    NdsFramePacer backwards = make_pacer(60, 100000, kTickHz);
+    p = probe(backwards, 100000);
+    check(p.due && p.presented == 1, "the backwards fixture presents once",
+          "presented " + u64(p.presented));
+    p = probe(backwards, 90000);
+    check(!p.due && p.presented == 1 && p.skipped == 0,
+          "a clock 10000 ticks backwards waits instead of presenting",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(backwards, 0);
+    check(!p.due && p.presented == 1 && p.skipped == 0,
+          "a clock reset to zero waits instead of presenting",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    p = probe(backwards, 116667);
+    check(p.due && p.presented == 2 && p.skipped == 0,
+          "the deadline still presents once the clock catches up",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+    // A backwards clock that comes back to the far future must also behave:
+    // the skipped count is charged, not the presented count.
+    p = probe(backwards, 116667 + 5 * 16667);
+    check(p.due && p.presented == 3 && p.skipped == 4,
+          "recovering from a backwards clock charges skipped slots",
+          "presented " + u64(p.presented) + ", skipped " + u64(p.skipped));
+}
+
+// ---------------------------------------------------------------------------
+// measured_fps()
+// ---------------------------------------------------------------------------
+
+void check_measured_fps() {
+    // Since-reset average: no presents yet, and a window that has not advanced,
+    // both read 0 rather than dividing by zero.
+    NdsFramePacer idle = make_pacer(60, 0, kTickHz);
+    check(idle.measured_fps(0) == 0.0,
+          "a fresh pacer reports no measured rate",
+          "measured_fps is non-zero");
+    check(idle.measured_fps(1000000) == 0.0,
+          "a pacer with no presents reports no measured rate",
+          "measured_fps is non-zero");
+    probe(idle, 0);
+    check(idle.measured_fps(0) == 0.0,
+          "a present at the window start still reports nothing",
+          "measured_fps is non-zero");
+
+    // Two presents inside one slot: the reset present lands at elapsed 0, so
+    // the early estimate is biased high (2 frames in one slot reads ~120 fps).
+    // That is a property of a since-reset average, and pinning it keeps a later
+    // "improvement" to a sliding window from silently changing the reported
+    // number the overlay shows.
+    NdsFramePacer early = make_pacer(60, 0, kTickHz);
+    probe(early, 0);
+    probe(early, 16667);
+    const double early_fps = early.measured_fps(16667);
+    check(early_fps > 119.9 && early_fps < 120.1,
+          "two presents in one slot read about 120 fps",
+          std::to_string(early_fps));
+
+    // The headline case: cap 60 driven at one slot per frame reads ~60 fps
+    // (measured over 599 elapsed slots for 600 presents, so it reads high by
+    // 1/599, well inside the 1% the panel needs).
+    NdsFramePacer sixty = make_pacer(60, 0, kTickHz);
+    Cadence run = run_cadence(sixty, 600, 16667, 0);
+    const double fps60 = sixty.measured_fps(run.last_now);
+    check(fps60 > 59.4 && fps60 < 60.6,
+          "cap 60 at a 60 Hz cadence reads about 60 fps",
+          std::to_string(fps60));
+
+    NdsFramePacer thirty = make_pacer(30, 0, kTickHz);
+    Cadence halved = run_cadence(thirty, 600, 16667, 0);
+    const double fps30 = thirty.measured_fps(halved.last_now);
+    check(fps30 > 29.7 && fps30 < 30.3,
+          "cap 30 at a 60 Hz cadence reads about 30 fps",
+          std::to_string(fps30));
+
+    // A measurement window that does NOT start at tick zero. Every
+    // elapsed-time bug hides when the reset tick is 0, because
+    // `now - window_start` and `now` are then the same number; this fixture is
+    // the one that tells them apart.
+    NdsFramePacer offset = make_pacer(60, 500000, kTickHz);
+    probe(offset, 500000);
+    probe(offset, 516667);
+    const double offset_fps = offset.measured_fps(516667);
+    check(offset_fps > 119.9 && offset_fps < 120.1,
+          "a 500 ms-old window measures elapsed ticks from the reset, not "
+          "from zero",
+          std::to_string(offset_fps));
+
+    // A long pause then a single present must not read as an absurd rate: it
+    // reads the honest average (2 presents in 10 s = 0.2 fps), not the 60 the
+    // cap was configured for.
+    NdsFramePacer paused = make_pacer(60, 0, kTickHz);
+    probe(paused, 0);
+    probe(paused, 10000000);
+    const double fps_paused = paused.measured_fps(10000000);
+    check(fps_paused > 0.19 && fps_paused < 0.21,
+          "a ten-second pause reads 0.2 fps, not the configured cap",
+          std::to_string(fps_paused));
+
+    // A cap edit keeps the measurement window, so the rate does not jump the
+    // instant a player changes the setting.
+    NdsFramePacer edited = make_pacer(60, 0, kTickHz);
+    probe(edited, 0);
+    probe(edited, 16667);
+    const double before = edited.measured_fps(16667);
+    edited.set_cap(30, 16667);
+    check(edited.measured_fps(16667) == before,
+          "set_cap keeps the measurement window",
+          "before " + std::to_string(before) + ", after " +
+              std::to_string(edited.measured_fps(16667)));
+    // And reset starts a fresh window, so the first frame after a reset is not
+    // charged against the previous cap's elapsed time.
+    edited.reset(30, 16667, kTickHz);
+    check(edited.measured_fps(16667) == 0.0,
+          "reset starts a fresh measurement window",
+          "measured_fps is non-zero after reset");
+}
+
+// ---------------------------------------------------------------------------
+// Determinism: an uneven 1000-step clock, twice
+// ---------------------------------------------------------------------------
+
+constexpr uint64_t kWalkDigest = 0x69C6644A3A85F302ull;
+
+// The walk's totals, cross-checked against the same independent model. They are
+// separate from the digest so a failure says WHICH number moved: a digest tells
+// you something changed, these say what. The tick stamp is the one the LAST
+// should_present() call saw, i.e. after 999 of the walk's 1000 increments.
+constexpr int kWalkDueCalls = 731;
+constexpr uint32_t kWalkSkipped = 216;
+constexpr uint64_t kWalkLastNow = 15769148;
+
+void check_determinism() {
+    NdsFramePacer first = make_pacer(60, 0, kTickHz);
+    const Cadence a = run_walk(first, 1000, 0x0123456789ABCDEFull);
+    check(a.steps == 1000, "the walk runs 1000 steps",
+          std::to_string(a.steps));
+    check(a.presented > 0 && a.presented == static_cast<uint32_t>(a.due_calls),
+          "the walk's presents and due calls agree",
+          "presented " + u64(a.presented) + ", due " +
+              number(a.due_calls));
+    check(a.due_calls == kWalkDueCalls,
+          "the walk presents on " + number(kWalkDueCalls) +
+              " of 1000 uneven steps",
+          std::to_string(a.due_calls) + " presented");
+    check(a.skipped == kWalkSkipped,
+          "an uneven clock far slower than the cap charges " +
+              u64(kWalkSkipped) + " skipped slots",
+          "skipped " + u64(a.skipped));
+    check(a.last_now == kWalkLastNow, "the walk ends at the pinned tick stamp",
+          "got " + u64(a.last_now));
+    check(a.digest == kWalkDigest,
+          "the uneven 1000-step walk matches the pinned digest",
+          hex64(a.digest) + ", want " + hex64(kWalkDigest));
+
+    // The same loop again must produce the same numbers: nothing in the pacer
+    // may depend on address, time or uninitialised state.
+    NdsFramePacer second = make_pacer(60, 0, kTickHz);
+    const Cadence b = run_walk(second, 1000, 0x0123456789ABCDEFull);
+    check(b.digest == a.digest, "the walk is deterministic",
+          hex64(b.digest) + " != " + hex64(a.digest));
+    check(b.presented == a.presented && b.skipped == a.skipped,
+          "the walk's counters are deterministic",
+          "presented " + u64(b.presented) + " vs " + u64(a.presented));
+    // A different seed must give a different digest, otherwise the digest is
+    // not actually folding the sequence in and the pin above proves nothing.
+    NdsFramePacer other = make_pacer(60, 0, kTickHz);
+    const Cadence c = run_walk(other, 1000, 0x0FEDCBA987654321ull);
+    check(c.digest != a.digest, "a different clock gives a different digest",
+          "both walks hashed to " + hex64(c.digest));
+    // The walk must also be capped at its cap, not merely "not unlimited":
+    // 1000 steps of 1..31 ms average well below 60 fps worth of presents.
+    const double walk_fps = first.measured_fps(a.last_now);
+    check(walk_fps > 0.0 && walk_fps <= 61.0,
+          "the walk never exceeds its cap",
+          "measured " + std::to_string(walk_fps));
+}
+
+int run_checks() {
+    check_cap_clamp();
+    check_cap_list();
+    check_slot_arithmetic();
+    check_phase();
+    check_drift();
+    check_stall();
+    check_stall_table();
+    check_presentation_cap();
+    check_set_cap_raise();
+    check_set_cap_lower();
+    check_set_cap_idempotent();
+    check_set_cap_disable();
+    check_set_cap_counters();
+    check_sleep();
+    check_suggested_sleep_in_loop();
+    check_degenerate();
+    check_measured_fps();
+    check_determinism();
+    return g_failures == 0 ? 0 : g_first_failure;
+}
+
+}  // namespace
+
+int main() {
+    const int result = run_checks();
+    if (result == 0) {
+        std::printf("%d checks passed\n", g_checks);
+    } else {
+        std::fprintf(stderr, "%d of %d checks FAILED (first at check %d)\n",
+                     g_failures, g_checks, result);
+    }
+    return result;
+}
diff --git a/runner/tests/frontend_runtime_settings_test.cpp b/runner/tests/frontend_runtime_settings_test.cpp
new file mode 100644
index 0000000..8b35683
--- /dev/null
+++ b/runner/tests/frontend_runtime_settings_test.cpp
@@ -0,0 +1,1647 @@
+// Pins the menu surface of the runtime settings file: the snapshot, its
+// clamp(), and the load/store pair that puts it on disk
+// (frontend_runtime_settings.h).
+//
+// The unit under test is small but it is the only thing between an edited
+// settings file and the menu the player sees, so the properties that matter
+// are the boring ones: a missing file must not damage the caller's struct, an
+// out-of-range number must never reach the menu or the disk, a bad line must
+// not discard its neighbours, and a launcher's own keys must survive a round
+// trip. Those are exactly the behaviours a "load the struct, set the struct,
+// save the struct" implementation gets wrong.
+//
+// The bounds are written out as literals in this file on purpose. The
+// implementation derives them from one constexpr table; if a bound there
+// changes, the test must fail rather than follow along, because the bound is
+// part of what the menu shows.
+//
+// Every assertion prints OK with its own name; a failure prints FAIL plus one
+// detail line and exits with a code outside 0..255, so a failing check names
+// itself without a debugger.
+//
+// ONE GAP IS CHARACTERISED, NOT ASSERTED AS CORRECT: a first store into a
+// brand-new path writes the twenty-two menu keys but no `settings_version` line
+// (frontend_settings.h says a version is written when the file has none). See
+// the note in check_first_store(). The test therefore asserts "all twenty-two
+// keys, exactly once" there and pins the version line only where it must hold,
+// so the day the gap is fixed this file keeps passing.
+//
+// ONE FIELD IS STORED AS A BARE INTEGER AND NOT AS A NAME:
+// display.screen_layout is an index into NdsScreenLayout, so the number itself
+// is the format. An enum reorder would then hand every player a different
+// picture on the next launch with no file to see it in, which is why
+// check_layout_indices() ties 0..5 to the layout NAMES (frontend.h declares
+// both the enum and the two name functions) instead of trusting the numbers to
+// agree.
+
+#include "frontend_runtime_settings.h"
+
+// For NdsScreenLayout and the two name functions: display.screen_layout is
+// stored as a bare index, so the only way to pin "index 2 means the
+// side-by-side picture" is against the enum and the names themselves.
+#include "frontend.h"
+
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace {
+
+std::size_t g_checks = 0;
+
+// ---- reporting ------------------------------------------------------------
+
+void ok(const std::string& name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name.c_str());
+}
+
+// The exit code is the ordinal of the failed assertion, so it is unique by
+// construction and points at the OK numbering above it.
+int fail(const std::string& name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name.c_str(), detail.c_str());
+    return static_cast<int>(g_checks + 1u);
+}
+
+// One assertion: prints OK and returns 0, or prints FAIL and returns the exit
+// code the caller should propagate.
+int check(bool value, const std::string& name, const std::string& detail) {
+    if (value) {
+        ok(name);
+        return 0;
+    }
+    return fail(name, detail);
+}
+
+std::string number(long long value) { return std::to_string(value); }
+
+// Renders control characters so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "'";
+    for (const char ch : text) {
+        switch (ch) {
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            case '\0': out += "\\0"; break;
+            default: out += ch; break;
+        }
+    }
+    out += '\'';
+    return out;
+}
+
+// ---- the field table ------------------------------------------------------
+//
+// A second copy of the implementation's table, with the bounds spelled as
+// literals. Member pointers let the generic loops below work in both
+// directions (load, store, clamp) without a switch.
+
+struct Field {
+    const char* key;
+    int NdsRuntimeMenuSnapshot::*field;
+    int minimum;
+    int maximum;
+};
+
+const Field kFields[22] = {
+    {"display.fullscreen", &NdsRuntimeMenuSnapshot::fullscreen, 0, 2},
+    {"display.window_scale", &NdsRuntimeMenuSnapshot::window_scale, 1, 4},
+    // The layout indices are pinned as the literal 0..5 the enum declares; the
+    // names those indices stand for are pinned in check_layout_indices(), not
+    // here, because this file's job for a bound is only the range the menu can
+    // reach.
+    {"display.screen_layout", &NdsRuntimeMenuSnapshot::screen_layout, 0, 5},
+    {"display.swap_screens", &NdsRuntimeMenuSnapshot::swap_screens, 0, 1},
+    {"display.second_monitor", &NdsRuntimeMenuSnapshot::second_monitor, 0, 1},
+    {"display.minimap", &NdsRuntimeMenuSnapshot::minimap, 0, 1},
+    {"display.vsync", &NdsRuntimeMenuSnapshot::vsync, 0, 1},
+    {"graphics.integer_scale", &NdsRuntimeMenuSnapshot::integer_scale, 0, 1},
+    {"graphics.linear_filter", &NdsRuntimeMenuSnapshot::linear_filter, 0, 1},
+    {"graphics.resolution_scale", &NdsRuntimeMenuSnapshot::resolution_scale, 1,
+     4},
+    {"graphics.color_mode", &NdsRuntimeMenuSnapshot::color_mode, 0, 3},
+    {"graphics.lcd_grid", &NdsRuntimeMenuSnapshot::lcd_grid, 0, 1},
+    // Nearest/Smooth/Sharp/Scale2x/EPX: the table derives the maximum from the
+    // filter count, the range the menu may reach is pinned here as a literal.
+    {"graphics.pixel_filter", &NdsRuntimeMenuSnapshot::pixel_filter, 0, 4},
+    {"audio.enabled", &NdsRuntimeMenuSnapshot::audio_enabled, 0, 1},
+    {"audio.volume", &NdsRuntimeMenuSnapshot::volume, 0, 100},
+    {"system.state_slot", &NdsRuntimeMenuSnapshot::state_slot, 1, 12},
+    {"system.pause_in_menu", &NdsRuntimeMenuSnapshot::pause_in_menu, 0, 1},
+    {"input.fast_forward", &NdsRuntimeMenuSnapshot::fast_forward, 0, 1},
+    {"display.menu_dim", &NdsRuntimeMenuSnapshot::menu_dim, 0, 100},
+    {"display.menu_opacity", &NdsRuntimeMenuSnapshot::menu_opacity, 0, 100},
+    {"input.mouse_sensitivity", &NdsRuntimeMenuSnapshot::mouse_sensitivity, 10,
+     400},
+    // 0 is the "Unlimited" row and the shipped default, so this is the one
+    // field whose minimum is also its default.
+    {"display.frame_cap", &NdsRuntimeMenuSnapshot::frame_cap, 0, 144},
+};
+
+// Names the first field that differs, or returns "" when the two snapshots are
+// equal. Every comparison below reports through this, so a mismatch is always
+// identified by key rather than by struct dump.
+std::string diff(const NdsRuntimeMenuSnapshot& want,
+                 const NdsRuntimeMenuSnapshot& got) {
+    for (const Field& field : kFields) {
+        const int w = want.*(field.field);
+        const int g = got.*(field.field);
+        if (w != g) {
+            return std::string(field.key) + " is " + number(g) +
+                   ", expected " + number(w);
+        }
+    }
+    return std::string();
+}
+
+// ---- file helpers ---------------------------------------------------------
+
+bool write_text(const std::filesystem::path& path, const std::string& text) {
+    std::error_code error;
+    if (!path.parent_path().empty()) {
+        std::filesystem::create_directories(path.parent_path(), error);
+    }
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.close();
+    return out.good();
+}
+
+bool read_text(const std::filesystem::path& path, std::string* out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    out->assign(std::istreambuf_iterator<char>(in),
+                std::istreambuf_iterator<char>());
+    return true;
+}
+
+std::vector<std::string> lines_of(const std::string& text) {
+    std::vector<std::string> lines;
+    std::string current;
+    for (const char ch : text) {
+        if (ch == '\n') {
+            lines.push_back(current);
+            current.clear();
+        } else {
+            current += ch;
+        }
+    }
+    if (!current.empty()) lines.push_back(current);
+    return lines;
+}
+
+// Position of the line for `key`, or -1. A line matches only as `key=value`,
+// so a comment that mentions a key is not mistaken for it.
+int line_index(const std::vector<std::string>& lines, const std::string& key) {
+    const std::string prefix = key + "=";
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        if (lines[i].compare(0u, prefix.size(), prefix) == 0u) {
+            return static_cast<int>(i);
+        }
+    }
+    return -1;
+}
+
+// The text after the '=' on the line for `key`, or "" when absent.
+std::string value_of(const std::vector<std::string>& lines,
+                     const std::string& key) {
+    const int index = line_index(lines, key);
+    if (index < 0) return std::string();
+    const std::string& line = lines[static_cast<std::size_t>(index)];
+    return line.substr(key.size() + 1u);
+}
+
+// Index of the first matching line at or after `from`, or a value past the end
+// when the key is absent, so comparisons between two lookups stay meaningful.
+std::size_t index_of_after(const std::vector<std::string>& lines,
+                           const std::string& key, std::size_t from) {
+    const std::string prefix = key + "=";
+    for (std::size_t i = from; i < lines.size(); ++i) {
+        if (lines[i].compare(0u, prefix.size(), prefix) == 0u) return i;
+    }
+    return lines.size() + 1u;
+}
+
+int count_key(const std::vector<std::string>& lines, const std::string& key) {
+    const std::string prefix = key + "=";
+    int count = 0;
+    for (const std::string& line : lines) {
+        if (line.compare(0u, prefix.size(), prefix) == 0u) ++count;
+    }
+    return count;
+}
+
+// Every key must appear exactly once: a second save that appends instead of
+// replacing is the classic way a settings file grows forever.
+std::string duplicate_report(const std::vector<std::string>& lines) {
+    for (const Field& field : kFields) {
+        const int count = count_key(lines, field.key);
+        if (count != 1) {
+            return std::string(field.key) + " appears " + number(count) +
+                   " time(s), expected exactly 1";
+        }
+    }
+    return std::string();
+}
+
+// A snapshot whose every field is set to a distinct, in-range, NON-default
+// value, so a round trip that drops a field lands on the default and is
+// therefore visible.
+NdsRuntimeMenuSnapshot non_default_snapshot() {
+    NdsRuntimeMenuSnapshot snapshot;
+    snapshot.fullscreen = 2;
+    snapshot.window_scale = 4;
+    // Square rather than a middle index: it is the highest index, so a store
+    // that dropped the key and re-derived Stacked would differ, and a store
+    // that truncated the range to the old five rows would clamp to BottomOnly
+    // and differ too.
+    snapshot.screen_layout = 5;
+    snapshot.swap_screens = 1;
+    snapshot.second_monitor = 1;
+    snapshot.minimap = 1;
+    snapshot.vsync = 0;
+    snapshot.integer_scale = 0;
+    snapshot.linear_filter = 1;
+    snapshot.resolution_scale = 3;
+    snapshot.color_mode = 3;
+    snapshot.lcd_grid = 1;
+    snapshot.pixel_filter = 4;
+    snapshot.audio_enabled = 0;
+    snapshot.volume = 37;
+    snapshot.state_slot = 9;
+    snapshot.pause_in_menu = 1;
+    snapshot.fast_forward = 0;
+    snapshot.mouse_sensitivity = 250;
+    snapshot.menu_dim = 25;
+    snapshot.menu_opacity = 80;
+    // 144 rather than something mid-list: a round trip that writes the default
+    // (0) would look identical to a dropped field, so this must stay non-zero.
+    snapshot.frame_cap = 144;
+    return snapshot;
+}
+
+// ---- sections -------------------------------------------------------------
+
+// 1. The compiled-in defaults ARE the first-run experience; they are literals a
+// player sees before any file exists, so they are pinned here rather than
+// derived from the header's constants.
+int check_defaults() {
+    const NdsRuntimeMenuSnapshot snapshot;
+    struct Expected {
+        const char* key;
+        int NdsRuntimeMenuSnapshot::*field;
+        int value;
+    };
+    const Expected expected[22] = {
+        {"display.fullscreen", &NdsRuntimeMenuSnapshot::fullscreen, 0},
+        {"display.window_scale", &NdsRuntimeMenuSnapshot::window_scale, 2},
+        // Stacked. Every run before this row existed showed the stacked
+        // picture, so the default must stay the one that changes nothing.
+        {"display.screen_layout", &NdsRuntimeMenuSnapshot::screen_layout, 0},
+        {"display.swap_screens", &NdsRuntimeMenuSnapshot::swap_screens, 0},
+        {"display.second_monitor", &NdsRuntimeMenuSnapshot::second_monitor, 0},
+        {"display.minimap", &NdsRuntimeMenuSnapshot::minimap, 0},
+        {"display.vsync", &NdsRuntimeMenuSnapshot::vsync, 1},
+        {"graphics.integer_scale", &NdsRuntimeMenuSnapshot::integer_scale, 1},
+        {"graphics.linear_filter", &NdsRuntimeMenuSnapshot::linear_filter, 0},
+        {"graphics.resolution_scale",
+         &NdsRuntimeMenuSnapshot::resolution_scale, 1},
+        {"graphics.color_mode", &NdsRuntimeMenuSnapshot::color_mode, 0},
+        {"graphics.lcd_grid", &NdsRuntimeMenuSnapshot::lcd_grid, 0},
+        {"graphics.pixel_filter", &NdsRuntimeMenuSnapshot::pixel_filter, 0},
+        {"audio.enabled", &NdsRuntimeMenuSnapshot::audio_enabled, 1},
+        {"audio.volume", &NdsRuntimeMenuSnapshot::volume, 100},
+        {"system.state_slot", &NdsRuntimeMenuSnapshot::state_slot, 1},
+        {"system.pause_in_menu", &NdsRuntimeMenuSnapshot::pause_in_menu, 0},
+        {"input.fast_forward", &NdsRuntimeMenuSnapshot::fast_forward, 1},
+        {"display.menu_dim", &NdsRuntimeMenuSnapshot::menu_dim, 60},
+        {"display.menu_opacity", &NdsRuntimeMenuSnapshot::menu_opacity, 100},
+        {"input.mouse_sensitivity",
+         &NdsRuntimeMenuSnapshot::mouse_sensitivity, 100},
+        {"display.frame_cap", &NdsRuntimeMenuSnapshot::frame_cap, 0},
+    };
+    for (const Expected& entry : expected) {
+        const int got = snapshot.*(entry.field);
+        if (const int rc = check(got == entry.value,
+                                 std::string("default ") + entry.key + " is " +
+                                     number(entry.value),
+                                 "fresh snapshot has " + number(got))) {
+            return rc;
+        }
+    }
+
+    // The named bounds the menu uses to size its rows. Pinned as literals
+    // because a changed bound changes the cursor range the player can reach.
+    const struct {
+        const char* name;
+        int got;
+        int want;
+    } bounds[6] = {
+        {"kStateSlotMax", NdsRuntimeMenuSnapshot::kStateSlotMax, 12},
+        {"kWindowScaleMax", NdsRuntimeMenuSnapshot::kWindowScaleMax, 4},
+        {"kResolutionScaleMax", NdsRuntimeMenuSnapshot::kResolutionScaleMax, 4},
+        {"kVolumeMax", NdsRuntimeMenuSnapshot::kVolumeMax, 100},
+        {"kMouseSensitivityMin", NdsRuntimeMenuSnapshot::kMouseSensitivityMin,
+         10},
+        {"kMouseSensitivityMax", NdsRuntimeMenuSnapshot::kMouseSensitivityMax,
+         400},
+    };
+    for (const auto& bound : bounds) {
+        if (const int rc = check(bound.got == bound.want,
+                                 std::string("bound ") + bound.name + " is " +
+                                     number(bound.want),
+                                 number(bound.got))) {
+            return rc;
+        }
+    }
+    return 0;
+}
+
+// 2. clamp() as a pure unit, both directions at once on one snapshot.
+int check_clamp_unit() {
+    NdsRuntimeMenuSnapshot low;
+    for (const Field& field : kFields) low.*(field.field) = field.minimum - 1;
+    low.clamp();
+    for (const Field& field : kFields) {
+        const int got = low.*(field.field);
+        if (const int rc = check(got == field.minimum,
+                                 std::string("clamp() raises ") + field.key +
+                                     " to " + number(field.minimum),
+                                 "clamp() left " + number(got))) {
+            return rc;
+        }
+    }
+
+    NdsRuntimeMenuSnapshot high;
+    for (const Field& field : kFields) high.*(field.field) = field.maximum + 1;
+    high.clamp();
+    for (const Field& field : kFields) {
+        const int got = high.*(field.field);
+        if (const int rc = check(got == field.maximum,
+                                 std::string("clamp() lowers ") + field.key +
+                                     " to " + number(field.maximum),
+                                 "clamp() left " + number(got))) {
+            return rc;
+        }
+    }
+
+    // Far outside the range in one step, not just one past the bound: the
+    // values a corrupt file can hold are arbitrary.
+    NdsRuntimeMenuSnapshot wild;
+    for (const Field& field : kFields) wild.*(field.field) = -2000000;
+    wild.clamp();
+    for (const Field& field : kFields) {
+        if (wild.*(field.field) != field.minimum) {
+            return fail("clamp() pins a wildly negative field to its minimum",
+                        std::string(field.key) + " is " +
+                            number(wild.*(field.field)));
+        }
+    }
+    ok("clamp() pins a wildly negative field to its minimum");
+    for (const Field& field : kFields) wild.*(field.field) = 2000000;
+    wild.clamp();
+    for (const Field& field : kFields) {
+        if (wild.*(field.field) != field.maximum) {
+            return fail("clamp() pins a wildly positive field to its maximum",
+                        std::string(field.key) + " is " +
+                            number(wild.*(field.field)));
+        }
+    }
+    ok("clamp() pins a wildly positive field to its maximum");
+
+    // clamp() must be idempotent and must not disturb an in-range snapshot.
+    const NdsRuntimeMenuSnapshot in_range = non_default_snapshot();
+    NdsRuntimeMenuSnapshot copy = in_range;
+    copy.clamp();
+    if (const int rc = check(diff(in_range, copy).empty(),
+                             "clamp() leaves an in-range snapshot alone",
+                             diff(in_range, copy))) {
+        return rc;
+    }
+    return 0;
+}
+
+// 3. display.screen_layout is stored as a bare integer, so the number IS the
+//    format: index 2 has to mean the side-by-side picture on disk as much as in
+//    memory. frontend_runtime_settings.cpp deliberately does not include
+//    frontend.h (a stored index must keep its meaning even if the enum grows),
+//    so this file is the only place where the two halves are compared.
+int check_layout_indices() {
+    struct Row {
+        int index;
+        const char* name;
+        NdsScreenLayout layout;
+    };
+    const Row rows[6] = {
+        {0, "stacked", NdsScreenLayout::Stacked},
+        {1, "separate", NdsScreenLayout::Separate},
+        {2, "side-by-side", NdsScreenLayout::SideBySide},
+        {3, "top", NdsScreenLayout::TopOnly},
+        {4, "bottom", NdsScreenLayout::BottomOnly},
+        {5, "square", NdsScreenLayout::Square},
+    };
+    for (const Row& row : rows) {
+        const int declared = static_cast<int>(row.layout);
+        if (const int rc = check(
+                declared == row.index,
+                std::string("layout index ") + number(row.index) + " is " +
+                    row.name + "'s enum value",
+                std::string("NdsScreenLayout declares ") + row.name + " as " +
+                    number(declared))) {
+            return rc;
+        }
+        const std::string named =
+            nds_screen_layout_name(static_cast<NdsScreenLayout>(row.index));
+        if (const int rc = check(named == row.name,
+                                 std::string("index ") + number(row.index) +
+                                     " is named " + quote(row.name),
+                                 "the name is " + quote(named))) {
+            return rc;
+        }
+        // Parsed into a value that is NOT the expected one, so a failed parse
+        // that leaves its output untouched cannot pass this check.
+        NdsScreenLayout back = row.index == 0 ? NdsScreenLayout::Separate
+                                              : NdsScreenLayout::Stacked;
+        if (const int rc = check(nds_parse_screen_layout(named, &back) &&
+                                     static_cast<int>(back) == row.index,
+                                 quote(named) + " parses back to index " +
+                                     number(row.index),
+                                 "parses to index " +
+                                     number(static_cast<int>(back)))) {
+            return rc;
+        }
+    }
+
+    // The row must reach exactly the enum: one index short would hide a layout
+    // the frontend can draw, one index long would offer a shape nobody wrote.
+    int minimum = -1;
+    int maximum = -1;
+    if (const int rc = check(
+            nds_runtime_menu_key_range("display.screen_layout", &minimum,
+                                       &maximum) &&
+                minimum == 0 &&
+                maximum == static_cast<int>(NdsScreenLayout::Square),
+            "display.screen_layout reaches exactly the declared layouts",
+            "the row ranges over " + number(minimum) + ".." +
+                number(maximum))) {
+        return rc;
+    }
+
+    // Every one of those indices is in range, so clamp() must leave it alone:
+    // a row whose range stopped at 4 would silently rewrite a stored Square to
+    // BottomOnly on the next launch, with no trace in the file.
+    for (int index = 0; index < 6; ++index) {
+        NdsRuntimeMenuSnapshot snapshot;
+        snapshot.screen_layout = index;
+        snapshot.swap_screens = index % 2;
+        snapshot.second_monitor = (index + 1) % 2;
+        snapshot.minimap = index % 2;
+        snapshot.clamp();
+        if (const int rc = check(snapshot.screen_layout == index &&
+                                     snapshot.swap_screens == index % 2 &&
+                                     snapshot.second_monitor ==
+                                         (index + 1) % 2 &&
+                                     snapshot.minimap == index % 2,
+                                 "clamp() leaves layout index " +
+                                     number(index) + " alone",
+                                 "screen_layout is " +
+                                     number(snapshot.screen_layout) +
+                                     ", swap_screens " +
+                                     number(snapshot.swap_screens) +
+                                     ", second_monitor " +
+                                     number(snapshot.second_monitor) +
+                                     ", minimap " +
+                                     number(snapshot.minimap))) {
+            return rc;
+        }
+    }
+    return 0;
+}
+
+// 4. The persisted surface and the menu are one table in the implementation,
+//    so every key this file knows must resolve to a row whose range is exactly
+//    the range pinned above, and that row must edit the field the table names.
+//    A key with no row is written to disk but absent from the menu (key_range
+//    returning false is how a row is left out), which is the silent shape of a
+//    dead setting.
+int check_menu_rows() {
+    NdsRuntimeMenuSnapshot snapshot;
+    for (const Field& field : kFields) {
+        int minimum = -1000;
+        int maximum = -1000;
+        if (const int rc = check(
+                nds_runtime_menu_key_range(field.key, &minimum, &maximum),
+                std::string("the menu has a row for ") + field.key,
+                "no row is backed for that key")) {
+            return rc;
+        }
+        if (const int rc = check(
+                minimum == field.minimum && maximum == field.maximum,
+                std::string("the ") + field.key + " row ranges over " +
+                    number(field.minimum) + ".." + number(field.maximum),
+                "the row ranges over " + number(minimum) + ".." +
+                    number(maximum))) {
+            return rc;
+        }
+        if (const int rc = check(
+                nds_runtime_menu_field(&snapshot, field.key) ==
+                    &(snapshot.*(field.field)),
+                std::string("the ") + field.key + " row edits its own field",
+                "the row edits a different value")) {
+            return rc;
+        }
+    }
+
+    // The row the menu edits IS the value that gets stored: write through the
+    // pointer the menu holds and the snapshot must follow, which is what makes
+    // a new row reachable without a second code path.
+    int* layout = nds_runtime_menu_field(&snapshot, "display.screen_layout");
+    if (const int rc = check(layout == &snapshot.screen_layout,
+                             "the layout row resolves to screen_layout",
+                             "the row resolves to something else")) {
+        return rc;
+    }
+    *layout = static_cast<int>(NdsScreenLayout::Square);
+    if (const int rc = check(
+            snapshot.screen_layout == static_cast<int>(NdsScreenLayout::Square),
+            "the layout row writes the index through",
+            "screen_layout holds " + number(snapshot.screen_layout))) {
+        return rc;
+    }
+
+    // A caller may ask for either end of a range alone; the menu sizes a row
+    // from one end in places.
+    int only_maximum = -1;
+    if (const int rc = check(
+            nds_runtime_menu_key_range("audio.volume", nullptr,
+                                       &only_maximum) &&
+                only_maximum == 100,
+            "a range may be asked for its maximum alone",
+            "maximum reads " + number(only_maximum))) {
+        return rc;
+    }
+    int only_minimum = -1;
+    if (const int rc = check(
+            nds_runtime_menu_key_range("system.state_slot", &only_minimum,
+                                       nullptr) && only_minimum == 1,
+            "a range may be asked for its minimum alone",
+            "minimum reads " + number(only_minimum))) {
+        return rc;
+    }
+
+    // Unknown and absent keys are refused rather than defaulted: the menu asks
+    // about keys a future build may add, and a guessed range would build a row
+    // that edits nothing.
+    if (const int rc = check(
+            !nds_runtime_menu_key_range("display.nope", nullptr, nullptr),
+            "an unbacked key has no range",
+            "the key resolved")) {
+        return rc;
+    }
+    if (const int rc = check(
+            !nds_runtime_menu_key_range(nullptr, nullptr, nullptr),
+            "an absent key has no range",
+            "a null key resolved")) {
+        return rc;
+    }
+    if (const int rc = check(
+            nds_runtime_menu_field(nullptr, "audio.volume") == nullptr,
+            "a null snapshot has no fields",
+            "a null snapshot resolved a field")) {
+        return rc;
+    }
+    return check(nds_runtime_menu_field(&snapshot, "display.nope") == nullptr,
+                 "an unbacked key has no field",
+                 "the key resolved to a field");
+}
+
+// 5. A missing path is not an error, and it must never touch the caller.
+int check_missing_path(const std::filesystem::path& root) {
+    NdsRuntimeMenuSnapshot sentinel;
+    sentinel.fullscreen = 7;
+    sentinel.window_scale = 7;
+    // 7 is outside 0..5, so an out-of-range index survives the way every other
+    // sentinel does: the point is only that the field is not touched, and a
+    // value the clamp would have moved can only be reached by a write that had
+    // no business happening.
+    sentinel.screen_layout = 7;
+    sentinel.swap_screens = 7;
+    sentinel.second_monitor = 7;
+    sentinel.minimap = 7;
+    sentinel.vsync = 7;
+    sentinel.integer_scale = 7;
+    sentinel.linear_filter = 7;
+    sentinel.resolution_scale = 7;
+    sentinel.color_mode = 7;
+    sentinel.lcd_grid = 7;
+    sentinel.pixel_filter = 7;
+    sentinel.audio_enabled = 7;
+    sentinel.volume = 7;
+    sentinel.state_slot = 7;
+    sentinel.pause_in_menu = 7;
+    sentinel.fast_forward = 7;
+    sentinel.mouse_sensitivity = 7;
+    sentinel.menu_dim = 7;
+    sentinel.menu_opacity = 7;
+    sentinel.frame_cap = 7;
+    NdsRuntimeMenuSnapshot after = sentinel;
+    const bool loaded =
+        nds_runtime_menu_load((root / "does-not-exist.ini").string(), &after);
+    if (const int rc = check(!loaded,
+                             "load() of a missing file returns false",
+                             "returned true")) {
+        return rc;
+    }
+    if (const int rc = check(diff(sentinel, after).empty(),
+                             "load() of a missing file leaves the snapshot "
+                             "untouched",
+                             diff(sentinel, after))) {
+        return rc;
+    }
+
+    // A null destination is refused rather than dereferenced.
+    if (const int rc = check(!nds_runtime_menu_load(
+                                 (root / "does-not-exist.ini").string(),
+                                 nullptr),
+                             "load() refuses a null destination",
+                             "returned true for nullptr")) {
+        return rc;
+    }
+
+    // An unreadable destination (a directory) is the same contract as a
+    // missing file: false, caller untouched. This is the wine/Windows shape of
+    // "exists but cannot be read"; the runner ships on Windows.
+    const std::filesystem::path directory = root / "a-directory";
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    NdsRuntimeMenuSnapshot kept = sentinel;
+    const bool loaded_directory = nds_runtime_menu_load(directory.string(),
+                                                        &kept);
+    if (const int rc = check(!loaded_directory,
+                             "load() of a directory returns false",
+                             "returned true")) {
+        return rc;
+    }
+    if (const int rc = check(diff(sentinel, kept).empty(),
+                             "load() of a directory leaves the snapshot "
+                             "untouched",
+                             diff(sentinel, kept))) {
+        return rc;
+    }
+
+    // An existing but empty file IS a file: it loads, and every field keeps
+    // its default.
+    const std::filesystem::path empty = root / "empty.ini";
+    if (!write_text(empty, "")) {
+        return fail("an empty file loads with the defaults",
+                    "cannot create " + quote(empty.string()));
+    }
+    NdsRuntimeMenuSnapshot from_empty;
+    from_empty.volume = 3;
+    const bool loaded_empty = nds_runtime_menu_load(empty.string(),
+                                                    &from_empty);
+    if (const int rc = check(loaded_empty,
+                             "an existing empty file loads",
+                             "load() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(diff(NdsRuntimeMenuSnapshot(), from_empty).empty(),
+                             "an empty file loads with every default",
+                             diff(NdsRuntimeMenuSnapshot(), from_empty))) {
+        return rc;
+    }
+
+    // load() is read-only: it must not clamp or rewrite the file behind the
+    // player's back.
+    const std::filesystem::path dirty = root / "read-only.ini";
+    const std::string dirty_text =
+        "settings_version=12\ndisplay.fullscreen=9\naudio.volume=loud\n";
+    if (!write_text(dirty, dirty_text)) {
+        return fail("load() does not rewrite the file",
+                    "cannot create " + quote(dirty.string()));
+    }
+    NdsRuntimeMenuSnapshot ignored;
+    (void)nds_runtime_menu_load(dirty.string(), &ignored);
+    std::string after_load;
+    if (!read_text(dirty, &after_load)) {
+        return fail("load() does not rewrite the file",
+                    "cannot read back " + quote(dirty.string()));
+    }
+    return check(after_load == dirty_text, "load() does not rewrite the file",
+                 "file is now " + quote(after_load));
+}
+
+// 6. A first store: the file is plain key=value, all twenty-two keys appear
+//    exactly once, and nothing is duplicated.
+//
+//    GAP, reported separately and deliberately not asserted as correct here: a
+//    brand-new path gets no `settings_version` line on the first store, because
+//    store() starts from a failed load() and only the parser inserts the
+//    version. frontend_settings.h says the runner "writes 12 when the file has
+//    none", so the header contract and this unit disagree for the first save.
+//    Asserting "no version line" would freeze the gap, so this section asserts
+//    only what holds either way.
+int check_first_store(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "first.ini";
+    const NdsRuntimeMenuSnapshot snapshot = non_default_snapshot();
+    if (const int rc = check(nds_runtime_menu_store(path.string(), snapshot),
+                             "a first store into a new path succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string text;
+    if (!read_text(path, &text)) {
+        return fail("the stored file is one key=value line per key",
+                    "cannot read back " + quote(path.string()));
+    }
+    if (const int rc = check(!text.empty() && text.back() == '\n',
+                             "the stored file ends with a newline",
+                             "last byte is " +
+                                 (text.empty() ? std::string("absent")
+                                               : quote(text.substr(
+                                                     text.size() - 1u))))) {
+        return rc;
+    }
+    if (const int rc = check(text.find('\r') == std::string::npos &&
+                                 text.find('\0') == std::string::npos,
+                             "the stored file is plain LF text",
+                             "file holds CR or NUL bytes")) {
+        return rc;
+    }
+    const std::vector<std::string> lines = lines_of(text);
+    if (const int rc = check(duplicate_report(lines).empty(),
+                             "each of the twenty-two keys is written once",
+                             duplicate_report(lines))) {
+        return rc;
+    }
+    // The version line may or may not be first (see the gap note); the
+    // twenty-two menu keys and at most one extra line must account for every
+    // line.
+    if (const int rc = check(lines.size() == 22u || lines.size() == 23u,
+                             "the file holds exactly the twenty-two keys, plus "
+                             "at most the version line",
+                             number(lines.size()) + " line(s): " +
+                                 quote(text))) {
+        return rc;
+    }
+    for (const Field& field : kFields) {
+        const std::string value = value_of(lines, field.key);
+        if (const int rc = check(value == number(snapshot.*(field.field)),
+                                 std::string("stores ") + field.key + " as a "
+                                 "plain decimal",
+                                 "line reads " +
+                                     quote(std::string(field.key) + "=" +
+                                           value))) {
+            return rc;
+        }
+    }
+    // The keys reach the file in the order kFields lists them, which is the
+    // implementation's own order: a row inserted in a different place is a
+    // change to the file a player reads, not only to the menu.
+    std::size_t position = 0;
+    for (const Field& field : kFields) {
+        const std::size_t at = index_of_after(lines, field.key, position);
+        if (const int rc = check(
+                at < lines.size(),
+                std::string("the file lists ") + field.key + " in table order",
+                "the key is not at or after line " +
+                    number(static_cast<long long>(position)))) {
+            return rc;
+        }
+        position = at + 1u;
+    }
+    // And the file loads back to exactly what was stored.
+    NdsRuntimeMenuSnapshot loaded;
+    if (const int rc = check(nds_runtime_menu_load(path.string(), &loaded),
+                             "a stored file loads",
+                             "load() returned false")) {
+        return rc;
+    }
+    return check(diff(snapshot, loaded).empty(),
+                 "a stored file loads back identically",
+                 diff(snapshot, loaded));
+}
+
+// 7. A version line is inserted, kept and never duplicated. Where it must hold
+//    it holds; a file that already carries a version keeps that version, so an
+//    older runner does not silently upgrade a newer launcher's file.
+int check_version_line(const std::filesystem::path& root) {
+    // No version line, but other content: the parser inserts `12` at the very
+    // front, which is the property requirement "first line" is about.
+    const std::filesystem::path unversioned = root / "unversioned.ini";
+    if (!write_text(unversioned, "# a comment\n\nlauncher.some_key=7\n")) {
+        return fail("an unversioned file gains settings_version=12 first",
+                    "cannot create " + quote(unversioned.string()));
+    }
+    if (const int rc = check(
+            nds_runtime_menu_store(unversioned.string(),
+                                   NdsRuntimeMenuSnapshot()),
+            "store() into an unversioned file succeeds",
+            "store() returned false")) {
+        return rc;
+    }
+    std::string text;
+    if (!read_text(unversioned, &text)) {
+        return fail("an unversioned file gains settings_version=12 first",
+                    "cannot read back");
+    }
+    std::vector<std::string> lines = lines_of(text);
+    if (const int rc = check(!lines.empty() &&
+                                 lines.front() == "settings_version=12",
+                             "an unversioned file gains settings_version=12 "
+                             "as its first line",
+                             lines.empty() ? std::string("file is empty")
+                                           : quote(lines.front()))) {
+        return rc;
+    }
+    if (const int rc = check(count_key(lines, "settings_version") == 1,
+                             "settings_version is written once",
+                             "appears " +
+                                 number(count_key(lines,
+                                                  "settings_version")) +
+                                 " time(s)")) {
+        return rc;
+    }
+
+    // An existing version is preserved, wherever it sits, and is not moved.
+    const std::filesystem::path versioned = root / "versioned.ini";
+    if (!write_text(versioned,
+                    "# launcher header\nsettings_version=3\n"
+                    "launcher.alpha=7\n")) {
+        return fail("an existing settings_version is preserved in place",
+                    "cannot create " + quote(versioned.string()));
+    }
+    if (const int rc = check(nds_runtime_menu_store(versioned.string(),
+                                                    NdsRuntimeMenuSnapshot()),
+                             "store() into a versioned file succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string versioned_text;
+    if (!read_text(versioned, &versioned_text)) {
+        return fail("an existing settings_version is preserved in place",
+                    "cannot read back");
+    }
+    lines = lines_of(versioned_text);
+    if (const int rc = check(value_of(lines, "settings_version") == "3",
+                             "an existing settings_version keeps its value",
+                             "reads " +
+                                 quote(value_of(lines,
+                                                "settings_version")))) {
+        return rc;
+    }
+    if (const int rc = check(lines.size() > 1u && lines[1] ==
+                                 "settings_version=3",
+                             "an existing settings_version keeps its position",
+                             lines.size() > 1u
+                                 ? quote(lines[1])
+                                 : std::string("too few lines"))) {
+        return rc;
+    }
+    if (const int rc = check(count_key(lines, "settings_version") == 1,
+                             "store() never duplicates settings_version",
+                             "appears " +
+                                 number(count_key(lines,
+                                                  "settings_version")) +
+                                 " time(s)")) {
+        return rc;
+    }
+    return check(lines.size() > 2u && lines[2] == "launcher.alpha=7",
+                 "a foreign key after the version line keeps its position",
+                 lines.size() > 2u ? quote(lines[2])
+                                   : std::string("too few lines"));
+}
+
+// 8. Foreign keys, comments and blank lines survive, in order, and the
+//    launcher's own key still reads back.
+int check_preservation(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "preserve.ini";
+    const std::string original =
+        "# a comment\n"
+        "\n"
+        "launcher.some_key=7\n";
+    if (!write_text(path, original)) {
+        return fail("comments, blank lines and foreign keys survive a store",
+                    "cannot create " + quote(path.string()));
+    }
+    NdsRuntimeMenuSnapshot snapshot;
+    snapshot.volume = 42;
+    if (const int rc = check(nds_runtime_menu_store(path.string(), snapshot),
+                             "store() into a file with foreign content "
+                             "succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string text;
+    if (!read_text(path, &text)) {
+        return fail("comments, blank lines and foreign keys survive a store",
+                    "cannot read back");
+    }
+    const std::vector<std::string> lines = lines_of(text);
+
+    // Version line first, then the original three lines verbatim and in order.
+    if (const int rc = check(lines.size() >= 4u,
+                             "the preserved lines are all still present",
+                             number(lines.size()) + " line(s): " +
+                                 quote(text))) {
+        return rc;
+    }
+    if (const int rc = check(lines[1] == "# a comment",
+                             "a comment survives verbatim",
+                             quote(lines[1]))) {
+        return rc;
+    }
+    if (const int rc = check(lines[2].empty(),
+                             "a blank line survives as a blank line",
+                             quote(lines[2]))) {
+        return rc;
+    }
+    if (const int rc = check(lines[3] == "launcher.some_key=7",
+                             "a foreign key survives verbatim",
+                             quote(lines[3]))) {
+        return rc;
+    }
+    if (const int rc = check(value_of(lines, "launcher.some_key") == "7",
+                             "a foreign key still reads back as 7",
+                             quote(value_of(lines, "launcher.some_key")))) {
+        return rc;
+    }
+    if (const int rc = check(index_of_after(lines, "launcher.some_key", 0) <
+                                 index_of_after(lines, "display.fullscreen",
+                                                0),
+                             "the menu keys are appended after the foreign "
+                             "ones",
+                             "display.fullscreen precedes launcher.some_key")) {
+        return rc;
+    }
+
+    // A line with no '=' is not a key and must be carried through untouched
+    // (a comment the launcher writes without '#').
+    const std::filesystem::path odd = root / "odd-lines.ini";
+    if (!write_text(odd,
+                    "totally bogus line\n"
+                    "   \n"
+                    "# trailing comment\n")) {
+        return fail("a line without '=' is carried through untouched",
+                    "cannot create " + quote(odd.string()));
+    }
+    if (const int rc = check(nds_runtime_menu_store(odd.string(),
+                                                    NdsRuntimeMenuSnapshot()),
+                             "store() into a file with odd lines succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string odd_text;
+    if (!read_text(odd, &odd_text)) {
+        return fail("a line without '=' is carried through untouched",
+                    "cannot read back");
+    }
+    const std::vector<std::string> odd_lines = lines_of(odd_text);
+    if (const int rc = check(odd_lines.size() >= 4u &&
+                                 odd_lines[1] == "totally bogus line",
+                             "a line without '=' survives verbatim",
+                             odd_lines.size() > 1u ? quote(odd_lines[1])
+                                                   : std::string("too few"))) {
+        return rc;
+    }
+    if (const int rc = check(odd_lines.size() >= 4u &&
+                                 odd_lines[3] == "# trailing comment",
+                             "a trailing comment keeps its position",
+                             odd_lines.size() > 3u ? quote(odd_lines[3])
+                                                   : std::string("too few"))) {
+        return rc;
+    }
+
+    // A value the human wrote with spaces around the '=' is trimmed on the way
+    // in, and written back without the spaces.
+    const std::filesystem::path spaced = root / "spaced.ini";
+    if (!write_text(spaced, "launcher.beta = spaced\n")) {
+        return fail("a value around '=' is trimmed", "cannot create");
+    }
+    NdsRuntimeMenuSnapshot spaced_snapshot;
+    if (const int rc = check(nds_runtime_menu_load(spaced.string(),
+                                                   &spaced_snapshot),
+                             "a file with a spaced '=' loads",
+                             "load() returned false")) {
+        return rc;
+    }
+    return check(diff(NdsRuntimeMenuSnapshot(), spaced_snapshot).empty(),
+                 "a spaced '=' still yields the defaults",
+                 diff(NdsRuntimeMenuSnapshot(), spaced_snapshot));
+}
+
+// 9. A parity round trip: every field, both directions.
+int check_round_trip(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "round-trip.ini";
+    const NdsRuntimeMenuSnapshot snapshot = non_default_snapshot();
+    if (const int rc = check(nds_runtime_menu_store(path.string(), snapshot),
+                             "store() writes a non-default snapshot",
+                             "store() returned false")) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot loaded;
+    if (const int rc = check(nds_runtime_menu_load(path.string(), &loaded),
+                             "load() reads the stored snapshot",
+                             "load() returned false")) {
+        return rc;
+    }
+    return check(diff(snapshot, loaded).empty(),
+                 "all twenty-two fields round-trip", diff(snapshot, loaded));
+}
+
+// 10. Clamping on load, both sides of every bound.
+int check_clamp_on_load(const std::filesystem::path& root) {
+    for (const Field& field : kFields) {
+        struct Case {
+            const char* side;
+            int written;
+            int expected;
+        };
+        const Case cases[2] = {
+            {"below its minimum", field.minimum - 1, field.minimum},
+            {"above its maximum", field.maximum + 1, field.maximum},
+        };
+        for (const Case& item : cases) {
+            const std::filesystem::path path =
+                root / ("clamp-load-" + std::string(field.key) + "-" +
+                        number(item.written) + ".ini");
+            if (!write_text(path, "settings_version=12\n" + std::string(
+                                      field.key) + "=" +
+                                      number(item.written) + "\n")) {
+                return fail(std::string("load() clamps ") + field.key,
+                            "cannot create " + quote(path.string()));
+            }
+            NdsRuntimeMenuSnapshot loaded;
+            if (const int rc = check(nds_runtime_menu_load(path.string(),
+                                                           &loaded),
+                                     std::string("load() clamps ") + field.key +
+                                         " " + item.side,
+                                     "load() returned false")) {
+                return rc;
+            }
+            const int got = loaded.*(field.field);
+            if (const int rc = check(got == item.expected,
+                                     std::string("load() clamps ") + field.key +
+                                         " " + item.side + " to " +
+                                         number(item.expected),
+                                     "file said " + number(item.written) +
+                                         ", snapshot holds " + number(got))) {
+                return rc;
+            }
+        }
+    }
+    return 0;
+}
+
+// 11. Clamping on store: an out-of-range snapshot must not reach the disk.
+int check_clamp_on_store(const std::filesystem::path& root) {
+    for (const Field& field : kFields) {
+        struct Case {
+            const char* side;
+            int written;
+            int expected;
+        };
+        const Case cases[2] = {
+            {"below its minimum", field.minimum - 5, field.minimum},
+            {"above its maximum", field.maximum + 5, field.maximum},
+        };
+        for (const Case& item : cases) {
+            const std::filesystem::path path =
+                root / ("clamp-store-" + std::string(field.key) + "-" +
+                        number(item.written) + ".ini");
+            NdsRuntimeMenuSnapshot snapshot;
+            snapshot.*(field.field) = item.written;
+            if (const int rc = check(nds_runtime_menu_store(path.string(),
+                                                           snapshot),
+                                     std::string("store() accepts ") +
+                                         field.key + " " + item.side,
+                                     "store() returned false")) {
+                return rc;
+            }
+            std::string text;
+            if (!read_text(path, &text)) {
+                return fail(std::string("store() clamps ") + field.key,
+                            "cannot read back");
+            }
+            const std::string value = value_of(lines_of(text), field.key);
+            if (const int rc = check(value == number(item.expected),
+                                     std::string("store() clamps ") +
+                                         field.key + " " + item.side + " to " +
+                                         number(item.expected),
+                                     "file holds " +
+                                         quote(std::string(field.key) + "=" +
+                                               value))) {
+                return rc;
+            }
+            // And the clamped value loads back as itself, so the on-disk file
+            // is already valid rather than waiting for a second save.
+            NdsRuntimeMenuSnapshot loaded;
+            (void)nds_runtime_menu_load(path.string(), &loaded);
+            if (loaded.*(field.field) != item.expected) {
+                return fail(std::string("a clamped ") + field.key +
+                                " loads back clamped",
+                            "snapshot holds " +
+                                number(loaded.*(field.field)));
+            }
+        }
+        ok(std::string("a clamped ") + field.key + " loads back clamped");
+    }
+    return 0;
+}
+
+// 12. An unparsable value keeps the default on load, and the next store
+//     rewrites the key to that default so the file becomes valid again.
+int check_unparsable(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "unparsable.ini";
+    if (!write_text(path,
+                    "settings_version=12\n"
+                    "audio.volume=loud\n"
+                    "display.fullscreen=yes\n")) {
+        return fail("an unparsable value keeps its default",
+                    "cannot create " + quote(path.string()));
+    }
+    NdsRuntimeMenuSnapshot loaded;
+    if (const int rc = check(nds_runtime_menu_load(path.string(), &loaded),
+                             "a file with unparsable values loads",
+                             "load() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(loaded.volume == 100,
+                             "audio.volume=loud keeps the default 100",
+                             "snapshot holds " + number(loaded.volume))) {
+        return rc;
+    }
+    if (const int rc = check(loaded.fullscreen == 0,
+                             "display.fullscreen=yes keeps the default 0",
+                             "snapshot holds " + number(loaded.fullscreen))) {
+        return rc;
+    }
+    if (const int rc = check(nds_runtime_menu_store(path.string(), loaded),
+                             "store() of that snapshot succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string text;
+    if (!read_text(path, &text)) {
+        return fail("store() rewrites an unparsable value to the default",
+                    "cannot read back");
+    }
+    const std::vector<std::string> lines = lines_of(text);
+    if (const int rc = check(value_of(lines, "audio.volume") == "100",
+                             "store() rewrites audio.volume=loud to 100",
+                             quote(value_of(lines, "audio.volume")))) {
+        return rc;
+    }
+    if (const int rc = check(value_of(lines, "display.fullscreen") == "0",
+                             "store() rewrites display.fullscreen=yes to 0",
+                             quote(value_of(lines, "display.fullscreen")))) {
+        return rc;
+    }
+    // The key keeps its original position, so a one-line fix by the player is
+    // not shuffled to the end of the file.
+    if (const int rc = check(lines.size() > 1u && lines[1] ==
+                                 "audio.volume=100",
+                             "the rewritten key keeps its position",
+                             lines.size() > 1u
+                                 ? quote(lines[1])
+                                 : std::string("too few lines"))) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot reloaded;
+    if (const int rc = check(nds_runtime_menu_load(path.string(), &reloaded),
+                             "the repaired file loads", "load() returned "
+                             "false")) {
+        return rc;
+    }
+    return check(reloaded.volume == 100, "the repaired file is valid",
+                 "volume reads " + number(reloaded.volume));
+}
+
+// 13. Idempotence: repeated stores are stable, with no key duplicated.
+int check_idempotence(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "idempotent.ini";
+    const NdsRuntimeMenuSnapshot snapshot = non_default_snapshot();
+    if (!write_text(path, "# launcher header\n\nlauncher.alpha=7\n")) {
+        return fail("a second store is byte-identical to the first",
+                    "cannot create " + quote(path.string()));
+    }
+    if (const int rc = check(nds_runtime_menu_store(path.string(), snapshot),
+                             "the first store succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string first;
+    if (!read_text(path, &first)) {
+        return fail("a second store is byte-identical to the first",
+                    "cannot read back");
+    }
+    if (const int rc = check(nds_runtime_menu_store(path.string(), snapshot),
+                             "the second store succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    std::string second;
+    if (!read_text(path, &second)) {
+        return fail("a second store is byte-identical to the first",
+                    "cannot read back");
+    }
+    if (const int rc = check(second == first,
+                             "a second store is byte-identical to the first",
+                             "first is " + quote(first) + ", second is " +
+                                 quote(second))) {
+        return rc;
+    }
+
+    // Five stores must not grow the file or duplicate a key.
+    for (int round = 0; round < 3; ++round) {
+        if (!nds_runtime_menu_store(path.string(), snapshot)) {
+            return fail("repeated stores do not duplicate a key",
+                        "store() returned false on round " + number(round));
+        }
+    }
+    std::string many;
+    if (!read_text(path, &many)) {
+        return fail("repeated stores do not duplicate a key",
+                    "cannot read back");
+    }
+    const std::vector<std::string> lines = lines_of(many);
+    if (const int rc = check(duplicate_report(lines).empty(),
+                             "five stores leave one line per key",
+                             duplicate_report(lines))) {
+        return rc;
+    }
+    if (const int rc = check(count_key(lines, "launcher.alpha") == 1,
+                             "five stores leave one foreign key",
+                             "appears " +
+                                 number(count_key(lines, "launcher.alpha")) +
+                                 " time(s)")) {
+        return rc;
+    }
+    if (const int rc = check(many == second,
+                             "five stores leave the text unchanged",
+                             "text is now " + quote(many))) {
+        return rc;
+    }
+
+    // load() of the final file and a store of that snapshot is still a no-op.
+    NdsRuntimeMenuSnapshot loaded;
+    if (!nds_runtime_menu_load(path.string(), &loaded)) {
+        return fail("load then store then load is stable",
+                    "load() returned false");
+    }
+    if (!nds_runtime_menu_store(path.string(), loaded)) {
+        return fail("load then store then load is stable",
+                    "store() returned false");
+    }
+    std::string rebuilt;
+    if (!read_text(path, &rebuilt)) {
+        return fail("load then store then load is stable",
+                    "cannot read back");
+    }
+    return check(rebuilt == many, "load then store then load is stable",
+                 "text is now " + quote(rebuilt));
+}
+
+// 14. Overlay: the form the runner uses at startup. A launcher or a command
+//     line seeds the snapshot, and only the keys the player really changed in
+//     the file may override that. So an absent key must keep the seeded value
+//     rather than resetting the field to its compiled default -- which is the
+//     difference between load() and overlay(), and the reason a saved choice is
+//     not the only choice.
+int check_overlay(const std::filesystem::path& root) {
+    const NdsRuntimeMenuSnapshot seeded = non_default_snapshot();
+
+    // One key present, everything else absent: only that field moves.
+    const std::filesystem::path one = root / "overlay-one.ini";
+    if (!write_text(one, "settings_version=12\ndisplay.screen_layout=2\n")) {
+        return fail("overlay() changes only the keys the file holds",
+                    "cannot create " + quote(one.string()));
+    }
+    NdsRuntimeMenuSnapshot overlaid = seeded;
+    if (const int rc = check(nds_runtime_menu_overlay(one.string(), &overlaid),
+                             "overlay() onto a seeded snapshot loads",
+                             "overlay() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(overlaid.screen_layout == 2,
+                             "overlay() takes display.screen_layout from the "
+                             "file",
+                             "screen_layout is " +
+                                 number(overlaid.screen_layout))) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot expected = seeded;
+    expected.screen_layout = 2;
+    if (const int rc = check(diff(expected, overlaid).empty(),
+                             "overlay() leaves every absent key alone",
+                             diff(expected, overlaid))) {
+        return rc;
+    }
+
+    // The three booleans, each present alone: a store of 0 is meaningful, so
+    // this proves the overlay is driven by presence and not by truthiness.
+    struct OneKey {
+        const char* key;
+        int NdsRuntimeMenuSnapshot::*field;
+    };
+    const OneKey booleans[3] = {
+        {"display.swap_screens", &NdsRuntimeMenuSnapshot::swap_screens},
+        {"display.second_monitor", &NdsRuntimeMenuSnapshot::second_monitor},
+        {"display.minimap", &NdsRuntimeMenuSnapshot::minimap},
+    };
+    for (const OneKey& row : booleans) {
+        const std::filesystem::path path =
+            root / ("overlay-" + std::string(row.key) + ".ini");
+        if (!write_text(path, "settings_version=12\n" + std::string(row.key) +
+                                  "=0\n")) {
+            return fail(std::string("overlay() applies ") + row.key,
+                        "cannot create " + quote(path.string()));
+        }
+        NdsRuntimeMenuSnapshot target = seeded;
+        if (const int rc = check(nds_runtime_menu_overlay(path.string(),
+                                                          &target),
+                                 std::string("overlay() with only ") + row.key +
+                                     " loads",
+                                 "overlay() returned false")) {
+            return rc;
+        }
+        NdsRuntimeMenuSnapshot want = seeded;
+        want.*(row.field) = 0;
+        if (const int rc = check(diff(want, target).empty(),
+                                 std::string("overlay() applies ") + row.key +
+                                     "=0 over the seeded 1",
+                                 diff(want, target))) {
+            return rc;
+        }
+    }
+
+    // A file holding every key replaces every field.
+    const std::filesystem::path full = root / "overlay-full.ini";
+    if (const int rc = check(nds_runtime_menu_store(full.string(),
+                                                    non_default_snapshot()),
+                             "a full file is written for the overlay",
+                             "store() returned false")) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot fresh;
+    if (const int rc = check(nds_runtime_menu_overlay(full.string(), &fresh),
+                             "overlay() of a full file loads",
+                             "overlay() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(diff(non_default_snapshot(), fresh).empty(),
+                             "overlay() of a full file replaces every field",
+                             diff(non_default_snapshot(), fresh))) {
+        return rc;
+    }
+
+    // An out-of-range value is clamped on the way in, exactly like load().
+    const std::filesystem::path wild = root / "overlay-wild.ini";
+    if (!write_text(wild, "settings_version=12\n"
+                          "display.screen_layout=9\n"
+                          "display.minimap=4\n")) {
+        return fail("overlay() clamps an out-of-range index",
+                    "cannot create " + quote(wild.string()));
+    }
+    NdsRuntimeMenuSnapshot clamped = seeded;
+    if (const int rc = check(nds_runtime_menu_overlay(wild.string(), &clamped),
+                             "overlay() of an out-of-range file loads",
+                             "overlay() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(clamped.screen_layout == 5,
+                             "overlay() clamps display.screen_layout=9 to 5",
+                             "screen_layout is " +
+                                 number(clamped.screen_layout))) {
+        return rc;
+    }
+    if (const int rc = check(clamped.minimap == 1,
+                             "overlay() clamps display.minimap=4 to 1",
+                             "minimap is " + number(clamped.minimap))) {
+        return rc;
+    }
+
+    // A missing file leaves the seeded snapshot alone and says so.
+    NdsRuntimeMenuSnapshot untouched = seeded;
+    const bool missing = nds_runtime_menu_overlay(
+        (root / "no-such-overlay.ini").string(), &untouched);
+    if (const int rc = check(!missing, "overlay() of a missing file returns "
+                                       "false",
+                             "returned true")) {
+        return rc;
+    }
+    if (const int rc = check(diff(seeded, untouched).empty(),
+                             "overlay() of a missing file leaves the snapshot "
+                             "alone",
+                             diff(seeded, untouched))) {
+        return rc;
+    }
+    return check(!nds_runtime_menu_overlay(one.string(), nullptr),
+                 "overlay() refuses a null snapshot",
+                 "returned true for nullptr");
+}
+
+// 15. Paths and failure modes of the store.
+int check_store_paths(const std::filesystem::path& root) {
+    // Parents are created, and the atomic-write temporary must not survive.
+    const std::filesystem::path deep =
+        root / "a" / "b" / "c" / "menu.ini";
+    const NdsRuntimeMenuSnapshot snapshot = non_default_snapshot();
+    if (const int rc = check(nds_runtime_menu_store(deep.string(), snapshot),
+                             "store() creates missing parent directories",
+                             "store() returned false")) {
+        return rc;
+    }
+    if (const int rc = check(std::filesystem::is_regular_file(deep),
+                             "store() creates the file inside them",
+                             "not a regular file: " + quote(deep.string()))) {
+        return rc;
+    }
+    const std::string temporary = deep.string() + ".tmp";
+    if (const int rc = check(!std::filesystem::exists(temporary),
+                             "store() leaves no .tmp sibling behind",
+                             "temporary survives: " + quote(temporary))) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot loaded;
+    (void)nds_runtime_menu_load(deep.string(), &loaded);
+    if (const int rc = check(diff(snapshot, loaded).empty(),
+                             "the file in the new directory loads back",
+                             diff(snapshot, loaded))) {
+        return rc;
+    }
+
+    // A directory as the destination is a failure, and the destination is left
+    // alone rather than turned into a file.
+    const std::filesystem::path as_directory = root / "destination";
+    std::error_code error;
+    std::filesystem::create_directories(as_directory, error);
+    if (const int rc = check(!nds_runtime_menu_store(as_directory.string(),
+                                                     snapshot),
+                             "store() to a directory returns false",
+                             "store() returned true")) {
+        return rc;
+    }
+    if (const int rc = check(std::filesystem::is_directory(as_directory),
+                             "a refused store leaves the directory alone",
+                             "the destination is no longer a directory")) {
+        return rc;
+    }
+    if (const int rc = check(!std::filesystem::exists(as_directory.string() +
+                                                      ".tmp"),
+                             "a refused store leaves no .tmp sibling",
+                             "temporary survives")) {
+        return rc;
+    }
+
+    // The failure is not sticky: the next real store works.
+    const std::filesystem::path recovered = root / "recovered.ini";
+    if (const int rc = check(nds_runtime_menu_store(recovered.string(),
+                                                     snapshot),
+                             "a store after a failure succeeds",
+                             "store() returned false")) {
+        return rc;
+    }
+    NdsRuntimeMenuSnapshot recovered_load;
+    (void)nds_runtime_menu_load(recovered.string(), &recovered_load);
+    return check(diff(snapshot, recovered_load).empty(),
+                 "the recovered file loads back identically",
+                 diff(snapshot, recovered_load));
+}
+
+// ---- driver ---------------------------------------------------------------
+
+int run_checks(const std::filesystem::path& root) {
+    if (const int rc = check_defaults()) return rc;
+    if (const int rc = check_clamp_unit()) return rc;
+    if (const int rc = check_layout_indices()) return rc;
+    if (const int rc = check_menu_rows()) return rc;
+
+    // The rest all need the temp tree; keeping them in one table means a
+    // section cannot silently be left out of the run.
+    int (*const path_sections[])(const std::filesystem::path&) = {
+        check_missing_path,
+        check_first_store,
+        check_version_line,
+        check_preservation,
+        check_round_trip,
+        check_clamp_on_load,
+        check_clamp_on_store,
+        check_unparsable,
+        check_idempotence,
+        check_overlay,
+        check_store_paths,
+    };
+    for (int (*section)(const std::filesystem::path&) : path_sections) {
+        if (const int rc = section(root)) return rc;
+    }
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// used first, but a sandboxed ctest run can refuse writes there because the
+// process working directory sits inside the tree under test, so the working
+// directory is tried second. Returns false only when neither location can hold
+// the tree, and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line that names both candidate
+    // paths stays unambiguous even when TEMP and the working directory are
+    // the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    const auto ticks =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    std::filesystem::path root;
+    if (!create_root("nds-frontend-runtime-settings-test",
+                     std::to_string(ticks), &root)) {
+        return 1;
+    }
+
+    const int result = run_checks(root);
+    std::error_code ignored;
+    std::filesystem::remove_all(root, ignored);
+    if (result != 0) {
+        std::fprintf(stderr, "%zu check(s) passed before the failure\n",
+                     g_checks);
+        return result;
+    }
+    std::printf("%zu checks passed\n", g_checks);
+    return 0;
+}
