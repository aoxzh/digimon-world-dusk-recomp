+// i.e. the table swaps red and blue and leaves green and the alpha byte alone.
+// An input of 0xFF4080C0 (R 0x40, G 0x80, B 0xC0) therefore grades to
+// 0xFFC08040, and at 50% strength red is 0x40 + (0xC0 - 0x40) * 0.5 = 0x80,
+// green stays 0x80 and blue is 0xC0 + (0x40 - 0xC0) * 0.5 = 0x80, so the blend
+// is 0xFF808080. Every row below is that same arithmetic on another pixel.
+constexpr PixelPin kSwapPins[] = {
+    {0xFF4080C0u, 0xFFC08040u, 0xFF808080u},
+    {0xFF123456u, 0xFF563412u, 0xFF343434u},
+    {0xFF000000u, 0xFF000000u, 0xFF000000u},
+    {0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu},
+    {0xFF808080u, 0xFF808080u, 0xFF808080u},
+    {0x00102030u, 0x00302010u, 0x00202020u},
+    {0x7F00FF00u, 0x7F00FF00u, 0x7F00FF00u},
+    {0x00000001u, 0x00010000u, 0x00010001u},
+    {0x000000FFu, 0x00FF0000u, 0x00800080u},
+    {0x00FF0000u, 0x000000FFu, 0x00800080u},
+    {0x7F0000FFu, 0x7FFF0000u, 0x7F800080u},
+    {0x80C0E0F0u, 0x80F0E0C0u, 0x80D8E0D8u},
+    {0xFF204060u, 0xFF604020u, 0xFF404040u},
+    {0x0000FF00u, 0x0000FF00u, 0x0000FF00u},
