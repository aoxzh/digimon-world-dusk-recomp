diff --git a/runner/src/achievements.cpp b/runner/src/achievements.cpp
new file mode 100644
index 0000000..83a830e
--- /dev/null
+++ b/runner/src/achievements.cpp
@@ -0,0 +1,903 @@
+#include "achievements.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <system_error>
+#include <utility>
+
+namespace nds_achievements {
+namespace {
+
+// ---------------------------------------------------------------------------
+// Small text helpers. The module deliberately carries its own JSON reader: the
+// runner links no JSON library, and a title's achievements.json is a small,
+// trusted-by-shape document that only needs to be read, never written.
+// ---------------------------------------------------------------------------
+
+std::string trim_ascii(const std::string& text) {
+    std::size_t begin = 0;
+    std::size_t end = text.size();
+    const auto padding = [](char ch) {
+        return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n';
+    };
+    while (begin < end && padding(text[begin])) ++begin;
+    while (end > begin && padding(text[end - 1])) --end;
+    return text.substr(begin, end - begin);
+}
+
+bool starts_with(const std::string& text, const char* prefix) {
+    const std::string head(prefix);
+    return text.size() >= head.size() &&
+           text.compare(0, head.size(), head) == 0;
+}
+
+enum class JsonType { Null, Bool, Number, String, Array, Object };
+
+struct JsonValue {
+    JsonType type = JsonType::Null;
+    bool boolean = false;
+    // Raw text of a string, or the literal token of a number.
+    std::string text;
+    bool is_integer = false;
+    std::vector<JsonValue> items;
+    std::vector<std::pair<std::string, JsonValue>> members;
+
+    const JsonValue* member(const char* key) const {
+        for (const auto& entry : members)
+            if (entry.first == key) return &entry.second;
+        return nullptr;
+    }
+};
+
+// A hand-edited file can be arbitrarily nested garbage, and this reader is
+// recursive, so the depth is capped well below where a stack overflow would
+// become the failure mode instead of a diagnostic.
+constexpr int kMaxJsonDepth = 32;
+
+struct JsonReader {
+    const std::string& text;
+    std::size_t pos = 0;
+    std::string error;
+
+    explicit JsonReader(const std::string& source) : text(source) {}
+
+    bool at_end() const { return pos >= text.size(); }
+
+    void skip_space() {
+        while (!at_end()) {
+            const char ch = text[pos];
+            if (ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r') return;
+            ++pos;
+        }
+    }
+
+    // Reports the offending byte as line:column, which is what an editor shows
+    // the author of the definition file.
+    std::string location(std::size_t at) const {
+        std::size_t line = 1;
+        std::size_t column = 1;
+        const std::size_t limit = std::min(at, text.size());
+        for (std::size_t i = 0; i < limit; ++i) {
+            if (text[i] == '\n') {
+                ++line;
+                column = 1;
+            } else {
+                ++column;
+            }
+        }
+        return std::to_string(line) + ":" + std::to_string(column);
+    }
+
+    bool fail(const std::string& what, std::size_t at) {
+        if (error.empty())
+            error = location(at) + ": " + what;
+        return false;
+    }
+
+    bool take(char wanted) {
+        if (at_end() || text[pos] != wanted) return false;
+        ++pos;
+        return true;
+    }
+
+    bool parse_document(JsonValue* out) {
+        skip_space();
+        if (at_end()) return fail("the file is empty", pos);
+        if (!parse_value(out, 0)) return false;
+        skip_space();
+        if (!at_end()) return fail("trailing text after the top-level value",
+                                   pos);
+        return true;
+    }
+
+    bool parse_value(JsonValue* out, int depth) {
+        if (depth > kMaxJsonDepth)
+            return fail("nesting is deeper than this reader allows", pos);
+        skip_space();
+        if (at_end()) return fail("unexpected end of file", pos);
+        const char ch = text[pos];
+        if (ch == '{') return parse_object(out, depth);
+        if (ch == '[') return parse_array(out, depth);
+        if (ch == '"') {
+            out->type = JsonType::String;
+            return parse_string(&out->text);
+        }
+        if (ch == '-' || (ch >= '0' && ch <= '9')) return parse_number(out);
+        if (ch == 't') return parse_word("true", true, out);
+        if (ch == 'f') return parse_word("false", false, out);
+        if (ch == 'n') return parse_word("null", false, out);
+        return fail("expected a value", pos);
+    }
+
+    bool parse_word(const char* word, bool boolean, JsonValue* out) {
+        const std::string literal(word);
+        if (text.compare(pos, literal.size(), literal) != 0)
+            return fail("expected '" + literal + "'", pos);
+        pos += literal.size();
+        out->type =
+            literal == "null" ? JsonType::Null : JsonType::Bool;
+        out->boolean = boolean;
+        return true;
+    }
+
+    bool parse_hex4(std::uint32_t* out) {
+        if (pos + 4 > text.size()) return fail("incomplete \\u escape", pos);
+        std::uint32_t value = 0;
+        for (int i = 0; i < 4; ++i) {
+            const char ch = text[pos + static_cast<std::size_t>(i)];
+            std::uint32_t digit = 0;
+            if (ch >= '0' && ch <= '9') {
+                digit = static_cast<std::uint32_t>(ch - '0');
+            } else if (ch >= 'a' && ch <= 'f') {
+                digit = static_cast<std::uint32_t>(ch - 'a' + 10);
+            } else if (ch >= 'A' && ch <= 'F') {
+                digit = static_cast<std::uint32_t>(ch - 'A' + 10);
+            } else {
+                return fail("\\u must be followed by four hex digits", pos);
+            }
+            value = value * 16u + digit;
+        }
+        pos += 4;
+        *out = value;
+        return true;
+    }
+
+    static void append_utf8(std::uint32_t code_point, std::string* out) {
+        if (code_point <= 0x7Fu) {
+            out->push_back(static_cast<char>(code_point));
+        } else if (code_point <= 0x7FFu) {
+            out->push_back(static_cast<char>(0xC0u | (code_point >> 6)));
+            out->push_back(static_cast<char>(0x80u | (code_point & 0x3Fu)));
+        } else if (code_point <= 0xFFFFu) {
+            out->push_back(static_cast<char>(0xE0u | (code_point >> 12)));
+            out->push_back(
+                static_cast<char>(0x80u | ((code_point >> 6) & 0x3Fu)));
+            out->push_back(static_cast<char>(0x80u | (code_point & 0x3Fu)));
+        } else {
+            out->push_back(static_cast<char>(0xF0u | (code_point >> 18)));
+            out->push_back(
+                static_cast<char>(0x80u | ((code_point >> 12) & 0x3Fu)));
+            out->push_back(
+                static_cast<char>(0x80u | ((code_point >> 6) & 0x3Fu)));
+            out->push_back(static_cast<char>(0x80u | (code_point & 0x3Fu)));
+        }
+    }
+
+    bool parse_string(std::string* out) {
+        if (!take('"')) return fail("expected a string", pos);
+        out->clear();
+        while (true) {
+            if (at_end()) return fail("unterminated string", pos);
+            const char ch = text[pos];
+            if (ch == '"') {
+                ++pos;
+                return true;
+            }
+            if (ch == '\\') {
+                ++pos;
+                if (at_end()) return fail("unterminated escape", pos);
+                const char escape = text[pos];
+                ++pos;
+                switch (escape) {
+                    case '"': out->push_back('"'); break;
+                    case '\\': out->push_back('\\'); break;
+                    case '/': out->push_back('/'); break;
+                    case 'b': out->push_back('\b'); break;
+                    case 'f': out->push_back('\f'); break;
+                    case 'n': out->push_back('\n'); break;
+                    case 'r': out->push_back('\r'); break;
+                    case 't': out->push_back('\t'); break;
+                    case 'u': {
+                        std::uint32_t code_point = 0;
+                        if (!parse_hex4(&code_point)) return false;
+                        // A surrogate pair is two escapes; a lone surrogate is
+                        // not JSON the standard permits but every lenient
+                        // reader emits U+FFFD for it, and rejecting the whole
+                        // file over one is worse than one wrong glyph.
+                        if (code_point >= 0xD800u && code_point <= 0xDBFFu &&
+                            text.compare(pos, 2, "\\u") == 0) {
+                            const std::size_t save = pos;
+                            pos += 2;
+                            std::uint32_t low = 0;
+                            if (parse_hex4(&low) && low >= 0xDC00u &&
+                                low <= 0xDFFFu) {
+                                code_point = 0x10000u +
+                                    ((code_point - 0xD800u) << 10) +
+                                    (low - 0xDC00u);
+                            } else {
+                                pos = save;
+                                code_point = 0xFFFDu;
+                            }
+                        } else if (code_point >= 0xD800u &&
+                                   code_point <= 0xDFFFu) {
+                            code_point = 0xFFFDu;
+                        }
+                        append_utf8(code_point, out);
+                        break;
+                    }
+                    default:
+                        return fail("unknown escape in a string", pos - 1);
+                }
+                continue;
+            }
+            // A raw control byte inside a string is never valid JSON and is
+            // what a file damaged in transit or by an editor usually looks
+            // like, so it is reported rather than passed through.
+            if (static_cast<unsigned char>(ch) < 0x20u)
+                return fail("raw control character in a string", pos);
+            out->push_back(ch);
+            ++pos;
+        }
+    }
+
+    bool parse_number(JsonValue* out) {
+        const std::size_t begin = pos;
+        if (at_end()) return fail("expected a number", pos);
+        if (text[pos] == '-') ++pos;
+        std::size_t digits = 0;
+        while (!at_end() && text[pos] >= '0' && text[pos] <= '9') {
+            ++pos;
+            ++digits;
+        }
+        if (digits == 0u) return fail("expected a number", begin);
+        bool integer = true;
+        if (!at_end() && text[pos] == '.') {
+            integer = false;
+            ++pos;
+            std::size_t fraction = 0;
+            while (!at_end() && text[pos] >= '0' && text[pos] <= '9') {
+                ++pos;
+                ++fraction;
+            }
+            if (fraction == 0u) return fail("expected digits after '.'", pos);
+        }
+        if (!at_end() && (text[pos] == 'e' || text[pos] == 'E')) {
+            integer = false;
+            ++pos;
+            if (!at_end() && (text[pos] == '+' || text[pos] == '-')) ++pos;
+            std::size_t exponent = 0;
+            while (!at_end() && text[pos] >= '0' && text[pos] <= '9') {
+                ++pos;
+                ++exponent;
+            }
+            if (exponent == 0u) return fail("expected digits in the exponent",
+                                            pos);
+        }
+        out->type = JsonType::Number;
+        out->text = text.substr(begin, pos - begin);
+        out->is_integer = integer;
+        return true;
+    }
+
+    bool parse_array(JsonValue* out, int depth) {
+        out->type = JsonType::Array;
+        ++pos;
+        skip_space();
+        if (take(']')) return true;
+        while (true) {
+            JsonValue item;
+            if (!parse_value(&item, depth + 1)) return false;
+            out->items.push_back(std::move(item));
+            skip_space();
+            if (take(',')) continue;
+            if (take(']')) return true;
+            return fail("expected ',' or ']' in an array", pos);
+        }
+    }
+
+    bool parse_object(JsonValue* out, int depth) {
+        out->type = JsonType::Object;
+        ++pos;
+        skip_space();
+        if (take('}')) return true;
+        while (true) {
+            skip_space();
+            if (at_end()) return fail("unexpected end of file in an object",
+                                      pos);
+            std::string key;
+            if (!parse_string(&key)) return false;
+            skip_space();
+            if (!take(':')) return fail("expected ':' after a key", pos);
+            JsonValue value;
+            if (!parse_value(&value, depth + 1)) return false;
+            out->members.emplace_back(std::move(key), std::move(value));
+            skip_space();
+            if (take(',')) continue;
+            if (take('}')) return true;
+            return fail("expected ',' or '}' in an object", pos);
+        }
+    }
+};
+
+// An id is kebab-case and a counter or flag is snake_case, so the two
+// vocabularies cannot be confused in a progress file where "unlocked=" and
+// "counter." lines live side by side. Both are restricted to what the runner's
+// own code can spell: a typo here would otherwise produce an achievement that
+// can never be earned and reports nothing.
+bool is_token(const std::string& text, char separator) {
+    if (text.empty() || text.size() > 64u) return false;
+    // A leading letter keeps the name readable in a file and in a log line;
+    // a leading digit or separator reads as a truncation.
+    if (text.front() < 'a' || text.front() > 'z') return false;
+    if (text.back() < 'a' || text.back() > 'z') {
+        // A trailing digit is fine ("wave2"); a trailing separator is not.
+        if (text.back() < '0' || text.back() > '9') return false;
+    }
+    char previous = '\0';
+    for (const char ch : text) {
+        const bool lower = ch >= 'a' && ch <= 'z';
+        const bool digit = ch >= '0' && ch <= '9';
+        if (!lower && !digit && ch != separator) return false;
+        if (ch == separator && previous == separator) return false;
+        previous = ch;
+    }
+    return true;
+}
+
+std::string show(const std::string& text) { return "\"" + text + "\""; }
+
+bool read_text_file(const std::string& path, std::string* out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    out->assign((std::istreambuf_iterator<char>(in)),
+                std::istreambuf_iterator<char>());
+    return true;
+}
+
+bool parse_int64(const std::string& text, std::int64_t* out) {
+    if (text.empty()) return false;
+    char* end = nullptr;
+    const long long value = std::strtoll(text.c_str(), &end, 10);
+    if (end == nullptr || *end != '\0') return false;
+    *out = static_cast<std::int64_t>(value);
+    return true;
+}
+
+bool member_string(const JsonValue& object, const char* key, std::string* out) {
+    const JsonValue* value = object.member(key);
+    if (!value || value->type != JsonType::String) return false;
+    *out = value->text;
+    return true;
+}
+
+bool member_int64(const JsonValue& object, const char* key, std::int64_t* out) {
+    const JsonValue* value = object.member(key);
+    if (!value || value->type != JsonType::Number || !value->is_integer)
+        return false;
+    return parse_int64(value->text, out);
+}
+
+bool kind_from_name(const std::string& name, NdsAchievementKind* out) {
+    if (name == "counter") {
+        *out = NdsAchievementKind::Counter;
+        return true;
+    }
+    if (name == "flag") {
+        *out = NdsAchievementKind::Flag;
+        return true;
+    }
+    if (name == "counter_ge_all") {
+        *out = NdsAchievementKind::CounterGeAll;
+        return true;
+    }
+    return false;
+}
+
+// The definitions and progress share one view of "earned", so an unlock can
+// never depend on which of the two entry points asked.
+bool is_earned(const NdsAchievementState& state, const NdsAchievement& entry) {
+    switch (entry.kind) {
+        case NdsAchievementKind::Counter: {
+            const auto found = state.counters.find(entry.counter);
+            return found != state.counters.end() &&
+                   found->second >= entry.target;
+        }
+        case NdsAchievementKind::Flag:
+            return state.flags.count(entry.flag) != 0u;
+        case NdsAchievementKind::CounterGeAll:
+            if (entry.counters.empty()) return false;
+            for (const std::string& name : entry.counters) {
+                const auto found = state.counters.find(name);
+                if (found == state.counters.end()) return false;
+                if (found->second < entry.target) return false;
+            }
+            return true;
+    }
+    return false;
+}
+
+// Unlocks every definition that is now earned but not yet recorded, in
+// definition order. `notify` decides whether the caller hears about it: an
+// observation is a live event and is announced, while loading a file restores
+// what an earlier session already earned and must not fire a notification for
+// a save the player made last week.
+void unlock_ready(NdsAchievementState* state, bool notify) {
+    state->unlocked_now.clear();
+    for (const NdsAchievement& entry : state->definitions) {
+        if (state->unlocked.count(entry.id) != 0u) continue;
+        if (!is_earned(*state, entry)) continue;
+        state->unlocked.insert(entry.id);
+        if (notify) state->unlocked_now.push_back(entry);
+    }
+}
+
+constexpr const char* kProgressVersion = "achievements_version";
+constexpr int kProgressVersionValue = 1;
+constexpr const char* kUnlockedKey = "unlocked";
+constexpr const char* kCounterPrefix = "counter.";
+// Without this line the file never finished being written (or was copied while
+// being written), which is the one damage an atomic rename cannot rule out.
+constexpr const char* kEndMarker = "# end";
+
+bool definition_has_id(const NdsAchievementState& state,
+                       const std::string& id) {
+    for (const NdsAchievement& entry : state.definitions)
+        if (entry.id == id) return true;
+    return false;
+}
+
+void note(std::vector<std::string>* diagnostics, const std::string& line) {
+    if (diagnostics) diagnostics->push_back(line);
+}
+
+}  // namespace
+
+bool load_definitions(const std::string& path,
+                      std::vector<NdsAchievement>* out,
+                      std::vector<std::string>* diagnostics) {
+    if (diagnostics) diagnostics->clear();
+    std::string text;
+    if (!read_text_file(path, &text)) {
+        note(diagnostics, "cannot read " + show(path));
+        return false;
+    }
+    JsonReader reader(text);
+    JsonValue document;
+    if (!reader.parse_document(&document)) {
+        note(diagnostics, show(path) + ": malformed JSON: " + reader.error);
+        return false;
+    }
+    if (document.type != JsonType::Object) {
+        note(diagnostics, show(path) +
+                              ": the top-level value must be an object");
+        return false;
+    }
+    const JsonValue* entries = document.member("achievements");
+    if (!entries) {
+        note(diagnostics, show(path) + ": no \"achievements\" array");
+        return false;
+    }
+    if (entries->type != JsonType::Array) {
+        note(diagnostics, show(path) + ": \"achievements\" must be an array");
+        return false;
+    }
+
+    // Parsed into a local table, so a document rejected as a whole leaves the
+    // caller's previous definition set untouched.
+    std::vector<NdsAchievement> parsed;
+    std::vector<std::string> problems;
+    for (std::size_t index = 0; index < entries->items.size(); ++index) {
+        const JsonValue& item = entries->items[index];
+        const std::string where =
+            "achievements[" + std::to_string(index) + "]";
+        if (item.type != JsonType::Object) {
+            problems.push_back(where + ": not an object");
+            continue;
+        }
+        std::string id;
+        if (!member_string(item, "id", &id) || id.empty()) {
+            problems.push_back(where + ": missing or non-string \"id\"");
+            continue;
+        }
+        const std::string label = where + " id " + show(id) + ": ";
+        NdsAchievement entry;
+        entry.id = id;
+        if (!is_token(id, '-')) {
+            problems.push_back(label + "an id is kebab-case lowercase");
+            continue;
+        }
+        if (!member_string(item, "name", &entry.name) || entry.name.empty()) {
+            problems.push_back(label + "missing or empty \"name\"");
+            continue;
+        }
+        if (entry.name.size() > 128u) {
+            problems.push_back(label + "\"name\" is longer than 128 bytes");
+            continue;
+        }
+        // A description is optional: an achievement whose name says everything
+        // should not have to repeat itself.
+        if (const JsonValue* value = item.member("description")) {
+            if (value->type != JsonType::String) {
+                problems.push_back(label + "\"description\" is not a string");
+                continue;
+            }
+            entry.description = value->text;
+        }
+        std::string kind_name = "counter";
+        if (const JsonValue* value = item.member("kind")) {
+            if (value->type != JsonType::String) {
+                problems.push_back(label + "\"kind\" is not a string");
+                continue;
+            }
+            kind_name = value->text;
+        }
+        if (!kind_from_name(kind_name, &entry.kind)) {
+            problems.push_back(label + "unknown \"kind\" " + show(kind_name));
+            continue;
+        }
+        if (const JsonValue* value = item.member("hidden")) {
+            if (value->type != JsonType::Bool) {
+                problems.push_back(label + "\"hidden\" is not a boolean");
+                continue;
+            }
+            entry.hidden = value->boolean;
+        }
+        if (entry.kind == NdsAchievementKind::Flag) {
+            if (!member_string(item, "flag", &entry.flag) ||
+                !is_token(entry.flag, '_')) {
+                problems.push_back(
+                    label + "a flag achievement needs a snake_case \"flag\"");
+                continue;
+            }
+            entry.target = 1;
+        } else {
+            std::int64_t target = 0;
+            if (!member_int64(item, "target", &target)) {
+                problems.push_back(
+                    label + "a counter achievement needs an integer "
+                            "\"target\"");
+                continue;
+            }
+            // Zero would be earned before the game starts, which is not what
+            // any title means by a target.
+            if (target < 1) {
+                problems.push_back(label + "\"target\" must be at least 1");
+                continue;
+            }
+            entry.target = target;
+        }
+        if (entry.kind == NdsAchievementKind::Counter) {
+            if (!member_string(item, "counter", &entry.counter) ||
+                !is_token(entry.counter, '_')) {
+                problems.push_back(
+                    label + "needs a snake_case \"counter\"");
+                continue;
+            }
+        }
+        if (entry.kind == NdsAchievementKind::CounterGeAll) {
+            const JsonValue* list = item.member("counters");
+            if (!list || list->type != JsonType::Array || list->items.empty()) {
+                problems.push_back(
+                    label + "counter_ge_all needs a non-empty \"counters\" "
+                            "array");
+                continue;
+            }
+            bool ok = true;
+            for (const JsonValue& element : list->items) {
+                if (element.type != JsonType::String ||
+                    !is_token(element.text, '_')) {
+                    problems.push_back(label + "every entry of \"counters\" "
+                                              "must be a snake_case name");
+                    ok = false;
+                    break;
+                }
+                // A name listed twice would count one counter as two, so the
+                // "all N" target could never be met honestly.
+                if (std::find(entry.counters.begin(), entry.counters.end(),
+                              element.text) != entry.counters.end()) {
+                    problems.push_back(label + "\"counters\" lists " +
+                                       show(element.text) + " twice");
+                    ok = false;
+                    break;
+                }
+                entry.counters.push_back(element.text);
+            }
+            if (!ok) continue;
+        }
+        // A duplicated id would make one definition unreachable and the other
+        // ambiguous in the progress file, so the first one wins.
+        bool duplicate = false;
+        for (const NdsAchievement& kept : parsed)
+            if (kept.id == entry.id) duplicate = true;
+        if (duplicate) {
+            problems.push_back(label + "duplicate id, keeping the first");
+            continue;
+        }
+        parsed.push_back(std::move(entry));
+    }
+
+    if (out) *out = std::move(parsed);
+    for (const std::string& problem : problems) note(diagnostics, problem);
+    return true;
+}
+
+void set_definitions(NdsAchievementState* state,
+                     const std::vector<NdsAchievement>& definitions) {
+    if (!state) return;
+    state->definitions = definitions;
+    state->unlocked_now.clear();
+    // Every unlock this state knows about, wherever it is currently filed. An
+    // unlock whose definition the new set has lost is kept in the orphan set
+    // rather than dropped: a definition file that is edited and then restored
+    // must restore the progress with it.
+    std::set<std::string> known = state->unlocked;
+    known.insert(state->orphan_unlocked.begin(), state->orphan_unlocked.end());
+    state->unlocked.clear();
+    state->orphan_unlocked.clear();
+    for (const std::string& id : known) {
+        if (definition_has_id(*state, id))
+            state->unlocked.insert(id);
+        else
+            state->orphan_unlocked.insert(id);
+    }
+}
+
+void observe(NdsAchievementState* state, const char* counter,
+             std::int64_t value) {
+    if (!state) return;
+    state->unlocked_now.clear();
+    if (counter) {
+        const std::string name = trim_ascii(counter);
+        if (!name.empty()) {
+            std::int64_t& mark = state->counters[name];
+            // The mark only ever rises: a new game in the guest resets its own
+            // counters, and an achievement earned before that reset stays
+            // earned, so a lower reading is noise rather than a rollback.
+            if (value > mark) mark = value;
+        }
+    }
+    unlock_ready(state, true);
+}
+
+void raise_flag(NdsAchievementState* state, const char* flag) {
+    if (!state) return;
+    state->unlocked_now.clear();
+    if (flag) {
+        const std::string name = trim_ascii(flag);
+        if (!name.empty()) state->flags.insert(name);
+    }
+    unlock_ready(state, true);
+}
+
+void refresh_unlocks(NdsAchievementState* state) {
+    if (!state) return;
+    unlock_ready(state, false);
+}
+
+const std::vector<NdsAchievement>& unlocked_by_last_observation(
+    const NdsAchievementState& state) {
+    return state.unlocked_now;
+}
+
+std::vector<NdsAchievement> listed_definitions(
+    const NdsAchievementState& state) {
+    std::vector<NdsAchievement> listed;
+    for (const NdsAchievement& entry : state.definitions) {
+        // Hiding is a surprise, not a secret kept from the person who earned
+        // it, so an earned hidden achievement becomes visible.
+        if (entry.hidden && state.unlocked.count(entry.id) == 0u) continue;
+        listed.push_back(entry);
+    }
+    return listed;
+}
+
+NdsAchievementSummary summarize(const NdsAchievementState& state) {
+    NdsAchievementSummary summary;
+    for (const NdsAchievement& entry : state.definitions) {
+        const bool unlocked = state.unlocked.count(entry.id) != 0u;
+        ++summary.total;
+        if (unlocked) ++summary.unlocked;
+        if (entry.hidden) {
+            ++summary.hidden_total;
+            if (unlocked) ++summary.hidden_unlocked;
+        } else {
+            ++summary.visible_total;
+            if (unlocked) ++summary.visible_unlocked;
+        }
+    }
+    return summary;
+}
+
+bool is_unlocked(const NdsAchievementState& state, const std::string& id) {
+    if (state.unlocked.count(id) != 0u) return true;
+    return state.orphan_unlocked.count(id) != 0u;
+}
+
+std::int64_t counter_high_water(const NdsAchievementState& state,
+                                const std::string& counter) {
+    const auto found = state.counters.find(counter);
+    return found == state.counters.end() ? 0 : found->second;
+}
+
+const NdsAchievement* find_definition(const NdsAchievementState& state,
+                                      const std::string& id) {
+    for (const NdsAchievement& entry : state.definitions)
+        if (entry.id == id) return &entry;
+    return nullptr;
+}
+
+bool load_progress(NdsAchievementState* state, const std::string& path,
+                   std::vector<std::string>* diagnostics) {
+    if (diagnostics) diagnostics->clear();
+    if (!state) return false;
+    std::string text;
+    if (!read_text_file(path, &text)) {
+        note(diagnostics, "cannot read " + show(path));
+        return false;
+    }
+    std::vector<std::string> lines;
+    std::string current;
+    for (const char ch : text) {
+        if (ch == '\n') {
+            lines.push_back(trim_ascii(current));
+            current.clear();
+        } else {
+            current.push_back(ch);
+        }
+    }
+    if (!trim_ascii(current).empty()) lines.push_back(trim_ascii(current));
+
+    // A file that does not end with the marker never finished being written,
+    // so its last line may be half a record: "unlocked=first-sa" would
+    // otherwise enter the state as an orphan id nobody can explain.
+    bool truncated = true;
+    for (const std::string& line : lines)
+        if (line == kEndMarker) truncated = false;
+    if (truncated) {
+        note(diagnostics, show(path) +
+                              ": no end marker, treating the file as "
+                              "truncated");
+        if (!lines.empty()) lines.pop_back();
+    }
+
+    // Additive only: nothing below removes an unlock or lowers a counter, so a
+    // damaged file can add noise but cannot destroy state the runner computed
+    // this session. Re-storing the state rewrites the file clean.
+    for (std::size_t index = 0; index < lines.size(); ++index) {
+        const std::string& line = lines[index];
+        if (line.empty() || line[0] == '#') continue;
+        const std::string where =
+            "line " + std::to_string(index + 1) + ": ";
+        const std::size_t equals = line.find('=');
+        if (equals == std::string::npos) {
+            note(diagnostics, where + "ignored, no '='");
+            continue;
+        }
+        const std::string key = trim_ascii(line.substr(0, equals));
+        const std::string value = trim_ascii(line.substr(equals + 1));
+        if (key.empty()) {
+            note(diagnostics, where + "ignored, empty key");
+            continue;
+        }
+        if (key == kProgressVersion) {
+            // Read but not enforced: a newer writer must not make an older
+            // runner refuse the whole file when every line it needs still
+            // parses.
+            continue;
+        }
+        if (key == kUnlockedKey) {
+            if (!is_token(value, '-')) {
+                note(diagnostics, where + "ignored unlock " + show(value));
+                continue;
+            }
+            if (definition_has_id(*state, value)) {
+                state->unlocked.insert(value);
+            } else {
+                // A progress file from a build whose definitions differ: the
+                // unlock is still the player's, so it is kept aside instead of
+                // dropped and restored if the definition comes back.
+                state->orphan_unlocked.insert(value);
+            }
+            continue;
+        }
+        if (starts_with(key, kCounterPrefix)) {
+            const std::string name = key.substr(std::string(kCounterPrefix)
+                                                    .size());
+            std::int64_t value_as_int = 0;
+            if (!is_token(name, '_')) {
+                note(diagnostics, where + "ignored counter " + show(name));
+                continue;
+            }
+            if (!parse_int64(value, &value_as_int)) {
+                note(diagnostics,
+                     where + "ignored counter " + show(name) +
+                         ": not an integer");
+                continue;
+            }
+            std::int64_t& mark = state->counters[name];
+            if (value_as_int > mark) mark = value_as_int;
+            continue;
+        }
+        note(diagnostics, where + "ignored unknown key " + show(key));
+    }
+    return true;
+}
+
+bool store_progress(const NdsAchievementState& state,
+                    const std::string& path) {
+    if (path.empty()) return false;
+    const std::filesystem::path target(path);
+    std::error_code error;
+    if (!target.parent_path().empty()) {
+        std::filesystem::create_directories(target.parent_path(), error);
+        if (error) return false;
+    }
+    std::string text;
+    text += kProgressVersion;
+    text += '=';
+    text += std::to_string(kProgressVersionValue);
+    text += '\n';
+    // Definition order first, then orphans in name order, so an unchanged
+    // state rewrites a byte-identical file.
+    for (const NdsAchievement& entry : state.definitions) {
+        if (state.unlocked.count(entry.id) == 0u) continue;
+        text += kUnlockedKey;
+        text += '=';
+        text += entry.id;
+        text += '\n';
+    }
+    for (const std::string& id : state.orphan_unlocked) {
+        text += kUnlockedKey;
+        text += '=';
+        text += id;
+        text += '\n';
+    }
+    // std::map already iterates in name order, which is the determinism this
+    // file wants and is also the order a human reads it in.
+    for (const auto& counter : state.counters) {
+        text += kCounterPrefix;
+        text += counter.first;
+        text += '=';
+        text += std::to_string(counter.second);
+        text += '\n';
+    }
+    text += kEndMarker;
+    text += '\n';
+
+    // Write beside the target and rename over it: a reader either sees the old
+    // file or the new one, and a crash mid-write leaves the old one usable.
+    std::filesystem::path temporary = target;
+    temporary += ".tmp";
+    {
+        std::ofstream out(temporary, std::ios::trunc | std::ios::binary);
+        if (!out) return false;
+        out.write(text.data(), static_cast<std::streamsize>(text.size()));
+        out.flush();
+        if (!out) {
+            out.close();
+            std::filesystem::remove(temporary, error);
+            return false;
+        }
+    }
+    std::filesystem::rename(temporary, target, error);
+    if (error) {
+        std::filesystem::remove(temporary, error);
+        return false;
+    }
+    return true;
+}
+
+}  // namespace nds_achievements
