+}
+
+const uint32_t* runtime_menu_overlay(RecompRuntimeUi* ui,
+                                     const uint32_t* pixels,
+                                     int width,
+                                     int height) {
+    // A toast is a notice the player must see with the menu CLOSED -- that is
+    // the whole point of it -- so the gate is "menu open OR toast showing"
+    // rather than "menu open".
+    if (!ui || !pixels || width <= 0 || height <= 0) return pixels;
+    if (!recomp_runtime_ui_is_open(ui) &&
+        !recomp_runtime_ui_toast_visible(ui)) {
+        return pixels;
+    }
+    static std::vector<uint32_t> surface;
+    const size_t count = static_cast<size_t>(width) *
+                         static_cast<size_t>(height);
+    surface.assign(pixels, pixels + count);
+    recomp_runtime_ui_render_argb8888(
+        ui, surface.data(), width, height, width * sizeof(uint32_t));
+    return surface.data();
+}
+
+// Host-side display post-processing: the DS colour-reproduction curve and the
+// LCD pixel grid. Applied to the composed guest picture and BEFORE the menu
+// overlay, because the menu is a host surface and tinting its text would be a
+// different feature.
+//
+// Returns the input pointer untouched when neither effect is active, so the
+// shipped picture is the exact guest framebuffer and nothing in the digest or
+// the black-band scan sees a copy that happens to be identical.
+const uint32_t* filtered_screen(const uint32_t* pixels,
+                                int screen,
+                                int width,
+                                int height,
+                                int color_mode,
+                                bool lcd_grid,
+                                int pixel_filter) {
+    if (!pixels || width <= 0 || height <= 0) return pixels;
+    uint8_t lut[256];
+    nds_display_filter::build_lut(color_mode, lut);
+    const bool pixel_pass =
+        nds_display_filter::pixel_filter_is_valid(pixel_filter) &&
+        pixel_filter != nds_display_filter::kPixelFilterNearest;
+    if (!lcd_grid && !pixel_pass && nds_display_filter::lut_is_identity(lut))
+        return pixels;
+    // Two buffers per screen: the spatial filter reads its neighbours, so it
+    // cannot write over the surface it is reading. Making them static means a
+    // steady state allocates nothing per frame.
+    static std::vector<uint32_t> surfaces[2];
+    static std::vector<uint32_t> spatial[2];
+    const size_t count =
+        static_cast<size_t>(width) * static_cast<size_t>(height);
+    const size_t slot = screen == 1 ? 1u : 0u;
+    std::vector<uint32_t>& surface = surfaces[slot];
+    surface.resize(count);
+    if (!nds_display_filter::apply(pixels, surface.data(), width, height,
+                                   width, color_mode, lcd_grid)) {
+        return pixels;
+    }
+    if (!pixel_pass) return surface.data();
+    // Spatial filter last: the LCD grid is a panel effect and must stay on top
+    // of a filtered picture instead of being blurred or sharpened itself, and
+    // sharpening wants the final colour values it is meant to exaggerate.
+    std::vector<uint32_t>& scratch = spatial[slot];
+    scratch.resize(count);
+    if (!nds_display_filter::apply_pixel_filter(
+            surface.data(), scratch.data(), width, height, pixel_filter)) {
+        return surface.data();
+    }
+    return scratch.data();
+}
+
+struct FrontendPresentation {
+    bool separate = false;
+    bool gl_top = false;
+    SDL_Window* windows[2]{};
+    SDL_Renderer* renderers[2]{};
+    SDL_Texture* textures[2]{};
+    SDL_Texture* sample_targets[2]{};
+    uint32_t window_ids[2]{};
+    int screen_widths[2]{kScreenWidth, kScreenWidth};
+    int canvas_width = kScreenWidth;
+    int configured_sample_scale = 1;
+    int sample_scale = 1;
+    // Where each DS picture is drawn inside the logical canvas, how large each
+    // window is, and which screen each window shows. EVERY consumer -- the
+    // window size, SDL_RenderSetLogicalSize, the draw rects and the touch
+    // mapping -- reads this one answer, so the picture and the stylus cannot
+    // disagree. Regenerated by refresh_presentation_geometry() whenever one of
+    // the knobs below changes.
+    nds_screen_presentation::NdsPresentationGeometry geometry{};
+    nds_screen_layout::NdsScreenLayoutKind layout_kind =
+        nds_screen_layout::kNdsLayoutStacked;
+    // The presentation shape currently installed. Kept here rather than read
+    // from options every time, because the settings menu can change it in a
+    // running session: options holds what the process was LAUNCHED with, and
+    // that stops being the truth the moment the player touches the row.
+    NdsScreenLayout layout = NdsScreenLayout::Stacked;
+    int window_scale = kWindowScale;
+    // The compiled-in window multiplier, kept so the debug/selftest injectors
+    // still convert their coordinates the way they always did.
+    int base_window_scale = kWindowScale;
+    int adaptive_width = 0;
+    bool swap_screens = false;
+    bool second_monitor = false;
+    // Draw the screen a one-screen layout is not showing as a small inset
+    // over the visible picture. Meaningless in two-window mode, where both
+    // screens are already on a display.
+    bool minimap = false;
+    // True once the knobs above describe a request someone actually made. A
+    // freshly built presentation has none, and create_presentation() then takes
+    // them from the launch options; a presentation rebuilt for a menu change
+    // arrives with them already set and must keep them.
+    bool knobs_seeded = false;
+};
+
+// docs/frame_interpolation.md, MVP blend mode. Holds the previous DS frame's
+// post-compositor ARGB pixels per screen plus the scratch the blend is built
+// into. These are copies taken after composition, so nothing the guest can
+// observe is involved and no scheduler work is attached to them.
+struct FrameBlendCache {
+    std::vector<uint32_t> previous[2];
+    std::vector<uint32_t> blended[2];
+    int widths[2]{0, 0};
+    bool valid = false;
+};
+
+// 50/50 per-channel average, the alpha 0.5 midpoint the 120 Hz target wants.
+// The low bit of each channel is dropped rather than rounded (invisible at 8
+// bits, one pass of cheap word arithmetic over ~100k pixels), and the alpha
+// byte is carried straight from the current frame so a blended upload is
+// byte-compatible with the real uploads either side of it.
+void blend_half(const uint32_t* previous, const uint32_t* current,
+                uint32_t* out, size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+        out[i] = (current[i] & 0xFF000000u) |
+                 (((previous[i] >> 1) & 0x007F7F7Fu) +
+                  ((current[i] >> 1) & 0x007F7F7Fu));
+    }
+}
+
+void cache_presented_frame(FrameBlendCache& cache, int screen,
+                           const uint32_t* pixels, int width) {
+    const size_t count = static_cast<size_t>(width) * kScreenHeight;
+    if (cache.widths[screen] != width) {
+        cache.widths[screen] = width;
+        cache.previous[screen].assign(count, 0u);
+        cache.blended[screen].assign(count, 0u);
+    }
+    std::memcpy(cache.previous[screen].data(), pixels,
+                count * sizeof(uint32_t));
+}
