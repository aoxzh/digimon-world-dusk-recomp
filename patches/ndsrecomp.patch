+                        (mag - kVirtualStylusDeadzone) /
+                        (1.0f - kVirtualStylusDeadzone);
+                    const float rate = curved * curved * 5.0f *
+                        (options.virtual_stylus.pad_sensitivity / 100.0f) /
+                        mag;
