+// ---------------------------------------------------------------------------
+// The contract, swept over canvases nobody would think to try by hand
+// ---------------------------------------------------------------------------
+
+struct Invariant {
+    int count = 0;
+    std::string example;
+
+    void note(const std::string& what) {
+        if (count == 0) example = what;
+        ++count;
+    }
+
+    std::string detail(const char* name) const {
+        return std::string(name) + ": " + number(count) +
+               " violation(s); first " + example;
+    }
+};
+
+void check_contract() {
+    const struct {
+        int width;
+        int height;
+    } kCanvases[] = {
+        {1, 1},       {255, 192},   {256, 191},  {256, 192},  {256, 193},
+        {257, 192},   {511, 191},   {512, 191},  {512, 192},  {512, 193},
+        {512, 384},   {513, 385},   {520, 256},  {640, 480},  {641, 1000},
+        {720, 480},   {768, 432},   {777, 600},  {800, 600},  {800, 601},
+        {801, 601},   {1023, 1024}, {1024, 512}, {1024, 768}, {1280, 720},
+        {1281, 721},  {1366, 768},  {1367, 769}, {1440, 900}, {1600, 900},
+        {1920, 1080}, {1921, 1081}, {2560, 1440}, {3840, 2160}, {999, 333},
+        {233, 1999},  {4096, 17},   {17, 4096},  {383, 700},  {16384, 16384},
+        {16385, 16384}, {16384, 16385}, {16385, 100}, {100, 16385},
+        {0, 100},    {-1, 100},   {100, 0},    {100, -1},
+    };
+
+    Invariant overlap;
+    Invariant overflow;
+    Invariant aspect;
+    Invariant centring;
+    Invariant unused;
+    Invariant scale;
+    Invariant validity;
+
+    for (int index = 0; index < kNdsLayoutKindCount; ++index) {
+        const NdsScreenLayoutKind kind =
+            static_cast<NdsScreenLayoutKind>(index);
+        for (const auto& canvas : kCanvases) {
+            for (int integer = 0; integer < 2; ++integer) {
+                for (int swap = 0; swap < 2; ++swap) {
+                    const bool integer_scale = integer != 0;
+                    const NdsScreenLayoutResult result = compute_layout(
+                        kind, canvas.width, canvas.height, integer_scale,
+                        swap != 0);
+                    const std::string where =
+                        std::string(layout_name(kind)) + " on " +
+                        number(canvas.width) + "x" + number(canvas.height) +
+                        (integer_scale ? " integer" : " fractional") +
+                        (swap != 0 ? " swapped" : "");
+
+                    const bool want_valid =
+                        request_is_valid(index, canvas.width, canvas.height);
+                    if (result.valid != want_valid) {
+                        validity.note(where + ": got " +
+                                      (result.valid ? "valid" : "refused"));
+                        continue;
+                    }
+                    if (result.canvas_width != canvas.width ||
+                        result.canvas_height != canvas.height) {
+                        validity.note(where + ": canvas echo changed");
+                    }
+                    if (!result.valid) {
+                        // A refusal must be inert: nothing to draw, nothing
+                        // left over, nothing that could be read as a scale.
+                        if (result.native_scale != 0 ||
+                            result.unused_canvas_pixels != 0 ||
+                            !rects_equal(result.rects[kNdsScreenTop],
+                                         {0, 0, 0, 0}) ||
+                            !rects_equal(result.rects[kNdsScreenBottom],
+                                         {0, 0, 0, 0})) {
+                            validity.note(where + ": refused but not zeroed");
+                        }
+                        continue;
+                    }
+
+                    const int want_scale = whole_scale(
+                        index, canvas.width, canvas.height);
+                    if (result.native_scale != want_scale) {
+                        scale.note(where + ": scale " +
+                                   number(result.native_scale) + " want " +
+                                   number(want_scale));
+                    }
+
+                    int used_area = 0;
+                    for (int slot = 0; slot < 2; ++slot) {
+                        const NdsScreenRect& rect = result.rects[slot];
+                        if (rect.width == 0 && rect.height == 0) continue;
+                        used_area += rect.width * rect.height;
+                        if (rect.width <= 0 || rect.height <= 0 || rect.x < 0 ||
+                            rect.y < 0 ||
+                            rect.x + rect.width > canvas.width ||
+                            rect.y + rect.height > canvas.height) {
+                            overflow.note(where + ": " + rect_text(rect));
+                        }
+                        // 4:3 within a pixel: 4*height and 3*width may differ
+                        // by at most 3, and the sign is pinned too so a
+                        // systematically short picture is caught.
+                        const int spread = 4 * rect.height - 3 * rect.width;
+                        if (spread < -3 || spread > 2) {
+                            aspect.note(where + ": 4h-3w = " +
+                                        number(spread) + " for " +
+                                        rect_text(rect));
+                        }
+                        if (integer_scale &&
+                            (rect.width != result.native_scale *
+                                                kNativeScreenWidth ||
+                             rect.height != result.native_scale *
+                                                 kNativeScreenHeight)) {
+                            scale.note(where +
+                                       ": integer scale is not a whole "
+                                       "multiple for " +
+                                       rect_text(rect));
+                        }
+                    }
+
+                    if (used_area + result.unused_canvas_pixels !=
+                        canvas.width * canvas.height) {
+                        unused.note(where + ": unused " +
+                                    number(result.unused_canvas_pixels) +
+                                    " but the rectangles cover " +
+                                    number(used_area));
+                    }
+
+                    const NdsScreenRect& first = result.rects[kNdsScreenTop];
+                    const NdsScreenRect& second =
+                        result.rects[kNdsScreenBottom];
+                    const bool both_present =
+                        first.width > 0 && first.height > 0 &&
+                        second.width > 0 && second.height > 0;
+                    if (both_present && first.x < second.x + second.width &&
+                        second.x < first.x + first.width &&
+                        first.y < second.y + second.height &&
+                        second.y < first.y + first.height) {
+                        overlap.note(where + ": " + rect_text(first) + " and " +
+                                     rect_text(second));
+                    }
+
+                    // Centring: the free space on the two sides of the used
+                    // block differs by at most one pixel, and the odd pixel is
+                    // on the right/bottom.
+                    int left = canvas.width;
+                    int top = canvas.height;
+                    int right_edge = 0;
+                    int bottom_edge = 0;
+                    for (int slot = 0; slot < 2; ++slot) {
+                        const NdsScreenRect& rect = result.rects[slot];
+                        if (rect.width <= 0 || rect.height <= 0) continue;
+                        if (rect.x < left) left = rect.x;
+                        if (rect.y < top) top = rect.y;
+                        if (rect.x + rect.width > right_edge) {
+                            right_edge = rect.x + rect.width;
+                        }
+                        if (rect.y + rect.height > bottom_edge) {
+                            bottom_edge = rect.y + rect.height;
+                        }
+                    }
+                    const int slack_right = canvas.width - right_edge;
+                    const int slack_bottom = canvas.height - bottom_edge;
+                    if (left > slack_right || slack_right - left > 1) {
+                        centring.note(where + ": left " + number(left) +
+                                      " right " + number(slack_right));
+                    }
+                    if (top > slack_bottom || slack_bottom - top > 1) {
+                        centring.note(where + ": top " + number(top) +
+                                      " bottom " + number(slack_bottom));
+                    }
+                }
+            }
+        }
+    }
+
+    check(validity.count == 0, "validity agrees with the fitted whole scale",
+          validity.detail("validity"));
+    check(overflow.count == 0, "no rectangle leaves the canvas",
+          overflow.detail("overflow"));
+    check(overlap.count == 0, "the two screens never overlap",
+          overlap.detail("overlap"));
+    check(aspect.count == 0, "every picture keeps 4:3 within a pixel",
+          aspect.detail("aspect"));
+    check(centring.count == 0,
+          "the block is centred with the odd pixel right/bottom",
+          centring.detail("centring"));
+    check(unused.count == 0,
+          "unused_canvas_pixels is the complement of the rectangles",
+          unused.detail("unused"));
+    check(scale.count == 0, "native_scale is the fitted whole scale",
+          scale.detail("scale"));
+}
+
+// ---------------------------------------------------------------------------
+// Totality: an out-of-range kind is a supported input, not undefined behaviour
+// ---------------------------------------------------------------------------
+
+void check_totality() {
+    const int kOutOfRange[] = {-1, 5, 6, 99, 2147483647};
+    for (int raw : kOutOfRange) {
+        const NdsScreenLayoutKind kind = static_cast<NdsScreenLayoutKind>(raw);
+        const NdsScreenLayoutResult got = compute_layout(kind, 1280, 720, true,
+                                                         false);
+        const NdsScreenLayoutResult want = compute_layout(
+            kNdsLayoutStacked, 1280, 720, true, false);
+        const bool same =
+            got.valid == want.valid &&
+            got.native_scale == want.native_scale &&
+            got.unused_canvas_pixels == want.unused_canvas_pixels &&
+            rects_equal(got.rects[kNdsScreenTop], want.rects[kNdsScreenTop]) &&
+            rects_equal(got.rects[kNdsScreenBottom],
+                        want.rects[kNdsScreenBottom]);
+        check(same, "kind " + number(raw) + " behaves as stacked",
+              describe(got) + " want " + describe(want));
+    }
+
+    // The extremes of int must not overflow the geometry either: both are
+    // refused rather than clamped, and the echoed canvas is unchanged.
+    const NdsScreenLayoutResult huge = compute_layout(
+        kNdsLayoutStacked, 2147483647, 2147483647, false, false);
+    const NdsScreenLayoutResult negative = compute_layout(
+        kNdsLayoutStacked, -2147483647 - 1, -2147483647 - 1, false, false);
+    check(!huge.valid && huge.canvas_width == 2147483647 &&
+              huge.unused_canvas_pixels == 0,
+          "an int-sized canvas is refused, not overflown", describe(huge));
+    check(!negative.valid && negative.canvas_width == -2147483647 - 1,
+          "a negative canvas is refused", describe(negative));
+}
+
+// ---------------------------------------------------------------------------
+// Determinism: the same request always produces the same geometry
+// ---------------------------------------------------------------------------
+
+void check_determinism() {
+    bool same = true;
+    std::string first_difference;
+    for (int index = 0; index < kNdsLayoutKindCount; ++index) {
+        const NdsScreenLayoutKind kind =
+            static_cast<NdsScreenLayoutKind>(index);
+        for (int integer = 0; integer < 2; ++integer) {
+            for (int swap = 0; swap < 2; ++swap) {
+                const NdsScreenLayoutResult a = compute_layout(
+                    kind, 1366, 768, integer != 0, swap != 0);
+                const NdsScreenLayoutResult b = compute_layout(
+                    kind, 1366, 768, integer != 0, swap != 0);
+                const bool equal =
+                    a.valid == b.valid && a.native_scale == b.native_scale &&
+                    a.unused_canvas_pixels == b.unused_canvas_pixels &&
+                    rects_equal(a.rects[kNdsScreenTop],
+                                b.rects[kNdsScreenTop]) &&
+                    rects_equal(a.rects[kNdsScreenBottom],
+                                b.rects[kNdsScreenBottom]);
+                if (!equal) {
+                    if (same) {
+                        first_difference = std::string(layout_name(kind)) +
+                                           " integer " + number(integer) +
+                                           " swap " + number(swap);
+                    }
+                    same = false;
+                }
+            }
+        }
+    }
+    check(same, "compute_layout is deterministic for every layout",
+          "first difference: " + first_difference);
+}
+
+// ---------------------------------------------------------------------------
+// The exact calls the frontend makes, verbatim
+// ---------------------------------------------------------------------------
+
+void check_frontend_calls() {
+    // A 512x768 canvas is the smallest window that shows both screens at 2x,
+    // and it is exactly filled: no letterbox at all.
+    const NdsScreenLayoutResult tall = compute_layout(
+        kNdsLayoutStacked, 512, 768, true, false);
+    check(tall.valid && tall.native_scale == 2 &&
+              tall.unused_canvas_pixels == 0 &&
+              rects_equal(tall.rects[kNdsScreenTop], {0, 0, 512, 384}) &&
+              rects_equal(tall.rects[kNdsScreenBottom], {0, 384, 512, 384}),
+          "stacked 512x768 tiles the canvas exactly", describe(tall));
+
+    // F3: swapping only exchanges the two rectangles. The scale and the
+    // leftover pixels must not move, or a swap would relayout the window.
+    const NdsScreenLayoutResult tall_swapped = compute_layout(
+        kNdsLayoutStacked, 512, 768, true, true);
+    check(tall_swapped.valid && tall_swapped.native_scale == 2 &&
+              tall_swapped.unused_canvas_pixels == 0 &&
+              rects_equal(tall_swapped.rects[kNdsScreenTop],
+                          {0, 384, 512, 384}) &&
+              rects_equal(tall_swapped.rects[kNdsScreenBottom],
+                          {0, 0, 512, 384}),
+          "stacked 512x768 swaps without moving anything else",
+          describe(tall_swapped));
+
+    const NdsScreenLayoutResult wide = compute_layout(
+        kNdsLayoutSideBySide, 1280, 720, true, false);
+    check(wide.valid && wide.native_scale == 2 &&
+              wide.unused_canvas_pixels == 528384 &&
+              rects_equal(wide.rects[kNdsScreenTop], {128, 168, 512, 384}) &&
+              rects_equal(wide.rects[kNdsScreenBottom], {640, 168, 512, 384}),
+          "side by side 1280x720 at 2x", describe(wide));
+
+    // The same canvas without integer scaling: the two screens fill the height
+    // and the leftover becomes a pillarbox instead of a letterbox.
+    const NdsScreenLayoutResult wide_fractional = compute_layout(
+        kNdsLayoutSideBySide, 1280, 720, false, false);
+    check(wide_fractional.valid && wide_fractional.native_scale == 2 &&
+              wide_fractional.unused_canvas_pixels == 307200 &&
+              rects_equal(wide_fractional.rects[kNdsScreenTop],
+                          {0, 120, 640, 480}) &&
+              rects_equal(wide_fractional.rects[kNdsScreenBottom],
+                          {640, 120, 640, 480}),
+          "side by side 1280x720 fills the height", describe(wide_fractional));
+
+    const NdsScreenLayoutResult single = compute_layout(
+        kNdsLayoutTopOnly, 800, 600, true, false);
+    check(single.valid && single.native_scale == 3 &&
+              single.unused_canvas_pixels == 37632 &&
+              rects_equal(single.rects[kNdsScreenTop], {16, 12, 768, 576}) &&
+              rects_equal(single.rects[kNdsScreenBottom], {0, 0, 0, 0}),
+          "top only 800x600 at 3x", describe(single));
+
+    const NdsScreenLayoutResult square = compute_layout(
+        kNdsLayoutSquare, 1024, 768, true, false);
+    check(square.valid && square.native_scale == 2 &&
+              square.unused_canvas_pixels == 393216 &&
+              rects_equal(square.rects[kNdsScreenTop], {0, 192, 512, 384}) &&
+              rects_equal(square.rects[kNdsScreenBottom], {512, 192, 512, 384}),
+          "square 1024x768 tiles two 512x512 cells", describe(square));
+
+    // The refusal the frontend must render as "window too small": every field
+    // is inert and the canvas echo still reports what was asked for.
+    const NdsScreenLayoutResult too_small = compute_layout(
+        kNdsLayoutStacked, 200, 400, true, false);
+    check(!too_small.valid && too_small.canvas_width == 200 &&
+              too_small.canvas_height == 400 && too_small.native_scale == 0 &&
+              too_small.unused_canvas_pixels == 0 &&
+              rects_equal(too_small.rects[kNdsScreenTop], {0, 0, 0, 0}) &&
+              rects_equal(too_small.rects[kNdsScreenBottom], {0, 0, 0, 0}),
+          "stacked 200x400 is refused, every field zeroed",
+          describe(too_small));
+}
+
+// ---------------------------------------------------------------------------
+// The odd pixel is documented to go to the right/bottom
+// ---------------------------------------------------------------------------
+
+void check_odd_pixel_side() {
+    // 777 - 256 = 521 leftover columns: 260 on the left, 261 on the right.
+    const NdsScreenLayoutResult horizontal = compute_layout(
+        kNdsLayoutStacked, 777, 600, true, false);
+    check(rects_equal(horizontal.rects[kNdsScreenTop], {260, 108, 256, 192}) &&
+              rects_equal(horizontal.rects[kNdsScreenBottom],
+                          {260, 300, 256, 192}),
+          "the odd leftover column goes to the right", describe(horizontal));
+
+    // 601 - 576 = 25 leftover rows: 12 above, 13 below.
+    const NdsScreenLayoutResult vertical = compute_layout(
+        kNdsLayoutTopOnly, 800, 601, true, false);
+    check(rects_equal(vertical.rects[kNdsScreenTop], {16, 12, 768, 576}),
+          "the odd leftover row goes to the bottom", describe(vertical));
+}
+
+}  // namespace
+
+int main() {
+    check_names();
+    check_parse();
+    check_single_window();
+    check_min_canvas();
+    check_pins();
+    check_swap();
+    check_contract();
+    check_totality();
+    check_determinism();
+    check_odd_pixel_side();
+    check_frontend_calls();
+
+    if (g_failures == 0) {
+        std::printf("%d checks passed\n", g_checks);
+        return 0;
+    }
+    std::printf("%d of %d checks failed\n", g_failures, g_checks);
+    return g_first_failure;
+}
diff --git a/runner/tests/screen_minimap_test.cpp b/runner/tests/screen_minimap_test.cpp
new file mode 100644
index 0000000..94481cc
--- /dev/null
+++ b/runner/tests/screen_minimap_test.cpp
@@ -0,0 +1,1155 @@
+// Pins the minimap inset (screen_minimap.h).
+//
+// A one-screen layout shows one DS screen; the minimap draws the hidden one
+// small in the corner of the visible picture. Everything here is geometry the
+// emulator cannot check for itself: an inset placed in the wrong corner still
+// looks like a minimap, and an inset that shows the screen the player is
+// already looking at looks exactly like one that shows the other. So the
+// numbers are pinned first, then the nine decisions are each given a check
+// that fails for that rule alone.
+//
+// 1. Hand pins: every decision-1 case (top only, bottom only, both swapped,
+//    the five refusals) plus hand-built geometries with offsets, awkward
+//    widths and short pictures, each with the rect worked out by hand.
+// 2. Window-scale invisibility: the same layout at 1x, 2x, 3x, 5x and 16x,
+//    compared field for field.
+// 3. The sweep the frontend actually walks: five layouts x scales {1,2,3,5,16}
+//    x adaptive {0,300,448} x swap -- 150 requests -- with the inside, margin,
+//    hidden-screen, minimum-size, width, aspect and scale rules asserted on
+//    every one that produces a minimap and the whole struct asserted on every
+//    one that does not.
+// 4. A wider sweep of one-screen views cut out of real layout geometry, so the
+//    picture rects have the offsets and sizes the layout module really
+//    produces (centring margins, fractional scales, wide canvases).
+// 5. Determinism: an FNV-1a digest over the whole struct stream of the 150
+//    requests, matched against a model of the header written in Python.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and a failure prints what it got next to what
+// it expected, so a failure names itself without a debugger.
+//
+// The arithmetic every pin below uses, for a 256x192 picture at the origin:
+//   margin = 256 / 8        = 32
+//   width  = 256 / 3        = 85   (above the 32 floor, below the 224 room)
+//   height = (85 * 192 + 128) / 256 = 64   (63.75 rounded to nearest)
+//   x      = 0 + 256 - 32 - 85      = 139
+//   y      = 0 + 192 - 32 - 64      = 96
+//   scale_x = 85 / 256 = 0.33203125, scale_y = 64 / 192 = 0.33333334f
+
+#include "screen_minimap.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+// A refusal is "all zeros", so the screen slot in a refused layout is the
+// top slot's value and not a third state; the enum is persisted, so its
+// numeric identity is part of the contract.
+static_assert(nds_screen_layout::kNdsScreenTop == 0, "top slot is 0");
+static_assert(nds_screen_layout::kNdsScreenBottom == 1, "bottom slot is 1");
+static_assert(nds_screen_minimap::kMinimapMarginDivisor == 8,
+              "margin divisor is the documented eighth");
+static_assert(nds_screen_minimap::kMinimapWidthDivisor == 3,
+              "width divisor is the documented third");
+static_assert(nds_screen_minimap::kMinMinimapMargin == 2, "margin floor is 2");
+static_assert(nds_screen_minimap::kMinMinimapWidth == 32, "width floor is 32");
+
+namespace {
+
+using nds_screen_layout::kNdsLayoutBottomOnly;
+using nds_screen_layout::kNdsLayoutKindCount;
+using nds_screen_layout::kNdsLayoutSideBySide;
+using nds_screen_layout::kNdsLayoutSquare;
+using nds_screen_layout::kNdsLayoutStacked;
+using nds_screen_layout::kNdsLayoutTopOnly;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::kNdsScreenLayoutKind;
+using nds_screen_layout::kNdsScreenRect;
+using nds_screen_layout::kNdsScreenTop;
+
+using nds_screen_minimap::compute_minimap;
+using nds_screen_minimap::kNdsScreenMinimapMargin;
+using nds_screen_minimap::kMinMinimapMargin;
+using nds_screen_minimap::kMinMinimapWidth;
+using nds_screen_minimap::NdsMinimapLayout;
+
+using nds_screen_presentation::compute_presentation;
+using nds_screen_presentation::kNdsPresentationSeparateWindows;
+using nds_screen_presentation::NdsPresentationGeometry;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const std::string& what,
+           const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what.c_str());
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::printf("FAIL %s\n     %s\n", what.c_str(), detail.c_str());
+    return false;
+}
+
+bool rect_is(const NdsScreenRect& rect, int x, int y, int width, int height) {
+    return rect.x == x && rect.y == y && rect.width == width &&
+           rect.height == height;
+}
+
+std::string describe_rect(const NdsScreenRect& rect) {
+    char buffer[96];
+    std::snprintf(buffer, sizeof(buffer), "{%d, %d, %d, %d}", rect.x, rect.y,
+                  rect.width, rect.height);
+    return buffer;
+}
+
+std::string describe_layout(const NdsMinimapLayout& layout) {
+    char buffer[192];
+    std::snprintf(buffer, sizeof(buffer),
+                  "visible %d screen %d inset %s scale_x %.9g scale_y %.9g",
+                  layout.visible ? 1 : 0, layout.screen,
+                  describe_rect(layout.inset).c_str(),
+                  static_cast<double>(layout.scale_x),
+                  static_cast<double>(layout.scale_y));
+    return buffer;
+}
+
+std::string describe_geometry(const NdsPresentationGeometry& geometry) {
+    if (!geometry.valid) return "refused (every field zero)";
+    char buffer[256];
+    std::snprintf(buffer, sizeof(buffer),
+                  "canvas %dx%d top %s bottom %s visible %d,%d windows %d "
+                  "separate %d",
+                  geometry.canvas_width, geometry.canvas_height,
+                  describe_rect(geometry.screen_rect[kNdsScreenTop]).c_str(),
+                  describe_rect(geometry.screen_rect[kNdsScreenBottom]).c_str(),
+                  geometry.visible[kNdsScreenTop] ? 1 : 0,
+                  geometry.visible[kNdsScreenBottom] ? 1 : 0,
+                  geometry.window_count, geometry.separate_windows ? 1 : 0);
+    return buffer;
+}
+
+// Decision 7, asserted as a whole: not just "not visible" but every field
+// zero, so a caller that ignores visible draws nothing at all.
+bool layout_is_all_zero(const NdsMinimapLayout& layout) {
+    return !layout.visible && layout.screen == kNdsScreenTop &&
+           rect_is(layout.inset, 0, 0, 0, 0) && layout.scale_x == 0.0f &&
+           layout.scale_y == 0.0f;
+}
+
+// Two layouts are the same answer down to the float bit patterns.
+bool layouts_identical(const NdsMinimapLayout& a, const NdsMinimapLayout& b) {
+    if (a.visible != b.visible) return false;
+    if (a.screen != b.screen) return false;
+    if (!rect_is(a.inset, b.inset.x, b.inset.y, b.inset.width, b.inset.height)) {
+        return false;
+    }
+    if (a.scale_x != b.scale_x) return false;
+    return a.scale_y == b.scale_y;
+}
+
+// Decision 3's margin: an eighth of the picture's width, floored, never under
+// two pixels.
+int expected_margin(int picture_width) {
+    const int margin = picture_width / 8;
+    return margin < kMinMinimapMargin ? kMinMinimapMargin : margin;
+}
+
+// Decisions 3 and 4 restated: a third of the picture wide, lifted to the
+// readability floor (or the picture's own width, whichever is smaller), capped
+// at the room left after the margin, and 4:3 tall rounded to nearest, shrinking
+// to fit a picture too short for that box.
+struct ExpectedInset {
+    bool visible;
+    int width;
+    int height;
+};
+
+ExpectedInset expected_inset(int picture_width, int picture_height) {
+    ExpectedInset out{false, 0, 0};
+    const int margin = expected_margin(picture_width);
+    const int available_width = picture_width - margin;
+    const int available_height = picture_height - margin;
+    if (available_width < 1 || available_height < 1) return out;
+    int width = picture_width / 3;
+    if (width < kMinMinimapWidth) {
+        width = picture_width < kMinMinimapWidth ? picture_width
+                                                 : kMinMinimapWidth;
+    }
+    if (width > available_width) width = available_width;
+    int height = (width * 192 + 128) / 256;
+    if (height > available_height) {
+        height = available_height;
+        width = (height * 256 + 96) / 192;
+    }
+    out.visible = true;
+    out.width = width;
+    out.height = height;
+    return out;
+}
+
+// A geometry with one screen's picture at `origin` and the other hidden, the
+// way compute_presentation() leaves a one-screen layout. The hidden rect is
+// all zeros, which is the case decision 1 must not mistake for "no picture".
+NdsPresentationGeometry one_screen_geometry(int shown, int origin_x,
+                                            int origin_y, int width,
+                                            int height, int canvas_width,
+                                            int canvas_height) {
+    NdsPresentationGeometry geometry{};
+    geometry.canvas_width = canvas_width;
+    geometry.canvas_height = canvas_height;
+    geometry.logical_width[0] = canvas_width;
+    geometry.logical_height[0] = canvas_height;
+    geometry.window_width[0] = canvas_width * 2;
+    geometry.window_height[0] = canvas_height * 2;
+    geometry.screen_rect[shown] = NdsScreenRect{origin_x, origin_y, width,
+                                               height};
+    geometry.visible[shown] = true;
+    geometry.window_count = 1;
+    geometry.valid = true;
+    return geometry;
+}
+
+// A geometry that is fully populated except that it claims not to be valid,
+// which is what a refused request looks like field by field.
+NdsPresentationGeometry refused_geometry() {
+    NdsPresentationGeometry geometry{};
+    return geometry;
+}
+
+// Counts violations of one invariant so a sweep reports "N of M" instead of one
+// line per bad configuration, while still naming the first offender.
+struct Tally {
+    int count = 0;
+    std::string first;
+
+    void note(const std::string& text) {
+        if (count == 0) first = text;
+        ++count;
+    }
+
+    bool clean() const { return count == 0; }
+
+    std::string detail(const char* label) const {
+        char buffer[96];
+        std::snprintf(buffer, sizeof(buffer), "%s: %d violation(s), first: ",
+                      label, count);
+        return std::string(buffer) + first;
+    }
+};
+
+const int kScales[] = {1, 2, 3, 5, 16};
+const int kAdaptive[] = {0, 300, 448};
+const int kSweepScales[] = {1, 2, 3, 5, 16};
+
+std::string request_label(const char* layout, int scale, int adaptive,
+                          bool swap) {
+    char buffer[128];
+    std::snprintf(buffer, sizeof(buffer), "%s at %dx adaptive %d swap %d",
+                  layout, scale, adaptive, swap ? 1 : 0);
+    return buffer;
+}
+
+const char* layout_label(int kind) {
+    switch (kind) {
+        case kNdsLayoutStacked: return "stacked";
+        case kNdsLayoutSideBySide: return "side by side";
+        case kNdsLayoutTopOnly: return "top only";
+        case kNdsLayoutBottomOnly: return "bottom only";
+        case kNdsLayoutSquare: return "square";
+        default: return "unknown";
+    }
+}
+
+// One hand-pinned case: a presentation request and the exact minimap it must
+// produce.
+struct PinCase {
+    const char* label;
+    int kind;
+    int scale;
+    int adaptive;
+    bool swap;
+    bool visible;
+    int screen;
+    int x;
+    int y;
+    int width;
+    int height;
+};
+
+void check_pins() {
+    const PinCase kPins[] = {
+        // Decision 1 + 2, the ordinary one-screen layouts. The picture is the
+        // whole 256x192 canvas, so the inset is the same rect in each; only the
+        // screen it shows differs.
+        {"top only at 2x insets the hidden bottom screen", kNdsLayoutTopOnly,
+         2, 0, false, true, kNdsScreenBottom, 139, 96, 85, 64},
+        {"top only at 2x with swap insets the hidden top screen (the shown one "
+         "is the bottom screen)",
+         kNdsLayoutTopOnly, 2, 0, true, true, kNdsScreenTop, 139, 96, 85, 64},
+        {"bottom only at 1x insets the hidden top screen",
+         kNdsLayoutBottomOnly, 1, 0, false, true, kNdsScreenTop, 139, 96, 85,
+         64},
+        {"bottom only at 1x with swap insets the hidden bottom screen",
+         kNdsLayoutBottomOnly, 1, 0, true, true, kNdsScreenBottom, 139, 96, 85,
+         64},
+        {"top only at 16x insets the hidden bottom screen, unsealed by the "
+         "window scale",
+         kNdsLayoutTopOnly, 16, 0, false, true, kNdsScreenBottom, 139, 96, 85,
+         64},
+        // Decision 1, both screens visible: no minimap.
+        {"stacked at 2x is refused because both screens are on display",
+         kNdsLayoutStacked, 2, 0, false, false, 0, 0, 0, 0, 0},
+        {"side by side at 1x is refused because both screens are on display",
+         kNdsLayoutSideBySide, 1, 0, false, false, 0, 0, 0, 0, 0},
+        {"square at 2x is refused because both screens are on display",
+         kNdsLayoutSquare, 2, 0, false, false, 0, 0, 0, 0, 0},
+        {"stacked at 2x with adaptive 448 is refused: widening does not hide a "
+         "screen",
+         kNdsLayoutStacked, 2, 448, false, false, 0, 0, 0, 0, 0},
+        {"stacked at 1x with adaptive 300 and swap is still refused",
+         kNdsLayoutStacked, 1, 300, true, false, 0, 0, 0, 0, 0},
+        // Decision 1, two-window mode: each screen has its own window.
+        {"two-window mode at 2x is refused because both screens have a window",
+         kNdsPresentationSeparateWindows, 2, 0, false, false, 0, 0, 0, 0, 0},
+        // A refused presentation has no picture to inset into.
+        {"top only at 1x with adaptive 448 is refused: adaptive is stacked "
+         "only, so the request itself is refused",
+         kNdsLayoutTopOnly, 1, 448, false, false, 0, 0, 0, 0, 0},
+        {"an out-of-range window scale leaves nothing to inset",
+         kNdsLayoutTopOnly, 0, 0, false, false, 0, 0, 0, 0, 0},
+        {"a window scale past the maximum leaves nothing to inset",
+         kNdsLayoutTopOnly, 17, 0, false, false, 0, 0, 0, 0, 0},
+    };
+
+    for (const PinCase& pin : kPins) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(static_cast<NdsScreenLayoutKind>(pin.kind),
+                                 pin.scale, pin.adaptive, pin.swap, false);
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        const std::string label =
+            request_label(pin.label, pin.scale, pin.adaptive, pin.swap);
+        if (!pin.visible) {
+            check(layout_is_all_zero(layout), label,
+                  "expected a refusal with every field zero, got " +
+                      describe_layout(layout) + " from " +
+                      describe_geometry(geometry));
+            continue;
+        }
+        const bool ok =
+            layout.visible && layout.screen == pin.screen &&
+            rect_is(layout.inset, pin.x, pin.y, pin.width, pin.height);
+        char expected[128];
+        std::snprintf(expected, sizeof(expected),
+                      "visible 1 screen %d inset {%d, %d, %d, %d}", pin.screen,
+                      pin.x, pin.y, pin.width, pin.height);
+        check(ok, label,
+              "expected " + std::string(expected) + ", got " +
+                  describe_layout(layout) + " from " +
+                  describe_geometry(geometry));
+    }
+}
+
+// Hand-built geometries: the shapes a caller can assemble by hand, where the
+// picture is not the whole canvas and the width rules actually bind. Every
+// expected rect below is worked out in the comment beside it.
+void check_hand_built() {
+    // A 256x192 picture at {100, 50} on a 512x384 canvas: the inset keeps the
+    // 85x64 size and the 32 px margin, so it lands at
+    //   x = 100 + 256 - 32 - 85 = 239, y = 50 + 192 - 32 - 64 = 146.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 100, 50, 256, 192, 512, 384));
+        check(layout.visible && layout.screen == kNdsScreenBottom &&
+                  rect_is(layout.inset, 239, 146, 85, 64),
+              "an offset picture puts the inset a margin inside its own "
+              "bottom-right corner",
+              "expected visible 1 screen 1 inset {239, 146, 85, 64}, got " +
+                  describe_layout(layout));
+    }
+    // A 448x192 adaptive-shaped picture: margin 448/8 = 56, width 448/3 = 149,
+    // height (149 * 192 + 128) / 256 = 112, x = 448 - 56 - 149 = 243,
+    // y = 192 - 56 - 112 = 24.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 0, 0, 448, 192, 448, 192));
+        check(layout.visible && rect_is(layout.inset, 243, 24, 149, 112),
+              "a 448-wide picture gets a 149x112 inset 56 px from each edge",
+              "expected {243, 24, 149, 112}, got " +
+                  describe_layout(layout));
+    }
+    // A 320x240 picture at {64, 96}: margin 40, width 106, height
+    // (106 * 192 + 128) / 256 = 80, x = 64 + 320 - 40 - 106 = 238,
+    // y = 96 + 240 - 40 - 80 = 216.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 64, 96, 320, 240, 448, 432));
+        check(layout.visible && rect_is(layout.inset, 238, 216, 106, 80),
+              "a 320x240 picture at {64, 96} gets an inset at {238, 216}",
+              "expected {238, 216, 106, 80}, got " +
+                  describe_layout(layout));
+    }
+    // A 40-wide picture: the third is 13, under the 32 readability floor, so
+    // the floor wins; the room is 40 - 5 = 35, so the width is 32 and the
+    // height (32 * 192 + 128) / 256 = 24. x = 40 - 5 - 32 = 3,
+    // y = 192 - 5 - 24 = 163.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 0, 0, 40, 192, 40, 192));
+        check(layout.visible && rect_is(layout.inset, 3, 163, 32, 24),
+              "a narrow picture is lifted to the 32 px readability floor",
+              "expected {3, 163, 32, 24}, got " + describe_layout(layout));
+    }
+    // A 24-wide picture: the floor would be 32 but the picture is only 24
+    // wide, so the floor becomes the picture's width and the room (24 - 3 = 21)
+    // caps it at 21; height (21 * 192 + 128) / 256 = 16, x = 24 - 3 - 21 = 0,
+    // y = 192 - 3 - 16 = 173.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 0, 0, 24, 192, 24, 192));
+        check(layout.visible && rect_is(layout.inset, 0, 173, 21, 16),
+              "the readability floor never grows past the picture it sits in",
+              "expected {0, 173, 21, 16}, got " + describe_layout(layout));
+    }
+    // A 256x60 picture: the 4:3 box for an 85-wide inset would be 64 tall but
+    // only 60 - 32 = 28 is free, so the height takes the room and the width
+    // follows at 4:3: (28 * 256 + 96) / 192 = 37, x = 256 - 32 - 37 = 187,
+    // y = 60 - 32 - 28 = 0.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 0, 0, 256, 60, 256, 60));
+        check(layout.visible && rect_is(layout.inset, 187, 0, 37, 28),
+              "a short picture shrinks the inset as a 4:3 box",
+              "expected {187, 0, 37, 28}, got " + describe_layout(layout));
+    }
+    // A 256x30 picture: the margin alone is 32, so there is no room at all and
+    // the answer is a refusal rather than a rect climbing out of the picture.
+    {
+        const NdsMinimapLayout layout = compute_minimap(
+            one_screen_geometry(kNdsScreenTop, 0, 0, 256, 30, 256, 30));
+        check(layout_is_all_zero(layout),
+              "a picture with no room left after the margin is refused",
+              "expected a refusal, got " + describe_layout(layout));
+    }
+    // Decision 1's last clause, spelled out: the HIDDEN screen's rect is all
+    // zeros (and here even nonsense), and that must not be read as "no
+    // picture" -- the inset is placed from the visible picture.
+    {
+        NdsPresentationGeometry geometry =
+            one_screen_geometry(kNdsScreenTop, 0, 0, 256, 192, 256, 192);
+        geometry.screen_rect[kNdsScreenBottom] =
+            NdsScreenRect{-5, -7, -3, -9};
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        check(layout.visible && layout.screen == kNdsScreenBottom &&
+                  rect_is(layout.inset, 139, 96, 85, 64),
+              "a zero-size hidden rect is not a missing picture",
+              "expected visible 1 screen 1 inset {139, 96, 85, 64}, got " +
+                  describe_layout(layout) + " from " + describe_geometry(geometry));
+    }
+    // The same picture on the bottom screen: identical inset, other slot.
+    {
+        NdsPresentationGeometry geometry =
+            one_screen_geometry(kNdsScreenBottom, 0, 0, 256, 192, 256, 192);
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        check(layout.visible && layout.screen == kNdsScreenTop &&
+                  rect_is(layout.inset, 139, 96, 85, 64),
+              "a bottom-only style geometry insets the hidden top screen",
+              "expected visible 1 screen 0 inset {139, 96, 85, 64}, got " +
+                  describe_layout(layout));
+    }
+}
+
+// Decision 1 as a list of refusals, each asserted on the whole struct.
+void check_refusals() {
+    struct RefusalCase {
+        const char* label;
+        int shown;  // -1 for neither, 2 for both
+        bool valid;
+        bool separate_windows;
+        int canvas_width;
+        int canvas_height;
+        int origin_x;
+        int origin_y;
+        int width;
+        int height;
+    };
+    const RefusalCase kCases[] = {
+        {"a refused presentation has no picture to inset into", 0, false, false,
+         256, 192, 0, 0, 256, 192},
+        {"the two-window mode is refused even with one screen marked visible", 0,
+         true, true, 256, 192, 0, 0, 256, 192},
+        {"both screens visible is refused", 2, true, false, 256, 384, 0, 0, 256,
+         192},
+        {"neither screen visible is refused", -1, true, false, 256, 192, 0, 0,
+         0, 0},
+        {"a visible screen with a zero-width rect is refused", 0, true, false,
+         256, 192, 0, 0, 0, 192},
+        {"a visible screen with a zero-height rect is refused", 0, true, false,
+         256, 192, 0, 0, 256, 0},
+        {"a visible rect wider than the canvas is refused", 0, true, false, 256,
+         192, 0, 0, 300, 192},
+        {"a visible rect taller than the canvas is refused", 0, true, false, 256,
+         192, 0, 0, 256, 200},
+        {"a visible rect starting outside the canvas is refused", 0, true,
+         false, 256, 192, -40, 0, 256, 192},
+        {"a canvas with no extent is refused", 0, true, false, 0, 192, 0, 0,
+         256, 192},
+        {"a picture wider than the canvas cap is refused", 0, true, false, 16384,
+         192, 0, 0, 16385, 192},
+    };
+    for (const RefusalCase& item : kCases) {
+        NdsPresentationGeometry geometry{};
+        geometry.valid = item.valid;
+        geometry.separate_windows = item.separate_windows;
+        geometry.canvas_width = item.canvas_width;
+        geometry.canvas_height = item.canvas_height;
+        geometry.logical_width[0] = item.canvas_width;
+        geometry.logical_height[0] = item.canvas_height;
+        geometry.window_count = item.separate_windows ? 2 : 1;
+        if (item.shown >= 0) {
+            const bool both = item.shown == 2;
+            const int first = both ? 0 : item.shown;
+            const int last = both ? 1 : item.shown;
+            for (int slot = first; slot <= last; ++slot) {
+                geometry.screen_rect[slot] =
+                    NdsScreenRect{item.origin_x, item.origin_y, item.width,
+                                  item.height};
+                geometry.visible[slot] = true;
+            }
+        }
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        check(layout_is_all_zero(layout), item.label,
+              "expected a refusal with every field zero, got " +
+                  describe_layout(layout));
+    }
+    // A geometry that is not valid but is otherwise fully populated: the valid
+    // flag alone decides, and the refusal still zeroes the whole struct.
+    {
+        NdsPresentationGeometry geometry =
+            one_screen_geometry(kNdsScreenTop, 0, 0, 256, 192, 256, 192);
+        geometry.valid = false;
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        check(layout_is_all_zero(layout),
+              "the valid flag alone refuses a fully populated geometry",
+              "expected a refusal, got " + describe_layout(layout));
+    }
+    // The two-window mode is recognised by separate_windows, not by the window
+    // count: decision 1 lists the mode, and the header never mentions
+    // window_count.
+    {
+        NdsPresentationGeometry geometry =
+            one_screen_geometry(kNdsScreenTop, 0, 0, 256, 192, 256, 192);
+        geometry.window_count = 3;
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        check(layout.visible && rect_is(layout.inset, 139, 96, 85, 64),
+              "a stray window count does not turn a one-screen layout into a "
+              "refusal",
+              "expected visible 1 inset {139, 96, 85, 64}, got " +
+                  describe_layout(layout));
+    }
+}
+
+// Decision 5: the window scale is invisible to the minimap.
+void check_window_scale_invisibility() {
+    struct Case {
+        int kind;
+        bool swap;
+        const char* label;
+    };
+    const Case kCases[] = {
+        {kNdsLayoutTopOnly, false, "top only"},
+        {kNdsLayoutTopOnly, true, "top only with swap"},
+        {kNdsLayoutBottomOnly, false, "bottom only"},
+        {kNdsLayoutBottomOnly, true, "bottom only with swap"},
+    };
+    for (const Case& item : kCases) {
+        const NdsPresentationGeometry base = compute_presentation(
+            static_cast<NdsScreenLayoutKind>(item.kind), 1, 0, item.swap,
+            false);
+        const NdsMinimapLayout expected = compute_minimap(base);
+        bool same = true;
+        std::string detail;
+        for (int scale : kScales) {
+            const NdsPresentationGeometry geometry = compute_presentation(
+                static_cast<NdsScreenLayoutKind>(item.kind), scale, 0,
+                item.swap, false);
+            const NdsMinimapLayout layout = compute_minimap(geometry);
+            if (!layouts_identical(expected, layout)) {
+                same = false;
+                char buffer[160];
+                std::snprintf(buffer, sizeof(buffer),
+                              "at %dx expected %s, got %s", scale,
+                              describe_layout(expected).c_str(),
+                              describe_layout(layout).c_str());
+                detail = buffer;
+                break;
+            }
+        }
+        check(same,
+              std::string("the ") + item.label +
+                  " inset is identical at 1x, 2x, 3x, 5x and 16x",
+              detail);
+    }
+    // The window fields are the only difference between those geometries, so
+    // this also proves the function reads the picture and not the window.
+    const NdsPresentationGeometry one_x =
+        compute_presentation(kNdsLayoutTopOnly, 1, 0, false, false);
+    const NdsPresentationGeometry sixteen_x =
+        compute_presentation(kNdsLayoutTopOnly, 16, 0, false, false);
+    check(one_x.window_width[0] != sixteen_x.window_width[0] &&
+              layouts_identical(compute_minimap(one_x),
+                                compute_minimap(sixteen_x)),
+          "two geometries differing only in window size give the same inset",
+          "window widths " + std::to_string(one_x.window_width[0]) + " and " +
+              std::to_string(sixteen_x.window_width[0]));
+}
+
+// The sweep the frontend walks: 5 layouts x 5 scales x 3 adaptive widths x 2
+// swap states. Every minimap is compared against the header's rule, and every
+// refusal against the whole-struct promise.
+void check_sweep() {
+    Tally inside;
+    Tally gap;
+    Tally hidden;
+    Tally minimum_size;
+    Tally width_rule;
+    Tally aspect;
+    Tally scale_identity;
+    Tally ordered;
+    int requests = 0;
+    int visible_count = 0;
+    int refused_count = 0;
+    std::string refused_detail;
+
+    for (int kind = 0; kind < 5; ++kind) {
+        for (int scale : kSweepScales) {
+            for (int adaptive : kAdaptive) {
+                for (int swap_index = 0; swap_index < 2; ++swap_index) {
+                    const bool swap = swap_index != 0;
+                    const NdsPresentationGeometry geometry = compute_presentation(
+                        static_cast<NdsScreenLayoutKind>(kind), scale, adaptive,
+                        swap, false);
+                    const NdsMinimapLayout layout = compute_minimap(geometry);
+                    ++requests;
+                    if (!layout.visible) {
+                        ++refused_count;
+                        if (!layout_is_all_zero(layout) &&
+                            refused_detail.empty()) {
+                            refused_detail = describe_layout(layout) + " from " +
+                                             describe_geometry(geometry);
+                        }
+                        continue;
+                    }
+                    ++visible_count;
+                    const int shown = geometry.visible[kNdsScreenTop]
+                                          ? kNdsScreenTop
+                                          : kNdsScreenBottom;
+                    const NdsScreenRect picture = geometry.screen_rect[shown];
+                    const std::string label =
+                        request_label(layout_label(kind), scale, adaptive, swap);
+
+                    // The inset lies fully inside the visible picture, and so
+                    // inside the canvas and the window.
+                    if (layout.inset.x < picture.x ||
+                        layout.inset.y < picture.y ||
+                        layout.inset.x + layout.inset.width >
+                            picture.x + picture.width ||
+                        layout.inset.y + layout.inset.height >
+                            picture.y + picture.height) {
+                        inside.note(label + " inset " +
+                                    describe_rect(layout.inset) + " picture " +
+                                    describe_rect(picture));
+                    }
+                    // The gap to the picture's bottom and right edges is
+                    // exactly the margin.
+                    const int margin = expected_margin(picture.width);
+                    if (picture.x + picture.width -
+                            (layout.inset.x + layout.inset.width) != margin ||
+                        picture.y + picture.height -
+                            (layout.inset.y + layout.inset.height) != margin) {
+                        gap.note(label + " inset " +
+                                 describe_rect(layout.inset) + " margin " +
+                                 std::to_string(margin));
+                    }
+                    // The inset shows the hidden screen and never the visible
+                    // one.
+                    const int expected_screen =
+                        shown == kNdsScreenTop ? kNdsScreenBottom : kNdsScreenTop;
+                    if (layout.screen != expected_screen) {
+                        hidden.note(label + " screen " +
+                                    std::to_string(layout.screen) +
+                                    " expected " +
+                                    std::to_string(expected_screen));
+                    }
+                    // At least one pixel in each axis.
+                    if (layout.inset.width < 1 || layout.inset.height < 1) {
+                        minimum_size.note(label + " inset " +
+                                          describe_rect(layout.inset));
+                    }
+                    // The width follows the header's rule: a third, lifted to
+                    // the readability floor, capped at the room after the
+                    // margin.
+                    const ExpectedInset expected =
+                        expected_inset(picture.width, picture.height);
+                    if (!expected.visible ||
+                        layout.inset.width != expected.width ||
+                        layout.inset.height != expected.height) {
+                        width_rule.note(label + " inset " +
+                                        describe_rect(layout.inset) +
+                                        " expected {" +
+                                        std::to_string(expected.width) + ", " +
+                                        std::to_string(expected.height) + "}");
+                    }
+                    // The 4:3 band of decision 4.
+                    const int spread =
+                        4 * layout.inset.height - 3 * layout.inset.width;
+                    if (spread < -1 || spread > 2) {
+                        aspect.note(label + " inset " +
+                                    describe_rect(layout.inset) + " 4h-3w " +
+                                    std::to_string(spread));
+                    }
+                    // Decision 8: both scales are the exact fraction of one DS
+                    // screen the thumbnail covers.
+                    if (layout.scale_x !=
+                            static_cast<float>(layout.inset.width) / 256.0f ||
+                        layout.scale_y !=
+                            static_cast<float>(layout.inset.height) / 192.0f) {
+                        char buffer[128];
+                        std::snprintf(buffer, sizeof(buffer),
+                                      "width %d height %d scale_x %.9g "
+                                      "scale_y %.9g",
+                                      layout.inset.width, layout.inset.height,
+                                      static_cast<double>(layout.scale_x),
+                                      static_cast<double>(layout.scale_y));
+                        scale_identity.note(label + " " + buffer);
+                    }
+                    // The inset is below and to the right of the picture's
+                    // origin, in that corner rather than any other.
+                    if (layout.inset.x < picture.x ||
+                        layout.inset.y < picture.y) {
+                        ordered.note(label + " inset " +
+                                     describe_rect(layout.inset));
+                    }
+                }
+            }
+        }
+    }
+
+    check(requests == 150, "the sweep is 150 requests",
+          "got " + std::to_string(requests));
+    check(visible_count == 20,
+          "20 of the 150 requests get a minimap (the two one-screen layouts at "
+          "every scale and swap state)",
+          "got " + std::to_string(visible_count) + " visible and " +
+              std::to_string(refused_count) + " refused");
+    check(refused_detail.empty(),
+          "every refused request zeroes the whole minimap struct",
+          refused_detail);
+    check(inside.clean(), "the inset lies fully inside the visible picture",
+          inside.detail("inside"));
+    check(gap.clean(),
+          "the inset sits exactly one margin inside the picture's bottom-right "
+          "corner",
+          gap.detail("margin"));
+    check(hidden.clean(), "the inset shows the hidden screen, never the shown "
+                          "one",
+          hidden.detail("screen"));
+    check(minimum_size.clean(), "the inset is at least one pixel in each axis",
+          minimum_size.detail("size"));
+    check(width_rule.clean(),
+          "the inset width is a third of the picture, lifted to the floor and "
+          "capped at the room",
+          width_rule.detail("width"));
+    check(aspect.clean(), "the inset keeps 4:3 to within -1 <= 4h - 3w <= 2",
+          aspect.detail("aspect"));
+    check(scale_identity.clean(),
+          "scale_x and scale_y are exactly width/256 and height/192",
+          scale_identity.detail("scale"));
+    check(ordered.clean(), "the inset is inside the picture's own quadrant",
+          ordered.detail("order"));
+}
+
+// The same invariants over one-screen views cut out of real layout geometry, so
+// the picture rects carry the offsets and sizes the layout module really
+// produces: centring margins, fractional scales, wide canvases.
+void check_layout_sweep() {
+    const int kCanvases[][2] = {
+        {256, 192},  {256, 384},  {512, 192},   {512, 256},   {320, 240},
+        {336, 192},  {448, 336},  {640, 480},   {777, 600},   {800, 600},
+        {800, 601},  {1024, 768}, {1280, 960},  {1366, 768},  {1920, 1080},
+        {2560, 1440}, {16384, 16384}, {200, 400}, {300, 384}, {513, 193},
+    };
+    Tally inside;
+    Tally gap;
+    Tally width_rule;
+    Tally aspect;
+    Tally screen;
+    int requests = 0;
+    int visible_count = 0;
+    int refused_count = 0;
+
+    for (int kind = 0; kind < 5; ++kind) {
+        for (const int* canvas : kCanvases) {
+            for (int integer_scale = 0; integer_scale < 2; ++integer_scale) {
+                for (int swap_index = 0; swap_index < 2; ++swap_index) {
+                    const bool swap = swap_index != 0;
+                    const NdsScreenLayoutResult placed = nds_screen_layout::
+                        compute_layout(static_cast<NdsScreenLayoutKind>(kind),
+                                       canvas[0], canvas[1], integer_scale != 0,
+                                       swap);
+                    for (int shown = 0; shown < 2; ++shown) {
+                        ++requests;
+                        NdsPresentationGeometry geometry{};
+                        if (placed.valid) {
+                            geometry.valid = true;
+                            geometry.canvas_width = placed.canvas_width;
+                            geometry.canvas_height = placed.canvas_height;
+                            geometry.logical_width[0] = placed.canvas_width;
+                            geometry.logical_height[0] = placed.canvas_height;
+                            geometry.window_width[0] = placed.canvas_width * 3;
+                            geometry.window_height[0] = placed.canvas_height * 3;
+                            geometry.screen_rect[0] = placed.rects[0];
+                            geometry.screen_rect[1] = placed.rects[1];
+                            geometry.visible[shown] = true;
+                            geometry.window_count = 1;
+                        }
+                        const NdsMinimapLayout layout =
+                            compute_minimap(geometry);
+                        char label_buffer[160];
+                        std::snprintf(
+                            label_buffer, sizeof(label_buffer),
+                            "%s %dx%d %s swap %d showing %s", layout_label(kind),
+                            canvas[0], canvas[1],
+                            integer_scale ? "integer" : "fractional",
+                            swap ? 1 : 0,
+                            shown == 0 ? "top" : "bottom");
+                        const std::string label = label_buffer;
+                        if (!layout.visible) {
+                            ++refused_count;
+                            if (!layout_is_all_zero(layout)) {
+                                refused_count += 1000;
+                            }
+                            continue;
+                        }
+                        ++visible_count;
+                        const NdsScreenRect picture =
+                            geometry.screen_rect[shown];
+                        const int margin = expected_margin(picture.width);
+                        if (layout.inset.x < picture.x ||
+                            layout.inset.y < picture.y ||
+                            layout.inset.x + layout.inset.width >
+                                picture.x + picture.width ||
+                            layout.inset.y + layout.inset.height >
+                                picture.y + picture.height) {
+                            inside.note(label + " inset " +
+                                        describe_rect(layout.inset) +
+                                        " picture " + describe_rect(picture));
+                        }
+                        if (picture.x + picture.width -
+                                (layout.inset.x + layout.inset.width) !=
+                                margin ||
+                            picture.y + picture.height -
+                                (layout.inset.y + layout.inset.height) !=
+                                margin) {
+                            gap.note(label + " inset " +
+                                     describe_rect(layout.inset) + " margin " +
+                                     std::to_string(margin));
+                        }
+                        const ExpectedInset expected =
+                            expected_inset(picture.width, picture.height);
+                        if (!expected.visible ||
+                            layout.inset.width != expected.width ||
+                            layout.inset.height != expected.height) {
+                            width_rule.note(label + " inset " +
+                                            describe_rect(layout.inset));
+                        }
+                        const int spread =
+                            4 * layout.inset.height - 3 * layout.inset.width;
+                        if (spread < -1 || spread > 2) {
+                            aspect.note(label + " 4h-3w " +
+                                        std::to_string(spread));
+                        }
+                        if (layout.screen != (shown == 0 ? kNdsScreenBottom
+                                                        : kNdsScreenTop)) {
+                            screen.note(label + " screen " +
+                                        std::to_string(layout.screen));
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    check(requests == 800, "the layout sweep is 800 requests",
+          "got " + std::to_string(requests));
+    check(refused_count < 1000,
+          "every refused layout view zeroes the whole minimap struct",
+          "got " + std::to_string(refused_count) + " refusals, some of them "
+          "with stale fields");
+    check(visible_count > 200,
+          "the layout sweep produces more than 200 minimaps to check",
+          "got " + std::to_string(visible_count));
+    check(inside.clean(),
+          "every layout-derived inset lies inside its own picture",
+          inside.detail("inside"));
+    check(gap.clean(),
+          "every layout-derived inset keeps the exact bottom-right margin",
+          gap.detail("margin"));
+    check(width_rule.clean(),
+          "every layout-derived inset has the width the header's rule asks "
+          "for",
+          width_rule.detail("width"));
+    check(aspect.clean(),
+          "every layout-derived inset keeps the 4:3 band",
+          aspect.detail("aspect"));
+    check(screen.clean(),
+          "every layout-derived inset shows the screen that is hidden",
+          screen.detail("screen"));
+}
+
+// Decision 9: every layout kind, including the two-window value and integers
+// outside the enum, returns a well-formed layout.
+void check_totality() {
+    const int kKinds[] = {-99, -1, 0, 1, 2, 3, 4, 5, 6, 7, 99};
+    bool all_well_formed = true;
+    std::string detail;
+    for (int kind : kKinds) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            static_cast<NdsScreenLayoutKind>(kind), 2, 0, false, false);
+        const NdsMinimapLayout layout = compute_minimap(geometry);
+        const bool well_formed = layout_is_all_zero(layout) ||
+                                 (layout.visible && layout.screen >= kNdsScreenTop &&
+                                  layout.screen <= kNdsScreenBottom &&
+                                  layout.inset.width >= 1 &&
+                                  layout.inset.height >= 1);
+        if (!well_formed) {
+            all_well_formed = false;
+            char buffer[192];
+            std::snprintf(buffer, sizeof(buffer), "kind %d gave %s", kind,
+                          describe_layout(layout).c_str());
+            if (detail.empty()) detail = buffer;
+        }
+        // The two-window value is the only kind that must refuse here; every
+        // other kind is a layout, and at 2x the two one-screen ones produce a
+        // minimap while the two-screen ones do not.
+        const bool expected_visible =
+            kind != static_cast<int>(kNdsPresentationSeparateWindows) &&
+            (kind == kNdsLayoutTopOnly || kind == kNdsLayoutBottomOnly);
+        if (layout.visible != expected_visible && detail.empty()) {
+            char buffer[192];
+            std::snprintf(buffer, sizeof(buffer),
+                          "kind %d expected visible %d, got %s", kind,
+                          expected_visible ? 1 : 0,
+                          describe_layout(layout).c_str());
+            detail = buffer;
+            all_well_formed = false;
+        }
+    }
+    check(all_well_formed,
+          "every layout kind, including the two-window value and out-of-range "
+          "integers, returns a well-formed layout",
+          detail);
+}
+
+// FNV-1a over the whole struct stream of the 150-request sweep, so a change to
+// the placement arithmetic shows up as a different number in the log.
+constexpr std::uint64_t kFnvOffsetBasis = 0xCBF29CE484222325ULL;
+constexpr std::uint64_t kFnvPrime = 0x100000001B3ULL;
+
+std::uint64_t fold_word(std::uint64_t hash, std::uint32_t word) {
+    for (int byte = 0; byte < 4; ++byte) {
+        hash ^= (word >> (byte * 8)) & 0xFFu;
+        hash *= kFnvPrime;
+    }
+    return hash;
+}
+
+std::uint32_t float_bits(float value) {
+    std::uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+struct Digest {
+    std::uint64_t hash;
+    int words;
+};
+
+Digest sweep_digest() {
+    Digest digest{kFnvOffsetBasis, 0};
+    for (int kind = 0; kind < 5; ++kind) {
+        for (int scale : kSweepScales) {
+            for (int adaptive : kAdaptive) {
+                for (int swap_index = 0; swap_index < 2; ++swap_index) {
+                    const NdsPresentationGeometry geometry = compute_presentation(
+                        static_cast<NdsScreenLayoutKind>(kind), scale, adaptive,
+                        swap_index != 0, false);
+                    const NdsMinimapLayout layout = compute_minimap(geometry);
+                    digest.hash = fold_word(digest.hash, layout.visible ? 1 : 0);
+                    digest.hash =
+                        fold_word(digest.hash,
+                                  static_cast<std::uint32_t>(layout.screen));
+                    digest.hash = fold_word(
+                        digest.hash, static_cast<std::uint32_t>(layout.inset.x));
+                    digest.hash = fold_word(
+                        digest.hash, static_cast<std::uint32_t>(layout.inset.y));
+                    digest.hash = fold_word(
+                        digest.hash,
+                        static_cast<std::uint32_t>(layout.inset.width));
+                    digest.hash = fold_word(
+                        digest.hash,
+                        static_cast<std::uint32_t>(layout.inset.height));
+                    digest.hash = fold_word(digest.hash,
+                                            float_bits(layout.scale_x));
+                    digest.hash = fold_word(digest.hash,
+                                            float_bits(layout.scale_y));
+                    digest.words += 8;
+                }
+            }
+        }
+    }
+    return digest;
+}
+
+void check_determinism() {
+    const Digest first = sweep_digest();
+    const Digest second = sweep_digest();
+    check(first.words == 1200, "the digest covers 1,200 words of struct fields",
+          "got " + std::to_string(first.words) + " words");
+    // 0xCEBC1E3B8BB0FCC1 is the value the independent Python model of the
+    // header produces for this sweep; a difference means the implementation
+    // and the model disagree about this many configurations.
+    char name[160];
+    std::snprintf(name, sizeof(name),
+                  "the 150-request sweep hashes to %016llX",
+                  static_cast<unsigned long long>(first.hash));
+    char detail[192];
+    std::snprintf(detail, sizeof(detail),
+                  "expected %016llX, got %016llX",
+                  static_cast<unsigned long long>(0xCEBC1E3B8BB0FCC1ULL),
+                  static_cast<unsigned long long>(first.hash));
+    check(first.hash == 0xCEBC1E3B8BB0FCC1ULL, name, detail);
+    check(first.hash == second.hash && first.words == second.words,
+          "the digest is the same on a second run in the same process",
+          "two runs disagree");
+    // A geometry that differs gets a different digest: the stream really does
+    // cover the fields it claims to.
+    NdsMinimapLayout layout{};
+    layout.visible = true;
+    layout.inset = NdsScreenRect{1, 2, 3, 4};
+    std::uint64_t moved = kFnvOffsetBasis;
+    moved = fold_word(moved, 1);
+    moved = fold_word(moved, 0);
+    moved = fold_word(moved, 1);
+    moved = fold_word(moved, 2);
+    moved = fold_word(moved, 3);
+    moved = fold_word(moved, 4);
+    moved = fold_word(moved, float_bits(layout.scale_x));
+    moved = fold_word(moved, float_bits(layout.scale_y));
+    std::uint64_t other = fold_word(kFnvOffsetBasis, 1);
+    other = fold_word(other, 0);
+    other = fold_word(other, 1);
+    other = fold_word(other, 2);
+    other = fold_word(other, 3);
+    other = fold_word(other, 5);
+    other = fold_word(other, float_bits(layout.scale_x));
+    other = fold_word(other, float_bits(layout.scale_y));
+    check(moved != other, "the digest moves when a field moves",
+          "both folds produced the same value");
+}
+
+// The calls the frontend makes: one presentation per layout and scale, then the
+// minimap row's inset, checked against the pictures the presenter draws.
+void check_frontend_calls() {
+    struct Case {
+        int kind;
+        bool swap;
+        int expected_screen;
+        const char* label;
+    };
+    const Case kCases[] = {
+        {kNdsLayoutTopOnly, false, kNdsScreenBottom,
+         "top only asks for the bottom screen's thumbnail"},
+        {kNdsLayoutTopOnly, true, kNdsScreenTop,
+         "top only with swap asks for the top screen's thumbnail"},
+        {kNdsLayoutBottomOnly, false, kNdsScreenTop,
+         "bottom only asks for the top screen's thumbnail"},
+        {kNdsLayoutBottomOnly, true, kNdsScreenBottom,
+         "bottom only with swap asks for the bottom screen's thumbnail"},
+    };
+    for (const Case& item : kCases) {
+        bool consistent = true;
+        std::string detail;
+        for (int scale : kScales) {
+            const NdsPresentationGeometry geometry = compute_presentation(
+                static_cast<NdsScreenLayoutKind>(item.kind), scale, 0,
+                item.swap, false);
+            const NdsMinimapLayout layout = compute_minimap(geometry);
+            const int shown = geometry.visible[kNdsScreenTop] ? kNdsScreenTop
+                                                             : kNdsScreenBottom;
+            const NdsScreenRect picture = geometry.screen_rect[shown];
+            // The thumbnail is inside the picture the presenter draws and
+            // shows the other screen: the two facts the draw call relies on.
+            const bool ok =
+                layout.visible && layout.screen == item.expected_screen &&
+                layout.screen != shown && layout.inset.x >= picture.x &&
+                layout.inset.y >= picture.y &&
+                layout.inset.x + layout.inset.width <=
+                    picture.x + picture.width &&
+                layout.inset.y + layout.inset.height <=
+                    picture.y + picture.height;
+            if (!ok) {
+                consistent = false;
+                char buffer[192];
+                std::snprintf(buffer, sizeof(buffer),
+                              "at %dx got %s inside picture %s", scale,
+                              describe_layout(layout).c_str(),
+                              describe_rect(picture).c_str());
+                detail = buffer;
+                break;
+            }
+        }
+        check(consistent, item.label, detail);
+    }
+    // The minimap row is a one-window-layout feature: every two-window
+    // geometry the presenter can build refuses it, whatever the scale.
+    bool always_refused = true;
+    for (int scale : kScales) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsPresentationSeparateWindows, scale, 0, false, false);
+        if (!layout_is_all_zero(compute_minimap(geometry))) {
+            always_refused = false;
+        }
+    }
+    check(always_refused,
+          "the two-window presentation never draws a minimap at any scale",
+          "a two-window geometry produced a visible minimap");
+}
+
+}  // namespace
+
+int main() {
+    check_pins();
+    check_hand_built();
+    check_refusals();
+    check_window_scale_invisibility();
+    check_sweep();
+    check_layout_sweep();
+    check_totality();
+    check_determinism();
+    check_frontend_calls();
+
+    std::printf("%d checks passed\n", g_checks - g_failures);
+    if (g_failures != 0) {
+        std::printf("%d of %d checks failed, first at index %d\n", g_failures,
+                    g_checks, g_first_failure);
+        return g_first_failure;
+    }
+    return 0;
+}
diff --git a/runner/tests/screen_presentation_test.cpp b/runner/tests/screen_presentation_test.cpp
new file mode 100644
index 0000000..509ea78
--- /dev/null
+++ b/runner/tests/screen_presentation_test.cpp
@@ -0,0 +1,1964 @@
+// Pins the presentation layer (screen_presentation.h).
+//
+// screen_layouts decides where each DS picture goes on a canvas; this module
+// decides what the frontend actually opens: how big the window is, how big the
+// renderer's logical surface is, which screens are visible, and which DS pixel
+// a click lands on. Every one of those is a number the emulator cannot check
+// for itself -- a window one scale factor off still shows a picture, and a
+// touch mapping off by a few pixels still moves the cursor -- so the numbers
+// are pinned first and the properties second.
+//
+// 1. Hand pins: every layout x window_scale {1,2,3,4} x swap {off,on}, 40 rows,
+//    with the arithmetic for the base canvas written out below.
+// 2. Adaptive width: the widening, its exact centring, and every refusal
+//    (odd, too narrow, too wide, wrong layout, two-window mode).
+// 3. Refusals: a refused request zeroes every field, which is checked by
+//    is_refused(), so a "valid-looking but ignored" path cannot pass by
+//    accident.
+// 4. Hit testing: picture centres, per-DS-pixel round trips, the corners, one
+//    pixel outside every edge, the black margins, hidden screens, window
+//    indices that do not exist, and the promise that a miss writes nothing.
+//    Both entry points are covered: the window-space one and the logical-space
+//    one, the property that they agree, and the resize case that is the reason
+//    the logical one exists.
+// 5. Contract loops over the whole input space: every rect inside the logical
+//    surface, no overlap, window == logical * window_scale exactly, visibility
+//    agreeing with the rects, and a refusal leaving nothing behind.
+// 6. Determinism: two FNV-1a digests, one over every geometry field for 2,016
+//    configurations and one over 6,500 hit-test samples, both matched against
+//    an independent model of the header written in Python.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and a failure prints what it got next to what
+// it expected, so a failure names itself without a debugger.
+//
+// Base canvases (the native canvas for each layout, from layout_min_canvas):
+//   stacked       256x384
+//   side-by-side  512x192
+//   square        512x256   (two 256x256 tiles, pictures 32 px from the top)
+//   top only      256x192
+//   bottom only   256x192
+// The window is always the canvas times window_scale, and the logical surface
+// is always the canvas itself, so `window == logical * window_scale` is the one
+// relation every valid geometry satisfies.
+
+#include "screen_presentation.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// The two-window mode is spelled as one past the last layout so it can never
+// collide with a layout kind, and the enum values are persisted, so their
+// numeric identity is part of the contract.
+static_assert(nds_screen_presentation::kNdsPresentationSeparateWindows == 5,
+              "two-window mode is value 5");
+static_assert(
+    nds_screen_presentation::kNdsPresentationSeparateWindows ==
+        nds_screen_layout::kNdsLayoutKindCount,
+    "two-window mode is one past the last layout");
+
+namespace {
+
+using nds_screen_layout::kNdsLayoutBottomOnly;
+using nds_screen_layout::kNdsLayoutSideBySide;
+using nds_screen_layout::kNdsLayoutSquare;
+using nds_screen_layout::kNdsLayoutStacked;
+using nds_screen_layout::kNdsLayoutTopOnly;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::NdsScreenLayoutKind;
+using nds_screen_layout::NdsScreenRect;
+using nds_screen_layout::kNdsScreenTop;
+
+using nds_screen_presentation::compute_presentation;
+using nds_screen_presentation::kNdsPresentationSeparateWindows;
+using nds_screen_presentation::kMaxAdaptiveWidth;
+using nds_screen_presentation::kMaxWindowScale;
+using nds_screen_presentation::kMinAdaptiveWidth;
+using nds_screen_presentation::NdsPresentationGeometry;
+using nds_screen_presentation::is_separate_windows;
+using nds_screen_presentation::screen_presentation_hit_test;
+using nds_screen_presentation::screen_presentation_hit_test_logical;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const std::string& what,
+           const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what.c_str());
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::printf("FAIL %s\n     %s\n", what.c_str(), detail.c_str());
+    return false;
+}
+
+bool rect_is(const NdsScreenRect& rect, int x, int y, int width, int height) {
+    return rect.x == x && rect.y == y && rect.width == width &&
+           rect.height == height;
+}
+
+// A single-line dump of a geometry, used as the failure detail everywhere.
+std::string describe(const NdsPresentationGeometry& geometry) {
+    if (!geometry.valid) return "refused (every field zero)";
+    char buffer[320];
+    std::snprintf(
+        buffer, sizeof(buffer),
+        "canvas %dx%d window %dx%d/%dx%d logical %dx%d/%dx%d "
+        "top {%d,%d,%d,%d} bottom {%d,%d,%d,%d} visible %d,%d "
+        "windows %d separate %d",
+        geometry.canvas_width, geometry.canvas_height, geometry.window_width[0],
+        geometry.window_height[0], geometry.window_width[1],
+        geometry.window_height[1], geometry.logical_width[0],
+        geometry.logical_height[0], geometry.logical_width[1],
+        geometry.logical_height[1], geometry.screen_rect[kNdsScreenTop].x,
+        geometry.screen_rect[kNdsScreenTop].y,
+        geometry.screen_rect[kNdsScreenTop].width,
+        geometry.screen_rect[kNdsScreenTop].height,
+        geometry.screen_rect[kNdsScreenBottom].x,
+        geometry.screen_rect[kNdsScreenBottom].y,
+        geometry.screen_rect[kNdsScreenBottom].width,
+        geometry.screen_rect[kNdsScreenBottom].height,
+        geometry.visible[kNdsScreenTop] ? 1 : 0,
+        geometry.visible[kNdsScreenBottom] ? 1 : 0, geometry.window_count,
+        geometry.separate_windows ? 1 : 0);
+    return std::string(buffer);
+}
+
+// True only for the documented refusal shape: invalid AND every other field
+// zero. A "refused" result that still carries a rect or a window size would let
+// a frontend draw something while thinking it had refused.
+bool is_refused(const NdsPresentationGeometry& geometry) {
+    if (geometry.valid) return false;
+    if (geometry.canvas_width != 0 || geometry.canvas_height != 0) return false;
+    if (geometry.window_count != 0 || geometry.separate_windows) return false;
+    for (int index = 0; index < 2; ++index) {
+        if (geometry.window_width[index] != 0) return false;
+        if (geometry.window_height[index] != 0) return false;
+        if (geometry.logical_width[index] != 0) return false;
+        if (geometry.logical_height[index] != 0) return false;
+        if (!rect_is(geometry.screen_rect[index], 0, 0, 0, 0)) return false;
+        if (geometry.visible[index]) return false;
+    }
+    return true;
+}
+
+std::string refusal_detail(const NdsPresentationGeometry& geometry) {
+    return "expected every field zero, got " + describe(geometry);
+}
+
+// ---------------------------------------------------------------------------
+// Constants and the two-window mode predicate
+// ---------------------------------------------------------------------------
+
+void check_constants() {
+    check(kMaxWindowScale == 16, "kMaxWindowScale is 16",
+          std::to_string(kMaxWindowScale));
+    check(kMinAdaptiveWidth == 256, "kMinAdaptiveWidth is the native width",
+          std::to_string(kMinAdaptiveWidth));
+    check(kMaxAdaptiveWidth == 448, "kMaxAdaptiveWidth is 448",
+          std::to_string(kMaxAdaptiveWidth));
+    check(kMaxAdaptiveWidth > kMinAdaptiveWidth,
+          "the adaptive width range is not empty", "");
+
+    const NdsPresentationGeometry geometry = compute_presentation(
+        kNdsLayoutStacked, 1, 0, false, false);
+    check(geometry.window_count == 1 && !geometry.separate_windows,
+          "a layout is one window, not the two-window mode",
+          describe(geometry));
+}
+
+void check_is_separate_windows() {
+    const int not_separate[] = {-2, -1, 0, 1, 2, 3, 4, 6, 99};
+    for (int value : not_separate) {
+        const bool got =
+            is_separate_windows(static_cast<NdsScreenLayoutKind>(value));
+        check(!got, "is_separate_windows is false for " +
+                        std::to_string(value),
+              "got true");
+    }
+    check(is_separate_windows(kNdsPresentationSeparateWindows),
+          "is_separate_windows is true for the two-window mode", "got false");
+}
+
+// ---------------------------------------------------------------------------
+// Hand pins: 5 layouts x scales 1..4 x swap off/on
+// ---------------------------------------------------------------------------
+
+struct PinCase {
+    NdsScreenLayoutKind kind;
+    int window_scale;
+    bool swap_screens;
+    int canvas_width;
+    int canvas_height;
+    NdsScreenRect top;
+    NdsScreenRect bottom;
+    bool visible_top;
+    bool visible_bottom;
+    const char* label;
+};
+
+// The rectangles do not depend on window_scale: the canvas is the same, only
+// the window and the logical surface grow. Two of them by hand:
+//
+//   stacked, 256x384, no swap: two 256x192 pictures stacked edge to edge ->
+//     top {0,0,256,192}, bottom {0,192,256,192}.
+//   square, 512x256, no swap: two 256x256 tiles side by side, each holding a
+//     256x192 picture centred vertically, so (256-192)/2 = 32 px above and
+//     below -> top {0,32,256,192}, bottom {256,32,256,192}.
+//
+// window_scale 2 turns the first into a 512x768 window with a 256x384 logical
+// surface; the rects stay in DS pixels, which is the whole point of decision 2.
+const PinCase kPins[] = {
+    // kind                  scale swap cw  ch  top                 bottom
+    {kNdsLayoutStacked, 1, false, 256, 384, {0, 0, 256, 192},
+     {0, 192, 256, 192}, true, true, "stacked 1x"},
+    {kNdsLayoutStacked, 2, false, 256, 384, {0, 0, 256, 192},
+     {0, 192, 256, 192}, true, true, "stacked 2x"},
+    {kNdsLayoutStacked, 3, false, 256, 384, {0, 0, 256, 192},
+     {0, 192, 256, 192}, true, true, "stacked 3x"},
+    {kNdsLayoutStacked, 4, false, 256, 384, {0, 0, 256, 192},
+     {0, 192, 256, 192}, true, true, "stacked 4x"},
+    {kNdsLayoutStacked, 1, true, 256, 384, {0, 192, 256, 192},
+     {0, 0, 256, 192}, true, true, "stacked 1x swapped"},
+    {kNdsLayoutStacked, 2, true, 256, 384, {0, 192, 256, 192},
+     {0, 0, 256, 192}, true, true, "stacked 2x swapped"},
+    {kNdsLayoutStacked, 3, true, 256, 384, {0, 192, 256, 192},
+     {0, 0, 256, 192}, true, true, "stacked 3x swapped"},
+    {kNdsLayoutStacked, 4, true, 256, 384, {0, 192, 256, 192},
+     {0, 0, 256, 192}, true, true, "stacked 4x swapped"},
+
+    {kNdsLayoutSideBySide, 1, false, 512, 192, {0, 0, 256, 192},
+     {256, 0, 256, 192}, true, true, "side-by-side 1x"},
+    {kNdsLayoutSideBySide, 2, false, 512, 192, {0, 0, 256, 192},
+     {256, 0, 256, 192}, true, true, "side-by-side 2x"},
+    {kNdsLayoutSideBySide, 3, false, 512, 192, {0, 0, 256, 192},
+     {256, 0, 256, 192}, true, true, "side-by-side 3x"},
+    {kNdsLayoutSideBySide, 4, false, 512, 192, {0, 0, 256, 192},
+     {256, 0, 256, 192}, true, true, "side-by-side 4x"},
+    {kNdsLayoutSideBySide, 1, true, 512, 192, {256, 0, 256, 192},
+     {0, 0, 256, 192}, true, true, "side-by-side 1x swapped"},
+    {kNdsLayoutSideBySide, 2, true, 512, 192, {256, 0, 256, 192},
+     {0, 0, 256, 192}, true, true, "side-by-side 2x swapped"},
+    {kNdsLayoutSideBySide, 3, true, 512, 192, {256, 0, 256, 192},
+     {0, 0, 256, 192}, true, true, "side-by-side 3x swapped"},
+    {kNdsLayoutSideBySide, 4, true, 512, 192, {256, 0, 256, 192},
+     {0, 0, 256, 192}, true, true, "side-by-side 4x swapped"},
+
+    // A single-screen layout shows its screen edge to edge; swap turns the
+    // hidden screen into the visible one in the same place (decision 4).
+    {kNdsLayoutTopOnly, 1, false, 256, 192, {0, 0, 256, 192}, {0, 0, 0, 0},
+     true, false, "top only 1x"},
+    {kNdsLayoutTopOnly, 2, false, 256, 192, {0, 0, 256, 192}, {0, 0, 0, 0},
+     true, false, "top only 2x"},
+    {kNdsLayoutTopOnly, 3, false, 256, 192, {0, 0, 256, 192}, {0, 0, 0, 0},
