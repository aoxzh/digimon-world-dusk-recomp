+// ---------------------------------------------------------------------------
+// The numeric parsers the config file shares
+// ---------------------------------------------------------------------------
+
+void check_numeric_parsers() {
+    uint8_t quality = 0;
+    check(nds_parse_supersampling("4", &quality) && quality == 4,
+          "supersampling accepts 4",
+          "value " + std::to_string(static_cast<int>(quality)));
+    check(!nds_parse_supersampling("0", &quality),
+          "supersampling rejects 0", "accepted it");
+    check(nds_parse_antialiasing("8", &quality) && quality == 8,
+          "antialiasing accepts 8",
+          "value " + std::to_string(static_cast<int>(quality)));
+    check(!nds_parse_antialiasing("3", &quality),
+          "antialiasing rejects 3", "accepted it");
+    check(!nds_parse_supersampling("3x", &quality),
+          "supersampling rejects trailing garbage", "accepted it");
+
+    bool toggle = false;
+    check(nds_parse_on_off("on", &toggle) && toggle,
+          "on_off accepts on", "got false");
+    check(nds_parse_on_off("yes", &toggle) && toggle,
+          "on_off accepts yes", "got false");
+    check(nds_parse_on_off("1", &toggle) && toggle,
+          "on_off accepts 1", "got false");
+    check(nds_parse_on_off("false", &toggle) && !toggle,
+          "on_off accepts false", "got true");
+    check(nds_parse_on_off("NO", &toggle) && !toggle,
+          "on_off accepts NO", "got true");
+    check(!nds_parse_on_off("maybe", &toggle),
+          "on_off rejects maybe", "accepted it");
+
+    uint16_t mouse_value = 0;
+    check(nds_parse_mouse_sensitivity("125", &mouse_value) &&
+              mouse_value == 125,
+          "mouse sensitivity accepts 125",
+          "value " + std::to_string(mouse_value));
+    check(!nds_parse_mouse_sensitivity("9", &mouse_value),
+          "mouse sensitivity rejects 9", "accepted it");
+    check(!nds_parse_mouse_sensitivity("401", &mouse_value),
+          "mouse sensitivity rejects 401", "accepted it");
+
+    // The fire key is a bit mask, not an index: the mouse code tests these bits
+    // directly, so the exact shift is part of the contract.
+    check(nds_parse_mouse_fire_key("L", &mouse_value) &&
+              mouse_value == (1u << 9),
+          "mouse fire key L is bit 9",
+          "value " + std::to_string(mouse_value));
+    check(nds_parse_mouse_fire_key("a", &mouse_value) &&
+              mouse_value == (1u << 0),
+          "mouse fire key a is bit 0",
+          "value " + std::to_string(mouse_value));
+    check(nds_parse_mouse_fire_key("y", &mouse_value) &&
+              mouse_value == (1u << 11),
+          "mouse fire key y is bit 11",
+          "value " + std::to_string(mouse_value));
+    check(nds_parse_mouse_fire_key("none", &mouse_value) && mouse_value == 0,
+          "mouse fire key none is no bits",
+          "value " + std::to_string(mouse_value));
+    check(!nds_parse_mouse_fire_key("start", &mouse_value),
+          "mouse fire key rejects start", "accepted it");
+
+    uint16_t local_wireless_port = 0;
+    check(nds_parse_local_wireless_base_port("26710", &local_wireless_port) &&
+              local_wireless_port == 26710,
+          "local wireless port accepts 26710",
+          "value " + std::to_string(local_wireless_port));
+    check(!nds_parse_local_wireless_base_port("1023", &local_wireless_port),
+          "local wireless port rejects 1023", "accepted it");
+    check(!nds_parse_local_wireless_base_port("65521", &local_wireless_port),
+          "local wireless port rejects 65521", "accepted it");
+
+    uint16_t width = 0;
+    check(nds_parse_widescreen_width("448", &width) && width == 448,
+          "adaptive width accepts 448", "value " + std::to_string(width));
+    check(nds_parse_widescreen_width("256", &width) && width == 256,
+          "adaptive width accepts 256", "value " + std::to_string(width));
+    check(nds_parse_widescreen_width("320", &width) && width == 320,
+          "adaptive width accepts 320", "value " + std::to_string(width));
+    check(nds_parse_widescreen_width("384", &width) && width == 384,
+          "adaptive width accepts 384", "value " + std::to_string(width));
+    check(!nds_parse_widescreen_width("255", &width),
+          "adaptive width rejects 255", "accepted it");
+    check(!nds_parse_widescreen_width("449", &width),
+          "adaptive width rejects 449", "accepted it");
+    // Four widths, not a range: the widescreen path has a fixed table of
+    // layouts, so a plausible-looking in-between width is still a mistake.
+    check(!nds_parse_widescreen_width("342", &width),
+          "adaptive width rejects a width between the allowed ones",
+          "accepted it");
+    check(!nds_parse_widescreen_width("288", &width),
+          "adaptive width rejects 288, which is not in the table",
+          "accepted it");
+    check(!nds_parse_widescreen_width("416", &width),
+          "adaptive width rejects 416, which is not in the table",
+          "accepted it");
+    check(!nds_parse_widescreen_width("300", &width),
+          "adaptive width rejects 300, which is not in the table",
+          "accepted it");
+    check(!nds_parse_widescreen_width("", &width),
+          "adaptive width rejects an empty value", "accepted it");
+
+    NdsCartridgeSaveType save_type = NdsCartridgeSaveType::Eeprom;
+    check(nds_parse_cartridge_save_type("flash", &save_type) &&
+              save_type == NdsCartridgeSaveType::Flash,
+          "cartridge save type accepts flash", "rejected it");
+    check(nds_parse_cartridge_save_type("eeprom-tiny", &save_type) &&
+              save_type == NdsCartridgeSaveType::EepromTiny,
+          "cartridge save type accepts eeprom-tiny", "rejected it");
+    check(nds_parse_cartridge_save_type("EEPROM_TINY", &save_type) &&
+              save_type == NdsCartridgeSaveType::EepromTiny,
+          "cartridge save type accepts the underscore spelling", "rejected");
+    check(!nds_parse_cartridge_save_type("sram", &save_type),
+          "cartridge save type rejects sram", "accepted it");
+}
