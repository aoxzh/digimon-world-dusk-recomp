+        // frame cannot wait for the next frame boundary — it would spin forever
+        // on the same `now`. Sleep one DS frame instead and present the frozen
+        // framebuffer, which is what a paused emulator should look like.
+        const bool menu_holds_machine =
+            runtime_menu_state.snapshot.pause_in_menu != 0 && runtime_menu_open();
+        if (menu_holds_machine) {
+            if (!menu_paused) {
+                menu_paused = true;
+                std::fprintf(stderr, "[sdl] game paused by settings menu\n");
