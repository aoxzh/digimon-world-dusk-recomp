+    }
+
+    {
+        const std::string text = R"json({"achievements": {}})json";
+        parsed.clear();
+        diagnostics.clear();
+        const bool loaded =
+            parse_text(root, "notarray.json", text, &parsed, &diagnostics);
+        if (int code = check("\"achievements\" must be an array", !loaded,
+                             "returned true"))
