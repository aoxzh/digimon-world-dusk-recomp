+void check_adaptive_screens() {
+    struct Case {
+        const char* text;
+        uint8_t expected;
+    };
+    const Case cases[] = {
+        {"none", NDS_ADAPTIVE_NONE},
+        {"off", NDS_ADAPTIVE_NONE},
+        {"top", NDS_ADAPTIVE_TOP},
+        {"bottom", NDS_ADAPTIVE_BOTTOM},
+        {"both", NDS_ADAPTIVE_BOTH},
+        {"BOTH", NDS_ADAPTIVE_BOTH},
+        {"Top", NDS_ADAPTIVE_TOP},
+    };
+    for (const Case& row : cases) {
+        uint8_t parsed = 0xFF;
+        const bool accepted = nds_parse_adaptive_screens(row.text, &parsed);
+        check(accepted && parsed == row.expected,
+              std::string("adaptive_widescreen accepts ") +
+                  quote_text(row.text),
+              accepted ? "parsed value " +
+                             std::to_string(static_cast<int>(parsed))
+                       : "rejected");
+    }
+
+    const char* const junk[] = {"automatic", "screen-top", "top-bottom",
+                                "both-screens", ""};
+    for (const char* text : junk) {
+        uint8_t parsed = NDS_ADAPTIVE_TOP;
+        const bool accepted = nds_parse_adaptive_screens(text, &parsed);
+        check(!accepted,
+              std::string("adaptive_widescreen rejects ") + quote_text(text),
+              "parsed it as " + std::to_string(static_cast<int>(parsed)));
+        check(parsed == NDS_ADAPTIVE_TOP,
+              std::string(
+                  "a rejected adaptive_widescreen leaves the value alone: ") +
+                  quote_text(text),
+              "overwrote the caller's value with " +
+                  std::to_string(static_cast<int>(parsed)));
+    }
+    check(!nds_parse_adaptive_screens("top", nullptr),
+          "a null adaptive_widescreen destination is refused", "got true");
+
+    struct NameCase {
+        uint8_t value;
+        const char* expected;
+    };
+    const NameCase names[] = {
+        {NDS_ADAPTIVE_NONE, "none"},
+        {NDS_ADAPTIVE_TOP, "top"},
+        {NDS_ADAPTIVE_BOTTOM, "bottom"},
+        {NDS_ADAPTIVE_BOTH, "both"},
+    };
+    for (const NameCase& row : names) {
+        const std::string name = nds_adaptive_screens_name(row.value);
+        check(name == row.expected,
+              std::string("adaptive_widescreen name is ") +
+                  quote_text(row.expected),
+              "got " + quote_text(name));
+        uint8_t parsed = 0xFF;
+        const bool accepted = nds_parse_adaptive_screens(name, &parsed);
+        check(accepted && parsed == row.value,
+              std::string("adaptive_widescreen name round-trips ") +
+                  quote_text(row.expected),
+              accepted ? "parsed back value " +
+                             std::to_string(static_cast<int>(parsed))
+                       : "could not parse its own name back");
+    }
+
+    // The mask means a stray high bit is not a fourth mode: the name describes
+    // only the two screens the DS actually has.
+    check(std::string(nds_adaptive_screens_name(
+              static_cast<uint8_t>(NDS_ADAPTIVE_TOP | 0x80))) == "top",
+          "bits outside the two screens do not change the adaptive name",
+          "got " +
+              quote_text(nds_adaptive_screens_name(
+                  static_cast<uint8_t>(NDS_ADAPTIVE_TOP | 0x80))));
+    check(std::string(nds_adaptive_screens_name(
+              static_cast<uint8_t>(0x80))) == "none",
+          "no adaptive screens is named none",
+          "got " + quote_text(nds_adaptive_screens_name(
+                      static_cast<uint8_t>(0x80))));
+}
