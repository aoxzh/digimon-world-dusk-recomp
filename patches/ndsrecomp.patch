+            return fail("a quoted string keeps a '#' and expands its escapes",
+                        result.packs.empty() ? std::string("no pack")
+                                             : quote(result.packs[0].name));
+        ok("a quoted string keeps a '#' and expands its escapes");
+
+        if (!require(!result.packs.empty() &&
+                     result.packs[0].description == "back\\slash"))
+            return fail("a doubled backslash survives as one backslash",
+                        result.packs.empty()
+                            ? std::string("no pack")
+                            : quote(result.packs[0].description));
+        ok("a doubled backslash survives as one backslash");
