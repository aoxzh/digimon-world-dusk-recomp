+        if (int code = check("a non-array achievements value is explained",
+                             diagnostics_mention(diagnostics, "array"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        const std::string text = R"json({"achievements": [42]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a non-object entry still lets the file load",
+                             parse_text(root, "numentry.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a non-object entry yields no definition",
+                             parsed.empty(), describe(parsed)))
+            return code;
+        if (int code = check("a non-object entry is reported by index",
+                             diagnostics_mention(diagnostics,
+                                                 "achievements[0]"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        // One broken entry costs that entry only. This is the tolerance the
+        // whole diagnostics channel exists for.
+        const std::string text = R"json({"achievements": [
+          {"id": "good-one", "name": "Good", "counter": "in_game_saves",
+           "target": 1},
+          {"id": "no-name", "counter": "in_game_saves", "target": 2},
