+                             parsed.size() == 1u &&
+                                 parsed[0].target == 9007199254740992LL,
+                             parsed.empty() ? ""
+                                            : std::to_string(parsed[0].target)))
+            return code;
+    }
+
+    // ==== 2. Definition shapes that must be reported. ==================
+    {
+        // Unreadable and unparsable files fail the call but must not touch the
+        // caller's table: a running session keeps its achievements.
+        std::vector<ach::NdsAchievement> kept(1);
+        kept[0].id = "kept";
+        diagnostics.clear();
+        const bool loaded = ach::load_definitions(
+            (root / "defs" / "does-not-exist.json").string(), &kept,
