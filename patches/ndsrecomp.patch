+        NdsFullscreenMode value;
+        const char* expected;
+    };
+    const NameCase names[] = {
+        {NdsFullscreenMode::Off, "off"},
+        {NdsFullscreenMode::Borderless, "borderless"},
+        {NdsFullscreenMode::Exclusive, "exclusive"},
+    };
+    for (const NameCase& row : names) {
+        const std::string name = nds_fullscreen_mode_name(row.value);
+        check(name == row.expected,
+              std::string("fullscreen name is ") + quote_text(row.expected),
+              "got " + quote_text(name));
+        NdsFullscreenMode parsed = NdsFullscreenMode::Off;
+        const bool accepted = nds_parse_fullscreen_mode(name, &parsed);
+        check(accepted && parsed == row.value,
+              std::string("fullscreen name round-trips ") +
+                  quote_text(row.expected),
+              accepted ? "parsed back value " +
+                             std::to_string(static_cast<int>(parsed))
+                       : "could not parse its own name back");
+    }
+    check(std::string(nds_fullscreen_mode_name(
+              static_cast<NdsFullscreenMode>(7))) == "off",
+          "an unknown fullscreen value names windowed mode",
+          "got " +
+              quote_text(nds_fullscreen_mode_name(
+                  static_cast<NdsFullscreenMode>(7))));
+}
