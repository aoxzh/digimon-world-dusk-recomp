+        ach::refresh_unlocks(nullptr);
+        if (int code = check("observation of a null state is a no-op", true,
+                             "reached"))
+            return code;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, nullptr, 5);
+        if (int code = check("a null counter name unlocks nothing",
+                             notified_ids(state).empty(),
+                             join(notified_ids(state))))
+            return code;
+        ach::observe(&state, "", 5);
+        if (int code = check("an empty counter name unlocks nothing",
+                             notified_ids(state).empty(),
+                             join(notified_ids(state))))
+            return code;
+        ach::raise_flag(&state, "");
+        if (int code = check("an empty flag name raises nothing",
+                             notified_ids(state).empty(),
+                             join(notified_ids(state))))
+            return code;
+        ach::observe(&state, "  in_game_saves  ", 1);
+        if (int code = check("a padded counter name is trimmed",
+                             same_ids(notified_ids(state), {"first-save"}),
+                             join(notified_ids(state))))
+            return code;
+    }
+
+    {
+        // The query returns a reference, so a caller cannot accidentally copy
+        // and then compare against a stale snapshot.
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 1);
+        const std::vector<ach::NdsAchievement>& first =
+            ach::unlocked_by_last_observation(state);
+        ach::observe(&state, "in_game_saves", 1);
+        const std::vector<ach::NdsAchievement>& second =
+            ach::unlocked_by_last_observation(state);
+        if (int code = check("the notification list is observed live",
+                             &first == &second, "different objects"))
+            return code;
+        if (int code = check("the live list reflects the latest observation",
+                             first.empty(), join(notified_ids(state))))
+            return code;
+    }
+
+    {
+        // Lookups the menu needs.
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        if (int code = check("find_definition() finds a known id",
+                             ach::find_definition(state, "ten-saves") !=
