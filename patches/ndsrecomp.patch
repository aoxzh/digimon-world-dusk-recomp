index 0000000..f367940
--- /dev/null
+++ b/runner/src/nitrofs.cpp
@@ -0,0 +1,715 @@
+// nitrofs.cpp -- see nitrofs.h.
+//
+// The tree walk is the whole module; everything else is bookkeeping. The
+// parser reads two header fields, hands the name table to the walker, and the
+// walker turns a directory tree into a flat list of (path, id, offset, size).
+//
+// The interesting cases are all refusals. The input is a cartridge image that
+// a player may have edited by hand, so nothing here trusts a length, an offset
+// or the shape of the tree: every branch that cannot be followed becomes a
+// diagnostic, never an out-of-bounds read and never a loop that does not end.
+//
+// Two details of the format are worth stating because they are easy to get
+// wrong. First, a directory's entry in the table carries its own first file
+// id, and on a real cartridge the first ids can belong to something else
+// entirely -- the shipping Digimon Story cartridge gives ids 0..5 to the ARM9
+// overlay table, and the first named file is id 6 -- so the declared value is
+// treated as authoritative and merely validated, never recomputed by counting
+// from zero. Second, the root directory's "parent directory id" field actually
+// holds the number of directories in the table, so the parent field is read by
+// nothing here and validated by nothing.
+
+#include "nitrofs.h"
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <set>
+
+namespace nds_nitrofs {
+namespace {
+
+// Header offsets. The DS header is 0x200 bytes and these four fields are
+// adjacent, which is why they are written as a group.
+constexpr std::size_t kHeaderSize = 0x200u;
+constexpr std::size_t kFileTableOffsetField = 0x40u;
+constexpr std::size_t kFileTableSizeField = 0x44u;
+constexpr std::size_t kAllocationOffsetField = 0x48u;
+constexpr std::size_t kAllocationSizeField = 0x4Cu;
+
+// A directory table entry is eight bytes: a u32 subtable offset, a u16 first
+// file id and a u16 parent directory id.
+constexpr std::uint32_t kDirectoryEntrySize = 8u;
+
+// The name entry's first byte packs a directory flag into the top bit and the
+// name length into the low seven. A zero length byte ends the subtable.
+constexpr std::uint8_t kDirectoryFlag = 0x80u;
+constexpr std::uint8_t kNameLengthMask = 0x7Fu;
+
+// A subdirectory reference is a u16 whose low twelve bits are the index; the
+// top bits are reserved and a real cartridge sets them to all ones.
+constexpr std::uint16_t kDirectoryIndexMask = 0x0FFFu;
+
+// A FAT entry is two u32s: the start offset and the end offset. The size is
+// their difference, so a file's last byte is not included in the end offset.
+constexpr std::uint32_t kAllocationEntrySize = 8u;
+
+std::uint32_t read_u32(const std::uint8_t* bytes) {
+    return static_cast<std::uint32_t>(bytes[0]) |
+           (static_cast<std::uint32_t>(bytes[1]) << 8u) |
+           (static_cast<std::uint32_t>(bytes[2]) << 16u) |
+           (static_cast<std::uint32_t>(bytes[3]) << 24u);
+}
+
+std::uint16_t read_u16(const std::uint8_t* bytes) {
+    const std::uint32_t low = bytes[0];
+    const std::uint32_t high = static_cast<std::uint32_t>(bytes[1]) << 8u;
+    return static_cast<std::uint16_t>(low | high);
+}
+
+// True when [offset, offset + length) lies inside an image of `size` bytes.
+// Written with 64-bit arithmetic so that a pair of large values cannot wrap
+// into a range that looks plausible.
+bool range_is_inside(std::uint32_t offset, std::uint32_t length,
+                     std::size_t size) {
+    const std::uint64_t end =
+        static_cast<std::uint64_t>(offset) + static_cast<std::uint64_t>(length);
+    return end <= static_cast<std::uint64_t>(size);
+}
+
+// Names are compared and matched without regard to case, because a manifest
+// written by hand has no way to know the cartridge's spelling and getting it
+// wrong should be a miss, not a mystery.
+char fold_byte(char value) {
+    if (value >= 'A' && value <= 'Z')
+        return static_cast<char>(value - 'A' + 'a');
+    return value;
+}
+
+std::string fold(const std::string& text) {
+    std::string folded;
+    folded.reserve(text.size());
+    for (const char value : text) folded.push_back(fold_byte(value));
+    return folded;
+}
+
+// Normalise a caller-supplied path into the form the entries use: '/' between
+// components, no leading or trailing separator, no empty or '.' components,
+// folded case. Returns an empty string for a path that is empty, carries a
+// drive or stream separator, or asks to climb out with "..".
+std::string fold_path(const std::string& path) {
+    if (path.empty()) return std::string();
+    if (path.find(':') != std::string::npos) return std::string();
+
+    std::string folded;
+    std::size_t start = 0;
+    while (start <= path.size()) {
+        std::size_t stop = start;
+        while (stop < path.size() && path[stop] != '/' && path[stop] != '\\')
+            ++stop;
+        const std::string component = path.substr(start, stop - start);
+        if (!component.empty() && component != ".") {
+            if (component == "..") return std::string();
+            if (!folded.empty()) folded.push_back('/');
+            folded += fold(component);
+        }
+        if (stop >= path.size()) break;
+        start = stop + 1;
+    }
+    return folded;
+}
+
+// A name may hold any byte a cartridge would use, but it may not pretend to be
+// a path and it may not be unprintable: both would make a diagnostic that a
+// player cannot read back.
+bool name_is_valid(const std::string& name) {
+    if (name.empty()) return false;
+    for (const char value : name) {
+        const unsigned char byte = static_cast<unsigned char>(value);
+        if (byte == '/' || byte == '\\' || byte == ':') return false;
+        if (byte < 0x20u || byte == 0x7Fu) return false;
+    }
+    return true;
+}
+
+void add_diagnostic(NdsNitroFs* result, NdsNitroFsRule rule,
+                    const std::string& path, int id,
+                    const std::string& detail) {
+    // The cap stops a corrupt image from producing an unbounded list. The one
+    // exception is the notice that says the list was cut, which must survive
+    // the cap or the reader would look like it simply stopped finding things.
+    const bool notice = rule == NdsNitroFsRule::TooManyProblems;
+    if (!notice &&
+        result->diagnostics.size() >=
+            static_cast<std::size_t>(kNdsNitroFsMaxDiagnostics)) {
+        return;
+    }
+    NdsNitroFsDiagnostic diagnostic;
+    diagnostic.rule = rule;
+    diagnostic.path = path;
+    diagnostic.id = id;
+    diagnostic.detail = detail;
+    result->diagnostics.push_back(std::move(diagnostic));
+}
+
+std::string size_text(std::uint64_t value) {
+    return std::to_string(value);
+}
+
+// Byte offsets read better in hex; sizes read better in decimal. Both are used
+// in diagnostics, and mixing them up would make a message that says the wrong
+// thing, so there is one helper per base.
+std::string hex_text(std::uint64_t value) {
+    std::string text = "0x";
+    if (value == 0u) return text + "0";
+    char digits[17] = {};
+    int count = 0;
+    while (value != 0u) {
+        const int digit = static_cast<int>(value & 0xFu);
+        digits[count++] = static_cast<char>(digit < 10 ? '0' + digit
+                                                      : 'A' + digit - 10);
+        value >>= 4u;
+    }
+    while (count > 0) text.push_back(digits[--count]);
+    return text;
+}
+
+// The walker. It owns the two sets that make the tree's shape decidable -- the
+// directories on the current path, and every directory already visited -- plus
+// the sets that keep paths and file ids unique.
+struct Walker {
+    const std::uint8_t* image = nullptr;
+    std::size_t image_size = 0;
+    const std::uint8_t* file_table = nullptr;
+    std::size_t file_table_size = 0;
+    std::uint32_t allocation_offset = 0;
+    std::uint32_t allocation_entries = 0;
+    std::uint32_t directory_count = 0;
+    std::uint32_t directory_table_size = 0;
+    NdsNitroFs* result = nullptr;
+
+    std::vector<std::uint32_t> ancestors;
+    std::vector<bool> visited;
+    std::set<std::string> folded_paths;
+    std::set<int> used_ids;
+    bool stopped = false;
+
+    void report(NdsNitroFsRule rule, const std::string& path, int id,
+                const std::string& detail) {
+        if (stopped) return;
+        add_diagnostic(result, rule, path, id, detail);
+        if (result->diagnostics.size() >=
+            static_cast<std::size_t>(kNdsNitroFsMaxDiagnostics)) {
+            add_diagnostic(result, NdsNitroFsRule::TooManyProblems, "",
+                           -1,
+                           "more problems than this reader will list; the "
+                           "rest were dropped");
+            stopped = true;
+        }
+    }
+
+    void add_file(const std::string& path, int id) {
+        if (stopped) return;
+        if (result->files.size() >=
+            static_cast<std::size_t>(kNdsNitroFsMaxFiles)) {
+            report(NdsNitroFsRule::TooManyFiles, path, id,
+                   "this image names more files than the reader will carry");
+            return;
+        }
+        if (!folded_paths.insert(fold(path)).second) {
+            report(NdsNitroFsRule::DuplicatePath, path, id,
+                   "another entry in the file table already has this path");
+            return;
+        }
+        if (id < 0 || static_cast<std::uint32_t>(id) >= allocation_entries) {
+            report(NdsNitroFsRule::FileIdOutOfRange, path, id,
+                   "file id " + std::to_string(id) + " is outside the " +
+                       size_text(allocation_entries) +
+                       " entries the allocation table has");
+            return;
+        }
+        if (!used_ids.insert(id).second) {
+            report(NdsNitroFsRule::DuplicateFileId, path, id,
+                   "file id " + std::to_string(id) +
+                       " is already claimed by another entry, so this one "
+                       "could never be read");
+            return;
+        }
+
+        const std::uint32_t entry = allocation_offset +
+                                    static_cast<std::uint32_t>(id) *
+                                        kAllocationEntrySize;
+        const std::uint32_t start = read_u32(image + entry);
+        const std::uint32_t stop = read_u32(image + entry + 4);
+        if (stop < start) {
+            report(NdsNitroFsRule::FatEntryEmpty, path, id,
+                   "the allocation table ends this file at " +
+                       hex_text(stop) + " but starts it at " +
+                       hex_text(start));
+            return;
+        }
+        if (!range_is_inside(start, stop - start, image_size)) {
+            report(NdsNitroFsRule::FatEntryOutsideImage, path, id,
+                   "the allocation table places this file at " +
+                       hex_text(start) + " for " + size_text(stop - start) +
+                       " bytes, which leaves the " +
+                       size_text(image_size) + "-byte image");
+            return;
+        }
+
+        NdsNitroFsEntry found;
+        found.path = path;
+        found.id = id;
+        found.offset = start;
+        found.size = stop - start;
+        result->files.push_back(std::move(found));
+    }
+
+    void walk(std::uint32_t directory, const std::string& prefix, int depth) {
+        if (stopped) return;
+        if (depth > kNdsNitroFsMaxDepth) {
+            report(NdsNitroFsRule::DirectoryTooDeep, prefix,
+                   -1,
+                   "directories nest deeper than " +
+                       std::to_string(kNdsNitroFsMaxDepth) +
+                       " levels, which no cartridge needs");
+            return;
+        }
+        if (directory >= directory_count) {
+            report(NdsNitroFsRule::DirectoryOutsideFileTable, prefix, -1,
+                   "a subdirectory points at directory " +
+                       size_text(directory) + " but the table has " +
+                       size_text(directory_count));
+            return;
+        }
+        for (const std::uint32_t ancestor : ancestors) {
+            if (ancestor == directory) {
+                report(NdsNitroFsRule::DirectoryCycle, prefix, -1,
+                       "this directory is reachable from itself");
+                return;
+            }
+        }
+        if (visited[directory]) {
+            report(NdsNitroFsRule::DirectoryRepeated, prefix, -1,
+                   "this directory is reachable from two places in the tree");
+            return;
+        }
+        const std::uint32_t subtable =
+            read_u32(file_table + directory * kDirectoryEntrySize);
+        if (subtable < directory_table_size) {
+            report(NdsNitroFsRule::DirectoryTableTruncated, prefix, -1,
+                   "the subtable offset " + hex_text(subtable) +
+                       " points into the directory table itself");
+            return;
+        }
+        if (subtable >= file_table_size) {
+            report(NdsNitroFsRule::DirectoryOutsideFileTable, prefix, -1,
+                   "the subtable offset " + hex_text(subtable) +
+                       " is past the " + size_text(file_table_size) +
+                       "-byte file table");
+            return;
+        }
+
+        ancestors.push_back(directory);
+        visited[directory] = true;
+        ++result->directories;
+
+        const int first_file = static_cast<int>(read_u16(
+            file_table + directory * kDirectoryEntrySize + 4));
+        std::vector<std::pair<std::uint32_t, std::string>> children;
+        std::size_t position = subtable;
+        int file_id = first_file;
+        bool terminated = false;
+        while (position < file_table_size) {
+            const std::uint8_t type = file_table[position];
+            if (type == 0u) {
+                terminated = true;
+                break;
+            }
+            const std::size_t length =
+                static_cast<std::size_t>(type & kNameLengthMask);
+            if (position + 1u + length > file_table_size) {
+                report(NdsNitroFsRule::DirectoryUnterminated, prefix, -1,
+                       "a name runs past the end of the file table");
+                break;
+            }
+            // A zero length with the directory flag set is a directory whose
+            // name is empty: the length byte alone cannot be the terminator,
+            // because that has no flag. Skip the reference so the walk stays
+            // aligned with the stream.
+            if (length == 0u) {
+                report(NdsNitroFsRule::EmptyName, prefix, -1,
+                       "a name entry has no name in it");
+                position += 1u;
+                if ((type & kDirectoryFlag) != 0u) {
+                    if (position + 2u > file_table_size) {
+                        report(NdsNitroFsRule::DirectoryUnterminated, prefix,
+                               -1, "a subdirectory reference is cut short");
+                        break;
+                    }
+                    position += 2u;
+                }
+                if (stopped) break;
+                continue;
+            }
+            const std::string name(
+                reinterpret_cast<const char*>(file_table + position + 1u),
+                length);
+            position += 1u + length;
+            if (!name_is_valid(name)) {
+                const bool is_directory = (type & kDirectoryFlag) != 0u;
+                report(NdsNitroFsRule::InvalidName, prefix + name,
+                       is_directory ? -1 : file_id,
+                       "a name holds a path separator, a colon or an "
+                       "unprintable byte");
+                if (is_directory) {
+                    if (position + 2u > file_table_size) {
+                        report(NdsNitroFsRule::DirectoryUnterminated, prefix,
+                               -1, "a subdirectory reference is cut short");
+                        break;
+                    }
+                    position += 2u;
+                } else {
+                    // The entry still owns a file id. The allocation table is
+                    // indexed by name-table order, so an id skipped here would
+                    // shift every later file onto the wrong bytes -- a silent
+                    // corruption, which is worse than the bad name itself.
+                    ++file_id;
+                }
+                continue;
+            }
+            if ((type & kDirectoryFlag) != 0u) {
+                if (position + 2u > file_table_size) {
+                    report(NdsNitroFsRule::DirectoryUnterminated, prefix, -1,
+                           "a subdirectory reference is cut short");
+                    break;
+                }
+                const std::uint32_t child = static_cast<std::uint32_t>(
+                    read_u16(file_table + position) & kDirectoryIndexMask);
+                position += 2u;
+                children.emplace_back(child, name);
+            } else {
+                add_file(prefix + name, file_id);
+                ++file_id;
+            }
+            if (stopped) break;
+        }
+        if (!terminated && !stopped) {
+            report(NdsNitroFsRule::DirectoryUnterminated, prefix, -1,
+                   "a subtable ran to the end of the file table without its "
+                   "terminator");
+        }
+
+        // Subdirectories are walked depth first, in the order they appeared,
+        // after this directory's own files. Ids come from each directory's
+        // declared first id, so the order is a matter of reporting rather than
+        // of numbering.
+        for (const auto& child : children) {
+            if (stopped) break;
+            walk(child.first, prefix + child.second + "/", depth + 1);
+        }
+        ancestors.pop_back();
+    }
+};
+
+bool host_file_size(const std::string& path, std::uint64_t* size) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file) return false;
+    const std::streamoff length = file.tellg();
+    if (length < 0) return false;
+    *size = static_cast<std::uint64_t>(length);
+    return true;
+}
+
+bool read_host_file(const std::string& path, std::uint64_t size,
+                    std::vector<std::uint8_t>* bytes) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file) return false;
+    bytes->assign(static_cast<std::size_t>(size), 0u);
+    if (size > 0u) {
+        file.read(reinterpret_cast<char*>(bytes->data()),
+                  static_cast<std::streamsize>(size));
+        if (!file) return false;
+    }
+    return true;
+}
+
+void report_override(std::vector<std::string>* diagnostics,
+                     std::string text) {
+    if (diagnostics != nullptr) diagnostics->push_back(std::move(text));
+}
+
+}  // namespace
+
+NdsNitroFs nitrofs_parse(const std::uint8_t* image, std::size_t image_size) {
+    NdsNitroFs result;
+    if (image == nullptr || image_size < kHeaderSize) {
+        add_diagnostic(&result, NdsNitroFsRule::ImageTooSmall, "", -1,
+                       "the image is " + size_text(image_size) +
+                           " bytes, too small to hold a " +
+                           size_text(kHeaderSize) + "-byte header");
+        return result;
+    }
+
+    const std::uint32_t file_table_offset =
+        read_u32(image + kFileTableOffsetField);
+    const std::uint32_t file_table_size =
+        read_u32(image + kFileTableSizeField);
+    const std::uint32_t allocation_offset =
+        read_u32(image + kAllocationOffsetField);
+    const std::uint32_t allocation_size =
+        read_u32(image + kAllocationSizeField);
+
+    // Both tables have to be readable before anything can be listed. A file
+    // whose bytes cannot be located is not a file, so there is nothing useful
+    // to carry forward here.
+    if (file_table_size == 0u) {
+        add_diagnostic(&result, NdsNitroFsRule::FileTableEmpty, "", -1,
+                       "the header says the file name table is empty");
+        return result;
+    }
+    if (!range_is_inside(file_table_offset, file_table_size, image_size)) {
+        add_diagnostic(&result, NdsNitroFsRule::FileTableOutsideImage, "", -1,
+                       "the header places the file name table at " +
+                           hex_text(file_table_offset) + " for " +
+                           size_text(file_table_size) +
+                           " bytes, which leaves the " +
+                           size_text(image_size) + "-byte image");
+        return result;
+    }
+    if (allocation_size == 0u) {
+        add_diagnostic(&result, NdsNitroFsRule::FatEmpty, "", -1,
+                       "the header says the allocation table is empty");
+        return result;
+    }
+    if (allocation_size % kAllocationEntrySize != 0u) {
+        add_diagnostic(&result, NdsNitroFsRule::FatSizeNotMultipleOfEight, "",
+                       -1,
+                       "the allocation table is " + size_text(allocation_size) +
+                           " bytes, which is not a whole number of " +
+                           size_text(kAllocationEntrySize) + "-byte entries");
+        return result;
+    }
+    if (!range_is_inside(allocation_offset, allocation_size, image_size)) {
+        add_diagnostic(&result, NdsNitroFsRule::FatOutsideImage, "", -1,
+                       "the header places the allocation table at " +
+                           hex_text(allocation_offset) + " for " +
+                           size_text(allocation_size) +
+                           " bytes, which leaves the " +
+                           size_text(image_size) + "-byte image");
+        return result;
+    }
+
+    const std::uint8_t* file_table = image + file_table_offset;
+    const std::uint32_t directory_table_size = read_u32(file_table);
+    if (directory_table_size == 0u ||
+        directory_table_size % kDirectoryEntrySize != 0u ||
+        directory_table_size > file_table_size) {
+        add_diagnostic(&result, NdsNitroFsRule::DirectoryTableTruncated, "",
+                       -1,
+                       "the first word of the file table sizes the directory "
+                       "table at " + hex_text(directory_table_size) +
+                           ", which is not a whole number of " +
+                           size_text(kDirectoryEntrySize) +
+                           "-byte entries that fit");
+        return result;
+    }
+
+    Walker walker;
+    walker.image = image;
+    walker.image_size = image_size;
+    walker.file_table = file_table;
+    walker.file_table_size = file_table_size;
+    walker.allocation_offset = allocation_offset;
+    walker.allocation_entries = allocation_size / kAllocationEntrySize;
+    walker.directory_count = directory_table_size / kDirectoryEntrySize;
+    walker.directory_table_size = directory_table_size;
+    walker.result = &result;
+    walker.visited.assign(walker.directory_count, false);
+    walker.walk(0u, std::string(), 0);
+
+    std::sort(result.files.begin(), result.files.end(),
+              [](const NdsNitroFsEntry& left, const NdsNitroFsEntry& right) {
+                  return left.id < right.id;
+              });
+    result.fat_entries = static_cast<int>(walker.allocation_entries);
+    result.ok = result.diagnostics.empty();
+    return result;
+}
+
+bool nitrofs_lookup(const NdsNitroFs& filesystem, const std::string& path,
+                    NdsNitroFsEntry* out) {
+    const std::string wanted = fold_path(path);
+    if (wanted.empty()) return false;
+    for (const NdsNitroFsEntry& entry : filesystem.files) {
+        if (fold(entry.path) != wanted) continue;
+        if (out != nullptr) *out = entry;
+        return true;
+    }
+    return false;
+}
+
+const NdsNitroFsEntry* nitrofs_file_by_id(const NdsNitroFs& filesystem,
+                                          int id) {
+    for (const NdsNitroFsEntry& entry : filesystem.files) {
+        if (entry.id == id) return &entry;
+    }
+    return nullptr;
+}
+
+bool nitrofs_apply_overrides(
+    std::uint8_t* image, std::size_t image_size,
+    const NdsNitroFs& filesystem,
+    const std::vector<std::pair<std::string, std::string>>& path_to_host_file,
+    std::vector<std::string>* diagnostics) {
+    bool applied = true;
+    std::set<std::string> named;
+    for (const auto& pair : path_to_host_file) {
+        const std::string wanted = fold_path(pair.first);
+        if (wanted.empty()) {
+            applied = false;
+            report_override(diagnostics,
+                            "cannot replace \"" + pair.first +
+                                "\": that is not a path a cartridge file can "
+                                "have");
+            continue;
+        }
+        if (!named.insert(wanted).second) {
+            applied = false;
+            report_override(diagnostics,
+                            "cannot replace \"" + pair.first +
+                                "\": it is named more than once, and the "
+                                "first replacement was kept");
+            continue;
+        }
+        NdsNitroFsEntry entry;
+        if (!nitrofs_lookup(filesystem, pair.first, &entry)) {
+            applied = false;
+            report_override(diagnostics,
+                            "cannot replace \"" + pair.first +
+                                "\": the cartridge has no file with that "
+                                "path");
+            continue;
+        }
+        std::uint64_t length = 0;
+        if (!host_file_size(pair.second, &length)) {
+            applied = false;
+            report_override(diagnostics,
+                            "cannot replace \"" + pair.first +
+                                "\" with \"" + pair.second +
+                                "\": the replacement file cannot be read");
+            continue;
+        }
+        if (length > static_cast<std::uint64_t>(entry.size)) {
+            applied = false;
+            report_override(
+                diagnostics,
+                "cannot replace \"" + pair.first + "\" with \"" +
+                    pair.second + "\": the replacement is " +
+                    size_text(length) + " bytes but the cartridge file is " +
+                    size_text(entry.size) +
+                    " bytes, and a replacement may not be longer than the "
+                    "file it replaces");
+            continue;
+        }
+        // The entry came from a parse of this same image, so its range was
+        // already checked there; this repeats the check because a caller may
+        // hand over a smaller buffer than the one that was parsed.
+        const std::uint64_t end =
+            static_cast<std::uint64_t>(entry.offset) + entry.size;
+        if (image == nullptr || end > static_cast<std::uint64_t>(image_size)) {
+            applied = false;
+            report_override(diagnostics,
+                            "cannot replace \"" + pair.first +
+                                "\": the file's bytes lie outside a " +
+                                size_text(image_size) + "-byte image");
+            continue;
+        }
+        if (length > 0u) {
+            std::vector<std::uint8_t> bytes;
+            if (!read_host_file(pair.second, length, &bytes)) {
+                applied = false;
+                report_override(diagnostics,
+                                "cannot replace \"" + pair.first +
+                                    "\" with \"" + pair.second +
+                                    "\": the replacement file was read short");
+                continue;
+            }
+            std::memcpy(image + entry.offset, bytes.data(),
+                        bytes.size());
+        }
+        // Everything between the end of the replacement and the end of the
+        // original file keeps the value it had. The allocation table is
+        // untouched, so the file's size never moves and no other file shifts.
+    }
+    return applied;
+}
+
+const char* nitrofs_rule_name(NdsNitroFsRule rule) {
+    switch (rule) {
+        case NdsNitroFsRule::Unknown:
+            return "unknown";
+        case NdsNitroFsRule::ImageTooSmall:
+            return "image_too_small";
+        case NdsNitroFsRule::FileTableOutsideImage:
+            return "file_table_outside_image";
+        case NdsNitroFsRule::FileTableEmpty:
+            return "file_table_empty";
+        case NdsNitroFsRule::DirectoryTableTruncated:
+            return "directory_table_truncated";
+        case NdsNitroFsRule::DirectoryOutsideFileTable:
+            return "directory_outside_file_table";
+        case NdsNitroFsRule::DirectoryUnterminated:
+            return "directory_unterminated";
+        case NdsNitroFsRule::DirectoryCycle:
+            return "directory_cycle";
+        case NdsNitroFsRule::DirectoryRepeated:
+            return "directory_repeated";
+        case NdsNitroFsRule::DirectoryTooDeep:
+            return "directory_too_deep";
+        case NdsNitroFsRule::EmptyName:
+            return "empty_name";
+        case NdsNitroFsRule::InvalidName:
+            return "invalid_name";
+        case NdsNitroFsRule::DuplicatePath:
+            return "duplicate_path";
+        case NdsNitroFsRule::FileIdOutOfRange:
+            return "file_id_out_of_range";
+        case NdsNitroFsRule::DuplicateFileId:
+            return "duplicate_file_id";
+        case NdsNitroFsRule::FatOutsideImage:
+            return "fat_outside_image";
+        case NdsNitroFsRule::FatSizeNotMultipleOfEight:
+            return "fat_size_not_multiple_of_eight";
+        case NdsNitroFsRule::FatEmpty:
+            return "fat_empty";
+        case NdsNitroFsRule::FatEntryOutsideImage:
+            return "fat_entry_outside_image";
+        case NdsNitroFsRule::FatEntryEmpty:
+            return "fat_entry_empty";
+        case NdsNitroFsRule::TooManyFiles:
+            return "too_many_files";
+        case NdsNitroFsRule::TooManyProblems:
+            return "too_many_problems";
+    }
+    return "unknown";
+}
+
+std::string nitrofs_diagnostic_text(const NdsNitroFsDiagnostic& diagnostic) {
+    std::string text = nitrofs_rule_name(diagnostic.rule);
+    text += ": ";
+    text += diagnostic.detail;
+    if (!diagnostic.path.empty() || diagnostic.id >= 0) {
+        text += " (";
+        if (!diagnostic.path.empty()) text += diagnostic.path;
+        if (diagnostic.id >= 0) {
+            if (!diagnostic.path.empty()) text += ", ";
+            text += "id ";
+            text += std::to_string(diagnostic.id);
+        }
+        text += ')';
+    }
+    return text;
+}
+
+}  // namespace nds_nitrofs
diff --git a/runner/src/nitrofs.h b/runner/src/nitrofs.h
new file mode 100644
index 0000000..1e127dc
--- /dev/null
+++ b/runner/src/nitrofs.h
@@ -0,0 +1,188 @@
+// nitrofs.h -- the cartridge file table, and mod overrides that fit in it.
+//
+// A Nintendo DS cartridge with a filesystem carries two tables named in its
+// header. The file name table (FNT) is a directory tree of names; the file
+// allocation table (FAT) maps a small integer -- the file id -- to a byte
+// range in the image. The game itself never asks for a name: its own code
+// decides on an id, looks it up in the FAT, and reads those bytes through the
+// cartridge protocol.
+//
+// That is what makes file mods possible without touching the read path. The
+// emulated machine sees the cartridge as one flat buffer addressed by byte
+// offset (the runner copies the whole ROM into `g_card_rom` at load and serves
+// guest reads out of it), so replacing a file is a matter of copying new bytes
+// over the old ones at the FAT's offset. Nothing in the guest, and nothing in
+// the emulator's cartridge code, has to know.
+//
+// This module is that copy, plus enough of a NitroFS reader to know where the
+// bytes are. It reads a caller-supplied image. It never opens the cartridge,
+// never prints, never throws, and keeps no state, so it is safe to call from
+// startup code that must not fail: a malformed table is expected input here,
+// because a player who edits a ROM can break it. Every refusal is reported as
+// a diagnostic on the result, and a tree that is only partly readable still
+// yields the entries that were sound.
+//
+// The override rule is strict on purpose. The FAT is not the only thing that
+// knows a file's size -- the game's own code has sizes compiled in, and the
+// archive formats inside these files carry their own offsets -- so a
+// replacement that changes the file's length corrupts whatever comes after
+// it. A replacement may therefore be SHORTER than the original, never longer.
+// The bytes past the end of the replacement keep their previous value.
+//
+// File ids are NOT assumed to start at zero in the FNT. On a real cartridge
+// the first few ids can belong to something else entirely: in the shipping
+// Digimon Story cartridge the ARM9 overlays occupy ids 0..5 and the first
+// named file is id 6. So each directory's declared first id is treated as
+// authoritative and merely validated (unique, inside the FAT) rather than
+// recomputed by counting from zero.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace nds_nitrofs {
+
+// What was wrong with the table. Every value has a stable lowercase token from
+// nitrofs_rule_name(), so a test or a log line can name the problem without
+// matching on the sentence.
+enum class NdsNitroFsRule : int {
+    Unknown = 0,
+    // The image is too small to hold a DS header at all.
+    ImageTooSmall,
+    // The header's FNT offset/size does not lie inside the image.
+    FileTableOutsideImage,
+    // The header says the FNT is empty.
+    FileTableEmpty,
+    // A directory's subtable offset points inside the directory table.
+    DirectoryTableTruncated,
+    // A subtable offset points past the end of the FNT.
+    DirectoryOutsideFileTable,
+    // A subtable ran to the end of the FNT without its terminator.
+    DirectoryUnterminated,
+    // A subdirectory is its own ancestor.
+    DirectoryCycle,
+    // The same subdirectory is reachable from two places in the tree.
+    DirectoryRepeated,
+    // Nesting deeper than kNdsNitroFsMaxDepth.
+    DirectoryTooDeep,
+    // A name of length zero.
+    EmptyName,
+    // A name containing a path separator or a control byte. The entry is not
+    // listed, but it still owns its file id, so the files after it keep the
+    // ids the allocation table gives them.
+    InvalidName,
+    // Two entries whose names fold to the same path.
+    DuplicatePath,
+    // A file id that the FAT does not have an entry for.
+    FileIdOutOfRange,
+    // Two named files claiming the same id, so one of them is not addressable.
+    DuplicateFileId,
+    // The header's FAT offset/size does not lie inside the image.
+    FatOutsideImage,
+    // The FAT size is not a whole number of eight-byte entries.
+    FatSizeNotMultipleOfEight,
+    // The FAT has no entries, so no file can be read.
+    FatEmpty,
+    // A file's byte range leaves the image.
+    FatEntryOutsideImage,
+    // A file's start offset is past its end offset.
+    FatEntryEmpty,
+    // More files than the module will carry.
+    TooManyFiles,
+    // More diagnostics than the module will carry; the tail was dropped.
+    TooManyProblems,
+};
+
+// Upper bounds. A real cartridge is far below all of these; they exist so that
+// a hostile or corrupted image cannot make the parser allocate without limit.
+constexpr int kNdsNitroFsMaxDepth = 32;
+constexpr int kNdsNitroFsMaxFiles = 65536;
+// At most this many ordinary diagnostics; a single TooManyProblems notice may
+// follow the last one, so a result never holds more than the cap plus one.
+constexpr int kNdsNitroFsMaxDiagnostics = 256;
+
+// One file the FNT named. `path` uses '/' between components, carries the
+// case the cartridge used, and has no leading slash: a file in the root
+// directory is just "TOUCH.BIN", a file in a subdirectory is
+// "MSG/MESPAK00.PAK".
+struct NdsNitroFsEntry {
+    std::string path;
+    int id = 0;
+    uint32_t offset = 0;  // into the image
+    uint32_t size = 0;
+};
+
+struct NdsNitroFsDiagnostic {
+    NdsNitroFsRule rule = NdsNitroFsRule::Unknown;
+    std::string path;  // the entry concerned, or "" when none is
+    int id = -1;       // the file id concerned, or -1 when none is
+    std::string detail;
+};
+
+struct NdsNitroFs {
+    // Sorted by file id ascending, so a dump is stable across runs.
+    std::vector<NdsNitroFsEntry> files;
+    std::vector<NdsNitroFsDiagnostic> diagnostics;
+    int fat_entries = 0;
+    int directories = 0;
+    // True only when the whole tree walked with no diagnostic at all.
+    bool ok = false;
+
+    // Note: `files` can be smaller than `fat_entries` on a healthy cartridge
+    // and that is not a fault. Ids with no name entry are reached by something
+    // other than the FNT -- the ARM9 overlay table is the usual example -- and
+    // this module deliberately does not call that a problem.
+};
+
+// Read the FNT/FAT of an image and return everything it named. Never throws;
+// on a refusal the result carries diagnostics and `ok` is false, and any files
+// found before the refusal are still listed.
+NdsNitroFs nitrofs_parse(const uint8_t* image, size_t image_size);
+
+// Find one file by path. The match is case-insensitive per ASCII byte and
+// tolerates one leading '/'. A path containing a '\\', a ':' or a ".."
+// component is refused rather than resolved, because a mod manifest that asks
+// to leave the pack is a mistake and not a path to squash. `out` may be null
+// when only the answer matters. Returns false and leaves `out` untouched when
+// there is no such file.
+bool nitrofs_lookup(const NdsNitroFs& filesystem, const std::string& path,
+                    NdsNitroFsEntry* out);
+
+// Find one file by its id, for content the FNT does not name (overlays, most
+// often). Returns nullptr when the id has no name entry.
+const NdsNitroFsEntry* nitrofs_file_by_id(const NdsNitroFs& filesystem,
+                                          int id);
+
+// Copy each host file over the cartridge file it is named for. `pairs` holds
+// (game path, host file path) in the order the caller wants them tried.
+//
+// A replacement is written at the file's offset and must not be longer than
+// the original; a longer one is refused with a diagnostic that names both
+// sizes, and the image is left alone. Bytes between the end of the replacement
+// and the end of the original file keep their previous value, so the file's
+// size in the FAT never moves.
+//
+// Refuses, with a diagnostic each, an unknown game path, a host file that
+// cannot be read, a replacement that would grow the file, and a game path
+// named twice (the second is refused, the first is kept). Diagnostics are
+// human-readable sentences appended to `diagnostics` when it is not null.
+//
+// Returns true only when every pair was applied. Never throws.
+bool nitrofs_apply_overrides(
+    uint8_t* image, size_t image_size, const NdsNitroFs& filesystem,
+    const std::vector<std::pair<std::string, std::string>>& path_to_host_file,
+    std::vector<std::string>* diagnostics);
+
+// Stable lowercase token for a rule ("directory_cycle", "fat_entry_empty",
+// ...). Returns "unknown" for a value outside the enum, never null.
+const char* nitrofs_rule_name(NdsNitroFsRule rule);
+
+// One diagnostic rendered for a log or a launcher pane, e.g.
+// `directory_cycle: MSG/ is reachable from itself (MSG)`. Never empty.
+std::string nitrofs_diagnostic_text(const NdsNitroFsDiagnostic& diagnostic);
+
+}  // namespace nds_nitrofs
diff --git a/runner/src/screen_layouts.cpp b/runner/src/screen_layouts.cpp
new file mode 100644
index 0000000..473e4a9
--- /dev/null
+++ b/runner/src/screen_layouts.cpp
@@ -0,0 +1,262 @@
+#include "screen_layouts.h"
+
+namespace nds_screen_layout {
+namespace {
+
+// The arrangement each layout asks for, in native pixels: a grid of cells, each
+// cell one picture tall and wide enough to hold it, except kSquare whose cells
+// are square tiles with the picture centred inside.
+//
+//   stacked       1 column  x 2 rows, cell 256x192 -> block 256x384
+//   side-by-side  2 columns x 1 row,  cell 256x192 -> block 512x192
+//   top / bottom  1 column  x 1 row,  cell 256x192 -> block 256x192
+//   square        2 columns x 1 row,  cell 256x256 -> block 512x256
+//
+// Stating the shape as data rather than as five branches is what keeps the five
+// layouts consistent: every one goes through the same scale, centring and
+// placement arithmetic, so a rule that holds for one holds for all five and the
+// tests can sweep all of them with one invariant checker.
+struct LayoutShape {
+    int columns;
+    int rows;
+    int cell_height;  // native cell box height: 192, or 256 for square
+};
+
+constexpr LayoutShape kShapes[kNdsLayoutKindCount] = {
+    {1, 2, kNativeScreenHeight},  // kNdsLayoutStacked
+    {2, 1, kNativeScreenHeight},  // kNdsLayoutSideBySide
+    {1, 1, kNativeScreenHeight},  // kNdsLayoutTopOnly
+    {1, 1, kNativeScreenHeight},  // kNdsLayoutBottomOnly
+    {2, 1, kNativeScreenWidth},   // kNdsLayoutSquare: a 256x256 tile per screen
+};
+
+// Totality is a contract, not politeness: the caller hands this whatever an
+// out-of-date settings file or a stale command line held, so an out-of-range
+// kind must land on a real shape instead of reading past the table. Stacked is
+// the fallback because it is the shipped default, and because a wrong guess
+// about which screen is where is less surprising than an uninitialised
+// rectangle.
+int shape_index(NdsScreenLayoutKind kind) {
+    const int index = static_cast<int>(kind);
+    if (index < 0 || index >= static_cast<int>(kNdsLayoutKindCount)) {
+        return static_cast<int>(kNdsLayoutStacked);
+    }
+    return index;
+}
+
+bool shape_is_single_window(int index) {
+    return index == static_cast<int>(kNdsLayoutTopOnly) ||
+           index == static_cast<int>(kNdsLayoutBottomOnly);
+}
+
+// A refused canvas: every field the contract calls "zero when invalid" is zero
+// because the aggregate is value-initialised. The canvas echo is still filled
+// in, so the caller can log what was asked for.
+NdsScreenLayoutResult invalid_result(int canvas_width, int canvas_height) {
+    NdsScreenLayoutResult result{};
+    result.canvas_width = canvas_width;
+    result.canvas_height = canvas_height;
+    return result;
+}
+
+// ASCII case folding for the layout tokens. The names are pure ASCII, so
+// <cctype>'s locale-dependent tolower (and its signed-char pitfall) is both
+// unnecessary and a source of surprises in a non-English locale.
+bool equals_ignoring_case(const char* text, const char* lower_case) {
+    while (*text != '\0' && *lower_case != '\0') {
+        char folded = *text;
+        if (folded >= 'A' && folded <= 'Z') {
+            folded = static_cast<char>(folded - 'A' + 'a');
+        }
+        if (folded != *lower_case) return false;
+        ++text;
+        ++lower_case;
+    }
+    return *text == '\0' && *lower_case == '\0';
+}
+
+}  // namespace
+
+const char* layout_name(NdsScreenLayoutKind kind) {
+    switch (shape_index(kind)) {
+        case kNdsLayoutStacked:
+            return "stacked";
+        case kNdsLayoutSideBySide:
+            return "side-by-side";
+        case kNdsLayoutTopOnly:
+            return "top";
+        case kNdsLayoutBottomOnly:
+            return "bottom";
+        case kNdsLayoutSquare:
+            return "square";
+        default:
+            // Unreachable: shape_index() has already folded every other value
+            // onto stacked. Kept so the function is total by construction.
+            return "stacked";
+    }
+}
+
+bool layout_parse(const char* text, NdsScreenLayoutKind* out) {
+    if (text == nullptr || out == nullptr) return false;
+
+    struct Token {
+        const char* text;
+        NdsScreenLayoutKind kind;
+    };
+    constexpr Token kTokens[] = {
+        {"stacked", kNdsLayoutStacked},
+        {"side-by-side", kNdsLayoutSideBySide},
+        // The two aliases a hand-written config file is likely to contain: the
+        // hyphen is easy to lose, and an underscore is the common stand-in.
+        {"sidebyside", kNdsLayoutSideBySide},
+        {"side_by_side", kNdsLayoutSideBySide},
+        {"top", kNdsLayoutTopOnly},
+        {"bottom", kNdsLayoutBottomOnly},
+        {"square", kNdsLayoutSquare},
+    };
+
+    for (const Token& token : kTokens) {
+        if (equals_ignoring_case(text, token.text)) {
+            *out = token.kind;
+            return true;
+        }
+    }
+    // *out is deliberately untouched on failure: the caller keeps whatever it
+    // had, so a rejected token in a settings file cannot reset the layout.
+    return false;
+}
+
+bool layout_is_single_window(NdsScreenLayoutKind kind) {
+    return shape_is_single_window(shape_index(kind));
+}
+
+bool layout_min_canvas(NdsScreenLayoutKind kind, int* width, int* height) {
+    if (width == nullptr || height == nullptr) return false;
+    const LayoutShape& shape = kShapes[shape_index(kind)];
+    *width = shape.columns * kNativeScreenWidth;
+    *height = shape.rows * shape.cell_height;
+    return true;
+}
+
+NdsScreenLayoutResult compute_layout(NdsScreenLayoutKind kind, int canvas_width,
+                                     int canvas_height, bool integer_scale,
+                                     bool swap_screens) {
+    const int index = shape_index(kind);
+
+    // A canvas is a request, not a promise: refuse anything that cannot be
+    // satisfied instead of squeezing it into a rectangle with a non-positive or
+    // off-canvas extent.
+    if (canvas_width <= 0 || canvas_height <= 0 ||
+        canvas_width > kMaxCanvasDimension ||
+        canvas_height > kMaxCanvasDimension) {
+        return invalid_result(canvas_width, canvas_height);
+    }
+
+    const LayoutShape& shape = kShapes[index];
+    const int native_block_w = shape.columns * kNativeScreenWidth;
+    const int native_block_h = shape.rows * shape.cell_height;
+
+    // The largest whole scale that fits, in both directions at once. This is
+    // also the floor of the fractional scale, so a valid canvas has
+    // native_scale >= 1 either way and the two modes agree on what fits.
+    const int whole_scale_w = canvas_width / native_block_w;
+    const int whole_scale_h = canvas_height / native_block_h;
+    const int native_scale =
+        whole_scale_w < whole_scale_h ? whole_scale_w : whole_scale_h;
+    if (native_scale < 1) return invalid_result(canvas_width, canvas_height);
+
+    int cell_box_width = 0;
+    int cell_box_height = 0;
+    if (integer_scale) {
+        cell_box_width = native_scale * kNativeScreenWidth;
+        cell_box_height = native_scale * shape.cell_height;
+    } else {
+        // Whichever direction runs out first decides the scale; the other one
+        // then follows the cell's aspect ratio. Comparing the two ratios
+        // cross-multiplied keeps this in exact integer arithmetic -- no double,
+        // no chance of the platforms disagreeing on a rounding.
+        //
+        // Both dimensions are floored, never rounded: a floor is the largest
+        // extent that provably stays inside the canvas, so an awkward canvas
+        // cannot gain the half pixel that rounding up would add.
+        const bool width_limited =
+            canvas_width * native_block_h <= canvas_height * native_block_w;
+        const int gain = width_limited ? canvas_width : canvas_height;
+        const int native_block =
+            width_limited ? native_block_w : native_block_h;
+        cell_box_width = kNativeScreenWidth * gain / native_block;
+        cell_box_height = shape.cell_height * gain / native_block;
+    }
+
+    // kSquare's cell box is taller than the picture it holds; that extra height
+    // is what makes kSquare respect a square footprint when it picks its scale.
+    // The cell box is a scale reference only: what is placed is the picture, so
+    // the tile padding must not shift it. For every other layout
+    // cell_height == kNativeScreenHeight and the two are the same size.
+    const int picture_width = cell_box_width;
+    const int picture_height =
+        cell_box_height * kNativeScreenHeight / shape.cell_height;
+
+    // Centring is computed from the pictures, not from the cell boxes: centring
+    // the cells and then centring each picture inside its cell would compound
+    // two one-pixel roundings into a two-pixel lopsidedness on an awkward
+    // canvas, which is exactly what the contract forbids.
+    const int used_width = shape.columns * picture_width;
+    const int used_height = shape.rows * picture_height;
+
+    // Integer division truncates, so an odd leftover hands the extra pixel to
+    // the right/bottom side: half the slack, rounded down, on the left/top.
+    const int origin_x = (canvas_width - used_width) / 2;
+    const int origin_y = (canvas_height - used_height) / 2;
+
+    // Position order, not screen order: cells[0] is the first cell of the
+    // arrangement (upper for a vertical block, leftmost for a horizontal one)
+    // and cells[1] the second. Pictures are laid out edge to edge on their own
+    // pitch -- a picture never overlaps its neighbour, whatever the cell box it
+    // was scaled against.
+    NdsScreenRect cells[2] = {{0, 0, 0, 0}, {0, 0, 0, 0}};
+    const int cell_count = shape_is_single_window(index) ? 1 : 2;
+    for (int slot = 0; slot < cell_count; ++slot) {
+        const int column = shape.columns > 1 ? slot : 0;
+        const int row = shape.columns > 1 ? 0 : slot;
+        cells[slot].x = origin_x + column * picture_width;
+        cells[slot].y = origin_y + row * picture_height;
+        cells[slot].width = picture_width;
+        cells[slot].height = picture_height;
+    }
+
+    NdsScreenLayoutResult result{};
+    result.canvas_width = canvas_width;
+    result.canvas_height = canvas_height;
+    result.native_scale = native_scale;
+    result.valid = true;
+
+    if (index == static_cast<int>(kNdsLayoutTopOnly)) {
+        // Single-window layouts leave the other rectangle empty (all zeros,
+        // straight from the aggregate initialiser) and ignore swap_screens:
+        // exchanging one screen with nothing would silently change which screen
+        // is on show.
+        result.rects[kNdsScreenTop] = cells[0];
+    } else if (index == static_cast<int>(kNdsLayoutBottomOnly)) {
+        result.rects[kNdsScreenBottom] = cells[0];
+    } else if (swap_screens) {
+        result.rects[kNdsScreenTop] = cells[1];
+        result.rects[kNdsScreenBottom] = cells[0];
+    } else {
+        result.rects[kNdsScreenTop] = cells[0];
+        result.rects[kNdsScreenBottom] = cells[1];
+    }
+
+    // Recomputed from the rectangles rather than from the block, so the field
+    // cannot drift away from the geometry it describes: kSquare's tile padding
+    // then counts as unused, exactly like letterboxing does.
+    int used_area = 0;
+    for (int slot = 0; slot < 2; ++slot) {
+        used_area += result.rects[slot].width * result.rects[slot].height;
+    }
+    result.unused_canvas_pixels = canvas_width * canvas_height - used_area;
+
+    return result;
+}
+
+}  // namespace nds_screen_layout
diff --git a/runner/src/screen_layouts.h b/runner/src/screen_layouts.h
new file mode 100644
index 0000000..991e0b6
--- /dev/null
+++ b/runner/src/screen_layouts.h
@@ -0,0 +1,156 @@
+#pragma once
+
+// Host-side screen layout geometry for the dual-screen DS image: given a host
+// canvas, where does each 256x192 screen's rectangle go, and at what scale?
+//
+// The frontend used to compute this inline, which is why it is now a module:
+// the arithmetic is easy to get subtly wrong (an aspect ratio broken by a
+// rounding, a pair of rectangles that overlaps on a small canvas, a letterbox
+// off by one) and a wrong answer still looks like a picture, just a squashed or
+// clipped one. Pure integer geometry in, geometry out -- no SDL, no renderer,
+// no I/O, no globals, no allocation.
+//
+// Rectangles are addressed by SCREEN SLOT, not by position:
+// rects[kNdsScreenTop] is where the DS top screen must be drawn and
+// rects[kNdsScreenBottom] where the bottom screen must be drawn, whatever order
+// the layout puts them in. That is the only mapping the presenter needs, and it
+// makes swap_screens observable without a second table.
+//
+// Each layout is a grid of CELLS. For every layout except kSquare a cell is the
+// 256x192 picture itself. kSquare's cells are 256x256 tiles, and the tile is a
+// SCALE REFERENCE ONLY: it decides how large the block may grow, so a square
+// layout stays square-footed, but what is placed is always the 256x192 picture,
+// scaled to the tile's width and 3/4 of its height, laid out picture to picture
+// and centred by its own extent. That distinction is load-bearing: centring the
+// tiles and then centring each picture inside its tile rounds twice, and two
+// truncations in the same direction leave up to three pixels more slack on one
+// side than the other, which the contract below forbids. kSquare's tile padding
+// is still counted as unused canvas, exactly like letterboxing.
+//
+// Contract for a valid result:
+//   * every non-empty rectangle lies fully inside the canvas: 0 <= x,
+//     x + width <= canvas_width, and the same vertically;
+//   * the two rectangles never overlap;
+//   * the arrangement is centred: the free space to the left and right of the
+//     used block differs by at most one pixel, and likewise above and below,
+//     and the odd pixel goes to the right/bottom;
+//   * each rectangle keeps the 256:192 (4:3) aspect ratio exactly when
+//     integer_scale is set, and to within one pixel otherwise, i.e.
+//     -3 <= 4 * height - 3 * width <= 2;
+//   * unused_canvas_pixels is canvas_width * canvas_height minus the area of
+//     the rectangles actually used, so it is 0 for a layout that tiles the
+//     canvas exactly and grows with the letterboxing/pillarboxing left over.
+namespace nds_screen_layout {
+
+// Both DS screens are 256x192. Every rectangle below is a whole-pixel window
+// into a canvas, so a whole-number scale s is a 256*s by 192*s rectangle.
+constexpr int kNativeScreenWidth = 256;
+constexpr int kNativeScreenHeight = 192;
+
+// Largest canvas dimension accepted. It keeps canvas_width * canvas_height,
+// every rectangle coordinate and unused_canvas_pixels inside int with room to
+// spare (16384 * 16384 == 268435456), so no caller-supplied canvas can overflow
+// the geometry. Larger requests are rejected rather than clamped.
+constexpr int kMaxCanvasDimension = 16384;
+
+// The two physical screens, in the order the firmware presents them. Used to
+// index NdsScreenLayoutResult::rects.
+//
+// Both enums name their underlying type: the API is total, so an out-of-range
+// value is a supported input rather than undefined behaviour, and saying so in
+// the declaration makes that visible at the call site.
+enum NdsScreenSlot : int {
+    kNdsScreenTop = 0,
+    kNdsScreenBottom = 1
+};
+
+// Layout names, spelled exactly as layout_name() returns them and as the
+// settings file spells them: "stacked", "side-by-side", "top", "bottom",
+// "square". An out-of-range value is not an error: every entry point falls back
+// to kNdsLayoutStacked, the shipped default, so a hand-edited settings value
+// cannot produce an uninitialised rectangle or index off the end of a table.
+enum NdsScreenLayoutKind : int {
+    kNdsLayoutStacked = 0,     // top above bottom; the shipped default
+    kNdsLayoutSideBySide = 1,  // left/right, adjacent; fits a wide window
+    kNdsLayoutTopOnly = 2,     // the top screen alone
+    kNdsLayoutBottomOnly = 3,  // the bottom screen alone
+    kNdsLayoutSquare = 4,      // two screens, one square tile each, side by
+                               // side
+    kNdsLayoutKindCount = 5
+};
+
+// A rectangle in canvas pixels. width and height are never negative in a valid
+// result, and an unused rectangle is all zeros.
+struct NdsScreenRect {
+    int x;
+    int y;
+    int width;
+    int height;
+};
+
+struct NdsScreenLayoutResult {
+    // Indexed by NdsScreenSlot: rects[kNdsScreenTop] is the top screen's
+    // destination. An unused slot is all zeros.
+    NdsScreenRect rects[2];
+    int canvas_width;   // echoes the request, valid or not
+    int canvas_height;
+    // The whole-number scale that fits: the scale actually applied when
+    // integer_scale is set, and the floor of the fractional scale otherwise
+    // (i.e. "fits at least Nx"). At least 1 whenever valid is true, 0 when it
+    // is false.
+    int native_scale;
+    // Canvas pixels no rectangle covers: the letterbox/pillarbox area, plus the
+    // square layout's tile padding. Zero when the layout tiles the canvas
+    // exactly, and zero when valid is false.
+    int unused_canvas_pixels;
+    bool valid;
+};
+
+// Canonical name, or "stacked" for an out-of-range kind. Never returns nullptr.
+const char* layout_name(NdsScreenLayoutKind kind);
+
+// Parses a layout token into *out. Case-insensitive, and accepts the five
+// canonical names plus "sidebyside" and "side_by_side" as aliases for
+// "side-by-side". Returns false -- leaving *out untouched -- for a null
+// pointer, an empty string or an unrecognised token. There is no whitespace
+// trimming: the token is what the settings file or the command line already
+// handed over.
+bool layout_parse(const char* text, NdsScreenLayoutKind* out);
+
+// True for the layouts that present exactly one screen and therefore need one
+// output window instead of two. Out-of-range kinds behave as stacked (false).
+bool layout_is_single_window(NdsScreenLayoutKind kind);
+
+// Smallest canvas for which compute_layout() returns a valid result for `kind`:
+// the size at which the layout fits at native_scale 1 (256x384 stacked, 512x192
+// side-by-side, 256x192 top/bottom, 512x256 square). Returns false when either
+// out pointer is null; out-of-range kinds behave as stacked.
+bool layout_min_canvas(NdsScreenLayoutKind kind, int* width, int* height);
+
+// Computes the geometry for `kind` on a canvas_width by canvas_height canvas.
+//
+// integer_scale: when true each screen is an exact whole multiple of 256x192
+// (nearest-neighbour friendly, no shimmering). When false the scale is the
+// fractional ratio that fills the canvas as far as the aspect ratio allows,
+// each rectangle being floored to a whole pixel so it can never overflow by
+// the half pixel that rounding up would add.
+//
+// valid is false -- with every rectangle, native_scale and unused_canvas_pixels
+// zeroed -- when the canvas is not positive, exceeds kMaxCanvasDimension, or
+// cannot hold the layout at 1:1 (see layout_min_canvas). A degenerate canvas is
+// never squeezed: a 1x1 or a 200x400 window reports invalid instead of
+// producing a sub-pixel or overflowing rectangle. A valid result always
+// satisfies the contract at the top of this header, for any integer_scale and
+// swap_screens combination.
+//
+// swap_screens exchanges the two DS screens between the two rectangles -- the
+// reference project's F3 key -- and changes nothing else: the canvas echo, the
+// scale, the used area and the leftover pixels are identical either way. It is
+// ignored by the single-screen layouts, where there is only one rectangle to
+// swap into (swapping anyway would silently change which screen is visible
+// rather than rearranging the view).
+NdsScreenLayoutResult compute_layout(NdsScreenLayoutKind kind, int canvas_width,
+                                     int canvas_height, bool integer_scale,
+                                     bool swap_screens);
+
+}  // namespace nds_screen_layout
diff --git a/runner/src/screen_minimap.cpp b/runner/src/screen_minimap.cpp
new file mode 100644
index 0000000..bed0890
--- /dev/null
+++ b/runner/src/screen_minimap.cpp
@@ -0,0 +1,140 @@
+#include "screen_minimap.h"
+
+namespace nds_screen_minimap {
+namespace {
+
+using nds_screen_layout::kMaxCanvasDimension;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::kNdsScreenTop;
+using nds_screen_layout::kNativeScreenHeight;
+using nds_screen_layout::kNativeScreenWidth;
+using nds_screen_layout::NdsScreenRect;
+
+// The refusal of decision 7: every field zero, so a caller that checks visible
+// draws nothing and a caller that forgets draws nothing rather than a
+// half-filled rect over the picture. Value-initialised rather than written out
+// field by field, so a field added later starts refused instead of garbage.
+NdsMinimapLayout refused_layout() {
+    NdsMinimapLayout layout{};
+    return layout;
+}
+
+// True when `picture` is a picture the framework could have produced: a
+// positive extent, coordinates and a size inside kMaxCanvasDimension so no
+// intermediate product can overflow, and a rect that fits inside the geometry's
+// own canvas. Every geometry compute_presentation() returns satisfies all of
+// these; the check exists because a caller may assemble one by hand and the
+// arithmetic below trusts them.
+bool picture_is_placeable(const NdsPresentationGeometry& geometry,
+                          const NdsScreenRect& picture) {
+    if (geometry.canvas_width <= 0 || geometry.canvas_height <= 0) return false;
+    if (geometry.canvas_width > kMaxCanvasDimension ||
+        geometry.canvas_height > kMaxCanvasDimension) {
+        return false;
+    }
+    if (picture.width <= 0 || picture.height <= 0) return false;
+    if (picture.width > kMaxCanvasDimension ||
+        picture.height > kMaxCanvasDimension) {
+        return false;
+    }
+    if (picture.x < 0 || picture.y < 0) return false;
+    if (picture.x + picture.width > geometry.canvas_width) return false;
+    if (picture.y + picture.height > geometry.canvas_height) return false;
+    return true;
+}
+
+// extent * numerator / denominator, rounded to nearest with a half going up.
+// The one derived dimension of the thumbnail goes through this (decision 4).
+// The product cannot overflow: every extent is at most kMaxCanvasDimension and
+// the numerator is at most kNativeScreenWidth (16384 * 256 == 4194304).
+int round_to_nearest(int extent, int numerator, int denominator) {
+    return (extent * numerator + denominator / 2) / denominator;
+}
+
+}  // namespace
+
+NdsMinimapLayout compute_minimap(const NdsPresentationGeometry& geometry) {
+    // Decision 1, in the order the header lists the reasons: a refused
+    // presentation, the two-window mode, and then "exactly one screen is
+    // visible" -- one comparison covers both screens visible and neither.
+    if (!geometry.valid) return refused_layout();
+    if (geometry.separate_windows) return refused_layout();
+    const bool top_is_visible = geometry.visible[kNdsScreenTop];
+    if (top_is_visible == geometry.visible[kNdsScreenBottom]) {
+        return refused_layout();
+    }
+
+    // Decision 2: the inset shows the screen that is NOT visible, which is what
+    // swap_screens already decided when it chose the picture to present. Taking
+    // the answer from the flag rather than from the layout kind is why "top"
+    // with swap -- a geometry whose visible screen is the bottom one -- insets
+    // the top screen.
+    const int shown = top_is_visible ? kNdsScreenTop : kNdsScreenBottom;
+    const int hidden = top_is_visible ? kNdsScreenBottom : kNdsScreenTop;
+
+    // Decision 3 reads the VISIBLE picture's rect, never the hidden one: the
+    // hidden screen's rect is all zeros by construction, so reading it would
+    // refuse every case this module exists for.
+    const NdsScreenRect picture = geometry.screen_rect[shown];
+    if (!picture_is_placeable(geometry, picture)) return refused_layout();
+
+    // Margin: an eighth of the picture's width, floored, never under two
+    // pixels. The floor only binds below a 16-pixel-wide picture, which no
+    // layout produces; it is there so a hand-built geometry cannot put the
+    // thumbnail flush against the edge.
+    int margin = picture.width / kMinimapMarginDivisor;
+    if (margin < kMinMinimapMargin) margin = kMinMinimapMargin;
+
+    // The room left inside the picture once the margin is taken. A picture with
+    // no room at all has nowhere to put a thumbnail: refuse rather than hand
+    // back a rect hanging off its edge.
+    const int available_width = picture.width - margin;
+    const int available_height = picture.height - margin;
+    if (available_width < 1 || available_height < 1) return refused_layout();
+
+    // A third of the picture's width, lifted to the readability floor of 32 --
+    // or to the picture's own width when that is smaller, so the floor can
+    // never grow the thumbnail past the picture it sits in -- and then capped
+    // at the room available. For a 256-wide picture the third is 85, above the
+    // floor and below the cap, so neither rule fires; they exist for hand-built
+    // geometries only.
+    int width = picture.width / kMinimapWidthDivisor;
+    if (width < kMinMinimapWidth) {
+        width = picture.width < kMinMinimapWidth ? picture.width
+                                                 : kMinMinimapWidth;
+    }
+    if (width > available_width) width = available_width;
+
+    // Decision 4: height follows the width at 4:3, rounded to nearest.
+    int height =
+        round_to_nearest(width, kNativeScreenHeight, kNativeScreenWidth);
+
+    // A picture too short for that 4:3 box (again: hand-built only): the height
+    // becomes the limit and the width is re-derived from it, so the thumbnail
+    // shrinks as a 4:3 box instead of turning into a letterbox.
+    if (height > available_height) {
+        height = available_height;
+        width =
+            round_to_nearest(height, kNativeScreenWidth, kNativeScreenHeight);
+    }
+
+    // Decision 3: bottom-right corner, exactly `margin` from each edge. The
+    // offset is measured back from the picture's own far corner and then
+    // shifted into canvas space, so the gap is the margin by construction
+    // rather than by a difference that could round.
+    NdsMinimapLayout layout{};
+    layout.visible = true;
+    layout.screen = hidden;
+    layout.inset = NdsScreenRect{picture.x + picture.width - margin - width,
+                                 picture.y + picture.height - margin - height,
+                                 width, height};
+    // Decision 8: both scales are the fraction of one DS screen the thumbnail
+    // covers, computed as a single exact float divide of two small integers.
+    layout.scale_x =
+        static_cast<float>(width) / static_cast<float>(kNativeScreenWidth);
+    layout.scale_y =
+        static_cast<float>(height) / static_cast<float>(kNativeScreenHeight);
+    return layout;
+}
+
+}  // namespace nds_screen_minimap
diff --git a/runner/src/screen_minimap.h b/runner/src/screen_minimap.h
new file mode 100644
index 0000000..714ffb4
--- /dev/null
+++ b/runner/src/screen_minimap.h
@@ -0,0 +1,188 @@
+#pragma once
+
+// The minimap inset for a one-screen layout.
+//
+// A one-window layout shows one DS screen and hides the other: "top" shows the
+// top picture, "bottom" the bottom one. The Minimap row (display.minimap) draws
+// the hidden screen small in a corner of the visible picture, so a player on
+// "top" still sees their map and a player on "bottom" still sees what the top
+// screen is doing. Two-window mode needs nothing: both screens are already on a
+// display.
+//
+// This is geometry only. It says where the thumbnail goes and which screen it
+// shows; the presenter draws the hidden screen's texture into that rect, the
+// same way it draws the two screens from screen_presentation. No SDL, no
+// textures, no I/O, no globals, no allocation, no printing.
+//
+// The decisions, stated once here so the tests and the frontend cannot drift.
+//
+// 1. WHEN THERE IS NO MINIMAP. visible is false, and the rest of the struct is
+//    zeroed (decision 7), when any of these holds:
+//      * the geometry is not valid -- a refused presentation has no pictures;
+//      * the geometry is the two-window mode (separate_windows): both screens
+//        are already on a display, so an inset would cover one of them with a
+//        copy of the other and no window would benefit;
+//      * both screens are visible, or neither is. Stacked, side-by-side and
+//        square already show both pictures, so a thumbnail there is clutter
+//        over a screen the player can see; the minimap is a one-screen-layout
+//        feature by definition. One comparison covers both cases, because
+//        either way there is no single picture to inset into;
+//      * the VISIBLE picture has no extent (screen_rect width or height <= 0):
+//        there is no picture to put a thumbnail in. In practice this and the
+//        next rule reduce to "the visible picture is under 3 logical pixels in
+//        one axis", which no layout produces; the checks exist so a
+//        hand-assembled geometry gets a refusal instead of a rect climbing out
+//        of a picture it does not fit in;
+//      * the visible picture does not fit inside the geometry's own canvas, or
+//        either extent (picture or canvas) exceeds kMaxCanvasDimension. That
+//        keeps every product in decision 3 inside int: the largest is
+//        kMaxCanvasDimension * 256.
+//    Note which rect the extent rule reads. The HIDDEN screen's rect is all
+//    zeros by construction: screen_presentation zeroes it because the screen is
+//    not drawn, and it stays zeroed here. The thumbnail's source is the hidden
+//    screen's TEXTURE, which the presenter already has, not a canvas rect.
+//    Treating that zero rect as "no picture" would refuse every case this
+//    module exists for, so the rule reads the visible picture, and the tests
+//    pin that a top-only geometry -- whose hidden rect is {0, 0, 0, 0} -- still
+//    gets a minimap.
+//
+// 2. WHICH SCREEN THE INSET SHOWS. Always the screen that is NOT visible, taken
+//    from geometry.visible and never from the layout kind. That distinction is
+//    load-bearing, because swap_screens on a one-screen layout swaps WHICH
+//    SCREEN IS SHOWN (screen_presentation decision 4): "top" with swap shows
+//    the BOTTOM picture, so the inset must show the TOP one. Reading the kind
+//    instead would draw the screen the player is already looking at, which is
+//    the one failure this module exists to prevent. `screen` is a screen slot
+//    in screen_layouts' sense (kNdsScreenTop / kNdsScreenBottom) -- the same
+//    value screen_presentation_hit_test() writes -- so the presenter can index
+//    its texture array with it directly.
+//
+// 3. WHERE IT SITS, AND HOW BIG. Bottom-right corner of the visible picture, in
+//    LOGICAL CANVAS pixels: the same space as screen_presentation's screen_rect
+//    and the same space the presenter's other draw rects are in, because mixing
+//    spaces is how the picture and the inset end up disagreeing.
+//
+//        margin  = the visible picture's width / 8, floored, at least 2
+//        width   = the visible picture's width / 3, then the caps below
+//        height  = width * 192 / 256, rounded to nearest (decision 4)
+//
+//    Why an eighth of the WIDTH, used for the bottom and right edges alike: the
+//    gap is then proportional, so a 16x window does not look cramped while a 1x
+//    window does not lose a tenth of its picture to a border; and at the
+//    smallest picture this module is ever handed (256x192 for one screen at 1x)
+//    it is 32 logical pixels, four DS tiles, so the thumbnail never crowds the
+//    edge. The 2 px floor stops a picture narrower than 16 px from having its
+//    inset touch the border outright.
+//
+//    Why a third for the width: this is a map, not a second screen. A third of
+//    the width is 11% of the visible picture's area -- it reads as an inset --
+//    and it is 85 px at 1x, a third of the DS's own 256, which keeps map detail
+//    legible. Half the width would be 25% of the area and read as a split
+//    screen; a quarter would be too small to see a route in.
+//
+//    Readability floor: if a third would be under kMinMinimapWidth (32), the
+//    inset is lifted to 32, or to the picture's own width when that is smaller
+//    still. For every geometry this module can be asked about the floor never
+//    binds -- a one-screen picture is 256 wide, so a third is 85 -- and it
+//    exists only so a hand-assembled geometry cannot ask for a one-pixel
+//    thumbnail. Where the floor would exceed a third it wins over the "a third"
+//    wording, because a thumbnail nobody can read is not a minimap; the
+//    invariant that never bends is decision 6, staying inside the picture.
+//
+//    Caps: both dimensions are then reduced so the inset plus its margin still
+//    fits inside the picture. Those caps cannot bind for a picture the layout
+//    module produced either (an eighth plus a third is under half the width),
+//    but a caller that assembles a geometry by hand can pass anything, and
+//    "inside the visible rect" is an invariant rather than a hope: if not even
+//    one pixel fits, the answer is a refusal, never a rect climbing out of the
+//    picture.
+//
+// 4. ASPECT. The thumbnail keeps the DS's 4:3 exactly whenever its width is a
+//    multiple of 4 (then width * 3 == height * 4), and otherwise is within one
+//    pixel of it, measured in height pixels because height is the derived
+//    dimension: -1 <= 4 * height - 3 * width <= 2. Rounding to nearest (a half
+//    going up) is what keeps that band one pixel wide and slightly above zero;
+//    flooring instead would bias every thumbnail short and the map would read
+//    as squashed next to the picture it sits on. screen_layouts floors for a
+//    different reason -- there a rect is a promise about the whole canvas -- so
+//    the two rules do not conflict, they answer different questions.
+//    For the pictures this framework actually produces the arithmetic is
+//    exact: 256 -> 85x64 (one pixel over, 4h-3w == 1), 320 -> 106x80 (2),
+//    384 -> 128x96 (0, exact), 448 -> 149x112 (1), 512 -> 170x128 (2).
+//
+// 5. WINDOW SCALE IS INVISIBLE HERE, ON PURPOSE. The inset is reported in
+//    logical canvas pixels and the renderer scales the whole logical surface to
+//    the window (screen_presentation decision 2), so the minimap grows with the
+//    picture for free. compute_minimap() reads only valid, separate_windows,
+//    visible and screen_rect: two geometries that differ only in window_scale
+//    produce the same layout, which the tests pin, because a version that
+//    multiplied by window_scale would put the inset off the picture at every
+//    scale but 1.
+//
+// 6. THE INVARIANTS. For a visible result:
+//      * the inset lies fully inside the VISIBLE picture's rect, and therefore
+//        inside the canvas and inside the window;
+//      * the inset is at most a third of the picture's width wide (modulo the
+//        readability floor of decision 3) and at least one pixel in each axis;
+//      * the gap to the picture's bottom and right edges is exactly `margin`;
+//      * `screen` is the hidden slot and is never the slot that is shown.
+//    The inset deliberately overlaps the visible picture: it is drawn on top of
+//    it. That overlap is the feature, so "does not overlap the picture" is not
+//    an invariant here; "stays inside it" is the one that matters.
+//
+// 7. A REFUSAL IS ALL ZEROS. visible false, screen kNdsScreenTop (a fixed slot
+//    so the whole struct is deterministic, and meaningless unless visible),
+//    inset {0, 0, 0, 0}, scale_x and scale_y 0.0f. A caller that checks visible
+//    never draws; a caller that forgets draws nothing rather than a half-filled
+//    rect over the picture.
+//
+// 8. scale_x AND scale_y ARE DERIVED, NOT STORED. scale_x is exactly
+//    inset.width / 256.0f and scale_y exactly inset.height / 192.0f: the
+//    fraction of one DS screen the thumbnail covers, so a presenter that clamps
+//    or reports can multiply without dividing by an extent it has to trust.
+//    Both are 0.0f exactly when the inset is empty, so nothing can divide by a
+//    zero-size inset.
+//
+// 9. TOTALITY. Every NdsScreenLayoutKind value -- the five layouts, the
+//    two-window value, and integers outside the enum -- returns a well-formed
+//    layout, because compute_minimap() reads the geometry and not the kind. An
+//    out-of-range kind is handled by the same nine rules as any other, and a
+//    two-window geometry refuses by decision 1.
+
+#include "screen_presentation.h"
+
+namespace nds_screen_minimap {
+
+using nds_screen_layout::NdsScreenRect;
+using nds_screen_presentation::NdsPresentationGeometry;
+
+// The layout constants of decision 3. Exposed so the tests and the settings
+// documentation can name the same numbers the implementation uses.
+constexpr int kMinimapMarginDivisor = 8;
+constexpr int kMinimapWidthDivisor = 3;
+constexpr int kMinMinimapMargin = 2;
+constexpr int kMinMinimapWidth = 32;
+
+// Where the thumbnail goes, which screen it shows and how much of one DS screen
+// it covers. Value-initialised, so a caller can write
+// `NdsMinimapLayout layout{};` and get the refusal of decision 7.
+struct NdsMinimapLayout {
+    // False means draw nothing. Everything else in the struct is then zero.
+    bool visible;
+    // The DS screen to draw as the inset: the hidden one, as a screen slot.
+    int screen;
+    // The thumbnail, in LOGICAL CANVAS pixels -- the space screen_rect is in.
+    NdsScreenRect inset;
+    // inset.width / 256.0f and inset.height / 192.0f, exactly (decision 8).
+    float scale_x;
+    float scale_y;
+};
+
+// Places the hidden screen's thumbnail inside the visible picture.
+//
+// Returns the refusal of decision 7 whenever decision 1 lists a reason. The
+// geometry's window sizes and window_scale are not consulted at all (decision
+// 5), so the answer is the same for every window scale of a given layout.
+NdsMinimapLayout compute_minimap(const NdsPresentationGeometry& geometry);
+
+}  // namespace nds_screen_minimap
diff --git a/runner/src/screen_presentation.cpp b/runner/src/screen_presentation.cpp
new file mode 100644
index 0000000..0b97181
--- /dev/null
+++ b/runner/src/screen_presentation.cpp
@@ -0,0 +1,316 @@
+#include "screen_presentation.h"
+
+namespace nds_screen_presentation {
+namespace {
+
+using nds_screen_layout::compute_layout;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::NdsScreenLayoutResult;
+using nds_screen_layout::kNdsScreenTop;
+using nds_screen_layout::kNativeScreenHeight;
+using nds_screen_layout::kNativeScreenWidth;
+using nds_screen_layout::layout_min_canvas;
+using nds_screen_layout::NdsScreenRect;
+
+// A refused request. Value-initialised, so every window size, logical size,
+// rect, visibility flag and the two mode flags are zero: a caller that ignores
+// valid gets an empty window it cannot mistake for a picture.
+NdsPresentationGeometry refused() {
+    NdsPresentationGeometry geometry{};
+    return geometry;
+}
+
+bool is_layout_kind(int value) {
+    return value >= 0 && value < static_cast<int>(kNdsLayoutKindCount);
+}
+
+// The screen a single-screen layout shows, after swap_screens has done its
+// job: the F3 key promises "swap what I am looking at", and on top-only or
+// bottom-only the only thing there is to swap is which screen is shown.
+NdsScreenLayoutKind shown_single_screen(NdsScreenLayoutKind kind,
+                                       bool swap_screens) {
+    if (swap_screens) {
+        if (kind == kNdsLayoutTopOnly) return kNdsLayoutBottomOnly;
+        if (kind == kNdsLayoutBottomOnly) return kNdsLayoutTopOnly;
+    }
+    return kind;
+}
+
+// Widens the top screen's picture to adaptive_width, keeping the bottom screen
+// 256 wide and centred in the widened canvas.
+//
+// This is the one piece of geometry this module derives itself rather than
+// taking from compute_layout(), and the reason is a contract, not an
+// oversight: compute_layout() guarantees every picture keeps the native 4:3
+// aspect at an integer scale, and a widescreen picture is exactly the thing
+// that breaks that promise. compute_layout(kNdsLayoutStacked, 384, 384, ...)
+// would report 256x192 pictures centred at x = 64, never a 384x192 one, so
+// there is no canvas it could be asked for that yields the widening.
+//
+// The top picture is widened wherever swap_screens has put it, so a swapped
+// widescreen layout keeps its wide picture on the top SCREEN and not on the
+// top half of the canvas. Widths stay even (enforced by the caller), which is
+// what makes the bottom picture's centring (adaptive - 256) / 2 exact.
+void widen_top_picture(int adaptive_width,
+                       NdsPresentationGeometry* geometry) {
+    const NdsScreenRect top = geometry->screen_rect[kNdsScreenTop];
+    const NdsScreenRect bottom = geometry->screen_rect[kNdsScreenBottom];
+    const int margin = (adaptive_width - kNativeScreenWidth) / 2;
+    geometry->screen_rect[kNdsScreenTop] =
+        NdsScreenRect{0, top.y, adaptive_width, top.height};
+    geometry->screen_rect[kNdsScreenBottom] =
+        NdsScreenRect{margin, bottom.y, kNativeScreenWidth, bottom.height};
+    geometry->canvas_width = adaptive_width;
+}
+
+// The one-window half of compute_presentation(): a layout drawn into its own
+// native canvas at 1:1, with the window an exact multiple of that canvas.
+NdsPresentationGeometry layout_geometry(NdsScreenLayoutKind kind,
+                                        int window_scale,
+                                        int adaptive_width,
+                                        bool swap_screens) {
+    const NdsScreenLayoutKind shown = shown_single_screen(kind, swap_screens);
+    // Single-screen layouts have already had their swap folded into `shown`,
+    // so only the two-screen layouts still have rects to exchange.
+    const bool exchange = swap_screens && (shown == kind);
+    // The native canvas: the smallest canvas the layout fits at 1:1, which is
+    // what makes the logical surface exactly the DS pixels with no scaling.
+    int canvas_width = 0;
+    int canvas_height = 0;
+    if (!layout_min_canvas(shown, &canvas_width, &canvas_height)) {
+        return refused();
+    }
+    const NdsScreenLayoutResult placed =
+        compute_layout(shown, canvas_width, canvas_height, true, exchange);
+    if (!placed.valid) {
+        return refused();
+    }
+
+    NdsPresentationGeometry geometry{};
+    geometry.canvas_width = placed.canvas_width;
+    geometry.canvas_height = placed.canvas_height;
+    geometry.screen_rect[kNdsScreenTop] = placed.rects[kNdsScreenTop];
+    geometry.screen_rect[kNdsScreenBottom] = placed.rects[kNdsScreenBottom];
+    geometry.visible[kNdsScreenTop] =
+        geometry.screen_rect[kNdsScreenTop].width > 0 &&
+        geometry.screen_rect[kNdsScreenTop].height > 0;
+    geometry.visible[kNdsScreenBottom] =
+        geometry.screen_rect[kNdsScreenBottom].width > 0 &&
+        geometry.screen_rect[kNdsScreenBottom].height > 0;
+    if (adaptive_width != 0) {
+        widen_top_picture(adaptive_width, &geometry);
+    }
+    geometry.window_count = 1;
+    geometry.separate_windows = false;
+    geometry.logical_width[0] = geometry.canvas_width;
+    geometry.logical_height[0] = geometry.canvas_height;
+    // Decision 2: the window is an exact multiple of the logical surface, so
+    // the window manager never invents a fractional scale.
+    geometry.window_width[0] = geometry.canvas_width * window_scale;
+    geometry.window_height[0] = geometry.canvas_height * window_scale;
+    geometry.valid = true;
+    return geometry;
+}
+
+// The two-window half: one 256x192 surface per window, each showing one screen.
+NdsPresentationGeometry separate_geometry(int window_scale) {
+    NdsPresentationGeometry geometry{};
+    geometry.canvas_width = kNativeScreenWidth;
+    geometry.canvas_height = kNativeScreenHeight;
+    for (int index = 0; index < 2; ++index) {
+        geometry.logical_width[index] = kNativeScreenWidth;
+        geometry.logical_height[index] = kNativeScreenHeight;
+        geometry.window_width[index] = kNativeScreenWidth * window_scale;
+        geometry.window_height[index] = kNativeScreenHeight * window_scale;
+        // Indexed by screen slot, which in this mode is also the window that
+        // shows it: one screen fills its window edge to edge, no margin.
+        geometry.screen_rect[index] =
+            NdsScreenRect{0, 0, kNativeScreenWidth, kNativeScreenHeight};
+        geometry.visible[index] = true;
+    }
+    geometry.window_count = 2;
+    geometry.separate_windows = true;
+    geometry.valid = true;
+    return geometry;
+}
+
+bool point_in_rect(const NdsScreenRect& rect, double x, double y) {
+    if (rect.width <= 0 || rect.height <= 0) {
+        return false;
+    }
+    return x >= static_cast<double>(rect.x) &&
+           x < static_cast<double>(rect.x) + rect.width &&
+           y >= static_cast<double>(rect.y) &&
+           y < static_cast<double>(rect.y) + rect.height;
+}
+
+// Window space to logical canvas space. The two differ by exactly the integer
+// window_scale from decision 2, but dividing by the ratio rather than by a
+// remembered scale keeps the mapping correct for any geometry that satisfies
+// the "exact multiple" contract.
+double to_logical(double value, int logical_extent, int window_extent) {
+    return value * logical_extent / window_extent;
+}
+
+// One logical point to one DS pixel inside `rect`. A widened picture stretches
+// 256 DS columns across its rect, so this is proportional, not a copy: the
+// presenter stretches those pixels the same way, and the two must agree or the
+// stylus lands a few pixels off.
+int to_ds_axis(double value, int rect_origin, int rect_extent,
+               int native_extent) {
+    const double within = value - static_cast<double>(rect_origin);
+    const double fraction = within / static_cast<double>(rect_extent);
+    int pixel = static_cast<int>(fraction * static_cast<double>(native_extent));
+    if (pixel < 0) {
+        pixel = 0;
+    }
+    if (pixel > native_extent - 1) {
+        pixel = native_extent - 1;
+    }
+    return pixel;
+}
+
+// The guards both touch entry points share: the geometry must describe the
+// window asked for, and that window must have a logical surface to measure
+// against. A window with a zero or negative logical size has no coordinate
+// space in it, so there is nothing to map.
+bool hit_target_is_usable(const NdsPresentationGeometry& geometry,
+                          int window_index) {
+    if (!geometry.valid) return false;
+    if (geometry.window_count < 1 || geometry.window_count > 2) return false;
+    if (window_index < 0 || window_index >= geometry.window_count) {
+        return false;
+    }
+    if (geometry.logical_width[window_index] <= 0 ||
+        geometry.logical_height[window_index] <= 0) {
+        return false;
+    }
+    return true;
+}
+
+// The shared body of both touch entry points: the point is already in logical
+// canvas space, so only the rects decide. Keeping this in one place is what
+// makes the window-space and logical-space answers agree about which screen
+// owns a point -- the two public functions differ only in how they get here.
+bool hit_test_at(const NdsPresentationGeometry& geometry, int window_index,
+                 double logical_x, double logical_y, int* screen, int* ds_x,
+                 int* ds_y) {
+    // In two-window mode window i holds screen i, so there is exactly one
+    // candidate. In a layout both screens share one surface and the point
+    // decides which.
+    const int first = geometry.separate_windows ? window_index : 0;
+    const int last = geometry.separate_windows ? window_index : 1;
+    for (int slot = first; slot <= last; ++slot) {
+        if (!geometry.visible[slot]) {
+            continue;
+        }
+        const NdsScreenRect& rect = geometry.screen_rect[slot];
+        if (!point_in_rect(rect, logical_x, logical_y)) {
+            continue;
+        }
+        *screen = slot;
+        *ds_x = to_ds_axis(logical_x, rect.x, rect.width, kNativeScreenWidth);
+        *ds_y = to_ds_axis(logical_y, rect.y, rect.height, kNativeScreenHeight);
+        return true;
+    }
+    return false;
+}
+
+}  // namespace
+
+bool is_separate_windows(NdsScreenLayoutKind kind) {
+    return static_cast<int>(kind) ==
+           static_cast<int>(kNdsPresentationSeparateWindows);
+}
+
+NdsPresentationGeometry compute_presentation(NdsScreenLayoutKind kind,
+                                             int window_scale,
+                                             int adaptive_width,
+                                             bool swap_screens,
+                                             bool second_monitor) {
+    // Decision 3: an out-of-range zoom is refused, never clamped.
+    if (window_scale < 1 || window_scale > kMaxWindowScale) {
+        return refused();
+    }
+    const int kind_value = static_cast<int>(kind);
+    if (is_separate_windows(kind)) {
+        // Two windows: adaptive_width widens a canvas that has no canvas to
+        // widen, and swap_screens would have to exchange two identical
+        // windows, leaving nothing in the result to show it happened. Both are
+        // refused rather than silently ignored.
+        if (adaptive_width != 0 || swap_screens) {
+            return refused();
+        }
+        // second_monitor is meaningful here and changes no number: two windows
+        // are already two windows, so the caller has two surfaces to place on
+        // two displays whatever it passes.
+        return separate_geometry(window_scale);
+    }
+    // Decision 8: only the two-window mode has two displays to talk to.
+    if (second_monitor) {
+        return refused();
+    }
+    // Decision 7 and the totality rule: any other out-of-range value that is
+    // not the two-window mode behaves as stacked, as compute_layout() does.
+    if (!is_layout_kind(kind_value)) {
+        kind = kNdsLayoutStacked;
+    }
+    // Decision 5: adaptive_width is either absent or a value this module can
+    // honour. An even width in range is required because the bottom picture is
+    // centred at (adaptive_width - 256) / 2; odd, too narrow and too wide are
+    // all refused, and so is every layout that cannot carry it.
+    if (adaptive_width != 0) {
+        const bool stacked = kind == kNdsLayoutStacked;
+        const bool in_range = adaptive_width >= kMinAdaptiveWidth &&
+                              adaptive_width <= kMaxAdaptiveWidth;
+        const bool even = (adaptive_width % 2) == 0;
+        if (!stacked || !in_range || !even) {
+            return refused();
+        }
+    }
+    return layout_geometry(kind, window_scale, adaptive_width, swap_screens);
+}
+
+bool screen_presentation_hit_test(const NdsPresentationGeometry& geometry,
+                                  int window_index, float x, float y,
+                                  int* screen, int* ds_x, int* ds_y) {
+    // A miss writes nothing, so the caller's variables hold their previous
+    // values: no "stale coordinates plus a success flag" trap.
+    if (screen == nullptr || ds_x == nullptr || ds_y == nullptr) {
+        return false;
+    }
+    if (!hit_target_is_usable(geometry, window_index)) {
+        return false;
+    }
+    if (geometry.window_width[window_index] <= 0 ||
+        geometry.window_height[window_index] <= 0) {
+        return false;
+    }
+
+    const double logical_x = to_logical(
+        static_cast<double>(x), geometry.logical_width[window_index],
+        geometry.window_width[window_index]);
+    const double logical_y = to_logical(
+        static_cast<double>(y), geometry.logical_height[window_index],
+        geometry.window_height[window_index]);
+    return hit_test_at(geometry, window_index, logical_x, logical_y, screen,
+                       ds_x, ds_y);
+}
+
+bool screen_presentation_hit_test_logical(
+    const NdsPresentationGeometry& geometry, int window_index, float x,
+    float y, int* screen, int* ds_x, int* ds_y) {
+    if (screen == nullptr || ds_x == nullptr || ds_y == nullptr) {
+        return false;
+    }
+    if (!hit_target_is_usable(geometry, window_index)) {
+        return false;
+    }
+    // No scale to undo: SDL has already mapped this point onto the logical
+    // surface, and that mapping stays correct across a resize while the
+    // window/logical multiple does not. See decision 11.
+    return hit_test_at(geometry, window_index, static_cast<double>(x),
+                       static_cast<double>(y), screen, ds_x, ds_y);
+}
+
+}  // namespace nds_screen_presentation
diff --git a/runner/src/screen_presentation.h b/runner/src/screen_presentation.h
new file mode 100644
index 0000000..dbe8e97
--- /dev/null
+++ b/runner/src/screen_presentation.h
@@ -0,0 +1,259 @@
+#pragma once
+
+// Window geometry and touch mapping for the dual-screen DS image.
+//
+// screen_layouts.h answers "where does each 256x192 picture go inside the
+// canvas?". The frontend has to answer three more questions, and it has to
+// answer all three consistently or the picture and the mouse disagree:
+//
+//   * how large is the OS window, and how large is the renderer's logical
+//     surface? (get either wrong and the picture is stretched or shimmers)
+//   * which DS screen does each picture belong to, and is it hidden?
+//   * which DS pixel is under a window-space point? (touch input)
+//
+// This module is that decision layer: pure geometry in, geometry out. No SDL,
+// no globals, no I/O, no allocation, no printing. frontend.cpp applies it.
+//
+// The decisions, stated once here so the tests and the frontend cannot drift.
+//
+// 1. CANVAS. Each layout draws into a fixed native canvas -- the smallest
+//    canvas that holds it at 1:1, which is exactly layout_min_canvas():
+//        stacked       256 x 384   two pictures, one above the other
+//        side-by-side  512 x 192   two pictures, left and right
+//        square        512 x 256   two pictures in 256x256 tiles, so 32 px of
+//                                  margin above and below
+//        top only      256 x 192
+//        bottom only   256 x 192
+//    Two-window mode has one 256x192 canvas per window.
+//
+// 2. NO ASPECT STRETCHING, EVER. logical_width/logical_height are the native
+//    canvas and screen_rect stays in native canvas pixels: the renderer is told
+//    to think in DS pixels and SDL_RenderSetLogicalSize() scales that surface
+//    to the window for it. window_scale multiplies the OUTER window only, so
+//    the window is exactly window_scale x the logical surface:
+//        window_width  == logical_width  * window_scale, always;
+//        window_height == logical_height * window_scale, always.
+//    That exact multiple is the point: the manager never has to invent a
+//    fractional scale factor, which is what makes a 1.5x-scaled DS image
+//    shimmer. A caller that wants a bigger picture raises window_scale; nothing
+//    here ever computes a non-integer scale.
+//
+// 3. window_scale must be 1..kMaxWindowScale. Anything else is refused rather
+//    than clamped: an 8192-pixel-wide window is already past what a texture or
+//    a display will take, and a silent clamp would show "8x" in the menu while
+//    the window is smaller.
+//
+// 4. swap_screens (F3) exchanges the two pictures' POSITIONS, never their
+//    sizes -- what the key promises is "swap what I am looking at". On a
+//    single-screen layout that means it swaps WHICH SCREEN IS SHOWN instead:
+//    top-only with swap_screens shows the bottom screen, in the same place and
+//    at the same size. There is nothing else on a one-screen layout to swap,
+//    and a key that did nothing on half the layouts would be a bug report.
+//
+// 5. adaptive_width widens the TOP screen's picture -- the widescreen hack.
+//    Allowed only on stacked, only even, only kMinAdaptiveWidth (256) through
+//    kMaxAdaptiveWidth (448). The canvas width becomes max(adaptive_width,
+//    256), which for the allowed range is just adaptive_width; the top rect
+//    becomes adaptive_width x 192 and the bottom rect stays 256 x 192, centred
+//    under it.
+//    The even-value rule exists because that centring is
+//    (adaptive_width - 256) / 2: an odd width would put the bottom picture half
+//    a pixel off centre, and half pixels are how a screen goes soft.
+//    Refused -- not ignored -- for every other layout, and for a zero-except-
+//    allowed, odd or out-of-range value: silently ignoring it would ship a
+//    picture the player asked to be wider and is not, which reads as "the
+//    setting does nothing".
+//    This is also why "or max(adaptive_width, 512) for side-by-side/square" has
+//    no answer here: widening is refused for those layouts, so that case cannot
+//    arise. Supporting it later is a design question (which of the two screens
+//    widens? does the other stay centred, and about what?), not arithmetic.
+//
+// 6. window_scale and adaptive_width apply to the window, not to each picture
+//    separately: there is one zoom for the canvas and the rects describe how
+//    the pictures share it.
+//
+// 7. TWO-WINDOW MODE is not a layout kind and is not in NdsScreenLayoutKind: it
+//    is a different presentation, in which each DS screen gets its own 256x192
+//    window and its own logical surface. It is requested by passing
+//    kNdsPresentationSeparateWindows to compute_presentation(); every other
+//    entry point keeps using the layout enum unchanged. In that mode
+//    window_width[i] / logical_width[i] / screen_rect[i] describe window i, and
+//    window i shows screen i (window 0 the top screen, window 1 the bottom).
+//
+// 8. second_monitor only means something in two-window mode, where the two
+//    windows are independent and may be placed on different displays. It does
+//    not change any number -- two-window mode is already two windows -- it
+//    exists so that a caller who asks for two displays gets either two windows
+//    or a refusal, never a silently single-display picture. Passing it to any
+//    layout kind is REFUSED, for the same reason adaptive_width is.
+//
+// 9. REFUSALS zero the whole structure: every size, every rect, both visibility
+//    flags, window_count, separate_windows, valid. A caller that forgets to
+//    check valid gets a 0x0 window -- visible in a log -- instead of a
+//    plausible-looking picture drawn in the wrong place.
+//
+// 10. HIT TEST. The touch entry points use the same rects the presenter draws,
+//    so there is no second copy of the geometry to drift. A point on a picture
+//    maps to DS coordinates by scaling inside that picture's rect -- identity
+//    for an un-widened 256x192 picture, proportional for an adaptive_width
+//    picture, because the presenter stretches those DS pixels the same way. A
+//    point on a margin, outside the window, outside the canvas, on a hidden
+//    screen, or in a window that does not exist returns false and writes
+//    NOTHING, and the caller releases the stylus. There is no "close enough"
+//    here: a margin tap that lands on a picture is a wrong touch in the
+//    emulator, not a rounding detail.
+//
+// 11. TWO TOUCH ENTRY POINTS, ONE MAPPING. The window is resizable -- the
+//    Fullscreen row resizes it -- so the exact window/logical multiple from
+//    decision 2 holds when the window is opened and stops holding the moment
+//    anybody drags an edge. That is why there are two entry points:
+//      * screen_presentation_hit_test() takes WINDOW pixels, for a caller that
+//        has them: the relative-mouse route, which reads the pointer in the
+//        window it was handed and undoes the window_scale factor;
+//      * screen_presentation_hit_test_logical() takes LOGICAL (native canvas)
+//        pixels, which is what SDL_RenderCoordinatesFromWindow() reports. SDL
+//        keeps the logical surface fixed and maps whatever window rectangle it
+//        currently has onto it, so after an arbitrary resize that is the only
+//        coordinate space that is still trustworthy.
+//    The logical one is the one to call whenever the window may have been
+//    resized: undoing a REMEMBERED window_scale would be applying a stale
+//    factor, and the stylus would land off the picture while the picture itself
+//    stayed correct. Both entry points run one shared body, so they cannot
+//    disagree about which screen owns a point; for a point a whole
+//    window_scale apart in window space they return the same answer.
+
+#include "screen_layouts.h"
+
+namespace nds_screen_presentation {
+
+using nds_screen_layout::kNdsLayoutBottomOnly;
+using nds_screen_layout::kNdsLayoutKindCount;
+using nds_screen_layout::kNdsLayoutSideBySide;
+using nds_screen_layout::kNdsLayoutSquare;
+using nds_screen_layout::kNdsLayoutStacked;
+using nds_screen_layout::kNdsLayoutTopOnly;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::NdsScreenLayoutKind;
+using nds_screen_layout::NdsScreenRect;
+using nds_screen_layout::kNdsScreenTop;
+
+// Largest accepted window_scale. 512 * 16 = 8192 px wide is already beyond any
+// display a DS frontend is shown on, and it keeps every window dimension, both
+// canvas dimensions and every intermediate product far inside int.
+constexpr int kMaxWindowScale = 16;
+
+// The adaptive_width range: the native width of one screen up to 448 (16:9-ish
+// for a 192-tall picture, the usual widescreen target). Values outside it, and
+// odd values inside it, are refused.
+constexpr int kMinAdaptiveWidth = 256;
+constexpr int kMaxAdaptiveWidth = 448;
+
+// The two-window presentation mode, which is NOT a layout. It is spelled as the
+// layout-count value -- one past the last real layout -- so recognising it is a
+// range check, and so no layout kind can ever collide with it. Because it is
+// outside NdsScreenLayoutKind's real range, passing it to a screen_layouts
+// function folds it onto stacked; only this module gives it meaning.
+constexpr NdsScreenLayoutKind kNdsPresentationSeparateWindows =
+    static_cast<NdsScreenLayoutKind>(kNdsLayoutKindCount);
+
+// True for kNdsPresentationSeparateWindows and nothing else.
+bool is_separate_windows(NdsScreenLayoutKind kind);
+
+// Everything the frontend needs to open, size and drive the window(s).
+//
+// Two shapes share this struct:
+//   * one window showing a layout: window_count == 1, separate_windows false,
+//     index 1 of every array is zero, and both screens may be visible in the
+//     single canvas.
+//   * two windows, one per screen: window_count == 2, separate_windows true,
+//     and index i of the window/logical arrays describes the window showing
+//     screen i.
+//
+// screen_rect is indexed by SCREEN SLOT either way (rects[kNdsScreenTop] is the
+// top screen's destination), which is what the presenter and the hit test both
+// need; it is never indexed by window. A hidden or unused rect is all zeros.
+struct NdsPresentationGeometry {
+    // Outer window size in pixels, before any OS/DPI scaling.
+    int window_width[2];
+    int window_height[2];
+    // Logical surface size for SDL_RenderSetLogicalSize(), per window. Always
+    // the native canvas for that window, never scaled: see decision 2.
+    int logical_width[2];
+    int logical_height[2];
+    // Where each DS picture is drawn, in LOGICAL (native canvas) pixels.
+    NdsScreenRect screen_rect[2];
+    // The canvas both logical sizes come from. In two-window mode both windows
+    // use it (one screen each).
+    int canvas_width;
+    int canvas_height;
+    // False when the layout hides a screen entirely (top-only, bottom-only, and
+    // the hidden half of a swap). A hidden screen has an all-zero rect and must
+    // not be presented, hit-tested or given a texture.
+    bool visible[2];
+    // 1 for every layout, 2 for the two-window presentation.
+    int window_count;
+    // True only for the two-window presentation: the windows are independent
+    // and may live on different displays.
+    bool separate_windows;
+    // False when the request was refused; everything above is then zero.
+    bool valid;
+};
+
+// Maps (kind, window_scale, adaptive_width, swap_screens, second_monitor) onto
+// the geometry above.
+//
+// kind: one of the five layouts, or kNdsPresentationSeparateWindows. An
+// out-of-range value that is neither -- a stale settings file, say -- behaves
+// as stacked, matching the totality of compute_layout().
+//
+// window_scale: 1..kMaxWindowScale. adaptive_width: 0 for none, otherwise only
+// with stacked and only even in kMinAdaptiveWidth..kMaxAdaptiveWidth.
+// second_monitor: only with kNdsPresentationSeparateWindows.
+//
+// Every refusal (a bad scale, an adaptive width a layout cannot carry, a second
+// monitor without two windows) returns valid == false with the whole structure
+// zeroed. See the decisions at the top of this header.
+NdsPresentationGeometry compute_presentation(NdsScreenLayoutKind kind,
+                                             int window_scale,
+                                             int adaptive_width,
+                                             bool swap_screens,
+                                             bool second_monitor);
+
+// Touch path: maps a point in window_index's window space onto a DS pixel.
+//
+// On a hit, writes the screen slot to *screen and the 0..255 / 0..191 DS pixel
+// to *ds_x / *ds_y, and returns true. On a miss -- margin, outside the window,
+// hidden screen, a window that does not exist, null out pointers, or an invalid
+// geometry -- returns false and writes nothing at all.
+//
+// x and y are window pixels as SDL reports them (window space, not the logical
+// surface): the function undoes exactly the window_scale factor from decision 2
+// and then uses the drawn rects, so it cannot disagree with the presenter.
+//
+// Use this entry point only while the window is still the size
+// compute_presentation() asked for. Once the player or the window manager has
+// resized it, the window/logical multiple is no longer window_scale and this
+// function's undo is wrong; call screen_presentation_hit_test_logical() with
+// the logical coordinate SDL reports instead. See decision 11.
+bool screen_presentation_hit_test(const NdsPresentationGeometry& geometry,
+                                  int window_index, float x, float y,
+                                  int* screen, int* ds_x, int* ds_y);
+
+// The same mapping for a point already in LOGICAL (native canvas) space -- the
+// coordinates SDL_RenderCoordinatesFromWindow() reports, and the space the
+// screen_rects are written in.
+//
+// This is the entry point to use when the window may have been resized, because
+// it never undoes a scale factor: SDL has already mapped the point onto the
+// fixed logical surface, so a resize changes the window coordinates and leaves
+// the logical ones correct. It shares its body with the window-space function,
+// so both agree about which screen owns a point; they differ only in the space
+// their x and y are expressed in.
+//
+// The hit/miss rules and the write-on-hit-only promise are identical, as is the
+// refusal to touch the out pointers on a miss.
+bool screen_presentation_hit_test_logical(
+    const NdsPresentationGeometry& geometry, int window_index, float x, float y,
+    int* screen, int* ds_x, int* ds_y);
+
+}  // namespace nds_screen_presentation
