+bool point_in_logical_rect(const NdsLogicalRect& rect, int x, int y) {
+    return rect.width > 0 && rect.height > 0 &&
+           x >= rect.x && x < rect.x + rect.width &&
+           y >= rect.y && y < rect.y + rect.height;
+}
+
+// Map a point in the renderer's LOGICAL DS-space onto the touchscreen.
+//
+// The geometry is the same answer the draw rects came from, so the stylus lands
+// where the picture is: `screen_rect` is expressed in logical canvas pixels
+// already, which is why no scale factor appears here. Deriving the mapping from
+// the layout enum instead (the previous shape) put the touch rectangle at a
+// fixed y and centred it horizontally, which is only true for stacked and
+// separate; side-by-side puts the touch screen at x=256..511, the square layout
+// offsets both pictures by its tile padding, and a one-screen bottom-only
+// presentation starts the touch screen at y=0.
+void set_touch_from_geometry(
+    float x, float y, bool down,
+    const nds_screen_presentation::NdsPresentationGeometry& geometry) {
+    // Only the bottom DS screen is a touchscreen; the top one carries a display
+    // only, so a click on it is not a stylus press. A layout that hides the
+    // bottom screen therefore has no stylus input at all, which is the honest
+    // consequence of asking to see only the top picture.
+    const nds_screen_layout::NdsScreenRect& rect =
+        geometry.screen_rect[nds_screen_layout::kNdsScreenBottom];
+    const bool inside = down && geometry.visible[1] &&
+        x >= static_cast<float>(rect.x) &&
+        x < static_cast<float>(rect.x + rect.width) &&
+        y >= static_cast<float>(rect.y) &&
+        y < static_cast<float>(rect.y + rect.height);
+    if (!inside) {
+        nds_set_touch(0, 0, false);
+        return;
+    }
+    const auto touch_x = static_cast<uint16_t>(std::clamp<int>(
+        static_cast<int>(x) - rect.x, 0, kScreenWidth - 1));
+    const auto touch_y = static_cast<uint16_t>(std::clamp<int>(
+        static_cast<int>(y) - rect.y, 0, kScreenHeight - 1));
+    nds_set_touch(touch_x, touch_y, true);
+}
+
+uint32_t audio_queue_count(const NdsAudioDevice& device, AudioQueue& queue) {
+    if (!device) return 0;
+#if defined(NDS_HAVE_SDL3)
+    (void)queue;
+    const int queued_bytes = SDL_GetAudioStreamQueued(device.stream);
+    return queued_bytes > 0
+        ? static_cast<uint32_t>(queued_bytes) / kAudioFrameBytes : 0;
+#else
+    SDL_LockAudioDevice(device);
+    const uint32_t count = queue.count;
+    SDL_UnlockAudioDevice(device);
+    return count;
+#endif
+}
+
+// Set while the settings menu's "Record audio" row is on. The tap lives in
+// drain_audio because that is the one place every produced sample passes
+// through; a second reader would steal samples from the mixer.
+NdsWavRecorder* g_audio_recorder = nullptr;
+
+uint32_t drain_audio(const NdsAudioDevice& device, AudioQueue& queue,
+                     bool throttle, uint32_t pace_floor, bool& queue_error) {
+    if (!device) return 0;
+    std::array<int16_t, 2048> samples{};
+    for (;;) {
+        const uint32_t frames = nds_spu_read_output(samples.data(), 1024);
+        if (!frames) break;
+        if (g_audio_recorder) g_audio_recorder->write(samples.data(), frames);
+        bool pushed = false;
+        while (!pushed) {
+#if defined(NDS_HAVE_SDL3)
+            const uint32_t queued = audio_queue_count(device, queue);
+            if (kAudioCapacityFrames - queued >= frames) {
+                if (SDL_PutAudioStreamData(device.stream, samples.data(),
+                                           static_cast<int>(
+                                               frames * kAudioFrameBytes))) {
+                    pushed = true;
+                } else {
+                    queue_error = true;
+                    return audio_queue_count(device, queue);
+                }
+            }
+#else
+            SDL_LockAudioDevice(device);
+            if (kAudioCapacityFrames - queue.count >= frames) {
+                const uint32_t first = std::min(
+                    frames, kAudioCapacityFrames - queue.write);
+                std::memcpy(queue.samples.data() + queue.write * 2u,
+                            samples.data(), first * kAudioFrameBytes);
+                if (first < frames)
+                    std::memcpy(queue.samples.data(),
+                                samples.data() + first * 2u,
+                                (frames - first) * kAudioFrameBytes);
+                queue.write = (queue.write + frames) % kAudioCapacityFrames;
+                queue.count += frames;
+                pushed = true;
+            }
+            SDL_UnlockAudioDevice(device);
+#endif
+            if (!pushed) {
+                if (!throttle) {
+                    queue_error = true;
+                    return audio_queue_count(device, queue);
+                }
+                SDL_Delay(1);
+            }
+        }
+    }
+    // Audio is the host's real-time clock. Never drop a produced block: if the
+    // emulator is faster than the DS cadence, let SDL consume the backlog
+    // before emulating another frame. pace_floor is the current allowance:
+    // kAudioQueueFrames in steady state, temporarily higher right after the
+    // boot prebuffer (the caller decays it a fixed step per frame). The sleep
+    // only stops the queue RISING above the floor — it never forces the queue
+    // down while the emulator is running behind, so a slow stretch spends the
+    // buffered runway instead of having it slept away.
+    uint32_t queued = audio_queue_count(device, queue);
+    while (throttle && queued > pace_floor) {
+        SDL_Delay(1);
+        queued = audio_queue_count(device, queue);
+    }
+    return queued;
+}
+
+void clear_audio_queue(const NdsAudioDevice& device, AudioQueue& queue) {
+    if (!device) return;
+#if defined(NDS_HAVE_SDL3)
+    SDL_ClearAudioStream(device.stream);
+    (void)queue;
+#else
+    SDL_LockAudioDevice(device);
+    queue.read = 0;
+    queue.write = 0;
+    queue.count = 0;
+    SDL_UnlockAudioDevice(device);
+#endif
+}
