+uint64_t framebuffer_rgb_fnv(int screen) {
+    const uint32_t* framebuffer = nds_gpu2d_framebuffer(screen);
+    uint64_t hash = 1469598103934665603ull;
+    for (size_t i = 0; i < 256u * 192u; ++i) {
+        const uint32_t pixel = framebuffer[i];
+        const uint8_t rgb[3] = {
+            static_cast<uint8_t>(pixel >> 16),
+            static_cast<uint8_t>(pixel >> 8),
+            static_cast<uint8_t>(pixel),
+        };
+        for (const uint8_t byte : rgb) {
+            hash ^= byte;
+            hash *= 1099511628211ull;
+        }
+    }
+    return hash;
+}
+
+// Where a recording goes: beside the settings file, named after the game and
+// the local time. A recording is a debug artifact, so it goes through the same
+// stem sanitising the screenshots use and never in front of a folder separator.
+std::string audio_recording_path(const std::string& directory,
+                                const std::string& stem) {
+    std::string safe;
+    for (const char c : stem) {
+        const unsigned char value = static_cast<unsigned char>(c);
+        const bool keep = (value >= 'a' && value <= 'z') ||
+                          (value >= 'A' && value <= 'Z') ||
+                          (value >= '0' && value <= '9') || c == '.' ||
+                          c == '_' || c == '-';
+        safe.push_back(keep ? c : '_');
+    }
+    if (safe.empty()) safe = "recording";
+    const std::time_t now = std::time(nullptr);
+    std::tm local{};
+#if defined(_WIN32)
+    localtime_s(&local, &now);
+#else
+    localtime_r(&now, &local);
+#endif
+    char stamp[32] = {};
+    std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", &local);
+    const std::filesystem::path folder(directory);
+    std::filesystem::path path =
+        folder / (safe + "-audio-" + stamp + ".wav");
+    for (int attempt = 2;
+         attempt < 100 && std::filesystem::exists(path); ++attempt) {
+        path = folder / (safe + "-audio-" + stamp + "-" +
+                         std::to_string(attempt) + ".wav");
+    }
+    return path.string();
+}
+
+constexpr const char* kRuntimeMouseSensitivityKey =
+    "input.mouse_sensitivity";
+constexpr const char* kRuntimeResumeKey = "system.resume";
+constexpr const char* kRuntimeQuitKey = "system.quit";
+constexpr const char* kRuntimeResetKey = "system.reset";
+constexpr const char* kRuntimeScreenshotKey = "system.screenshot";
+constexpr const char* kRuntimeSaveStateKey = "system.save_state";
+constexpr const char* kRuntimeLoadStateKey = "system.load_state";
+constexpr const char* kRuntimeVsyncKey = "display.vsync";
+constexpr const char* kRuntimeFastForwardKey = "input.fast_forward";
+constexpr const char* kRuntimeColorModeKey = "graphics.color_mode";
+constexpr const char* kRuntimeLcdGridKey = "graphics.lcd_grid";
+constexpr const char* kRuntimePixelFilterKey = "graphics.pixel_filter";
+constexpr const char* kRuntimeFrameCapKey = "display.frame_cap";
+constexpr const char* kRuntimeScreenLayoutKey = "display.screen_layout";
+constexpr const char* kRuntimeSwapScreensKey = "display.swap_screens";
+constexpr const char* kRuntimeSecondMonitorKey = "display.second_monitor";
+constexpr const char* kRuntimeMinimapKey = "display.minimap";
+constexpr const char* kRuntimeAudioRecordKey = "audio.record";
+constexpr const char* kRuntimeBindPrefix = "controls.bind.";
+constexpr const char* kRuntimeBindResetKey = "controls.reset";
+
+// One menu key per DS button, spelled "controls.bind.<button>". Built from the
+// binding module's own button names so the menu key, the settings sub-key and
+// the pad bit cannot drift apart.
+const char* runtime_bind_key(int button) {
+    static const std::array<std::string, kNdsPadButtonCount> keys = [] {
+        std::array<std::string, kNdsPadButtonCount> built;
+        for (int i = 0; i < kNdsPadButtonCount; ++i)
+            built[static_cast<size_t>(i)] =
+                std::string(kRuntimeBindPrefix) +
+                nds_pad_button_name(static_cast<NdsPadButton>(i));
+        return built;
+    }();
+    if (button < 0 || button >= kNdsPadButtonCount) return "";
+    return keys[static_cast<size_t>(button)].c_str();
+}
+
+// The button a "controls.bind.<button>" menu key names, or -1.
+int runtime_bind_button_for_key(const char* key) {
+    if (!key || std::strncmp(key, kRuntimeBindPrefix,
+                             std::strlen(kRuntimeBindPrefix)) != 0)
+        return -1;
+    return nds_pad_button_from_name(key + std::strlen(kRuntimeBindPrefix));
+}
+
+struct FrontendPresentation;
+
+// The host side of the shared settings menu. Every value the menu edits lives
+// in `snapshot` (which is what the settings file stores); every row's effect is
+// applied to the live frontend through `apply` below, so a persisted choice and
+// the running window never disagree.
+struct RuntimeMenuState {
+    NdsFrontendOptions* options = nullptr;
+    // Applies one edited value to the live window/audio/3D state. Runs after
+    // the snapshot was updated, so it can read the new value back.
+    std::function<void(const char* key)> apply;
+    // Runs a savestate command through the same code path the F-key shortcut
+    // uses (and leaves the notice text behind). Empty when the ROM identity was
+    // never verified, in which case the rows are disabled.
+    std::function<void(NdsSavestateSlotAction, unsigned)> savestate;
+    // Writes both screens to a PNG beside the settings file. Empty when the
+    // settings path is unknown, which is also when there is nowhere sensible to
+    // put a screenshot.
+    std::function<void()> screenshot;
+    // Redraws the settings file from the snapshot; set by the run loop so it
+    // can log the outcome once per change.
+    std::function<void()> persist;
+    // Arms a one-shot "press the new binding now" capture for one DS button.
+    // The value is the button index, or -1 to cancel.
+    std::function<void(int)> begin_bind;
+    // Restores the shipped bindings and persists them.
+    std::function<void()> reset_bindings;
+    // Starts or stops writing the produced audio to a WAV file. Empty when no
+    // audio device opened, because with no device nothing is ever drained and a
+    // recording would be an empty file that claims to be a recording.
+    std::function<void()> toggle_record;
+    RecompRuntimeUi* ui = nullptr;
+    NdsRuntimeMenuSnapshot snapshot{};
+    bool* running = nullptr;
+    bool close_requested = false;
+    bool reset_requested = false;
+};
+
+int runtime_menu_get_value(void* context, const RecompRuntimeUiItem* item,
+                           int* value_out) {
+    auto* state = static_cast<RuntimeMenuState*>(context);
+    if (!state || !item || !value_out) return 0;
+    const int* field = nds_runtime_menu_field(&state->snapshot, item->key);
+    if (!field) return 0;
+    *value_out = *field;
+    return 1;
+}
+
+int runtime_menu_set_value(void* context, const RecompRuntimeUiItem* item,
+                           int value) {
+    auto* state = static_cast<RuntimeMenuState*>(context);
+    if (!state || !item) return 0;
+    int* field = nds_runtime_menu_field(&state->snapshot, item->key);
+    if (!field) return 0;
+    int minimum = 0;
+    int maximum = 0;
+    if (!nds_runtime_menu_key_range(item->key, &minimum, &maximum)) return 0;
+    // The shared menu already clamps a stepped row, but a CHOICE row hands back
+    // whatever choice_values says; re-clamping here keeps the settings table's
+    // own range the single authority over both the menu and the file.
+    *field = std::clamp(value, minimum, maximum);
+    if (state->apply) state->apply(item->key);
+    return 1;
+}
+
+int runtime_menu_run_action(void* context, const RecompRuntimeUiItem* item) {
+    auto* state = static_cast<RuntimeMenuState*>(context);
+    if (!state || !item) return 0;
+    if (std::strcmp(item->key, kRuntimeResumeKey) == 0) {
+        state->close_requested = true;
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeQuitKey) == 0) {
+        if (state->running) *state->running = false;
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeResetKey) == 0) {
+        // Asking for a restart closes the menu first: the reset re-initialises
+        // the machine underneath, so a menu left open would be describing a
+        // session that no longer exists.
+        state->close_requested = true;
+        state->reset_requested = true;
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeScreenshotKey) == 0) {
+        if (state->screenshot) state->screenshot();
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeSaveStateKey) == 0 ||
+        std::strcmp(item->key, kRuntimeLoadStateKey) == 0) {
+        if (!state->savestate) return 0;
+        const unsigned slot = static_cast<unsigned>(std::clamp(
+            state->snapshot.state_slot, 1,
+            static_cast<int>(NDS_SAVESTATE_SLOT_COUNT)));
+        state->savestate(
+            std::strcmp(item->key, kRuntimeSaveStateKey) == 0
+                ? NdsSavestateSlotAction::Save
+                : NdsSavestateSlotAction::Load,
+            slot);
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeBindResetKey) == 0) {
+        if (!state->reset_bindings) return 0;
+        state->reset_bindings();
+        return 1;
+    }
+    if (std::strcmp(item->key, kRuntimeAudioRecordKey) == 0) {
+        if (!state->toggle_record) return 0;
+        state->toggle_record();
+        return 1;
+    }
+    if (const int button = runtime_bind_button_for_key(item->key);
+        button >= 0) {
+        if (!state->begin_bind) return 0;
+        state->begin_bind(button);
+        // The menu closes so the armed capture can see the next real press:
+        // while it is open every key is menu navigation, so the binding the
+        // player is about to press would never reach the capture.
+        state->close_requested = true;
+        return 1;
+    }
+    return 0;
+}
+
+int runtime_menu_is_enabled(void* context, const RecompRuntimeUiItem* item) {
+    auto* state = static_cast<RuntimeMenuState*>(context);
+    if (!state || !item) return 0;
+    if (std::strcmp(item->key, kRuntimeScreenshotKey) == 0)
+        return state->screenshot ? 1 : 0;
+    if (std::strcmp(item->key, kRuntimeSaveStateKey) == 0 ||
+        std::strcmp(item->key, kRuntimeLoadStateKey) == 0)
+        return state->savestate ? 1 : 0;
+    if (std::strcmp(item->key, kRuntimeMouseSensitivityKey) == 0)
+        return state->options && state->options->relative_mouse_touch ? 1 : 0;
+    if (std::strcmp(item->key, kRuntimeAudioRecordKey) == 0)
+        return state->toggle_record ? 1 : 0;
+    // A value row whose setting this runner does not own (and therefore could
+    // not apply) must not be offered at all: a row that moves and changes
+    // nothing is worse than a row that is visibly unavailable. Action rows are
+    // deliberately exempt -- they carry no value to own, and each one above
+    // states its own availability.
+    if (item->type != RECOMP_RUNTIME_UI_ACTION &&
+        !nds_runtime_menu_field(&state->snapshot, item->key))
+        return 0;
+    return 1;
+}
+
+void runtime_menu_save(void* context) {
+    auto* state = static_cast<RuntimeMenuState*>(context);
+    if (!state || !state->persist) return;
+    state->persist();
+}
