+        if (int code = check("a missing file is reported",
+                             diagnostics_mention(diagnostics,
+                                                 "does-not-exist.json"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        std::vector<ach::NdsAchievement> kept(1);
