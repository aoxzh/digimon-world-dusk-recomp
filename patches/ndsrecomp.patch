+            }
+            if (!virtual_stylus_mouse_consumed &&
+                event.type == SDL_MOUSEBUTTONUP &&
+                event.button.button == SDL_BUTTON_LEFT &&
+                event.button.windowID == presentation.window_ids[1] &&
+                mouse_down) {
