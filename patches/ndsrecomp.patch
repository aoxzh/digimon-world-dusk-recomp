new file mode 100644
index 0000000..2fd4fb2
--- /dev/null
+++ b/runner/tests/achievements_test.cpp
@@ -0,0 +1,1841 @@
+// Pins the local achievement machinery (achievements.h).
+//
+// This module is the part of an achievement system that does not need a
+// server: definitions parsed from a title's JSON, counters fed by the runner,
+// at-most-once unlocks, a small progress file, and a notification list. The
+// properties worth testing are the ones a rewrite could quietly destroy:
+//
+//   * A definition set is hand-edited, so one broken entry must cost that
+//     entry only -- the other eleven still load and the caller's previous
+//     table survives a file that will not parse at all.
+//   * An unlock happens once. A second observation at the same value must not
+//     unlock again and must not notify again, or the player sees the same
+//     toast every frame.
+//   * Counters are high-water marks. A new game resets the guest's own
+//     counters; that must not take back an achievement.
+//   * A hidden achievement is counted but not listed until it is earned.
+//   * The progress file is written by the machine that just crashed last time,
+//     so reading it is additive: damage may add noise, never remove progress.
+//
+// Exit code is the ordinal of the first failing check, matching the OK
+// numbering, so a failure names itself without a debugger.
+
+#include "achievements.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace ach = nds_achievements;
+
+namespace {
+
+int g_checks = 0;
+
+// Records one check. Returns 0 when it passed, or the check's ordinal (the
+// number it was printed as) when it failed, so a caller can return it directly.
+int check(const char* name, bool condition, const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", name);
+        return 0;
+    }
+    std::printf("FAIL %s\n", name);
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name, detail.c_str());
+    return g_checks;
+}
+
+// Escapes a string so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\n') {
+            out += "\\n";
+        } else if (ch == '\r') {
+            out += "\\r";
+        } else if (ch == '\t') {
+            out += "\\t";
+        } else {
+            out.push_back(ch);
+        }
+    }
+    out += '"';
+    return out;
+}
+
+std::string join(const std::vector<std::string>& parts) {
+    std::string out;
+    for (std::size_t i = 0; i < parts.size(); ++i) {
+        if (i != 0u) out += " | ";
+        out += parts[i];
+    }
+    return out.empty() ? "(none)" : out;
+}
+
+bool diagnostics_mention(const std::vector<std::string>& diagnostics,
+                         const std::string& needle) {
+    for (const std::string& line : diagnostics)
+        if (line.find(needle) != std::string::npos) return true;
+    return false;
+}
+
+std::vector<std::string> lines_of(const std::string& text) {
+    std::vector<std::string> lines;
+    std::string current;
+    for (const char ch : text) {
+        if (ch == '\n') {
+            lines.push_back(current);
+            current.clear();
+        } else {
+            current.push_back(ch);
+        }
+    }
+    if (!current.empty()) lines.push_back(current);
+    return lines;
+}
+
+std::string read_file(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return std::string();
+    return std::string((std::istreambuf_iterator<char>(in)),
+                       std::istreambuf_iterator<char>());
+}
+
+bool write_file(const std::filesystem::path& path, const std::string& text) {
+    std::error_code error;
+    if (!path.parent_path().empty()) {
+        std::filesystem::create_directories(path.parent_path(), error);
+    }
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.close();
+    return out.good();
+}
+
+bool file_exists(const std::filesystem::path& path) {
+    std::error_code error;
+    return std::filesystem::exists(path, error) && !error;
+}
+
+// Counts entries of `lines` that start with `prefix`.
+int count_prefixed(const std::vector<std::string>& lines,
+                   const std::string& prefix) {
+    int found = 0;
+    for (const std::string& line : lines)
+        if (line.compare(0, prefix.size(), prefix) == 0) ++found;
+    return found;
+}
+
+int index_of_line(const std::vector<std::string>& lines,
+                  const std::string& wanted) {
+    for (std::size_t i = 0; i < lines.size(); ++i)
+        if (lines[i] == wanted) return static_cast<int>(i);
+    return -1;
+}
+
+std::string describe(const std::vector<ach::NdsAchievement>& entries) {
+    std::string out = "[";
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += entries[i].id;
+        out += "(";
+        out += std::to_string(static_cast<int>(entries[i].kind));
+        out += ")";
+    }
+    out += ']';
+    return out;
+}
+
+std::string describe(const std::vector<std::string>& values) {
+    std::string out = "[";
+    for (std::size_t i = 0; i < values.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += values[i];
+    }
+    out += ']';
+    return out;
+}
+
+// One definition id per unlocked entry the call reported.
+std::vector<std::string> notified_ids(const ach::NdsAchievementState& state) {
+    std::vector<std::string> ids;
+    for (const ach::NdsAchievement& entry : ach::unlocked_by_last_observation(
+             state))
+        ids.push_back(entry.id);
+    return ids;
+}
+
+bool same_ids(const std::vector<std::string>& got,
+              const std::vector<std::string>& want) {
+    return got == want;
+}
+
+// Writes `text` to a scratch file and parses it: every definition shape test
+// is then one call instead of a file fixture plus a load.
+bool parse_text(const std::filesystem::path& root, const char* leaf,
+                const std::string& text,
+                std::vector<ach::NdsAchievement>* out,
+                std::vector<std::string>* diagnostics) {
+    const std::filesystem::path path = root / "defs" / leaf;
+    if (!write_file(path, text)) return false;
+    return ach::load_definitions(path.string(), out, diagnostics);
+}
+
+// Parses `text` and installs it on `state`, the usual start of a state test.
+bool install(const std::filesystem::path& root, const char* leaf,
+             const std::string& text, ach::NdsAchievementState* state,
+             std::vector<std::string>* diagnostics) {
+    std::vector<ach::NdsAchievement> parsed;
+    if (!parse_text(root, leaf, text, &parsed, diagnostics)) return false;
+    ach::set_definitions(state, parsed);
+    return true;
+}
+
+// A definition set used by most of the state tests.
+const char* const kThreeDefinitions = R"json({
+  "achievements": [
+    { "id": "first-save", "name": "First save", "kind": "counter",
+      "counter": "in_game_saves", "target": 1 },
+    { "id": "ten-saves", "name": "Ten saves", "kind": "counter",
+      "counter": "in_game_saves", "target": 10 },
+    { "id": "first-flag", "name": "A flag", "kind": "flag",
+      "flag": "saw_credits" }
+  ]
+})json";
+
+}  // namespace
+
+namespace {
+
+int run_checks(const std::filesystem::path& root) {
+    namespace fs = std::filesystem;
+    std::vector<ach::NdsAchievement> parsed;
+    std::vector<std::string> diagnostics;
+
+    // ==== 1. Definition shapes that must load. =========================
+    {
+        // The documented minimal shape: a counter target and nothing else.
+        const std::string text = R"json({"achievements": [
+          {"id": "first-save", "name": "First save",
+           "counter": "in_game_saves", "target": 1}]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a minimal counter definition loads",
+                             parse_text(root, "minimal.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("the minimal definition is one entry",
+                             parsed.size() == 1u,
+                             describe(parsed)))
+            return code;
+        if (int code = check("an absent kind defaults to counter",
+                             parsed[0].kind == ach::NdsAchievementKind::Counter,
+                             describe(parsed)))
+            return code;
+        if (int code = check("the minimal definition keeps its id",
+                             parsed[0].id == "first-save", parsed[0].id))
+            return code;
+        if (int code = check("the minimal definition keeps its target",
+                             parsed[0].target == 1,
+                             std::to_string(parsed[0].target)))
+            return code;
+        if (int code = check("an absent description is empty, not garbage",
+                             parsed[0].description.empty(),
+                             quote(parsed[0].description)))
+            return code;
+        if (int code = check("an absent hidden flag is false",
+                             !parsed[0].hidden, "hidden"))
+            return code;
+        if (int code = check("a clean file reports no diagnostics",
+                             diagnostics.empty(), join(diagnostics)))
+            return code;
+    }
+
+    {
+        // The full shape, including the fields the menu shows.
+        const std::string text = R"json({"achievements": [
+          {"id": "all-tools", "name": "Full toolkit",
+           "description": "Use every host tool once.",
+           "kind": "counter_ge_all",
+           "counters": ["in_game_saves", "screenshots_taken"],
+           "target": 1, "hidden": true}]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a counter_ge_all definition loads",
+                             parse_text(root, "geall.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a counter_ge_all keeps every counter",
+                             parsed.size() == 1u &&
+                                 parsed[0].counters.size() == 2u,
+                             describe(parsed)))
+            return code;
+        if (int code = check("the counter_ge_all counter order is the file's",
+                             parsed.size() == 1u &&
+                                 parsed[0].counters[0] == "in_game_saves" &&
+                                 parsed[0].counters[1] == "screenshots_taken",
+                             describe(parsed)))
+            return code;
+        if (int code = check("a hidden definition stays hidden",
+                             parsed.size() == 1u && parsed[0].hidden, "x"))
+            return code;
+        if (int code = check("the full description survives",
+                             parsed.size() == 1u &&
+                                 parsed[0].description ==
+                                     "Use every host tool once.",
+                             parsed.empty() ? "" : parsed[0].description))
+            return code;
+    }
+
+    {
+        // Order matters: the notification list and the progress file both
+        // follow definition order.
+        const std::string text = R"json({"achievements": [
+          {"id": "zulu", "name": "Z", "counter": "a_counter", "target": 1},
+          {"id": "alpha", "name": "A", "counter": "b_counter", "target": 2},
+          {"id": "mike", "name": "M", "kind": "flag",
+           "flag": "some_flag"}]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a three-entry file loads",
+                             parse_text(root, "order.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("definition order is the file order",
+                             parsed.size() == 3u && parsed[0].id == "zulu" &&
+                                 parsed[1].id == "alpha" &&
+                                 parsed[2].id == "mike",
+                             describe(parsed)))
+            return code;
+        if (int code = check("the third entry is a flag definition",
+                             parsed.size() == 3u &&
+                                 parsed[2].kind ==
+                                     ach::NdsAchievementKind::Flag,
+                             describe(parsed)))
+            return code;
+    }
+
+    {
+        // An empty array is a legitimate file: a title with no achievements.
+        const std::string text = R"json({"achievements": []})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("an empty achievements array loads",
+                             parse_text(root, "empty.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an empty array yields no entries",
+                             parsed.empty(), describe(parsed)))
+            return code;
+        if (int code = check("an empty array reports no diagnostics",
+                             diagnostics.empty(), join(diagnostics)))
+            return code;
+    }
+
+    {
+        // Formatting is not the author's problem: whitespace, newlines and
+        // member order are all free.
+        const std::string text =
+            "  {\n\t\"achievements\" :\n\t[ {\n\t\t\"target\" : 3 ,\n"
+            "\t\t\"name\"  : \"Spaced\" ,\n\t\t\"id\" : \"spaced-out\" ,\n"
+            "\t\t\"counter\" : \"in_game_saves\"\n\t} ]\n}\n";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("whitespace and member order are tolerated",
+                             parse_text(root, "spaced.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a reordered entry still parses",
+                             parsed.size() == 1u &&
+                                 parsed[0].target == 3 &&
+                                 parsed[0].name == "Spaced",
+                             describe(parsed)))
+            return code;
+    }
+
+    {
+        // A Japanese title: the definition file carries UTF-8, and a name or
+        // description must come back byte for byte or the menu shows mojibake.
+        const std::string text =
+            "{\"achievements\": [{\"id\": \"first-save\", \"name\": "
+            "\"さいしょのセーブ\", \"description\": \"セーブを1回する\", "
+            "\"counter\": \"in_game_saves\", \"target\": 1}]}";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a UTF-8 definition loads",
+                             parse_text(root, "utf8.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a UTF-8 name survives byte for byte",
+                             parsed.size() == 1u &&
+                                 parsed[0].name ==
+                                     "\xe3\x81\x95\xe3\x81\x84\xe3\x81\x97"
+                                     "\xe3\x82\x87\xe3\x81\xae\xe3\x82\xbb"
+                                     "\xe3\x83\xbc\xe3\x83\x96",
+                             parsed.empty() ? "" : quote(parsed[0].name)))
+            return code;
+        if (int code = check("a UTF-8 description survives byte for byte",
+                             parsed.size() == 1u &&
+                                 parsed[0].description ==
+                                     "\xe3\x82\xbb\xe3\x83\xbc\xe3\x83\x96"
+                                     "\xe3\x82\x92" "1" "\xe5\x9b\x9e"
+                                     "\xe3\x81\x99\xe3\x82\x8b",
+                             parsed.empty() ? ""
+                                            : quote(parsed[0].description)))
+            return code;
+    }
+
+    {
+        // Escapes are how a JSON author writes a quote, a tab or an accent.
+        const std::string text =
+            "{\"achievements\": [{\"id\": \"escaped\", \"name\": "
+            "\"A \\\"quoted\\\" name\", \"description\": "
+            "\"tab\\there, newline\\nthere, caf\\u00e9\", "
+            "\"counter\": \"in_game_saves\", \"target\": 1}]}";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("escaped strings load",
+                             parse_text(root, "escaped.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a backslash-quote escape becomes a quote",
+                             parsed.size() == 1u &&
+                                 parsed[0].name == "A \"quoted\" name",
+                             parsed.empty() ? "" : quote(parsed[0].name)))
+            return code;
+        if (int code = check("escape sequences become their characters",
+                             parsed.size() == 1u &&
+                                 parsed[0].description ==
+                                     "tab\there, newline\nthere, caf\xc3\xa9",
+                             parsed.empty()
+                                 ? ""
+                                 : quote(parsed[0].description)))
+            return code;
+    }
+
+    {
+        // A surrogate pair is two escapes for one code point; getting this
+        // wrong turns an emoji into two mojibake bytes.
+        const std::string text =
+            "{\"achievements\": [{\"id\": \"emoji\", \"name\": "
+            "\"star \\ud83c\\udf1f\", \"counter\": \"in_game_saves\", "
+            "\"target\": 1}]}";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a surrogate pair escape loads",
+                             parse_text(root, "emoji.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a surrogate pair becomes one 4-byte code point",
+                             parsed.size() == 1u &&
+                                 parsed[0].name == "star \xf0\x9f\x8c\x9f",
+                             parsed.empty() ? "" : quote(parsed[0].name)))
+            return code;
+    }
+
+    {
+        // 64-bit targets are legal JSON integers and a playtime counter may
+        // well exceed 2^31 seconds on a save that has been played for years.
+        const std::string text = R"json({"achievements": [
+          {"id": "big", "name": "Big", "counter": "playtime_seconds",
+           "target": 9007199254740992}]})json";
+        parsed.clear();
+        diagnostics.clear();
