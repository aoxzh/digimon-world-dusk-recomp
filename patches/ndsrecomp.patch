+// A size-5 1D table whose nodes are (t, 1 - t, 0.5) for t = i / 4. Red and
+// green are exact complements, so any check that mixes the channels fails
+// loudly, and blue is a constant half that must stay 0x80 for every input.
+constexpr PixelPin kRosePins[] = {
+    {0xFF000000u, 0xFF00FF80u, 0xFF008040u},
+    {0xFF010101u, 0xFF01FE80u, 0xFF018040u},
+    {0xFF404040u, 0xFF40BF80u, 0xFF408060u},
+    {0xFF7F7F7Fu, 0xFF7F8080u, 0xFF7F807Fu},
+    {0xFF808080u, 0xFF807F80u, 0xFF808080u},
+    {0xFF818181u, 0xFF817E80u, 0xFF818080u},
+    {0xFFC0C0C0u, 0xFFC03F80u, 0xFFC080A0u},
+    {0xFFFFFFFFu, 0xFFFF0080u, 0xFFFF80BFu},
+};
+
+NdsColorLut build_rose_1d() {
+    const int size = 5;
+    NdsColorLut lut;
+    lut.size = size;
+    lut.is_3d = false;
+    for (int node = 0; node < size; ++node) {
+        const float t = static_cast<float>(node) / 4.0f;
+        lut.data.push_back(t);
+        lut.data.push_back(1.0f - t);
+        lut.data.push_back(0.5f);
+    }
+    return lut;
+}
+
+// A 1D table with extended-range nodes: (-0.25, 1.25, 0.5) and
+// (1.25, -0.25, 0.5). The format allows values outside 0..1 and the loader must
+// keep them; the sampler clamps at the byte, so the extremes saturate.
+constexpr PixelPin kExtendedPins[] = {
+    {0xFF000000u, 0xFF00FF80u, 0xFF008040u},
+    {0xFF404040u, 0xFF20DF80u, 0xFF308F60u},
+    {0xFF7F7F7Fu, 0xFF7F8080u, 0xFF7F807Fu},
+    {0xFF808080u, 0xFF807F80u, 0xFF807F80u},
+    {0xFFC0C0C0u, 0xFFE01F80u, 0xFFD06FA0u},
+    {0xFFFFFFFFu, 0xFFFF0080u, 0xFFFF80BFu},
+};
+
+NdsColorLut build_extended_1d() {
+    NdsColorLut lut;
+    lut.size = 2;
+    lut.is_3d = false;
+    lut.data = {-0.25f, 1.25f, 0.5f, 1.25f, -0.25f, 0.5f};
+    return lut;
+}
+
+// ---------------------------------------------------------------------------
+// Frame fixtures
+// ---------------------------------------------------------------------------
+
+constexpr int kFrameWidth = 256;
+constexpr int kFrameHeight = 192;
+
+// R, G and B walk different periods and the alpha byte cycles 0x00/0x7F/0xFF,
+// so a pass that loses alpha, transposes a channel or writes a row twice
+// cannot hash correctly.
+uint32_t pattern_pixel(int x, int y) {
+    constexpr uint32_t kAlphas[3] = {0x00u, 0x7Fu, 0xFFu};
+    const uint32_t alpha = kAlphas[(x + y) % 3];
+    const uint32_t red = static_cast<uint32_t>((x * 7 + y * 13) & 0xFF);
+    const uint32_t green = static_cast<uint32_t>((x * 3 + y * 29) & 0xFF);
+    const uint32_t blue = static_cast<uint32_t>((x * 11 + y * 5) & 0xFF);
+    return (alpha << 24) | (red << 16) | (green << 8) | blue;
+}
+
+std::vector<uint32_t> pattern_frame(int pitch) {
+    std::vector<uint32_t> pixels(
+        static_cast<std::size_t>(pitch) * kFrameHeight, kSentinel);
+    for (int y = 0; y < kFrameHeight; ++y) {
+        for (int x = 0; x < kFrameWidth; ++x) {
+            pixels[static_cast<std::size_t>(y) * pitch + x] =
+                pattern_pixel(x, y);
+        }
+    }
+    return pixels;
+}
+
+// FNV-1a over the visible pixels, lowest byte of each pixel first, so the
+// digest does not depend on the host's endianness.
+uint64_t fnv1a64(const uint32_t* pixels, int width, int height, int pitch) {
+    uint64_t hash = 0xCBF29CE484222325ull;
+    for (int y = 0; y < height; ++y) {
+        const uint32_t* row = pixels + static_cast<std::ptrdiff_t>(y) * pitch;
+        for (int x = 0; x < width; ++x) {
+            const uint32_t value = row[x];
+            for (int shift = 0; shift < 32; shift += 8) {
+                hash ^= (value >> shift) & 0xFFu;
+                hash *= 0x100000001B3ull;
+            }
+        }
+    }
+    return hash;
+}
+
+std::string first_mismatch(const std::vector<uint32_t>& want,
+                           const std::vector<uint32_t>& got, int width,
+                           int height, int want_pitch, int got_pitch) {
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            const std::size_t want_at =
+                static_cast<std::size_t>(y) * want_pitch + x;
+            const std::size_t got_at =
+                static_cast<std::size_t>(y) * got_pitch + x;
+            if (want[want_at] != got[got_at]) {
+                return "(" + number(x) + ", " + number(y) + "): got " +
+                       hex32(got[got_at]) + ", want " +
+                       hex32(want[want_at]);
+            }
+        }
+    }
+    return std::string();
+}
+
+std::string unwritten_pixels(const std::vector<uint32_t>& pixels, int width,
+                             int height, int pitch) {
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            if (pixels[static_cast<std::size_t>(y) * pitch + x] == kSentinel) {
+                return "(" + number(x) + ", " + number(y) +
+                       ") still holds the sentinel";
+            }
+        }
+    }
+    return std::string();
+}
+
+std::string sentinel_breaks(const std::vector<uint32_t>& pixels) {
+    for (std::size_t at = 0; at < pixels.size(); ++at) {
+        if (pixels[at] != kSentinel) {
+            return "[" + number(static_cast<long long>(at)) + "]: " +
+                   hex32(pixels[at]);
+        }
+    }
+    return std::string();
+}
+
+std::string padding_breaks(const std::vector<uint32_t>& pixels, int width,
+                           int height, int pitch) {
+    for (int y = 0; y < height; ++y) {
+        for (int x = width; x < pitch; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * pitch + x;
+            if (pixels[at] != kSentinel) {
+                return "(" + number(x) + ", " + number(y) + "): " +
+                       hex32(pixels[at]);
+            }
+        }
+    }
+    return std::string();
+}
+
+// Grades one pixel, reporting through `ok` whether the call was accepted.
+uint32_t grade_pixel(const NdsColorLut& lut, uint32_t in, int strength,
+                     bool* ok) {
+    uint32_t out = kSentinel;
+    const bool accepted = apply_lut(lut, &in, &out, 1, 1, 1, strength);
+    if (ok != nullptr) *ok = accepted;
+    return accepted ? out : kSentinel;
+}
+
+// Runs every row of a pin table at full strength and at half strength, plus the
+// alpha byte, which must come through untouched in both.
+void pin_table(const NdsColorLut& lut, const PixelPin* pins, std::size_t count,
+               const char* name) {
+    for (std::size_t at = 0; at < count; ++at) {
+        const PixelPin& pin = pins[at];
+        bool graded_ok = false;
+        const uint32_t graded = grade_pixel(lut, pin.in, 100, &graded_ok);
+        check(graded_ok && graded == pin.graded,
+              std::string(name) + " grades " + hex32(pin.in),
+              "got " + hex32(graded) + ", want " + hex32(pin.graded));
+
+        bool half_ok = false;
+        const uint32_t half = grade_pixel(lut, pin.in, 50, &half_ok);
+        check(half_ok && half == pin.half,
+              std::string(name) + " blends " + hex32(pin.in) + " at 50%",
+              "got " + hex32(half) + ", want " + hex32(pin.half));
+
+        const uint32_t alpha_kept = graded & 0xFF000000u;
+        check(alpha_kept == (pin.in & 0xFF000000u),
+              std::string(name) + " keeps alpha of " + hex32(pin.in),
+              "got " + hex32(alpha_kept) + ", want " +
+                  hex32(pin.in & 0xFF000000u));
+    }
+}
+
+// Asserts a fixture is refused and that the diagnostic names the problem. The
+// two halves are separate checks so a missing rejection and a useless message
+// are told apart in the output.
+void rejects(const std::filesystem::path& path, const std::string& text,
+             const std::string& what, const std::string& expect) {
+    NdsColorLut lut;
+    std::string error;
+    const bool loaded = load_text(path, text, &lut, &error);
+    check(!loaded, "the loader refuses " + what,
+          "accepted it as a " + number(lut.size) + "-node table");
+    check(error.find(expect) != std::string::npos,
+          "the refusal of " + what + " names " + expect,
+          "message was '" + error + "'");
+}
+
+// Asserts a fixture loads and hands back exactly the node count and shape it
+// declares.
+void accepts(const std::filesystem::path& path, const std::string& text,
+             const std::string& what, int size, bool is_3d,
+             std::size_t entries) {
+    NdsColorLut lut;
+    std::string error;
+    const bool loaded = load_text(path, text, &lut, &error);
+    if (!check(loaded, "the loader accepts " + what, "message was '" + error +
+                                                         "'"))
+        return;
+    check(lut.size == size && lut.is_3d == is_3d,
+          "the loader reads the shape of " + what,
+          number(lut.size) + " nodes, 3d = " + (lut.is_3d ? "true" : "false"));
+    check(lut.data.size() == entries * 3u,
+          "the loader reads " + number(static_cast<long long>(entries)) +
+              " entries of " + what,
+          number(static_cast<long long>(lut.data.size() / 3u)) + " entries");
+    check(error.empty(), "a successful load of " + what + " clears the error",
+          "message was '" + error + "'");
+}
+
+std::string table_rows(int count, const char* row) {
+    std::string text;
+    for (int at = 0; at < count; ++at) {
+        text += row;
+        text += '\n';
+    }
+    return text;
+}
+
+// ---------------------------------------------------------------------------
+// Checks
+// ---------------------------------------------------------------------------
+
+void check_constants() {
+    // ---- The struct's documented default state. -------------------------
+    const NdsColorLut fresh;
+    check(fresh.size == 0 && !fresh.is_3d, "a fresh table is empty",
+          number(fresh.size) + " nodes, 3d = " + (fresh.is_3d ? "true"
+                                                             : "false"));
+    check(fresh.data.empty() && fresh.title.empty(),
+          "a fresh table holds no data and no title", "one of them is set");
+    check(!fresh.has_input_range, "a fresh table declares no input range",
+          "has_input_range is already true");
+    check(fresh.domain_min[0] == 0.0f && fresh.domain_min[1] == 0.0f &&
+              fresh.domain_min[2] == 0.0f,
+          "a fresh table's domain starts at 0",
+          hex32(static_cast<uint32_t>(fresh.domain_min[0] * 255.0f)));
+    check(fresh.domain_max[0] == 1.0f && fresh.domain_max[1] == 1.0f &&
+              fresh.domain_max[2] == 1.0f,
+          "a fresh table's domain ends at 1",
+          hex32(static_cast<uint32_t>(fresh.domain_max[0] * 255.0f)));
+    check(kMinLutSize == 2 && kMaxLutSize == 64 && kDefaultStrength == 100,
+          "the constants match the documented values", "a constant drifted");
+}
+
+void check_loader_api(const std::filesystem::path& root) {
+    NdsColorLut lut;
+    std::string error;
+
+    // ---- A missing file, an empty path and a null destination. ----------
+    error.clear();
+    check(!load_cube(narrow(root / "no-such-file.cube"), &lut, &error),
+          "the loader refuses a path that does not exist", "returned true");
+    check(!error.empty(), "a missing file leaves a non-empty message",
+          "the message is empty");
+
+    error.clear();
+    check(!load_cube(std::string(), &lut, &error),
+          "the loader refuses an empty path", "returned true");
+    check(!error.empty(), "an empty path leaves a non-empty message",
+          "the message is empty");
+
+    error.clear();
+    check(!load_cube(narrow(root / "no-such-file.cube"), nullptr, &error),
+          "the loader refuses a null destination", "returned true");
+    check(!error.empty(), "a null destination leaves a non-empty message",
+          "the message is empty");
+
+    // A null error pointer must be survivable, not a crash.
+    check(!load_cube(narrow(root / "no-such-file.cube"), &lut, nullptr),
+          "the loader tolerates a null error pointer", "returned true");
+
+    // ---- A failed load leaves the caller's table untouched. -------------
+    NdsColorLut kept;
+    kept.size = 7;
+    kept.is_3d = true;
+    kept.title = "sentinel";
+    kept.data = {1.0f, 2.0f, 3.0f};
+    error = "stale";
+    check(!load_cube(narrow(root / "no-such-file.cube"), &kept, &error),
+          "a failed load reports failure", "returned true");
+    check(kept.size == 7 && kept.is_3d && kept.title == "sentinel" &&
+              kept.data.size() == 3u,
+          "a failed load leaves the destination untouched",
+          "the table was modified");
+
+    // ---- A directory is not a table. ------------------------------------
+    std::error_code created;
+    const std::filesystem::path directory = root / "a-directory";
+    std::filesystem::create_directories(directory, created);
+    error.clear();
+    check(!load_cube(narrow(directory), &lut, &error),
+          "the loader refuses a directory", "returned true");
+    check(!error.empty(), "refusing a directory leaves a non-empty message",
+          "the message is empty");
+}
+
+void check_directives(const std::filesystem::path& root) {
+    const std::filesystem::path file = root / "directives.cube";
+
+    // ---- Every directive, all on one file. ------------------------------
+    NdsColorLut lut;
+    std::string error;
+    const std::string full =
+        "TITLE \"Warm evening #2\"\n"
+        "DOMAIN_MIN 0.05 0.1 0.15\n"
+        "DOMAIN_MAX 0.9 0.95 1\n"
+        "LUT_3D_INPUT_RANGE 0.1 0.2 0.3 0.9 0.8 0.7\n"
+        "LUT_3D_SIZE 2\n" +
+        table_rows(8, "0.5 0.5 0.5");
+    const bool loaded = load_text(file, full, &lut, &error);
+    if (!check(loaded, "the loader accepts a file with every directive",
+               "message was '" + error + "'"))
+        return;
+    check(lut.title == "Warm evening #2", "a title with spaces is kept whole",
+          "title was '" + lut.title + "'");
+    check(lut.size == 2 && lut.is_3d, "LUT_3D_SIZE sets a 3D table",
+          number(lut.size) + " nodes, 3d = " + (lut.is_3d ? "true" : "false"));
+    check(lut.domain_min[0] == 0.05f && lut.domain_min[1] == 0.1f &&
+              lut.domain_min[2] == 0.15f,
+          "DOMAIN_MIN is read per channel", "the domain does not match");
+    check(lut.domain_max[0] == 0.9f && lut.domain_max[1] == 0.95f &&
+              lut.domain_max[2] == 1.0f,
+          "DOMAIN_MAX is read per channel", "the domain does not match");
+    check(lut.has_input_range, "LUT_3D_INPUT_RANGE is recorded",
+          "has_input_range is false");
+    check(lut.input_range_min[0] == 0.1f && lut.input_range_min[1] == 0.2f &&
+              lut.input_range_min[2] == 0.3f,
+          "a six-number input range is read per channel",
+          "the range does not match");
+    check(lut.input_range_max[0] == 0.9f && lut.input_range_max[1] == 0.8f &&
+              lut.input_range_max[2] == 0.7f,
+          "a six-number input range ends per channel",
+          "the range does not match");
+
+    // ---- A two-number range is one range for all three channels. --------
+    // The range is only legal on a 3D table, so the fixture is a 2^3 grid
+    // rather than the two-row 1D table used for the other directives.
+    const std::string shared_range =
+        "LUT_3D_SIZE 2\nLUT_3D_INPUT_RANGE 0 1\n" +
+        [] {
+            std::string rows;
+            for (int row = 0; row < 8; ++row) {
+                rows += "0 0 0\n";
+            }
+            return rows;
+        }();
+    NdsColorLut shared;
+    error.clear();
+    check(load_text(file, shared_range, &shared, &error) &&
+              shared.has_input_range && shared.input_range_min[0] == 0.0f &&
+              shared.input_range_min[1] == 0.0f &&
+              shared.input_range_min[2] == 0.0f &&
+              shared.input_range_max[0] == 1.0f &&
+              shared.input_range_max[1] == 1.0f &&
+              shared.input_range_max[2] == 1.0f,
+          "a two-number input range applies to every channel",
+          "message was '" + error + "'");
+
+    // ---- Comments, blank lines, CRLF and a UTF-8 BOM. -------------------
+    accepts(file,
+            "# leading comment\n"
+            "\n"
+            "TITLE \"with comments\"   # trailing comment\n"
+            "\n"
+            "LUT_1D_SIZE 2\n"
+            "\n"
+            "# a comment between the directives and the table\n"
+            "0 0 0   # black\n"
+            "1 1 1\n"
+            "\n"
+            "# trailing comment\n",
+            "comments and blank lines", 2, false, 2);
+
+    accepts(file,
+            "LUT_1D_SIZE 2\r\n0 0 0\r\n1 1 1\r\n",
+            "a CRLF file", 2, false, 2);
+
+    accepts(file,
+            std::string("\xEF\xBB\xBF", 3) + "LUT_1D_SIZE 2\n0 0 0\n1 1 1\n",
+            "a file with a UTF-8 BOM", 2, false, 2);
+
+    accepts(file, "LUT_1D_SIZE\t2\n0\t0\t0\n1\t1\t1\n",
+            "a tab-separated file", 2, false, 2);
+
+    // A BOM inside a CRLF file, i.e. what a Windows editor actually writes.
+    accepts(file,
+            std::string("\xEF\xBB\xBF", 3) + "LUT_3D_SIZE 2\r\n" +
+                table_rows(8, "0.5 0.5 0.5"),
+            "a BOM with CRLF line endings", 2, true, 8);
+
+    // ---- Refusals, each with the diagnostic that names the problem. -----
+    rejects(file, std::string("\xFF\xFE", 2) + "LUT_1D_SIZE 2\n",
+            "a UTF-16 file", "UTF-16");
+    rejects(file, "LUT_2D_SIZE 2\n0 0 0\n0 0 0\n0 0 0\n",
+            "a 2D size directive", "unknown directive");
+    rejects(file, "LUT_3D_SISE 2\n", "a misspelled size directive",
+            "unknown directive");
+    rejects(file, "LUT_3D_SIZE 2\nGREYSCALE 1\n", "an unknown directive",
+            "unknown directive");
+    rejects(file, "TITLE hello\nLUT_1D_SIZE 2\n", "an unquoted title",
+            "quoted string");
+    rejects(file, "TITLE \"unclosed\nLUT_1D_SIZE 2\n", "an unclosed title",
+            "closing quote");
+    rejects(file, "TITLE \"two\" \"titles\"\nLUT_1D_SIZE 2\n",
+            "a second quoted string on the title line", "after the closing");
+    rejects(file,
+            "TITLE \"a\"\nTITLE \"b\"\nLUT_1D_SIZE 2\n0 0 0\n1 1 1\n",
+            "two TITLE directives", "more than once");
+    rejects(file,
+            "LUT_1D_SIZE 2\nDOMAIN_MIN 0 0 0\nDOMAIN_MIN 0 0 0\n"
+            "0 0 0\n1 1 1\n",
+            "two DOMAIN_MIN directives", "more than once");
+    rejects(file,
+            "LUT_1D_SIZE 2\nDOMAIN_MAX 1 1 1\nDOMAIN_MAX 1 1 1\n"
+            "0 0 0\n1 1 1\n",
+            "two DOMAIN_MAX directives", "more than once");
+    rejects(file, "LUT_1D_SIZE 2\nDOMAIN_MIN 0 0\n0 0 0\n1 1 1\n",
+            "a DOMAIN_MIN with two numbers", "needs 3 numbers");
+    rejects(file, "LUT_1D_SIZE 2\nDOMAIN_MIN 0 zero 0\n",
+            "a DOMAIN_MIN with a word", "not a number");
+    rejects(file, "LUT_1D_SIZE 2\nDOMAIN_MIN 1 0 0\nDOMAIN_MAX 1 1 1\n"
+                  "0 0 0\n1 1 1\n",
+            "a reversed domain", "above DOMAIN_MIN");
+    rejects(file,
+            "LUT_3D_SIZE 2\nLUT_3D_INPUT_RANGE 0 1\nLUT_3D_INPUT_RANGE 0 1\n",
+            "two LUT_3D_INPUT_RANGE directives", "more than once");
+    rejects(file, "LUT_3D_SIZE 2\nLUT_3D_INPUT_RANGE 0 1 0 1\n",
+            "an input range with four numbers", "needs 2 or 6 numbers");
+    rejects(file, "LUT_1D_SIZE 2\nLUT_3D_INPUT_RANGE 0 1\n0 0 0\n1 1 1\n",
+            "an input range on a 1D table", "applies to a 3D table");
+    rejects(file, "LUT_1D_SIZE 2\nLUT_3D_SIZE 2\n",
+            "both size directives", "cannot be combined");
+    rejects(file, "LUT_1D_SIZE 2\nLUT_1D_SIZE 2\n0 0 0\n1 1 1\n",
+            "a repeated size directive", "more than once");
+    rejects(file, "LUT_1D_SIZE 2\n0 0 0\nTITLE \"late\"\n",
+            "a directive after the first table row", "after the first table");
+}
+
+void check_table_shape(const std::filesystem::path& root) {
+    const std::filesystem::path file = root / "shape.cube";
+
+    // ---- Valid shapes. -------------------------------------------------
+    accepts(file, "LUT_1D_SIZE 2\n0 0 0\n1 1 1\n", "a two-node 1D table", 2,
+            false, 2);
+    accepts(file, "LUT_3D_SIZE 2\n" + table_rows(8, "0 0 0"),
+            "a two-node 3D table", 2, true, 8);
+    {
+        NdsColorLut lut;
+        std::string error;
+        check(load_text(file,
+                        "LUT_1D_SIZE 3\n0.25 0.5 0.75\n0.5 0.5 0.5\n1 1 1\n",
+                        &lut, &error),
+              "the loader accepts a three-node 1D table",
+              "message was '" + error + "'");
+        check(lut.data.size() == 9u && lut.data[0] == 0.25f &&
+                  lut.data[1] == 0.5f && lut.data[2] == 0.75f,
+              "table rows are stored red, green, blue",
+              "the first row was reordered");
+    }
+
+    // ---- Node order is red-fastest, as the format says. ----------------
+    {
+        // Row i is (i, i*2, i*3) for i in 0..7. Red fastest means node
+        // (r, g, b) is row r + 2*g + 4*b, so row 1 must be the node with red
+        // one, and row 4 the node with blue one.
+        std::string text = "LUT_3D_SIZE 2\n";
+        for (int row = 0; row < 8; ++row) {
+            text += number(row) + " " + number(row * 2) + " " +
+                    number(row * 3) + "\n";
+        }
+        NdsColorLut lut;
+        std::string error;
+        const bool ok = load_text(file, text, &lut, &error);
+        check(ok, "the loader accepts an eight-row 3D fixture",
+              "message was '" + error + "'");
+        check(ok && lut.data.size() == 24u,
+              "an eight-row 3D table has 24 floats",
+              number(static_cast<long long>(lut.data.size())) + " floats");
+        // The node with red one, green zero, blue zero is row 1.
+        check(ok && lut.data[3] == 1.0f && lut.data[4] == 2.0f &&
+                  lut.data[5] == 3.0f,
+              "row 1 is the node with red set",
+              "row 1 is not at index 1");
+        // The node with red zero, green one, blue zero is row 2.
+        check(ok && lut.data[6] == 2.0f && lut.data[7] == 4.0f &&
+                  lut.data[8] == 6.0f,
+              "row 2 is the node with green set",
+              "row 2 is not at index 2");
+        // The node with the blue bit set is row 4.
+        check(ok && lut.data[12] == 4.0f && lut.data[13] == 8.0f &&
+                  lut.data[14] == 12.0f,
+              "row 4 is the node with blue set (red fastest)",
+              "the blue axis is not the slowest");
+    }
+
+    // ---- Values outside 0..1 are kept, not rejected. -------------------
+    {
+        NdsColorLut lut;
+        std::string error;
+        const bool ok =
+            load_text(file, "LUT_1D_SIZE 2\n-0.25 -0.25 -0.25\n1.5 1.5 1.5\n",
+                      &lut, &error);
+        check(ok, "the loader accepts extended-range values",
+              "message was '" + error + "'");
+        check(ok && lut.data[0] == -0.25f && lut.data[3] == 1.5f,
+              "extended-range values are kept exactly as written",
+              "a value was clamped at load time");
+    }
+
+    // ---- Refusals. -----------------------------------------------------
+    rejects(file, "", "an empty file", "no LUT_1D_SIZE");
+    rejects(file, "# only a comment\n", "a file of comments only",
+            "no LUT_1D_SIZE");
+    rejects(file, "TITLE \"no size\"\n0 0 0\n1 1 1\n",
+            "a file with no size directive", "no LUT_1D_SIZE");
+    rejects(file, "LUT_1D_SIZE 2\n0 0 0\n", "a truncated 1D table",
+            "expected 2 table entries");
+    rejects(file, "LUT_1D_SIZE 2\n0 0 0\n1 1 1\n0.5 0.5 0.5\n",
+            "an over-long 1D table", "expected 2 table entries");
+    rejects(file, "LUT_3D_SIZE 2\n" + table_rows(7, "0 0 0"),
+            "a 3D table one row short", "expected 8 table entries");
+    rejects(file, "LUT_3D_SIZE 2\n" + table_rows(9, "0 0 0"),
+            "a 3D table one row long", "expected 8 table entries");
+    rejects(file, "LUT_3D_SIZE 2\n", "a 3D table with no rows",
+            "expected 8 table entries");
+    rejects(file, "LUT_3D_SIZE 65\n", "LUT_3D_SIZE 65", "maximum of 64");
+    rejects(file, "LUT_3D_SIZE 65\n" + table_rows(8, "0 0 0"),
+            "LUT_3D_SIZE 65 with data", "maximum of 64");
+    rejects(file, "LUT_3D_SIZE 1000\n", "LUT_3D_SIZE 1000", "maximum of 64");
+    rejects(file, "LUT_1D_SIZE 1\n0 0 0\n", "LUT_1D_SIZE 1",
+            "minimum of 2");
+    rejects(file, "LUT_3D_SIZE 0\n", "LUT_3D_SIZE 0", "minimum of 2");
+    rejects(file, "LUT_3D_SIZE -4\n", "a negative size", "minimum of 2");
+    rejects(file, "LUT_3D_SIZE two\n", "a size that is a word",
+            "needs an integer");
+    rejects(file, "LUT_3D_SIZE 2.5\n", "a fractional size",
+            "needs an integer");
+    rejects(file, "LUT_1D_SIZE 2\n0 0\n", "a row with two numbers",
+            "needs 3 numbers");
+    rejects(file, "LUT_1D_SIZE 2\n0 0 0 0\n", "a row with four numbers",
+            "needs 3 numbers");
+    rejects(file, "LUT_1D_SIZE 2\n0 x 0\n", "a row with a word",
+            "not a number");
+    rejects(file, "LUT_1D_SIZE 2\n0 0 0\n1 1\n", "a truncated second row",
+            "needs 3 numbers");
+
+    // ---- A diagnostic names the line it came from. ---------------------
+    {
+        NdsColorLut lut;
+        std::string error;
+        const bool loaded = load_text(
+            file, "LUT_1D_SIZE 2\n\n0 0 0\n\nBOGUS 1\n", &lut, &error);
+        check(!loaded, "a bad directive on line 5 is refused", "returned true");
+        check(error.find("line 5") != std::string::npos,
+              "the message names line 5", "message was '" + error + "'");
+    }
+}
+
+void check_sampler_3d(const std::filesystem::path& root) {
+    // ---- The hand-derivable size-2 swap table. -------------------------
+    const NdsColorLut swapped = build_swapped();
+    pin_table(swapped, kSwapPins, sizeof(kSwapPins) / sizeof(kSwapPins[0]),
+              "the swap table");
+    check(identity_lut(swapped) == false,
+          "the swap table is not reported as the identity", "reported as one");
+
+    // ---- The same table, loaded from text. -----------------------------
+    {
+        NdsColorLut loaded_lut;
+        std::string error;
+        const bool ok = load_text(root / "swap.cube", swap_cube_text(),
+                                  &loaded_lut, &error);
+        if (check(ok, "the swap fixture loads from a file",
+                  "message was '" + error + "'")) {
+            const std::size_t count = sizeof(kSwapPins) / sizeof(kSwapPins[0]);
+            std::string drift;
+            for (std::size_t at = 0; at < count; ++at) {
+                bool accepted = false;
+                const uint32_t got =
+                    grade_pixel(loaded_lut, kSwapPins[at].in, 100, &accepted);
+                if (!accepted || got != kSwapPins[at].graded) {
+                    drift = hex32(kSwapPins[at].in) + " -> " + hex32(got) +
+                            ", want " + hex32(kSwapPins[at].graded);
+                    break;
+                }
+            }
+            check(drift.empty(),
+                  "a table loaded from a file grades like the hand-built one",
+                  drift);
+            check(loaded_lut.title == "red/blue swap",
+                  "the loaded table keeps its title",
+                  "title was '" + loaded_lut.title + "'");
+        }
+    }
+
+    // ---- The size-3 rotation and the size-5 drop. ----------------------
+    pin_table(build_rotate_3d(), kRotatePins,
+              sizeof(kRotatePins) / sizeof(kRotatePins[0]),
+              "the rotation table");
+    pin_table(build_size5_3d(), kSize5Pins,
+              sizeof(kSize5Pins) / sizeof(kSize5Pins[0]), "the size-5 table");
+    pin_table(build_gray_mean_3d(), kGrayMeanPins,
+              sizeof(kGrayMeanPins) / sizeof(kGrayMeanPins[0]),
+              "the grey-mean table");
+    pin_table(build_input_range_3d(), kInputRangePins,
+              sizeof(kInputRangePins) / sizeof(kInputRangePins[0]),
+              "the input-range table");
+    pin_table(build_range6_swap(), kRange6Pins,
+              sizeof(kRange6Pins) / sizeof(kRange6Pins[0]),
+              "the six-number range table");
+
+    // ---- LUT_3D_INPUT_RANGE wins over DOMAIN_MIN/MAX. ------------------
+    {
+        // The same identity table twice: once with only a domain, once with
+        // both. An input of 64 is 0.251 normalised; over a 0.2..0.8 domain it
+        // lands at 0.08497 and grades to 22 (0x16), while a 0..0.5 input range
+        // puts it at 0.50196 and grades to 128 (0x80).
+        std::string identity_rows;
+        for (int blue = 0; blue < 2; ++blue) {
+            for (int green = 0; green < 2; ++green) {
+                for (int red = 0; red < 2; ++red) {
+                    identity_rows += number(red) + " " + number(green) + " " +
+                                     number(blue) + "\n";
+                }
+            }
+        }
+        NdsColorLut domain_only;
+        NdsColorLut both;
+        std::string error;
+        const bool domain_ok = load_text(
+            root / "domain.cube",
+            "DOMAIN_MIN 0.2 0.2 0.2\nDOMAIN_MAX 0.8 0.8 0.8\n"
+            "LUT_3D_SIZE 2\n" +
+                identity_rows,
+            &domain_only, &error);
+        check(domain_ok, "a 3D table with a domain loads",
+              "message was '" + error + "'");
+        bool accepted = false;
+        const uint32_t domain_pixel =
+            grade_pixel(domain_only, 0xFF404040u, 100, &accepted);
+        check(accepted && domain_pixel == 0xFF161616u,
+              "a 3D table maps its input through the domain",
+              "got " + hex32(domain_pixel) + ", want 0xFF161616");
+
+        error.clear();
+        const bool both_ok = load_text(
+            root / "range-wins.cube",
+            "DOMAIN_MIN 0.2 0.2 0.2\nDOMAIN_MAX 0.8 0.8 0.8\n"
+            "LUT_3D_INPUT_RANGE 0 0.5\n"
+            "LUT_3D_SIZE 2\n" +
+                identity_rows,
+            &both, &error);
+        check(both_ok, "a 3D table with a domain and an input range loads",
+              "message was '" + error + "'");
+        accepted = false;
+        const uint32_t both_pixel = grade_pixel(both, 0xFF404040u, 100,
+                                               &accepted);
+        check(accepted && both_pixel == 0xFF808080u,
+              "LUT_3D_INPUT_RANGE wins over DOMAIN_MIN/MAX",
+              "got " + hex32(both_pixel) + ", want 0xFF808080");
+    }
+
+    // ---- A 3D table whose input range is degenerate is refused. -------
+    {
+        const std::string rows = table_rows(8, "0 0 0");
+        rejects(root / "degenerate.cube",
+                "LUT_3D_SIZE 2\nLUT_3D_INPUT_RANGE 0.5 0.5\n" + rows,
+                "a zero-width input range", "empty on");
+        rejects(root / "reversed.cube",
+                "LUT_3D_SIZE 2\nLUT_3D_INPUT_RANGE 0.9 0.1\n" + rows,
+                "a reversed input range", "empty on");
+    }
+}
+
+void check_sampler_1d(const std::filesystem::path& root) {
+    pin_table(build_ramp_1d(), kRampPins,
+              sizeof(kRampPins) / sizeof(kRampPins[0]), "the ramp table");
+    pin_table(build_half_1d(), kHalfPins,
+              sizeof(kHalfPins) / sizeof(kHalfPins[0]), "the half table");
+    pin_table(build_domain_1d(), kDomainPins,
+              sizeof(kDomainPins) / sizeof(kDomainPins[0]),
+              "the domain table");
+    pin_table(build_rose_1d(), kRosePins,
+              sizeof(kRosePins) / sizeof(kRosePins[0]), "the rose table");
+    pin_table(build_extended_1d(), kExtendedPins,
+              sizeof(kExtendedPins) / sizeof(kExtendedPins[0]),
+              "the extended-range table");
+
+    // ---- A 1D table loaded from text grades the same way. -------------
+    {
+        NdsColorLut lut;
+        std::string error;
+        const bool ok = load_text(
+            root / "ramp.cube",
+            "TITLE \"ramp\"\nLUT_1D_SIZE 2\n0.25 0.5 0.75\n1 1 1\n", &lut,
+            &error);
+        if (check(ok, "the ramp fixture loads from a file",
+                  "message was '" + error + "'")) {
+            const std::size_t count = sizeof(kRampPins) / sizeof(kRampPins[0]);
+            std::string drift;
+            for (std::size_t at = 0; at < count; ++at) {
+                const uint32_t got = grade_pixel(lut, kRampPins[at].in, 100,
+                                                nullptr);
+                if (got != kRampPins[at].graded) {
+                    drift = hex32(kRampPins[at].in) + " -> " + hex32(got) +
+                            ", want " + hex32(kRampPins[at].graded);
+                    break;
+                }
+            }
+            check(drift.empty(), "a 1D table loaded from a file grades exactly",
+                  drift);
+        }
+    }
+
+    // ---- A 1D table's nodes are shared by all three channels. ---------
+    {
+        // Nodes (0, 0, 0) and (1, 0.5, 0.25): an input of 0xFF4080C0 reads
+        // each channel's own position on the shared curve, so red is graded by
+        // the red component of the node pair and not by the red byte of the
+        // input again.
+        NdsColorLut lut;
+        std::string error;
+        const bool ok = load_text(root / "per-channel.cube",
+                                  "LUT_1D_SIZE 2\n0 0 0\n1 0.5 0.25\n", &lut,
+                                  &error);
+        check(ok, "a per-channel 1D table loads",
+              "message was '" + error + "'");
+        bool accepted = false;
+        const uint32_t graded = grade_pixel(lut, 0xFF4080C0u, 100, &accepted);
+        // red 0x40 -> 255 * 64/255 = 64 = 0x40; green: 0.5 curve at 128/255 =
+        // 0.25098 -> 64 = 0x40; blue: 0.25 curve at 192/255 = 0.18824 -> 48.
+        check(accepted && graded == 0xFF404030u,
+              "a 1D table grades each channel through its own component",
+              "got " + hex32(graded) + ", want 0xFF404030");
+    }
+}
+
+void check_strength(const std::filesystem::path& root) {
+    (void)root;
+    const NdsColorLut lut = build_swapped();
+
+    // ---- Strength 0 is a bit-exact copy of the input. -----------------
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+    std::vector<uint32_t> flat(static_cast<std::size_t>(kFrameWidth) *
+                                   kFrameHeight,
+                               kSentinel);
+    const bool copied = apply_lut(lut, source.data(), flat.data(), kFrameWidth,
+                                  kFrameHeight, kFrameWidth, 0);
+    check(copied, "a strength of 0 is accepted", "returned false");
+    check(std::memcmp(flat.data(), source.data(),
+                      flat.size() * sizeof(uint32_t)) == 0,
+          "a strength of 0 is a bit-exact copy",
+          first_mismatch(source, flat, kFrameWidth, kFrameHeight, kFrameWidth,
+                         kFrameWidth));
+
+    // ---- The default strength is the full grade. ----------------------
+    uint32_t pinned = 0;
+    uint32_t by_default = 0;
+    check(apply_lut(lut, &kSwapPins[0].in, &pinned, 1, 1, 1, 100) &&
+              apply_lut(lut, &kSwapPins[0].in, &by_default, 1, 1, 1),
+          "both strength spellings are accepted", "returned false");
+    check(by_default == pinned && pinned == kSwapPins[0].graded,
+          "the default strength is the full grade",
+          "default " + hex32(by_default) + ", full " + hex32(pinned));
+
+    // ---- Out-of-range strengths are clamped, not rejected. ------------
+    bool accepted = false;
+    const uint32_t high = grade_pixel(lut, kSwapPins[0].in, 150, &accepted);
+    check(accepted && high == kSwapPins[0].graded,
+          "a strength of 150 is clamped to the full grade",
+          "got " + hex32(high));
+    const uint32_t low = grade_pixel(lut, kSwapPins[0].in, -20, &accepted);
+    check(accepted && low == kSwapPins[0].in,
+          "a strength of -20 is clamped to the original",
+          "got " + hex32(low));
+
+    // ---- The blend is linear and rounded once, after the blend. ------
+    {
+        // Swap table, input 0xFF204060: red 0x20, green 0x40, blue 0x60.
+        // Graded is 0xFF604020. At 25% red is 0x20 + (0x60 - 0x20) * 0.25 =
+        // 0x30, green stays 0x40, blue is 0x60 + (0x20 - 0x60) * 0.25 = 0x50.
+        const uint32_t quarter = grade_pixel(lut, 0xFF204060u, 25, &accepted);
+        check(accepted && quarter == 0xFF304050u,
+              "a 25% blend rounds once after the blend",
+              "got " + hex32(quarter) + ", want 0xFF304050");
+        // 0xFF010101 at 50%: graded 0xFF010100, so blue is 1 + (0 - 1) * 0.5 =
+        // 0.5, which rounds away from zero to 1 rather than to 0.
+        const uint32_t tie = grade_pixel(lut, 0xFF010101u, 50, &accepted);
+        check(accepted && tie == 0xFF010101u,
+              "a half-level blend rounds away from zero",
+              "got " + hex32(tie) + ", want 0xFF010101");
+    }
+}
+
+void check_identity() {
+    // ---- make_identity_lut covers both shapes and every size. ---------
+    const int sizes[] = {2, 3, 4, 5, 7, 16, 17, 64};
+    for (int is_3d = 0; is_3d < 2; ++is_3d) {
+        for (const int size : sizes) {
+            const NdsColorLut lut = make_identity_lut(size, is_3d != 0);
+            const std::string what =
+                number(size) + "-node " + (is_3d != 0 ? "3D" : "1D");
+            if (!check(lut.size == size && lut.is_3d == (is_3d != 0),
+                       "make_identity_lut builds a " + what + " table",
+                       number(lut.size) + " nodes, 3d = " +
+                           (lut.is_3d ? "true" : "false")))
+                continue;
+            const std::size_t nodes = is_3d != 0
+                                          ? static_cast<std::size_t>(size) *
+                                                size * size
+                                          : static_cast<std::size_t>(size);
+            check(lut.data.size() == nodes * 3u,
+                  "the " + what + " identity holds " +
+                      number(static_cast<long long>(nodes)) + " nodes",
+                  number(static_cast<long long>(lut.data.size() / 3u)) +
+                      " nodes");
+            check(identity_lut(lut), "identity_lut() agrees the " + what +
+                                         " table is the identity",
+                  "reported as a real grade");
+        }
+    }
+
+    // Clamping is documented: a settings value straight off a text file can be
+    // out of range and must still produce a usable table.
+    check(make_identity_lut(1, true).size == kMinLutSize,
+          "make_identity_lut clamps a size of 1 up to the minimum",
+          number(make_identity_lut(1, true).size));
+    check(make_identity_lut(65, true).size == kMaxLutSize,
+          "make_identity_lut clamps a size of 65 down to the maximum",
+          number(make_identity_lut(65, true).size));
+    check(make_identity_lut(0, false).size == kMinLutSize,
+          "make_identity_lut clamps a size of 0 up to the minimum",
+          number(make_identity_lut(0, false).size));
+
+    // ---- The identity is bit-exact through the sampler, at any size. --
+    {
+        std::string drift;
+        for (const int size : sizes) {
+            for (int is_3d = 0; is_3d < 2; ++is_3d) {
+                const NdsColorLut lut = make_identity_lut(size, is_3d != 0);
+                for (int value = 0; value < 256 && drift.empty(); value += 1) {
+                    const uint32_t in = (0xFFu << 24) |
+                                        (static_cast<uint32_t>(value) << 16) |
+                                        (static_cast<uint32_t>(255 - value)
+                                         << 8) |
+                                        static_cast<uint32_t>(value / 2);
+                    bool accepted = false;
+                    const uint32_t out = grade_pixel(lut, in, 100, &accepted);
+                    if (!accepted || out != in) {
+                        drift = "size " + number(size) + ", " +
+                                (is_3d != 0 ? "3D" : "1D") + ", " + hex32(in) +
+                                " -> " + hex32(out);
+                    }
+                }
+            }
+        }
+        check(drift.empty(),
+              "every built-in identity table is a bit-exact passthrough at "
+              "100%",
+              drift);
+    }
+
+    // ---- A table that is not the identity is not called one. ----------
+    check(!identity_lut(build_swapped()),
+          "identity_lut() rejects a table that swaps two channels",
+          "reported as the identity");
+    check(!identity_lut(build_ramp_1d()),
+          "identity_lut() rejects a 1D curve that is not v -> v",
+          "reported as the identity");
+    check(!identity_lut(build_domain_1d()),
+          "identity_lut() rejects the identity over a narrower domain",
+          "reported as the identity");
+    {
+        NdsColorLut unsound = make_identity_lut(2, true);
+        unsound.data.pop_back();
+        check(!identity_lut(unsound),
+              "identity_lut() rejects a table whose data is short",
+              "reported as the identity");
+        NdsColorLut wrong_size = make_identity_lut(2, true);
+        wrong_size.size = 5;
+        check(!identity_lut(wrong_size),
+              "identity_lut() rejects a table whose size disagrees with its "
+              "data",
+              "reported as the identity");
+    }
+
+    // ---- A table loaded from a file is recognised as the identity. ----
+    check(identity_lut(make_identity_lut(2, false)),
+          "the identity survives the round trip through its own type",
+          "reported as a real grade");
+}
+
+void check_rejections() {
+    const NdsColorLut lut = build_swapped();
+    std::vector<uint32_t> surface(static_cast<std::size_t>(4) * 4, kSentinel);
+    std::vector<uint32_t> source(static_cast<std::size_t>(4) * 4, 0xFF000000u);
+
+    struct Case {
+        const char* name;
+        const uint32_t* in;
+        uint32_t* out;
+        int width;
+        int height;
+        int pitch;
+    };
+    std::vector<Case> cases;
+    cases.push_back({"a null input", nullptr, surface.data(), 4, 4, 4});
+    cases.push_back({"a null output", source.data(), nullptr, 4, 4, 4});
+    cases.push_back({"two null buffers", nullptr, nullptr, 4, 4, 4});
+    cases.push_back({"width 0", source.data(), surface.data(), 0, 4, 4});
+    cases.push_back({"width -1", source.data(), surface.data(), -1, 4, 4});
+    cases.push_back({"height 0", source.data(), surface.data(), 4, 0, 4});
+    cases.push_back({"height -1", source.data(), surface.data(), 4, -1, 4});
+    cases.push_back({"a pitch below the width", source.data(),
+                     surface.data(), 4, 4, 3});
+    cases.push_back({"a negative pitch", source.data(), surface.data(), 4, 4,
+                     -1});
+
+    for (const Case& tc : cases) {
+        surface.assign(surface.size(), kSentinel);
+        const bool accepted = apply_lut(lut, tc.in, tc.out, tc.width, tc.height,
+                                        tc.pitch, 100);
+        check(!accepted, std::string("apply_lut() rejects ") + tc.name,
+              "returned true");
+        const std::string breaks = sentinel_breaks(surface);
+        check(breaks.empty(),
+              std::string("a rejected call (") + tc.name +
+                  ") leaves the surface untouched",
+              breaks);
+    }
+
+    // ---- A structurally unsound table is refused, not sampled. --------
+    {
+        const uint32_t pixel = 0xFF4080C0u;
+        uint32_t out = kSentinel;
+        NdsColorLut short_data = build_swapped();
+        short_data.data.pop_back();
+        check(!apply_lut(short_data, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table whose data is too short",
+              "returned true");
+        check(out == kSentinel,
+              "a rejected short table leaves the output untouched",
+              "the output was written");
+
+        NdsColorLut long_data = build_swapped();
+        long_data.data.push_back(0.0f);
+        check(!apply_lut(long_data, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table whose data is too long",
+              "returned true");
+
+        NdsColorLut small = build_swapped();
+        small.size = 1;
+        check(!apply_lut(small, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table sized below the minimum",
+              "returned true");
+
+        NdsColorLut huge = make_identity_lut(2, true);
+        huge.size = 65;
+        check(!apply_lut(huge, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table sized above the maximum",
+              "returned true");
+
+        NdsColorLut empty_table = build_swapped();
+        empty_table.data.clear();
+        check(!apply_lut(empty_table, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table with no data", "returned true");
+
+        NdsColorLut flat_domain = build_domain_1d();
+        flat_domain.domain_min[1] = 0.8f;
+        check(!apply_lut(flat_domain, &pixel, &out, 1, 1, 1, 100),
+              "apply_lut() rejects a table with a zero-width domain",
+              "returned true");
+    }
+}
+
+void check_aliasing() {
+    const NdsColorLut lut = build_swapped();
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+
+    // ---- In place equals out of place, bit for bit. -------------------
+    std::vector<uint32_t> apart(static_cast<std::size_t>(kFrameWidth) *
+                                    kFrameHeight,
+                                kSentinel);
+    std::vector<uint32_t> in_place = source;
+    const bool apart_ok =
+        apply_lut(lut, source.data(), apart.data(), kFrameWidth, kFrameHeight,
+                  kFrameWidth, 100);
+    const bool in_place_ok =
+        apply_lut(lut, in_place.data(), in_place.data(), kFrameWidth,
+                  kFrameHeight, kFrameWidth, 100);
+    check(apart_ok && in_place_ok, "both the aliased and the copied pass run",
+          "one of them returned false");
+    const std::string aliasing = first_mismatch(
+        apart, in_place, kFrameWidth, kFrameHeight, kFrameWidth, kFrameWidth);
+    check(aliasing.empty(),
+          "an in-place pass equals an out-of-place pass",
+          aliasing);
+
+    // A strength of 0 in place is a copy onto itself, which is the one path
+    // where a plain memcpy would be undefined.
+    std::vector<uint32_t> self_copy = source;
+    check(apply_lut(lut, self_copy.data(), self_copy.data(), kFrameWidth,
+                    kFrameHeight, kFrameWidth, 0),
+          "a strength of 0 accepts an aliased buffer", "returned false");
+    check(std::memcmp(self_copy.data(), source.data(),
+                      source.size() * sizeof(uint32_t)) == 0,
+          "an aliased copy at strength 0 changes nothing",
+          first_mismatch(source, self_copy, kFrameWidth, kFrameHeight,
+                         kFrameWidth, kFrameWidth));
+
+    // ---- A padded row's tail is never written. ------------------------
+    {
+        const int width = 5;
+        const int height = 3;
+        const int pitch = 8;
+        std::vector<uint32_t> padded(
+            static_cast<std::size_t>(pitch) * height, kSentinel);
+        for (int y = 0; y < height; ++y) {
+            for (int x = 0; x < width; ++x) {
+                padded[static_cast<std::size_t>(y) * pitch + x] =
+                    0xFF010203u;
+            }
+        }
+        check(apply_lut(lut, padded.data(), padded.data(), width, height,
+                        pitch, 100),
+              "a padded surface is accepted", "returned false");
+        const std::string padding =
+            padding_breaks(padded, width, height, pitch);
+        check(padding.empty(), "the padding after a padded row is untouched",
+              padding);
+        const std::string unwritten =
+            unwritten_pixels(padded, width, height, pitch);
+        check(unwritten.empty(), "every visible pixel of a padded row is "
+                                 "written",
+              unwritten);
+    }
+}
+
+void check_frames() {
+    const std::vector<uint32_t> source = pattern_frame(kFrameWidth);
+
+    struct Case {
+        const char* name;
+        NdsColorLut lut;
+        int strength;
+        uint64_t digest;
+    };
+    // The digests are FNV-1a-64 over the visible pixels, lowest byte first,
+    // computed from the fixtures by hand -- with the exception of the identity
+    // row, which must equal the input frame's own digest.
+    std::vector<Case> cases;
+    cases.push_back({"the swap table", build_swapped(), 100,
+                     0x333230C33EDD1925ull});
+    cases.push_back({"the swap table at 50%", build_swapped(), 50,
+                     0xDC5517EAFA9ACAA5ull});
+    cases.push_back({"the swap table at 0%", build_swapped(), 0,
+                     0xB80F5E3A744BA6A5ull});
+    cases.push_back({"the rotation table", build_rotate_3d(), 100,
+                     0x52A9A8B2B74963A5ull});
+    cases.push_back({"the six-number range table", build_range6_swap(), 100,
+                     0x4FAAD480D6DDF82Dull});
+    cases.push_back({"the ramp table", build_ramp_1d(), 100,
+                     0x332782919E4A006Dull});
+    cases.push_back({"the domain table", build_domain_1d(), 100,
+                     0xA10CA26B05707EE5ull});
+    cases.push_back({"the identity table", make_identity_lut(2, true), 100,
+                     0xB80F5E3A744BA6A5ull});
+
+    for (const Case& tc : cases) {
+        std::vector<uint32_t> out(static_cast<std::size_t>(kFrameWidth) *
+                                      kFrameHeight,
+                                  kSentinel);
+        const bool ok = apply_lut(tc.lut, source.data(), out.data(),
+                                  kFrameWidth, kFrameHeight, kFrameWidth,
+                                  tc.strength);
+        const std::string unwritten =
+            unwritten_pixels(out, kFrameWidth, kFrameHeight, kFrameWidth);
+        check(ok && unwritten.empty(),
+              std::string(tc.name) + ": every pixel is written", unwritten);
+        const uint64_t digest =
+            fnv1a64(out.data(), kFrameWidth, kFrameHeight, kFrameWidth);
+        check(digest == tc.digest,
+              std::string(tc.name) + " hashes as the pinned frame",
+              hex64(digest) + ", want " + hex64(tc.digest));
+    }
+
+    // ---- The pass is deterministic. -----------------------------------
+    {
+        std::vector<uint32_t> first_run(static_cast<std::size_t>(kFrameWidth) *
+                                            kFrameHeight,
+                                        kSentinel);
+        std::vector<uint32_t> second_run(first_run.size(), kSentinel);
+        const NdsColorLut lut = build_rotate_3d();
+        apply_lut(lut, source.data(), first_run.data(), kFrameWidth,
+                  kFrameHeight, kFrameWidth, 37);
+        apply_lut(lut, source.data(), second_run.data(), kFrameWidth,
+                  kFrameHeight, kFrameWidth, 37);
+        check(first_run == second_run,
+              "two passes over the same frame are identical",
+              first_mismatch(first_run, second_run, kFrameWidth, kFrameHeight,
+                             kFrameWidth, kFrameWidth));
+    }
+
+    // ---- The identity leaves the frame's digest alone, and the swap
+    //      changes it, otherwise every digest above could pass by luck. --
+    {
+        std::vector<uint32_t> out(static_cast<std::size_t>(kFrameWidth) *
+                                      kFrameHeight,
+                                  kSentinel);
+        const NdsColorLut identity = make_identity_lut(2, true);
+        check(apply_lut(identity, source.data(), out.data(), kFrameWidth,
+                        kFrameHeight, kFrameWidth, 100),
+              "the identity accepts the reference frame", "returned false");
+        check(std::memcmp(out.data(), source.data(),
+                          source.size() * sizeof(uint32_t)) == 0,
+              "the identity leaves the reference frame bit for bit alone",
+              first_mismatch(source, out, kFrameWidth, kFrameHeight,
+                             kFrameWidth, kFrameWidth));
+
+        std::vector<uint32_t> graded(out.size(), kSentinel);
+        const NdsColorLut swap = build_swapped();
+        check(apply_lut(swap, source.data(), graded.data(), kFrameWidth,
+                        kFrameHeight, kFrameWidth, 100),
+              "the swap table accepts the reference frame", "returned false");
+        check(std::memcmp(graded.data(), source.data(),
+                          source.size() * sizeof(uint32_t)) != 0,
+              "the swap table actually changes the reference frame",
+              "the output equals the input");
+    }
+}
+
+void check_utf8_path(const std::filesystem::path& root) {
+    // A directory and a file whose names are not ASCII: the loader takes a
+    // UTF-8 std::string and must reach the file the caller meant, which on
+    // Windows means converting through char8_t rather than the ANSI code page.
+    const std::filesystem::path directory =
+        root / from_utf8("grades-\xC3\xA9t\xC3\xA9");
+    std::error_code created;
+    std::filesystem::create_directories(directory, created);
+    const std::filesystem::path file =
+        directory / from_utf8("chaud-\xCE\xA9.cube");
+    NdsColorLut lut;
+    std::string error;
+    const bool ok =
+        load_text(file, "TITLE \"chaud\"\nLUT_1D_SIZE 2\n0 0 0\n1 1 1\n", &lut,
+                  &error);
+    check(ok, "a table in a non-ASCII directory loads",
+          "message was '" + error + "', path '" + narrow(file) + "'");
+    check(lut.title == "chaud",
+          "the non-ASCII table is the one that was written",
+          "title was '" + lut.title + "'");
+
+    // The same name again, this time spelled in the ANSI code page a caller
+    // would get from path::string() on a machine whose code page cannot hold
+    // it. Nothing is pinned about how that fails; what is pinned is that it
+    // does not load the file, i.e. the two spellings are not interchangeable.
+    check(!load_cube(narrow(root / "no-such-directory" / "x.cube"), &lut,
+                     &error),
+          "a path with a missing directory is refused", "returned true");
+}
+
+int run_checks(const std::filesystem::path& root) {
+    check_constants();
+    check_loader_api(root);
+    check_directives(root);
+    check_table_shape(root);
+    check_sampler_3d(root);
+    check_sampler_1d(root);
+    check_strength(root);
+    check_identity();
+    check_rejections();
+    check_aliasing();
+    check_frames();
+    check_utf8_path(root);
+    return g_failures == 0 ? 0 : g_first_failure;
+}
+
+}  // namespace
+
+int main() {
+    const auto ticks =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    std::filesystem::path root;
+    if (!create_root("nds-color-grade-test", std::to_string(ticks), &root))
+        return 1;
+
+    const int result = run_checks(root);
+    std::error_code ignored;
+    std::filesystem::remove_all(root, ignored);
+    if (result != 0) {
+        std::fprintf(stderr, "%d of %d check(s) passed before the failure\n",
+                     g_checks - g_failures, g_checks);
+        return result;
+    }
+    std::printf("%d checks passed\n", g_checks);
+    return 0;
+}
