+        ok("an empty name table lists no files");
+
+        broken = built;
+        put_u32(&broken.image, 0x40u, 0x7FFFFF00u);
+        parsed = parse_of(broken);
+        if (!require(first_rule(parsed,
+                                NdsNitroFsRule::FileTableOutsideImage) !=
+                     nullptr))
