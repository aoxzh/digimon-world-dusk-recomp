+    }
+
+    // ---- 6. Escapes and a '#' inside a string. ------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-escapes", &mods))
+            return fail("the fixture made the escape-case tree",
+                        "create failed");
+        const fs::path pack = make_pack(mods, "Escapes");
+        const std::vector<std::string> manifest = {
+            "[pack]",
+            "name = \"Quote \\\" and hash # and tab \\t end\"",
+            "id = \"escapes\"",
+            "description = \"back\\\\slash\"",
+            "[[file]]",
+            "id = 1",
+            "path = \"a.bin\"",
+        };
+        if (!write_file(pack / "a.bin", "x\n") ||
+            !write_manifest(pack / "mod.toml", manifest))
+            return fail("the fixture wrote the escape manifest",
+                        "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        if (!require(result.diagnostics.empty()))
+            return fail("the documented escapes are accepted",
+                        describe(result));
+        ok("the documented escapes are accepted");
+
+        if (!require(!result.packs.empty() &&
+                     result.packs[0].name ==
