+// Pins the persisted runtime-settings file contract (frontend_settings.h).
+//
+// The file is shared with the launcher and hand-edited by users, so the
+// properties worth testing are not just "a value round trips" but the ones a
+// rewrite could quietly destroy:
+//
+//   * `settings_version` is the first line, and a file without one gains the
+//     runner's version (12) on load rather than being silently upgraded.
+//   * A key the runner does not know survives a load/save round trip, and
+//     existing key order is preserved so the file does not churn.
+//   * Blank lines and `#` comments come through verbatim, in place -- with no
+//     CR left behind when the file was written with CRLF endings.
+//   * A present-but-unparsable value makes the typed accessor fall back; it is
+//     NOT rewritten, because the user is presumably mid-edit.
+//   * save() replaces the file through a temporary and leaves no `.tmp`
+//     sibling, including when the rename fails: a plain truncating write would
+//     destroy every setting at once.
+//   * A missing or unreadable file is not fatal; the object is simply empty.
+//
+// Each assertion has its own nonzero return code and prints OK/FAIL with a
+// one-line detail, so a failure names itself without a debugger.
+
+#include "frontend_settings.h"
+
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <limits>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+int g_checks = 0;
+
+bool require(bool value) {
+    return value;
+}
+
+void ok(const char* name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name);
+}
+
+// Prints the failing check plus its detail and yields that check's exit code.
+int fail(int code, const char* name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name, detail.c_str());
+    return code;
+}
+
+// Escapes a string so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\n') {
+            out += "\\n";
+        } else if (ch == '\r') {
+            out += "\\r";
+        } else if (ch == '\t') {
+            out += "\\t";
+        } else {
+            out.push_back(ch);
+        }
+    }
+    out += '"';
+    return out;
+}
+
+std::string show(const std::vector<std::string>& lines) {
+    std::string out = "[";
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += quote(lines[i]);
+    }
+    out += ']';
+    return out;
+}
+
+// Splits rendered contents into lines, ignoring the final newline's empty tail.
+std::vector<std::string> lines_of(const std::string& text) {
+    std::vector<std::string> lines;
+    std::string current;
+    for (const char ch : text) {
+        if (ch == '\n') {
+            lines.push_back(current);
+            current.clear();
+        } else {
+            current.push_back(ch);
+        }
+    }
+    if (!current.empty()) lines.push_back(current);
+    return lines;
+}
+
+// Raw bytes, so a CRLF fixture is not normalised away by the CRT.
+std::string read_file(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return std::string();
+    return std::string((std::istreambuf_iterator<char>(in)),
+                       std::istreambuf_iterator<char>());
+}
+
+bool write_file(const std::filesystem::path& path, const std::string& text) {
+    std::error_code error;
+    if (!path.parent_path().empty()) {
+        std::filesystem::create_directories(path.parent_path(), error);
+    }
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.close();
+    return out.good();
+}
+
+bool has_carriage_return(const std::string& text) {
+    return text.find('\r') != std::string::npos;
+}
+
+}  // namespace
+
+// Compile-time pins: the version the runner writes and the key it writes it
+// under are part of the on-disk format the launcher reads.
+static_assert(NdsRuntimeSettingsFile::kVersion == 12,
+              "the runtime settings format the launcher reads is version 12");
+static_assert(std::string_view(NdsRuntimeSettingsFile::kVersionKey) ==
+                  "settings_version",
+              "the version key is spelled settings_version");
+
+namespace {
+
+using Settings = NdsRuntimeSettingsFile;
+
+int run_checks(const std::filesystem::path& root) {
+    namespace fs = std::filesystem;
+
+    const fs::path missing = root / "absent" / "settings.txt";
+    const fs::path basic = root / "basic" / "settings.txt";
+    const fs::path typed = root / "typed" / "settings.txt";
+    const fs::path order = root / "order" / "settings.txt";
+    const fs::path notes = root / "notes" / "settings.txt";
+    const fs::path loose = root / "loose" / "settings.txt";
+    const fs::path spaces = root / "spaces" / "settings.txt";
+    const fs::path crlf = root / "crlf" / "settings.txt";
+    const fs::path crlf_notes = root / "crlf-notes" / "settings.txt";
+    const fs::path bare_cr = root / "bare-cr" / "settings.txt";
+    const fs::path over = root / "over" / "settings.txt";
+    const fs::path deep = root / "deep" / "nested" / "more" / "settings.txt";
+    const fs::path hostile = root / "hostile" / "settings.txt";
+    const fs::path erased = root / "erase" / "settings.txt";
+    const fs::path versioned = root / "version" / "settings.txt";
+
+    const std::vector<std::string> only_version = {"settings_version=12"};
+
+    // ---- 1. A missing file is not fatal. -----------------------------
+    Settings absent;
+    if (!require(absent.size() == 0u))
+        return fail(1, "a fresh object is empty",
+                    "size() = " + std::to_string(absent.size()));
+    ok("a fresh object is empty");
+
+    if (!require(!absent.load(missing.string())))
+        return fail(2, "load() of a missing file returns false",
+                    quote(missing.string()));
+    ok("load() of a missing file returns false");
+
+    if (!require(absent.size() == 0u))
+        return fail(3, "a failed load leaves the object empty",
+                    "size() = " + std::to_string(absent.size()));
+    ok("a failed load leaves the object empty");
+
+    // A path that exists but cannot be read as a file: the documented
+    // "exists but cannot be read" arm, which must not throw.
+    std::error_code dirent_error;
+    fs::create_directories(root / "unreadable", dirent_error);
+    const fs::path unreadable = root / "unreadable";
+    if (!require(!absent.load(unreadable.string())))
+        return fail(4, "load() of an unreadable path returns false",
+                    quote(unreadable.string()));
+    ok("load() of an unreadable path returns false");
+
+    absent.set_string("leftover", "value");
+    (void)absent.load(missing.string());
+    if (!require(absent.size() == 0u) || !require(!absent.has("leftover")))
+        return fail(5, "a failed load clears a previously populated object",
+                    "size() = " + std::to_string(absent.size()));
+    ok("a failed load clears a previously populated object");
+
+    // ---- 2. The version line. ----------------------------------------
+    if (!require(absent.save(basic.string())))
+        return fail(6, "save() of an empty object succeeds",
+                    quote(basic.string()));
+    ok("save() of an empty object succeeds");
+
+    if (!require(fs::exists(basic)))
+        return fail(7, "save() creates the file and its parent directory",
+                    quote(basic.string()));
+    ok("save() creates the file and its parent directory");
+
+    Settings reloaded;
+    if (!require(reloaded.load(basic.string())))
+        return fail(8, "a saved file loads back", quote(read_file(basic)));
+    ok("a saved file loads back");
+
+    if (!require(reloaded.size() == 1u))
+        return fail(9, "a file with no version line gains exactly one entry",
+                    "size() = " + std::to_string(reloaded.size()));
+    ok("a file with no version line gains exactly one entry");
+
+    if (!require(lines_of(reloaded.render()) == only_version))
+        return fail(10, "the only entry is settings_version=12",
+                    show(lines_of(reloaded.render())));
+    ok("the only entry is settings_version=12");
+
+    if (!require(reloaded.get_int(Settings::kVersionKey, -1) == 12))
+        return fail(11, "the written version reads back as 12",
+                    std::to_string(
+                        reloaded.get_int(Settings::kVersionKey, -1)));
+    ok("the written version reads back as 12");
+
+    if (!require(reloaded.save(basic.string())))
+        return fail(12, "re-saving the version-bearing object succeeds",
+                    quote(basic.string()));
+    ok("re-saving the version-bearing object succeeds");
+
+    {
+        const std::vector<std::string> saved = lines_of(read_file(basic));
+        if (!require(!saved.empty() && saved.front() == "settings_version=12"))
+            return fail(13, "the saved file's first line is the version",
+                        show(saved));
+        ok("the saved file's first line is the version");
+
+        if (!require(saved.size() == 1u))
+            return fail(14, "the version is the file's only line",
+                        show(saved));
+        ok("the version is the file's only line");
+    }
+
+    // ---- 3. Typed values round trip. ---------------------------------
+    Settings typed_values;
+    typed_values.set_int("volume", 42);
+    typed_values.set_bool("fullscreen", true);
+    typed_values.set_bool("mute", false);
+    typed_values.set_string("nick", "Player One");
+    typed_values.set_int("lowest", std::numeric_limits<int>::min());
+    typed_values.set_int("highest", std::numeric_limits<int>::max());
+    if (!require(typed_values.save(typed.string())))
+        return fail(15, "save() of a populated object succeeds",
+                    quote(typed.string()));
+    ok("save() of a populated object succeeds");
+
+    Settings typed_loaded;
+    if (!require(typed_loaded.load(typed.string())))
+        return fail(16, "the populated file loads back",
+                    quote(read_file(typed)));
+    ok("the populated file loads back");
+
+    if (!require(typed_loaded.get_int("volume", -1) == 42))
+        return fail(17, "get_int() round trips 42 past its fallback",
+                    std::to_string(typed_loaded.get_int("volume", -1)));
+    ok("get_int() round trips 42 past its fallback");
+
+    if (!require(typed_loaded.get_bool("fullscreen", false)))
+        return fail(18, "get_bool() round trips true past its fallback",
+                    typed_loaded.get_bool("fullscreen", false) ? "true"
+                                                              : "false");
+    ok("get_bool() round trips true past its fallback");
+
+    if (!require(!typed_loaded.get_bool("mute", true)))
+        return fail(19, "get_bool() round trips false past its fallback",
+                    typed_loaded.get_bool("mute", true) ? "true" : "false");
+    ok("get_bool() round trips false past its fallback");
+
+    if (!require(typed_loaded.get_string("nick", "MISSING") == "Player One"))
+        return fail(20, "get_string() round trips a spaced value",
+                    quote(typed_loaded.get_string("nick", "MISSING")));
+    ok("get_string() round trips a spaced value");
+
+    if (!require(typed_loaded.get_int("lowest", 0) ==
+                 std::numeric_limits<int>::min()))
+        return fail(21, "get_int() round trips INT_MIN",
+                    std::to_string(typed_loaded.get_int("lowest", 0)));
+    ok("get_int() round trips INT_MIN");
+
+    if (!require(typed_loaded.get_int("highest", 0) ==
+                 std::numeric_limits<int>::max()))
+        return fail(22, "get_int() round trips INT_MAX",
+                    std::to_string(typed_loaded.get_int("highest", 0)));
+    ok("get_int() round trips INT_MAX");
+
+    {
+        const std::vector<std::string> want = {
+            "settings_version=12",
+            "volume=42",
+            "fullscreen=1",
+            "mute=0",
+            "nick=Player One",
+            "lowest=" + std::to_string(std::numeric_limits<int>::min()),
+            "highest=" + std::to_string(std::numeric_limits<int>::max())};
+        const std::vector<std::string> got = lines_of(typed_loaded.render());
+        if (!require(got == want))
+            return fail(23, "the version line stays first, keys keep set order",
+                        show(got));
+        ok("the version line stays first, keys keep set order");
+    }
+
+    // ---- 4. Fallbacks, including present-but-unparsable values. ------
+    if (!require(typed_loaded.get_int("absent_key", 777) == 777))
+        return fail(24, "get_int() of an absent key returns the fallback",
+                    std::to_string(typed_loaded.get_int("absent_key", 777)));
+    ok("get_int() of an absent key returns the fallback");
+
+    if (!require(typed_loaded.get_bool("absent_key", true)))
+        return fail(25, "get_bool() of an absent key returns the fallback",
+                    typed_loaded.get_bool("absent_key", true) ? "true"
+                                                             : "false");
+    ok("get_bool() of an absent key returns the fallback");
+
+    if (!require(typed_loaded.get_string("absent_key", "ABSENT") == "ABSENT"))
+        return fail(26, "get_string() of an absent key returns the fallback",
+                    quote(typed_loaded.get_string("absent_key", "ABSENT")));
+    ok("get_string() of an absent key returns the fallback");
+
+    Settings unparsable;
+    if (!require(write_file(loose, "volume=loud\nflag=maybe\n") &&
+                 unparsable.load(loose.string())))
+        return fail(27, "a hand-edited, unparsable fixture loads",
+                    quote(read_file(loose)));
+    ok("a hand-edited, unparsable fixture loads");
+
+    if (!require(unparsable.get_int("volume", 7) == 7))
+        return fail(28, "get_int() of 'loud' returns the fallback",
+                    std::to_string(unparsable.get_int("volume", 7)));
+    ok("get_int() of 'loud' returns the fallback");
+
+    if (!require(unparsable.has("volume")))
+        return fail(29, "an unparsable value is still a present key", "has()");
+    ok("an unparsable value is still a present key");
+
+    if (!require(!unparsable.get_bool("flag", false)))
+        return fail(30, "get_bool() of 'maybe' returns the fallback",
+                    unparsable.get_bool("flag", false) ? "true" : "false");
+    ok("get_bool() of 'maybe' returns the fallback");
+
+    if (!require(unparsable.save(loose.string()) &&
+                 read_file(loose).find("volume=loud") != std::string::npos))
+        return fail(31, "save() does not rewrite an unparsable value",
+                    quote(read_file(loose)));
+    ok("save() does not rewrite an unparsable value");
+
+    // ---- 5. Order preservation and appends. --------------------------
+    Settings ordered;
+    if (!require(write_file(order, "a=1\nb=2\n") &&
+                 ordered.load(order.string())))
+        return fail(32, "the two-key fixture loads", quote(read_file(order)));
+    ok("the two-key fixture loads");
+
+    ordered.set_string("c", "3");
+    ordered.set_string("d", "4");
+    if (!require(ordered.save(order.string())))
+        return fail(33, "appending two keys saves", quote(order.string()));
+    ok("appending two keys saves");
+
+    {
+        const std::vector<std::string> want = {"settings_version=12", "a=1",
+                                               "b=2", "c=3", "d=4"};
+        const std::vector<std::string> got = lines_of(read_file(order));
+        if (!require(got == want))
+            return fail(34, "existing keys keep order, new keys append",
+                        show(got));
+        ok("existing keys keep order, new keys append");
+    }
+
+    // ---- 6. Blank lines and comments, verbatim and in place. ---------
+    const std::string notes_text =
+        "alpha=1\n\n# keep me\nbeta=2\n  # indented note\n";
+    Settings with_notes;
+    if (!require(write_file(notes, notes_text) &&
+                 with_notes.load(notes.string())))
+        return fail(35, "a fixture with blanks and comments loads",
+                    quote(read_file(notes)));
+    ok("a fixture with blanks and comments loads");
+
+    if (!require(with_notes.save(notes.string())))
+        return fail(36, "the commented file saves", quote(notes.string()));
+    ok("the commented file saves");
+
+    const std::string notes_want = "settings_version=12\nalpha=1\n\n"
+                                   "# keep me\nbeta=2\n  # indented note\n";
+    if (!require(read_file(notes) == notes_want))
+        return fail(37, "blank and comment lines survive verbatim, in place",
+                    quote(read_file(notes)));
+    ok("blank and comment lines survive verbatim, in place");
+
+    Settings notes_again;
+    if (!require(notes_again.load(notes.string()) &&
+                 notes_again.save(notes.string())))
+        return fail(38, "a load then save of the same path succeeds",
+                    quote(notes.string()));
+    ok("a load then save of the same path succeeds");
+
+    if (!require(read_file(notes) == notes_want))
+        return fail(39, "a second load/save cycle changes nothing",
+                    quote(read_file(notes)));
+    ok("a second load/save cycle changes nothing");
+
+    // ---- 7. Whitespace tolerance and line-ending debris. -------------
+    Settings spaced;
+    if (!require(write_file(spaces, "  key = value  \n") &&
+                 spaced.load(spaces.string())))
+        return fail(40, "a padded key/value line loads",
+                    quote(read_file(spaces)));
+    ok("a padded key/value line loads");
+
+    if (!require(spaced.has("key")))
+        return fail(41, "surrounding whitespace is trimmed off the key",
+                    show(lines_of(spaced.render())));
+    ok("surrounding whitespace is trimmed off the key");
+
+    if (!require(spaced.get_string("key", "FALLBACK") == "value"))
+        return fail(42, "surrounding whitespace is trimmed off the value",
+                    quote(spaced.get_string("key", "FALLBACK")));
+    ok("surrounding whitespace is trimmed off the value");
+
+    if (!require(!spaced.has("  key ")))
+        return fail(43, "the padded spelling is not a second key",
+                    "has(\"  key \")");
+    ok("the padded spelling is not a second key");
+
+    Settings crlf_loaded;
+    if (!require(write_file(crlf, "name=Foo Bar\r\nnum=13\r\n") &&
+                 crlf_loaded.load(crlf.string())))
+        return fail(44, "a CRLF file loads", quote(read_file(crlf)));
+    ok("a CRLF file loads");
+
+    if (!require(!has_carriage_return(crlf_loaded.render())))
+        return fail(45, "no CR survives into the values",
+                    quote(crlf_loaded.render()));
+    ok("no CR survives into the values");
+
+    if (!require(crlf_loaded.get_string("name", "X") == "Foo Bar" &&
+                 crlf_loaded.get_int("num", -1) == 13))
+        return fail(46, "CRLF keys and values read back exactly",
+                    quote(crlf_loaded.render()));
+    ok("CRLF keys and values read back exactly");
+
+    // The CRT's text mode only folds the CR of a CRLF pair, so the LAST line
+    // of a file whose final newline was lost (a truncated write) arrives with
+    // a trailing CR the loader has to drop itself. That is the case this pins.
+    Settings bare_cr_loaded;
+    if (!require(write_file(bare_cr, "val=hello\r\n# tail comment\r") &&
+                 bare_cr_loaded.load(bare_cr.string())))
+        return fail(47, "a file whose last line ends in a bare CR loads",
+                    quote(read_file(bare_cr)));
+    ok("a file whose last line ends in a bare CR loads");
+
+    if (!require(!has_carriage_return(bare_cr_loaded.render())))
+        return fail(48, "a CR on the unterminated last line does not survive",
+                    quote(bare_cr_loaded.render()));
+    ok("a CR on the unterminated last line does not survive");
+
+    if (!require(bare_cr_loaded.get_string("val", "X") == "hello"))
+        return fail(49, "the value before it is unaffected",
+                    quote(bare_cr_loaded.render()));
+    ok("the value before it is unaffected");
+
+    // A last line with no newline at all is normal for hand-edited files.
+    Settings unterminated;
+    if (!require(write_file(root / "unterminated" / "settings.txt",
+                            "alpha=1\nbeta=2") &&
+                 unterminated.load((root / "unterminated" / "settings.txt")
+                                       .string())))
+        return fail(50, "a file with no final newline loads",
+                    quote(read_file(root / "unterminated" / "settings.txt")));
+    ok("a file with no final newline loads");
+
+    if (!require(unterminated.get_int("alpha", -1) == 1 &&
+                 unterminated.get_int("beta", -1) == 2))
+        return fail(51, "both keys of the unterminated file are readable",
+                    show(lines_of(unterminated.render())));
+    ok("both keys of the unterminated file are readable");
+
+    if (!require(unterminated.render().back() == '\n'))
+        return fail(52, "render() always ends in a newline",
+                    quote(unterminated.render()));
+    ok("render() always ends in a newline");
+
+    // Comment and blank lines carry no key, so nothing trims them: a CRLF
+    // file must not leak CR into the preserved lines.
+    Settings crlf_notes_loaded;
+    if (!require(write_file(crlf_notes, "a=1\r\n# note\r\n\r\nb=2\r\n") &&
+                 crlf_notes_loaded.load(crlf_notes.string())))
+        return fail(53, "a CRLF file with a comment and a blank line loads",
+                    quote(read_file(crlf_notes)));
+    ok("a CRLF file with a comment and a blank line loads");
+
+    if (!require(!has_carriage_return(crlf_notes_loaded.render())))
+        return fail(54, "a CRLF comment keeps no CR",
+                    quote(crlf_notes_loaded.render()));
+    ok("a CRLF comment keeps no CR");
+
+    if (!require(crlf_notes_loaded.save(crlf_notes.string()) &&
+                 read_file(crlf_notes) ==
+                     "settings_version=12\na=1\n# note\n\nb=2\n"))
+        return fail(55, "a CRLF file is re-saved with LF endings only",
+                    quote(read_file(crlf_notes)));
+    ok("a CRLF file is re-saved with LF endings only");
+
+    // ---- 8. Saving over an existing file. ----------------------------
+    Settings overwrite;
+    overwrite.set_string("a", "old");
+    if (!require(overwrite.save(over.string())))
+        return fail(56, "the first save of the overwrite fixture succeeds",
+                    quote(over.string()));
+    ok("the first save of the overwrite fixture succeeds");
+
+    overwrite.set_string("a", "new");
+    if (!require(overwrite.save(over.string())))
+        return fail(57, "saving again over the same file succeeds",
+                    quote(over.string()));
+    ok("saving again over the same file succeeds");
+
+    {
+        // save() writes the version line itself when the object never loaded a
+        // file, so the first save of a fresh settings file already satisfies
+        // the header's "the first line is settings_version" contract.
+        const std::vector<std::string> want = {"settings_version=12", "a=new"};
+        const std::vector<std::string> got = lines_of(read_file(over));
+        if (!require(got == want))
+            return fail(58, "the destination shows the new value, not the old",
+                        show(got));
+        ok("the destination shows the new value, not the old");
+    }
+
+    if (!require(!fs::exists(over.string() + ".tmp")))
+        return fail(59, "no .tmp sibling survives a successful save",
+                    quote(over.string() + ".tmp"));
+    ok("no .tmp sibling survives a successful save");
+
+    Settings deep_writer;
+    deep_writer.set_string("k", "v");
+    if (!require(deep_writer.save(deep.string()) && fs::exists(deep)))
+        return fail(60, "save() creates a missing parent directory chain",
+                    quote(deep.string()));
+    ok("save() creates a missing parent directory chain");
+
+    // A destination that exists as a directory makes the rename fail. The
+    // contract is "false, previous file untouched, no debris left behind".
+    std::error_code hostile_error;
+    fs::create_directories(hostile, hostile_error);
+    Settings hostile_writer;
+    hostile_writer.set_string("a", "1");
+    if (!require(!hostile_writer.save(hostile.string())))
+        return fail(61, "save() onto a directory destination returns false",
+                    quote(hostile.string()));
+    ok("save() onto a directory destination returns false");
+
+    if (!require(fs::is_directory(hostile)))
+        return fail(62, "a failed save leaves the destination untouched",
+                    quote(hostile.string()));
+    ok("a failed save leaves the destination untouched");
+
+    if (!require(!fs::exists(hostile.string() + ".tmp")))
+        return fail(63, "a failed save removes its .tmp sibling",
+                    quote(hostile.string() + ".tmp"));
+    ok("a failed save removes its .tmp sibling");
+
+    // ---- 9. erase(). --------------------------------------------------
+    Settings erasable;
+    if (!require(write_file(erased, "x=1\ny=2\n") &&
+                 erasable.load(erased.string())))
+        return fail(64, "the erase fixture loads", quote(read_file(erased)));
+    ok("the erase fixture loads");
+
+    if (!require(erasable.erase("x")))
+        return fail(65, "erase() of a present key returns true", "x");
+    ok("erase() of a present key returns true");
+
+    if (!require(!erasable.has("x")))
+        return fail(66, "the erased key is absent", "has(\"x\")");
+    ok("the erased key is absent");
+
+    {
+        const std::vector<std::string> want = {"settings_version=12", "y=2"};
+        const std::vector<std::string> got = lines_of(erasable.render());
+        if (!require(got == want))
+            return fail(67, "the erased key is gone from render()", show(got));
+        ok("the erased key is gone from render()");
+    }
+
+    if (!require(!erasable.erase("zzz")))
+        return fail(68, "erase() of an absent key returns false", "zzz");
+    ok("erase() of an absent key returns false");
+
+    // ---- 10. settings_version is reserved. ---------------------------
+    Settings versioned_file;
+    if (!require(write_file(versioned, "settings_version=7\nfoo=1\n") &&
+                 versioned_file.load(versioned.string())))
+        return fail(69, "a file with an older version line loads",
+                    quote(read_file(versioned)));
+    ok("a file with an older version line loads");
+
+    if (!require(versioned_file.get_int(Settings::kVersionKey, -1) == 7))
+        return fail(70, "load() keeps the version it finds",
+                    std::to_string(
+                        versioned_file.get_int(Settings::kVersionKey, -1)));
+    ok("load() keeps the version it finds");
+
+    versioned_file.set_string(Settings::kVersionKey, "99");
+    if (!require(versioned_file.get_int(Settings::kVersionKey, -1) == 7))
+        return fail(71, "set_string() on settings_version is ignored",
+                    std::to_string(
+                        versioned_file.get_int(Settings::kVersionKey, -1)));
+    ok("set_string() on settings_version is ignored");
+
+    {
+        const std::vector<std::string> got = lines_of(versioned_file.render());
+        if (!require(!got.empty() && got.front() == "settings_version=7"))
+            return fail(72, "the version line keeps its value when rendered",
+                        show(got));
+        ok("the version line keeps its value when rendered");
+    }
+
+    versioned_file.set_int(Settings::kVersionKey, 5);
+    if (!require(versioned_file.get_int(Settings::kVersionKey, -1) == 7))
+        return fail(73, "set_int() on settings_version is ignored",
+                    std::to_string(
+                        versioned_file.get_int(Settings::kVersionKey, -1)));
+    ok("set_int() on settings_version is ignored");
+
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// used first, but a sandboxed ctest run can refuse writes there because the
+// process working directory sits inside the tree under test, so the working
+// directory is tried second. Returns false only when neither location can hold
+// the tree, and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line that names both candidate
+    // paths stays unambiguous even when TEMP and the working directory are
+    // the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    namespace fs = std::filesystem;
+    const auto stamp = std::chrono::steady_clock::now()
+                           .time_since_epoch().count();
+    fs::path root;
+    if (!create_root("nds-frontend-settings-test", std::to_string(stamp),
+                     &root)) {
+        return 1;
+    }
+
+    // Checks live in run_checks() so the temporary tree is removed on every
+    // exit path, including a failing one.
+    const int result = run_checks(root);
+    if (result == 0) std::printf("%d checks passed\n", g_checks);
+    std::error_code cleanup_error;
+    fs::remove_all(root, cleanup_error);
+    return result;
+}
