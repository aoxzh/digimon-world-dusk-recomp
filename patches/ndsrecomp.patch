+// ---------------------------------------------------------------------------
+// Minimum canvas: the boundary the frontend uses to decide whether it can
+// honour a resize at all, so it has to agree with compute_layout exactly.
+// ---------------------------------------------------------------------------
+
+void check_min_canvas() {
+    for (int index = 0; index < kNdsLayoutKindCount; ++index) {
+        const NdsScreenLayoutKind kind =
+            static_cast<NdsScreenLayoutKind>(index);
+        int width = 0;
+        int height = 0;
+        const bool ok = layout_min_canvas(kind, &width, &height);
+        const bool values_ok = ok && width == block_width(index) &&
+                               height == block_height(index);
+        check(values_ok,
+              std::string("layout_min_canvas for ") + layout_name(kind),
+              "got " + number(width) + "x" + number(height) + " want " +
+                  number(block_width(index)) + "x" +
+                  number(block_height(index)));
+        if (!values_ok) continue;
+
+        const NdsScreenLayoutResult at_min =
+            compute_layout(kind, width, height, true, false);
+        check(at_min.valid && at_min.native_scale == 1,
+              std::string("the minimum canvas is valid for ") +
+                  layout_name(kind),
+              describe(at_min));
+
+        const NdsScreenLayoutResult narrow =
+            compute_layout(kind, width - 1, height, true, false);
+        check(!narrow.valid && narrow.native_scale == 0 &&
+                  narrow.unused_canvas_pixels == 0 &&
+                  rects_equal(narrow.rects[kNdsScreenTop], {0, 0, 0, 0}) &&
+                  rects_equal(narrow.rects[kNdsScreenBottom], {0, 0, 0, 0}),
+              std::string("one pixel narrower is refused for ") +
+                  layout_name(kind),
+              describe(narrow));
+
+        const NdsScreenLayoutResult short_canvas =
+            compute_layout(kind, width, height - 1, true, false);
+        check(!short_canvas.valid && short_canvas.native_scale == 0 &&
+                  short_canvas.unused_canvas_pixels == 0 &&
+                  rects_equal(short_canvas.rects[kNdsScreenTop],
+                              {0, 0, 0, 0}),
+              std::string("one pixel shorter is refused for ") +
+                  layout_name(kind),
+              describe(short_canvas));
+    }
+
+    check(!layout_min_canvas(kNdsLayoutStacked, nullptr, nullptr),
+          "layout_min_canvas rejects null out pointers", "accepted a null out");
+
+    int width = 0;
+    int height = 0;
+    check(layout_min_canvas(static_cast<NdsScreenLayoutKind>(99), &width,
+                            &height) &&
+              width == 256 && height == 384,
+          "layout_min_canvas falls back to stacked", "got " + number(width) +
+              "x" + number(height));
+}
