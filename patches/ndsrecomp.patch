+        if (!require(first_rule(parsed, NdsNitroFsRule::FileTableEmpty) !=
+                     nullptr))
+            return fail("an empty name table is refused", describe(parsed));
+        ok("an empty name table is refused");
+        if (!require(parsed.files.empty() && !parsed.ok))
