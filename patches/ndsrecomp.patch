index 0000000..0f4f169
--- /dev/null
+++ b/runner/src/display_filters.cpp
@@ -0,0 +1,360 @@
+#include "display_filters.h"
+
+#include <cmath>
+#include <cstddef>
+
+namespace nds_display_filter {
+namespace {
+
+// One gamma curve per mode, indexed by kColorMode*. Mode 0 states its exponent
+// explicitly even though it is the identity: the table is generated by one
+// formula, and a special case would let the identity drift away from 0->0 and
+// 255->255 unnoticed.
+//
+// The curve brightens as the exponent rises, which is the direction the DS's
+// "colour reproduction" options go: 1.0 (raw), 1.1, 1.2, 1.4.
+constexpr double kExponents[kColorModeCount] = {1.0, 1.1, 1.2, 1.4};
+
+constexpr int kChannelMax = 255;
+
+// The channel curve: out = round(255 * pow(in / 255, 1 / exponent)).
+//
+// Doubles are exact enough here: the closest any value in the whole table comes
+// to a .5 tie is 6.9e-4 (mode 3, in = 49), so no rounding mode choice can flip
+// an entry. std::lround is still used rather than a cast so the intent is
+// explicit, and the clamp keeps a hypothetical NaN or overshoot from wrapping.
+uint8_t curve_value(int channel, double exponent) {
+    if (exponent == 1.0) return static_cast<uint8_t>(channel);
+    const double normalised = static_cast<double>(channel) / kChannelMax;
+    const double curved = kChannelMax * std::pow(normalised, 1.0 / exponent);
+    const long rounded = std::lround(curved);
+    if (rounded < 0) return 0;
+    if (rounded > kChannelMax) return static_cast<uint8_t>(kChannelMax);
+    return static_cast<uint8_t>(rounded);
+}
+
+int exponent_index(int color_mode) {
+    return color_mode_is_valid(color_mode) ? color_mode : kColorModeOriginal;
+}
+
+// 3x3 binomial kernel, row-major from the top-left. Every row and column sums
+// to 4, so the whole kernel sums to 16 and the divide is a shift by 4.
+constexpr int kBlurWeights[9] = {1, 2, 1, 2, 4, 2, 1, 2, 1};
+
+// Border replication: sampling outside the image reads the nearest edge pixel
+// instead, which is why the caller never has to pad the buffer.
+int clamp_to_edge(int coordinate, int last_index) {
+    if (coordinate < 0) return 0;
+    if (coordinate > last_index) return last_index;
+    return coordinate;
+}
+
+// The 3x3 binomial blur of one pixel, one channel at a time. All three channels
+// share the weights, so they are accumulated in a single walk over the
+// neighbourhood instead of three.
+void blur_rgb(const uint32_t* in, int width, int height, int x, int y,
+              int* red, int* green, int* blue) {
+    int sum_red = 0;
+    int sum_green = 0;
+    int sum_blue = 0;
+    for (int dy = -1; dy <= 1; ++dy) {
+        const int sample_y = clamp_to_edge(y + dy, height - 1);
+        const uint32_t* row =
+            in + static_cast<std::ptrdiff_t>(sample_y) * width;
+        for (int dx = -1; dx <= 1; ++dx) {
+            const int weight = kBlurWeights[(dy + 1) * 3 + (dx + 1)];
+            const uint32_t pixel =
+                row[clamp_to_edge(x + dx, width - 1)];
+            sum_red += weight *
+                       static_cast<int>((pixel >> 16) & 0xFFu);
+            sum_green += weight *
+                         static_cast<int>((pixel >> 8) & 0xFFu);
+            sum_blue += weight * static_cast<int>(pixel & 0xFFu);
+        }
+    }
+    // The kernel sums to 16, so the largest possible sum is 16 * 255 = 4080 and
+    // the largest rounded value is 4088 >> 4 = 255: the blur cannot overflow a
+    // channel. +8 then >>4 is round half up, i.e. the (sum + 8) / 16 the
+    // contract specifies, without a division.
+    *red = (sum_red + 8) >> 4;
+    *green = (sum_green + 8) >> 4;
+    *blue = (sum_blue + 8) >> 4;
+}
+
+// Unsharp form: push the centre away from the blur by twice the difference the
+// blur removed. The intermediate is signed and reaches at most 255 + 2 * 255 =
+// 765, so an int is comfortably wide enough; the clamp is what keeps the result
+// an 8-bit channel.
+int sharpen_channel(int centre, int blurred) {
+    const int sharpened = centre + 2 * (centre - blurred);
+    if (sharpened < 0) return 0;
+    if (sharpened > kChannelMax) return kChannelMax;
+    return sharpened;
+}
+
+int pixel_filter_index(int pixel_filter) {
+    return pixel_filter_is_valid(pixel_filter) ? pixel_filter
+                                               : kPixelFilterNearest;
+}
+
+// ---------------------------------------------------------------------------
+// The edge-directed pair: Scale2x and Epx
+// ---------------------------------------------------------------------------
+//
+// Both rules are the classic Scale2x-family tests, reduced from "write four
+// output pixels" to "possibly replace this one". They read a snapshot of the
+// source (guaranteed distinct from `out` by the caller contract) and compare
+// whole ARGB words, so the walk order cannot leak a filtered pixel into a
+// later comparison.
+//
+// The 2x form is what the names normally mean; it needs an output buffer of
+// 2 * width by 2 * height, i.e. four times the pixels this call is given. The
+// reduction is deliberate and is documented in display_filters.h: allocating
+// that scratch surface here would silently quadruple the per-frame buffer the
+// presenter owns.
+struct Neighbourhood {
+    uint32_t centre;
+    uint32_t left;
+    uint32_t right;
+    uint32_t up;
+    uint32_t down;
+};
+
+// Border replication, the same rule the blur and the sharpener use: a sample
+// outside the image reads the nearest edge pixel. Keeping the three filters on
+// one clamping convention means a frame filtered by any of them agrees at the
+// edges, and nothing outside the buffer is ever read.
+Neighbourhood sample(const uint32_t* in, int width, int height, int x, int y) {
+    const int last_x = width - 1;
+    const int last_y = height - 1;
+    const uint32_t* row_up =
+        in + static_cast<std::ptrdiff_t>(clamp_to_edge(y - 1, last_y)) * width;
+    const uint32_t* row_mid =
+        in + static_cast<std::ptrdiff_t>(clamp_to_edge(y, last_y)) * width;
+    const uint32_t* row_down =
+        in + static_cast<std::ptrdiff_t>(clamp_to_edge(y + 1, last_y)) * width;
+    Neighbourhood n;
+    n.centre = row_mid[clamp_to_edge(x, last_x)];
+    n.left = row_mid[clamp_to_edge(x - 1, last_x)];
+    n.right = row_mid[clamp_to_edge(x + 1, last_x)];
+    n.up = row_up[clamp_to_edge(x, last_x)];
+    n.down = row_down[clamp_to_edge(x, last_x)];
+    return n;
+}
+
+// Scale2x, reduced to one output pixel:
+//   if L == R and U != D: the pixel sits in a horizontal run whose vertical
+//       neighbours differ, i.e. on a horizontal edge -> take the run colour;
+//   else if U == D and L != R: the transpose of that case;
+//   else keep.
+// Note the asymmetry that makes this detail-preserving rather than a blur: a
+// disagreeing pair never causes a write, so isolated detail and single-pixel
+// highlights survive, and a corner (two disagreeing pairs) can never move.
+uint32_t scale2x_pixel(const Neighbourhood& n) {
+    if (n.left == n.right && n.up != n.down) return n.left;
+    if (n.up == n.down && n.left != n.right) return n.up;
+    return n.centre;
+}
+
+// Epx, same reduction, the four-clause form everyone cites:
+//   if L == U and U != R and L != D: out = L;
+//   else if U == R and U != L and R != D: out = R;
+//   else if D == R and D != U and R != L: out = R;
+//   else if L == D and L != U and D != R: out = L;
+//   else keep.
+// Each clause says "these two neighbours agree, and neither of the other two
+// matches them", which is the 2x2 corner diagnosis EPX is built on: it repairs
+// the diagonal pixels of a staircase, where Scale2x leaves them alone.
+uint32_t epx_pixel(const Neighbourhood& n) {
+    if (n.left == n.up && n.up != n.right && n.left != n.down) return n.left;
+    if (n.up == n.right && n.up != n.left && n.right != n.down) {
+        return n.right;
+    }
+    if (n.down == n.right && n.down != n.up && n.right != n.left) {
+        return n.right;
+    }
+    if (n.left == n.down && n.left != n.up && n.down != n.right) {
+        return n.left;
+    }
+    return n.centre;
+}
+
+}  // namespace
+
+const char* color_mode_name(int mode) {
+    switch (mode) {
+        case kColorModeOriginal: return "Original";
+        case kColorModeLight: return "Light";
+        case kColorModeModerate: return "Moderate";
+        case kColorModeStrong: return "Strong";
+        default: return "";
+    }
+}
+
+bool color_mode_is_valid(int mode) {
+    return mode >= 0 && mode < kColorModeCount;
+}
+
+void build_lut(int color_mode, uint8_t lut[256]) {
+    // Null is a programming error, not something to report: the contract has no
+    // failure arm, so the call is a no-op rather than a crash.
+    if (lut == nullptr) return;
+    const double exponent = kExponents[exponent_index(color_mode)];
+    for (int channel = 0; channel < 256; ++channel) {
+        lut[channel] = curve_value(channel, exponent);
+    }
+}
+
+bool lut_is_identity(const uint8_t lut[256]) {
+    // A null table carries no curve, so it is treated as the identity: the
+    // caller's fast path then simply skips a pass it could not have built.
+    if (lut == nullptr) return true;
+    for (int channel = 0; channel < 256; ++channel) {
+        if (lut[channel] != static_cast<uint8_t>(channel)) return false;
+    }
+    return true;
+}
+
+bool apply(const uint32_t* in, uint32_t* out, int width, int height,
+           int pitch_pixels, int color_mode, bool lcd_grid) {
+    if (in == nullptr || out == nullptr) return false;
+    if (width <= 0 || height <= 0) return false;
+    if (pitch_pixels < width) return false;
+
+    uint8_t lut[256];
+    build_lut(color_mode, lut);
+    // Mode 0 (and an invalid mode) with the grid off is a pure copy; skip the
+    // per-channel table lookups for it rather than reading a table we know.
+    const bool curve = !lut_is_identity(lut);
+
+    for (int y = 0; y < height; ++y) {
+        const uint32_t* source_row =
+            in + static_cast<std::ptrdiff_t>(y) * pitch_pixels;
+        uint32_t* target_row =
+            out + static_cast<std::ptrdiff_t>(y) * pitch_pixels;
+        // Row parity is constant across the row, so the "odd row" half of the
+        // grid test is hoisted out of the x loop.
+        const bool dim_row = lcd_grid && ((y & 1) != 0);
+        for (int x = 0; x < width; ++x) {
+            const uint32_t pixel = source_row[x];
+            const uint32_t alpha = pixel & 0xFF000000u;
+            int red = static_cast<int>((pixel >> 16) & 0xFFu);
+            int green = static_cast<int>((pixel >> 8) & 0xFFu);
+            int blue = static_cast<int>(pixel & 0xFFu);
+
+            // Colour reproduction first, then the grid: the grid models the
+            // panel's coverage of an already-reproduced picture, so dimming a
+            // post-curve value is the physical order.
+            if (curve) {
+                red = lut[red];
+                green = lut[green];
+                blue = lut[blue];
+            }
+
+            // The grid covers one column in two and one row in two, so a pixel
+            // is dimmed when EITHER coordinate is odd. 0.75 is applied as
+            // (v * 3 + 2) / 4, which is round-half-up of 0.75 * v in integer
+            // math: v = 2 gives 2, v = 10 gives 8, and the result is exact for
+            // every 8-bit input without touching floating point per pixel.
+            if (dim_row || (lcd_grid && ((x & 1) != 0))) {
+                red = (red * 3 + 2) / 4;
+                green = (green * 3 + 2) / 4;
+                blue = (blue * 3 + 2) / 4;
+            }
+
+            target_row[x] = alpha |
+                            (static_cast<uint32_t>(red) << 16) |
+                            (static_cast<uint32_t>(green) << 8) |
+                            static_cast<uint32_t>(blue);
+        }
+    }
+    return true;
+}
+
+const char* pixel_filter_name(int filter) {
+    switch (filter) {
+        case kPixelFilterNearest: return "Nearest";
+        case kPixelFilterSmooth: return "Smooth";
+        case kPixelFilterSharp: return "Sharp";
+        case kPixelFilterScale2x: return "Scale2x";
+        case kPixelFilterEpx: return "EPX";
+        default: return "";
+    }
+}
+
+bool pixel_filter_is_valid(int filter) {
+    return filter >= 0 && filter < kPixelFilterCount;
+}
+
+bool apply_pixel_filter(const uint32_t* in, uint32_t* out, int width,
+                        int height, int pixel_filter) {
+    if (in == nullptr || out == nullptr) return false;
+    if (width <= 0 || height <= 0) return false;
+    // Aliasing is rejected rather than supported: the kernel reads the
+    // neighbours of the pixel it is about to write, so a shared buffer would
+    // mix filtered and unfiltered pixels depending on the walk order.
+    if (in == out) return false;
+
+    const int filter = pixel_filter_index(pixel_filter);
+    // The edge-directed pair shares one path: both are "replace the centre with
+    // a neighbour, or keep it", so they only choose a different rule.
+    const bool edge_directed =
+        filter == kPixelFilterScale2x || filter == kPixelFilterEpx;
+
+    for (int y = 0; y < height; ++y) {
+        const uint32_t* source_row = in + static_cast<std::ptrdiff_t>(y) *
+                                              width;
+        uint32_t* target_row = out + static_cast<std::ptrdiff_t>(y) * width;
+        for (int x = 0; x < width; ++x) {
+            const uint32_t pixel = source_row[x];
+            // Alpha is the centre pixel's, always, in every mode: the filters
+            // are a colour operation and must not soften a cut-out edge. Taken
+            // before the branch so the edge filters cannot accidentally carry a
+            // neighbour's alpha out with the colour they copy.
+            const uint32_t alpha = pixel & 0xFF000000u;
+
+            if (edge_directed) {
+                const Neighbourhood n = sample(in, width, height, x, y);
+                const uint32_t replaced = (filter == kPixelFilterScale2x)
+                                              ? scale2x_pixel(n)
+                                              : epx_pixel(n);
+                // Recombine rather than writing `replaced` whole: the rule
+                // chooses a colour, never an alpha.
+                target_row[x] = alpha | (replaced & 0x00FFFFFFu);
+                continue;
+            }
+
+            // The blur is computed even for nearest so that the modes below
+            // share one code path; the copy is what makes nearest exact.
+            int red = 0;
+            int green = 0;
+            int blue = 0;
+            blur_rgb(in, width, height, x, y, &red, &green, &blue);
+
+            int result_red = red;
+            int result_green = green;
+            int result_blue = blue;
+            if (filter == kPixelFilterNearest) {
+                result_red = static_cast<int>((pixel >> 16) & 0xFFu);
+                result_green = static_cast<int>((pixel >> 8) & 0xFFu);
+                result_blue = static_cast<int>(pixel & 0xFFu);
+            } else if (filter == kPixelFilterSharp) {
+                result_red =
+                    sharpen_channel(static_cast<int>((pixel >> 16) & 0xFFu),
+                                    red);
+                result_green = sharpen_channel(
+                    static_cast<int>((pixel >> 8) & 0xFFu), green);
+                result_blue =
+                    sharpen_channel(static_cast<int>(pixel & 0xFFu), blue);
+            }
+
+            target_row[x] = alpha |
+                            (static_cast<uint32_t>(result_red) << 16) |
+                            (static_cast<uint32_t>(result_green) << 8) |
+                            static_cast<uint32_t>(result_blue);
+        }
+    }
+    return true;
+}
+
+}  // namespace nds_display_filter
diff --git a/runner/src/display_filters.h b/runner/src/display_filters.h
new file mode 100644
index 0000000..e27f647
--- /dev/null
+++ b/runner/src/display_filters.h
@@ -0,0 +1,112 @@
+#pragma once
+
+#include <cstdint>
+
+// Host-side display post-processing: the GBA/DS "colour reproduction" curve and
+// the LCD pixel grid. Both effects are pure functions of the framebuffer, so
+// this module owns them without SDL, allocation, threads or I/O and the whole
+// thing is testable off-screen.
+//
+// Pixels are ARGB8888 little-endian: byte order B,G,R,A in memory, i.e.
+// 0xAARRGGBB as a uint32_t -- the format the presenter already hands around.
+//
+// The colour curve is a per-channel transfer function, so it is exposed as a
+// 256-entry LUT: the presenter can build it once per mode change instead of
+// recomputing pow() per pixel, and can skip the whole pass when the table turns
+// out to be the identity.
+namespace nds_display_filter {
+
+// The curve is `out = round(255 * pow(in / 255, 1.0 / exponent))`, which is
+// exactly the identity for kColorModeOriginal and brightens the midtones as
+// the exponent rises. Modes outside 0..kColorModeCount-1 are invalid; every
+// entry point below treats an invalid mode as kColorModeOriginal rather than
+// failing, so a hand-edited settings file cannot black the screen out.
+constexpr int kColorModeOriginal = 0;
+constexpr int kColorModeLight    = 1;
+constexpr int kColorModeModerate = 2;
+constexpr int kColorModeStrong   = 3;
+constexpr int kColorModeCount    = 4;
+
+// Human-readable name for the mode as the settings menu spells it, or an empty
+// string for an invalid mode. Never returns nullptr.
+const char* color_mode_name(int mode);
+bool color_mode_is_valid(int mode);
+
+// Applies colour reproduction and/or the LCD grid to an ARGB8888 surface.
+// `in` and `out` may alias (same pointer) or differ; `out` is always fully
+// written. pitch_pixels is the stride in pixels and must be >= width.
+// Returns false (leaving `out` untouched) when in/out is null, width<=0,
+// height<=0, or pitch_pixels<width.
+bool apply(const uint32_t* in, uint32_t* out, int width, int height,
+           int pitch_pixels, int color_mode, bool lcd_grid);
+
+// Fills `lut` with the per-channel transfer curve for `color_mode`
+// (identity for an invalid/original mode). Exposed so the caller can skip a
+// per-pixel pass when the LUT is the identity.
+void build_lut(int color_mode, uint8_t lut[256]);
+bool lut_is_identity(const uint8_t lut[256]);
+
+// ---------------------------------------------------------------------------
+// Spatial pixel filters
+// ---------------------------------------------------------------------------
+//
+// A second, independent effect, kept out of apply() on purpose: this one is
+// 1:1 (the picture keeps its size and its shape), it never composes with the
+// colour curve inside a single call, and the presenter is free to chain the
+// two in either order or skip either one. Nearest/Smooth/Sharp is the DS's
+// "screen filter" setting, a different axis from colour reproduction.
+//
+// Nearest is the identity. Smooth is the 3x3 binomial blur 1 2 1 / 2 4 2 /
+// 1 2 1 divided by 16 with round-half-up. Sharp re-applies the difference the
+// blur removed, centre + 2 * (centre - blur), clamped to 0..255. Borders
+// replicate: the sample coordinate is clamped to the image, so nothing outside
+// the buffer is ever read.
+//
+// Scale2x and Epx are the edge-directed family instead: they never mix two
+// pixels, they only ever copy a neighbour into the centre, and only when that
+// neighbour already matches another one. Flat runs and clean detail therefore
+// survive untouched -- where Smooth softens every edge it meets -- and no
+// output colour can appear that was not already in the neighbourhood.
+//
+// They are the 1:1 "edge repair" reduction of the classic 2x upscalers, not
+// the upscalers themselves. True Scale2x/EPX emit four pixels per input pixel
+// and so need an output buffer four times the size (twice the width and twice
+// the height); this module's caller hands over a same-size buffer, and quietly
+// allocating a 4x scratch surface inside apply_pixel_filter() would multiply
+// the per-frame memory and the presenter's blit by four with nothing in the
+// contract telling the caller. The reduction keeps the part that gives the
+// family its look: a pixel whose horizontal neighbours agree while its
+// vertical ones disagree is sitting on a horizontal edge and takes the run
+// colour, and vice versa. Applied at native resolution the visible effect is
+// edge cleanup rather than magnification, which is what the DS "screen filter"
+// setting actually buys on a fixed-size panel.
+constexpr int kPixelFilterNearest = 0;
+constexpr int kPixelFilterSmooth  = 1;
+constexpr int kPixelFilterSharp   = 2;
+constexpr int kPixelFilterScale2x = 3;
+constexpr int kPixelFilterEpx     = 4;
+constexpr int kPixelFilterCount   = 5;
+
+// Human-readable name as the settings menu spells it, or an empty string for
+// an invalid filter. Never returns nullptr.
+const char* pixel_filter_name(int filter);
+bool pixel_filter_is_valid(int filter);
+
+// Applies a 1:1 spatial filter to a tightly packed ARGB8888 image: both
+// buffers hold exactly width*height pixels and the row pitch is `width`.
+// `in` and `out` must be distinct -- the kernel reads neighbours that an
+// earlier output pixel would already have replaced. Alpha is copied from the
+// centre pixel and never filtered. Returns false (leaving `out` untouched) for
+// a null pointer, width<=0, height<=0, or in == out. An invalid `pixel_filter`
+// is not an error: it behaves as kPixelFilterNearest, so a hand-edited
+// settings value cannot corrupt the picture.
+//
+// kPixelFilterScale2x and kPixelFilterEpx compare whole ARGB words for
+// equality, alpha included, using the Scale2x convention: an edge between two
+// opaque colours is not the same edge as one between two different
+// transparencies. The centre pixel's own alpha is always what is written out,
+// so the alpha channel is never taken from a neighbour.
+bool apply_pixel_filter(const uint32_t* in, uint32_t* out, int width,
+                        int height, int pixel_filter);
+
+}  // namespace nds_display_filter
diff --git a/runner/src/frame_pacing.cpp b/runner/src/frame_pacing.cpp
new file mode 100644
index 0000000..10b88eb
--- /dev/null
+++ b/runner/src/frame_pacing.cpp
@@ -0,0 +1,167 @@
+#include "frame_pacing.h"
+
+#include <algorithm>
+
+namespace nds_frame_pacing {
+namespace {
+
+// The menu's selectable caps, in the order a player reads them. Unlimited sits
+// first because it is the default and the honest description of "as fast as the
+// host allows"; the rest step through the values players actually ask for and
+// include 60/120/144 so a panel can lock to its own field rate if the player
+// wants that.
+constexpr int kCapValues[] = {kFrameCapUnlimited, 30, 45, 60, 75, 90,
+                              100,               120, 144};
+constexpr int kCapValueCount =
+    static_cast<int>(sizeof(kCapValues) / sizeof(kCapValues[0]));
+
+// Names are static strings rather than a formatted buffer: the menu keeps the
+// pointer it is handed, so a per-call buffer would dangle. The numeric ones are
+// literals, not std::to_string calls, for the same reason.
+constexpr const char* kCapNames[kCapValueCount] = {
+    "Unlimited", "30", "45", "60", "75", "90", "100", "120", "144"};
+
+constexpr uint64_t kMillisPerSecond = 1000;
+
+uint64_t divide_round_up(uint64_t value, uint64_t divisor) {
+    if (divisor == 0) return 0;
+    return value / divisor + (value % divisor != 0 ? 1u : 0u);
+}
+
+}  // namespace
+
+int frame_cap_clamp(int cap) {
+    if (cap == kFrameCapUnlimited) return kFrameCapUnlimited;
+    return std::clamp(cap, kFrameCapMin, kFrameCapMax);
+}
+
+int frame_cap_count() { return kCapValueCount; }
+
+int frame_cap_from_index(int index) {
+    if (index < 0 || index >= kCapValueCount) return kFrameCapUnlimited;
+    return kCapValues[index];
+}
+
+int frame_cap_index(int cap) {
+    const int clamped = frame_cap_clamp(cap);
+    for (int i = 0; i < kCapValueCount; ++i) {
+        if (kCapValues[i] == clamped) return i;
+    }
+    // A cap inside the supported range but not on the list (a hand-edited
+    // settings file, say) snaps to the nearest lower rung, which caps rather
+    // than uncaps: a player who wrote 55 asked for at most 55, and landing them
+    // on 60 would hand back more frames than they asked for.
+    int best = 0;
+    for (int i = 0; i < kCapValueCount; ++i) {
+        if (kCapValues[i] == kFrameCapUnlimited) continue;
+        if (kCapValues[i] <= clamped) best = i;
+    }
+    return best;
+}
+
+const char* frame_cap_name(int cap) {
+    return kCapNames[frame_cap_index(cap)];
+}
+
+void NdsFramePacer::reset(int cap, uint64_t now_ticks,
+                          uint64_t ticks_per_second) {
+    cap_ = frame_cap_clamp(cap);
+    ticks_per_second_ = ticks_per_second;
+    active_ = cap_ != kFrameCapUnlimited && ticks_per_second != 0;
+    slot_ticks_ = active_ ? divide_round_up(ticks_per_second,
+                                            static_cast<uint64_t>(cap_))
+                          : 0;
+    // A tick rate that cannot describe even one slot is unusable, and pacing
+    // against it would divide by zero below.
+    if (slot_ticks_ == 0) active_ = false;
+    next_slot_ = now_ticks;
+    window_start_ = now_ticks;
+    presented_ = 0;
+    skipped_slots_ = 0;
+    window_presented_ = 0;
+}
+
+void NdsFramePacer::set_cap(int cap, uint64_t now_ticks) {
+    const int clamped = frame_cap_clamp(cap);
+    cap_ = clamped;
+    const bool was_active = active_;
+    active_ = clamped != kFrameCapUnlimited && ticks_per_second_ != 0;
+    slot_ticks_ = active_
+        ? divide_round_up(ticks_per_second_, static_cast<uint64_t>(clamped))
+        : 0;
+    if (slot_ticks_ == 0) active_ = false;
+    if (!active_) {
+        // Turning the cap off must not leave a deadline behind that a later
+        // re-enable would honour.
+        next_slot_ = now_ticks;
+        return;
+    }
+    if (!was_active) {
+        // Coming back from unlimited: the first frame after the change is due
+        // immediately rather than one slot later, so a menu toggle feels
+        // instant instead of introducing a one-frame stall.
+        next_slot_ = now_ticks;
+        return;
+    }
+    // Re-anchor to whichever is later. Anchoring to `now` alone would let a
+    // long stall release its whole backlog at once (a burst); anchoring to the
+    // stale `next_slot` alone would make a lower cap overshoot its deadline.
+    next_slot_ = std::max(now_ticks, next_slot_);
+}
+
+bool NdsFramePacer::should_present(uint64_t now_ticks) {
+    if (!active_) {
+        ++presented_;
+        ++window_presented_;
+        return true;
+    }
+    if (now_ticks < next_slot_) return false;
+    // Late frames advance the deadline by whole slots from the CURRENT
+    // deadline, not from `now`, so the phase never drifts. When the caller has
+    // been away for several slots, the deadline is jumped forward to the next
+    // one still in the future and the rest are counted as skipped -- that is
+    // the bounded skip: the caller presents one frame now and never a burst.
+    const uint64_t behind = (now_ticks - next_slot_) / slot_ticks_ + 1u;
+    next_slot_ += behind * slot_ticks_;
+    if (behind > 1u) {
+        // Saturating add on the 64-bit value BEFORE the cast. Testing the
+        // uint32_t after the cast cannot work: an eight-month stall produces a
+        // `behind - 1` near 6e13, whose low 32 bits are an arbitrary small
+        // number, so a wrap check on the truncated value sees nothing wrong.
+        // The counter is a diagnostic, not a state machine; saturating keeps it
+        // honest instead of wrapping to a small number mid-pause.
+        const uint64_t advance = behind - 1u;
+        if (advance > 0xFFFFFFFFu - skipped_slots_)
+            skipped_slots_ = 0xFFFFFFFFu;
+        else
+            skipped_slots_ += static_cast<uint32_t>(advance);
+    }
+    ++presented_;
+    ++window_presented_;
+    return true;
+}
+
+uint32_t NdsFramePacer::suggested_sleep_ms(uint64_t now_ticks) const {
+    if (!active_ || now_ticks >= next_slot_) return 0;
+    const uint64_t remaining_ticks = next_slot_ - now_ticks;
+    // Round UP: a caller that sleeps for the floor would wake just before the
+    // deadline and have to sleep again, and at 144 fps the floor is 0 ms, which
+    // would spin the frame loop at full tilt.
+    const uint64_t millis = divide_round_up(remaining_ticks * kMillisPerSecond,
+                                            ticks_per_second_);
+    const uint64_t slot_millis =
+        divide_round_up(slot_ticks_ * kMillisPerSecond, ticks_per_second_);
+    const uint64_t bounded = std::max<uint64_t>(1u, std::min(millis, slot_millis));
+    return static_cast<uint32_t>(bounded);
+}
+
+double NdsFramePacer::measured_fps(uint64_t now_ticks) const {
+    if (!active_ || now_ticks <= window_start_ || ticks_per_second_ == 0)
+        return 0.0;
+    const uint64_t elapsed = now_ticks - window_start_;
+    return static_cast<double>(window_presented_) *
+           static_cast<double>(ticks_per_second_) /
+           static_cast<double>(elapsed);
+}
+
+}  // namespace nds_frame_pacing
diff --git a/runner/src/frame_pacing.h b/runner/src/frame_pacing.h
new file mode 100644
index 0000000..3d5f447
--- /dev/null
+++ b/runner/src/frame_pacing.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include <cstdint>
+
+// Host-only frame-rate cap: how many times per second the picture is redrawn.
+//
+// The DS itself produces exactly one frame per vblank (59.826 Hz), and the
+// frontend's scheduler gate advances the guest by exactly one kSystemCyclesPer
+// Frame per loop iteration. So the guest can never produce MORE than its native
+// field rate, and the only thing a cap can usefully do is redraw LESS often:
+// at 30 fps every second picture is skipped. That is why this is a
+// PRESENTATION cap and not an emulation-speed cap.
+//
+// It is deliberately presentation-only because emulation speed is not free to
+// change here. The mixer produces one frame of samples per guest frame and the
+// host audio device pulls at a fixed 32768 Hz, and drain_audio() already uses
+// the queue depth as the loop's real-time clock ("Audio is the host's
+// real-time clock. Never drop a produced block"). Slowing the guest to hit a
+// 30 fps cap would hand the device half the samples it asks for and every
+// buffer would underrun. So the machine, the mixer and the input cadence all
+// keep running at their native rate; only the SDL present is held back. A
+// player gets the frame rate they asked for and the audio they had.
+//
+// Consequence worth stating plainly: with the default Unlimited there is no
+// change at all, and a cap of 60 or above never binds on a title that is
+// already pacing at its native rate. The cap is meaningful for 30..59.
+//
+// Why this is a module and not a few lines in the frame loop: the arithmetic
+// is a fixed-point phase accumulator, and every easy version of it is subtly
+// wrong. Sleeping `1000 / cap` milliseconds per frame rounds each frame up to
+// the 1 ms SDL_Delay granularity and drifts (30 fps becomes 31.2). Sleeping
+// until `next_deadline` and not updating the deadline makes one slow frame
+// permanently shift the phase. Skipping the slots in between makes the caller
+// present in bursts. The accumulator below advances by whole slots and hands
+// the caller a decision, so a frame that arrives late is either presented
+// immediately or skipped by exactly one slot, never by an unbounded burst.
+//
+// The caller owns the clock. Every entry point takes `now_ticks` in whatever
+// units `ticks_per_second` describes, which is what makes this testable with a
+// synthetic clock and makes it impossible for the module to read wall time
+// behind the caller's back.
+namespace nds_frame_pacing {
+
+// 0 means "no cap": present every guest frame the machine produces, which is
+// the shipped default and matches the reference project's "Unlimited".
+constexpr int kFrameCapUnlimited = 0;
+constexpr int kFrameCapMin = 30;
+constexpr int kFrameCapMax = 144;
+
+// The DS's own field rate. A cap at or above this changes nothing (the guest
+// cannot produce more), but it is still a legal, selectable value because a
+// player asking for "144" wants the ceiling gone rather than an error.
+constexpr int kNativeRefreshHz = 60;
+
+// Clamps `cap` into {0} U [kFrameCapMin, kFrameCapMax]. 0 stays 0 (unlimited);
+// anything else is pulled into the supported window, so a hand-edited settings
+// file cannot produce a 1 fps or a 10000 fps cap.
+int frame_cap_clamp(int cap);
+
+// The menu's list of selectable caps, in display order. `frame_cap_from_index`
+// maps a menu row index back to a cap, and `frame_cap_index` does the reverse
+// (returning the closest row for a cap that is not exactly on the list, so a
+// value written by an older version still lands on something sensible).
+int frame_cap_count();
+int frame_cap_from_index(int index);
+int frame_cap_index(int cap);
+
+// The name the settings menu spells: "Unlimited", "30", "60", … Never returns
+// nullptr, and an out-of-range cap is named after its clamped value.
+const char* frame_cap_name(int cap);
+
+// A phase accumulator over presentation slots.
+//
+// One slot is `ticks_per_second / cap` ticks. The pacer keeps `next_slot`, the
+// tick at which the next present is allowed. should_present() is true once
+// now_ticks >= next_slot, and consumes exactly one slot when it says so.
+//
+// Nothing here touches the machine. The caller emulates every frame it was
+// going to emulate anyway and asks this only whether to hand the resulting
+// framebuffer to the display.
+struct NdsFramePacer {
+    // (Re)starts the pacer with `cap` redraws per second at tick `now_ticks`.
+    // A cap of 0 or an unusable ticks_per_second disables pacing entirely, so
+    // every subsequent should_present() returns true without advancing
+    // anything. Resets the measurement counters, so a cap change starts a fresh
+    // measurement window rather than reporting a rate that spans two caps.
+    void reset(int cap, uint64_t now_ticks, uint64_t ticks_per_second);
+
+    // Changes the cap without stalling or bursting. Re-anchors `next_slot` to
+    // whichever is later, `now_ticks` or the previous deadline, so raising the
+    // cap takes effect on the next slot instead of releasing a backlog of
+    // instantly-due frames. Keeps the measurement counters.
+    void set_cap(int cap, uint64_t now_ticks);
+
+    // True when the caller may start a frame now. Consumes one slot when true.
+    bool should_present(uint64_t now_ticks);
+
+    // Milliseconds to sleep before calling should_present() again, or 0 when
+    // the next frame is already due. Never returns a value large enough to
+    // overshoot the deadline by a whole slot: it rounds up to the next
+    // millisecond so a 1 ms SDL_Delay granularity cannot spin, and it is capped
+    // at one slot's worth of milliseconds.
+    uint32_t suggested_sleep_ms(uint64_t now_ticks) const;
+
+    int cap() const { return cap_; }
+    // True when the pacer is configured and pacing (cap != 0 and a usable
+    // tick rate). False means every should_present() returns true.
+    bool active() const { return active_; }
+
+    // Frames actually presented / slots that passed without one, since reset.
+    // `skipped_slots` is the observable "the cap is biting" number: it counts
+    // the slots the pacer let go by, which is exactly what a 30 fps cap on a
+    // 60 Hz-cadence guest produces.
+    uint32_t presented() const { return presented_; }
+    uint32_t skipped_slots() const { return skipped_slots_; }
+
+    // Presented frames per second over the last `sample_window_ticks`, or 0
+    // when pacing is off. Measured from the tick stamps the caller supplied, so
+    // it is the rate the cap actually achieved rather than the rate it asked
+    // for.
+    double measured_fps(uint64_t now_ticks) const;
+
+    // Ticks per second and one slot in ticks, both exposed so the caller (and
+    // its tests) can reason about the same numbers the implementation uses.
+    uint64_t ticks_per_second() const { return ticks_per_second_; }
+    uint64_t slot_ticks() const { return slot_ticks_; }
+
+    int cap_ = kFrameCapUnlimited;
+    bool active_ = false;
+    uint64_t ticks_per_second_ = 0;
+    uint64_t slot_ticks_ = 0;
+    uint64_t next_slot_ = 0;
+    uint64_t window_start_ = 0;
+    uint32_t presented_ = 0;
+    uint32_t skipped_slots_ = 0;
+    uint32_t window_presented_ = 0;
+};
+
+}  // namespace nds_frame_pacing
diff --git a/runner/src/frontend_runtime_settings.cpp b/runner/src/frontend_runtime_settings.cpp
new file mode 100644
index 0000000..75f6c03
--- /dev/null
+++ b/runner/src/frontend_runtime_settings.cpp
@@ -0,0 +1,141 @@
+#include "frontend_runtime_settings.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "display_filters.h"
+#include "frame_pacing.h"
+#include "frontend_settings.h"
+
+namespace {
+
+// Every key the menu surface owns, in the order it writes them. Keeping one
+// table means load and store cannot drift apart: a key added here is both read
+// and written, and the test that walks the table covers both directions.
+struct KeyBinding {
+    const char* key;
+    int NdsRuntimeMenuSnapshot::*field;
+    int minimum;
+    int maximum;
+};
+
+constexpr KeyBinding kBindings[] = {
+    {"display.fullscreen", &NdsRuntimeMenuSnapshot::fullscreen, 0, 2},
+    {"display.window_scale", &NdsRuntimeMenuSnapshot::window_scale, 1,
+     NdsRuntimeMenuSnapshot::kWindowScaleMax},
+    // The six presentation shapes, in the order NdsScreenLayout declares them.
+    // The maximum is written as a literal because this file deliberately does
+    // not include frontend.h: the settings surface is stored state, and a
+    // stored index must keep meaning the same shape even if the enum is
+    // extended later, so both ends name the same fixed range and the test pins
+    // index -> layout by name.
+    {"display.screen_layout", &NdsRuntimeMenuSnapshot::screen_layout, 0, 5},
+    {"display.swap_screens", &NdsRuntimeMenuSnapshot::swap_screens, 0, 1},
+    {"display.second_monitor", &NdsRuntimeMenuSnapshot::second_monitor, 0, 1},
+    {"display.minimap", &NdsRuntimeMenuSnapshot::minimap, 0, 1},
+    {"display.vsync", &NdsRuntimeMenuSnapshot::vsync, 0, 1},
+    {"graphics.integer_scale", &NdsRuntimeMenuSnapshot::integer_scale, 0, 1},
+    {"graphics.linear_filter", &NdsRuntimeMenuSnapshot::linear_filter, 0, 1},
+    {"graphics.resolution_scale", &NdsRuntimeMenuSnapshot::resolution_scale, 1,
+     NdsRuntimeMenuSnapshot::kResolutionScaleMax},
+    {"graphics.color_mode", &NdsRuntimeMenuSnapshot::color_mode, 0,
+     nds_display_filter::kColorModeCount - 1},
+    {"graphics.lcd_grid", &NdsRuntimeMenuSnapshot::lcd_grid, 0, 1},
+    {"graphics.pixel_filter", &NdsRuntimeMenuSnapshot::pixel_filter, 0,
+     nds_display_filter::kPixelFilterCount - 1},
+    {"audio.enabled", &NdsRuntimeMenuSnapshot::audio_enabled, 0, 1},
+    {"audio.volume", &NdsRuntimeMenuSnapshot::volume, 0,
+     NdsRuntimeMenuSnapshot::kVolumeMax},
+    {"system.state_slot", &NdsRuntimeMenuSnapshot::state_slot, 1,
+     NdsRuntimeMenuSnapshot::kStateSlotMax},
+    {"system.pause_in_menu", &NdsRuntimeMenuSnapshot::pause_in_menu, 0, 1},
+    {"input.fast_forward", &NdsRuntimeMenuSnapshot::fast_forward, 0, 1},
+    {"display.menu_dim", &NdsRuntimeMenuSnapshot::menu_dim, 0, 100},
+    {"display.menu_opacity", &NdsRuntimeMenuSnapshot::menu_opacity, 0, 100},
+    {"input.mouse_sensitivity", &NdsRuntimeMenuSnapshot::mouse_sensitivity,
+     NdsRuntimeMenuSnapshot::kMouseSensitivityMin,
+     NdsRuntimeMenuSnapshot::kMouseSensitivityMax},
+    // 0 is a legal value here, not a sentinel for "unset": it is the
+    // Unlimited row, and it is the shipped default.
+    {"display.frame_cap", &NdsRuntimeMenuSnapshot::frame_cap, 0,
+     nds_frame_pacing::kFrameCapMax},
+};
+
+void clamp_to(int* value, int minimum, int maximum) {
+    *value = std::clamp(*value, minimum, maximum);
+}
+
+const KeyBinding* find_binding(const char* key) {
+    if (!key) return nullptr;
+    for (const KeyBinding& binding : kBindings)
+        if (std::strcmp(binding.key, key) == 0) return &binding;
+    return nullptr;
+}
+
+}  // namespace
+
+bool nds_runtime_menu_key_range(const char* key, int* minimum, int* maximum) {
+    const KeyBinding* binding = find_binding(key);
+    if (!binding) return false;
+    if (minimum) *minimum = binding->minimum;
+    if (maximum) *maximum = binding->maximum;
+    return true;
+}
+
+int* nds_runtime_menu_field(NdsRuntimeMenuSnapshot* snapshot, const char* key) {
+    const KeyBinding* binding = find_binding(key);
+    if (!snapshot || !binding) return nullptr;
+    return &(snapshot->*(binding->field));
+}
+
+void NdsRuntimeMenuSnapshot::clamp() {
+    for (const KeyBinding& binding : kBindings)
+        clamp_to(&(this->*(binding.field)), binding.minimum,
+                 binding.maximum);
+}
+
+bool nds_runtime_menu_load(const std::string& path,
+                           NdsRuntimeMenuSnapshot* out) {
+    if (!out) return false;
+    NdsRuntimeSettingsFile settings;
+    if (!settings.load(path)) return false;
+    NdsRuntimeMenuSnapshot snapshot{};
+    for (const KeyBinding& binding : kBindings) {
+        // get_int's fallback is the compiling default, so an absent key and a
+        // key holding garbage both leave the default in place.
+        snapshot.*(binding.field) =
+            settings.get_int(binding.key, snapshot.*(binding.field));
+    }
+    snapshot.clamp();
+    *out = snapshot;
+    return true;
+}
+
+bool nds_runtime_menu_overlay(const std::string& path,
+                              NdsRuntimeMenuSnapshot* snapshot) {
+    if (!snapshot) return false;
+    NdsRuntimeSettingsFile settings;
+    if (!settings.load(path)) return false;
+    for (const KeyBinding& binding : kBindings) {
+        int* field = &(snapshot->*(binding.field));
+        // The current value is the fallback: a key the file does not hold keeps
+        // whatever the launcher/CLI/config already decided.
+        *field = settings.get_int(binding.key, *field);
+    }
+    snapshot->clamp();
+    return true;
+}
+
+bool nds_runtime_menu_store(const std::string& path,
+                            const NdsRuntimeMenuSnapshot& snapshot) {
+    // Preserve everything the file already holds; only the menu's own keys are
+    // rewritten. NdsRuntimeSettingsFile keeps comments, blank lines, foreign
+    // keys and their order.
+    NdsRuntimeSettingsFile settings;
+    settings.load(path);
+    NdsRuntimeMenuSnapshot clamped = snapshot;
+    clamped.clamp();
+    for (const KeyBinding& binding : kBindings)
+        settings.set_int(binding.key, clamped.*(binding.field));
+    return settings.save(path);
+}
diff --git a/runner/src/frontend_runtime_settings.h b/runner/src/frontend_runtime_settings.h
new file mode 100644
index 0000000..92b1e19
--- /dev/null
+++ b/runner/src/frontend_runtime_settings.h
@@ -0,0 +1,138 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// The values the in-game settings menu owns, in the plain numeric form the
+// shared runtime UI speaks (every row is a BOOL, an INT or a CHOICE index).
+//
+// This exists so that "what the menu shows" and "what gets written to disk" can
+// be pinned by a unit test without SDL, a renderer, or a running machine: the
+// frontend translates this snapshot into engine calls, and the translation is
+// the only part that needs a live emulator.
+struct NdsRuntimeMenuSnapshot {
+    enum : int {
+        kStateSlotMax = 12,
+        kWindowScaleMax = 4,
+        kResolutionScaleMax = 4,
+        kVolumeMax = 100,
+        kMouseSensitivityMin = 10,
+        kMouseSensitivityMax = 400,
+    };
+
+    // display.fullscreen, index into Windowed/Borderless/Exclusive.
+    int fullscreen = 0;
+    // display.window_scale, a multiple of the native 256x192 window.
+    int window_scale = 2;
+    // display.screen_layout: which of the one-window presentation shapes the
+    // player wants, as an index into NdsScreenLayout (Stacked, Separate,
+    // SideBySide, TopOnly, BottomOnly, Square). Stored as a number because the
+    // settings file is a flat key/value surface and the menu edits an INT;
+    // the frontend converts with a single cast and one comment. Stacked is the
+    // shipped default, so a build that never touches this row behaves exactly
+    // as before.
+    int screen_layout = 0;
+    // display.swap_screens: exchange which picture is drawn where. On a
+    // one-screen layout it exchanges which SCREEN is shown, which is the whole
+    // point of the key: a player who wants to see the bottom screen only while
+    // a map is open does not want to relaunch.
+    int swap_screens = 0;
+    // display.second_monitor: put the touch window on another display. Only the
+    // two-window layout has a second window to move, so the row is refused
+    // (not silently ignored) everywhere else.
+    int second_monitor = 0;
+    // display.minimap: while a one-screen layout hides a picture, draw the
+    // hidden one as a small inset. Off by default: it covers part of the game.
+    int minimap = 0;
+    // display.vsync: present in step with the display refresh. ON by default,
+    // which is what an SDL renderer already does when nobody asks it anything
+    // -- so the shipped behaviour is unchanged and the row exists so it can be
+    // turned OFF for latency.
+    int vsync = 1;
+    // graphics.integer_scale: snap the presentation to whole native pixels.
+    int integer_scale = 1;
+    // graphics.linear_filter: LINEAR texture sampling instead of NEAREST.
+    int linear_filter = 0;
+    // graphics.resolution_scale: the 3D engine's internal resolution.
+    int resolution_scale = 1;
+    // graphics.color_mode: the DS's "colour reproduction" curves, indexed the
+    // way the display filter module numbers them (Original/Light/Moderate/
+    // Strong). 0 is the untouched picture and the shipped default.
+    int color_mode = 0;
+    // graphics.lcd_grid: dim one pixel in two to imitate the panel grid of the
+    // original hardware. Off by default; it costs picture sharpness on purpose.
+    int lcd_grid = 0;
+    // graphics.pixel_filter: the 1:1 spatial filter (Nearest/Smooth/Sharp)
+    // applied to the composed picture. Nearest is the shipped default and is a
+    // straight copy, so nothing changes until the player asks for it.
+    int pixel_filter = 0;
+    // display.frame_cap: the host-side frame-rate ceiling in frames per second,
+    // or 0 for "Unlimited" (the shipped default, which is what the frontend
+    // already does: it runs one guest frame per vblank and lets the host catch
+    // up). Values are clamped into the frame-pacing module's supported window
+    // (0, or 30..144) so a hand-edited file cannot ask for 2 fps or 10000.
+    int frame_cap = 0;
+    // audio.enabled / audio.volume.
+    int audio_enabled = 1;
+    int volume = kVolumeMax;
+    // system.state_slot (1-based, matching the F1..F12 shortcuts).
+    int state_slot = 1;
+    // system.pause_in_menu: hold the machine while the menu is open.
+    int pause_in_menu = 0;
+    // input.fast_forward: hold Tab to run the machine as fast as the host
+    // allows. On by default, the way Egg of Time ships fast-forward on.
+    int fast_forward = 1;
+    // input.mouse_sensitivity, only meaningful for a title with a relative
+    // mouse binding; carried here anyway so one file holds one surface.
+    int mouse_sensitivity = 100;
+    // display.menu_dim / display.menu_opacity, the shared menu's own backdrop
+    // rows (percents, 0..100). Kept in the same file so a player who dims the
+    // game behind the menu sees that choice survive a restart.
+    int menu_dim = 60;
+    int menu_opacity = 100;
+
+    // Clamps every field into its documented range. Out-of-range values are
+    // what an edited or truncated file produces, and a menu row whose value is
+    // outside its own minimum/maximum is not merely cosmetic: the model snaps
+    // the cursor to it and the first LEFT/RIGHT steps out of range again.
+    void clamp();
+};
+
+// The shared runtime-UI key ("display.fullscreen", "audio.volume", ...) that
+// owns a snapshot field, and that row's documented range.
+//
+// The menu is built from the shared recomp-ui standard menu, whose rows are
+// addressed by exactly these key strings, so this is the single place where a
+// row is bound to the value it edits: the frontend does not carry a second
+// table that could drift from the persisted one. A key this runner does not
+// back returns false, which is how a menu row can be left unbuilt rather than
+// built and dead.
+bool nds_runtime_menu_key_range(const char* key, int* minimum, int* maximum);
+
+// The snapshot field a shared runtime-UI key owns, or nullptr when the key is
+// not backed here. Used by the menu callbacks, which the shared UI calls with
+// nothing but the item's key.
+int* nds_runtime_menu_field(NdsRuntimeMenuSnapshot* snapshot, const char* key);
+
+// Reads the menu surface out of `path`, leaving `out` untouched and returning
+// false when the file is missing or unreadable. Keys that are absent keep the
+// default; keys that are present but unparsable also keep the default (the file
+// is a human-editable format and one bad line must not discard the rest).
+bool nds_runtime_menu_load(const std::string& path,
+                           NdsRuntimeMenuSnapshot* out);
+
+// Overlays the keys `path` actually holds onto `snapshot`, leaving every absent
+// field alone. This is the form the runner uses at startup: the game config and
+// the command line seed the snapshot, so a title's chosen launch configuration
+// stays the default and a saved menu choice only overrides what the player
+// really changed. Returns false when the file is missing or unreadable, in
+// which case `snapshot` is untouched.
+bool nds_runtime_menu_overlay(const std::string& path,
+                              NdsRuntimeMenuSnapshot* snapshot);
+
+// Writes the menu surface into `path`, preserving every other line of the file
+// (a launcher's own keys, comments, unknown future keys) and replacing it
+// atomically. Returns false when the write fails; the previous file then stays
+// intact.
+bool nds_runtime_menu_store(const std::string& path,
+                            const NdsRuntimeMenuSnapshot& snapshot);
diff --git a/runner/src/frontend_settings.cpp b/runner/src/frontend_settings.cpp
new file mode 100644
index 0000000..a393054
--- /dev/null
+++ b/runner/src/frontend_settings.cpp
@@ -0,0 +1,188 @@
+#include "frontend_settings.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <system_error>
+
+namespace {
+
+bool parse_int(const std::string& text, int* out) {
+    if (text.empty()) return false;
+    char* end = nullptr;
+    const long long value = std::strtoll(text.c_str(), &end, 10);
+    if (end == text.c_str() || end == nullptr || *end != '\0') return false;
+    if (value < -2147483647LL - 1 || value > 2147483647LL) return false;
+    *out = static_cast<int>(value);
+    return true;
+}
+
+std::string trim_ascii(const std::string& text) {
+    size_t begin = 0;
+    size_t end = text.size();
+    while (begin < end && (text[begin] == ' ' || text[begin] == '\t' ||
+                           text[begin] == '\r' || text[begin] == '\n'))
+        ++begin;
+    while (end > begin && (text[end - 1] == ' ' || text[end - 1] == '\t' ||
+                           text[end - 1] == '\r' || text[end - 1] == '\n'))
+        --end;
+    return text.substr(begin, end - begin);
+}
+
+}  // namespace
+
+const std::string* NdsRuntimeSettingsFile::find(const std::string& key) const {
+    for (const auto& entry : entries_)
+        if (!entry.first.empty() && entry.first == key) return &entry.second;
+    return nullptr;
+}
+
+std::string* NdsRuntimeSettingsFile::find(const std::string& key) {
+    for (auto& entry : entries_)
+        if (!entry.first.empty() && entry.first == key) return &entry.second;
+    return nullptr;
+}
+
+bool NdsRuntimeSettingsFile::load(const std::string& path) {
+    entries_.clear();
+    if (path.empty()) return false;
+    std::ifstream in(path);
+    if (!in) return false;
+    std::string line;
+    bool saw_version = false;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        const size_t equals = line.find('=');
+        if (equals == std::string::npos) {
+            // Comment or blank line: kept verbatim so hand edits survive.
+            entries_.emplace_back(std::string(), line);
+            continue;
+        }
+        const std::string key = trim_ascii(line.substr(0, equals));
+        if (key.empty()) {
+            entries_.emplace_back(std::string(), line);
+            continue;
+        }
+        if (key == kVersionKey) saw_version = true;
+        entries_.emplace_back(key, trim_ascii(line.substr(equals + 1)));
+    }
+    if (!saw_version)
+        entries_.insert(entries_.begin(),
+                        {std::string(kVersionKey), std::to_string(kVersion)});
+    return true;
+}
+
+bool NdsRuntimeSettingsFile::save(const std::string& path) const {
+    if (path.empty()) return false;
+    const std::filesystem::path target(path);
+    std::error_code error;
+    if (!target.parent_path().empty()) {
+        std::filesystem::create_directories(target.parent_path(), error);
+        if (error) return false;
+    }
+    std::filesystem::path temporary = target;
+    temporary += ".tmp";
+    {
+        std::ofstream out(temporary, std::ios::trunc | std::ios::binary);
+        if (!out) return false;
+        // A brand-new file has nothing to load, so parse-time version insertion
+        // never ran: write it here instead, or the first save of a fresh
+        // settings file would be a versionless file the header claims cannot
+        // exist.
+        if (!has(kVersionKey)) {
+            out << kVersionKey << '=' << kVersion << '\n';
+        }
+        out << render();
+        out.flush();
+        if (!out) {
+            out.close();
+            std::filesystem::remove(temporary, error);
+            return false;
+        }
+    }
+    // rename() over an existing file replaces it atomically on both POSIX and
+    // Windows (where filesystem maps to MoveFileEx with the replace flag), so a
+    // reader either sees the old file or the new one -- never a truncated one.
+    std::filesystem::rename(temporary, target, error);
+    if (error) {
+        std::filesystem::remove(temporary, error);
+        return false;
+    }
+    return true;
+}
+
+std::string NdsRuntimeSettingsFile::render() const {
+    std::string text;
+    for (const auto& entry : entries_) {
+        if (entry.first.empty()) {
+            text += entry.second;
+        } else {
+            text += entry.first;
+            text += '=';
+            text += entry.second;
+        }
+        text += '\n';
+    }
+    return text;
+}
+
+int NdsRuntimeSettingsFile::get_int(const std::string& key, int fallback) const {
+    const std::string* value = find(key);
+    if (!value) return fallback;
+    int parsed = 0;
+    return parse_int(*value, &parsed) ? parsed : fallback;
+}
+
+bool NdsRuntimeSettingsFile::get_bool(const std::string& key,
+                                      bool fallback) const {
+    const std::string* value = find(key);
+    if (!value) return fallback;
+    if (*value == "1" || *value == "true" || *value == "on" || *value == "yes")
+        return true;
+    if (*value == "0" || *value == "false" || *value == "off" || *value == "no")
+        return false;
+    return fallback;
+}
+
+std::string NdsRuntimeSettingsFile::get_string(
+    const std::string& key, const std::string& fallback) const {
+    const std::string* value = find(key);
+    return value ? *value : fallback;
+}
+
+void NdsRuntimeSettingsFile::set_int(const std::string& key, int value) {
+    set_string(key, std::to_string(value));
+}
+
+void NdsRuntimeSettingsFile::set_bool(const std::string& key, bool value) {
+    set_string(key, value ? "1" : "0");
+}
+
+void NdsRuntimeSettingsFile::set_string(const std::string& key,
+                                        const std::string& value) {
+    if (key.empty() || key == kVersionKey) return;
+    if (std::string* existing = find(key)) {
+        *existing = value;
+        return;
+    }
+    // Keep settings_version first: a new key is appended at the end, which also
+    // keeps the file stable across saves.
+    entries_.emplace_back(key, value);
+}
+
+bool NdsRuntimeSettingsFile::has(const std::string& key) const {
+    return find(key) != nullptr;
+}
+
+bool NdsRuntimeSettingsFile::erase(const std::string& key) {
+    const auto removed = std::remove_if(
+        entries_.begin(), entries_.end(),
+        [&key](const std::pair<std::string, std::string>& entry) {
+            return !entry.first.empty() && entry.first == key;
+        });
+    if (removed == entries_.end()) return false;
+    entries_.erase(removed, entries_.end());
+    return true;
+}
diff --git a/runner/src/frontend_settings.h b/runner/src/frontend_settings.h
new file mode 100644
index 0000000..2498d4a
--- /dev/null
+++ b/runner/src/frontend_settings.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Persisted runtime (in-game menu) settings.
+//
+// The on-disk format is the shared launcher/runtime key/value file: one
+// `key=value` per line, blank lines and `#` comments carried through verbatim,
+// and every key the runner does not recognise preserved so a newer launcher's
+// settings survive a round trip through an older runner. The first line is
+// `settings_version=<n>`; the runner keeps whatever version it finds and
+// writes 12 when the file has none, which is the version the runtime settings
+// surface has been writing since it was introduced.
+//
+// Saving is atomic (temp file + rename). A crash or a power loss during a save
+// therefore leaves the previous file intact instead of a half-written one;
+// this is the failure mode a plain truncating write has and it silently
+// destroys every setting at once.
+class NdsRuntimeSettingsFile {
+public:
+    // Written when the file has no `settings_version` line yet.
+    static constexpr int kVersion = 12;
+    static constexpr const char* kVersionKey = "settings_version";
+
+    // Reads `path`. A missing file is not an error: the object keeps whatever
+    // it already held (empty for a fresh one) and returns false so the caller
+    // can tell "no settings yet" from "loaded". A file that exists but cannot
+    // be read also returns false, with the object left empty.
+    bool load(const std::string& path);
+
+    // Writes `path`, creating parent directories and replacing the destination
+    // atomically. Returns false (with the previous file untouched) when the
+    // temporary file or the rename fails.
+    bool save(const std::string& path) const;
+
+    // Typed accessors. `get_*` returns `fallback` when the key is absent or its
+    // value does not parse; a present-but-unparsable value is NOT rewritten, so
+    // a human editing the file keeps their text until the menu changes it.
+    int get_int(const std::string& key, int fallback) const;
+    bool get_bool(const std::string& key, bool fallback) const;
+    std::string get_string(const std::string& key,
+                           const std::string& fallback) const;
+
+    // Assigns (or appends) a key. Existing order is preserved so the file does
+    // not churn on every save.
+    void set_int(const std::string& key, int value);
+    void set_bool(const std::string& key, bool value);
+    void set_string(const std::string& key, const std::string& value);
+
+    bool has(const std::string& key) const;
+    bool erase(const std::string& key);
+    size_t size() const { return entries_.size(); }
+    // Rendered file contents, for tests and diagnostics.
+    std::string render() const;
+
+private:
+    const std::string* find(const std::string& key) const;
+    std::string* find(const std::string& key);
+
+    // Ordered key/value pairs. Comments and blank lines are kept as entries
+    // whose key is empty, so a hand-edited file keeps its layout.
+    std::vector<std::pair<std::string, std::string>> entries_;
+};
diff --git a/runner/src/host_capture.cpp b/runner/src/host_capture.cpp
new file mode 100644
index 0000000..8a501ae
--- /dev/null
+++ b/runner/src/host_capture.cpp
@@ -0,0 +1,436 @@
+// host_capture.cpp -- see host_capture.h.
+//
+// The PNG writer is self-contained on purpose. The runner does not link zlib,
+// libpng or SDL_image, and adding one of them for screenshots would make the
+// build depend on a system library the project otherwise never touches. PNG
+// allows deflate "stored" blocks, so the bytes are wrapped in zlib framing and
+// written uncompressed: every decoder accepts it, the encoder needs no
+// compressor and no Huffman tables, and a 256x192 DS frame is only ~150 KiB.
+//
+// The whole file is assembled in one buffer and written with a single
+// ofstream::write. A capture is a debug action, not a hot path, and one
+// call-sized allocation is far easier to audit than a hand-rolled streaming
+// chunk writer -- the CRC and the IDAT length both need the complete payload
+// anyway.
+
+#include "host_capture.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <mutex>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+// Last failure on this thread. The header documents that the pointer returned
+// by nds_capture_last_error() is invalidated by the next capture call on the
+// same thread; a thread_local buffer makes concurrent captures independent.
+thread_local std::string g_last_error;
+
+void set_error(const std::string& text) { g_last_error = text; }
+
+// Text for an errno value. The generic category is locale- and
+// thread-independent, which the C strerror() family is not; the code is fed
+// through as an int because errno constants are not std::errc enumerators.
+std::string errno_text(int code) {
+    if (code == 0) return "unknown error";
+    return std::error_code(code, std::generic_category()).message();
+}
+
+// ---- CRC-32 (PNG polynomial 0xEDB88320, reflected) ------------------------
+
+constexpr uint32_t kCrcInit = 0xFFFFFFFFu;
+
+std::array<uint32_t, 256> g_crc_table{};
+std::once_flag g_crc_table_once;
+
+void build_crc_table() {
+    for (uint32_t index = 0; index < 256u; ++index) {
+        uint32_t value = index;
+        for (int bit = 0; bit < 8; ++bit) {
+            value = (value & 1u) ? (0xEDB88320u ^ (value >> 1u))
+                                 : (value >> 1u);
+        }
+        g_crc_table[index] = value;
+    }
+}
+
+uint32_t crc32_update(uint32_t crc, const void* data, size_t size) {
+    std::call_once(g_crc_table_once, build_crc_table);
+    const uint8_t* bytes = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; ++i) {
+        crc = g_crc_table[(crc ^ bytes[i]) & 0xFFu] ^ (crc >> 8u);
+    }
+    return crc;
+}
+
+// ---- Adler-32 -------------------------------------------------------------
+
+constexpr uint32_t kAdlerModulus = 65521u;
+// Largest n with (n * 255) + 65520 still fitting in 32 bits, from zlib's
+// reference implementation; reduces the moduli to once per block.
+constexpr size_t kAdlerChunk = 5552u;
+
+uint32_t adler32_bytes(const uint8_t* data, size_t size) {
+    uint32_t low = 1u;
+    uint32_t high = 0u;
+    while (size > 0u) {
+        const size_t chunk = std::min(size, kAdlerChunk);
+        for (size_t i = 0; i < chunk; ++i) {
+            low += data[i];
+            high += low;
+        }
+        low %= kAdlerModulus;
+        high %= kAdlerModulus;
+        data += chunk;
+        size -= chunk;
+    }
+    return (high << 16u) | low;
+}
+
+// ---- big-endian byte builders --------------------------------------------
+
+void append_u32be(std::vector<uint8_t>& out, uint32_t value) {
+    out.push_back(static_cast<uint8_t>(value >> 24u));
+    out.push_back(static_cast<uint8_t>(value >> 16u));
+    out.push_back(static_cast<uint8_t>(value >> 8u));
+    out.push_back(static_cast<uint8_t>(value));
+}
+
+void append_bytes(std::vector<uint8_t>& out, const void* data, size_t size) {
+    const uint8_t* bytes = static_cast<const uint8_t*>(data);
+    out.insert(out.end(), bytes, bytes + size);
+}
+
+// Chunk layout: length (BE, data only), type, data, CRC (BE) over type+data.
+void append_chunk(std::vector<uint8_t>& out, const char type[5],
+                  const void* data, size_t size) {
+    append_u32be(out, static_cast<uint32_t>(size));
+    append_bytes(out, type, 4u);
+    if (size > 0u) append_bytes(out, data, size);
+    uint32_t crc = crc32_update(kCrcInit, type, 4u);
+    if (size > 0u) crc = crc32_update(crc, data, size);
+    append_u32be(out, ~crc);
+}
+
+// ---- path construction ----------------------------------------------------
+
+// Every character outside [A-Za-z0-9._-] becomes '_'. The explicit ranges are
+// deliberate: std::isalnum is locale-dependent and a locale with a multibyte
+// notion of "alphanumeric" would leak arbitrary bytes into the filename.
+bool stem_char_is_plain(char ch) {
+    return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
+           (ch >= '0' && ch <= '9') || ch == '.' || ch == '_' || ch == '-';
+}
+
+std::string sanitise_stem(const std::string& stem) {
+    std::string result;
+    result.reserve(stem.size());
+    for (const char ch : stem) {
+        result.push_back(stem_char_is_plain(ch) ? ch : '_');
+    }
+    if (result.empty()) result = "screenshot";
+    return result;
+}
+
+std::string forward_slashes(std::string text) {
+    std::replace(text.begin(), text.end(), '\\', '/');
+    return text;
+}
+
+// Local wall clock, matching the zone the rest of the diagnostics logs use.
+std::string local_timestamp() {
+    const std::time_t now = std::time(nullptr);
+    std::tm tm_buf{};
+#if defined(_WIN32)
+    localtime_s(&tm_buf, &now);
+#else
+    localtime_r(&now, &tm_buf);
+#endif
+    char buffer[32] = {};
+    if (std::strftime(buffer, sizeof(buffer), "%Y%m%d-%H%M%S", &tm_buf) == 0u)
+        return {};
+    return buffer;
+}
+
+// Longest disambiguation suffix ("-1000.png") the loop can produce.
+constexpr uint32_t kMaxNameAttempts = 1000u;
+
+}  // namespace
+
+const char* nds_capture_last_error() { return g_last_error.c_str(); }
+
+bool nds_capture_write_png(const uint32_t* pixels, int width, int height,
+                           int pitch_pixels, const std::string& path) {
+    g_last_error.clear();
+    if (!pixels) {
+        set_error("null pixel buffer");
+        return false;
+    }
+    if (width <= 0 || height <= 0) {
+        set_error("invalid capture size " + std::to_string(width) + "x" +
+                  std::to_string(height));
+        return false;
+    }
+    if (pitch_pixels < width) {
+        set_error("row pitch " + std::to_string(pitch_pixels) +
+                  " is narrower than the " + std::to_string(width) +
+                  "-pixel row");
+        return false;
+    }
+    if (path.empty()) {
+        set_error("empty capture path");
+        return false;
+    }
+
+    constexpr size_t kMaxSize = std::numeric_limits<size_t>::max();
+    const size_t width_px = static_cast<size_t>(width);
+    const size_t height_px = static_cast<size_t>(height);
+    const size_t pitch = static_cast<size_t>(pitch_pixels);
+
+    // Row payload is a filter byte plus three colour bytes per pixel.
+    if (width_px > (kMaxSize - 1u) / 3u) {
+        set_error("row of " + std::to_string(width) +
+                  " pixels overflows size_t");
+        return false;
+    }
+    const size_t row_bytes = 1u + 3u * width_px;
+    if (height_px > kMaxSize / row_bytes) {
+        set_error("image of " + std::to_string(width) + "x" +
+                  std::to_string(height) + " overflows size_t");
+        return false;
+    }
+    const size_t raw_bytes = row_bytes * height_px;
+
+    // Highest addressed element is (height - 1) * pitch + width - 1; keep the
+    // element distance inside what a pointer difference can express.
+    if (pitch > kMaxSize / height_px) {
+        set_error("row pitch overflows size_t");
+        return false;
+    }
+    const size_t last_row = (height_px - 1u) * pitch;
+    if (width_px > kMaxSize - last_row) {
+        set_error("pixel span overflows size_t");
+        return false;
+    }
+    const size_t span = last_row + width_px;
+    constexpr size_t kMaxSpan =
+        static_cast<size_t>(std::numeric_limits<ptrdiff_t>::max()) /
+        sizeof(uint32_t);
+    if (span > kMaxSpan) {
+        set_error("pixel span of " + std::to_string(span) +
+                  " entries exceeds the addressable range");
+        return false;
+    }
+
+    // zlib framing: 0x78 0x01, then stored blocks of at most 65535 bytes,
+    // then the Adler-32 of the uncompressed stream.
+    const size_t block_count =
+        raw_bytes / 65535u + ((raw_bytes % 65535u) != 0u ? 1u : 0u);
+    if (raw_bytes > kMaxSize - 6u) {
+        set_error("zlib stream size overflows size_t");
+        return false;
+    }
+    const size_t zlib_room = kMaxSize - 6u - raw_bytes;
+    if (block_count > zlib_room / 5u) {
+        set_error("zlib stream size overflows size_t");
+        return false;
+    }
+    const size_t zlib_bytes = 6u + 5u * block_count + raw_bytes;
+    if (zlib_bytes > 0xFFFFFFFFu) {
+        set_error("zlib stream of " + std::to_string(zlib_bytes) +
+                  " bytes exceeds the 4 GiB PNG chunk limit");
+        return false;
+    }
+    if (zlib_bytes > kMaxSize - 64u) {
+        set_error("PNG file size overflows size_t");
+        return false;
+    }
+
+    // Raw scanlines: filter type 0 (None) then R, G, B per pixel. Memory
+    // order is B, G, R, A, so the components are the low three bytes.
+    std::vector<uint8_t> raw(raw_bytes);
+    size_t cursor = 0u;
+    for (size_t y = 0; y < height_px; ++y) {
+        const uint32_t* row = pixels + y * pitch;
+        raw[cursor++] = 0u;
+        for (size_t x = 0; x < width_px; ++x) {
+            const uint32_t argb = row[x];
+            raw[cursor++] = static_cast<uint8_t>((argb >> 16u) & 0xFFu);
+            raw[cursor++] = static_cast<uint8_t>((argb >> 8u) & 0xFFu);
+            raw[cursor++] = static_cast<uint8_t>(argb & 0xFFu);
+        }
+    }
+
+    // zlib stream. A stored block is BFINAL/BTYPE in one byte, LEN and NLEN
+    // little-endian, then LEN literal bytes -- no Huffman coding at all, which
+    // is why this needs no compressor.
+    std::vector<uint8_t> idat;
+    idat.reserve(zlib_bytes);
+    idat.push_back(0x78u);  // CMF: deflate, 32 KiB window
+    idat.push_back(0x01u);  // FLG: no preset dictionary, fastest level
+    size_t consumed = 0u;
+    while (consumed < raw_bytes) {
+        const size_t chunk = std::min<size_t>(65535u, raw_bytes - consumed);
+        const bool final_block = (consumed + chunk) == raw_bytes;
+        const uint32_t len = static_cast<uint32_t>(chunk);
+        const uint32_t nlen = ~len & 0xFFFFu;
+        idat.push_back(final_block ? 0x01u : 0x00u);
+        idat.push_back(static_cast<uint8_t>(len & 0xFFu));
+        idat.push_back(static_cast<uint8_t>((len >> 8u) & 0xFFu));
+        idat.push_back(static_cast<uint8_t>(nlen & 0xFFu));
+        idat.push_back(static_cast<uint8_t>((nlen >> 8u) & 0xFFu));
+        const uint8_t* block = raw.data() + consumed;
+        idat.insert(idat.end(), block, block + chunk);
+        consumed += chunk;
+    }
+    append_u32be(idat, adler32_bytes(raw.data(), raw_bytes));
+
+    // Assemble the file: signature, IHDR, IDAT, IEND.
+    static constexpr uint8_t kSignature[8] = {0x89u, 'P', 'N', 'G', 0x0Du,
+                                              0x0Au, 0x1Au, 0x0Au};
+    uint8_t ihdr[13] = {};
+    const uint32_t width_be = static_cast<uint32_t>(width);
+    const uint32_t height_be = static_cast<uint32_t>(height);
+    ihdr[0] = static_cast<uint8_t>(width_be >> 24u);
+    ihdr[1] = static_cast<uint8_t>(width_be >> 16u);
+    ihdr[2] = static_cast<uint8_t>(width_be >> 8u);
+    ihdr[3] = static_cast<uint8_t>(width_be);
+    ihdr[4] = static_cast<uint8_t>(height_be >> 24u);
+    ihdr[5] = static_cast<uint8_t>(height_be >> 16u);
+    ihdr[6] = static_cast<uint8_t>(height_be >> 8u);
+    ihdr[7] = static_cast<uint8_t>(height_be);
+    ihdr[8] = 8u;   // bit depth
+    ihdr[9] = 2u;   // colour type: truecolour RGB
+    ihdr[10] = 0u;  // compression: deflate
+    ihdr[11] = 0u;  // filter method: adaptive (only type 0 is emitted)
+    ihdr[12] = 0u;  // interlace: none
+
+    std::vector<uint8_t> png;
+    png.reserve(57u + idat.size());
+    append_bytes(png, kSignature, sizeof(kSignature));
+    append_chunk(png, "IHDR", ihdr, sizeof(ihdr));
+    append_chunk(png, "IDAT", idat.data(), idat.size());
+    append_chunk(png, "IEND", nullptr, 0u);
+
+    const std::filesystem::path target(path);
+    const std::filesystem::path parent = target.parent_path();
+    if (!parent.empty()) {
+        std::error_code directory_error;
+        std::filesystem::create_directories(parent, directory_error);
+        if (directory_error) {
+            set_error("cannot create capture directory '" +
+                      parent.string() + "': " + directory_error.message());
+            return false;
+        }
+    }
+
+    // ofstream::write takes a streamsize; anything larger has to be refused
+    // rather than silently shortened by the cast.
+    const bool streamable =
+        png.size() <= static_cast<size_t>(
+                          std::numeric_limits<std::streamsize>::max());
+    if (!streamable) {
+        set_error("PNG of " + std::to_string(png.size()) +
+                  " bytes exceeds the stream write limit");
+        return false;
+    }
+    std::ofstream out(target, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        set_error("cannot open capture file '" + path + "': " +
+                  errno_text(errno));
+        return false;
+    }
+    out.write(reinterpret_cast<const char*>(png.data()),
+              static_cast<std::streamsize>(png.size()));
+    out.flush();
+    if (!out.good()) {
+        set_error("short write to capture file '" + path + "': " +
+                  errno_text(errno));
+        out.close();
+        std::error_code remove_error;
+        std::filesystem::remove(target, remove_error);
+        return false;
+    }
+    // Close explicitly: a buffered failure only becomes visible here, and the
+    // contract is "true only when the whole file was written and closed".
+    out.close();
+    if (!out.good()) {
+        set_error("cannot close capture file '" + path + "': " +
+                  errno_text(errno));
+        std::error_code remove_error;
+        std::filesystem::remove(target, remove_error);
+        return false;
+    }
+    return true;
+}
+
+std::string nds_capture_target_path(const std::string& directory,
+                                    const std::string& stem) {
+    g_last_error.clear();
+    if (directory.empty()) {
+        set_error("empty capture directory");
+        return {};
+    }
+
+    const std::filesystem::path directory_path(directory);
+    std::error_code create_error;
+    std::filesystem::create_directories(directory_path, create_error);
+    if (create_error) {
+        set_error("cannot create capture directory '" + directory + "': " +
+                  create_error.message());
+        return {};
+    }
+    std::error_code inspect_error;
+    const bool usable = std::filesystem::is_directory(directory_path,
+                                                      inspect_error);
+    if (!usable) {
+        set_error(inspect_error ? "cannot inspect capture directory '" +
+                                      directory + "': " +
+                                      inspect_error.message()
+                                : "capture path '" + directory +
+                                      "' is not a directory");
+        return {};
+    }
+
+    const std::string stamp = local_timestamp();
+    if (stamp.empty()) {
+        set_error("cannot format the local capture timestamp");
+        return {};
+    }
+
+    // generic_string() emits '/' separators, so a capture log reads the same
+    // on Windows and POSIX; the replace is a belt-and-braces guard for
+    // implementations that keep the native form.
+    const std::string base = forward_slashes(
+        (directory_path / (sanitise_stem(stem) + "-" + stamp))
+            .generic_string());
+
+    for (uint32_t attempt = 1; attempt <= kMaxNameAttempts; ++attempt) {
+        const std::string candidate =
+            attempt == 1u ? base + ".png"
+                          : base + "-" + std::to_string(attempt) + ".png";
+        std::error_code exists_error;
+        const bool taken =
+            std::filesystem::exists(std::filesystem::path(candidate),
+                                    exists_error);
+        if (exists_error) {
+            set_error("cannot inspect capture path '" + candidate + "': " +
+                      exists_error.message());
+            return {};
+        }
+        if (!taken) return candidate;
+    }
+    set_error("no free capture filename within " +
+              std::to_string(kMaxNameAttempts) + " attempts for '" + base +
+              ".png'");
+    return {};
+}
diff --git a/runner/src/host_capture.h b/runner/src/host_capture.h
new file mode 100644
index 0000000..5fc018a
--- /dev/null
+++ b/runner/src/host_capture.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// PNG capture of presented frames.
+//
+// Deliberately dependency-free: the runner links neither libpng nor zlib, and
+// a screenshot is not worth pulling either in. The writer emits an
+// uncompressed (deflate "stored") zlib stream, which every PNG decoder
+// accepts; the file is larger than a compressed one but a DS frame is a few
+// hundred kilobytes either way.
+//
+// Thread-safe: concurrent captures on different threads do not share mutable
+// state. The failure text behind nds_capture_last_error() is per-thread.
+
+// Writes one presented frame to a PNG file, creating parent directories.
+// `pixels` is a tightly-addressable ARGB8888 little-endian buffer (byte order
+// B,G,R,A in memory, i.e. 0xAARRGGBB as a uint32_t), `pitch_pixels` is the
+// distance between rows in uint32_t units. Alpha is ignored; the PNG is
+// written as true colour with 8 bits per channel plus a mandatory
+// non-interlaced zlib stream.
+// Returns true only when the whole file was written and closed.
+bool nds_capture_write_png(const uint32_t* pixels, int width, int height,
+                           int pitch_pixels, const std::string& path);
+
+// Builds "<directory>/<stem>-YYYYMMDD-HHMMSS.png" from the host's local time
+// and creates `directory` (and parents) if needed. `stem` is sanitised: every
+// character outside [A-Za-z0-9._-] becomes '_', and an empty stem becomes
+// "screenshot". Returns an empty string only when the directory could not be
+// created.
+std::string nds_capture_target_path(const std::string& directory,
+                                    const std::string& stem);
+
+// Human-readable one-line description of the last failure (never null).
+//
+// The pointer addresses a thread-local buffer: it stays valid until the next
+// nds_capture_* call on the SAME thread, which overwrites it. Copy the text
+// when it must outlive that call. The string is empty after a successful call.
+const char* nds_capture_last_error();
diff --git a/runner/src/input_bindings.cpp b/runner/src/input_bindings.cpp
new file mode 100644
index 0000000..d60f09c
--- /dev/null
+++ b/runner/src/input_bindings.cpp
@@ -0,0 +1,214 @@
+#include "input_bindings.h"
+
+#include <cstddef>
+#include <cstring>
+#include <map>
+
+#include "frontend_settings.h"
+
+namespace {
+
+// The persisted spelling of each button, in bit order. One table serves both
+// the settings sub-key and the menu, so the file format and the identifiers the
+// menu passes around cannot drift apart.
+const char* const kButtonNames[kNdsPadButtonCount] = {
+    "a", "b", "select", "start", "right", "left",
+    "up", "down", "r", "l", "x", "y",
+};
+
+static_assert(sizeof(kButtonNames) / sizeof(kButtonNames[0]) ==
+                  kNdsPadButtonCount,
+              "every button needs exactly one stable settings name");
+
+// "Left Ctrl" and "Scroll Lock" are real SDL scancode names, so a space is
+// legal inside a name; only the ends are noise (and the settings loader has
+// already trimmed those before a value reaches this module).
+std::string trim_ascii(const std::string& text) {
+    std::size_t begin = 0;
+    std::size_t end = text.size();
+    const auto padding = [](char ch) {
+        return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n';
+    };
+    while (begin < end && padding(text[begin])) ++begin;
+    while (end > begin && padding(text[end - 1])) --end;
+    return text.substr(begin, end - begin);
+}
+
+// Case-folded for comparison only. The cast to unsigned char keeps a byte
+// above 0x7F from becoming a negative index (undefined behaviour in tolower).
+std::string fold_ascii(const std::string& text) {
+    std::string out = text;
+    for (char& ch : out) {
+        const unsigned char byte = static_cast<unsigned char>(ch);
+        if (byte >= 'A' && byte <= 'Z')
+            ch = static_cast<char>(byte - 'A' + 'a');
+    }
+    return out;
+}
+
+std::string settings_key(const char* prefix, int index) {
+    std::string key(prefix);
+    key += kButtonNames[index];
+    return key;
+}
+
+// A missing row keeps `fallback`; a row holding an empty value is the player's
+// explicit "unbound" and must not be resurrected as the default.
+std::string resolve_row(const NdsRuntimeSettingsFile& settings,
+                        const std::string& key, const std::string& fallback,
+                        bool pad) {
+    if (!settings.has(key)) return fallback;
+    const std::string stored = settings.get_string(key, std::string());
+    // A hand-edited or truncated file is expected: an implausible name keeps
+    // the default so that one damaged row cannot discard the other eleven.
+    if (stored.empty() || nds_input_bindings_name_is_valid(stored, pad))
+        return stored;
+    return fallback;
+}
+
+// A pad label is generated ("Pad " + name), so it cannot be returned as a
+// pointer into the caller's string the way a key label can. One buffer would
+// silently make every earlier row of a settings page show the newest name, so
+// labels are kept per distinct name: a std::map's nodes do not move, which
+// keeps every returned pointer valid for the rest of the process. The
+// vocabulary is SDL's fixed button list, so the cache stays tiny.
+std::map<std::string, std::string>& pad_label_cache() {
+    static std::map<std::string, std::string> cache;
+    return cache;
+}
+
+}  // namespace
+
+NdsInputBindings nds_input_bindings_defaults() {
+    NdsInputBindings bindings;
+    // Follows the common DS emulator convention the runner shipped with:
+    // Z/X = A/B, A/S = Y/X, Q/W = L/R.
+    const char* const keys[kNdsPadButtonCount] = {
+        "Z", "X", "Backspace", "Return", "Right", "Left",
+        "Up", "Down", "W", "Q", "S", "A",
+    };
+    // Face buttons are bound by position, not by letter: on a pad the south
+    // button is the DS's A whatever the controller prints on its shell.
+    //
+    // These are SDL 3's own spellings, taken from SDL_GetGamepadStringForButton
+    // (checked against SDL 3.4.18, whose button list is a,b,x,y,back,guide,
+    // start,leftstick,rightstick,leftshoulder,rightshoulder,dpup,dpdown,dpleft,
+    // dpright,...). SDL 3 accepts no underscore form: "dpad_up" and
+    // "left_shoulder" both parse as SDL_GAMEPAD_BUTTON_INVALID, so a table
+    // spelled that way would leave the pad dead with no error anywhere.
+    const char* const pads[kNdsPadButtonCount] = {
+        "a", "b", "back", "start", "dpright", "dpleft",
+        "dpup", "dpdown", "rightshoulder", "leftshoulder", "x", "y",
+    };
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        bindings.key[i] = keys[i];
+        bindings.pad[i] = pads[i];
+    }
+    return bindings;
+}
+
+const char* nds_pad_button_name(NdsPadButton button) {
+    const int index = static_cast<int>(button);
+    if (index < 0 || index >= kNdsPadButtonCount) return "";
+    return kButtonNames[index];
+}
+
+int nds_pad_button_from_name(const char* name) {
+    if (!name) return -1;
+    for (int i = 0; i < kNdsPadButtonCount; ++i)
+        if (std::strcmp(kButtonNames[i], name) == 0) return i;
+    return -1;
+}
+
+bool nds_input_bindings_load(const std::string& path, NdsInputBindings* out) {
+    if (!out) return false;
+    NdsRuntimeSettingsFile settings;
+    if (!settings.load(path)) return false;
+    NdsInputBindings next = nds_input_bindings_defaults();
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        next.key[i] = resolve_row(settings, settings_key("controls.key.", i),
+                                  next.key[i], false);
+        next.pad[i] = resolve_row(settings, settings_key("controls.pad.", i),
+                                  next.pad[i], true);
+    }
+    *out = next;
+    return true;
+}
+
+bool nds_input_bindings_store(const std::string& path,
+                              const NdsInputBindings& bindings) {
+    // Refuse up front rather than write a line that would corrupt the file: a
+    // newline inside a value would inject an unrelated row, and an '=' would
+    // move the rest of the name into a second field. Failing the whole store
+    // keeps the previous file intact and makes the damage the caller's to fix.
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        const std::string& key = bindings.key[i];
+        const std::string& pad = bindings.pad[i];
+        if (!key.empty() && !nds_input_bindings_name_is_valid(key, false))
+            return false;
+        if (!pad.empty() && !nds_input_bindings_name_is_valid(pad, true))
+            return false;
+    }
+    NdsRuntimeSettingsFile settings;
+    // A missing file is not an error here: load() then leaves an empty object
+    // and save() writes the version line plus the twelve rows, which is exactly
+    // what a first run needs.
+    (void)settings.load(path);
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        settings.set_string(settings_key("controls.key.", i),
+                            bindings.key[i]);
+        settings.set_string(settings_key("controls.pad.", i),
+                            bindings.pad[i]);
+    }
+    return settings.save(path);
+}
+
+int nds_input_bindings_button_for_key(const NdsInputBindings& bindings,
+                                      const std::string& name) {
+    const std::string wanted = fold_ascii(trim_ascii(name));
+    if (wanted.empty()) return -1;
+    // Lowest index wins: the caller is asking "which button produced this
+    // event", and with two buttons sharing a name the earlier one in the table
+    // is the one a menu would have offered first.
+    for (int i = 0; i < kNdsPadButtonCount; ++i)
+        if (fold_ascii(trim_ascii(bindings.key[i])) == wanted) return i;
+    return -1;
+}
+
+int nds_input_bindings_button_for_pad(const NdsInputBindings& bindings,
+                                      const std::string& name) {
+    const std::string wanted = fold_ascii(trim_ascii(name));
+    if (wanted.empty()) return -1;
+    for (int i = 0; i < kNdsPadButtonCount; ++i)
+        if (fold_ascii(trim_ascii(bindings.pad[i])) == wanted) return i;
+    return -1;
+}
+
+const char* nds_input_bindings_label(const std::string& name, bool pad) {
+    if (name.empty()) return "unbound";
+    if (!pad) return name.c_str();
+    std::map<std::string, std::string>& cache = pad_label_cache();
+    const auto found = cache.find(name);
+    if (found != cache.end()) return found->second.c_str();
+    return cache.emplace(name, "Pad " + name).first->second.c_str();
+}
+
+bool nds_input_bindings_name_is_valid(const std::string& name, bool pad) {
+    // Both devices share one shape rule: an SDL name is a short printable token
+    // or spaced phrase ("Left Ctrl", "dpad_up"), and the two families differ
+    // only in vocabulary, which this module deliberately cannot know.
+    (void)pad;
+    if (name.size() < 1u || name.size() > 31u) return false;
+    bool saw_letter = false;
+    for (const char raw : name) {
+        const unsigned char byte = static_cast<unsigned char>(raw);
+        if (byte < 0x20u || byte > 0x7Eu) return false;
+        // '=' would split the value across a key/value line boundary.
+        if (byte == '=') return false;
+        if ((byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z'))
+            saw_letter = true;
+    }
+    // Without a letter the value is punctuation or spaces only, which no SDL
+    // name is -- and a spaces-only value is what a truncated line leaves.
+    return saw_letter;
+}
diff --git a/runner/src/input_bindings.h b/runner/src/input_bindings.h
new file mode 100644
index 0000000..8cb826e
--- /dev/null
+++ b/runner/src/input_bindings.h
@@ -0,0 +1,115 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// Remappable, persistable bindings for the twelve DS buttons.
+//
+// The live input path maps an SDL scancode or gamepad button to a guest key
+// bit. This module owns the data behind that map -- the table the build ships
+// and the settings-file spelling of every binding -- and deliberately knows
+// nothing about SDL. A binding therefore travels as the *name* SDL prints and
+// parses ("Z", "Backspace", "dpad_up"), which the caller resolves with the SDL
+// it links. Names rather than numbers matter across SDL versions: SDL 3
+// renamed several gamepad button enum values, so a file of numbers would
+// reinterpret every face button after such an upgrade.
+
+// The twelve DS buttons, indexed by their bit position in the guest key mask.
+enum class NdsPadButton : int {
+    A = 0,
+    B,
+    Select,
+    Start,
+    Right,
+    Left,
+    Up,
+    Down,
+    R,
+    L,
+    X,
+    Y,
+    Count,
+};
+constexpr int kNdsPadButtonCount = 12;
+
+// One binding per button per device. An empty string means unbound, which is a
+// state a player reaches on purpose (clearing a binding) and therefore has to
+// survive a save: it is distinct from "the row is absent", which falls back to
+// the default.
+//
+//   key[i]  an SDL scancode name -- exactly what SDL_GetScancodeName() prints
+//           and SDL_GetScancodeFromName() accepts
+//   pad[i]  an SDL gamepad button name -- exactly what
+//           SDL_GetGamepadStringForButton() prints, which in SDL 3 is the
+//           unsplit form: "a", "b", "x", "y", "back", "start", "dpup",
+//           "dpdown", "dpleft", "dpright", "leftshoulder", "rightshoulder".
+//           SDL 3 parses no underscores in these names ("dpad_up",
+//           "left_shoulder" all yield SDL_GAMEPAD_BUTTON_INVALID).
+struct NdsInputBindings {
+    std::string key[kNdsPadButtonCount];
+    std::string pad[kNdsPadButtonCount];
+};
+
+// The map the current build ships: Z/X/Backspace/Return/arrows/W/Q/S/A and the
+// position-based gamepad face buttons (south/east/west/north, the dpad, then
+// R/L). A fresh settings file falls back to this, so changing it changes the
+// out-of-the-box controls. It must only ever hold names SDL 3 actually parses:
+// a misspelled default binds nothing and no error is reported anywhere.
+NdsInputBindings nds_input_bindings_defaults();
+
+// Stable lowercase identifiers used as settings-file sub-keys and by the menu:
+// "a","b","select","start","right","left","up","down","r","l","x","y".
+// nds_pad_button_name() returns "" (never nullptr) for an out-of-range button.
+// nds_pad_button_from_name() is case-sensitive and returns -1 when unknown,
+// which is why "A" does not name the "a" button.
+const char* nds_pad_button_name(NdsPadButton button);
+int nds_pad_button_from_name(const char* name);
+
+// Reads the bindings `path` holds on top of nds_input_bindings_defaults(),
+// leaving rows the file does not mention at their default. Returns false and
+// leaves `*out` untouched when the file is missing or unreadable; `out` must
+// be non-null. Settings keys are `controls.key.<button>` and
+// `controls.pad.<button>`.
+//
+// The file is hand-editable, so one damaged row must not discard the other
+// eleven: a row whose value is not a plausible name keeps the default and
+// load() still returns true. A row present with an empty value clears the
+// binding. A duplicate row keeps the first, as NdsRuntimeSettingsFile does.
+bool nds_input_bindings_load(const std::string& path, NdsInputBindings* out);
+
+// Writes only the `controls.key.*` / `controls.pad.*` rows, preserving every
+// other line, comment and blank line, the file's existing key order, and an
+// existing settings_version (NdsRuntimeSettingsFile adds one when the file has
+// none). Returns false without touching the file when a value is not a
+// plausible binding name: a newline or '=' inside a value would otherwise
+// inject a line into the key/value format.
+bool nds_input_bindings_store(const std::string& path,
+                              const NdsInputBindings& bindings);
+
+// Button whose key/pad binding equals `name` (case-insensitive, surrounding
+// whitespace ignored), or -1 for an empty or unknown name. When two buttons
+// share a name the lowest index wins: a live remap asks "which button is this
+// event", and the first match is the one earlier in the table.
+//
+// The two devices are searched separately, so a pad call never answers with a
+// keyboard binding and vice versa.
+int nds_input_bindings_button_for_key(const NdsInputBindings& bindings,
+                                      const std::string& name);
+int nds_input_bindings_button_for_pad(const NdsInputBindings& bindings,
+                                      const std::string& name);
+
+// Human-readable name for the menu: "unbound" for an empty binding, the name
+// itself for a key, "Pad " + name for a gamepad button. Never returns nullptr.
+//
+// The key form returns a pointer into `name` itself; the pad form into a
+// process-lifetime cache keyed by the name (SDL's button vocabulary is a short
+// fixed list). Either way the pointer stays valid until `name` changes, so a
+// settings page can hold every row's label at once.
+const char* nds_input_bindings_label(const std::string& name, bool pad);
+
+// True when `name` is a plausible binding for that device. The module cannot
+// ask SDL, so this checks the shape a name has to have -- 1 to 31 printable
+// ASCII characters, at least one letter, no '=' -- which guards against a
+// corrupted or hand-edited settings file rather than performing an SDL lookup.
+// Empty (unbound) is not a valid name, so callers test for empty first.
+bool nds_input_bindings_name_is_valid(const std::string& name, bool pad);
diff --git a/runner/src/mod_packs.cpp b/runner/src/mod_packs.cpp
new file mode 100644
index 0000000..abc3497
--- /dev/null
+++ b/runner/src/mod_packs.cpp
@@ -0,0 +1,1095 @@
+// mod_packs.cpp -- see mod_packs.h.
+//
+// The manifest reader is hand-rolled and line-oriented because the format is
+// four tables wide and nothing else in the runner links a TOML library. Keeping
+// it strict is the point: a player who mistypes `[[files]]` gets a diagnostic
+// naming the file and the line, not a mod that loads and does nothing.
+//
+// Nothing here prints, throws or keeps state. The one place a decision could
+// silently depend on the host -- directory iteration order -- is neutralised by
+// sorting the pack names before they are visited, so the "first pack wins" rule
+// is a property of the names, not of NTFS.
+
+#include "mod_packs.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <set>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace nds_mod_packs {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+// A manifest is a text file a player edits by hand, so the limits are generous
+// but finite: startup must not be held hostage by a 2 GiB mod.toml.
+constexpr std::uintmax_t kMaxManifestBytes = 1024u * 1024u;
+constexpr std::size_t kMaxManifestLine = 4096u;
+
+// A tree of 500 unzipped-but-broken packs would otherwise produce 500 identical
+// warnings. The cap keeps the result a fixed size; the truncation is reported.
+constexpr std::size_t kMaxDiagnostics = 512u;
+
+// ---- Text and path helpers ------------------------------------------------
+
+bool is_blank(char ch) { return ch == ' ' || ch == '\t'; }
+
+std::string trim(const std::string& text) {
+    std::size_t begin = 0;
+    std::size_t end = text.size();
+    while (begin < end && is_blank(text[begin])) ++begin;
+    while (end > begin && is_blank(text[end - 1])) --end;
+    return text.substr(begin, end - begin);
+}
+
+// Case folding for comparison only. Bytes above 0x7F are left alone: they are
+// UTF-8 sequence bytes, and folding them would corrupt a non-ASCII name.
+std::string fold_ascii(const std::string& text) {
+    std::string out = text;
+    for (char& ch : out) {
+        const unsigned char byte = static_cast<unsigned char>(ch);
+        if (byte >= 'A' && byte <= 'Z')
+            ch = static_cast<char>(byte - 'A' + 'a');
+    }
+    return out;
+}
+
+// The module's whole interface is UTF-8 std::string, so every transition to and
+// from a path object is explicit. On Windows this is what keeps a pack in a
+// directory called "モッド" addressable at all.
+fs::path from_utf8(const std::string& text) {
+    return fs::path(std::u8string(text.begin(), text.end()));
+}
+
+std::string to_utf8(const fs::path& path) {
+    const std::u8string text = path.generic_u8string();
+    return std::string(text.begin(), text.end());
+}
+
+bool is_identifier(const std::string& key) {
+    if (key.empty()) return false;
+    for (std::size_t index = 0; index < key.size(); ++index) {
+        const unsigned char ch = static_cast<unsigned char>(key[index]);
+        const bool letter = (ch >= 'A' && ch <= 'Z') ||
+                            (ch >= 'a' && ch <= 'z') || ch == '_';
+        const bool tail = letter || (ch >= '0' && ch <= '9') || ch == '-';
+        if (index == 0u ? !letter : !tail) return false;
+    }
+    return true;
+}
+
+// Cuts a trailing comment. The `#` has to be outside a quoted string, so a
+// description may legitimately contain one ("Track #3, remastered"); inside a
+// string the byte is ordinary text and the scanner tracks the escapes to know
+// where the string ends.
+std::string strip_comment(const std::string& text) {
+    bool quoted = false;
+    for (std::size_t index = 0; index < text.size(); ++index) {
+        const char ch = text[index];
+        if (quoted) {
+            if (ch == '\\') {
+                ++index;
+            } else if (ch == '"') {
+                quoted = false;
+            }
+        } else if (ch == '"') {
+            quoted = true;
+        } else if (ch == '#') {
+            return text.substr(0, index);
+        }
+    }
+    return text;
+}
+
+// ---- Value parsing -------------------------------------------------------
+
+// A quoted string, with exactly the five escapes the header documents. Any
+// other backslash sequence is an error rather than a literal, because a
+// mistyped escape in a Windows-style path (`"data\\font.bin"` versus
+// `"data\font.bin"`) is precisely the mistake this parser exists to catch.
+bool parse_string(const std::string& text, std::string* out, std::string* why) {
+    if (text.size() < 2 || text.front() != '"') {
+        *why = "the value must be a quoted string";
+        return false;
+    }
+    std::string value;
+    bool closed = false;
+    std::size_t index = 1;
+    for (; index < text.size(); ++index) {
+        const char ch = text[index];
+        if (ch == '"') {
+            closed = true;
+            ++index;
+            break;
+        }
+        if (ch == '\\') {
+            if (index + 1 >= text.size()) {
+                *why = "a backslash ends the line";
+                return false;
+            }
+            const char escape = text[index + 1];
+            switch (escape) {
+                case '"': value.push_back('"'); break;
+                case '\\': value.push_back('\\'); break;
+                case 'n': value.push_back('\n'); break;
+                case 't': value.push_back('\t'); break;
+                case 'r': value.push_back('\r'); break;
+                default:
+                    *why = std::string("'\\") + escape +
+                           "' is not one of the supported escapes "
+                           "(\\\" \\\\ \\n \\t \\r)";
+                    return false;
+            }
+            ++index;
+            continue;
+        }
+        const unsigned char byte = static_cast<unsigned char>(ch);
+        if (byte < 0x20u || byte == 0x7Fu) {
+            *why = "the string holds a raw control byte";
+            return false;
+        }
+        value.push_back(ch);
+    }
+    if (!closed) {
+        *why = "the string is never closed";
+        return false;
+    }
+    if (index != text.size()) {
+        *why = "there is text after the closing quote";
+        return false;
+    }
+    *out = value;
+    return true;
+}
+
+// A non-negative decimal that fits an int. No sign, no 0x prefix: the header
+// promises decimal only, and accepting "0x10" here would make the grammar
+// depend on which TOML someone last read.
+bool parse_integer(const std::string& text, int* out, std::string* why) {
+    if (text.empty()) {
+        *why = "the value must be a decimal integer";
+        return false;
+    }
+    if (text.size() > 10u) {
+        *why = "the value does not fit in 32 bits";
+        return false;
+    }
+    long long value = 0;
+    for (const char ch : text) {
+        if (ch < '0' || ch > '9') {
+            *why = "'" + text + "' is not a non-negative decimal integer";
+            return false;
+        }
+        value = value * 10 + (ch - '0');
+        if (value > 2147483647LL) {
+            *why = "the value does not fit in 32 bits";
+            return false;
+        }
+    }
+    *out = static_cast<int>(value);
+    return true;
+}
+
+// ---- Manifest model ------------------------------------------------------
+
+struct Entry {
+    int key = 0;
+    int line = 0;       // the entry's table header
+    int path_line = 0;  // the `path` row, for a path diagnostic
+    std::string path;
+};
+
+struct Manifest {
+    std::string name;
+    std::string id;
+    std::string version;
+    std::string description;
+    std::vector<Entry> files;
+    std::vector<Entry> music;
+};
+
+struct ParseFailure {
+    NdsModPackRule rule = NdsModPackRule::ManifestSyntax;
+    int line = 0;
+    std::string detail;
+};
+
+enum class TableKind : int { None = 0, Pack, File, Music };
+
+// The parser holds the state a line needs plus the manifest it fills. It stops
+// at the first problem: a manifest is rejected as a whole, and reporting the
+// first mistake is more useful than reporting the cascade behind it.
+struct Parser {
+    Manifest* manifest = nullptr;
+    ParseFailure* failure = nullptr;
+
+    TableKind table = TableKind::None;
+    int table_line = 0;
+    bool pack_seen = false;
+    std::set<std::string> keys;
+
+    bool has_name = false;
+    bool has_id = false;
+    bool has_entry_key = false;
+    bool has_entry_path = false;
+    int entry_key = 0;
+    int entry_key_line = 0;
+    int entry_path_line = 0;
+    std::string entry_path;
+
+    bool fail(NdsModPackRule rule, int line, const std::string& detail) {
+        failure->rule = rule;
+        failure->line = line;
+        failure->detail = detail;
+        return false;
+    }
+
+    std::string describe(const std::string& key) const {
+        return "'" + key + "'";
+    }
+
+    // Called for every table header and once at end of file. Fields have to sit
+    // together under their header, which is what makes the line number in a
+    // "missing id" diagnostic the header's line.
+    bool finish_table() {
+        const TableKind finished = table;
+        table = TableKind::None;
+        switch (finished) {
+            case TableKind::None:
+                return true;
+            case TableKind::Pack:
+                if (!has_name)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "the [pack] table has no name");
+                if (!has_id)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "the [pack] table has no id");
+                if (manifest->name.empty())
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "the [pack] name is empty");
+                if (manifest->id.empty())
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "the [pack] id is empty");
+                return true;
+            case TableKind::File:
+                if (!has_entry_key)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "a [[file]] table has no id");
+                if (!has_entry_path)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "a [[file]] table has no path");
+                manifest->files.push_back(
+                    Entry{entry_key, table_line, entry_path_line, entry_path});
+                return true;
+            case TableKind::Music:
+                if (!has_entry_key)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "a [[music]] table has no track");
+                if (!has_entry_path)
+                    return fail(NdsModPackRule::MissingField, table_line,
+                                "a [[music]] table has no path");
+                manifest->music.push_back(
+                    Entry{entry_key, table_line, entry_path_line, entry_path});
+                return true;
+        }
+        return true;
+    }
+
+    bool begin_table(int line, const std::string& name, bool array) {
+        if (name == "pack") {
+            if (array)
+                return fail(NdsModPackRule::UnknownSection, line,
+                            "the pack table is written [pack], not [[pack]]");
+            if (pack_seen)
+                return fail(NdsModPackRule::DuplicateSection, line,
+                            "the [pack] table appears twice");
+            pack_seen = true;
+            if (!finish_table()) return false;
+            table = TableKind::Pack;
+        } else if (name == "file") {
+            if (!array)
+                return fail(NdsModPackRule::UnknownSection, line,
+                            "file overrides are written [[file]], not [file]");
+            if (!finish_table()) return false;
+            table = TableKind::File;
+        } else if (name == "music") {
+            if (!array)
+                return fail(NdsModPackRule::UnknownSection, line,
+                            "music overrides are written [[music]], not "
+                            "[music]");
+            if (!finish_table()) return false;
+            table = TableKind::Music;
+        } else {
+            return fail(NdsModPackRule::UnknownSection, line,
+                        describe(name) +
+                            " is not a pack table (expected [pack], [[file]] "
+                            "or [[music]])");
+        }
+        table_line = line;
+        keys.clear();
+        has_name = false;
+        has_id = false;
+        has_entry_key = false;
+        has_entry_path = false;
+        entry_key = 0;
+        entry_key_line = 0;
+        entry_path_line = 0;
+        entry_path.clear();
+        return true;
+    }
+
+    bool header(int line, const std::string& text) {
+        const bool array = text.size() >= 2u && text[1] == '[';
+        std::string name;
+        if (array) {
+            if (text.size() < 4u ||
+                text.compare(text.size() - 2u, 2u, "]]") != 0)
+                return fail(NdsModPackRule::ManifestSyntax, line,
+                            "a table header must end with ']]'");
+            name = trim(text.substr(2u, text.size() - 4u));
+        } else {
+            if (text.back() != ']')
+                return fail(NdsModPackRule::ManifestSyntax, line,
+                            "a table header must end with ']'");
+            name = trim(text.substr(1u, text.size() - 2u));
+        }
+        if (name.empty())
+            return fail(NdsModPackRule::ManifestSyntax, line,
+                        "a table header must name a table");
+        return begin_table(line, name, array);
+    }
+
+    bool assignment(int line, const std::string& text) {
+        const std::size_t equals = text.find('=');
+        if (equals == std::string::npos)
+            return fail(NdsModPackRule::ManifestSyntax, line,
+                        "expected 'key = value'");
+        const std::string key = trim(text.substr(0, equals));
+        const std::string value = trim(text.substr(equals + 1u));
+        if (!is_identifier(key))
+            return fail(NdsModPackRule::ManifestSyntax, line,
+                        describe(key) + " is not a valid key");
+        if (table == TableKind::None)
+            return fail(NdsModPackRule::ManifestSyntax, line,
+                        "the key " + describe(key) +
+                            " appears before any table header");
+        if (!keys.insert(key).second)
+            return fail(NdsModPackRule::DuplicateKey, line,
+                        "the key " + describe(key) +
+                            " is set twice in one table");
+
+        std::string why;
+        if (table == TableKind::Pack) {
+            std::string parsed;
+            if (!parse_string(value, &parsed, &why))
+                return fail(NdsModPackRule::BadString, line,
+                            "the [pack] " + key + ": " + why);
+            if (key == "name") {
+                manifest->name = parsed;
+                has_name = true;
+            } else if (key == "id") {
+                manifest->id = parsed;
+                has_id = true;
+            } else if (key == "version") {
+                manifest->version = parsed;
+            } else if (key == "description") {
+                manifest->description = parsed;
+            } else {
+                return fail(NdsModPackRule::UnknownKey, line,
+                            describe(key) +
+                                " is not a [pack] field (name, id, version, "
+                                "description)");
+            }
+            return true;
+        }
+
+        // The integer field is spelled differently in the two array tables:
+        // `id` for a file (a game content id) and `track` for music, because a
+        // track number is not a content id and the two tables are separate
+        // namespaces.
+        const bool is_file = table == TableKind::File;
+        const char* const wanted = is_file ? "[[file]]" : "[[music]]";
+        const char* const keyed = is_file ? "id" : "track";
+        const char* const alternative = is_file ? "track" : "id";
+        const bool wants_key = key == keyed;
+        const bool wants_path = key == "path";
+        if (!wants_key && !wants_path) {
+            // Naming the other table's spelling catches the common copy-paste
+            // mistake, which otherwise reads as "unknown key".
+            return fail(NdsModPackRule::UnknownKey, line,
+                        describe(key) + " is not a " + wanted + " field (" +
+                            keyed + ", path; " + alternative +
+                            " belongs to the other table)");
+        }
+        if (wants_key) {
+            int parsed = 0;
+            if (!parse_integer(value, &parsed, &why))
+                return fail(NdsModPackRule::BadInteger, line,
+                            "the " + std::string(wanted) + ": " + why);
+            entry_key = parsed;
+            entry_key_line = line;
+            has_entry_key = true;
+            return true;
+        }
+        std::string parsed;
+        if (!parse_string(value, &parsed, &why))
+            return fail(NdsModPackRule::BadString, line,
+                        "the " + std::string(wanted) + " path: " + why);
+        entry_path = parsed;
+        entry_path_line = line;
+        has_entry_path = true;
+        return true;
+    }
+
+    bool consume(int line, const std::string& body) {
+        if (body.size() > kMaxManifestLine)
+            return fail(NdsModPackRule::ManifestSyntax, line,
+                        "the line is longer than " +
+                            std::to_string(kMaxManifestLine) + " bytes");
+        const std::string text = trim(strip_comment(body));
+        if (text.empty()) return true;
+        if (text.front() == '[') return header(line, text);
+        return assignment(line, text);
+    }
+};
+
+bool parse_manifest(const std::string& text, Manifest* manifest,
+                    ParseFailure* failure) {
+    Parser parser;
+    parser.manifest = manifest;
+    parser.failure = failure;
+
+    // A byte order mark is something an editor writes, not a statement about
+    // the pack, so it is skipped rather than reported.
+    std::size_t begin = 0;
+    if (text.size() >= 3u &&
+        static_cast<unsigned char>(text[0]) == 0xEFu &&
+        static_cast<unsigned char>(text[1]) == 0xBBu &&
+        static_cast<unsigned char>(text[2]) == 0xBFu)
+        begin = 3u;
+
+    int number = 1;
+    while (begin < text.size()) {
+        const std::size_t newline = text.find('\n', begin);
+        const std::size_t end =
+            newline == std::string::npos ? text.size() : newline;
+        std::string body = text.substr(begin, end - begin);
+        if (!body.empty() && body.back() == '\r') body.pop_back();
+        begin = newline == std::string::npos ? text.size() : newline + 1u;
+        if (!parser.consume(number, body)) return false;
+        ++number;
+    }
+    // A final table with no newline after it still has to be validated.
+    if (!parser.finish_table()) return false;
+    if (!parser.pack_seen) {
+        // A manifest with no [pack] table has no id and no name, so it cannot
+        // be enabled -- but the file is there, which is what makes this an
+        // error rather than a "not a pack".
+        failure->rule = NdsModPackRule::MissingField;
+        failure->line = 0;
+        failure->detail =
+            "the manifest has no [pack] table, so it has no name or id";
+        return false;
+    }
+    return true;
+}
+
+// ---- Path validation -----------------------------------------------------
+
+std::string component_key(const fs::path& component) {
+    return fold_ascii(to_utf8(component));
+}
+
+// True when `target` is `base` or lies below it, compared component by
+// component. Comparing components rather than string prefixes is what stops
+// ".../mods/Pack" from accepting ".../mods/Pack2/x": the prefix test would.
+bool path_is_inside(const fs::path& base, const fs::path& target) {
+    fs::path::const_iterator left = base.begin();
+    fs::path::const_iterator right = target.begin();
+    for (; left != base.end(); ++left, ++right) {
+        if (right == target.end()) return false;
+        if (component_key(*left) != component_key(*right)) return false;
+    }
+    return true;
+}
+
+// Resolution order is deliberate: the cheap lexical rules first, so a manifest
+// carrying "../escape.bin" is reported as parent traversal even though the file
+// also happens not to exist, and the canonical-containment test before the
+// existence test, so a path that escapes through a link is reported as such.
+bool resolve_path(const fs::path& pack_directory, const std::string& relative,
+                  std::string* resolved, NdsModPackRule* rule,
+                  std::string* detail) {
+    const auto reject = [rule, detail](NdsModPackRule which,
+                                       const std::string& why) {
+        if (rule != nullptr) *rule = which;
+        if (detail != nullptr) *detail = why;
+        return false;
+    };
+
+    if (relative.empty())
+        return reject(NdsModPackRule::PathEmpty, "the path is empty");
+    if (relative.front() == '/' || relative.front() == '\\')
+        return reject(NdsModPackRule::PathLeadingSeparator,
+                      "'" + relative +
+                          "' starts with a separator, so it is not relative to "
+                          "the pack directory");
+    if (relative.find(':') != std::string::npos)
+        return reject(NdsModPackRule::PathDriveLetter,
+                      "'" + relative + "' contains ':', which a pack path "
+                      "never may -- it names a drive, a share or an alternate "
+                      "data stream");
+
+    // Both separators are accepted in a component split, so the lexical rules
+    // behave the same for a manifest written on either platform.
+    std::string component;
+    for (std::size_t index = 0; index <= relative.size(); ++index) {
+        const char ch = index == relative.size() ? '/' : relative[index];
+        if (ch == '/' || ch == '\\') {
+            if (component == "..")
+                return reject(NdsModPackRule::PathParentTraversal,
+                              "'" + relative + "' walks upwards with '..'");
+            component.clear();
+        } else {
+            component.push_back(ch);
+        }
+    }
+
+    std::error_code error;
+    // Absolute first, so the path the caller gets back does not depend on the
+    // process working directory at the moment of the call -- a test that
+    // compares two loads, or a log line read tomorrow, needs that.
+    const fs::path absolute = fs::absolute(pack_directory, error);
+    if (error)
+        return reject(NdsModPackRule::PathMissing,
+                      "the pack directory cannot be inspected: " +
+                          error.message());
+    const fs::path base = fs::weakly_canonical(absolute, error);
+    if (error)
+        return reject(NdsModPackRule::PathMissing,
+                      "the pack directory cannot be inspected: " +
+                          error.message());
+    const fs::path joined = absolute / from_utf8(relative);
+    const fs::path target = fs::weakly_canonical(joined, error);
+    if (error)
+        return reject(NdsModPackRule::PathMissing,
+                      "'" + relative + "' cannot be resolved: " +
+                          error.message());
+    if (!path_is_inside(base, target))
+        return reject(NdsModPackRule::PathOutsidePack,
+                      "'" + relative + "' resolves outside the pack directory");
+
+    const fs::file_status status = fs::status(target, error);
+    if (error)
+        return reject(NdsModPackRule::PathMissing,
+                      "'" + relative + "' cannot be inspected: " +
+                          error.message());
+    if (!fs::exists(status))
+        return reject(NdsModPackRule::PathMissing,
+                      "there is no file '" + relative + "' in the pack");
+    if (!fs::is_regular_file(status))
+        return reject(NdsModPackRule::PathNotAFile,
+                      "'" + relative + "' is not a regular file");
+
+    if (resolved != nullptr) *resolved = to_utf8(target);
+    return true;
+}
+
+// ---- Diagnostics ---------------------------------------------------------
+
+struct Sink {
+    std::vector<NdsModPackDiagnostic>* out = nullptr;
+    bool truncated = false;
+
+    void push(NdsModPackSeverity severity, NdsModPackRule rule,
+              const std::string& pack, const std::string& file, int line,
+              const std::string& detail) {
+        if (out->size() >= kMaxDiagnostics) {
+            truncated = true;
+            return;
+        }
+        NdsModPackDiagnostic diagnostic;
+        diagnostic.severity = severity;
+        diagnostic.rule = rule;
+        diagnostic.pack = pack;
+        diagnostic.file = file;
+        diagnostic.line = line;
+        diagnostic.detail = detail;
+        out->push_back(std::move(diagnostic));
+    }
+};
+
+std::size_t count_severity(const std::vector<NdsModPackDiagnostic>& list,
+                           NdsModPackSeverity severity) {
+    std::size_t total = 0;
+    for (const NdsModPackDiagnostic& diagnostic : list)
+        if (diagnostic.severity == severity) ++total;
+    return total;
+}
+
+// Fills in the counts that are derived from the vectors and hands the result
+// back. Every exit from the loader goes through here, so a summary can never
+// disagree with the table it describes -- including on the early returns for a
+// missing or unreadable `mods` directory.
+NdsModPacksResult finish(NdsModPacksResult result) {
+    result.summary.file_overrides = static_cast<int>(result.files.size());
+    result.summary.music_overrides = static_cast<int>(result.music.size());
+    result.summary.enabled_packs = 0;
+    for (const NdsModPackInfo& pack : result.packs)
+        if (pack.enabled) ++result.summary.enabled_packs;
+    result.summary.warnings = static_cast<int>(
+        count_severity(result.diagnostics, NdsModPackSeverity::Warning));
+    result.summary.errors = static_cast<int>(
+        count_severity(result.diagnostics, NdsModPackSeverity::Error));
+    return result;
+}
+
+std::string number_text(int value) { return std::to_string(value); }
+
+struct Candidate {
+    std::string name;
+    fs::path directory;
+};
+
+// Entries that survived path validation, kept until the whole pack has been
+// read so a pack's own diagnostics stay together in the result. `path_line` is
+// the row a conflict is reported against, because that is the line a player
+// editing the losing pack has to change.
+struct Pending {
+    int key = 0;
+    int path_line = 0;
+    std::string path;
+};
+
+// Reads one manifest into `manifest`, reporting a failure as a diagnostic with
+// the manifest path and line number attached.
+bool read_manifest(const fs::path& path, Manifest* manifest, Sink* sink,
+                   const std::string& pack) {
+    const std::string file = to_utf8(path);
+    // `exists` rather than `is_regular_file`: a missing file has to come out as
+    // "this directory has no manifest", which is the warning a player who
+    // unzipped a pack one level too deep needs, and a failing status call would
+    // report it as an unreadable manifest instead.
+    std::error_code error;
+    const bool present = fs::exists(path, error);
+    if (!present) {
+        if (error) {
+            sink->push(NdsModPackSeverity::Error,
+                       NdsModPackRule::ManifestUnreadable, pack, file, 0,
+                       "the manifest cannot be inspected: " +
+                           error.message());
+        } else {
+            sink->push(NdsModPackSeverity::Warning,
+                       NdsModPackRule::DirectoryWithoutManifest, pack, file, 0,
+                       "there is no mod.toml in this directory");
+        }
+        return false;
+    }
+    error.clear();
+    const bool regular = fs::is_regular_file(path, error);
+    if (error) {
+        sink->push(NdsModPackSeverity::Error,
+                   NdsModPackRule::ManifestUnreadable, pack, file, 0,
+                   "the manifest cannot be inspected: " + error.message());
+        return false;
+    }
+    if (!regular) {
+        // Not a manifest at all: a directory or a device happened to be called
+        // mod.toml. Treat it exactly like a missing one.
+        sink->push(NdsModPackSeverity::Warning,
+                   NdsModPackRule::DirectoryWithoutManifest, pack, file, 0,
+                   "the pack has no regular file called mod.toml");
+        return false;
+    }
+    const std::uintmax_t size = fs::file_size(path, error);
+    if (!error && size > kMaxManifestBytes) {
+        sink->push(NdsModPackSeverity::Error, NdsModPackRule::ManifestTooLarge,
+                   pack, file, 0,
+                   "the manifest is larger than " +
+                       number_text(static_cast<int>(kMaxManifestBytes)) +
+                       " bytes and was not read");
+        return false;
+    }
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+        sink->push(NdsModPackSeverity::Error,
+                   NdsModPackRule::ManifestUnreadable, pack, file, 0,
+                   "the manifest cannot be opened for reading");
+        return false;
+    }
+    const std::string text((std::istreambuf_iterator<char>(input)),
+                           std::istreambuf_iterator<char>());
+    if (input.bad()) {
+        sink->push(NdsModPackSeverity::Error,
+                   NdsModPackRule::ManifestUnreadable, pack, file, 0,
+                   "the manifest could not be read to the end");
+        return false;
+    }
+    if (text.size() > kMaxManifestBytes) {
+        sink->push(NdsModPackSeverity::Error, NdsModPackRule::ManifestTooLarge,
+                   pack, file, 0,
+                   "the manifest is larger than " +
+                       number_text(static_cast<int>(kMaxManifestBytes)) +
+                       " bytes and was not read");
+        return false;
+    }
+    ParseFailure failure;
+    if (!parse_manifest(text, manifest, &failure)) {
+        sink->push(NdsModPackSeverity::Error, failure.rule, pack, file,
+                   failure.line, failure.detail);
+        return false;
+    }
+    return true;
+}
+
+}  // namespace
+
+const char* nds_mod_pack_rule_name(NdsModPackRule rule) {
+    switch (rule) {
+        case NdsModPackRule::MissingModsDirectory:
+            return "missing_mods_directory";
+        case NdsModPackRule::DirectoryUnreadable: return "directory_unreadable";
+        case NdsModPackRule::DirectoryWithoutManifest:
+            return "directory_without_manifest";
+        case NdsModPackRule::ManifestUnreadable:
+            return "manifest_unreadable";
+        case NdsModPackRule::ManifestTooLarge: return "manifest_too_large";
+        case NdsModPackRule::ManifestSyntax: return "manifest_syntax";
+        case NdsModPackRule::UnknownSection: return "unknown_section";
+        case NdsModPackRule::DuplicateSection: return "duplicate_section";
+        case NdsModPackRule::UnknownKey: return "unknown_key";
+        case NdsModPackRule::DuplicateKey: return "duplicate_key";
+        case NdsModPackRule::BadInteger: return "bad_integer";
+        case NdsModPackRule::BadString: return "bad_string";
+        case NdsModPackRule::MissingField: return "missing_field";
+        case NdsModPackRule::PathEmpty: return "path_empty";
+        case NdsModPackRule::PathDriveLetter: return "path_drive_letter";
+        case NdsModPackRule::PathLeadingSeparator:
+            return "path_leading_separator";
+        case NdsModPackRule::PathParentTraversal:
+            return "path_parent_traversal";
+        case NdsModPackRule::PathOutsidePack: return "path_outside_pack";
+        case NdsModPackRule::PathNotAFile: return "path_not_a_file";
+        case NdsModPackRule::PathMissing: return "path_missing";
+        case NdsModPackRule::DuplicatePackId: return "duplicate_pack_id";
+        case NdsModPackRule::DuplicateFileId: return "duplicate_file_id";
+        case NdsModPackRule::DuplicateMusicTrack:
+            return "duplicate_music_track";
+        case NdsModPackRule::ShadowedFile: return "shadowed_file";
+        case NdsModPackRule::ShadowedMusic: return "shadowed_music";
+        case NdsModPackRule::TooManyProblems: return "too_many_problems";
+    }
+    return "unknown";
+}
+
+const char* nds_mod_pack_severity_name(NdsModPackSeverity severity) {
+    switch (severity) {
+        case NdsModPackSeverity::Warning: return "warning";
+        case NdsModPackSeverity::Error: return "error";
+    }
+    return "unknown";
+}
+
+NdsModPacksResult nds_mod_packs_load(const std::string& mods_directory) {
+    NdsModPacksResult result;
+    Sink sink;
+    sink.out = &result.diagnostics;
+
+    const fs::path mods = from_utf8(mods_directory);
+    std::error_code error;
+    const fs::file_status status = fs::status(mods, error);
+    if (error) {
+        sink.push(NdsModPackSeverity::Warning,
+                  NdsModPackRule::MissingModsDirectory, "", "", 0,
+                  "'" + mods_directory +
+                      "' cannot be inspected, so no packs are loaded: " +
+                      error.message());
+        return finish(result);
+    }
+    if (!fs::exists(status)) {
+        // The overwhelmingly common case: an install with no mods at all.
+        sink.push(NdsModPackSeverity::Warning,
+                  NdsModPackRule::MissingModsDirectory, "", "", 0,
+                  "there is no '" + mods_directory +
+                      "' directory, so no packs are loaded");
+        return finish(result);
+    }
+    if (!fs::is_directory(status)) {
+        sink.push(NdsModPackSeverity::Error,
+                  NdsModPackRule::DirectoryUnreadable, "", to_utf8(mods), 0,
+                  "'" + mods_directory + "' is not a directory");
+        return finish(result);
+    }
+
+    std::vector<Candidate> candidates;
+    fs::directory_iterator iterator(mods, error);
+    if (error) {
+        sink.push(NdsModPackSeverity::Error,
+                  NdsModPackRule::DirectoryUnreadable, "", to_utf8(mods), 0,
+                  "the mods directory cannot be listed: " + error.message());
+        return finish(result);
+    }
+    const fs::directory_iterator end;
+    while (iterator != end) {
+        std::error_code probe;
+        const bool is_directory = iterator->is_directory(probe);
+        if (!probe && is_directory) {
+            candidates.push_back(
+                Candidate{to_utf8(iterator->path().filename()),
+                          iterator->path()});
+        }
+        // A plain file directly in `mods` is not a pack and is not a mistake a
+        // player needs telling about -- it is usually a readme.
+        iterator.increment(error);
+        if (error) {
+            sink.push(NdsModPackSeverity::Error,
+                      NdsModPackRule::DirectoryUnreadable, "", to_utf8(mods),
+                      0, "the mods directory listing stopped early: " +
+                             error.message());
+            break;
+        }
+    }
+
+    // Byte order on the pack name, not the host's ordering: this is the line
+    // that makes "first pack wins" reproducible and independent of NTFS.
+    std::sort(candidates.begin(), candidates.end(),
+              [](const Candidate& left, const Candidate& right) {
+                  return left.name < right.name;
+              });
+
+    result.summary.packs = static_cast<int>(candidates.size());
+
+    std::set<std::string> pack_ids;
+    std::map<int, NdsModPackOverride> files;
+    std::map<int, NdsModPackOverride> music;
+
+    for (const Candidate& candidate : candidates) {
+        const fs::path manifest_path = candidate.directory / "mod.toml";
+        NdsModPackInfo info;
+        info.directory = candidate.name;
+        Manifest manifest;
+        if (!read_manifest(manifest_path, &manifest, &sink, candidate.name)) {
+            // Recorded, not skipped: the directory is still a pack the player
+            // created, it just never produced a table.
+            result.packs.push_back(std::move(info));
+            continue;
+        }
+
+        const std::string file = to_utf8(manifest_path);
+        info.name = manifest.name;
+        info.id = manifest.id;
+        info.version = manifest.version;
+        info.description = manifest.description;
+        const std::string folded_id = fold_ascii(manifest.id);
+        if (!pack_ids.insert(folded_id).second) {
+            sink.push(NdsModPackSeverity::Warning,
+                      NdsModPackRule::DuplicatePackId, candidate.name, file, 0,
+                      "the pack id '" + manifest.id +
+                          "' is already used by an earlier pack, so this pack "
+                          "is disabled");
+            result.packs.push_back(std::move(info));
+            continue;
+        }
+
+        // One bad path costs its entry, not the pack: a pack with one stale
+        // file name is still mostly useful.
+        std::vector<Pending> accepted_files;
+        std::map<int, int> file_lines;
+        for (const Entry& entry : manifest.files) {
+            std::string resolved;
+            NdsModPackRule rule = NdsModPackRule::PathMissing;
+            std::string detail;
+            if (!resolve_path(candidate.directory, entry.path, &resolved,
+                              &rule, &detail)) {
+                // The `path` line, not the table header: that is the line the
+                // player has to edit.
+                sink.push(NdsModPackSeverity::Error, rule, candidate.name, file,
+                          entry.path_line,
+                          "this [[file]] entry is ignored: " + detail);
+                continue;
+            }
+            const std::map<int, int>::iterator seen =
+                file_lines.find(entry.key);
+            if (seen != file_lines.end()) {
+                sink.push(NdsModPackSeverity::Error,
+                          NdsModPackRule::DuplicateFileId, candidate.name, file,
+                          entry.line,
+                          "the content id " + number_text(entry.key) +
+                              " is already provided by this pack at line " +
+                              number_text(seen->second) +
+                              ", so this entry is ignored");
+                continue;
+            }
+            file_lines.emplace(entry.key, entry.line);
+            accepted_files.push_back(
+                Pending{entry.key, entry.path_line, resolved});
+        }
+
+        std::vector<Pending> accepted_music;
+        std::map<int, int> music_lines;
+        for (const Entry& entry : manifest.music) {
+            std::string resolved;
+            NdsModPackRule rule = NdsModPackRule::PathMissing;
+            std::string detail;
+            if (!resolve_path(candidate.directory, entry.path, &resolved,
+                              &rule, &detail)) {
+                sink.push(NdsModPackSeverity::Error, rule, candidate.name, file,
+                          entry.path_line,
+                          "this [[music]] entry is ignored: " + detail);
+                continue;
+            }
+            const std::map<int, int>::iterator seen =
+                music_lines.find(entry.key);
+            if (seen != music_lines.end()) {
+                sink.push(NdsModPackSeverity::Error,
+                          NdsModPackRule::DuplicateMusicTrack, candidate.name,
+                          file, entry.line,
+                          "the track " + number_text(entry.key) +
+                              " is already provided by this pack at line " +
+                              number_text(seen->second) +
+                              ", so this entry is ignored");
+                continue;
+            }
+            music_lines.emplace(entry.key, entry.line);
+            accepted_music.push_back(
+                Pending{entry.key, entry.path_line, resolved});
+        }
+
+        // Merge after the pack's own diagnostics, and in the same pack order,
+        // so the "shadowed by" sentence always names a pack the reader has
+        // already seen.
+        for (const Pending& pending : accepted_files) {
+            const std::map<int, NdsModPackOverride>::iterator existing =
+                files.find(pending.key);
+            if (existing != files.end()) {
+                sink.push(NdsModPackSeverity::Warning,
+                          NdsModPackRule::ShadowedFile, candidate.name, file,
+                          pending.path_line,
+                          "the content id " + number_text(pending.key) +
+                              " is already supplied by pack '" +
+                              existing->second.pack +
+                              "', which loads first, so this copy is ignored");
+                continue;
+            }
+            NdsModPackOverride entry;
+            entry.key = pending.key;
+            entry.pack = candidate.name;
+            entry.path = pending.path;
+            files.emplace(pending.key, std::move(entry));
+        }
+
+        for (const Pending& pending : accepted_music) {
+            const std::map<int, NdsModPackOverride>::iterator existing =
+                music.find(pending.key);
+            if (existing != music.end()) {
+                sink.push(NdsModPackSeverity::Warning,
+                          NdsModPackRule::ShadowedMusic, candidate.name, file,
+                          pending.path_line,
+                          "the track " + number_text(pending.key) +
+                              " is already supplied by pack '" +
+                              existing->second.pack +
+                              "', which loads first, so this copy is ignored");
+                continue;
+            }
+            NdsModPackOverride entry;
+            entry.key = pending.key;
+            entry.pack = candidate.name;
+            entry.path = pending.path;
+            music.emplace(pending.key, std::move(entry));
+        }
+
+        ++result.summary.enabled_packs;
+        info.enabled = true;
+        result.packs.push_back(std::move(info));
+    }
+
+    // std::map keeps the keys ascending, which is the order the header promises
+    // and the order a log line or a menu wants.
+    result.files.reserve(files.size());
+    for (const std::pair<const int, NdsModPackOverride>& entry : files)
+        result.files.push_back(entry.second);
+    result.music.reserve(music.size());
+    for (const std::pair<const int, NdsModPackOverride>& entry : music)
+        result.music.push_back(entry.second);
+
+    if (sink.truncated) {
+        NdsModPackDiagnostic notice;
+        notice.severity = NdsModPackSeverity::Warning;
+        notice.rule = NdsModPackRule::TooManyProblems;
+        notice.detail = "more problems were found than the diagnostic limit; "
+                        "only the first ones are reported";
+        result.diagnostics.push_back(std::move(notice));
+    }
+
+    result.summary.file_overrides = static_cast<int>(result.files.size());
+    result.summary.music_overrides = static_cast<int>(result.music.size());
+    result.summary.warnings = static_cast<int>(
+        count_severity(result.diagnostics, NdsModPackSeverity::Warning));
+    result.summary.errors = static_cast<int>(
+        count_severity(result.diagnostics, NdsModPackSeverity::Error));
+    return finish(result);
+}
+
+std::string nds_mod_packs_default_directory(
+    const std::string& executable_path) {
+    std::string text;
+    text.reserve(executable_path.size() + 5u);
+    for (const char ch : executable_path)
+        text.push_back(ch == '\\' ? '/' : ch);
+    const std::size_t slash = text.rfind('/');
+    if (slash == std::string::npos) return "mods";
+    return text.substr(0, slash) + "/mods";
+}
+
+const std::string* nds_mod_packs_file_path(const NdsModPacksResult& result,
+                                           int content_id) {
+    for (const NdsModPackOverride& entry : result.files)
+        if (entry.key == content_id) return &entry.path;
+    return nullptr;
+}
+
+const std::string* nds_mod_packs_music_path(const NdsModPacksResult& result,
+                                            int track) {
+    for (const NdsModPackOverride& entry : result.music)
+        if (entry.key == track) return &entry.path;
+    return nullptr;
+}
+
+bool nds_mod_pack_resolve_path(const std::string& pack_directory,
+                               const std::string& relative,
+                               std::string* resolved, NdsModPackRule* rule,
+                               std::string* detail) {
+    return resolve_path(from_utf8(pack_directory), relative, resolved, rule,
+                        detail);
+}
+
+std::string nds_mod_pack_diagnostic_text(
+    const NdsModPackDiagnostic& diagnostic) {
+    std::string text = nds_mod_pack_severity_name(diagnostic.severity);
+    text += ' ';
+    text += nds_mod_pack_rule_name(diagnostic.rule);
+    text += ": ";
+    text += diagnostic.detail;
+    if (!diagnostic.file.empty() || diagnostic.line > 0) {
+        text += " (";
+        if (!diagnostic.file.empty()) text += diagnostic.file;
+        if (diagnostic.line > 0) {
+            if (!diagnostic.file.empty()) text += ':';
+            text += number_text(diagnostic.line);
+        }
+        text += ')';
+    }
+    return text;
+}
+
+}  // namespace nds_mod_packs
