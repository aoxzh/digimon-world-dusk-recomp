+                             "wrong target"))
+            return code;
+        if (int code = check("find_definition() returns nullptr for an "
+                             "unknown id",
+                             ach::find_definition(state, "nope") == nullptr,
+                             "not nullptr"))
+            return code;
+        if (int code = check("counter_high_water() is 0 for an unfed counter",
+                             ach::counter_high_water(state, "never_fed") == 0,
+                             "nonzero"))
+            return code;
+        ach::observe(&state, "in_game_saves", 7);
+        if (int code = check("counter_high_water() reports the mark",
+                             ach::counter_high_water(state, "in_game_saves") ==
+                                 7,
+                             std::to_string(ach::counter_high_water(
+                                 state, "in_game_saves"))))
+            return code;
+        if (int code = check("an unfed counter is not invented",
+                             ach::counter_high_water(state, "never_fed") == 0,
+                             "nonzero"))
+            return code;
+    }
+
+    // ==== 4. Summary and hidden achievements. ==========================
+    {
+        ach::NdsAchievementState state;
+        const std::string text = R"json({"achievements": [
+          {"id": "open", "name": "Open", "counter": "a_counter",
+           "target": 1},
+          {"id": "secret", "name": "Secret", "counter": "b_counter",
+           "target": 1, "hidden": true},
+          {"id": "open-two", "name": "Open two", "counter": "b_counter",
+           "target": 2}]})json";
+        diagnostics.clear();
+        install(root, "hidden.json", text, &state, &diagnostics);
+
+        const ach::NdsAchievementSummary start = ach::summarize(state);
+        if (int code = check("the summary counts every definition",
+                             start.total == 3, std::to_string(start.total)))
+            return code;
+        if (int code = check("the summary starts with nothing unlocked",
+                             start.unlocked == 0,
+                             std::to_string(start.unlocked)))
+            return code;
+        if (int code = check("a hidden definition is counted as hidden",
+                             start.hidden_total == 1,
+                             std::to_string(start.hidden_total)))
+            return code;
+        if (int code = check("a hidden definition is not in the visible total",
+                             start.visible_total == 2,
+                             std::to_string(start.visible_total)))
+            return code;
+        if (int code = check("hidden unlocks start at zero",
+                             start.hidden_unlocked == 0,
+                             std::to_string(start.hidden_unlocked)))
+            return code;
+
+        std::vector<ach::NdsAchievement> listed =
+            ach::listed_definitions(state);
+        if (int code = check("a hidden achievement is not listed before it "
+                             "is earned",
+                             listed.size() == 2u,
+                             std::to_string(listed.size())))
+            return code;
+        if (int code = check("the listing omits exactly the hidden id",
+                             ach::find_definition(state, "secret") != nullptr &&
+                                 listed.size() == 2u &&
+                                 listed[0].id == "open" &&
+                                 listed[1].id == "open-two",
+                             describe(listed)))
+            return code;
+
+        ach::observe(&state, "b_counter", 1);
+        listed = ach::listed_definitions(state);
+        const ach::NdsAchievementSummary bonus = ach::summarize(state);
+        if (int code = check("earning a hidden achievement reveals it",
+                             listed.size() == 3u,
+                             std::to_string(listed.size())))
+            return code;
+        if (int code = check("a revealed hidden achievement keeps its place",
+                             listed.size() == 3u &&
+                                 listed[1].id == "secret",
+                             describe(listed)))
+            return code;
+        if (int code = check("a hidden unlock is counted as unlocked",
+                             bonus.unlocked == 1,
+                             std::to_string(bonus.unlocked)))
+            return code;
+        if (int code = check("a hidden unlock is counted as hidden-unlocked",
+                             bonus.hidden_unlocked == 1,
+                             std::to_string(bonus.hidden_unlocked)))
+            return code;
+        if (int code = check("a hidden unlock is not counted as visible",
+                             bonus.visible_unlocked == 0,
+                             std::to_string(bonus.visible_unlocked)))
+            return code;
+
+        ach::NdsAchievementState empty_state;
+        const ach::NdsAchievementSummary zero = ach::summarize(empty_state);
+        if (int code = check("an empty state summarises to zeros",
+                             zero.total == 0 && zero.unlocked == 0 &&
+                                 zero.visible_total == 0 &&
+                                 zero.hidden_total == 0,
+                             std::to_string(zero.total)))
+            return code;
+    }
+
+    // ==== 5. A definition set that changes between runs. ===============
+    {
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 10);
+        ach::raise_flag(&state, "saw_credits");
+        const int before = ach::summarize(state).unlocked;
+
+        // Same set installed again: nothing is lost and nothing duplicates.
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        if (int code = check("reinstalling the same set keeps the unlocks",
+                             ach::summarize(state).unlocked == before,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("reinstalling the same set keeps the counters",
+                             ach::counter_high_water(state, "in_game_saves") ==
+                                 10,
+                             std::to_string(ach::counter_high_water(
+                                 state, "in_game_saves"))))
+            return code;
+        if (int code = check("reinstalling the same set keeps the flags",
+                             ach::is_unlocked(state, "first-flag"), "lost"))
+            return code;
+
+        // A shorter set: the removed achievement is remembered, not dropped.
+        const std::string shorter = R"json({"achievements": [
+          {"id": "first-save", "name": "First save",
+           "counter": "in_game_saves", "target": 1}]})json";
+        diagnostics.clear();
+        install(root, "shorter.json", shorter, &state, &diagnostics);
+        if (int code = check("a removed definition leaves the summary",
+                             ach::summarize(state).total == 1,
+                             std::to_string(ach::summarize(state).total)))
+            return code;
+        if (int code = check("a removed definition's unlock is still known",
+                             ach::is_unlocked(state, "ten-saves"), "lost"))
+            return code;
+        if (int code = check("a removed definition still counts as unlocked",
+                             ach::summarize(state).unlocked == 1,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+
+        // Restoring the definition restores the unlock without re-notifying.
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        if (int code = check("restoring a definition restores its unlock",
+                             ach::is_unlocked(state, "ten-saves"), "lost"))
+            return code;
+        if (int code = check("restoring a definition does not re-notify",
+                             notified_ids(state).empty(),
+                             join(notified_ids(state))))
+            return code;
+
+        // A new achievement over a counter already fed: refresh earns it.
+        const std::string added = R"json({"achievements": [
+          {"id": "first-save", "name": "First save",
+           "counter": "in_game_saves", "target": 1},
+          {"id": "twenty-saves", "name": "Twenty saves",
+           "counter": "in_game_saves", "target": 20}]})json";
+        diagnostics.clear();
+        install(root, "added.json", added, &state, &diagnostics);
+        if (int code = check("a new definition is not earned until it is "
+                             "refreshed",
+                             !ach::is_unlocked(state, "twenty-saves"),
+                             "unlocked early"))
+            return code;
+        ach::refresh_unlocks(&state);
+        if (int code = check("a new definition is not earned from an old mark",
+                             !ach::is_unlocked(state, "twenty-saves"),
+                             "unlocked early"))
+            return code;
+        ach::observe(&state, "in_game_saves", 20);
+        if (int code = check("a new definition is earned when its counter is "
+                             "reached",
+                             ach::is_unlocked(state, "twenty-saves"),
+                             "not unlocked"))
+            return code;
+    }
+
+    // ==== 6. Progress persistence. =====================================
+    {
+        const fs::path progress = root / "progress" / "achievements.dat";
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 10);
+        ach::raise_flag(&state, "saw_credits");
+        if (int code = check("store_progress() writes the file",
+                             ach::store_progress(state, progress.string()),
+                             progress.string()))
+            return code;
+        if (int code = check("store_progress() creates missing directories",
+                             file_exists(progress), progress.string()))
+            return code;
+
+        const std::string text = read_file(progress);
+        const std::vector<std::string> lines = lines_of(text);
+        if (int code = check("the progress file starts with its version",
+                             !lines.empty() &&
+                                 lines[0] == "achievements_version=1",
+                             lines.empty() ? "(empty)" : lines[0]))
+            return code;
+        if (int code = check("the progress file ends with the end marker",
+                             !lines.empty() && lines.back() == "# end",
+                             lines.empty() ? "(empty)" : lines.back()))
+            return code;
+        if (int code = check("the progress file lists each unlock once",
+                             count_prefixed(lines, "unlocked=") == 3,
+                             std::to_string(
+                                 count_prefixed(lines, "unlocked="))))
+            return code;
+        if (int code = check("the progress file records the counter mark",
+                             index_of_line(lines,
+                                           "counter.in_game_saves=10") >= 0,
+                             text))
+            return code;
+        if (int code = check("unlocks are written in definition order",
+                             index_of_line(lines, "unlocked=first-save") <
+                                 index_of_line(lines, "unlocked=ten-saves"),
+                             text))
+            return code;
+        if (int code = check("a stored file leaves no temporary behind",
+                             !file_exists(progress.string() + ".tmp"),
+                             progress.string() + ".tmp"))
+            return code;
+
+        // Round trip into a fresh state.
+        ach::NdsAchievementState reloaded;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &reloaded,
+                &diagnostics);
+        if (int code = check("load_progress() reads the stored file",
+                             ach::load_progress(&reloaded, progress.string(),
+                                                &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a clean progress file reports no diagnostics",
+                             diagnostics.empty(), join(diagnostics)))
+            return code;
+        if (int code = check("every unlock round trips",
+                             ach::is_unlocked(reloaded, "first-save") &&
+                                 ach::is_unlocked(reloaded, "ten-saves"),
+                             "missing"))
+            return code;
+        if (int code = check("a flag unlock round trips",
+                             ach::is_unlocked(reloaded, "first-flag"),
+                             "missing"))
+            return code;
+        if (int code = check("a counter mark round trips",
+                             ach::counter_high_water(reloaded,
+                                                     "in_game_saves") == 10,
+                             std::to_string(ach::counter_high_water(
+                                 reloaded, "in_game_saves"))))
+            return code;
+        if (int code = check("loading progress does not notify",
+                             notified_ids(reloaded).empty(),
+                             join(notified_ids(reloaded))))
+            return code;
+
+        // Determinism: the same state twice writes the same bytes.
+        const fs::path again = root / "progress" / "again.dat";
+        ach::store_progress(reloaded, again.string());
+        if (int code = check("storing the same state twice writes the same "
+                             "bytes",
+                             read_file(again) == text, "differs"))
+            return code;
+    }
+
+    {
+        // Missing and unreadable: false, and the caller keeps its state.
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 10);
+        const int before = ach::summarize(state).unlocked;
+        diagnostics.clear();
+        const bool loaded = ach::load_progress(
+            &state, (root / "progress" / "absent.dat").string(), &diagnostics);
+        if (int code = check("load_progress() of a missing file returns false",
+                             !loaded, "returned true"))
+            return code;
+        if (int code = check("a missing progress file keeps the live state",
+                             ach::summarize(state).unlocked == before,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("a missing progress file is reported",
+                             diagnostics_mention(diagnostics, "absent.dat"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a missing progress file leaves the counters",
+                             ach::counter_high_water(state, "in_game_saves") ==
+                                 10,
+                             "lost"))
+            return code;
+    }
+
+    {
+        // Damage: a truncated tail, a corrupt line, a foreign key, a counter
+        // that is not a number. Reading is additive, so the damage may add
+        // noise but must never remove what the session already computed.
+        const fs::path damaged = root / "progress" / "damaged.dat";
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 5);
+        const int before = ach::summarize(state).unlocked;
+
+        const std::string text =
+            "achievements_version=1\n"
+            "unlocked=first-save\n"
+            "unlocked=first-save\n"
+            "counter.in_game_saves=2\n"
+            "counter.unreadable=not-a-number\n"
+            "foreign.key=whatever\n"
+            "just-some-text\n"
+            "unlocked=Not A Name\n"
+            "counter.Bad Name=3\n"
+            "unlocked=fir";
+        write_file(damaged, text);
+        diagnostics.clear();
+        if (int code = check("a damaged progress file still loads",
+                             ach::load_progress(&state, damaged.string(),
+                                                &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a duplicated unlock stays one unlock",
+                             ach::summarize(state).unlocked >= 1 &&
+                                 ach::is_unlocked(state, "first-save"),
+                             "lost"))
+            return code;
+        if (int code = check("a truncated file does not lose live progress",
+                             ach::summarize(state).unlocked == before,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("a counter going backwards in the file is "
+                             "ignored",
+                             ach::counter_high_water(state, "in_game_saves") ==
+                                 5,
+                             std::to_string(ach::counter_high_water(
+                                 state, "in_game_saves"))))
+            return code;
+        if (int code = check("a counter that is not a number is reported",
+                             diagnostics_mention(diagnostics, "unreadable"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a foreign key is reported",
+                             diagnostics_mention(diagnostics, "foreign.key"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a line without '=' is reported",
+                             diagnostics_mention(diagnostics, "line 7"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an unlock whose id is not kebab-case is "
+                             "reported",
+                             diagnostics_mention(diagnostics, "Not A Name"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an unlock whose id is not kebab-case is "
+                             "ignored",
+                             !ach::is_unlocked(state, "Not A Name"),
+                             "accepted"))
+            return code;
+        if (int code = check("a counter whose name is not snake_case is "
+                             "reported",
+                             diagnostics_mention(diagnostics, "Bad Name"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a counter whose name is not snake_case is "
+                             "ignored",
+                             ach::counter_high_water(state, "Bad Name") == 0,
+                             "accepted"))
+            return code;
+        if (int code = check("a truncated tail does not enter the state as an "
+                             "unlock",
+                             !ach::is_unlocked(state, "fir"), "fir accepted"))
+            return code;
+        if (int code = check("a truncated file is reported",
+                             diagnostics_mention(diagnostics, "truncated"),
+                             join(diagnostics)))
+            return code;
+
+        // Re-storing rewrites the file clean, which is how damage heals.
+        if (int code = check("a damaged state stores back cleanly",
+                             ach::store_progress(state, damaged.string()),
+                             damaged.string()))
+            return code;
+        const std::vector<std::string> healed = lines_of(read_file(damaged));
+        if (int code = check("a rewritten file has no foreign key left",
+                             count_prefixed(healed, "foreign.key") == 0,
+                             read_file(damaged)))
+            return code;
+        if (int code = check("a rewritten file has one end marker",
+                             count_prefixed(healed, "# end") == 1,
+                             read_file(damaged)))
+            return code;
+    }
+
+    {
+        // A progress file from another build: ids this definition set does not
+        // know must not be thrown away.
+        const fs::path foreign = root / "progress" / "foreign.dat";
+        write_file(foreign,
+                   "achievements_version=1\n"
+                   "unlocked=first-save\n"
+                   "unlocked=removed-achievement\n"
+                   "counter.in_game_saves=4\n"
+                   "# end\n");
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        diagnostics.clear();
+        if (int code = check("a foreign progress file loads",
+                             ach::load_progress(&state, foreign.string(),
+                                                &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a known id is unlocked from a foreign file",
+                             ach::is_unlocked(state, "first-save"), "lost"))
+            return code;
+        if (int code = check("an unknown id is kept as an orphan unlock",
+                             ach::is_unlocked(state, "removed-achievement"),
+                             "lost"))
+            return code;
+        if (int code = check("an orphan unlock is not counted in the summary",
+                             ach::summarize(state).unlocked == 1,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("a foreign file that loads cleanly reports "
+                             "nothing",
+                             diagnostics.empty(), join(diagnostics)))
+            return code;
+
+        const fs::path round = root / "progress" / "foreign-round.dat";
+        ach::store_progress(state, round.string());
+        const std::vector<std::string> lines = lines_of(read_file(round));
+        if (int code = check("an orphan unlock is written back",
+                             index_of_line(
+                                 lines,
+                                 "unlocked=removed-achievement") >= 0,
+                             read_file(round)))
+            return code;
+        if (int code = check("a written orphan follows the known unlocks",
+                             index_of_line(lines, "unlocked=first-save") <
+                                 index_of_line(
+                                     lines,
+                                     "unlocked=removed-achievement"),
+                             read_file(round)))
+            return code;
+
+        // And restoring the definition reclaims it.
+        const std::string restored = R"json({"achievements": [
+          {"id": "first-save", "name": "First save",
+           "counter": "in_game_saves", "target": 1},
+          {"id": "removed-achievement", "name": "Back again",
+           "counter": "in_game_saves", "target": 2}]})json";
+        diagnostics.clear();
+        install(root, "restored.json", restored, &state, &diagnostics);
+        if (int code = check("restoring a definition reclaims its orphan "
+                             "unlock",
+                             ach::is_unlocked(state, "removed-achievement") &&
+                                 ach::summarize(state).unlocked == 2,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("reclaiming an orphan does not re-notify",
+                             notified_ids(state).empty(),
+                             join(notified_ids(state))))
+            return code;
+    }
+
+    {
+        // A file with nothing but a header: a fresh player who has not earned
+        // anything yet.
+        const fs::path blank = root / "progress" / "blank.dat";
+        write_file(blank, "achievements_version=1\n# end\n");
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        if (int code = check("an empty progress file loads",
+                             ach::load_progress(&state, blank.string(),
+                                                &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an empty progress file unlocks nothing",
+                             ach::summarize(state).unlocked == 0,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("an empty progress file reports nothing",
+                             diagnostics.empty(), join(diagnostics)))
+            return code;
+    }
+
+    {
+        // An empty state still writes a usable file, and load/store of that
+        // file is stable.
+        const fs::path empty = root / "progress" / "empty.dat";
+        const ach::NdsAchievementState blank_state;
+        if (int code = check("an empty state stores",
+                             ach::store_progress(blank_state,
+                                                 empty.string()),
+                             empty.string()))
+            return code;
+        const std::vector<std::string> lines = lines_of(read_file(empty));
+        if (int code = check("an empty state writes only the header and the "
+                             "marker",
+                             lines.size() == 2u, read_file(empty)))
+            return code;
+        if (int code = check("storing an empty state is refused for an empty "
+                             "path",
+                             !ach::store_progress(blank_state, ""),
+                             "accepted"))
+            return code;
+    }
+
+    {
+        // A file whose last line is a partial record and which therefore has
+        // no end marker: every complete line applies, the tail does not.
+        const fs::path partial = root / "progress" / "partial.dat";
+        write_file(partial,
+                   "achievements_version=1\n"
+                   "unlocked=first-save\n"
+                   "counter.in_game_saves=9\n"
+                   "unlocked=ten");
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        diagnostics.clear();
+        if (int code = check("a file without an end marker still loads",
+                             ach::load_progress(&state, partial.string(),
+                                                &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a complete line before the truncated tail "
+                             "applies",
+                             ach::is_unlocked(state, "first-save") &&
+                                 ach::counter_high_water(state,
+                                                         "in_game_saves") ==
+                                     9,
+                             "missing"))
+            return code;
+        if (int code = check("the partial tail is not read as an unlock",
+                             !ach::is_unlocked(state, "ten"), "ten accepted"))
+            return code;
+    }
+
+    {
+        // Loading is idempotent and additive in both directions.
+        const fs::path first = root / "progress" / "idem.dat";
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &state, &diagnostics);
+        ach::observe(&state, "in_game_saves", 10);
+        ach::store_progress(state, first.string());
+        ach::load_progress(&state, first.string(), &diagnostics);
+        ach::load_progress(&state, first.string(), &diagnostics);
+        if (int code = check("loading the same progress file twice is stable",
+                             ach::summarize(state).unlocked == 2,
+                             std::to_string(ach::summarize(state).unlocked)))
+            return code;
+        if (int code = check("loading the same file twice keeps the counter",
+                             ach::counter_high_water(state, "in_game_saves") ==
+                                 10,
+                             std::to_string(ach::counter_high_water(
+                                 state, "in_game_saves"))))
+            return code;
+    }
+
+    // ==== 7. Determinism across runs. ==================================
+    {
+        std::vector<ach::NdsAchievement> once;
+        std::vector<ach::NdsAchievement> twice;
+        std::vector<std::string> first_diagnostics;
+        std::vector<std::string> second_diagnostics;
+        write_file(root / "defs" / "three-again.json", kThreeDefinitions);
+        ach::load_definitions((root / "defs" / "three-again.json").string(),
+                              &once, &first_diagnostics);
+        ach::load_definitions((root / "defs" / "three-again.json").string(),
+                              &twice, &second_diagnostics);
+        if (int code = check("parsing the same file twice is identical",
+                             describe(once) == describe(twice) &&
+                                 once.size() == twice.size(),
+                             describe(once) + " vs " + describe(twice)))
+            return code;
+        if (int code = check("parsing a clean file twice reports nothing",
+                             first_diagnostics.empty() &&
+                                 second_diagnostics.empty(),
+                             join(first_diagnostics)))
+            return code;
+    }
+
+    {
+        // Two states fed the same way must produce the same file: this is what
+        // makes a bug report's progress file comparable to a fresh one.
+        ach::NdsAchievementState left;
+        ach::NdsAchievementState right;
+        diagnostics.clear();
+        install(root, "three.json", kThreeDefinitions, &left, &diagnostics);
+        install(root, "three.json", kThreeDefinitions, &right, &diagnostics);
+        ach::observe(&left, "in_game_saves", 4);
+        ach::raise_flag(&left, "saw_credits");
+        ach::raise_flag(&right, "saw_credits");
+        ach::observe(&right, "in_game_saves", 4);
+        const fs::path left_path = root / "progress" / "left.dat";
+        const fs::path right_path = root / "progress" / "right.dat";
+        ach::store_progress(left, left_path.string());
+        ach::store_progress(right, right_path.string());
+        if (int code = check("observation order does not change the file",
+                             read_file(left_path) == read_file(right_path),
+                             read_file(left_path) + " vs " +
+                                 read_file(right_path)))
+            return code;
+    }
+
+    {
+        // Boundary values: the DS clock is 64-bit-ish and a counter may be
+        // large; nothing may overflow or wrap.
+        ach::NdsAchievementState state;
+        const std::string text = R"json({"achievements": [
+          {"id": "huge", "name": "Huge", "counter": "frames_presented",
+           "target": 9223372036854775806}]})json";
+        diagnostics.clear();
+        install(root, "huge.json", text, &state, &diagnostics);
+        ach::observe(&state, "frames_presented", 9223372036854775807LL);
+        if (int code = check("a 64-bit counter target can be reached",
+                             ach::is_unlocked(state, "huge"), "not unlocked"))
+            return code;
+        ach::observe(&state, "negative_counter", -5);
+        if (int code = check("a negative counter does not go below zero",
+                             ach::counter_high_water(state,
+                                                     "negative_counter") == 0,
+                             std::to_string(ach::counter_high_water(
+                                 state, "negative_counter"))))
+            return code;
+    }
+
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// used first, but a sandboxed run can refuse writes there because the process
+// working directory sits inside the tree under test, so the working directory
+// is tried second. Returns false only when neither location can hold the tree,
+// and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line that names both candidate
+    // paths stays unambiguous even when TEMP and the working directory are
+    // the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error && create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr, "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    namespace fs = std::filesystem;
+    const auto stamp =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    fs::path root;
+    if (!create_root("nds-achievements-test", std::to_string(stamp), &root))
+        return 1;
+
+    // Checks live in run_checks() so the temporary tree is removed on every
+    // exit path, including a failing one.
+    const int result = run_checks(root);
+    if (result == 0) std::printf("%d checks passed\n", g_checks);
+    std::error_code cleanup_error;
+    fs::remove_all(root, cleanup_error);
+    return result;
+}
diff --git a/runner/tests/audio_capture_test.cpp b/runner/tests/audio_capture_test.cpp
new file mode 100644
index 0000000..afe312d
--- /dev/null
+++ b/runner/tests/audio_capture_test.cpp
@@ -0,0 +1,1231 @@
+// Pins the dependency-free WAV recorder (audio_capture.h) against an
+// INDEPENDENT decoder written here.
+//
+// "It plays in a media player" is not a test. A header whose byte_rate is
+// wrong, a data chunk size left at 0, a block_align that disagrees with the
+// channel count or a payload written in the wrong byte order all still open in
+// a permissive player -- and the first two of those are exactly what a header
+// "patched at the end" gets wrong. So this file walks the container itself:
+//
+//   * the 44 fixed prologue bytes: both chunk tags, riff_size against the real
+//     file length, fmt chunk size 16, audio_format 1 (PCM), channels, sample
+//     rate, byte_rate == rate * channels * 2, block_align == channels * 2, 16
+//     bits per sample, then "data", data_size against the real payload length,
+//     and no byte after the payload;
+//   * every payload byte against the samples handed to write(), so byte order,
+//     channel interleaving and frame counting are pinned rather than assumed;
+//   * the extremes INT16_MIN/INT16_MAX, mono and stereo, 0 frames, a recording
+//     assembled from several writes that cross 64 KiB, and one single write
+//     large enough to be split internally;
+//   * the state machine: write() with nothing open, a second open() while a
+//     recording runs, reopen after close truncating the old file, close()
+//     twice, close() on a recorder that was never opened, and a failed write
+//     latching the recording shut while still leaving a valid file;
+//   * a UTF-8 path, proved by the bytes of the name that appears on disk: a
+//     narrow std::string path is read in the host's ANSI code page, so a
+//     recorder that forgets the conversion writes "café" as "cafÃ©" and only a
+//     directory listing shows it.
+//
+// The decoder is itself mutation-tested first: one field of a valid recording
+// is damaged at a time and the decoder must reject it with a message naming
+// that field. A decoder that accepts anything cannot make the writer appear
+// correct.
+//
+// Every assertion prints OK with its own name. The first failure prints FAIL
+// plus one detail line, and its 1-based ordinal becomes the process exit code,
+// so a failing check names itself without a debugger. The scratch tree is
+// removed on every exit path.
+
+#include "audio_capture.h"
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iterator>
+#include <limits>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace {
+
+// The canonical WAVE prologue: "RIFF"/size/"WAVE", a 16-byte "fmt " chunk,
+// then "data"/size. Offsets into the file are fixed by the format.
+constexpr std::size_t kHeaderBytes = 44u;
+constexpr std::size_t kRiffSizeOffset = 4u;
+constexpr std::size_t kDataSizeOffset = 40u;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const char* what, const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what);
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::fprintf(stderr, "FAIL %s\n     %s\n", what, detail.c_str());
+    return false;
+}
+
+template <typename T>
+std::string num(T value) {
+    return std::to_string(value);
+}
+
+std::string hex(uint32_t value, int digits) {
+    char buffer[16];
+    std::snprintf(buffer, sizeof(buffer), "0x%0*X", digits,
+                  static_cast<unsigned>(value));
+    return buffer;
+}
+
+// The UTF-8 spelling of a path, which is the encoding the recorder's contract
+// names. path::string() would be the obvious choice and is the wrong one: on
+// Windows it converts through the host's ANSI code page and throws for any name
+// outside it, so a scratch directory under a non-ASCII TEMP would fail the test
+// before the writer was reached. u8string() has no such reservation.
+std::string narrow(const std::filesystem::path& path) {
+    const std::u8string text = path.u8string();
+    return std::string(reinterpret_cast<const char*>(text.data()), text.size());
+}
+
+// The UTF-8 spelling of one path component. The checks that care about names
+// build every path by iterating from an ASCII root and compare components here
+// rather than converting text back into a path, so the comparison never shares
+// a conversion with the code under test.
+std::string utf8_name(const std::filesystem::path& path) {
+    const std::u8string text = path.filename().u8string();
+    return std::string(reinterpret_cast<const char*>(text.data()), text.size());
+}
+
+// ---- byte readers ---------------------------------------------------------
+
+uint16_t read_le16(const std::vector<uint8_t>& bytes, std::size_t at) {
+    return static_cast<uint16_t>(
+        static_cast<uint16_t>(bytes[at]) |
+        static_cast<uint16_t>(static_cast<uint16_t>(bytes[at + 1u]) << 8u));
+}
+
+uint32_t read_le32(const std::vector<uint8_t>& bytes, std::size_t at) {
+    return static_cast<uint32_t>(bytes[at]) |
+           (static_cast<uint32_t>(bytes[at + 1u]) << 8u) |
+           (static_cast<uint32_t>(bytes[at + 2u]) << 16u) |
+           (static_cast<uint32_t>(bytes[at + 3u]) << 24u);
+}
+
+void write_le32(std::vector<uint8_t>* bytes, std::size_t at, uint32_t value) {
+    (*bytes)[at] = static_cast<uint8_t>(value);
+    (*bytes)[at + 1u] = static_cast<uint8_t>(value >> 8u);
+    (*bytes)[at + 2u] = static_cast<uint8_t>(value >> 16u);
+    (*bytes)[at + 3u] = static_cast<uint8_t>(value >> 24u);
+}
+
+// An int16_t sample's bit pattern as the little-endian pair WAV requires. The
+// uint16_t conversion is the modulo one, so this is exact for every value.
+std::vector<uint8_t> sample_bytes(const std::vector<int16_t>& samples) {
+    std::vector<uint8_t> bytes;
+    bytes.reserve(samples.size() * 2u);
+    for (const int16_t sample : samples) {
+        const uint16_t raw = static_cast<uint16_t>(sample);
+        bytes.push_back(static_cast<uint8_t>(raw & 0xFFu));
+        bytes.push_back(static_cast<uint8_t>(raw >> 8u));
+    }
+    return bytes;
+}
+
+// One sample of a decoded file, read back from the little-endian payload. The
+// memcpy keeps the conversion exact on a big-endian host too, where casting a
+// uint16_t above INT16_MAX to int16_t would be a signed overflow question.
+int16_t sample_at(const std::vector<uint8_t>& payload, std::size_t index) {
+    const uint16_t raw = static_cast<uint16_t>(
+        static_cast<uint16_t>(payload[index * 2u]) |
+        static_cast<uint16_t>(static_cast<uint16_t>(payload[index * 2u + 1u])
+                              << 8u));
+    int16_t value = 0;
+    std::memcpy(&value, &raw, sizeof(value));
+    return value;
+}
+
+// ---- independent WAV decoder ---------------------------------------------
+
+struct DecodedWav {
+    uint32_t riff_size = 0;
+    uint32_t fmt_size = 0;
+    uint16_t audio_format = 0;
+    uint16_t channels = 0;
+    uint32_t sample_rate = 0;
+    uint32_t byte_rate = 0;
+    uint16_t block_align = 0;
+    uint16_t bits_per_sample = 0;
+    uint32_t data_size = 0;
+    std::vector<uint8_t> payload;
+};
+
+// Empty string means success; otherwise the text names the defect.
+std::string decode_wav(const std::vector<uint8_t>& file, DecodedWav* out) {
+    if (file.size() < kHeaderBytes) {
+        return "file of " + num(file.size()) +
+               " byte(s) is shorter than the 44-byte WAVE header";
+    }
+    if (std::memcmp(file.data(), "RIFF", 4u) != 0) {
+        return "file does not start with the RIFF tag";
+    }
+    if (std::memcmp(file.data() + 8u, "WAVE", 4u) != 0) {
+        return "byte 8 is not the WAVE form type";
+    }
+    DecodedWav wav;
+    wav.riff_size = read_le32(file, kRiffSizeOffset);
+    const uint32_t expected_riff =
+        static_cast<uint32_t>(file.size() - 8u);
+    if (wav.riff_size != expected_riff) {
+        return "riff size is " + num(wav.riff_size) + ", the file needs " +
+               num(expected_riff) + " (length - 8)";
+    }
+    if (std::memcmp(file.data() + 12u, "fmt ", 4u) != 0) {
+        return "byte 12 is not the fmt chunk tag";
+    }
+    wav.fmt_size = read_le32(file, 16u);
+    if (wav.fmt_size != 16u) {
+        return "fmt chunk size is " + num(wav.fmt_size) + ", PCM needs 16";
+    }
+    wav.audio_format = read_le16(file, 20u);
+    if (wav.audio_format != 1u) {
+        return "audio format is " + num(wav.audio_format) +
+               ", not 1 (PCM)";
+    }
+    wav.channels = read_le16(file, 22u);
+    if (wav.channels == 0u) return "channel count is 0";
+    wav.sample_rate = read_le32(file, 24u);
+    if (wav.sample_rate == 0u) return "sample rate is 0";
+    wav.byte_rate = read_le32(file, 28u);
+    const uint64_t expected_rate = static_cast<uint64_t>(wav.sample_rate) *
+                                   wav.channels * 2u;
+    if (wav.byte_rate != expected_rate) {
+        return "byte rate is " + num(wav.byte_rate) + ", " +
+               num(wav.sample_rate) + " Hz x " + num(wav.channels) +
+               " channels x 2 bytes needs " + num(expected_rate);
+    }
+    wav.block_align = read_le16(file, 32u);
+    const uint32_t expected_align =
+        static_cast<uint32_t>(wav.channels) * 2u;
+    if (wav.block_align != expected_align) {
+        return "block align is " + num(wav.block_align) + ", " +
+               num(wav.channels) + " 16-bit channel(s) pack into " +
+               num(expected_align) + " bytes";
+    }
+    wav.bits_per_sample = read_le16(file, 34u);
+    if (wav.bits_per_sample != 16u) {
+        return "bits per sample is " + num(wav.bits_per_sample) +
+               ", not 16";
+    }
+    if (std::memcmp(file.data() + 36u, "data", 4u) != 0) {
+        return "byte 36 is not the data chunk tag";
+    }
+    wav.data_size = read_le32(file, kDataSizeOffset);
+    const std::size_t remaining = file.size() - kHeaderBytes;
+    if (wav.data_size > remaining) {
+        return "data chunk size " + num(wav.data_size) +
+               " exceeds the " + num(remaining) + " payload byte(s) present";
+    }
+    if (wav.data_size < remaining) {
+        return num(remaining - wav.data_size) +
+               " trailing byte(s) after the data chunk";
+    }
+    wav.payload.assign(file.begin() + static_cast<std::ptrdiff_t>(kHeaderBytes),
+                       file.end());
+    *out = std::move(wav);
+    return std::string();
+}
+
+// ---- file helpers ---------------------------------------------------------
+
+bool read_bytes(const std::filesystem::path& path,
+                std::vector<uint8_t>* out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    out->assign(std::istreambuf_iterator<char>(in),
+                std::istreambuf_iterator<char>());
+    return true;
+}
+
+// Writes one recording and decodes the file back. `problem` is empty on
+// success and otherwise names the first thing that did not hold.
+struct Recording {
+    std::vector<uint8_t> file;
+    DecodedWav wav;
+    std::string problem;
+};
+
+Recording record_one(const std::filesystem::path& path, uint32_t rate,
+                     int channels, const std::vector<int16_t>& samples) {
+    Recording result;
+    NdsWavRecorder recorder;
+    if (!recorder.open(narrow(path), rate, channels)) {
+        result.problem = "open() failed: " +
+                         std::string(recorder.last_error());
+        return result;
+    }
+    const std::size_t stride = static_cast<std::size_t>(channels);
+    const std::size_t frames = stride == 0u ? 0u : samples.size() / stride;
+    recorder.write(samples.empty() ? nullptr : samples.data(),
+                   static_cast<uint32_t>(frames));
+    if (!recorder.close()) {
+        result.problem = "close() failed: " +
+                         std::string(recorder.last_error());
+        return result;
+    }
+    if (!read_bytes(path, &result.file)) {
+        result.problem = "cannot read back the recording '" + narrow(path) +
+                         "'";
+        return result;
+    }
+    result.problem = decode_wav(result.file, &result.wav);
+    return result;
+}
+
+// First difference between a decoded payload and the samples that were handed
+// to write(); empty when they match byte for byte.
+std::string compare_payload(const std::vector<uint8_t>& got,
+                            const std::vector<int16_t>& samples) {
+    const std::vector<uint8_t> want = sample_bytes(samples);
+    if (got.size() != want.size()) {
+        return "payload is " + num(got.size()) + " byte(s), " +
+               num(samples.size()) + " sample(s) need " + num(want.size());
+    }
+    for (std::size_t i = 0; i < want.size(); ++i) {
+        if (got[i] != want[i]) {
+            return "payload byte " + num(i) + " is " + hex(got[i], 2) +
+                   ", expected " + hex(want[i], 2) + " (sample " + num(i / 2u) +
+                   " is " + num(sample_at(got, i / 2u)) + ", source " +
+                   num(samples[i / 2u]) + ")";
+        }
+    }
+    return std::string();
+}
+
+// Every field the format fixes, for a recording of `frames` frames. Each field
+// is its own check so a failure names the one that is wrong.
+bool check_header(const std::string& label, const DecodedWav& wav,
+                  uint32_t rate, int channels, std::size_t frames) {
+    const std::size_t stride = static_cast<std::size_t>(channels);
+    const std::size_t data_bytes = frames * stride * 2u;
+    const uint64_t byte_rate = static_cast<uint64_t>(rate) * stride * 2u;
+    bool ok = true;
+    ok = check(wav.fmt_size == 16u, (label + ": fmt chunk size is 16").c_str(),
+               num(wav.fmt_size)) &&
+         ok;
+    ok = check(wav.audio_format == 1u,
+               (label + ": audio format is PCM").c_str(),
+               num(wav.audio_format)) &&
+         ok;
+    ok = check(wav.channels == static_cast<uint16_t>(channels),
+               (label + ": channel count").c_str(),
+               num(wav.channels) + ", wrote " + num(channels)) &&
+         ok;
+    ok = check(wav.sample_rate == rate, (label + ": sample rate").c_str(),
+               num(wav.sample_rate) + ", wrote " + num(rate)) &&
+         ok;
+    ok = check(wav.byte_rate == byte_rate, (label + ": byte rate").c_str(),
+               num(wav.byte_rate) + ", want " + num(byte_rate)) &&
+         ok;
+    ok = check(wav.block_align == static_cast<uint16_t>(stride * 2u),
+               (label + ": block align").c_str(),
+               num(wav.block_align) + ", want " + num(stride * 2u)) &&
+         ok;
+    ok = check(wav.bits_per_sample == 16u,
+               (label + ": 16 bits per sample").c_str(),
+               num(wav.bits_per_sample)) &&
+         ok;
+    ok = check(wav.data_size == data_bytes,
+               (label + ": data chunk size covers the payload").c_str(),
+               num(wav.data_size) + ", want " + num(data_bytes)) &&
+         ok;
+    ok = check(wav.riff_size == 36u + data_bytes,
+               (label + ": riff size covers header and payload").c_str(),
+               num(wav.riff_size) + ", want " + num(36u + data_bytes)) &&
+         ok;
+    ok = check(wav.payload.size() == data_bytes,
+               (label + ": payload length").c_str(),
+               num(wav.payload.size()) + ", want " + num(data_bytes)) &&
+         ok;
+    return ok;
+}
+
+// ---- the checks -----------------------------------------------------------
+
+// Damages a copy of a valid recording, then requires the decoder to reject it
+// with a message naming the damaged field.
+bool expect_rejected(const std::vector<uint8_t>& valid, const std::string& name,
+                     const char* keyword,
+                     const std::function<void(std::vector<uint8_t>*)>& damage) {
+    std::vector<uint8_t> file = valid;
+    damage(&file);
+    DecodedWav wav;
+    const std::string problem = decode_wav(file, &wav);
+    const bool rejected =
+        !problem.empty() &&
+        problem.find(keyword) != std::string::npos;
+    const std::string label = "decoder rejects " + name;
+    const std::string detail =
+        problem.empty()
+            ? "decode_wav accepted the file, so the matching writer check "
+              "cannot be trusted"
+            : "rejected with '" + problem + "', which does not mention '" +
+                  std::string(keyword) + "'";
+    return check(rejected, label.c_str(), detail);
+}
+
+// ---- 0. decoder self-controls --------------------------------------------
+
+bool check_decoder_controls(const std::filesystem::path& root) {
+    const std::vector<int16_t> samples = {
+        std::numeric_limits<int16_t>::min(),
+        std::numeric_limits<int16_t>::max(),
+        0, -1, 1, 12345, -12345, -32768 + 7,
+    };
+    const Recording control =
+        record_one(root / "control.wav", 22050u, 2, samples);
+    if (!check(control.problem.empty(), "the control recording decodes",
+               control.problem)) {
+        return false;
+    }
+    const std::vector<uint8_t>& file = control.file;
+    const uint32_t data = control.wav.data_size;
+
+    bool ok = true;
+    ok = expect_rejected(file, "a bad RIFF tag", "RIFF",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[3] = static_cast<uint8_t>('X');
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a short riff size", "riff size",
+                         [](std::vector<uint8_t>* bytes) {
+                             write_le32(bytes, kRiffSizeOffset,
+                                        read_le32(*bytes, kRiffSizeOffset) -
+                                            2u);
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a bad WAVE form type", "WAVE",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[11] = static_cast<uint8_t>('X');
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a bad fmt tag", "fmt chunk tag",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[15] = static_cast<uint8_t>('x');
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a non-PCM fmt chunk size", "fmt chunk size",
+                         [](std::vector<uint8_t>* bytes) {
+                             write_le32(bytes, 16u, 18u);
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a float audio format", "audio format",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[20] = 3u;
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "zero channels", "channel count",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[22] = 0u;
+                             (*bytes)[23] = 0u;
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a wrong block align", "block align",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[32] = 3u;
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a wrong byte rate", "byte rate",
+                         [](std::vector<uint8_t>* bytes) {
+                             write_le32(bytes, 28u, 1u);
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "an 8-bit sample size", "bits per sample",
+                         [](std::vector<uint8_t>* bytes) {
+                             (*bytes)[34] = 8u;
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a trailing pad after the payload", "trailing",
+                         [](std::vector<uint8_t>* bytes) {
+                             bytes->push_back(0x00u);
+                             // riff_size is re-stamped: the pad is legal
+                             // there, so the fault must be found by the data
+                             // chunk size rather than by a stale length.
+                             write_le32(bytes, kRiffSizeOffset,
+                                        static_cast<uint32_t>(
+                                            bytes->size() - 8u));
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a data size larger than the payload",
+                         "exceeds",
+                         [data](std::vector<uint8_t>* bytes) {
+                             write_le32(bytes, kDataSizeOffset, data + 2u);
+                         }) &&
+         ok;
+    ok = expect_rejected(file, "a truncated file", "exceeds",
+                         [](std::vector<uint8_t>* bytes) {
+                             bytes->resize(bytes->size() - 3u);
+                             write_le32(bytes, kRiffSizeOffset,
+                                        static_cast<uint32_t>(
+                                            bytes->size() - 8u));
+                         }) &&
+         ok;
+    return ok;
+}
+
+// ---- 1. the empty recording ----------------------------------------------
+
+bool check_zero_frames(const std::filesystem::path& root) {
+    const std::filesystem::path path = root / "empty.wav";
+    const Recording got = record_one(path, 8000u, 1, {});
+    if (!check(got.problem.empty(), "a 0-frame recording decodes",
+               got.problem)) {
+        return false;
+    }
+    const bool header = check_header("0 frames", got.wav, 8000u, 1, 0u);
+    bool ok = header;
+    ok = check(got.file.size() == kHeaderBytes,
+               "a 0-frame file is exactly the 44-byte header",
+               num(got.file.size()) + " bytes") &&
+         ok;
+    ok = check(got.wav.riff_size == 36u,
+               "a 0-frame riff size is 36 (header minus its own 8 bytes)",
+               num(got.wav.riff_size)) &&
+         ok;
+    ok = check(got.wav.data_size == 0u, "a 0-frame data size is 0",
+               num(got.wav.data_size)) &&
+         ok;
+    return ok;
+}
+
+// ---- 2. mono, extremes and round trip ------------------------------------
+
+bool check_mono(const std::filesystem::path& root) {
+    // INT16_MIN and INT16_MAX first: a writer that computes the sample with
+    // sign-magnitude arithmetic, or that formats the payload through a
+    // signed-shift, gets exactly these two wrong while a mid-range ramp looks
+    // perfect.
+    const std::vector<int16_t> samples = {
+        std::numeric_limits<int16_t>::min(),
+        std::numeric_limits<int16_t>::max(),
+        0, -1, 1, -32767, 32766, 12345, -12345, 256, -256,
+        std::numeric_limits<int16_t>::min() + 1,
+        std::numeric_limits<int16_t>::max() - 1,
+        0x1234, -0x1234,
+    };
+    const std::filesystem::path path = root / "mono.wav";
+    const Recording got = record_one(path, 22050u, 1, samples);
+    if (!check(got.problem.empty(), "a mono recording decodes",
+               got.problem)) {
+        return false;
+    }
+    bool ok = check_header("mono 22050 Hz", got.wav, 22050u, 1, samples.size());
+    ok = check(got.wav.payload == sample_bytes(samples),
+               "mono samples round-trip as little-endian 16-bit PCM",
+               compare_payload(got.wav.payload, samples)) &&
+         ok;
+    ok = check(sample_at(got.wav.payload, 0u) ==
+                   std::numeric_limits<int16_t>::min(),
+               "INT16_MIN round-trips as 0x8000", "") &&
+         ok;
+    ok = check(sample_at(got.wav.payload, 1u) ==
+                   std::numeric_limits<int16_t>::max(),
+               "INT16_MAX round-trips as 0x7FFF", "") &&
+         ok;
+    ok = check(got.file.size() == kHeaderBytes + 2u * samples.size(),
+               "the file is header plus two bytes per mono frame",
+               num(got.file.size()) + " bytes") &&
+         ok;
+    return ok;
+}
+
+// ---- 3. stereo interleaving ----------------------------------------------
+
+bool check_stereo(const std::filesystem::path& root) {
+    // Left ramps up and right ramps down, with the extremes first: a writer
+    // that de-interleaves, or that writes frames as blocks of left then right,
+    // permutes this into a payload that is still 16-bit PCM of the same length.
+    std::vector<int16_t> samples;
+    const std::size_t frames = 64u;
+    for (std::size_t i = 0; i < frames; ++i) {
+        samples.push_back(
+            static_cast<int16_t>(static_cast<int32_t>(i) * 500 - 16000));
+        samples.push_back(
+            static_cast<int16_t>(16000 - static_cast<int32_t>(i) * 500));
+    }
+    samples[0] = std::numeric_limits<int16_t>::min();
+    samples[1] = std::numeric_limits<int16_t>::max();
+    samples[2] = std::numeric_limits<int16_t>::max();
+    samples[3] = std::numeric_limits<int16_t>::min();
+
+    const std::filesystem::path path = root / "stereo.wav";
+    const Recording got = record_one(path, 32768u, 2, samples);
+    if (!check(got.problem.empty(), "a stereo recording decodes",
+               got.problem)) {
+        return false;
+    }
+    bool ok = check_header("stereo 32768 Hz", got.wav, 32768u, 2, frames);
+    ok = check(got.wav.byte_rate == 32768u * 4u,
+               "stereo byte rate is 131072", num(got.wav.byte_rate)) && ok;
+    ok = check(got.wav.block_align == 4u,
+               "stereo block align is 4 bytes", num(got.wav.block_align)) &&
+         ok;
+    ok = check(got.wav.payload == sample_bytes(samples),
+               "stereo samples round-trip interleaved",
+               compare_payload(got.wav.payload, samples)) &&
+         ok;
+    ok = check(sample_at(got.wav.payload, 0u) ==
+                   std::numeric_limits<int16_t>::min() &&
+                   sample_at(got.wav.payload, 1u) ==
+                       std::numeric_limits<int16_t>::max(),
+               "the first stereo frame is L=INT16_MIN R=INT16_MAX", "") &&
+         ok;
+    return ok;
+}
+
+// ---- 4. the maximum channel count ---------------------------------------
+
+bool check_channel_limit(const std::filesystem::path& root) {
+    // Eight channels is the documented maximum: two bytes per channel give a
+    // 16-byte block align, which is the field a writer that assumes stereo
+    // gets wrong.
+    std::vector<int16_t> samples;
+    const std::size_t frames = 9u;
+    for (std::size_t frame = 0; frame < frames; ++frame) {
+        for (int channel = 0; channel < NdsWavRecorder::kMaxChannels;
+             ++channel) {
+            samples.push_back(static_cast<int16_t>(
+                static_cast<int>(frame) * 1000 + channel * 100 -
+                static_cast<int>(frames) * 500));
+        }
+    }
+    const std::filesystem::path path = root / "eight.wav";
+    const Recording got =
+        record_one(path, 16000u, NdsWavRecorder::kMaxChannels, samples);
+    if (!check(got.problem.empty(), "an 8-channel recording decodes",
+               got.problem)) {
+        return false;
+    }
+    bool ok = check_header("8 channels", got.wav, 16000u,
+                           NdsWavRecorder::kMaxChannels, frames);
+    ok = check(got.wav.block_align == 16u,
+               "8 channels pack into a 16-byte block",
+               num(got.wav.block_align)) &&
+         ok;
+    ok = check(got.wav.byte_rate == 16000u * 16u,
+               "8 channels at 16 kHz need a 256000 byte rate",
+               num(got.wav.byte_rate)) &&
+         ok;
+    ok = check(got.wav.payload == sample_bytes(samples),
+               "the 8-channel payload round-trips",
+               compare_payload(got.wav.payload, samples)) &&
+         ok;
+    return ok;
+}
+
+// ---- 5. writes that cross 64 KiB ----------------------------------------
+
+bool check_large_writes(const std::filesystem::path& root) {
+    // Three writes of 20000 mono frames: 120000 payload bytes, so the 64 KiB
+    // boundary falls INSIDE the second write instead of between two calls,
+    // where an offset that forgets the header would not show.
+    std::vector<int16_t> samples(60000u);
+    for (std::size_t i = 0; i < samples.size(); ++i) {
+        samples[i] = static_cast<int16_t>(
+            static_cast<int32_t>(i % 65536u) - 32768);
+    }
+    const std::filesystem::path path = root / "long.wav";
+    NdsWavRecorder recorder;
+    if (!check(recorder.open(narrow(path), 22050u, 1),
+               "a recording spread over three writes opens",
+               recorder.last_error())) {
+        return false;
+    }
+    recorder.write(samples.data(), 20000u);
+    recorder.write(samples.data() + 20000u, 20000u);
+    recorder.write(samples.data() + 40000u, 20000u);
+    bool ok = check(recorder.frames_written() == samples.size(),
+                    "three writes count every frame",
+                    num(recorder.frames_written()) + ", wrote " +
+                        num(samples.size()));
+    ok = check(recorder.close(), "the multi-write recording closes",
+               recorder.last_error()) &&
+         ok;
+    if (!ok) return false;
+
+    Recording got;
+    if (!read_bytes(path, &got.file)) {
+        return check(false, "the multi-write recording is readable",
+                     "cannot read '" + narrow(path) + "'");
+    }
+    got.problem = decode_wav(got.file, &got.wav);
+    if (!check(got.problem.empty(), "the multi-write recording decodes",
+               got.problem)) {
+        return false;
+    }
+    ok = check_header("60000 mono frames", got.wav, 22050u, 1,
+                      samples.size());
+    ok = check(got.wav.payload == sample_bytes(samples),
+               "a payload past 64 KiB round-trips byte for byte",
+               compare_payload(got.wav.payload, samples)) &&
+         ok;
+
+    // One call of 70000 stereo frames is 280000 bytes, more than the recorder
+    // can hand to the stream in one request, so this exercises the internal
+    // splitting through a single write() call.
+    std::vector<int16_t> wide(70000u * 2u);
+    for (std::size_t frame = 0; frame < 70000u; ++frame) {
+        wide[frame * 2u] = static_cast<int16_t>(
+            static_cast<int32_t>(frame % 65536u) - 32768);
+        wide[frame * 2u + 1u] = static_cast<int16_t>(
+            32767 - static_cast<int32_t>(frame % 65536u));
+    }
+    const std::filesystem::path big = root / "big.wav";
+    const Recording huge = record_one(big, 48000u, 2, wide);
+    if (!check(huge.problem.empty(), "a single 280000-byte write decodes",
+               huge.problem)) {
+        return false;
+    }
+    ok = check_header("70000 stereo frames", huge.wav, 48000u, 2, 70000u);
+    ok = check(huge.wav.payload == sample_bytes(wide),
+               "a single large write keeps every sample in order",
+               compare_payload(huge.wav.payload, wide)) &&
+         ok;
+    return ok;
+}
+
+// ---- 6. the state machine ------------------------------------------------
+
+bool check_write_without_open(const std::filesystem::path& root) {
+    const int16_t samples[4] = {1, -1, 2, -2};
+    NdsWavRecorder recorder;
+    recorder.write(samples, 2u);
+    bool ok = check(!recorder.active(),
+                    "write() before open() leaves the recorder closed", "");
+    ok = check(recorder.frames_written() == 0u,
+               "write() before open() counts nothing",
+               num(recorder.frames_written())) &&
+         ok;
+    ok = check(recorder.last_error()[0] == '\0',
+               "write() before open() is not an error",
+               recorder.last_error()) &&
+         ok;
+    ok = check(recorder.close(),
+               "close() on a recorder that was never opened succeeds", "") &&
+         ok;
+    ok = check(!recorder.active(),
+               "a never-opened recorder stays inactive", "") &&
+         ok;
+    // Nothing may have been created anywhere.
+    std::error_code error;
+    ok = check(!std::filesystem::exists(root / "never.wav", error),
+               "a recorder that was never opened creates no file", "") &&
+         ok;
+    return ok;
+}
+
+bool check_double_open(const std::filesystem::path& root) {
+    const std::filesystem::path first = root / "first.wav";
+    const std::filesystem::path second = root / "second.wav";
+    const std::vector<int16_t> block = {100, -100, 200, -200};
+    NdsWavRecorder recorder;
+    bool ok = check(recorder.open(narrow(first), 22050u, 1),
+                    "a recording opens", recorder.last_error());
+    recorder.write(block.data(), 4u);
+    ok = check(recorder.frames_written() == 4u,
+               "the recording counts its frames",
+               num(recorder.frames_written())) &&
+         ok;
+    // A second open() would truncate the file being recorded, so the contract
+    // is that it is refused and the first recording continues untouched.
+    ok = check(!recorder.open(narrow(second), 44100u, 2),
+               "a second open() while recording is refused",
+               "open() returned true") &&
+         ok;
+    ok = check(std::string(recorder.last_error()).find("still open") !=
+                   std::string::npos,
+               "the refusal names the recording already open",
+               recorder.last_error()) &&
+         ok;
+    ok = check(recorder.active(),
+               "the refused open() leaves the first recording open", "") &&
+         ok;
+    recorder.write(block.data(), 4u);
+    ok = check(recorder.frames_written() == 8u,
+               "the first recording continues after the refusal",
+               num(recorder.frames_written())) &&
+         ok;
+    ok = check(recorder.close(),
+               "the first recording closes after the refusal",
+               recorder.last_error()) &&
+         ok;
+    ok = check(recorder.frames_written() == 8u,
+               "frames_written() is still readable after close()",
+               num(recorder.frames_written())) &&
+         ok;
+    std::error_code error;
+    ok = check(!std::filesystem::exists(second, error),
+               "the refused open() creates no second file", "") &&
+         ok;
+
+    std::vector<uint8_t> file;
+    if (!read_bytes(first, &file)) {
+        return check(false, "the recording after the refusal is readable",
+                     "cannot read '" + narrow(first) + "'");
+    }
+    DecodedWav wav;
+    const std::string problem = decode_wav(file, &wav);
+    ok = check(problem.empty(),
+               "the recording after the refusal decodes", problem) &&
+         ok;
+    if (problem.empty()) {
+        ok = check(wav.sample_rate == 22050u && wav.channels == 1u,
+                   "the refused open() did not rewrite the format",
+                   num(wav.sample_rate) + " Hz, " + num(wav.channels) +
+                       " channel(s)") &&
+             ok;
+        ok = check(wav.data_size == 16u,
+                   "the first recording holds both writes",
+                   num(wav.data_size) + " payload byte(s)") &&
+             ok;
+    }
+    ok = check(recorder.close(),
+               "close() twice repeats the same answer", "") &&
+         ok;
+    ok = check(!recorder.active(),
+               "a closed recorder is inactive", "") &&
+         ok;
+    return ok;
+}
+
+bool check_reopen_truncates(const std::filesystem::path& root) {
+    // A second recording into the same path must not leave the tail of the
+    // first one behind: that is the failure a plain "seek to 0 and write" gets
+    // wrong while the header still looks consistent.
+    const std::filesystem::path path = root / "reuse.wav";
+    const std::vector<int16_t> long_run = {1, 2, 3, 4, 5, 6, 7, 8};
+    const Recording first = record_one(path, 22050u, 2, long_run);
+    if (!check(first.problem.empty(), "the first recording of a reused path",
+               first.problem)) {
+        return false;
+    }
+    const Recording second = record_one(path, 8000u, 1, {42});
+    if (!check(second.problem.empty(), "the second recording of that path",
+               second.problem)) {
+        return false;
+    }
+    bool ok = check(second.file.size() == kHeaderBytes + 2u,
+                    "reopening truncates the older, longer recording",
+                    num(second.file.size()) + " bytes");
+    ok = check(second.wav.data_size == 2u,
+               "the reused file describes only the new payload",
+               num(second.wav.data_size) + " payload byte(s)") &&
+         ok;
+    ok = check(second.wav.sample_rate == 8000u && second.wav.channels == 1u,
+               "the reused file carries the new format",
+               num(second.wav.sample_rate) + " Hz, " +
+                   num(second.wav.channels) + " channel(s)") &&
+         ok;
+    return ok;
+}
+
+bool check_latched_write(const std::filesystem::path& root) {
+    // A null sample buffer with frames to write is a caller bug that would
+    // otherwise drop a block of audio silently, so write() latches the
+    // recording shut -- but the file it leaves behind is still a valid 0-frame
+    // WAV and close() reports the loss.
+    const std::filesystem::path path = root / "latch.wav";
+    const int16_t block[4] = {10, -10, 20, -20};
+    NdsWavRecorder recorder;
+    bool ok = check(recorder.open(narrow(path), 22050u, 2),
+                    "the recording that will lose a write opens",
+                    recorder.last_error());
+    if (!ok) return false;
+    recorder.write(nullptr, 8u);
+    ok = check(std::string(recorder.last_error()).find("null") !=
+                   std::string::npos,
+               "a null sample buffer is refused",
+               recorder.last_error()) &&
+         ok;
+    ok = check(recorder.active(),
+               "a refused write leaves the file open", "") &&
+         ok;
+    ok = check(recorder.frames_written() == 0u,
+               "a refused write counts no frames",
+               num(recorder.frames_written())) &&
+         ok;
+    recorder.write(block, 2u);
+    ok = check(recorder.frames_written() == 0u,
+               "writes after a latch are ignored, not appended",
+               num(recorder.frames_written())) &&
+         ok;
+    ok = check(!recorder.close(),
+               "close() reports a recording that lost samples",
+               "close() returned true") &&
+         ok;
+    ok = check(std::string(recorder.last_error()).find("null") !=
+                   std::string::npos,
+               "close() leaves the first failure text in place",
+               recorder.last_error()) &&
+         ok;
+    std::vector<uint8_t> file;
+    if (!read_bytes(path, &file)) {
+        return check(false, "the latched recording is readable",
+                     "cannot read '" + narrow(path) + "'");
+    }
+    DecodedWav wav;
+    const std::string problem = decode_wav(file, &wav);
+    ok = check(problem.empty(),
+               "the latched recording is still a valid WAV", problem) &&
+         ok;
+    if (problem.empty()) {
+        ok = check(wav.data_size == 0u,
+                   "the latched recording holds an empty payload",
+                   num(wav.data_size) + " payload byte(s)") &&
+             ok;
+    }
+    return ok;
+}
+
+bool check_no_op_writes(const std::filesystem::path& root) {
+    const int16_t block[4] = {7, -7, 8, -8};
+    NdsWavRecorder recorder;
+    bool ok = check(recorder.open(narrow(root / "noop.wav"), 22050u, 1),
+                    "the recording for the no-op writes opens",
+                    recorder.last_error());
+    if (!ok) return false;
+    recorder.write(block, 0u);
+    ok = check(recorder.frames_written() == 0u,
+               "write() of 0 frames counts nothing",
+               num(recorder.frames_written())) &&
+         ok;
+    ok = check(recorder.last_error()[0] == '\0',
+               "write() of 0 frames is not an error",
+               recorder.last_error()) &&
+         ok;
+    // A null buffer is fine when there are no frames to read from it.
+    recorder.write(nullptr, 0u);
+    ok = check(recorder.frames_written() == 0u &&
+                   recorder.last_error()[0] == '\0',
+               "a null buffer with 0 frames is still a no-op",
+               std::string("frames ") + num(recorder.frames_written()) +
+                   ", error '" + recorder.last_error() + "'") &&
+         ok;
+    ok = check(recorder.close(), "the no-op recording closes",
+               recorder.last_error()) &&
+         ok;
+    return ok;
+}
+
+// ---- 7. rejected arguments ----------------------------------------------
+
+bool check_rejections(const std::filesystem::path& root) {
+    const std::string good = narrow(root / "rejected.wav");
+    const std::string blocked = narrow(root / "blocker" / "rejected.wav");
+    const std::string directory = narrow(root / "a-directory");
+    {
+        std::ofstream blocker(root / "blocker", std::ios::binary);
+        blocker << "not a directory\n";
+        std::error_code error;
+        std::filesystem::create_directories(root / "a-directory", error);
+    }
+
+    struct Case {
+        const char* name;
+        std::string path;
+        uint32_t rate;
+        int channels;
+    };
+    const Case cases[] = {
+        {"an empty path", "", 22050u, 1},
+        {"a zero sample rate", good, 0u, 1},
+        {"0 channels", good, 22050u, 0},
+        {"negative channels", good, 22050u, -1},
+        {"too many channels", good, 22050u,
+         NdsWavRecorder::kMaxChannels + 1},
+        {"a byte rate past 32 bits", good, 0xF0000000u,
+         NdsWavRecorder::kMaxChannels},
+        {"a destination whose parent is a file", blocked, 22050u, 1},
+        {"a directory as the destination", directory, 22050u, 1},
+    };
+    bool ok = true;
+    for (const Case& rejection : cases) {
+        NdsWavRecorder recorder;
+        const std::string label =
+            std::string("rejects ") + rejection.name;
+        const bool opened = recorder.open(rejection.path, rejection.rate,
+                                          rejection.channels);
+        if (!check(!opened, label.c_str(), "open() returned true")) {
+            // A broken writer may well have created something; leave the file
+            // alone and keep going so the remaining cases still report.
+            ok = false;
+            continue;
+        }
+        ok = check(!recorder.active(),
+                   (label + " and stays closed").c_str(), "") &&
+             ok;
+        const std::string reason = recorder.last_error();
+        ok = check(!reason.empty(), (label + " with a reason").c_str(),
+                   "open() returned false but left last_error() empty") &&
+             ok;
+        ok = check(recorder.close(),
+                   (label + " leaves a reusable recorder").c_str(),
+                   "close() after a refused open() returned false") &&
+             ok;
+    }
+    // A refused open() must not leave a stray file behind, and the error text
+    // for the two interesting filesystem cases must name the cause.
+    std::error_code error;
+    ok = check(!std::filesystem::exists(good, error),
+               "a refused open() creates no file",
+               "'" + good + "' exists") &&
+         ok;
+    {
+        NdsWavRecorder recorder;
+        (void)recorder.open(blocked, 22050u, 1);
+        const std::string reason = recorder.last_error();
+        ok = check(reason.find("cannot create the directory") !=
+                       std::string::npos,
+                   "the blocked parent is named in the error", reason) &&
+             ok;
+    }
+    {
+        NdsWavRecorder recorder;
+        (void)recorder.open(directory, 22050u, 1);
+        const std::string reason = recorder.last_error();
+        ok = check(reason.find("cannot open recording file") !=
+                       std::string::npos,
+                   "an unwritable destination is named in the error",
+                   reason) &&
+             ok;
+    }
+    // A refused open() must not poison the recorder: the next good open works
+    // and clears the error text.
+    {
+        NdsWavRecorder recorder;
+        (void)recorder.open("", 22050u, 1);
+        ok = check(recorder.open(good, 22050u, 1),
+                   "a recorder rejected once can still open",
+                   recorder.last_error()) &&
+             ok;
+        ok = check(recorder.last_error()[0] == '\0',
+                   "a successful open() clears the error text",
+                   recorder.last_error()) &&
+             ok;
+        ok = check(recorder.close(), "that recording closes",
+                   recorder.last_error()) &&
+             ok;
+    }
+    return ok;
+}
+
+// ---- 8. UTF-8 paths -----------------------------------------------------
+
+bool check_utf8_path(const std::filesystem::path& root) {
+    // "café-ü/nested/rec.wav" spelled as UTF-8. The ASCII root is used to list
+    // the directory, so the check reads the bytes that actually reached the
+    // disk instead of trusting a conversion in the test.
+    const std::string directory = "caf\xC3\xA9-\xC3\xBC";
+    const std::string root_text = narrow(root);
+    const std::string wanted =
+        root_text + "/" + directory + "/nested/rec.wav";
+    NdsWavRecorder recorder;
+    const std::vector<int16_t> samples = {-32768, 32767, 0, 1};
+    if (!check(recorder.open(wanted, 22050u, 2),
+               "a UTF-8 path opens", recorder.last_error())) {
+        return false;
+    }
+    recorder.write(samples.data(), 2u);
+    bool ok = check(recorder.close(), "the UTF-8 recording closes",
+                    recorder.last_error());
+
+    std::error_code error;
+    std::filesystem::path family;
+    std::filesystem::path nested;
+    for (const std::filesystem::directory_entry& entry :
+         std::filesystem::directory_iterator(root, error)) {
+        if (utf8_name(entry.path()) == directory) {
+            family = entry.path();
+            break;
+        }
+    }
+    ok = check(!family.empty(),
+               "the UTF-8 directory name appears byte for byte", wanted) &&
+         ok;
+    if (family.empty()) return ok;
+    for (const std::filesystem::directory_entry& entry :
+         std::filesystem::directory_iterator(family, error)) {
+        if (utf8_name(entry.path()) == "nested") {
+            nested = entry.path();
+            break;
+        }
+    }
+    ok = check(!nested.empty(),
+               "the parent directories below the UTF-8 name are created",
+               narrow(family)) &&
+         ok;
+    if (nested.empty()) return ok;
+    std::filesystem::path file_path;
+    for (const std::filesystem::directory_entry& entry :
+         std::filesystem::directory_iterator(nested, error)) {
+        if (utf8_name(entry.path()) == "rec.wav") {
+            file_path = entry.path();
+            break;
+        }
+    }
+    ok = check(!file_path.empty(),
+               "the UTF-8 recording file is created", narrow(nested)) &&
+         ok;
+    if (file_path.empty()) return ok;
+
+    std::vector<uint8_t> file;
+    if (!read_bytes(file_path, &file)) {
+        return check(false, "the UTF-8 recording is readable",
+                     "cannot read the file under '" + narrow(nested) + "'");
+    }
+    DecodedWav wav;
+    const std::string problem = decode_wav(file, &wav);
+    ok = check(problem.empty(), "the UTF-8 recording decodes", problem) && ok;
+    if (problem.empty()) {
+        ok = check(wav.payload == sample_bytes(samples),
+                   "the UTF-8 recording holds the same payload",
+                   compare_payload(wav.payload, samples)) &&
+             ok;
+    }
+    return ok;
+}
+
+// ---- scratch tree -------------------------------------------------------
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// tried first -- which is what TMP/TEMP override -- but a sandboxed run can
+// refuse writes there because the process working directory sits inside the
+// tree under test, so the working directory is tried second. Returns false only
+// when neither location can hold the tree, and then names both paths and both
+// reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line naming both candidates stays
+    // unambiguous even when TEMP and the working directory are the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     narrow(temp_path).c_str(), note.c_str(),
+                     narrow(*root).c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 narrow(temp_path).c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 narrow(cwd_path).c_str(), cwd_reason.c_str());
+    return false;
+}
+
+// ---- the run -----------------------------------------------------------
+
+int run_checks(const std::filesystem::path& root) {
+    // The decoder must be shown to reject a damaged file before its verdict on
+    // a good one means anything, so the controls come first.
+    if (!check_decoder_controls(root)) return g_first_failure;
+
+    check_zero_frames(root);
+    check_mono(root);
+    check_stereo(root);
+    check_channel_limit(root);
+    check_large_writes(root);
+    check_write_without_open(root);
+    check_double_open(root);
+    check_reopen_truncates(root);
+    check_latched_write(root);
+    check_no_op_writes(root);
+    check_rejections(root);
+    check_utf8_path(root);
+    return g_failures == 0 ? 0 : g_first_failure;
+}
+
+}  // namespace
+
+int main() {
+    const auto ticks =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    std::filesystem::path root;
+    if (!create_root("nds-audio-capture-test", std::to_string(ticks), &root))
+        return 1;
+
+    const int result = run_checks(root);
+    std::error_code ignored;
+    std::filesystem::remove_all(root, ignored);
+    if (result != 0) {
+        std::fprintf(stderr, "%d of %d check(s) passed before the failure\n",
+                     g_checks - g_failures, g_checks);
+        return result;
+    }
+    std::printf("%d checks passed\n", g_checks);
+    return 0;
+}
diff --git a/runner/tests/cart_rom_test.cpp b/runner/tests/cart_rom_test.cpp
new file mode 100644
index 0000000..a9211b8
--- /dev/null
+++ b/runner/tests/cart_rom_test.cpp
@@ -0,0 +1,127 @@
+// Exercise the production loader, B7 response preparation and data-word
+// extraction with synthetic images. Including io.cpp follows gpu2d_window_test;
+// dead-section elimination keeps unrelated devices out of this focused test.
+#include "../src/io.cpp"
+
+#include <array>
+
+namespace {
+int failures = 0;
+
+void check(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        ++failures;
+    }
+}
+
+bool load_image(const std::vector<uint8_t>& image) {
+    const std::array<uint8_t, 0x30u + 0x412u * 4u> synthetic_bios{};
+    return nds_io_load_cartridge(image.data(), static_cast<uint32_t>(image.size()),
+                                 synthetic_bios.data(), synthetic_bios.size());
+}
+
+void command(uint8_t opcode, uint32_t address, uint32_t length = 4u) {
+    // Skip the encrypted boot handshake, as direct boot does. The B7 address
+    // decoder, ROM copy and word extraction are all the production functions.
+    g_card_mode = CardCommandMode::Normal;
+    std::memset(g_card_command, 0, sizeof(g_card_command));
+    g_card_command[0] = opcode;
+    g_card_command[1] = static_cast<uint8_t>(address >> 24u);
+    g_card_command[2] = static_cast<uint8_t>(address >> 16u);
+    g_card_command[3] = static_cast<uint8_t>(address >> 8u);
+    g_card_command[4] = static_cast<uint8_t>(address);
+    g_card_transfer_len = length;
+    card_prepare_response();
+}
+
+void expect_read(uint32_t address, uint32_t expected, const char* message) {
+    command(0xB7u, address);
+    const uint32_t actual = card_response_word(0);
+    if (actual != expected) {
+        std::fprintf(stderr, "B7 %08X: got %08X, expected %08X\n",
+                     address, actual, expected);
+    }
+    check(actual == expected, message);
+}
+
+void test_trimmed_image() {
+    constexpr uint32_t size = 0x039CAA74u;
+    constexpr uint32_t capacity = 0x04000000u;
+    std::vector<uint8_t> image(size, 0xA5u);
+    image[9] = 9;  // 64 MiB header capacity; data below is entirely synthetic.
+    store_le32(image.data() + 0x118600u, 0x12345678u);
+    store_le32(image.data() + 0x108200u, 0xDEADBEEFu);
+    store_le32(image.data() + 0x2C8800u, 0x87654321u);
+    store_le32(image.data() + 0x0C8800u, 0xCAFEBABEu);
+    store_le32(image.data() + 0x100A00u, 0x13579BDFu);
+    store_le32(image.data() + 0x8000u, 0x2468ACE0u);
+    store_le32(image.data() + size - 4u, 0xABCDEF01u);
+    check(load_image(image), "trimmed image loads");
+    check(g_card_rom.size() == capacity, "trimmed image has power-of-two capacity");
+    expect_read(0x118600u, 0x12345678u, "valid file offset retains address bits");
+    expect_read(0x2C8800u, 0x87654321u, "second valid offset does not alias lower ROM");
+    expect_read(0x100A00u, 0x13579BDFu, "previously unaffected offset stays correct");
+    expect_read(size - 4u, 0xABCDEF01u, "last file word is preserved");
+    expect_read(size, 0, "first padded word is zero");
+    expect_read(capacity - 4u, 0, "last capacity word is zero");
+    expect_read(capacity + 0x118600u, 0x12345678u, "address wraps at chip capacity");
+    expect_read(capacity, 0x2468ACE0u, "wrapped low address retains B7 remapping");
+
+    command(0xB7u, 0x039CAA00u, 0x200u);
+    for (uint32_t pos = 0; pos < 0x200u; pos += 4u) {
+        const uint32_t expected = pos < 0x70u ? 0xA5A5A5A5u :
+                                  pos == 0x70u ? 0xABCDEF01u : 0u;
+        check(card_response_word(pos) == expected,
+              "sector crossing trimmed EOF preserves data then returns zero padding");
+    }
+    command(0xB8u, 0);
+    check(card_response_word(0) == 0x00003FC2u,
+          "B8 chip ID reports padded 64 MiB capacity");
+    check(nds_cart_chip_id() == 0x00003FC2u,
+          "direct-boot chip ID agrees with B8");
+}
+
+void test_power_of_two_image() {
+    constexpr uint32_t size = 0x00200000u;
+    std::vector<uint8_t> image(size, 0x5Au);
+    store_le32(image.data() + 0x118600u, 0x11223344u);
+    store_le32(image.data() + size - 4u, 0x55667788u);
+    check(load_image(image), "power-of-two image loads after trimmed image");
+    check(g_card_rom.size() == size, "power-of-two capacity stays unchanged");
+    expect_read(0x118600u, 0x11223344u, "power-of-two read is unchanged");
+    expect_read(size - 4u, 0x55667788u, "power-of-two last word is unchanged");
+    expect_read(size + 0x118600u, 0x11223344u, "power-of-two wrap is unchanged");
+    command(0xB8u, 0);
+    check(card_response_word(0) == 0x000001C2u, "power-of-two chip ID is unchanged");
+}
+void test_unaligned_trimmed_tail() {
+    // Reload at the same rounded capacity: old cartridge bytes must not leak
+    // into the new padding. Also cover a partial final data-port word.
+    constexpr uint32_t size = 0x00100003u;
+    std::vector<uint8_t> image(size, 0x3Cu);
+    check(load_image(image), "unaligned trimmed image loads");
+    check(g_card_rom.size() == 0x00200000u, "unaligned image rounds upward");
+    expect_read(0x00100000u, 0x003C3C3Cu, "partial final word is zero-padded");
+    expect_read(0x00118600u, 0, "reload clears previous image bytes from padding");
+    command(0xB8u, 0);
+    check(card_response_word(0) == 0x000001C2u, "unaligned image uses rounded chip ID");
+}
+
+void test_capacity_overflow_rejected() {
+    const std::array<uint8_t, 0x200u> image{};
+    const std::array<uint8_t, 0x30u + 0x412u * 4u> synthetic_bios{};
+    check(!nds_io_load_cartridge(image.data(), 0x80000001u,
+                                 synthetic_bios.data(), synthetic_bios.size()),
+          "unrepresentable rounded capacity rejected before reading input");
+    check(g_card_rom.empty(), "rejected image leaves cartridge absent");
+}
+} // namespace
+
+int main() {
+    test_trimmed_image();
+    test_power_of_two_image();
+    test_unaligned_trimmed_tail();
+    test_capacity_overflow_rejected();
+    return failures ? 1 : 0;
+}
diff --git a/runner/tests/color_grade_test.cpp b/runner/tests/color_grade_test.cpp
new file mode 100644
index 0000000..470affc
--- /dev/null
+++ b/runner/tests/color_grade_test.cpp
@@ -0,0 +1,1768 @@
+// Pins the colour-grade contract (color_grade.h).
+//
+// A grade is the easiest thing in the port to get wrong and still like: an
+// interpolation whose weights are slightly off, a table read in the wrong node
+// order or a mapping that skips the file's own input range all produce a
+// picture that a player would describe as "fine, maybe". So the pins here are
+// exact ARGB values, computed from the .cube semantics by hand and by an
+// independent reimplementation, and every table is small enough that a reader
+// can check the arithmetic without a debugger.
+//
+// The four traps this file is built around:
+//
+//   * The sampler's node order. .cube stores red fastest, so node (r, g, b)
+//     sits at ((b * size) + g) * size + r. A transposed or g-fastest read of
+//     the same table passes a "does it still return large numbers" test and
+//     fails every pinned pixel here.
+//   * The three-axis interpolation. Dropping one axis weight, or blending the
+//     axes in the other order, leaves a table that is right at the corners and
+//     wrong in the middle -- which is why the size-3 and size-5 fixtures are
+//     pinned at pixels that sit between nodes, and the size-3 rotation fixture
+//     is a table whose every channel reads a different axis.
+//   * Rounding. Round half away from zero is worth a whole level per tie, and
+//     ties are chosen on purpose: the "half" table maps an input of 1 to
+//     exactly 0.5, so a truncating sampler returns 0 where the pin says 1.
+//   * The parser's strictness. A file with a short table, an unknown directive
+//     or two size directives must be refused with a diagnostic naming the
+//     problem, because the alternative -- a table that loads and grades with
+//     half its nodes missing -- is a silent global colour shift.
+//
+// The buffer contract is pinned like display_filters_test.cpp pins its own: a
+// rejected call must leave the caller's surface untouched, a padded row's tail
+// must not be written, and in-place application must equal out-of-place
+// application bit for bit.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and every failure prints its own name and
+// actual value, so a failure names itself without a debugger.
+
+#include "color_grade.h"
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <system_error>
+#include <vector>
+
+// The header's promises about its constants are part of the settings file's
+// vocabulary, so they are pinned at compile time rather than only compared at
+// runtime.
+static_assert(nds_color_grade::kMinLutSize == 2, "two nodes minimum");
+static_assert(nds_color_grade::kMaxLutSize == 64, "64 nodes maximum");
+static_assert(nds_color_grade::kDefaultStrength == 100, "full by default");
+static_assert(nds_color_grade::kIdentityLutSize == 2, "identity size");
+
+namespace {
+
+using nds_color_grade::apply_lut;
+using nds_color_grade::identity_lut;
