+bool write_text(const std::filesystem::path& path, const std::string& text) {
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.flush();
+    return out.good();
+}
+
+// Writes `text` as the fixture file at `path` and loads it back. A fixture that
+// cannot be written reports through `error` rather than aborting, so a
+// permission problem is one failing check and not a dead run.
+bool load_text(const std::filesystem::path& path, const std::string& text,
+               NdsColorLut* lut, std::string* error) {
+    if (!write_text(path, text)) {
+        *error = "the test could not write its own fixture";
+        return false;
+    }
+    return load_cube(narrow(path), lut, error);
+}
