+std::string describe_pin(const PinCase& pin) {
+    return std::string("canvas ") + number(pin.canvas_width) + "x" +
+           number(pin.canvas_height) + " valid " +
+           (pin.valid ? "true" : "false") + " scale " +
+           number(pin.native_scale) + " unused " +
+           number(pin.unused_canvas_pixels) + " top " + rect_text(pin.top) +
+           " bottom " + rect_text(pin.bottom);
+}
