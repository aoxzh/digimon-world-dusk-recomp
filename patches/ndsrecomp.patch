+// ---------------------------------------------------------------------------
+// Names and parsing
+// ---------------------------------------------------------------------------
+
+void check_names() {
+    const struct {
+        NdsScreenLayoutKind kind;
+        const char* text;
+    } kNamed[] = {
+        {kNdsLayoutStacked, "stacked"},
+        {kNdsLayoutSideBySide, "side-by-side"},
+        {kNdsLayoutTopOnly, "top"},
+        {kNdsLayoutBottomOnly, "bottom"},
+        {kNdsLayoutSquare, "square"},
+    };
+    for (const auto& entry : kNamed) {
+        const std::string got = layout_name(entry.kind);
+        check(got == entry.text, std::string("layout_name is ") + entry.text,
+              "got \"" + got + "\"");
+    }
+
+    // Out of range is not an error: every entry point is total, and the
+    // fallback is the shipped default.
+    const int kOutOfRange[] = {-1, 5, 99, -2147483647 - 1};
+    for (int raw : kOutOfRange) {
+        const NdsScreenLayoutKind kind =
+            static_cast<NdsScreenLayoutKind>(raw);
+        const std::string got = layout_name(kind);
+        check(got == "stacked", "layout_name falls back for " + number(raw),
+              "got \"" + got + "\"");
+    }
+}
+
+void check_parse() {
+    const struct {
+        const char* text;
+        NdsScreenLayoutKind kind;
+    } kGood[] = {
+        {"stacked", kNdsLayoutStacked},
+        {"side-by-side", kNdsLayoutSideBySide},
+        {"top", kNdsLayoutTopOnly},
+        {"bottom", kNdsLayoutBottomOnly},
+        {"square", kNdsLayoutSquare},
+        {"sidebyside", kNdsLayoutSideBySide},
+        {"side_by_side", kNdsLayoutSideBySide},
+        {"SideBySide", kNdsLayoutSideBySide},
+        {"SIDE_BY_SIDE", kNdsLayoutSideBySide},
+        {"Side-By-Side", kNdsLayoutSideBySide},
+        {"SIDE-BY-SIDE", kNdsLayoutSideBySide},
+        {"STACKED", kNdsLayoutStacked},
+        {"Top", kNdsLayoutTopOnly},
+        {"bOtToM", kNdsLayoutBottomOnly},
+        {"SqUaRe", kNdsLayoutSquare},
+    };
+    for (const auto& entry : kGood) {
+        NdsScreenLayoutKind parsed = kNdsLayoutKindCount;
+        const bool accepted = layout_parse(entry.text, &parsed);
+        check(accepted && parsed == entry.kind,
+              std::string("layout_parse accepts \"") + entry.text + "\"",
+              accepted ? "parsed a different kind"
+                       : "rejected a valid token");
+    }
+
+    // Junk must be refused and must leave the caller's value alone, so a
+    // corrupt line in the settings file cannot reset the layout.
+    const char* kJunk[] = {
+        "",          "stack",     "side by side", "side-by-side ",
+        " side-by-side", "sidebysidee", "top only",  "tos",
+        "square ",   "SQ",        "0",            "-1",
+    };
+    for (const char* text : kJunk) {
+        NdsScreenLayoutKind parsed = kNdsLayoutSquare;
+        const bool accepted = layout_parse(text, &parsed);
+        check(!accepted && parsed == kNdsLayoutSquare,
+              std::string("layout_parse rejects \"") + text + "\"",
+              accepted ? "accepted a junk token"
+                       : "clobbered the caller's value");
+    }
+
+    NdsScreenLayoutKind parsed = kNdsLayoutTopOnly;
+    check(!layout_parse(nullptr, &parsed) && parsed == kNdsLayoutTopOnly,
+          "layout_parse rejects a null string", "accepted or wrote through");
+    check(!layout_parse("stacked", nullptr),
+          "layout_parse rejects a null out pointer", "accepted a null out");
+}
+
+void check_single_window() {
+    const struct {
+        NdsScreenLayoutKind kind;
+        bool single;
+    } kExpected[] = {
+        {kNdsLayoutStacked, false},
+        {kNdsLayoutSideBySide, false},
+        {kNdsLayoutTopOnly, true},
+        {kNdsLayoutBottomOnly, true},
+        {kNdsLayoutSquare, false},
+    };
+    for (const auto& entry : kExpected) {
+        const bool got = layout_is_single_window(entry.kind);
+        check(got == entry.single,
+              std::string("layout_is_single_window for ") +
+                  layout_name(entry.kind),
+              got ? "reported single" : "reported two-window");
+    }
+    check(!layout_is_single_window(static_cast<NdsScreenLayoutKind>(-1)),
+          "layout_is_single_window falls back for -1", "reported single");
+    check(!layout_is_single_window(static_cast<NdsScreenLayoutKind>(99)),
+          "layout_is_single_window falls back for 99", "reported single");
+}
