+                ++host_touch_presses;
+                last_touch_event_x = event.button.x;
+                last_touch_event_y = event.button.y;
+                touch_release_pending = false;
+                touch_frames_held = 0;
+                set_touch_from_geometry(event.button.x, event.button.y, true,
