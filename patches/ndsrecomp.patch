+// Pins the screen-layout geometry (screen_layouts.h).
+//
+// The module exists because a wrong layout still looks like a picture: a top
+// screen half a pixel too high is a screenshot, not a crash. So this test pins
+// numbers first and properties second.
+//
+// 1. Hand pins: every layout on every canvas the frontend is likely to meet, in
+//    both scaling modes, against values computed independently -- a small model
+//    of the specification written separately from the implementation and diffed
+//    against it over 880 canvas/layout/mode/swap combinations before this file
+//    existed. The arithmetic for one row per layout is written out in the
+//    comment above the table, so a reader can check five of them by hand.
+// 2. The contract as loops: every rectangle inside the canvas, no two
+//    rectangles overlapping, 4:3 to within a pixel, the block centred with the
+//    odd pixel on the right/bottom, and unused_canvas_pixels always the exact
+//    complement of the rectangles actually used.
+// 3. The API contract: names round-trip (including the aliases a hand-edited
+//    settings file produces), junk is rejected without touching the caller's
+//    value, every entry point stays total for out-of-range enum values, and
+//    layout_min_canvas() agrees with compute_layout() at the exact boundary --
+//    the minimum is valid, one pixel less is not.
+// 4. Determinism, and the exact calls the frontend makes, pinned verbatim so a
+//    change here is caught as a diff instead of discovered as a moved picture.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and a failure prints the value it got and the
+// value it expected, so a failure names itself without a debugger.
+
+#include "screen_layouts.h"
+
+#include <cstdio>
+#include <string>
+
+// The enum values are persisted to disk and read back by an out-of-date binary,
+// so their numeric identity is part of the contract, not an implementation
+// detail.
+static_assert(nds_screen_layout::kNativeScreenWidth == 256, "screen width");
+static_assert(nds_screen_layout::kNativeScreenHeight == 192, "screen height");
+static_assert(nds_screen_layout::kMaxCanvasDimension == 16384, "canvas cap");
+static_assert(nds_screen_layout::kNdsScreenTop == 0, "top slot is 0");
+static_assert(nds_screen_layout::kNdsScreenBottom == 1, "bottom slot is 1");
+static_assert(nds_screen_layout::kNdsLayoutStacked == 0, "stacked is 0");
+static_assert(nds_screen_layout::kNdsLayoutSideBySide == 1,
+              "side by side is 1");
+static_assert(nds_screen_layout::kNdsLayoutTopOnly == 2, "top only is 2");
+static_assert(nds_screen_layout::kNdsLayoutBottomOnly == 3, "bottom only is 3");
+static_assert(nds_screen_layout::kNdsLayoutSquare == 4, "square is 4");
+static_assert(nds_screen_layout::kNdsLayoutKindCount == 5, "five layouts");
+
+namespace {
+
+using nds_screen_layout::compute_layout;
+using nds_screen_layout::kMaxCanvasDimension;
+using nds_screen_layout::kNativeScreenHeight;
+using nds_screen_layout::kNativeScreenWidth;
+using nds_screen_layout::kNdsLayoutBottomOnly;
+using nds_screen_layout::kNdsLayoutKindCount;
+using nds_screen_layout::kNdsLayoutSideBySide;
+using nds_screen_layout::kNdsLayoutSquare;
+using nds_screen_layout::kNdsLayoutStacked;
+using nds_screen_layout::kNdsLayoutTopOnly;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::NdsScreenLayoutKind;
+using nds_screen_layout::NdsScreenLayoutResult;
+using nds_screen_layout::NdsScreenRect;
+using nds_screen_layout::kNdsScreenTop;
+using nds_screen_layout::layout_is_single_window;
+using nds_screen_layout::layout_min_canvas;
+using nds_screen_layout::layout_name;
+using nds_screen_layout::layout_parse;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const std::string& what,
+           const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what.c_str());
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::fprintf(stderr, "FAIL %s\n     %s\n", what.c_str(), detail.c_str());
+    return false;
+}
+
+std::string number(int value) {
+    return std::to_string(value);
+}
+
+std::string rect_text(const NdsScreenRect& rect) {
+    return "{" + number(rect.x) + ", " + number(rect.y) + ", " +
+           number(rect.width) + ", " + number(rect.height) + "}";
+}
+
+bool rects_equal(const NdsScreenRect& left, const NdsScreenRect& right) {
+    return left.x == right.x && left.y == right.y &&
+           left.width == right.width && left.height == right.height;
+}
+
+std::string describe(const NdsScreenLayoutResult& result) {
+    return std::string("canvas ") + number(result.canvas_width) + "x" +
+           number(result.canvas_height) + " valid " +
+           (result.valid ? "true" : "false") + " scale " +
+           number(result.native_scale) + " unused " +
+           number(result.unused_canvas_pixels) + " top " +
+           rect_text(result.rects[kNdsScreenTop]) + " bottom " +
+           rect_text(result.rects[kNdsScreenBottom]);
+}
+
+// ---------------------------------------------------------------------------
+// Expected layout shapes, stated independently of the implementation
+// ---------------------------------------------------------------------------
+
+// The block each layout occupies at native scale 1. Square's cell is a 256x256
+// tile, so it needs 512x256 rather than 512x192 and its scale is bounded by a
+// taller reference -- which is the whole reason it exists as its own layout.
+struct ExpectedShape {
+    int columns;
+    int rows;
+    int cell_height;
+};
+
+const ExpectedShape kShapes[kNdsLayoutKindCount] = {
+    {1, 2, kNativeScreenHeight},  // stacked: top above bottom
+    {2, 1, kNativeScreenHeight},  // side by side
+    {1, 1, kNativeScreenHeight},  // top only
+    {1, 1, kNativeScreenHeight},  // bottom only
+    {2, 1, kNativeScreenWidth},   // square: a 256x256 tile per screen
+};
+
+int block_width(int index) {
+    return kShapes[index].columns * kNativeScreenWidth;
+}
+
+int block_height(int index) {
+    return kShapes[index].rows * kShapes[index].cell_height;
+}
+
+// The largest whole scale that fits, which is also the floor of the fractional
+// scale and the value reported in native_scale.
+int whole_scale(int index, int canvas_width, int canvas_height) {
+    const int fit_w = canvas_width / block_width(index);
+    const int fit_h = canvas_height / block_height(index);
+    return fit_w < fit_h ? fit_w : fit_h;
+}
+
+bool request_is_valid(int index, int canvas_width, int canvas_height) {
+    if (canvas_width <= 0 || canvas_height <= 0) return false;
+    if (canvas_width > kMaxCanvasDimension) return false;
+    if (canvas_height > kMaxCanvasDimension) return false;
+    return whole_scale(index, canvas_width, canvas_height) >= 1;
+}
+
+// ---------------------------------------------------------------------------
+// Hand pins
+// ---------------------------------------------------------------------------
+//
+// Worked out by hand, one per layout, so the table below is checkable rather
+// than merely recorded.
+//
+//   stacked 800x600, integer
+//     block 256x384; scale = min(800/256, 600/384) = min(3, 1) = 1;
+//     cell 256x192; used 256x384; origin (800-256)/2 = 272,
+//     (600-384)/2 = 108; top {272, 108, 256, 192},
+//     bottom {272, 108+192, 256, 192}; unused 480000 - 98304 = 381696.
+//
+//   side-by-side 1280x720, integer
+//     block 512x192; scale = min(1280/512, 720/192) = min(2, 3) = 2;
+//     cell 512x384; used 1024x384; origin (1280-1024)/2 = 128,
+//     (720-384)/2 = 168; top {128, 168, 512, 384},
+//     bottom {128+512, 168, 512, 384}; unused 921600 - 393216 = 528384.
+//
+//   top only 800x600, integer
+//     block 256x192; scale = min(3, 3) = 3; picture 768x576;
+//     origin (800-768)/2 = 16, (600-576)/2 = 12; top {16, 12, 768, 576};
+//     bottom unused, all zeros; unused 480000 - 442368 = 37632.
+//
+//   bottom only 1920x1080, integer
+//     block 256x192; scale = min(7, 5) = 5; picture 1280x960;
+//     origin (1920-1280)/2 = 320, (1080-960)/2 = 60; top unused, all zeros;
+//     bottom {320, 60, 1280, 960}; unused 2073600 - 1228800 = 844800.
+//
+//   square 1366x768, fractional
+//     width-limited: 1366*256 = 349696 <= 768*512 = 393216, so the scale is
+//     gain/block = 1366/512; cell box 256*1366/512 = 683 by 683;
+//     picture 683 wide, 683*192/256 = 512.28 floored to 512 high;
+//     used 1366x512; origin (1366-1366)/2 = 0, (768-512)/2 = 128;
+//     top {0, 128, 683, 512}, bottom {683, 128, 683, 512};
+//     unused 1049088 - 2*349696 = 349696. The 171 pixels of tile padding per
+//     screen are counted as unused, exactly like letterboxing.
+
+struct PinCase {
+    NdsScreenLayoutKind kind;
+    int canvas_width;
+    int canvas_height;
+    bool integer_scale;
+    bool valid;
+    int native_scale;
+    int unused_canvas_pixels;
+    NdsScreenRect top;
+    NdsScreenRect bottom;
+    const char* label;
+};
+
+// 5 layouts x 7 canvases x 2 scaling modes. The canvases are the standard
