+}
+
+void draw_savestate_notice(SDL_Renderer* renderer,
+                           const SDL_Rect& screen,
+                           const char* text) {
+    if (!renderer || !text || !*text) return;
+    constexpr int kColumns = 40;
+    constexpr int kRows = 5;
+    constexpr int kGlyphWidth = 6;
+    constexpr int kGlyphHeight = 8;
+    const SDL_Rect background{screen.x + 5,
+                              screen.y + screen.h - kRows * kGlyphHeight - 5,
+                              kColumns * kGlyphWidth + 6,
+                              kRows * kGlyphHeight + 4};
+    SDL_SetRenderDrawColor(renderer, 10, 10, 10, 255);
+    fill_rect(renderer, background);
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
+    int row = 0;
+    int column = 0;
+    for (const char* p = text; *p && row < kRows; ++p) {
+        if (*p == '\n' || column == kColumns) {
+            ++row;
+            column = 0;
+            if (*p == '\n') continue;
+            if (row >= kRows) break;
+        }
+        const char* glyph = notice_glyph(*p);
+        for (int gy = 0; gy < 7; ++gy) {
+            for (int gx = 0; gx < 5; ++gx) {
+                if (glyph[gy * 5 + gx] != '1') continue;
+                const SDL_Rect pixel{
+                    background.x + 3 + column * kGlyphWidth + gx,
+                    background.y + 2 + row * kGlyphHeight + gy, 1, 1};
+                fill_rect(renderer, pixel);
+            }
+        }
+        ++column;
+    }
+}
+
+// The layout a stored menu index names. The menu stores the enum's own integer,
+// so this is a cast with a guard rather than a second table: an index that is
+// out of range after a hand edit falls back to the shipped default instead of
+// presenting a shape nobody asked for.
+NdsScreenLayout screen_layout_for_index(int index) {
+    switch (index) {
+        case static_cast<int>(NdsScreenLayout::Separate):
+            return NdsScreenLayout::Separate;
+        case static_cast<int>(NdsScreenLayout::SideBySide):
+            return NdsScreenLayout::SideBySide;
+        case static_cast<int>(NdsScreenLayout::TopOnly):
+            return NdsScreenLayout::TopOnly;
+        case static_cast<int>(NdsScreenLayout::BottomOnly):
+            return NdsScreenLayout::BottomOnly;
+        case static_cast<int>(NdsScreenLayout::Square):
+            return NdsScreenLayout::Square;
+        default: return NdsScreenLayout::Stacked;
+    }
+}
+
+// The layout enum names a SHAPE the player picked; screen_presentation speaks
+// in layout kinds plus one extra "two windows" value that is deliberately not a
+// kind. This is the one place the two vocabularies meet.
+nds_screen_layout::NdsScreenLayoutKind presentation_kind_for(
+    NdsScreenLayout layout) {
+    using namespace nds_screen_layout;
+    switch (layout) {
+        case NdsScreenLayout::Separate:
+            return nds_screen_presentation::kNdsPresentationSeparateWindows;
+        case NdsScreenLayout::SideBySide: return kNdsLayoutSideBySide;
+        case NdsScreenLayout::TopOnly: return kNdsLayoutTopOnly;
+        case NdsScreenLayout::BottomOnly: return kNdsLayoutBottomOnly;
+        case NdsScreenLayout::Square: return kNdsLayoutSquare;
+        default: return kNdsLayoutStacked;
+    }
+}
+
+// The adaptive width this presentation can actually use, or 0 for none.
+//
+// compute_presentation() REFUSES an adaptive width on anything but stacked, and
+// refusing the whole presentation would leave the player with no window at all
+// because two independent settings disagree. So the width is dropped here, with
+// one notice, and the game still runs -- the same shape as every other
+// "requested but unsupported" notice in this frontend.
+//
+// `report_unsupported` is false for the validity probe below: asking the module
+// whether a combination WOULD work must not print the notice, or the player sees
+// the same complaint twice for one keypress (once from the probe, once from the
+// real rebuild).
+int presentation_adaptive_width(const NdsFrontendOptions& options,
+                                NdsScreenLayout layout,
+                                bool report_unsupported = true) {
+    const bool requested = (options.adaptive_screens & NDS_ADAPTIVE_TOP) != 0u;
+    const bool supported = (options.adaptive_supported & NDS_ADAPTIVE_TOP) != 0u;
+    if (!requested || !supported) return 0;
+    if (layout != NdsScreenLayout::Stacked) {
+        if (report_unsupported) {
+            std::fprintf(stderr,
+                "[sdl] adaptive widescreen needs the stacked layout; keeping "
+                "the native %d-pixel width with the '%s' layout\n",
+                kScreenWidth, nds_screen_layout_name(layout));
+        }
+        return 0;
+    }
+    return options.adaptive_max_width[0];
+}
+
+// Take on a geometry the module already agreed to. Split out so the live layout
+// switch can probe the module first and only then commit, instead of mutating the
+// presentation and un-mutating it when the module refuses.
+void adopt_geometry(FrontendPresentation& presentation,
+                    const nds_screen_presentation::NdsPresentationGeometry&
+                        geometry,
+                    nds_screen_layout::NdsScreenLayoutKind kind) {
+    presentation.geometry = geometry;
+    presentation.layout_kind = kind;
+    presentation.separate = geometry.separate_windows;
+    presentation.canvas_width = geometry.canvas_width;
+}
+
+// Build the geometry for a request WITHOUT committing it. Split out of
+// refresh_presentation_geometry() so the live layout switch can ask "would this
+// work?" and only then move anything -- a probe that had to mutate the
+// presentation first would have to un-mutate it on refusal, and every caller
+// that forgot to would leave half a shape behind.
+//
+// The two flags are filtered against the shape here rather than where they are
+// read from the settings file. A stored "Second monitor" or "Swap screens" is a
+// standing wish, not a description of the running shape: a player keeps the
+// toggle on while switching layouts, and the module refuses both outside their
+// own shape, so passing them through unexamined would turn an unrelated toggle
+// into a session that cannot start.
+bool probe_presentation_geometry(
+    const FrontendPresentation& presentation, const NdsFrontendOptions& options,
+    NdsScreenLayout layout, bool swap_screens, bool second_monitor,
+    nds_screen_presentation::NdsPresentationGeometry* out_geometry,
+    nds_screen_layout::NdsScreenLayoutKind* out_kind) {
+    const nds_screen_layout::NdsScreenLayoutKind kind =
+        presentation_kind_for(layout);
+    const bool two_windows =
+        nds_screen_presentation::is_separate_windows(kind);
+    const nds_screen_presentation::NdsPresentationGeometry geometry =
+        nds_screen_presentation::compute_presentation(
+            kind, presentation.window_scale,
+            presentation_adaptive_width(options, layout, false),
+            swap_screens && !two_windows, second_monitor && two_windows);
+    if (!geometry.valid) return false;
+    if (out_geometry) *out_geometry = geometry;
+    if (out_kind) *out_kind = kind;
+    return true;
+}
+
+// One place that turns the presentation knobs into geometry, so the windows, the
+// logical surfaces, the draw rects and the touch mapping can never be built from
+// different answers.
+//
+// The knobs are read from `presentation`, not from `options`: the settings menu
+// can change the shape mid-session, and options only records what the process
+// was launched with. create_presentation() seeds presentation from options once.
+bool refresh_presentation_geometry(FrontendPresentation& presentation,
+                                   const NdsFrontendOptions& options) {
+    nds_screen_presentation::NdsPresentationGeometry geometry{};
+    nds_screen_layout::NdsScreenLayoutKind kind =
+        nds_screen_layout::kNdsLayoutStacked;
+    if (!probe_presentation_geometry(
+            presentation, options, presentation.layout,
+            presentation.swap_screens, presentation.second_monitor, &geometry,
+            &kind)) {
+        std::fprintf(stderr,
+            "[sdl] the '%s' layout cannot be presented at window scale %d\n",
+            nds_screen_layout_name(presentation.layout),
+            presentation.window_scale);
+        return false;
+    }
+    adopt_geometry(presentation, geometry, kind);
+    return true;
+}
+
+// Translate a point on one DS screen into the WINDOW pixels of the window that
+// displays it. Used by the debug and self-test injectors, which have to push
+// synthetic SDL events: SDL speaks window pixels, so a caller that knows what
+// DS pixel it wants to hit must come through here rather than multiply by a
+// remembered scale. Returns false when the layout does not show that screen.
+bool presentation_window_point(
+    const nds_screen_presentation::NdsPresentationGeometry& geometry,
+    int screen, int ds_x, int ds_y, int* out_x, int* out_y) {
+    if (!out_x || !out_y) return false;
+    if (screen < 0 || screen > 1) return false;
+    if (!geometry.visible[screen]) return false;
+    const int window = geometry.separate_windows ? screen : 0;
+    if (geometry.logical_width[window] <= 0) return false;
+    const nds_screen_layout::NdsScreenRect& rect = geometry.screen_rect[screen];
+    const int logical_x = rect.x + ds_x;
+    const int logical_y = rect.y + ds_y;
+    *out_x = logical_x * geometry.window_width[window] /
+             geometry.logical_width[window];
+    *out_y = logical_y * geometry.window_height[window] /
+             geometry.logical_height[window];
+    return true;
+}
+
+// The window a given DS screen is shown in.
+int presentation_window_for(
+    const nds_screen_presentation::NdsPresentationGeometry& geometry,
+    int screen) {
+    return geometry.separate_windows ? screen : 0;
+}
+
+// Re-derive the whole presentation for a new window scale.
+//
+// The scale reaches the player through one menu row, but it touches four things
+// that must agree: the window sizes, the logical surfaces, the draw rects (via
+// the geometry) and the touch mapping (also via the geometry). Multiplying a
+// remembered pair of dimensions -- what this used to do -- cannot express any of
+// that once there are layouts whose canvas is not two stacked screens.
+//
+// A refused scale leaves the previous geometry exactly as it was, so the caller
+// can report the scale that is actually running.
+bool rescale_presentation(FrontendPresentation& presentation,
+                          const NdsFrontendOptions& options, int scale) {
+    const int previous_scale = presentation.window_scale;
+    presentation.window_scale = scale;
+    if (!refresh_presentation_geometry(presentation, options)) {
+        presentation.window_scale = previous_scale;
+        return false;
+    }
+    const nds_screen_presentation::NdsPresentationGeometry& geometry =
+        presentation.geometry;
+    for (int window = 0; window < geometry.window_count; ++window) {
+        if (!presentation.windows[window]) continue;
+        SDL_SetWindowSize(presentation.windows[window],
+                          geometry.window_width[window],
+                          geometry.window_height[window]);
+        if (!presentation.renderers[window]) continue;
+        set_render_logical_size(presentation.renderers[window],
+                                geometry.logical_width[window],
+                                geometry.logical_height[window]);
+#if !defined(NDS_HAVE_SDL3)
+        SDL_RenderSetIntegerScale(presentation.renderers[window], SDL_TRUE);
+#endif
+        // The debug/selftest injectors translate DS pixels into window pixels,
+        // so they have to see the new size in the same frame the window changes.
+        if (window < 2) g_inject_window_ids[window] =
+            SDL_GetWindowID(presentation.windows[window]);
+    }
+    g_inject_geometry = geometry;
+    std::fprintf(stderr,
+                 "[sdl] window scale %d: canvas %dx%d, window %dx%d, "
+                 "logical %dx%d\n",
+                 scale, geometry.canvas_width, geometry.canvas_height,
+                 geometry.window_width[0], geometry.window_height[0],
+                 geometry.logical_width[0], geometry.logical_height[0]);
+    return true;
+}
+
+// The per-screen textures (and, when supersampling, the intermediate targets).
+// Split out of create_presentation() so a live layout change can rebuild them
+// for a new set of picture widths without recreating the windows: the window is
+// the thing the player positioned, and the textures are the thing a different
+// layout invalidates.
+bool create_screen_textures(FrontendPresentation& presentation) {
+    for (int screen = 0; screen < 2; ++screen) {
+        // The direct-top presenter draws screen 0 itself and never samples a
+        // texture for it: it reads the framebuffer through the compute path.
+        if (screen == 0 && presentation.gl_top) continue;
+        presentation.textures[screen] = SDL_CreateTexture(
+            presentation.renderers[screen], SDL_PIXELFORMAT_ARGB8888,
+            SDL_TEXTUREACCESS_STREAMING,
+            presentation.screen_widths[screen], kScreenHeight);
+        if (!presentation.textures[screen]) {
+            std::fprintf(stderr, "[sdl] texture failed: %s\n", SDL_GetError());
+            return false;
+        }
+        if (!set_texture_scale_nearest(presentation.textures[screen])) {
+            std::fprintf(stderr, "[sdl] texture scale mode failed: %s\n",
+                         SDL_GetError());
+            return false;
+        }
+        if (presentation.sample_scale > 1) {
+            presentation.sample_targets[screen] = SDL_CreateTexture(
+                presentation.renderers[screen], SDL_PIXELFORMAT_ARGB8888,
+                SDL_TEXTUREACCESS_TARGET,
+                presentation.screen_widths[screen] * presentation.sample_scale,
+                kScreenHeight * presentation.sample_scale);
+            if (!presentation.sample_targets[screen]) {
+                std::fprintf(stderr, "[sdl] supersample target failed: %s\n",
+                             SDL_GetError());
+                return false;
+            }
+            if (!set_texture_scale_nearest(
+                    presentation.sample_targets[screen])) {
+                std::fprintf(
+                    stderr,
+                    "[sdl] supersample target scale mode failed: %s\n",
+                    SDL_GetError());
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// The picture width each screen is rasterised at. A hidden screen still owns a
+// texture at the native width, because the guest rasterises into it every frame
+// whether or not anything displays it.
+void refresh_screen_widths(FrontendPresentation& presentation) {
+    const nds_screen_presentation::NdsPresentationGeometry& geometry =
+        presentation.geometry;
+    for (int screen = 0; screen < 2; ++screen) {
+        const int rect_width = geometry.screen_rect[screen].width;
+        presentation.screen_widths[screen] =
+            rect_width > 0 ? rect_width : kScreenWidth;
+    }
+}
+
+// Push the presentation's picture width and geometry into the two engines that
+// need to agree with it.
+//
+// The 3D output width is the widest picture either screen is rasterised at, and
+// the adaptive 2D framebuffer has to be told the same thing: a layout whose
+// canvas is a different shape changes both, and a stale width would leave the
+// renderer drawing into a buffer the presenter no longer samples at the same
+// size. Called from create_presentation() and from every live layout change.
+bool publish_presentation_widths(FrontendPresentation& presentation) {
+    const uint16_t output_width = static_cast<uint16_t>(std::max(
+        presentation.screen_widths[0], presentation.screen_widths[1]));
+    if (!nds_gpu3d_set_output_width(output_width)) {
+        std::fprintf(stderr, "[sdl] adaptive 3D width %u is unavailable\n",
+                     output_width);
+        return false;
+    }
+    return true;
+}
+
+// Put the bottom screen's window on a display the top screen is not on.
+//
+// Only the two-window layout has two windows to separate, so every other shape
+// returns immediately and the row that asked for this says why. With no second
+// display the window goes back beside its partner: parking a window off-screen
+// would look like the feature working while making the touch screen unreachable.
+void place_second_monitor_window(FrontendPresentation& presentation) {
+    if (!presentation.separate || !presentation.windows[1]) return;
+    const nds_screen_presentation::NdsPresentationGeometry& geometry =
+        presentation.geometry;
+    const int width = geometry.window_width[1] > 0
+        ? geometry.window_width[1] : kScreenWidth * kWindowScale;
+    const int height = geometry.window_height[1] > 0
+        ? geometry.window_height[1] : kScreenHeight * kWindowScale;
+    int primary_x = 0;
+    int primary_y = 0;
+    if (presentation.windows[0])
+        SDL_GetWindowPosition(presentation.windows[0], &primary_x, &primary_y);
+    const SDL_DisplayID primary_display =
+        presentation.windows[0]
+            ? SDL_GetDisplayForWindow(presentation.windows[0]) : 0;
+    SDL_DisplayID target = 0;
+    SDL_Rect target_bounds{};
+    if (presentation.second_monitor) {
+        int count = 0;
+        SDL_DisplayID* displays = SDL_GetDisplays(&count);
+        if (displays) {
+            for (int i = 0; i < count; ++i) {
+                if (displays[i] == primary_display) continue;
+                SDL_Rect bounds{};
+                if (!SDL_GetDisplayBounds(displays[i], &bounds)) continue;
+                target = displays[i];
+                target_bounds = bounds;
+                break;
+            }
+            SDL_free(displays);
+        }
+        if (!target) {
+            std::fprintf(stderr,
+                         "[sdl] no second display; the two windows stay "
+                         "side by side\n");
+        }
+    }
+    if (target) {
+        SDL_SetWindowPosition(presentation.windows[1],
+                              target_bounds.x +
+                                  (target_bounds.w - width) / 2,
+                              target_bounds.y +
+                                  (target_bounds.h - height) / 2);
+        std::fprintf(stderr,
+                     "[sdl] bottom screen on display %u at %d,%d\n",
+                     static_cast<unsigned>(target), target_bounds.x,
+                     target_bounds.y);
+        return;
+    }
+    SDL_SetWindowPosition(presentation.windows[1],
+                          primary_x + width + 32, primary_y);
+}
+
+// Change the shape of a running session without restarting it.
+//
+// Every one-window layout shares a single window and a single renderer, so a
+// switch between them is a rebuild of exactly what the geometry owns: the
+// picture widths, the textures at those widths, the window size, the logical
+// surface, and the width the 3D rasteriser is told to produce. The window
+// itself survives, because the player put it where they wanted it.
+//
+// Two-window mode is refused rather than half-done. It needs a second window and
+// a second renderer, and creating them mid-session means rebuilding the injector
+// window ids, the renderer-vsync loop and the mouse router's window lookup at a
+// point where a partially rebuilt presentation would show one screen and drop
+// the other. Asking for a restart is honest; a half switch is not. The stored
+// value is left as the player set it, so the next launch arrives in the shape
+// they asked for.
+bool reshape_presentation(FrontendPresentation& presentation,
+                          const NdsFrontendOptions& options,
+                          NdsScreenLayout layout, bool swap_screens,
+                          bool second_monitor) {
+    const bool wants_two_windows = layout == NdsScreenLayout::Separate;
+    if (wants_two_windows || presentation.separate) {
+        std::fprintf(stderr,
+                     "[sdl] the two-window layout needs a restart; the running "
+                     "session stays '%s'\n",
+                     nds_screen_layout_name(presentation.layout));
+        return false;
+    }
+    nds_screen_presentation::NdsPresentationGeometry geometry{};
+    nds_screen_layout::NdsScreenLayoutKind kind =
+        nds_screen_layout::kNdsLayoutStacked;
+    if (!probe_presentation_geometry(presentation, options, layout, swap_screens,
+                                     second_monitor, &geometry, &kind)) {
+        std::fprintf(stderr,
+                     "[sdl] the '%s' layout cannot be presented at window "
+                     "scale %d\n",
+                     nds_screen_layout_name(layout), presentation.window_scale);
+        return false;
+    }
+    // Nothing below can fail in a way that leaves the old shape usable, so the
+    // old textures go first: they are sized for the old picture widths.
+    destroy_screen_resources(presentation);
+    adopt_geometry(presentation, geometry, kind);
+    presentation.layout = layout;
+    presentation.swap_screens = swap_screens;
+    presentation.second_monitor = second_monitor;
+    refresh_screen_widths(presentation);
+    if (presentation.windows[0]) {
+        SDL_SetWindowSize(presentation.windows[0], geometry.window_width[0],
+                          geometry.window_height[0]);
+    }
+    if (presentation.renderers[0]) {
+        set_render_logical_size(presentation.renderers[0],
+                                geometry.logical_width[0],
+                                geometry.logical_height[0]);
+    }
+    if (!create_screen_textures(presentation)) {
+        std::fprintf(stderr,
+                     "[sdl] the '%s' layout could not allocate its pictures\n",
+                     nds_screen_layout_name(layout));
+        return false;
+    }
+    publish_presentation_widths(presentation);
+    g_inject_geometry = geometry;
+    if (presentation.windows[0])
+        g_inject_window_ids[0] = SDL_GetWindowID(presentation.windows[0]);
+    std::fprintf(stderr, "[sdl] layout now '%s' canvas %dx%d windows %d\n",
+                 nds_screen_layout_name(layout), geometry.canvas_width,
+                 geometry.canvas_height, geometry.window_count);
+    return true;
+}
+
+bool create_presentation(const NdsFrontendOptions& options,
+                         FrontendPresentation& presentation,
+                         bool allow_gl_top = true) {
+    presentation.window_scale = kWindowScale;
+    presentation.base_window_scale = kWindowScale;
+    // A freshly built presentation has no knobs of its own, so the launch
+    // configuration seeds them. A presentation rebuilt for a menu change
+    // arrives with knobs already set and keeps them.
+    if (!presentation.knobs_seeded) {
+        presentation.layout = options.screen_layout;
+        presentation.knobs_seeded = true;
+    }
+    if (!refresh_presentation_geometry(presentation, options)) return false;
+    const nds_screen_presentation::NdsPresentationGeometry& geometry =
+        presentation.geometry;
+    // Two windows: every texture is native 256x192, so screen_widths stays at
+    // the native width. One window: each picture is as wide as its rect, and a
+    // hidden screen keeps a native-width texture because the guest rasterises
+    // into it every frame whether or not anything displays it.
+    if (!presentation.separate) refresh_screen_widths(presentation);
+#if defined(NDS_HAVE_COMPUTE_RENDERER)
+    const char* direct_selection =
+        std::getenv("NDS_COMPUTE_DIRECT_PRESENT");
+    const bool direct_enabled =
+        !direct_selection || !*direct_selection ||
+        std::strcmp(direct_selection, "1") == 0;
+    const bool direct_top_requested =
+        (options.adaptive_screens & NDS_ADAPTIVE_TOP) != 0u ||
+        options.internal_resolution > 1u;
+    presentation.gl_top = presentation.separate &&
+        allow_gl_top &&
+        direct_top_requested &&
+        nds_gpu3d_renderer_prefers_compute() &&
+        direct_enabled;
+#endif
+    const int aa_scale = options.antialiasing >= 8 ? 4 :
+                         options.antialiasing >= 4 ? 3 :
+                         options.antialiasing >= 2 ? 2 : 1;
+    presentation.configured_sample_scale =
+        std::max<int>(options.supersampling, aa_scale);
+    presentation.sample_scale = presentation.configured_sample_scale;
+    const uint64_t top_window_flags =
+        SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI |
+        (presentation.gl_top
+             ? static_cast<uint64_t>(SDL_WINDOW_OPENGL) : 0u);
+    const std::string label = game_label(options);
+    // A one-window layout is called a preview, not a top screen: with top-only
+    // or bottom-only it may be showing the BOTTOM screen, and a title bar that
+    // lies is worse than a vague one.
+    const std::string window_zero_title = presentation.separate
+        ? label + " - Top Screen"
+        : label + " preview";
+    presentation.windows[0] = create_window(
+        window_zero_title.c_str(), SDL_WINDOWPOS_CENTERED,
+        SDL_WINDOWPOS_CENTERED, geometry.window_width[0],
+        geometry.window_height[0], top_window_flags);
+    if (!presentation.windows[0]) {
+        std::fprintf(stderr, "[sdl] window failed: %s\n", SDL_GetError());
+        return false;
+    }
+    if (!presentation.gl_top) {
+        presentation.renderers[0] = create_renderer(presentation.windows[0]);
+        if (!presentation.renderers[0]) {
+            std::fprintf(stderr, "[sdl] renderer failed: %s\n", SDL_GetError());
+            destroy_presentation(presentation);
+            return false;
+        }
+    }
+
+    if (presentation.separate) {
+        int top_x = 0;
+        int top_y = 0;
+        SDL_GetWindowPosition(presentation.windows[0], &top_x, &top_y);
+        presentation.windows[1] = create_window(
+            (label + " - Bottom Screen").c_str(),
+            top_x + geometry.window_width[0] + 32, top_y,
+            geometry.window_width[1], geometry.window_height[1],
+            SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI);
+        if (!presentation.windows[1]) {
+            std::fprintf(stderr, "[sdl] bottom window failed: %s\n",
+                         SDL_GetError());
+            destroy_presentation(presentation);
+            return false;
+        }
+        presentation.renderers[1] =
+            create_renderer(presentation.windows[1]);
+        if (!presentation.renderers[1]) {
+            std::fprintf(stderr, "[sdl] bottom renderer failed: %s\n",
+                         SDL_GetError());
+            destroy_presentation(presentation);
+            return false;
+        }
+    } else {
+        presentation.windows[1] = presentation.windows[0];
+        presentation.renderers[1] = presentation.renderers[0];
+    }
+
+    // Fullscreen is applied only after both separate-layout windows have their
+    // final placement. The primary combined/top window is deliberately the
+    // sole target so the separate touch window remains usable.
+    if (!set_window_fullscreen(presentation.windows[0], options.fullscreen)) {
+        std::fprintf(stderr, "[sdl] fullscreen (%s) failed: %s\n",
+                     nds_fullscreen_mode_name(options.fullscreen),
+                     SDL_GetError());
+        destroy_presentation(presentation);
+        return false;
+    }
+
+    // The logical surface is whatever the geometry says this window maps, which
+    // is the whole canvas in one-window mode and one native screen in two-window
+    // mode. In one-window mode both screens share renderer 0, so the size is set
+    // once.
+    for (int window = 0; window < geometry.window_count; ++window) {
+        if (!presentation.renderers[window]) continue;
+        set_render_logical_size(presentation.renderers[window],
+                                geometry.logical_width[window],
+                                geometry.logical_height[window]);
+#if !defined(NDS_HAVE_SDL3)
+        SDL_RenderSetIntegerScale(presentation.renderers[window], SDL_TRUE);
+#endif
+    }
+    if (!create_screen_textures(presentation)) {
+        destroy_presentation(presentation);
+        return false;
+    }
+    for (int screen = 0; screen < 2; ++screen) {
+        presentation.window_ids[screen] =
+            SDL_GetWindowID(presentation.windows[screen]);
+    }
+    return true;
+}
+
+void render_screen(FrontendPresentation& presentation, int screen,
+                   const SDL_Rect& destination) {
+    SDL_Renderer* renderer = presentation.renderers[screen];
+    SDL_Texture* source = presentation.textures[screen];
+    if (presentation.sample_scale > 1 && presentation.sample_targets[screen]) {
+        SDL_SetRenderTarget(renderer, presentation.sample_targets[screen]);
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+        SDL_RenderClear(renderer);
+        render_texture(renderer, source, nullptr);
+        SDL_SetRenderTarget(renderer, nullptr);
+        source = presentation.sample_targets[screen];
+    }
+    render_texture(renderer, source, &destination);
+}
+
+struct PresentationTicks {
+    uint64_t upload = 0;
+    uint64_t draw = 0;
+    uint64_t swap = 0;
+    bool ok = true;
+};
+
+// All-or-nothing. The only fallible step is the renderer rebuild, so it runs
+// FIRST and nothing else is touched until it has succeeded: a failed apply
+// leaves the readback latency, the sample scale and the HD emit flag exactly
+// as the currently installed stage left them, so the caller can report the
+// stage that is actually running.
+bool apply_performance_governor_stage(
+        const NdsFrontendOptions& options,
+        FrontendPresentation& presentation,
+        uint8_t stage) {
+    const uint8_t target_scale =
+        stage >= 2u ? 1u : options.internal_resolution;
+    if (!nds_gpu3d_set_runtime_internal_scale(target_scale)) {
+        std::fprintf(stderr,
+                     "[governor] could not apply internal scale %u\n",
+                     static_cast<unsigned>(target_scale));
+        return false;
+    }
+    nds_gpu3d_set_display_readback_latency(stage >= 1u);
+    presentation.sample_scale =
+        stage >= 2u ? 1 : presentation.configured_sample_scale;
+    nds_gpu2d_set_hd_emit(target_scale > 1u && presentation.gl_top);
+    return true;
+}
+
+void draw_virtual_stylus(SDL_Renderer* renderer, const SDL_Rect& destination,
+                         float stylus_x, float stylus_y) {
+    const int x = destination.x + static_cast<int>(
+        std::lround(stylus_x * destination.w / 256.0f));
+    const int y = destination.y + static_cast<int>(
+        std::lround(stylus_y * destination.h / 192.0f));
+
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
+    render_line(renderer, x - 5, y, x - 2, y);
+    render_line(renderer, x + 2, y, x + 5, y);
+    render_line(renderer, x, y - 5, x, y - 2);
+    render_line(renderer, x, y + 2, x, y + 5);
+}
+
+PresentationTicks present_screens(FrontendPresentation& presentation,
+                                  const uint32_t* top_pixels,
+                                  int top_width,
+                                  const uint32_t* bottom_pixels,
+                                  int bottom_width,
+                                  RecompRuntimeUi* runtime_ui,
+                                  bool virtual_stylus_visible,
+                                  float virtual_stylus_x,
+                                  float virtual_stylus_y,
+                                  const char* savestate_notice,
+                                  int color_mode,
+                                  bool lcd_grid,
+                                  int pixel_filter) {
+    PresentationTicks ticks{};
+    // Display post-processing happens once, here, on the surfaces this call is
+    // about to upload: both the real and the interpolated frame go through the
+    // same two lines, so a blended frame cannot be presented unfiltered.
+    top_pixels = filtered_screen(top_pixels, 0, top_width, kScreenHeight,
+                                 color_mode, lcd_grid, pixel_filter);
+    bottom_pixels = filtered_screen(bottom_pixels, 1, bottom_width,
+                                    kScreenHeight, color_mode, lcd_grid,
+                                    pixel_filter);
+    if (presentation.gl_top) {
+#if defined(NDS_HAVE_COMPUTE_RENDERER)
+        NdsGpu2dDirectFrame direct_frame{};
+        const bool direct = nds_gpu2d_direct_frame(&direct_frame);
+        NdsComputePresentTicks gl_ticks{};
+        if (!nds_compute_host_present_top(
+                top_pixels, static_cast<uint16_t>(top_width),
+                direct ? &direct_frame : nullptr, &gl_ticks)) {
+            std::fprintf(stderr, "[gpu3d] direct top presentation failed\n");
+            ticks.ok = false;
+            return ticks;
+        }
+        ticks.upload += gl_ticks.upload;
+        ticks.draw += gl_ticks.draw;
+        ticks.swap += gl_ticks.swap;
+        bottom_pixels = runtime_menu_overlay(
+            runtime_ui, bottom_pixels, bottom_width, kScreenHeight);
+        uint64_t start = SDL_GetPerformanceCounter();
+        SDL_UpdateTexture(presentation.textures[1], nullptr, bottom_pixels,
+                          bottom_width * sizeof(uint32_t));
+        ticks.upload += SDL_GetPerformanceCounter() - start;
+        const SDL_Rect screen_rect{
+            0, 0, presentation.screen_widths[1], kScreenHeight};
+        SDL_Renderer* renderer = presentation.renderers[1];
+        start = SDL_GetPerformanceCounter();
+        SDL_SetRenderDrawColor(renderer, 20, 20, 20, 255);
+        SDL_RenderClear(renderer);
+        render_screen(presentation, 1, screen_rect);
+        if (virtual_stylus_visible)
+            draw_virtual_stylus(renderer, screen_rect,
+                                virtual_stylus_x, virtual_stylus_y);
+        draw_savestate_notice(renderer, screen_rect, savestate_notice);
+        ticks.draw += SDL_GetPerformanceCounter() - start;
+        start = SDL_GetPerformanceCounter();
+        SDL_RenderPresent(renderer);
+        ticks.swap += SDL_GetPerformanceCounter() - start;
+#endif
+        return ticks;
+    }
+    // Whichever screen a host overlay is painted on has to be one the player is
+    // actually being shown: with the bottom-only layout the top picture is not
+    // on screen at all, so painting the menu there would make it invisible.
+    if (presentation.geometry.visible[0]) {
+        top_pixels = runtime_menu_overlay(runtime_ui, top_pixels, top_width,
+                                          kScreenHeight);
+    } else {
+        bottom_pixels = runtime_menu_overlay(runtime_ui, bottom_pixels,
+                                             bottom_width, kScreenHeight);
+    }
+    uint64_t start = SDL_GetPerformanceCounter();
+    SDL_UpdateTexture(presentation.textures[0], nullptr, top_pixels,
+                      top_width * sizeof(uint32_t));
+    SDL_UpdateTexture(presentation.textures[1], nullptr, bottom_pixels,
+                      bottom_width * sizeof(uint32_t));
+    ticks.upload += SDL_GetPerformanceCounter() - start;
+    // Every draw rect comes from the geometry the windows and the touch mapping
+    // were already built from, so the picture and the stylus cannot disagree.
+    const auto screen_destination = [&presentation](int screen) {
+        const nds_screen_layout::NdsScreenRect& rect =
+            presentation.geometry.screen_rect[screen];
+        return SDL_Rect{rect.x, rect.y, rect.width, rect.height};
+    };
+    if (!presentation.separate) {
+        SDL_Renderer* renderer = presentation.renderers[0];
+        start = SDL_GetPerformanceCounter();
+        SDL_SetRenderDrawColor(renderer, 20, 20, 20, 255);
+        SDL_RenderClear(renderer);
+        for (int screen = 0; screen < 2; ++screen) {
+            if (!presentation.geometry.visible[screen]) continue;
+            render_screen(presentation, screen, screen_destination(screen));
+        }
+        // The minimap: in a one-screen layout the other picture is not on screen
+        // at all, so a player who needs it (a map on the bottom screen, a HUD on
+        // the top) gets a thumbnail of it in the corner of the one they can see.
+        // The module decides when that is meaningful -- it refuses for stacked,
+        // side-by-side and square, where both pictures are already visible, and
+        // for the two-window mode, which never reaches this path anyway.
+        //
+        // Nothing here consults the layout kind: which screen to draw comes from
+        // geometry.visible, so "top with swap" correctly insets the BOTTOM
+        // picture rather than repeating the one on screen.
+        if (presentation.minimap) {
+            const nds_screen_minimap::NdsMinimapLayout minimap =
+                nds_screen_minimap::compute_minimap(presentation.geometry);
+            if (minimap.visible) {
+                const nds_screen_layout::NdsScreenRect& inset = minimap.inset;
+                const SDL_Rect inset_rect{inset.x, inset.y, inset.width,
+                                          inset.height};
+                // A frame so the thumbnail does not dissolve into a picture that
+                // happens to be the same colour where it lands.
+                SDL_SetRenderDrawColor(renderer, 235, 235, 235, 255);
+                fill_rect(renderer, inset_rect);
+                const SDL_Rect inner{inset.x + 1, inset.y + 1,
+                                     std::max(1, inset.width - 2),
+                                     std::max(1, inset.height - 2)};
+                render_screen(presentation, minimap.screen, inner);
+            }
+        }
+        // The stylus and the notice belong on the touch screen, which is the
+        // bottom one -- unless the layout shows only the top, in which case the
+        // visible picture is the only place they can go.
+        const int notice_screen =
+            presentation.geometry.visible[1] ? 1 : 0;
+        const SDL_Rect notice_rect = screen_destination(notice_screen);
+        if (virtual_stylus_visible)
+            draw_virtual_stylus(renderer, notice_rect,
+                                virtual_stylus_x, virtual_stylus_y);
+        draw_savestate_notice(renderer, notice_rect, savestate_notice);
+        ticks.draw += SDL_GetPerformanceCounter() - start;
+        start = SDL_GetPerformanceCounter();
+        SDL_RenderPresent(renderer);
+        ticks.swap += SDL_GetPerformanceCounter() - start;
+        return ticks;
+    }
+
+    for (int screen = 0; screen < 2; ++screen) {
+        const SDL_Rect screen_rect = screen_destination(screen);
+        SDL_Renderer* renderer = presentation.renderers[screen];
+        start = SDL_GetPerformanceCounter();
+        SDL_SetRenderDrawColor(renderer, 20, 20, 20, 255);
+        SDL_RenderClear(renderer);
+        render_screen(presentation, screen, screen_rect);
+        if (screen == 1 && virtual_stylus_visible)
+            draw_virtual_stylus(renderer, screen_rect,
+                                virtual_stylus_x, virtual_stylus_y);
+        if (screen == 1)
+            draw_savestate_notice(renderer, screen_rect, savestate_notice);
+        ticks.draw += SDL_GetPerformanceCounter() - start;
+        start = SDL_GetPerformanceCounter();
+        SDL_RenderPresent(renderer);
+        ticks.swap += SDL_GetPerformanceCounter() - start;
+    }
+    return ticks;
+}
+
+} // namespace
+
+int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
+    NdsFrontendOptions options = initial_options;
+    SDL_SetMainReady();
+    // SDL_INIT_TIMER matters on Windows: it raises the OS timer resolution
+    // to 1 ms (SDL_HINT_TIMER_RESOLUTION default). Without it SDL_Delay(1)
+    // sleeps a full ~15.6 ms scheduler quantum, so the audio-queue throttle
+    // overshoots every frame, pinning the loop at ~57 FPS and cyclically
+    // starving the audio queue (the audible boot crackle).
+    if (!sdl_init_frontend()) {
+        std::fprintf(stderr, "[sdl] init failed: %s\n", SDL_GetError());
+        return 1;
+    }
+    if (!sdl_set_thread_priority_high())
+        std::fprintf(stderr, "[sdl] thread priority unchanged: %s\n",
+                     SDL_GetError());
+
+#if !defined(NDS_HAVE_SDL3)
+    if (!SDL_SetHintWithPriority(SDL_HINT_RENDER_SCALE_QUALITY, "0",
+                                 SDL_HINT_OVERRIDE)) {
+        std::fprintf(stderr,
+                     "[sdl] render scale quality hint was not applied\n");
+    }
+#endif
+    FrontendPresentation presentation{};
+    if (!create_presentation(options, presentation)) {
+        SDL_Quit();
+        return 1;
+    }
+    // The two rects the relative-mouse router reasons about are read from the
+    // geometry at the point of use rather than cached here: the settings menu can
+    // reshape a running session (that is what the Screen layout and Swap screens
+    // rows do), and a rect captured at startup would keep routing clicks at
+    // yesterday's picture position for the rest of the session.
+    const auto logical_rect_for = [&presentation](int screen) {
+        const nds_screen_layout::NdsScreenRect& rect =
+            presentation.geometry.screen_rect[screen];
+        return NdsLogicalRect{rect.x, rect.y, rect.width, rect.height};
+    };
+    std::fprintf(stderr,
+        "[sdl] layout=%s fullscreen=%s adaptive=%s supersampling=%ux aa=%ux "
+        "internal=%ux canvas=%dx%d windows=%d\n",
+        nds_screen_layout_name(options.screen_layout),
+        nds_fullscreen_mode_name(options.fullscreen),
+        nds_adaptive_screens_name(options.adaptive_screens),
+        static_cast<unsigned>(options.supersampling),
+        static_cast<unsigned>(options.antialiasing),
+        static_cast<unsigned>(options.internal_resolution),
+        presentation.canvas_width, presentation.geometry.canvas_height,
+        presentation.geometry.window_count);
+    if (!publish_presentation_widths(presentation)) {
+        destroy_presentation(presentation);
+        SDL_Quit();
+        return 1;
+    }
+    // Must precede nds_compute_host_start(): the scale is a baked shader
+    // constant, so it has to be known before the renderer compiles anything.
+    //
+    // Deliberately NOT gated on the direct presenter. Rendering at scale and
+    // presenting at scale are separate: the scaled raster still point-samples
+    // the same native surface every faithful consumer reads, so a run without
+    // the GPU presenter is a valid way to prove that invariance holds. Only
+    // the visible benefit needs gl_top, so that is what the notice says.
+    const uint8_t initial_internal_resolution =
+        options.perf_governor_mode == NdsPerfGovernorMode::ForceStage2
+            ? 1u
+            : options.internal_resolution;
+    if (!nds_gpu3d_set_internal_scale(initial_internal_resolution)) {
+        std::fprintf(stderr,
+                     "[sdl] internal resolution %ux is unavailable\n",
+                     static_cast<unsigned>(initial_internal_resolution));
+        destroy_presentation(presentation);
+        SDL_Quit();
+        return 1;
+    }
