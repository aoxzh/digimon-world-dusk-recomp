+
+void check_pins() {
+    for (const PinCase& pin : kPins) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            pin.kind, pin.window_scale, 0, pin.swap_screens, false);
+        const bool matches =
+            geometry.valid &&
+            geometry.canvas_width == pin.canvas_width &&
+            geometry.canvas_height == pin.canvas_height &&
+            geometry.logical_width[0] == pin.canvas_width &&
+            geometry.logical_height[0] == pin.canvas_height &&
+            geometry.window_width[0] == pin.canvas_width * pin.window_scale &&
+            geometry.window_height[0] == pin.canvas_height * pin.window_scale &&
+            rect_is(geometry.screen_rect[kNdsScreenTop], pin.top.x, pin.top.y,
+                    pin.top.width, pin.top.height) &&
+            rect_is(geometry.screen_rect[kNdsScreenBottom], pin.bottom.x,
+                    pin.bottom.y, pin.bottom.width, pin.bottom.height) &&
+            geometry.visible[kNdsScreenTop] == pin.visible_top &&
+            geometry.visible[kNdsScreenBottom] == pin.visible_bottom &&
+            geometry.window_count == 1 && !geometry.separate_windows;
+        check(matches, std::string("pin ") + pin.label, describe(geometry));
+    }
+}
+
+void check_pin_spare_index() {
+    // A layout is one window, so the second entry of every per-window array
+    // must stay zero: a frontend that loops over both indices would otherwise
+    // open a phantom 0x0 window.
+    bool spare_zero = true;
+    for (const PinCase& pin : kPins) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            pin.kind, pin.window_scale, 0, pin.swap_screens, false);
+        if (geometry.window_width[1] != 0 || geometry.window_height[1] != 0 ||
+            geometry.logical_width[1] != 0 ||
+            geometry.logical_height[1] != 0) {
+            spare_zero = false;
+        }
+    }
+    check(spare_zero, "a one-window geometry leaves index 1 of every array "
+                      "zero",
+          "some pin filled window 1");
+}
+
+// ---------------------------------------------------------------------------
+// adaptive_width: the widescreen widening, and every refusal around it
+// ---------------------------------------------------------------------------
+
+struct AdaptiveCase {
+    int adaptive_width;
+    int window_scale;
+    bool swap_screens;
+    int canvas_width;
+    NdsScreenRect top;
+    NdsScreenRect bottom;
+    const char* label;
+};
+
+// Stacked at 192 tall per screen. The top picture widens to adaptive_width; the
+// bottom stays 256 wide and is centred under it, which is exact because the
+// width is even: margin = (adaptive - 256) / 2.
+//   258 -> margin 1,   300 -> margin 22,   448 -> margin 96.
+const AdaptiveCase kAdaptive[] = {
+    {256, 2, false, 256, {0, 0, 256, 192}, {0, 192, 256, 192}, "256 2x"},
+    {258, 2, false, 258, {0, 0, 258, 192}, {1, 192, 256, 192}, "258 2x"},
+    {300, 2, false, 300, {0, 0, 300, 192}, {22, 192, 256, 192}, "300 2x"},
+    {448, 2, false, 448, {0, 0, 448, 192}, {96, 192, 256, 192}, "448 2x"},
+    {256, 1, false, 256, {0, 0, 256, 192}, {0, 192, 256, 192}, "256 1x"},
+    {300, 3, false, 300, {0, 0, 300, 192}, {22, 192, 256, 192}, "300 3x"},
+    // Swapped: the wide picture belongs to the top SCREEN, wherever the layout
+    // puts it, so it moves to the lower half and keeps its width.
+    {300, 2, true, 300, {0, 192, 300, 192}, {22, 0, 256, 192}, "300 2x sw"},
+    {448, 4, true, 448, {0, 192, 448, 192}, {96, 0, 256, 192}, "448 4x sw"},
+};
+
+void check_adaptive() {
+    for (const AdaptiveCase& item : kAdaptive) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsLayoutStacked, item.window_scale, item.adaptive_width,
+            item.swap_screens, false);
+        const bool matches =
+            geometry.valid && geometry.canvas_width == item.canvas_width &&
+            geometry.canvas_height == 384 &&
+            geometry.logical_width[0] == item.canvas_width &&
+            geometry.logical_height[0] == 384 &&
+            geometry.window_width[0] == item.canvas_width * item.window_scale &&
+            geometry.window_height[0] == 384 * item.window_scale &&
+            rect_is(geometry.screen_rect[kNdsScreenTop], item.top.x,
+                    item.top.y, item.top.width, item.top.height) &&
+            rect_is(geometry.screen_rect[kNdsScreenBottom], item.bottom.x,
+                    item.bottom.y, item.bottom.width, item.bottom.height) &&
+            geometry.visible[kNdsScreenTop] &&
+            geometry.visible[kNdsScreenBottom] && geometry.window_count == 1;
+        check(matches, std::string("adaptive ") + item.label,
+              describe(geometry));
+    }
+
+    // The widening itself, called out separately from the row check so a
+    // regression says which half broke.
+    for (int width : {258, 300, 448}) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsLayoutStacked, 1, width, false, false);
+        char name[96];
+        std::snprintf(name, sizeof(name),
+                      "adaptive %d widens only the top picture", width);
+        check(geometry.screen_rect[kNdsScreenTop].width == width &&
+                  geometry.screen_rect[kNdsScreenBottom].width == 256,
+              name, describe(geometry));
+    }
+    // Centring is exact for an even width: the free space left of the bottom
+    // picture equals the free space right of it.
+    for (int width : {256, 258, 300, 448}) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsLayoutStacked, 1, width, false, false);
+        const NdsScreenRect bottom = geometry.screen_rect[kNdsScreenBottom];
+        const int left = bottom.x;
+        const int right = geometry.canvas_width - (bottom.x + bottom.width);
+        char name[96];
+        std::snprintf(name, sizeof(name),
+                      "adaptive %d centres the bottom picture exactly", width);
+        check(left == right, name,
+              "left " + std::to_string(left) + " right " +
+                  std::to_string(right));
+    }
+    // A reference 256 is not a widening at all: it must equal the plain layout.
+    const NdsPresentationGeometry plain =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    const NdsPresentationGeometry native_width =
+        compute_presentation(kNdsLayoutStacked, 2, 256, false, false);
+    check(plain.canvas_width == native_width.canvas_width &&
+              rect_is(plain.screen_rect[kNdsScreenTop],
+                      native_width.screen_rect[kNdsScreenTop].x,
+                      native_width.screen_rect[kNdsScreenTop].y,
+                      native_width.screen_rect[kNdsScreenTop].width,
+                      native_width.screen_rect[kNdsScreenTop].height),
+          "adaptive 256 is the same as no widening", describe(native_width));
+}
+
+void check_adaptive_refusals() {
+    // Odd widths cannot centre exactly, and widths outside 256..448 are not the
+    // widescreen the setting promises.
+    for (int width : {257, 255, 254, 449, 450, 1024, -2}) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsLayoutStacked, 2, width, false, false);
+        check(is_refused(geometry),
+              "adaptive width " + std::to_string(width) + " is refused",
+              refusal_detail(geometry));
+    }
+    // Every layout that cannot carry the widening refuses rather than ignoring
+    // it: a silently ignored request ships a picture the player asked to widen.
+    const NdsScreenLayoutKind others[] = {kNdsLayoutSideBySide,
+                                          kNdsLayoutTopOnly,
+                                          kNdsLayoutBottomOnly,
+                                          kNdsLayoutSquare};
+    for (NdsScreenLayoutKind kind : others) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kind, 2, 300, false, false);
+        check(is_refused(geometry),
+              "adaptive width is refused for layout " + std::to_string(
+                  static_cast<int>(kind)),
+              refusal_detail(geometry));
+    }
+    // And in two-window mode, which has one 256-wide surface per window and no
+    // canvas to widen.
+    const NdsPresentationGeometry separate = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 300, false, false);
+    check(is_refused(separate),
+          "adaptive width is refused in two-window mode",
+          refusal_detail(separate));
+}
+
+void check_adaptive_boundaries() {
+    // The range is inclusive at both ends.
+    const NdsPresentationGeometry low = compute_presentation(
+        kNdsLayoutStacked, 1, kMinAdaptiveWidth, false, false);
+    check(low.valid && low.canvas_width == kMinAdaptiveWidth,
+          "the minimum adaptive width is accepted", describe(low));
+    const NdsPresentationGeometry high = compute_presentation(
+        kNdsLayoutStacked, 1, kMaxAdaptiveWidth, false, false);
+    check(high.valid && high.canvas_width == kMaxAdaptiveWidth,
+          "the maximum adaptive width is accepted", describe(high));
+    // 448 is 7/3 of 192 tall, so the picture is wider than 4:3 on purpose. The
+    // height is untouched: widening must never change the vertical geometry.
+    check(high.screen_rect[kNdsScreenTop].height == 192 &&
+              high.screen_rect[kNdsScreenBottom].y == 192,
+          "widening does not change any height", describe(high));
+}
+
+// ---------------------------------------------------------------------------
+// window_scale and second_monitor refusals
+// ---------------------------------------------------------------------------
+
+void check_scale_refusals() {
+    for (int scale : {0, -1, -7, 17, 100, kMaxWindowScale + 1}) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kNdsLayoutStacked, scale, 0, false, false);
+        check(is_refused(geometry),
+              "window_scale " + std::to_string(scale) + " is refused",
+              refusal_detail(geometry));
+    }
+    for (int scale : {1, kMaxWindowScale}) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kNdsLayoutStacked, scale, 0, false, false);
+        check(geometry.valid && geometry.window_width[0] == 256 * scale &&
+                  geometry.window_height[0] == 384 * scale,
+              "window_scale " + std::to_string(scale) + " is accepted",
+              describe(geometry));
+    }
+    // A refused scale applies to every entry path, including two-window mode.
+    const NdsPresentationGeometry separate = compute_presentation(
+        kNdsPresentationSeparateWindows, 0, 0, false, false);
+    check(is_refused(separate), "two-window mode refuses window_scale 0",
+          refusal_detail(separate));
+}
+
+void check_second_monitor() {
+    const NdsScreenLayoutKind layouts[] = {
+        kNdsLayoutStacked, kNdsLayoutSideBySide, kNdsLayoutTopOnly,
+        kNdsLayoutBottomOnly, kNdsLayoutSquare};
+    for (NdsScreenLayoutKind kind : layouts) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kind, 2, 0, false, true);
+        check(is_refused(geometry),
+              "second_monitor is refused for layout " +
+                  std::to_string(static_cast<int>(kind)),
+              refusal_detail(geometry));
+    }
+    // Two-window mode accepts it, and the flag changes no number: the caller
+    // gets two windows either way and decides where to put them.
+    const NdsPresentationGeometry without = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, false, false);
+    const NdsPresentationGeometry with = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, false, true);
+    check(without.valid && with.valid && with.separate_windows &&
+              with.window_count == 2,
+          "second_monitor is accepted in two-window mode", describe(with));
+    check(without.window_width[0] == with.window_width[0] &&
+              without.window_height[1] == with.window_height[1] &&
+              rect_is(without.screen_rect[kNdsScreenTop],
+                      with.screen_rect[kNdsScreenTop].x,
+                      with.screen_rect[kNdsScreenTop].y,
+                      with.screen_rect[kNdsScreenTop].width,
+                      with.screen_rect[kNdsScreenTop].height),
+          "second_monitor changes no number", describe(with));
+}
+
+// ---------------------------------------------------------------------------
+// Out-of-range kinds fold onto stacked
+// ---------------------------------------------------------------------------
+
+void check_totality() {
+    const NdsPresentationGeometry stacked =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    for (int value : {-99, -1, 6, 7, 99}) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            static_cast<NdsScreenLayoutKind>(value), 2, 0, false, false);
+        const bool same =
+            geometry.valid && stacked.valid &&
+            geometry.canvas_width == stacked.canvas_width &&
+            geometry.canvas_height == stacked.canvas_height &&
+            geometry.window_width[0] == stacked.window_width[0] &&
+            rect_is(geometry.screen_rect[kNdsScreenTop],
+                    stacked.screen_rect[kNdsScreenTop].x,
+                    stacked.screen_rect[kNdsScreenTop].y,
+                    stacked.screen_rect[kNdsScreenTop].width,
+                    stacked.screen_rect[kNdsScreenTop].height) &&
+            rect_is(geometry.screen_rect[kNdsScreenBottom],
+                    stacked.screen_rect[kNdsScreenBottom].x,
+                    stacked.screen_rect[kNdsScreenBottom].y,
+                    stacked.screen_rect[kNdsScreenBottom].width,
+                    stacked.screen_rect[kNdsScreenBottom].height);
+        check(same, "kind " + std::to_string(value) + " behaves as stacked",
+              describe(geometry));
+    }
+    // ... and an out-of-range kind still refuses what stacked refuses.
+    const NdsPresentationGeometry refused = compute_presentation(
+        static_cast<NdsScreenLayoutKind>(99), 2, 300, false, false);
+    check(!is_refused(refused),
+          "kind 99 carries the adaptive width, because it became stacked",
+          describe(refused));
+    const NdsPresentationGeometry bad_scale = compute_presentation(
+        static_cast<NdsScreenLayoutKind>(-5), 0, 0, false, false);
+    check(is_refused(bad_scale), "kind -5 with scale 0 is still refused",
+          refusal_detail(bad_scale));
+}
+
+// ---------------------------------------------------------------------------
+// Two-window mode
+// ---------------------------------------------------------------------------
+
+void check_two_window() {
+    for (int scale : {1, 2, 3, 4}) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            kNdsPresentationSeparateWindows, scale, 0, false, false);
+        char label[64];
+        std::snprintf(label, sizeof(label), " (%dx)", scale);
+        check(geometry.valid && geometry.window_count == 2 &&
+                  geometry.separate_windows,
+              std::string("two-window 2") + label + " opens two windows",
+              describe(geometry));
+        check(geometry.window_width[0] == 256 * scale &&
+                  geometry.window_height[0] == 192 * scale &&
+                  geometry.window_width[1] == 256 * scale &&
+                  geometry.window_height[1] == 192 * scale,
+              std::string("two-window 2") + label + " sizes both windows",
+              describe(geometry));
+        check(geometry.logical_width[0] == 256 &&
+                  geometry.logical_height[0] == 192 &&
+                  geometry.logical_width[1] == 256 &&
+                  geometry.logical_height[1] == 192,
+              std::string("two-window 2") + label +
+                  " gives each window a 256x192 surface",
+              describe(geometry));
+        check(rect_is(geometry.screen_rect[kNdsScreenTop], 0, 0, 256, 192) &&
+                  rect_is(geometry.screen_rect[kNdsScreenBottom], 0, 0, 256,
+                          192),
+              std::string("two-window 2") + label +
+                  " fills each surface edge to edge",
+              describe(geometry));
+    }
+    const NdsPresentationGeometry geometry = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, false, false);
+    check(geometry.canvas_width == 256 && geometry.canvas_height == 192,
+          "two-window mode's canvas is one screen", describe(geometry));
+    check(geometry.visible[kNdsScreenTop] && geometry.visible[kNdsScreenBottom],
+          "two-window mode shows both screens", describe(geometry));
+
+    // swap_screens has nothing to exchange between two identical windows, so it
+    // is refused rather than ignored (decision 4 read strictly).
+    const NdsPresentationGeometry swapped = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, true, false);
+    check(is_refused(swapped),
+          "two-window mode refuses swap_screens, which could not change "
+          "anything",
+          refusal_detail(swapped));
+}
+
+// ---------------------------------------------------------------------------
+// Hit testing
+// ---------------------------------------------------------------------------
+
+struct Hit {
+    bool hit;
+    int screen;
+    int ds_x;
+    int ds_y;
+};
+
+// Converts a point in LOGICAL surface coordinates into window coordinates (the
+// space the OS reports the mouse in) and runs the hit test there. Testing in
+// logical space keeps every expectation readable, while the conversion
+// exercises the window_scale undo on the way in.
+Hit hit_logical(const NdsPresentationGeometry& geometry, int window, float x,
+                float y) {
+    Hit result{false, -1, -1, -1};
+    if (window < 0 || window > 1) return result;
+    const int logical_width = geometry.logical_width[window];
+    const int logical_height = geometry.logical_height[window];
+    if (logical_width <= 0 || logical_height <= 0) return result;
+    const float window_x =
+        x * static_cast<float>(geometry.window_width[window]) /
+        static_cast<float>(logical_width);
+    const float window_y =
+        y * static_cast<float>(geometry.window_height[window]) /
+        static_cast<float>(logical_height);
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+    result.hit = screen_presentation_hit_test(geometry, window, window_x,
+                                              window_y, &screen, &ds_x, &ds_y);
+    if (result.hit) {
+        result.screen = screen;
+        result.ds_x = ds_x;
+        result.ds_y = ds_y;
+    }
+    return result;
+}
+
+std::string describe_hit(const Hit& hit) {
+    if (!hit.hit) return "no hit";
+    return "screen " + std::to_string(hit.screen) + " ds " +
+           std::to_string(hit.ds_x) + "," + std::to_string(hit.ds_y);
+}
+
+// The centre of a picture. An even-sized picture has no centre pixel, so the
+// exact centre of a 256x192 picture is the boundary between columns 127 and
+// 128: the mapping truncates, so it reports 128. That choice is pinned rather
+// than left to rounding, and it is why the expected pair is 128/96 and not
+// 127/95.
+Hit centre_of(const NdsPresentationGeometry& geometry, int window, int slot) {
+    const NdsScreenRect& rect = geometry.screen_rect[slot];
+    const float x = static_cast<float>(rect.x) +
+                    static_cast<float>(rect.width) / 2.0f;
+    const float y = static_cast<float>(rect.y) +
+                    static_cast<float>(rect.height) / 2.0f;
+    return hit_logical(geometry, window, x, y);
+}
+
+void check_hit_centres() {
+    for (int scale : {1, 2, 3, 4}) {
+        // Both screens of a two-screen layout: the left/upper picture is the
+        // top screen, and its centre is the centre of the DS top screen.
+        const NdsPresentationGeometry stacked =
+            compute_presentation(kNdsLayoutStacked, scale, 0, false, false);
+        const Hit top = centre_of(stacked, 0, kNdsScreenTop);
+        const Hit bottom = centre_of(stacked, 0, kNdsScreenBottom);
+        char label[64];
+        std::snprintf(label, sizeof(label), " (stacked %dx)", scale);
+        check(top.hit && top.screen == kNdsScreenTop && top.ds_x == 128 &&
+                  top.ds_y == 96,
+              std::string("the top picture's centre is DS 128,96") + label,
+              describe_hit(top));
+        check(bottom.hit && bottom.screen == kNdsScreenBottom &&
+                  bottom.ds_x == 128 && bottom.ds_y == 96,
+              std::string("the bottom picture's centre is DS 128,96") + label,
+              describe_hit(bottom));
+
+        const NdsPresentationGeometry side =
+            compute_presentation(kNdsLayoutSideBySide, scale, 0, false, false);
+        const Hit left = centre_of(side, 0, kNdsScreenTop);
+        const Hit right = centre_of(side, 0, kNdsScreenBottom);
+        std::snprintf(label, sizeof(label), " (side-by-side %dx)", scale);
+        check(left.hit && left.screen == kNdsScreenTop && left.ds_x == 128 &&
+                  left.ds_y == 96 && right.hit &&
+                  right.screen == kNdsScreenBottom && right.ds_x == 128 &&
+                  right.ds_y == 96,
+              std::string("each side-by-side picture maps to its own screen") +
+                  label,
+              describe_hit(left) + " / " + describe_hit(right));
+
+        const NdsPresentationGeometry square =
+            compute_presentation(kNdsLayoutSquare, scale, 0, false, false);
+        const Hit square_top = centre_of(square, 0, kNdsScreenTop);
+        std::snprintf(label, sizeof(label), " (square %dx)", scale);
+        check(square_top.hit && square_top.screen == kNdsScreenTop &&
+                  square_top.ds_x == 128 && square_top.ds_y == 96,
+              std::string("a square-layout picture's centre ignores its "
+                          "32 px offset") +
+                  label,
+              describe_hit(square_top));
+    }
+
+    // Single-screen layouts: the picture fills the canvas, and swap changes
+    // which screen the very same point reports.
+    const NdsPresentationGeometry top_only =
+        compute_presentation(kNdsLayoutTopOnly, 2, 0, false, false);
+    const Hit shown = centre_of(top_only, 0, kNdsScreenTop);
+    check(shown.hit && shown.screen == kNdsScreenTop,
+          "top-only reports the top screen", describe_hit(shown));
+    const NdsPresentationGeometry top_only_swapped =
+        compute_presentation(kNdsLayoutTopOnly, 2, 0, true, false);
+    const Hit swapped = centre_of(top_only_swapped, 0, kNdsScreenBottom);
+    check(swapped.hit && swapped.screen == kNdsScreenBottom,
+          "top-only swapped reports the bottom screen at the same point",
+          describe_hit(swapped));
+    const NdsPresentationGeometry bottom_only =
+        compute_presentation(kNdsLayoutBottomOnly, 2, 0, false, false);
+    const Hit bottom_shown = centre_of(bottom_only, 0, kNdsScreenBottom);
+    check(bottom_shown.hit && bottom_shown.screen == kNdsScreenBottom,
+          "bottom-only reports the bottom screen", describe_hit(bottom_shown));
+
+    // The widened picture is stretched, so its centre is still 128 even though
+    // its rect is 300 wide: the presenter stretches those DS columns too.
+    const NdsPresentationGeometry wide =
+        compute_presentation(kNdsLayoutStacked, 2, 300, false, false);
+    const Hit wide_centre = centre_of(wide, 0, kNdsScreenTop);
+    check(wide_centre.hit && wide_centre.screen == kNdsScreenTop &&
+              wide_centre.ds_x == 128 && wide_centre.ds_y == 96,
+          "a widened picture's centre is still DS 128,96",
+          describe_hit(wide_centre));
+    const Hit wide_bottom = centre_of(wide, 0, kNdsScreenBottom);
+    check(wide_bottom.hit && wide_bottom.screen == kNdsScreenBottom &&
+              wide_bottom.ds_x == 128 && wide_bottom.ds_y == 96,
+          "the picture under it still maps to its own centre",
+          describe_hit(wide_bottom));
+}
+
+// Every sampled DS pixel, taken at its centre, must map back to itself. This is
+// the check that catches an off-by-one in the window-to-logical undo or a
+// swapped axis, which a centre-only test would miss.
+void check_hit_pixel_roundtrip() {
+    struct Config {
+        NdsScreenLayoutKind kind;
+        int window_scale;
+        int adaptive_width;
+        const char* label;
+    };
+    const Config configs[] = {
+        {kNdsLayoutStacked, 1, 0, "stacked 1x"},
+        {kNdsLayoutStacked, 2, 0, "stacked 2x"},
+        {kNdsLayoutStacked, 3, 0, "stacked 3x"},
+        {kNdsLayoutSideBySide, 3, 0, "side-by-side 3x"},
+        {kNdsLayoutSquare, 4, 0, "square 4x"},
+        {kNdsLayoutTopOnly, 1, 0, "top-only 1x"},
+        {kNdsLayoutStacked, 2, 300, "widened 300 at 2x"},
+        {kNdsLayoutStacked, 4, 448, "widened 448 at 4x"},
+    };
+    const int sample_x[] = {0, 1, 85, 127, 128, 170, 254, 255};
+    const int sample_y[] = {0, 1, 63, 95, 96, 128, 190, 191};
+
+    for (const Config& config : configs) {
+        const NdsPresentationGeometry geometry = compute_presentation(
+            config.kind, config.window_scale, config.adaptive_width, false,
+            false);
+        bool all_ok = true;
+        std::string first_bad;
+        for (int slot = 0; slot < 2; ++slot) {
+            if (!geometry.visible[slot]) continue;
+            const NdsScreenRect& rect = geometry.screen_rect[slot];
+            for (int pixel_y : sample_y) {
+                for (int pixel_x : sample_x) {
+                    // The centre of DS pixel (pixel_x, pixel_y), expressed in
+                    // logical coordinates: the picture may be stretched, so the
+                    // step is rect_extent / 256, not 1.
+                    const float x =
+                        static_cast<float>(rect.x) +
+                        (static_cast<float>(pixel_x) + 0.5f) *
+                            static_cast<float>(rect.width) / 256.0f;
+                    const float y =
+                        static_cast<float>(rect.y) +
+                        (static_cast<float>(pixel_y) + 0.5f) *
+                            static_cast<float>(rect.height) / 192.0f;
+                    const Hit hit = hit_logical(geometry, 0, x, y);
+                    if (!hit.hit || hit.screen != slot ||
+                        hit.ds_x != pixel_x || hit.ds_y != pixel_y) {
+                        if (all_ok) {
+                            first_bad = "pixel " + std::to_string(pixel_x) +
+                                        "," + std::to_string(pixel_y) +
+                                        " of slot " + std::to_string(slot) +
+                                        " -> " + describe_hit(hit);
+                        }
+                        all_ok = false;
+                    }
+                }
+            }
+        }
+        check(all_ok, std::string("every sampled DS pixel round-trips (") +
+                          config.label + ")",
+              first_bad);
+    }
+}
+
+void check_hit_corners() {
+    const NdsScreenLayoutKind kinds[] = {
+        kNdsLayoutStacked, kNdsLayoutSideBySide, kNdsLayoutTopOnly,
+        kNdsLayoutBottomOnly, kNdsLayoutSquare};
+    for (NdsScreenLayoutKind kind : kinds) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kind, 2, 0, false, false);
+        // The first visible screen; single-screen layouts may have swapped the
+        // other one into use, but the first visible rect is what is pinned.
+        const int slot =
+            geometry.visible[kNdsScreenTop] ? kNdsScreenTop : kNdsScreenBottom;
+        const NdsScreenRect& rect = geometry.screen_rect[slot];
+        const float right = static_cast<float>(rect.x + rect.width) - 0.5f;
+        const float bottom = static_cast<float>(rect.y + rect.height) - 0.5f;
+        const float left = static_cast<float>(rect.x) + 0.5f;
+        const float top_edge = static_cast<float>(rect.y) + 0.5f;
+        const Hit top_left = hit_logical(geometry, 0, left, top_edge);
+        const Hit bottom_right = hit_logical(geometry, 0, right, bottom);
+        const Hit top_right = hit_logical(geometry, 0, right, top_edge);
+        const Hit bottom_left = hit_logical(geometry, 0, left, bottom);
+        const std::string label =
+            " (layout " + std::to_string(static_cast<int>(kind)) + ")";
+        check(top_left.hit && top_left.screen == slot && top_left.ds_x == 0 &&
+                  top_left.ds_y == 0,
+              "the picture's first pixel is DS 0,0" + label,
+              describe_hit(top_left));
+        check(bottom_right.hit && bottom_right.screen == slot &&
+                  bottom_right.ds_x == 255 && bottom_right.ds_y == 191,
+              "the picture's last pixel is DS 255,191" + label,
+              describe_hit(bottom_right));
+        check(top_right.hit && top_right.ds_x == 255 && top_right.ds_y == 0 &&
+                  bottom_left.hit && bottom_left.ds_x == 0 &&
+                  bottom_left.ds_y == 191,
+              "the other two corners are the other two DS corners" + label,
+              describe_hit(top_right) + " / " + describe_hit(bottom_left));
+    }
+}
+
+void check_hit_outside() {
+    // "One pixel outside a picture" only means "nothing" where there IS
+    // nothing: in four of the five layouts the pictures tile the canvas edge to
+    // edge, so the pixel next to a picture is the neighbouring picture, and
+    // reporting a miss there would be the wrong answer, not the safe one. Two
+    // cases cover the real thing:
+    //   * past the canvas edge, which is outside the logical surface entirely;
+    //   * the square layout's 32-pixel margins, which are genuinely empty.
+    // The pixels adjacent to a neighbouring picture are pinned in
+    // check_hit_margins() instead, where they belong.
+    const char* edges[] = {"left", "right", "above", "below"};
+    const NdsScreenLayoutKind kinds[] = {
+        kNdsLayoutStacked, kNdsLayoutSideBySide, kNdsLayoutTopOnly,
+        kNdsLayoutBottomOnly, kNdsLayoutSquare};
+    for (NdsScreenLayoutKind kind : kinds) {
+        const NdsPresentationGeometry geometry =
+            compute_presentation(kind, 3, 0, false, false);
+        const float width = static_cast<float>(geometry.canvas_width);
+        const float height = static_cast<float>(geometry.canvas_height);
+        const Hit hits[] = {
+            hit_logical(geometry, 0, -1.0f, height / 2.0f),
+            hit_logical(geometry, 0, width, height / 2.0f),
+            hit_logical(geometry, 0, width / 2.0f, -1.0f),
+            hit_logical(geometry, 0, width / 2.0f, height),
+        };
+        for (int index = 0; index < 4; ++index) {
+            check(!hits[index].hit,
+                  std::string("one pixel past the canvas ") + edges[index] +
+                      " edge is a miss (layout " +
+                      std::to_string(static_cast<int>(kind)) + ")",
+                  describe_hit(hits[index]));
+        }
+    }
+
+    // The square layout's margins: one logical pixel above the pictures and one
+    // below them is empty, at a column that is inside a picture horizontally.
+    const NdsPresentationGeometry square =
+        compute_presentation(kNdsLayoutSquare, 3, 0, false, false);
+    const Hit above = hit_logical(square, 0, 128.0f, 31.0f);
+    const Hit below = hit_logical(square, 0, 128.0f, 224.0f);
+    check(!above.hit && !below.hit,
+          "one pixel above and below a square-layout picture is a miss",
+          describe_hit(above) + " / " + describe_hit(below));
+
+    // A widened layout has horizontal margins in the bottom half only: the
+    // 256-wide bottom picture is centred in a 300-wide canvas, so columns 0..21
+    // are empty there. One pixel left of the picture is a miss; the first
+    // picture column is not.
+    const NdsPresentationGeometry wide =
+        compute_presentation(kNdsLayoutStacked, 2, 300, false, false);
+    const Hit left_margin = hit_logical(wide, 0, 21.5f, 250.0f);
+    const Hit first_column = hit_logical(wide, 0, 22.5f, 250.0f);
+    check(!left_margin.hit,
+          "one pixel left of the widened layout's bottom picture is a miss",
+          describe_hit(left_margin));
+    check(first_column.hit && first_column.screen == kNdsScreenBottom &&
+              first_column.ds_x == 0,
+          "the bottom picture's first column is DS column 0",
+          describe_hit(first_column));
+    const Hit right_margin = hit_logical(wide, 0, 278.5f, 250.0f);
+    check(!right_margin.hit,
+          "one pixel right of the widened layout's bottom picture is a miss",
+          describe_hit(right_margin));
+}
+
+void check_hit_margins() {
+    // The square layout is the one layout with real black margins: 32 logical
+    // pixels above and below the two pictures. A tap there must release the
+    // stylus, not land on the nearest screen.
+    const NdsPresentationGeometry square =
+        compute_presentation(kNdsLayoutSquare, 2, 0, false, false);
+    const Hit above = hit_logical(square, 0, 128.0f, 16.0f);
+    const Hit above_edge = hit_logical(square, 0, 128.0f, 31.0f);
+    const Hit below = hit_logical(square, 0, 128.0f, 240.0f);
+    check(!above.hit, "the square layout's top margin is a miss",
+          describe_hit(above));
+    check(!above_edge.hit, "the last margin row above the pictures is a miss",
+          describe_hit(above_edge));
+    check(!below.hit, "the square layout's bottom margin is a miss",
+          describe_hit(below));
+    const Hit first_row = hit_logical(square, 0, 128.0f, 32.0f);
+    check(first_row.hit && first_row.screen == kNdsScreenTop &&
+              first_row.ds_y == 0,
+          "the first picture row is the top screen's first row",
+          describe_hit(first_row));
+    const Hit bottom_row = hit_logical(square, 0, 384.0f, 223.0f);
+    check(bottom_row.hit && bottom_row.screen == kNdsScreenBottom &&
+              bottom_row.ds_y == 191,
+          "the last picture row is the bottom screen's last row",
+          describe_hit(bottom_row));
+
+    // Stacked has no gutter: the seam belongs to whichever picture starts
+    // there, so a tap one row above it is still the top screen's last row.
+    const NdsPresentationGeometry stacked =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    const Hit seam_above = hit_logical(stacked, 0, 128.0f, 191.0f);
+    const Hit seam = hit_logical(stacked, 0, 128.0f, 192.0f);
+    check(seam_above.hit && seam_above.screen == kNdsScreenTop &&
+              seam_above.ds_y == 191,
+          "the row above the seam is still the top screen",
+          describe_hit(seam_above));
+    check(seam.hit && seam.screen == kNdsScreenBottom && seam.ds_y == 0,
+          "the seam row is the bottom screen's first row", describe_hit(seam));
+
+    // Beyond the canvas edge is outside the logical surface entirely.
+    const Hit past_right = hit_logical(stacked, 0, 256.0f, 100.0f);
+    const Hit past_bottom = hit_logical(stacked, 0, 100.0f, 384.0f);
+    check(!past_right.hit && !past_bottom.hit,
+          "a point past the canvas edge is a miss",
+          describe_hit(past_right) + " / " + describe_hit(past_bottom));
+}
+
+void check_hit_window_index() {
+    const NdsPresentationGeometry layout =
+        compute_presentation(kNdsLayoutSideBySide, 2, 0, false, false);
+    const Hit bad_low = hit_logical(layout, 0, 10.0f, 10.0f);
+    check(bad_low.hit, "a layout window accepts window index 0",
+          describe_hit(bad_low));
+    // Window 1 does not exist in a one-window geometry; asking anyway must not
+    // read the zeroed spare entry and divide by it.
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+    check(!screen_presentation_hit_test(layout, 1, 10.0f, 10.0f, &screen,
+                                        &ds_x, &ds_y),
+          "a layout rejects window index 1", "got a hit");
+    check(!screen_presentation_hit_test(layout, -1, 10.0f, 10.0f, &screen,
+                                        &ds_x, &ds_y),
+          "a layout rejects window index -1", "got a hit");
+    check(!screen_presentation_hit_test(layout, 2, 10.0f, 10.0f, &screen,
+                                        &ds_x, &ds_y),
+          "a layout rejects window index 2", "got a hit");
+
+    // Two-window mode: window i reports screen i, and the same window-space
+    // point means a different screen in each window.
+    const NdsPresentationGeometry separate = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, false, false);
+    const Hit first = hit_logical(separate, 0, 128.0f, 96.0f);
+    const Hit second = hit_logical(separate, 1, 128.0f, 96.0f);
+    check(first.hit && first.screen == kNdsScreenTop && second.hit &&
+              second.screen == kNdsScreenBottom,
+          "window 0 is the top screen and window 1 the bottom",
+          describe_hit(first) + " / " + describe_hit(second));
+    check(!screen_presentation_hit_test(separate, 2, 10.0f, 10.0f, &screen,
+                                        &ds_x, &ds_y),
+          "two-window mode rejects a third window", "got a hit");
+    check(first.ds_x == 128 && first.ds_y == 96 && second.ds_x == 128 &&
+              second.ds_y == 96,
+          "both two-window pictures are unmagnified 256x192 surfaces",
+          describe_hit(first));
+}
+
+// The hit test obeys two fields that no geometry from compute_presentation()
+// can distinguish from something else: `visible`, because a hidden screen is
+// always the one with an empty rect, and `window_count`, because the spare
+// per-window entries are always zero. That makes "read the flag" and "read the
+// rect/array" look equivalent -- until a caller hands over a geometry it built
+// itself, which frontend code that previews a layout does. These hand-built
+// geometries are what keeps the flags the thing the touch path follows, since
+// the presenter draws from the same two fields.
+void check_hit_explicit_fields() {
+    NdsPresentationGeometry geometry{};
+    geometry.canvas_width = 256;
+    geometry.canvas_height = 192;
+    geometry.logical_width[0] = 256;
+    geometry.logical_height[0] = 192;
+    geometry.window_width[0] = 256;
+    geometry.window_height[0] = 192;
+    geometry.window_count = 1;
+    geometry.valid = true;
+    // Both screens claim the same non-empty rect, but only the bottom one is
+    // visible. A hit test that trusted the rects would answer the top screen,
+    // which is the wrong picture -- and the two rects overlapping is exactly
+    // what a caller building a geometry by hand gets wrong.
+    geometry.screen_rect[kNdsScreenTop] = NdsScreenRect{0, 0, 256, 192};
+    geometry.screen_rect[kNdsScreenBottom] = NdsScreenRect{0, 0, 256, 192};
+    geometry.visible[kNdsScreenTop] = false;
+    geometry.visible[kNdsScreenBottom] = true;
+    const Hit hidden_top = hit_logical(geometry, 0, 128.0f, 96.0f);
+    check(hidden_top.hit && hidden_top.screen == kNdsScreenBottom,
+          "a hidden screen is skipped even when its rect is non-empty",
+          describe_hit(hidden_top) + " / " + describe(geometry));
+
+    // With both visible the same point reads top first, so the check above is
+    // not passing because the loop happens to reach the bottom screen anyway.
+    geometry.visible[kNdsScreenTop] = true;
+    const Hit both = hit_logical(geometry, 0, 128.0f, 96.0f);
+    check(both.hit && both.screen == kNdsScreenTop,
+          "with both screens shown the top one wins the shared pixel",
+          describe_hit(both));
+
+    // window_count says one window, but window 1 is fully populated. Only the
+    // count guard can reject that; without it the hit test reads a surface the
+    // frontend never opened, and because the top screen is still showing it
+    // would answer with a perfectly plausible pixel from the wrong window.
+    geometry.visible[kNdsScreenTop] = true;
+    geometry.visible[kNdsScreenBottom] = false;
+    geometry.logical_width[1] = 256;
+    geometry.logical_height[1] = 192;
+    geometry.window_width[1] = 256;
+    geometry.window_height[1] = 192;
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+    check(!screen_presentation_hit_test(geometry, 1, 128.0f, 96.0f, &screen,
+                                        &ds_x, &ds_y),
+          "a populated spare window is still rejected by window_count",
+          "got a hit");
+    // The same point through the window that does exist does hit, so the line
+    // above is not passing because the geometry itself is dead.
+    const Hit real = hit_logical(geometry, 0, 128.0f, 96.0f);
+    check(real.hit && real.screen == kNdsScreenTop,
+          "the window that exists still answers at that point",
+          describe_hit(real));
+
+    // Both screens hidden, both rects still non-empty: the rect is not the
+    // authority on visibility, the flag is, and a hidden geometry is a miss
+    // that writes nothing.
+    geometry.visible[kNdsScreenTop] = false;
+    screen = -7;
+    ds_x = -7;
+    ds_y = -7;
+    const bool hidden =
+        screen_presentation_hit_test(geometry, 0, 128.0f, 96.0f, &screen, &ds_x,
+                                     &ds_y);
+    check(!hidden && screen == -7 && ds_x == -7 && ds_y == -7,
+          "a geometry with both screens hidden hits nothing and writes nothing",
+          "screen " + std::to_string(screen) + " ds " + std::to_string(ds_x) +
+              "," + std::to_string(ds_y));
+}
+
+void check_hit_refusals() {
+    const NdsPresentationGeometry refused =
+        compute_presentation(kNdsLayoutStacked, 0, 0, false, false);
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+    check(!screen_presentation_hit_test(refused, 0, 10.0f, 10.0f, &screen,
+                                        &ds_x, &ds_y),
+          "a refused geometry hits nothing", "got a hit");
+
+    const NdsPresentationGeometry good =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    check(!screen_presentation_hit_test(good, 0, 10.0f, 10.0f, nullptr, &ds_x,
+                                        &ds_y),
+          "a null screen pointer is a miss, not a crash", "got a hit");
+    check(!screen_presentation_hit_test(good, 0, 10.0f, 10.0f, &screen, nullptr,
+                                        &ds_y),
+          "a null ds_x pointer is a miss", "got a hit");
+    check(!screen_presentation_hit_test(good, 0, 10.0f, 10.0f, &screen, &ds_x,
+                                        nullptr),
+          "a null ds_y pointer is a miss", "got a hit");
+
+    // A miss writes nothing at all: the caller's values survive, so a frontend
+    // that releases the stylus on a miss cannot be left holding a stale pixel
+    // from a previous hit.
+    screen = -7;
+    ds_x = -7;
+    ds_y = -7;
+    const bool hit = screen_presentation_hit_test(good, 0, -1.0f, -1.0f,
+                                                  &screen, &ds_x, &ds_y);
+    check(!hit && screen == -7 && ds_x == -7 && ds_y == -7,
+          "a miss writes nothing to the out parameters",
+          "screen " + std::to_string(screen) + " ds " +
+              std::to_string(ds_x) + "," + std::to_string(ds_y));
+    // And a hit writes all three.
+    screen = -7;
+    ds_x = -7;
+    ds_y = -7;
+    const bool landed = screen_presentation_hit_test(good, 0, 100.0f, 100.0f,
+                                                     &screen, &ds_x, &ds_y);
+    check(landed && screen == kNdsScreenTop && ds_x >= 0 && ds_y >= 0,
+          "a hit writes the screen and both coordinates",
+          "screen " + std::to_string(screen) + " ds " +
+              std::to_string(ds_x) + "," + std::to_string(ds_y));
+}
+
+// ---------------------------------------------------------------------------
+// The logical-space touch entry point
+// ---------------------------------------------------------------------------
+
+// Runs the LOGICAL entry point: the point is already in native canvas pixels,
+// the space SDL_RenderCoordinatesFromWindow() reports and the space the screen
+// rects are written in.
+Hit hit_native(const NdsPresentationGeometry& geometry, int window, float x,
+               float y) {
+    Hit result{false, -1, -1, -1};
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+    result.hit = screen_presentation_hit_test_logical(geometry, window, x, y,
+                                                      &screen, &ds_x, &ds_y);
+    if (result.hit) {
+        result.screen = screen;
+        result.ds_x = ds_x;
+        result.ds_y = ds_y;
+    }
+    return result;
+}
+
+std::string kind_label(NdsScreenLayoutKind kind) {
+    if (is_separate_windows(kind)) return "separate windows";
+    return std::string(nds_screen_layout::layout_name(kind));
+}
+
+// One mapping in two coordinate spaces. The window-space entry point divides by
+// the window/logical ratio, which decision 2 makes exactly window_scale, so
+// handing it a point a whole window_scale away from a logical point must give
+// the same answer as handing that logical point to the logical entry point.
+// Nothing may differ: not the screen, not a DS pixel, not the verdict.
+//
+// The samples are the whole canvas on a 9x9 grid plus half a pixel outside and
+// inside every visible rect corner, which is where a half-open rectangle's
+// agreement can break without any interior point noticing.
+// compute_presentation() with the two arguments the touch tests always pass as
+// "no second monitor": the sweep below repeats this call often enough that the
+// long form pushes the declaration past the line limit.
+NdsPresentationGeometry placed_presentation(NdsScreenLayoutKind kind, int scale,
+                                            int adaptive, bool swap) {
+    return compute_presentation(kind, scale, adaptive, swap, false);
+}
+
+void check_hit_logical_agreement() {
+    const NdsScreenLayoutKind kinds[] = {
+        kNdsLayoutStacked,     kNdsLayoutSideBySide, kNdsLayoutTopOnly,
+        kNdsLayoutBottomOnly,  kNdsLayoutSquare,
+        kNdsPresentationSeparateWindows};
+    const int scales[] = {1, 2, 3, 5, 16};
+    const int adaptives[] = {0, 300};
+
+    for (NdsScreenLayoutKind kind : kinds) {
+        int compared = 0;
+        int mismatches = 0;
+        std::string first_bad;
+        for (int scale : scales) {
+            for (int adaptive : adaptives) {
+                for (bool swap : {false, true}) {
+                    const NdsPresentationGeometry placed =
+                        placed_presentation(kind, scale, adaptive, swap);
+                    if (!placed.valid) continue;
+                    const int canvas_width = placed.canvas_width;
+                    const int canvas_height = placed.canvas_height;
+                    for (int window = 0; window < placed.window_count;
+                         ++window) {
+                        float points_x[128];
+                        float points_y[128];
+                        int count = 0;
+                        for (int gy = 0; gy <= 8; ++gy) {
+                            for (int gx = 0; gx <= 8; ++gx) {
+                                points_x[count] = static_cast<float>(
+                                                      canvas_width) *
+                                                  static_cast<float>(gx) / 8.0f;
+                                points_y[count] = static_cast<float>(
+                                                      canvas_height) *
+                                                  static_cast<float>(gy) / 8.0f;
+                                ++count;
+                            }
+                        }
+                        for (int slot = 0; slot < 2; ++slot) {
+                            if (!placed.visible[slot]) continue;
+                            const NdsScreenRect& rect =
+                                placed.screen_rect[slot];
+                            const float left = static_cast<float>(rect.x);
+                            const float top = static_cast<float>(rect.y);
+                            const float right =
+                                static_cast<float>(rect.x + rect.width);
+                            const float bottom =
+                                static_cast<float>(rect.y + rect.height);
+                            const float xs[] = {left - 0.5f, left + 0.5f,
+                                                right - 0.5f, right + 0.5f};
+                            const float ys[] = {top - 0.5f, top + 0.5f,
+                                                bottom - 0.5f, bottom + 0.5f};
+                            for (float x : xs) {
+                                for (float y : ys) {
+                                    if (count >= 128) break;
+                                    points_x[count] = x;
+                                    points_y[count] = y;
+                                    ++count;
+                                }
+                            }
+                        }
+                        for (int index = 0; index < count; ++index) {
+                            const Hit via_window = hit_logical(
+                                placed, window, points_x[index],
+                                points_y[index]);
+                            const Hit via_native = hit_native(
+                                placed, window, points_x[index],
+                                points_y[index]);
+                            ++compared;
+                            const bool same =
+                                via_window.hit == via_native.hit &&
+                                (!via_window.hit ||
+                                 (via_window.screen == via_native.screen &&
+                                  via_window.ds_x == via_native.ds_x &&
+                                  via_window.ds_y == via_native.ds_y));
+                            if (!same) {
+                                if (mismatches == 0) {
+                                    first_bad =
+                                        kind_label(kind) + " " +
+                                        std::to_string(scale) + "x at " +
+                                        std::to_string(points_x[index]) + "," +
+                                        std::to_string(points_y[index]) +
+                                        ": window space " +
+                                        describe_hit(via_window) +
+                                        ", logical space " +
+                                        describe_hit(via_native);
+                                }
+                                ++mismatches;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        check(mismatches == 0,
+              "the two touch entry points agree for " + kind_label(kind) +
+                  " (" + std::to_string(compared) + " points)",
+              first_bad);
+    }
+
+    // The premise the agreement rests on, measured rather than assumed: for
+    // every geometry the module produces, the window really is the logical
+    // surface times window_scale, so the window-space division is exactly a
+    // division by the scale.
+    int premise_failures = 0;
+    std::string premise_detail;
+    int premise_checked = 0;
+    for (NdsScreenLayoutKind kind : kinds) {
+        for (int scale : scales) {
+            for (int adaptive : adaptives) {
+                for (bool swap : {false, true}) {
+                    const NdsPresentationGeometry geometry =
+                        placed_presentation(kind, scale, adaptive, swap);
+                    if (!geometry.valid) continue;
+                    for (int window = 0; window < geometry.window_count;
+                         ++window) {
+                        ++premise_checked;
+                        if (geometry.window_width[window] !=
+                                geometry.logical_width[window] * scale ||
+                            geometry.window_height[window] !=
+                                geometry.logical_height[window] * scale) {
+                            ++premise_failures;
+                            if (premise_detail.empty()) {
+                                premise_detail = describe(geometry) + " at " +
+                                                 std::to_string(scale) + "x";
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    check(premise_failures == 0,
+          "every window is exactly its logical surface times the scale (" +
+              std::to_string(premise_checked) + " windows)",
+          premise_detail);
+}
+
+// The adaptive picture is stretched, so the logical mapping is proportional
+// rather than a copy: 256 DS columns across 448 canvas pixels is 1.75 canvas
+// pixels per DS column, and the picture's centre stays DS 128,96 at x 224.
+void check_hit_logical_adaptive() {
+    const NdsPresentationGeometry wide =
+        compute_presentation(kNdsLayoutStacked, 1, 448, false, false);
+    const Hit start = hit_native(wide, 0, 0.5f, 0.5f);
+    const Hit quarter = hit_native(wide, 0, 112.0f, 48.0f);
+    const Hit middle = hit_native(wide, 0, 224.0f, 96.0f);
+    const Hit end = hit_native(wide, 0, 447.5f, 191.5f);
+    check(start.hit && start.screen == kNdsScreenTop && start.ds_x == 0 &&
+              start.ds_y == 0 && quarter.hit && quarter.ds_x == 64 &&
+              quarter.ds_y == 48 && middle.hit && middle.ds_x == 128 &&
+              middle.ds_y == 96 && end.hit && end.ds_x == 255 &&
+              end.ds_y == 191,
+          "a 448-wide picture maps proportionally to DS pixels",
+          describe_hit(start) + " / " + describe_hit(quarter) + " / " +
+              describe_hit(middle) + " / " + describe_hit(end));
+
+    // The bottom picture of the same layout is not widened: it stays 256 wide,
+    // centred at x 96, and each of its columns is its own DS column.
+    const Hit bottom_start = hit_native(wide, 0, 96.5f, 192.5f);
+    const Hit bottom_middle = hit_native(wide, 0, 224.0f, 288.0f);
+    const Hit bottom_end = hit_native(wide, 0, 351.5f, 383.5f);
+    check(bottom_start.hit && bottom_start.screen == kNdsScreenBottom &&
+              bottom_start.ds_x == 0 && bottom_start.ds_y == 0 &&
+              bottom_middle.hit && bottom_middle.screen == kNdsScreenBottom &&
+              bottom_middle.ds_x == 128 && bottom_middle.ds_y == 96 &&
+              bottom_end.hit && bottom_end.screen == kNdsScreenBottom &&
+              bottom_end.ds_x == 255 && bottom_end.ds_y == 191,
+          "the un-widened bottom picture under it is an exact copy",
+          describe_hit(bottom_start) + " / " + describe_hit(bottom_middle) +
+              " / " + describe_hit(bottom_end));
+
+    const Hit left_of_bottom = hit_native(wide, 0, 95.5f, 288.0f);
+    const Hit right_of_bottom = hit_native(wide, 0, 352.5f, 288.0f);
+    check(!left_of_bottom.hit && !right_of_bottom.hit,
+          "the widened layout's side margins are misses in logical space",
+          describe_hit(left_of_bottom) + " / " + describe_hit(right_of_bottom));
+}
+
+// The reason the logical entry point exists. The window is resizable -- the
+// Fullscreen row resizes it -- so `window == logical * window_scale` holds when
+// the window opens and stops holding after the first drag. The geometry keeps
+// the size it was opened at while SDL keeps the logical surface fixed, so the
+// same physical point arrives as a DIFFERENT window coordinate and as the SAME
+// logical coordinate, and only the logical entry point still answers with the
+// pixel that is actually under the stylus.
+void check_hit_logical_resize() {
+    const NdsPresentationGeometry geometry =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    int screen = -1;
+    int ds_x = -1;
+    int ds_y = -1;
+
+    // While the window still has the size it asked for, both entry points are
+    // right: window (256, 192) is the top picture's centre, DS (128, 96).
+    const bool opened = screen_presentation_hit_test(
+        geometry, 0, 256.0f, 192.0f, &screen, &ds_x, &ds_y);
+    check(opened && screen == kNdsScreenTop && ds_x == 128 && ds_y == 96,
+          "at the size it asked for the window entry point is exact",
+          "screen " + std::to_string(screen) + " ds " +
+              std::to_string(ds_x) + "," + std::to_string(ds_y));
+
+    // The player drags the window to 800x600. SDL still maps points onto the
+    // fixed logical surface, so the picture centre is still logical (128, 96)
+    // and the logical entry point still answers DS (128, 96) -- it does not
+    // read the window size at all.
+    NdsPresentationGeometry dragged = geometry;
+    dragged.window_width[0] = 800;
+    dragged.window_height[0] = 600;
+    const Hit after = hit_native(dragged, 0, 128.0f, 96.0f);
+    check(after.hit && after.screen == kNdsScreenTop && after.ds_x == 128 &&
+              after.ds_y == 96,
+          "the logical answer does not move when the window is dragged",
+          describe_hit(after));
+
+    // Same physical point as window coordinates: after the drag the picture
+    // centre is window (400, 150). Handing that to the window entry point while
+    // the geometry still says 512x384 divides by the OLD ratio and lands on
+    // logical (200, 150) -- plausible, and 72 DS columns off. That is a stale
+    // factor, not a rounding error, and it is exactly what the logical entry
+    // point cannot do.
+    const bool stale = screen_presentation_hit_test(
+        geometry, 0, 400.0f, 150.0f, &screen, &ds_x, &ds_y);
+    check(stale && (ds_x != 128 || ds_y != 96),
+          "a stale window-space call lands on the wrong pixel after a drag",
+          "screen " + std::to_string(screen) + " ds " + std::to_string(ds_x) +
+              "," + std::to_string(ds_y));
+}
+
+void check_hit_logical_refusals() {
+    const NdsPresentationGeometry good =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    int screen = -7;
+    int ds_x = -7;
+    int ds_y = -7;
+
+    // A hit writes the DS pixel the caller handed it, with no scale applied.
+    const bool landed = screen_presentation_hit_test_logical(
+        good, 0, 10.0f, 20.0f, &screen, &ds_x, &ds_y);
+    check(landed && screen == kNdsScreenTop && ds_x == 10 && ds_y == 20,
+          "a logical hit is an identity mapping on an un-widened picture",
+          "screen " + std::to_string(screen) + " ds " + std::to_string(ds_x) +
+              "," + std::to_string(ds_y));
+
+    // And a miss writes nothing, exactly as the window-space entry point
+    // promises, so the two cannot differ in what a failed touch leaves behind.
+    screen = -7;
+    ds_x = -7;
+    ds_y = -7;
+    const bool miss = screen_presentation_hit_test_logical(
+        good, 0, 300.0f, 300.0f, &screen, &ds_x, &ds_y);
+    check(!miss && screen == -7 && ds_x == -7 && ds_y == -7,
+          "a logical miss writes nothing to the out parameters",
+          "screen " + std::to_string(screen) + " ds " +
+              std::to_string(ds_x) + "," + std::to_string(ds_y));
+
+    check(!screen_presentation_hit_test_logical(good, 0, 10.0f, 10.0f, nullptr,
+                                                &ds_x, &ds_y),
+          "a null screen pointer is a logical miss, not a crash", "got a hit");
+    check(!screen_presentation_hit_test_logical(good, 0, 10.0f, 10.0f, &screen,
+                                                nullptr, &ds_y),
+          "a null ds_x pointer is a logical miss", "got a hit");
+    check(!screen_presentation_hit_test_logical(good, 0, 10.0f, 10.0f, &screen,
+                                                &ds_x, nullptr),
+          "a null ds_y pointer is a logical miss", "got a hit");
+    check(!screen_presentation_hit_test_logical(good, 1, 10.0f, 10.0f, &screen,
+                                                &ds_x, &ds_y),
+          "a layout has no window 1 in logical space either", "got a hit");
+    const NdsPresentationGeometry refused =
+        compute_presentation(kNdsLayoutStacked, 0, 0, false, false);
+    check(!screen_presentation_hit_test_logical(refused, 0, 10.0f, 10.0f,
+                                                &screen, &ds_x, &ds_y),
+          "a refused geometry misses in logical space too", "got a hit");
+
+    // The one deliberate difference, and the whole point of the entry point: a
+    // geometry with no window size still maps logical points, because the
+    // logical surface and the rects are all it needs. The window-space entry
+    // point cannot undo a ratio it does not know, so it refuses.
+    NdsPresentationGeometry sizeless{};
+    sizeless.canvas_width = 256;
+    sizeless.canvas_height = 384;
+    sizeless.logical_width[0] = 256;
+    sizeless.logical_height[0] = 384;
+    sizeless.screen_rect[kNdsScreenTop] = NdsScreenRect{0, 0, 256, 192};
+    sizeless.screen_rect[kNdsScreenBottom] = NdsScreenRect{0, 192, 256, 192};
+    sizeless.visible[kNdsScreenTop] = true;
+    sizeless.visible[kNdsScreenBottom] = true;
+    sizeless.window_count = 1;
+    sizeless.valid = true;
+    const Hit mapped = hit_native(sizeless, 0, 128.0f, 96.0f);
+    check(mapped.hit && mapped.screen == kNdsScreenTop && mapped.ds_x == 128 &&
+              mapped.ds_y == 96,
+          "a geometry without a window size still maps logical points",
+          describe_hit(mapped));
+    check(!screen_presentation_hit_test(sizeless, 0, 128.0f, 96.0f, &screen,
+                                        &ds_x, &ds_y),
+          "the window entry point refuses a geometry with no window size",
+          "got a hit");
+
+    // The shared guards have to reject hand-built geometries too, because the
+    // frontend's preview code assembles them itself. Three windows is not a
+    // shape this module can draw, even though window 0 holds a good rect.
+    NdsPresentationGeometry three_windows{};
+    three_windows.canvas_width = 256;
+    three_windows.canvas_height = 192;
+    three_windows.logical_width[0] = 256;
+    three_windows.logical_height[0] = 192;
+    three_windows.window_width[0] = 256;
+    three_windows.window_height[0] = 192;
+    three_windows.screen_rect[kNdsScreenTop] = NdsScreenRect{0, 0, 256, 192};
+    three_windows.visible[kNdsScreenTop] = true;
+    three_windows.window_count = 3;
+    three_windows.valid = true;
+    check(!screen_presentation_hit_test(three_windows, 0, 128.0f, 96.0f,
+                                        &screen, &ds_x, &ds_y),
+          "a three-window geometry hits nothing in window space", "got a hit");
+    check(!screen_presentation_hit_test_logical(three_windows, 0, 128.0f, 96.0f,
+                                                &screen, &ds_x, &ds_y),
+          "a three-window geometry hits nothing in logical space",
+          "got a hit");
+
+    // A zero logical surface would divide by zero on the way to window space,
+    // so the shared guard has to refuse it before any arithmetic runs. The
+    // rects and the window size are deliberately all valid.
+    NdsPresentationGeometry flat{};
+    flat.canvas_width = 256;
+    flat.canvas_height = 192;
+    flat.logical_width[0] = 0;
+    flat.logical_height[0] = 0;
+    flat.window_width[0] = 256;
+    flat.window_height[0] = 192;
+    flat.screen_rect[kNdsScreenTop] = NdsScreenRect{0, 0, 256, 192};
+    flat.visible[kNdsScreenTop] = true;
+    flat.window_count = 1;
+    flat.valid = true;
+    check(!screen_presentation_hit_test(flat, 0, 128.0f, 96.0f, &screen, &ds_x,
+                                        &ds_y),
+          "a zero logical surface hits nothing in window space", "got a hit");
+    check(!screen_presentation_hit_test_logical(flat, 0, 128.0f, 96.0f, &screen,
+                                                &ds_x, &ds_y),
+          "a zero logical surface hits nothing in logical space either",
+          "got a hit");
+}
+
+// ---------------------------------------------------------------------------
+// The contract, as loops over the whole input space
+// ---------------------------------------------------------------------------
+
+void check_contract() {
+    const NdsScreenLayoutKind kinds[] = {
+        kNdsLayoutStacked,           kNdsLayoutSideBySide,
+        kNdsLayoutTopOnly,           kNdsLayoutBottomOnly,
+        kNdsLayoutSquare,            kNdsPresentationSeparateWindows};
+    const int scales[] = {0, 1, 2, 3, 4, 16, 17};
+    const int adaptives[] = {0, 256, 258, 300, 448, 255, 257, 449};
+
+    int inside_violations = 0;
+    int overlap_violations = 0;
+    int scale_violations = 0;
+    int visibility_violations = 0;
+    int canvas_violations = 0;
+    int mode_violations = 0;
+    int valid_count = 0;
+    std::string first;
+
+    for (NdsScreenLayoutKind kind : kinds) {
+        for (int scale : scales) {
+            for (int adaptive : adaptives) {
+                for (bool swap : {false, true}) {
+                    for (bool second : {false, true}) {
+                        const NdsPresentationGeometry geometry =
+                            compute_presentation(kind, scale, adaptive, swap,
+                                                 second);
+                        if (!geometry.valid) continue;
+                        ++valid_count;
+                        if (first.empty()) first = describe(geometry);
+
+                        // 1. Every picture lies inside its logical surface.
+                        for (int slot = 0; slot < 2; ++slot) {
+                            const NdsScreenRect& rect =
+                                geometry.screen_rect[slot];
+                            if (!geometry.visible[slot]) continue;
+                            const int window =
+                                geometry.separate_windows ? slot : 0;
+                            if (rect.x < 0 || rect.y < 0 ||
+                                rect.x + rect.width >
+                                    geometry.logical_width[window] ||
+                                rect.y + rect.height >
+                                    geometry.logical_height[window] ||
+                                rect.width <= 0 || rect.height <= 0) {
+                                ++inside_violations;
+                            }
+                        }
+                        // 2. Two pictures in one surface never overlap. In
+                        // two-window mode each rect lives in its own window, so
+                        // the two are allowed to coincide.
+                        const NdsScreenRect& a =
+                            geometry.screen_rect[kNdsScreenTop];
+                        const NdsScreenRect& b =
+                            geometry.screen_rect[kNdsScreenBottom];
+                        if (!geometry.separate_windows &&
+                            geometry.visible[kNdsScreenTop] &&
+                            geometry.visible[kNdsScreenBottom] &&
+                            a.x < b.x + b.width && b.x < a.x + a.width &&
+                            a.y < b.y + b.height && b.y < a.y + a.height) {
+                            ++overlap_violations;
+                        }
+                        // 3. The window is exactly the logical surface times
+                        // window_scale, for every window that exists.
+                        for (int window = 0; window < geometry.window_count;
+                             ++window) {
+                            if (geometry.window_width[window] !=
+                                    geometry.logical_width[window] * scale ||
+                                geometry.window_height[window] !=
+                                    geometry.logical_height[window] * scale) {
+                                ++scale_violations;
+                            }
+                        }
+                        // 4. Visibility agrees with the rectangles: visible
+                        // means a real rect, hidden means all zeros.
+                        for (int slot = 0; slot < 2; ++slot) {
+                            const NdsScreenRect& rect =
+                                geometry.screen_rect[slot];
+                            const bool has_area =
+                                rect.width > 0 && rect.height > 0;
+                            if (has_area != geometry.visible[slot]) {
+                                ++visibility_violations;
+                            }
+                        }
+                        // 5. The canvas and the logical surface agree: a layout
+                        // draws both screens on one canvas, two-window mode
+                        // gives each window one screen.
+                        if (geometry.separate_windows) {
+                            if (geometry.logical_width[0] != 256 ||
+                                geometry.logical_height[0] != 192 ||
+                                geometry.logical_width[1] != 256 ||
+                                geometry.logical_height[1] != 192) {
+                                ++canvas_violations;
+                            }
+                        } else if (geometry.logical_width[0] !=
+                                       geometry.canvas_width ||
+                                   geometry.logical_height[0] !=
+                                       geometry.canvas_height) {
+                            ++canvas_violations;
+                        }
+                        // 6. A one-window geometry has one window, and the
+                        // two-window mode has two.
+                        const int want = geometry.separate_windows ? 2 : 1;
+                        if (geometry.window_count != want) ++mode_violations;
+                    }
+                }
+            }
+        }
+    }
+
+    // 1,344 requests, of which exactly 100 are accepted: 5 valid scales x 2
+    // swaps x (5 adaptive widths for stacked, the plain one for the other four
+    // layouts) for the one-window layouts, plus the two-window mode. The rest
+    // are refusals, and those are counted by the leftover check below.
+    check(valid_count == 100,
+          "the contract loop covered 100 valid and 1,244 refused requests",
+          std::to_string(valid_count) + " valid");
+    check(inside_violations == 0, "every picture is inside its surface",
+          std::to_string(inside_violations) + " violations, first " + first);
+    check(overlap_violations == 0, "the two pictures never overlap",
+          std::to_string(overlap_violations) + " violations, first " + first);
+    check(scale_violations == 0,
+          "the window is exactly the logical surface times window_scale",
+          std::to_string(scale_violations) + " violations, first " + first);
+    check(visibility_violations == 0,
+          "visible agrees with a non-empty rect, hidden with an empty one",
+          std::to_string(visibility_violations) + " violations, first " +
+              first);
+    check(canvas_violations == 0,
+          "the logical surface is the canvas, or one screen in two-window mode",
+          std::to_string(canvas_violations) + " violations, first " + first);
+    check(mode_violations == 0,
+          "window_count matches the presentation mode",
+          std::to_string(mode_violations) + " violations, first " + first);
+
+    // A refused result never leaves a field behind, whatever the reason was.
+    int leftovers = 0;
+    std::string first_leftover;
+    for (NdsScreenLayoutKind kind : kinds) {
+        for (int scale : scales) {
+            for (int adaptive : adaptives) {
+                for (bool swap : {false, true}) {
+                    const NdsPresentationGeometry geometry =
+                        compute_presentation(kind, scale, adaptive, swap, true);
+                    if (geometry.valid) continue;
+                    if (!is_refused(geometry)) {
+                        if (leftovers == 0) first_leftover = describe(geometry);
+                        ++leftovers;
+                    }
+                }
+            }
+        }
+    }
+    check(leftovers == 0, "a refusal zeroes every field",
+          std::to_string(leftovers) + " with leftovers, first " +
+              first_leftover);
+}
+
+// ---------------------------------------------------------------------------
+// Determinism
+// ---------------------------------------------------------------------------
+
+// FNV-1a over 32-bit words in little-endian byte order. Two independent
+// implementations (this one and a Python model of the header) produced the
+// pinned constants, so a change in either the geometry or the touch mapping
+// moves a digest even when every hand-pinned case above still passes.
+struct Digest {
+    std::uint64_t hash;
+    long words;
+
+    Digest() : hash(0xCBF29CE484222325ull), words(0) {}
+
+    void add(int value) {
+        const std::uint32_t bits = static_cast<std::uint32_t>(value);
+        for (int byte = 0; byte < 4; ++byte) {
+            hash ^= (bits >> (byte * 8)) & 0xFFu;
+            hash *= 0x100000001B3ull;
+        }
+        ++words;
+    }
+};
+
+void add_geometry_words(Digest* digest,
+                        const NdsPresentationGeometry& geometry) {
+    digest->add(geometry.valid ? 1 : 0);
+    digest->add(geometry.canvas_width);
+    digest->add(geometry.canvas_height);
+    digest->add(geometry.window_width[0]);
+    digest->add(geometry.window_height[0]);
+    digest->add(geometry.logical_width[0]);
+    digest->add(geometry.logical_height[0]);
+    digest->add(geometry.window_width[1]);
+    digest->add(geometry.window_height[1]);
+    digest->add(geometry.logical_width[1]);
+    digest->add(geometry.logical_height[1]);
+    for (int slot = 0; slot < 2; ++slot) {
+        digest->add(geometry.screen_rect[slot].x);
+        digest->add(geometry.screen_rect[slot].y);
+        digest->add(geometry.screen_rect[slot].width);
+        digest->add(geometry.screen_rect[slot].height);
+    }
+    digest->add(geometry.visible[0] ? 1 : 0);
+    digest->add(geometry.visible[1] ? 1 : 0);
+    digest->add(geometry.window_count);
+    digest->add(geometry.separate_windows ? 1 : 0);
+}
+
+void check_determinism() {
+    const int kinds[] = {-1, 0, 1, 2, 3, 4, 5, 6, 99};
+    const int scales[] = {0, 1, 2, 3, 4, 16, 17};
+    const int adaptives[] = {0, 256, 258, 300, 448, 254, 257, 450};
+
+    Digest geometry_digest;
+    Digest hit_digest;
+    Digest logical_digest;
+    for (int kind : kinds) {
+        for (int scale : scales) {
+            for (int adaptive : adaptives) {
+                for (bool swap : {false, true}) {
+                    for (bool second : {false, true}) {
+                        const NdsPresentationGeometry geometry =
+                            compute_presentation(
+                                static_cast<NdsScreenLayoutKind>(kind), scale,
+                                adaptive, swap, second);
+                        add_geometry_words(&geometry_digest, geometry);
+                        if (!geometry.valid) continue;
+                        const float canvas_width_value =
+                            static_cast<float>(geometry.canvas_width);
+                        const float canvas_height_value =
+                            static_cast<float>(geometry.canvas_height);
+                        for (int window = 0; window < geometry.window_count;
+                             ++window) {
+                            for (int gy = 0; gy < 5; ++gy) {
+                                for (int gx = 0; gx < 5; ++gx) {
+                                    const float x = static_cast<float>(
+                                        geometry.window_width[window]) *
+                                        static_cast<float>(gx) / 4.0f;
+                                    const float y = static_cast<float>(
+                                        geometry.window_height[window]) *
+                                        static_cast<float>(gy) / 4.0f;
+                                    int screen = -1;
+                                    int ds_x = -1;
+                                    int ds_y = -1;
+                                    const bool hit =
+                                        screen_presentation_hit_test(
+                                            geometry, window, x, y, &screen,
+                                            &ds_x, &ds_y);
+                                    hit_digest.add(hit ? 1 : 0);
+                                    hit_digest.add(screen);
+                                    hit_digest.add(ds_x);
+                                    hit_digest.add(ds_y);
+                                    const float logical_x =
+                                        canvas_width_value *
+                                        static_cast<float>(gx) / 4.0f;
+                                    const float logical_y =
+                                        canvas_height_value *
+                                        static_cast<float>(gy) / 4.0f;
+                                    int logical_screen = -1;
+                                    int logical_ds_x = -1;
+                                    int logical_ds_y = -1;
+                                    const bool logical_hit =
+                                        screen_presentation_hit_test_logical(
+                                            geometry, window, logical_x,
+                                            logical_y, &logical_screen,
+                                            &logical_ds_x, &logical_ds_y);
+                                    logical_digest.add(logical_hit ? 1 : 0);
+                                    logical_digest.add(logical_screen);
+                                    logical_digest.add(logical_ds_x);
+                                    logical_digest.add(logical_ds_y);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    char detail[128];
+    std::snprintf(detail, sizeof(detail), "%ld words, digest %016llX",
+                  geometry_digest.words,
+                  static_cast<unsigned long long>(geometry_digest.hash));
+    check(geometry_digest.words == 46368 &&
+              geometry_digest.hash == 0x5FBC8F59A43EE859ull,
+          "the geometry digest over 2,016 configurations is unchanged",
+          detail);
+    std::snprintf(detail, sizeof(detail), "%ld words, digest %016llX",
+                  hit_digest.words,
+                  static_cast<unsigned long long>(hit_digest.hash));
+    check(hit_digest.words == 26000 &&
+              hit_digest.hash == 0x3B0B86247B2A2C15ull,
+          "the window-space hit-test digest over 6,500 samples is unchanged",
+          detail);
+    std::snprintf(detail, sizeof(detail), "%ld words, digest %016llX",
+                  logical_digest.words,
+                  static_cast<unsigned long long>(logical_digest.hash));
+    check(logical_digest.words == 26000 &&
+              logical_digest.hash == 0x3B0B86247B2A2C15ull,
+          "the logical-space hit-test digest over 6,500 samples is unchanged",
+          detail);
+    // The two coordinate spaces are the same mapping, so the same sampled point
+    // (a quarter of the canvas in logical space, a quarter of the window in
+    // window space) must produce the identical stream. This is the agreement
+    // property again, now over the whole sweep and in one line: a change that
+    // made the logical path divide by the window ratio would move it.
+    check(logical_digest.hash == hit_digest.hash,
+          "both coordinate spaces hash to the same stream over the sweep",
+          std::string("window ") + std::to_string(hit_digest.hash) +
+              " logical " + std::to_string(logical_digest.hash));
+
+    // Same input, same answer: no hidden state between calls.
+    const NdsPresentationGeometry first =
+        compute_presentation(kNdsLayoutSquare, 3, 0, true, false);
+    for (int repeat = 0; repeat < 5; ++repeat) {
+        const NdsPresentationGeometry again =
+            compute_presentation(kNdsLayoutSquare, 3, 0, true, false);
+        if (describe(again) != describe(first)) {
+            check(false, "repeated calls return the same geometry",
+                  describe(again));
+            return;
+        }
+    }
+    check(true, "repeated calls return the same geometry", "");
+}
+
+// ---------------------------------------------------------------------------
+// The four calls the frontend hard-codes
+// ---------------------------------------------------------------------------
+
+void check_frontend_calls() {
+    // stacked at 2x: the default presentation, 512x768 window.
+    const NdsPresentationGeometry stacked =
+        compute_presentation(kNdsLayoutStacked, 2, 0, false, false);
+    check(stacked.valid && stacked.canvas_width == 256 &&
+              stacked.canvas_height == 384 && stacked.window_width[0] == 512 &&
+              stacked.window_height[0] == 768 &&
+              stacked.logical_width[0] == 256 &&
+              stacked.logical_height[0] == 384 &&
+              rect_is(stacked.screen_rect[kNdsScreenTop], 0, 0, 256, 192) &&
+              rect_is(stacked.screen_rect[kNdsScreenBottom], 0, 192, 256, 192),
+          "frontend: stacked at 2x", describe(stacked));
+
+    // side-by-side at 1x, swapped: the top screen moves to the right half.
+    const NdsPresentationGeometry side = compute_presentation(
+        kNdsLayoutSideBySide, 1, 0, true, false);
+    check(side.valid && side.canvas_width == 512 && side.canvas_height == 192 &&
+              side.window_width[0] == 512 && side.window_height[0] == 192 &&
+              rect_is(side.screen_rect[kNdsScreenTop], 256, 0, 256, 192) &&
+              rect_is(side.screen_rect[kNdsScreenBottom], 0, 0, 256, 192),
+          "frontend: side-by-side at 1x swapped", describe(side));
+
+    // top-only at 3x: one 768x576 window, bottom screen hidden.
+    const NdsPresentationGeometry top = compute_presentation(
+        kNdsLayoutTopOnly, 3, 0, false, false);
+    check(top.valid && top.canvas_width == 256 && top.canvas_height == 192 &&
+              top.window_width[0] == 768 && top.window_height[0] == 576 &&
+              rect_is(top.screen_rect[kNdsScreenTop], 0, 0, 256, 192) &&
+              rect_is(top.screen_rect[kNdsScreenBottom], 0, 0, 0, 0) &&
+              top.visible[kNdsScreenTop] && !top.visible[kNdsScreenBottom] &&
+              top.window_count == 1,
+          "frontend: top only at 3x", describe(top));
+
+    // two windows at 2x: two 512x384 windows, one screen each.
+    const NdsPresentationGeometry separate = compute_presentation(
+        kNdsPresentationSeparateWindows, 2, 0, false, false);
+    check(separate.valid && separate.window_count == 2 &&
+              separate.separate_windows && separate.window_width[0] == 512 &&
+              separate.window_height[0] == 384 &&
+              separate.window_width[1] == 512 &&
+              separate.window_height[1] == 384 &&
+              separate.logical_width[0] == 256 &&
+              separate.logical_height[0] == 192 &&
+              rect_is(separate.screen_rect[kNdsScreenTop], 0, 0, 256, 192) &&
+              separate.visible[kNdsScreenTop] &&
+              separate.visible[kNdsScreenBottom],
+          "frontend: two windows at 2x", describe(separate));
+}
