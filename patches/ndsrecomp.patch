+
+    // ---- 9. Applying replacements. --------------------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+
+        // Same size: the bytes land exactly where the file is, and the
+        // allocation table is untouched.
+        const fs::path same = root / "same.bin";
+        const std::vector<std::uint8_t> replacement =
+            bytes_of("0123456789abcdef");
+        if (!write_file(same, replacement))
+            return fail("the same-size replacement file could be written", "");
+        ok("the same-size replacement file could be written");
+
+        std::vector<std::uint8_t> image = built.image;
+        std::vector<std::string> diagnostics;
+        const bool applied = nds_nitrofs::nitrofs_apply_overrides(
+            image.data(), image.size(), parsed,
+            {{"TITLE.BIN", same.string()}}, &diagnostics);
+        if (!require(applied))
+            return fail("a same-size replacement is applied",
+                        show(diagnostics));
+        ok("a same-size replacement is applied");
+
+        if (!require(diagnostics.empty()))
+            return fail("a same-size replacement says nothing",
+                        show(diagnostics));
+        ok("a same-size replacement says nothing");
+
+        if (!require(read_range(image, built.fat[0].first, 16u) == replacement))
+            return fail("the replacement lands byte for byte", "");
+        ok("the replacement lands byte for byte");
+
+        if (!require(read_range(image, built.fat_offset,
+                                built.fat_entries * 8u) ==
+                     read_range(built.image, built.fat_offset,
+                                built.fat_entries * 8u)))
+            return fail("the allocation table is not touched", "");
+        ok("the allocation table is not touched");
+
+        // The case does not have to match the cartridge: a manifest is written
+        // by hand.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"title.bin", same.string()}}, &diagnostics)))
+            return fail("a lowercase path in a manifest still lands",
+                        show(diagnostics));
+        ok("a lowercase path in a manifest still lands");
+
+        // Shorter: the covered bytes change, the rest keep their old value.
+        const fs::path shorter = root / "shorter.bin";
+        if (!write_file(shorter, bytes_of("XYZW")))
+            return fail("the short replacement file could be written", "");
+        ok("the short replacement file could be written");
+
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"DATA/ONE.BIN", shorter.string()}}, &diagnostics)))
+            return fail("a shorter replacement is applied", show(diagnostics));
+        ok("a shorter replacement is applied");
+
+        const std::vector<std::uint8_t> tail =
+            read_range(image, built.fat[1].first + 4u, 28u);
+        if (!require(tail == read_range(built.image, built.fat[1].first + 4u,
+                                        28u)))
+            return fail("the bytes a short replacement does not cover are "
+                        "left alone",
+                        "");
+        ok("the bytes a short replacement does not cover are left alone");
+
+        if (!require(read_range(image, built.fat[1].first, 4u) ==
+                     bytes_of("XYZW")))
+            return fail("a short replacement lands at the start of the file",
+                        "");
+        ok("a short replacement lands at the start of the file");
+
+        // Longer: refused, by name and by both sizes, and nothing is written.
+        const fs::path longer = root / "longer.bin";
+        if (!write_file(longer, bytes_of("0123456789ABCDEFG")))
+            return fail("the long replacement file could be written", "");
+        ok("the long replacement file could be written");
+
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", longer.string()}}, &diagnostics)))
+            return fail("a longer replacement is refused", "");
+        ok("a longer replacement is refused");
+
+        if (!require(diagnostics.size() == 1u))
+            return fail("a longer replacement says one thing",
+                        show(diagnostics));
+        ok("a longer replacement says one thing");
+
+        if (!require(diagnostics[0].find("TITLE.BIN") != std::string::npos &&
+                     diagnostics[0].find("17") != std::string::npos &&
+                     diagnostics[0].find("16") != std::string::npos))
+            return fail("a longer replacement names the file and both sizes",
+                        show(diagnostics));
+        ok("a longer replacement names the file and both sizes");
+
+        if (!require(image == built.image))
+            return fail("a refused replacement writes nothing", "");
+        ok("a refused replacement writes nothing");
+
+        // An unknown game path.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"NOPE.BIN", same.string()}}, &diagnostics)))
+            return fail("an unknown game path is refused", "");
+        ok("an unknown game path is refused");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("NOPE.BIN") != std::string::npos))
+            return fail("an unknown game path is named", show(diagnostics));
+        ok("an unknown game path is named");
+
+        // A host file that is not there.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", (root / "absent.bin").string()}}, &diagnostics)))
+            return fail("a missing replacement file is refused", "");
+        ok("a missing replacement file is refused");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("absent.bin") != std::string::npos))
+            return fail("a missing replacement file is named",
+                        show(diagnostics));
+        ok("a missing replacement file is named");
+
+        // A replacement path that is a directory, not a file.
+        std::error_code error;
+        fs::create_directories(root / "a-directory", error);
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", (root / "a-directory").string()}},
+                &diagnostics)))
+            return fail("a replacement that is a directory is refused", "");
+        ok("a replacement that is a directory is refused");
+
+        // The same game path twice: the first is kept, the second refused.
+        const fs::path first_bytes = root / "first.bin";
+        if (!write_file(first_bytes, bytes_of("AAAAAAAAAAAAAAAA")))
+            return fail("the first of two replacement files could be written",
+                        "");
+        ok("the first of two replacement files could be written");
+
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", first_bytes.string()},
+                 {"title.bin", same.string()}},
+                &diagnostics)))
+            return fail("a game path named twice is refused", "");
+        ok("a game path named twice is refused");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("more than once") !=
+                         std::string::npos))
+            return fail("a repeated game path is explained",
+                        show(diagnostics));
+        ok("a repeated game path is explained");
+        if (!require(read_range(image, built.fat[0].first, 16u) ==
+                     bytes_of("AAAAAAAAAAAAAAAA")))
+            return fail("the first replacement of a repeated path is kept",
+                        "");
+        ok("the first replacement of a repeated path is kept");
+
+        // A path the file table could never contain.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"../escape.bin", same.string()}}, &diagnostics)))
+            return fail("an escaping game path is refused", "");
+        ok("an escaping game path is refused");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("../escape.bin") != std::string::npos))
+            return fail("an escaping game path is named", show(diagnostics));
+        ok("an escaping game path is named");
+
+        // ... and refused as a path, not merely as a path the cartridge does
+        // not happen to have. Those are different mistakes and a player fixing
+        // a manifest needs to be told which one they made.
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("not a path a cartridge file can "
+                                         "have") != std::string::npos))
+            return fail("an escaping path is refused for what it is, not for "
+                        "what it misses",
+                        show(diagnostics));
+        ok("an escaping path is refused for what it is, not for what it "
+           "misses");
+
+        // The same for a traversal in the middle of an otherwise real path: a
+        // reader that only fails to match would report a missing file here.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"DATA/../TITLE.BIN", same.string()}}, &diagnostics)))
+            return fail("a traversal in the middle of a path is refused", "");
+        ok("a traversal in the middle of a path is refused");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("not a path a cartridge file can "
+                                         "have") != std::string::npos))
+            return fail("a mid-path traversal is refused as a path",
+                        show(diagnostics));
+        ok("a mid-path traversal is refused as a path");
+
+        // No diagnostics wanted, and none required: the refusal still happens.
+        image = built.image;
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"NOPE.BIN", same.string()}}, nullptr)))
+            return fail("a refusal works without a diagnostics sink", "");
+        ok("a refusal works without a diagnostics sink");
+
+        // An empty replacement file is legal and changes nothing, because the
+        // file simply keeps every byte it had.
+        const fs::path empty = root / "empty.bin";
+        if (!write_file(empty, std::vector<std::uint8_t>()))
+            return fail("an empty replacement file could be written", "");
+        ok("an empty replacement file could be written");
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", empty.string()}}, &diagnostics)))
+            return fail("an empty replacement is accepted and changes nothing",
+                        show(diagnostics));
+        ok("an empty replacement is accepted and changes nothing");
+        if (!require(image == built.image))
+            return fail("an empty replacement leaves the image identical", "");
+        ok("an empty replacement leaves the image identical");
+
+        // A caller may hold the parse of one buffer and pass a smaller one.
+        std::vector<std::uint8_t> short_image =
+            read_range(built.image, 0u, built.fat[0].first + 4u);
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                short_image.data(), short_image.size(), parsed,
+                {{"TITLE.BIN", same.string()}}, &diagnostics)))
+            return fail("a buffer smaller than the file is refused", "");
+        ok("a buffer smaller than the file is refused");
+
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                nullptr, built.image.size(), parsed,
+                {{"TITLE.BIN", same.string()}}, nullptr)))
+            return fail("a null image is refused", "");
+        ok("a null image is refused");
+
+        // Several replacements at once, each landing in its own file.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", same.string()},
+                 {"DATA/ONE.BIN", same.string()}},
+                &diagnostics)))
+            return fail("two replacements in one call both land",
+                        show(diagnostics));
+        ok("two replacements in one call both land");
+        if (!require(read_range(image, built.fat[1].first, 16u) == replacement))
+            return fail("the second replacement lands in its own file", "");
+        ok("the second replacement lands in its own file");
+
+        // An empty pair list is a no-op that reports success.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed, {}, &diagnostics)))
+            return fail("no replacements at all is not a failure", "");
+        ok("no replacements at all is not a failure");
+        if (!require(image == built.image && diagnostics.empty()))
+            return fail("no replacements at all changes nothing", "");
+        ok("no replacements at all changes nothing");
+    }
+
+    // ---- 10. A larger tree. ---------------------------------------------
+    {
+        // Three levels, with files at each one, so a file id has to be right at
+        // every depth rather than only in the first subdirectory.
+        //
+        //   ROOT.BIN            id 0
+        //   A/AFILE.BIN         id 1
+        //   A/B/BFILE.BIN       id 2
+        //   A/B/C/CFILE.BIN     id 3
+        //   A/B/C2/DFILE.BIN    id 4
+        //   AB/EFILE.BIN        id 5
+        RomSpec spec;
+        spec.root.files.push_back(FileSpec{"ROOT.BIN", 0, 8u, 0x10u});
+        DirSpec a;
+        a.name = "A";
+        a.files.push_back(FileSpec{"AFILE.BIN", 1, 8u, 0x20u});
+        DirSpec b;
+        b.name = "B";
+        b.files.push_back(FileSpec{"BFILE.BIN", 2, 8u, 0x30u});
+        DirSpec c;
+        c.name = "C";
+        c.files.push_back(FileSpec{"CFILE.BIN", 3, 8u, 0x40u});
+        DirSpec c2;
+        c2.name = "C2";
+        c2.files.push_back(FileSpec{"DFILE.BIN", 4, 8u, 0x50u});
+        b.dirs.push_back(c);
+        b.dirs.push_back(c2);
+        a.dirs.push_back(b);
+        spec.root.dirs.push_back(a);
+        DirSpec ab;
+        ab.name = "AB";
+        ab.files.push_back(FileSpec{"EFILE.BIN", 5, 8u, 0x60u});
+        spec.root.dirs.push_back(ab);
+
+        const BuiltRom built = build_rom(spec);
+        const NdsNitroFs parsed = parse_of(built);
+
+        if (!require(parsed.ok))
+            return fail("a three-level tree parses without complaint",
+                        describe(parsed));
+        ok("a three-level tree parses without complaint");
+
+        if (!require(parsed.files.size() == 6u))
+            return fail("every file at every depth is listed",
+                        describe(parsed));
+        ok("every file at every depth is listed");
+
+        if (!require(parsed.directories == 6))
+            return fail("every directory at every depth is counted",
+                        describe(parsed));
+        ok("every directory at every depth is counted");
+
+        const char* const expected[] = {
+            "ROOT.BIN",          "A/AFILE.BIN",     "A/B/BFILE.BIN",
+            "A/B/C/CFILE.BIN",   "A/B/C2/DFILE.BIN", "AB/EFILE.BIN",
+        };
+        bool paths_ok = true;
+        std::string first_bad;
+        for (std::size_t i = 0; i < parsed.files.size() && i < 6u; ++i) {
+            if (parsed.files[i].path != expected[i] ||
+                parsed.files[i].id != static_cast<int>(i)) {
+                paths_ok = false;
+                first_bad = parsed.files[i].path + " id " +
+                            number_text(static_cast<std::uint64_t>(
+                                parsed.files[i].id));
+                break;
+            }
+        }
+        if (!require(paths_ok))
+            return fail("each path and id matches the tree", first_bad);
+        ok("each path and id matches the tree");
+
+        // A sibling whose name starts with another directory's name must not be
+        // mistaken for a child of it. This is the case a string-prefix
+        // comparison gets wrong.
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "AB/EFILE.BIN",
+                                                 nullptr)))
+            return fail("a sibling with a shared prefix is still reachable",
+                        "");
+        ok("a sibling with a shared prefix is still reachable");
+
+        if (!require(!nds_nitrofs::nitrofs_lookup(parsed, "A/EFILE.BIN",
+                                                  nullptr)))
+            return fail("a file is not reachable through the wrong sibling",
+                        "");
+        ok("a file is not reachable through the wrong sibling");
+
+        if (!require(!nds_nitrofs::nitrofs_lookup(parsed, "A/B/CFILE.BIN",
+                                                  nullptr)))
+            return fail("a file is not reachable one level too shallow", "");
+        ok("a file is not reachable one level too shallow");
+
+        if (!require(!nds_nitrofs::nitrofs_lookup(parsed, "A/B/C/DFILE.BIN",
+                                                  nullptr)))
+            return fail("a file is not reachable through the wrong parent", "");
+        ok("a file is not reachable through the wrong parent");
+
+        NdsNitroFsEntry found;
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "a/b/c2/dfile.bin",
+                                                 &found) &&
+                     found.id == 4))
+            return fail("a deep path is matched without regard to case",
+                        describe(parsed));
+        ok("a deep path is matched without regard to case");
+    }
+
+    // ---- 11. Names the format allows. -----------------------------------
+    {
+        // The longest name a length byte can describe, a name with a space in
+        // it, and a name that is not ASCII: a player's replacement pack can
+        // have all three, and none of them may be mangled on the way through.
+        const std::string longest(127u, 'L');
+        const std::string wide = "\xE3\x83\xA2\xE3\x83\x83\xE3\x83\x89.BIN";
+        RomSpec spec;
+        spec.root.files.push_back(FileSpec{longest, 0, 8u, 0x10u});
+        spec.root.files.push_back(FileSpec{"WITH SPACE.BIN", 1, 8u, 0x20u});
+        spec.root.files.push_back(FileSpec{wide, 2, 8u, 0x30u});
+        const BuiltRom built = build_rom(spec);
+        const NdsNitroFs parsed = parse_of(built);
+
+        if (!require(parsed.ok))
+            return fail("the longest name the format allows parses",
+                        describe(parsed));
+        ok("the longest name the format allows parses");
+
+        if (!require(parsed.files.size() == 3u))
+            return fail("all three unusual names are listed", describe(parsed));
+        ok("all three unusual names are listed");
+
+        if (!require(parsed.files[0].path == longest))
+            return fail("a 127-byte name comes back whole",
+                        quote(parsed.files[0].path));
+        ok("a 127-byte name comes back whole");
+
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "WITH SPACE.BIN",
+                                                 nullptr)))
+            return fail("a name with a space is matched", "");
+        ok("a name with a space is matched");
+
+        if (!require(parsed.files[2].path == wide))
+            return fail("a multi-byte name comes back byte for byte",
+                        quote(parsed.files[2].path));
+        ok("a multi-byte name comes back byte for byte");
+
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, wide, nullptr)))
+            return fail("a multi-byte name can be looked up", "");
+        ok("a multi-byte name can be looked up");
+
+        // Case folding is ASCII only. Lowercasing the ASCII extension of a
+        // multi-byte name still matches -- that is the fold doing its job.
+        std::string lowered = wide;
+        lowered[lowered.size() - 3u] = 'b';
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, lowered, nullptr)))
+            return fail("an ASCII extension is folded around a multi-byte stem",
+                        quote(lowered));
+        ok("an ASCII extension is folded around a multi-byte stem");
+
+        // Changing a byte of the multi-byte stem must NOT match, which it would
+        // if the fold touched anything above 0x7F and made two names collide.
+        std::string stemmed = wide;
+        stemmed[3] = '\x8A';
+        if (!require(!nds_nitrofs::nitrofs_lookup(parsed, stemmed, nullptr)))
+            return fail("a multi-byte stem is not folded into another name",
+                        quote(stemmed));
+        ok("a multi-byte stem is not folded into another name");
+    }
+
+    // ---- 12. The boundary of an allocation entry. -----------------------
+    {
+        // A zero-length file is legal: the end offset equals the start. It has
+        // to be listed, because a name entry pointing at nothing is still a
+        // name the game might ask for.
+        RomSpec spec;
+        spec.root.files.push_back(FileSpec{"EMPTY.BIN", 0, 0u, 0x00u});
+        spec.root.files.push_back(FileSpec{"AFTER.BIN", 1, 8u, 0x10u});
+        BuiltRom built = build_rom(spec);
+        NdsNitroFs parsed = parse_of(built);
+
+        if (!require(parsed.ok))
+            return fail("a zero-length file is not a fault", describe(parsed));
+        ok("a zero-length file is not a fault");
+
+        if (!require(parsed.files.size() == 2u && parsed.files[0].size == 0u))
+            return fail("a zero-length file is listed with size zero",
+                        describe(parsed));
+        ok("a zero-length file is listed with size zero");
+
+        if (!require(parsed.files[1].size == 8u))
+            return fail("the file after a zero-length one is unaffected",
+                        describe(parsed));
+        ok("the file after a zero-length one is unaffected");
+
+        // A file that ends exactly at the last byte of the image is inside it.
+        // The off-by-one to guard against is treating the end offset as
+        // inclusive or exclusive of one byte too many.
+        RomSpec exact;
+        FileSpec last{"LAST.BIN", 0, 0u, 0x10u};
+        exact.root.files.push_back(last);
+        exact.image_size = 0x400u;
+        built = build_rom(exact);
+        // Point the single entry at the final 16 bytes.
+        put_u32(&built.image, built.fat_offset, 0x3F0u);
+        put_u32(&built.image, built.fat_offset + 4u, 0x400u);
+        parsed = parse_of(built);
+        if (!require(parsed.ok && parsed.files.size() == 1u &&
+                     parsed.files[0].offset == 0x3F0u &&
+                     parsed.files[0].size == 16u))
+            return fail("a file that ends on the last byte is inside the image",
+                        describe(parsed));
+        ok("a file that ends on the last byte is inside the image");
+
+        // One byte further is not.
+        put_u32(&built.image, built.fat_offset + 4u, 0x401u);
+        parsed = parse_of(built);
+        if (!require(first_rule(parsed, NdsNitroFsRule::FatEntryOutsideImage) !=
+                     nullptr))
+            return fail("a file that ends one byte past the image is refused",
+                        describe(parsed));
+        ok("a file that ends one byte past the image is refused");
+
+        // A range that wraps when added, which a naive 32-bit sum would accept.
+        put_u32(&built.image, built.fat_offset, 0xFFFFFFF0u);
+        put_u32(&built.image, built.fat_offset + 4u, 0x00000020u);
+        parsed = parse_of(built);
+        if (!require(!parsed.ok))
+            return fail("a range that would wrap is refused", describe(parsed));
+        ok("a range that would wrap is refused");
+    }
+
+    // ---- 13. The diagnostic cap. ----------------------------------------
+    {
+        // A hand-edited image can be wrong in more places than a launcher pane
+        // could ever show. The list must stop at the documented cap and say so,
+        // rather than growing with the corruption.
+        RomSpec spec;
+        for (int i = 0; i < 300; ++i) {
+            // A colon is one of the bytes a name may not hold, so every one of
+            // these is refused and reported.
+            spec.root.files.push_back(
+                FileSpec{"BAD:" + number_text(static_cast<std::uint64_t>(i)),
+                         i, 0u, 0x00u});
+        }
+        const BuiltRom built = build_rom(spec);
+        const NdsNitroFs parsed = parse_of(built);
+
+        if (!require(!parsed.ok))
+            return fail("an image full of bad names is not ok",
+                        describe(parsed));
+        ok("an image full of bad names is not ok");
+
+        if (!require(parsed.files.empty()))
+            return fail("no file with a bad name is listed", describe(parsed));
+        ok("no file with a bad name is listed");
+
+        if (!require(static_cast<int>(parsed.diagnostics.size()) ==
+                     nds_nitrofs::kNdsNitroFsMaxDiagnostics + 1))
+            return fail("the diagnostic list stops at the cap plus its notice",
+                        number_text(parsed.diagnostics.size()));
+        ok("the diagnostic list stops at the cap plus its notice");
+
+        if (!require(count_rule(parsed, NdsNitroFsRule::InvalidName) ==
+                     nds_nitrofs::kNdsNitroFsMaxDiagnostics))
+            return fail("the cap counts ordinary diagnostics only",
+                        number_text(static_cast<std::uint64_t>(
+                            count_rule(parsed, NdsNitroFsRule::InvalidName))));
+        ok("the cap counts ordinary diagnostics only");
+
+        if (!require(count_rule(parsed, NdsNitroFsRule::TooManyProblems) == 1))
+            return fail("the cap is announced exactly once", describe(parsed));
+        ok("the cap is announced exactly once");
+
+        if (!require(!parsed.diagnostics.empty() &&
+                     parsed.diagnostics.back().rule ==
+                         NdsNitroFsRule::TooManyProblems))
+            return fail("the notice is the last thing in the list",
+                        describe(parsed));
+        ok("the notice is the last thing in the list");
+    }
+
+    // ---- 14. How a caller spells an override. ---------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+        const fs::path marker = root / "marker.bin";
+        if (!write_file(marker, bytes_of("ABCDEFGHIJKLMNOP")))
+            return fail("the override file could be written", "");
+        ok("the override file could be written");
+
+        // A leading slash is how a manifest written by someone used to unix
+        // paths will spell a root file.
+        std::vector<std::uint8_t> image = built.image;
+        std::vector<std::string> diagnostics;
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"/TITLE.BIN", marker.string()}}, &diagnostics)))
+            return fail("a leading slash in a game path still lands",
+                        show(diagnostics));
+        ok("a leading slash in a game path still lands");
+
+        // Backslashes, because a Windows author will reach for them.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"DATA\\ONE.BIN", marker.string()}}, &diagnostics)))
+            return fail("a backslash path still lands", show(diagnostics));
+        ok("a backslash path still lands");
+
+        // One host file may serve two cartridge files; nothing makes it unique.
+        // The two game files differ in size, and the shorter one is the limit:
+        // 16 bytes fits both TITLE.BIN's 16 and DATA/ONE.BIN's 32.
+        image = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                image.data(), image.size(), parsed,
+                {{"TITLE.BIN", marker.string()},
+                 {"DATA/ONE.BIN", marker.string()}},
+                &diagnostics)))
+            return fail("one host file may replace two game files",
+                        show(diagnostics));
+        ok("one host file may replace two game files");
+        if (!require(read_range(image, built.fat[0].first, 16u) ==
+                         bytes_of("ABCDEFGHIJKLMNOP") &&
+                     read_range(image, built.fat[1].first, 16u) ==
+                         bytes_of("ABCDEFGHIJKLMNOP")))
+            return fail("the shared host file lands in both", "");
+        ok("the shared host file lands in both");
+
+        // A cartridge file of zero bytes can take no replacement at all, and
+        // the refusal says both sizes so the player can see why.
+        RomSpec empty_spec;
+        empty_spec.root.files.push_back(FileSpec{"EMPTY.BIN", 0, 0u, 0x00u});
+        const BuiltRom empty_rom = build_rom(empty_spec);
+        const NdsNitroFs empty_parsed = parse_of(empty_rom);
+        std::vector<std::uint8_t> empty_image = empty_rom.image;
+        diagnostics.clear();
+        if (!require(!nds_nitrofs::nitrofs_apply_overrides(
+                empty_image.data(), empty_image.size(), empty_parsed,
+                {{"EMPTY.BIN", marker.string()}}, &diagnostics)))
+            return fail("a zero-length game file takes no replacement", "");
+        ok("a zero-length game file takes no replacement");
+        if (!require(diagnostics.size() == 1u &&
+                     diagnostics[0].find("16") != std::string::npos &&
+                     diagnostics[0].find("0") != std::string::npos))
+            return fail("a zero-length refusal names both sizes",
+                        show(diagnostics));
+        ok("a zero-length refusal names both sizes");
+
+        // Replacing the last file in the image with a same-size file must not
+        // touch anything before the image's end.
+        RomSpec tail_spec;
+        FileSpec tail{"TAIL.BIN", 0, 16u, 0x10u};
+        tail_spec.root.files.push_back(tail);
+        tail_spec.image_size = 0x400u;
+        const BuiltRom tail_rom = build_rom(tail_spec);
+        // Point the file at the final 16 bytes of the image, and parse the
+        // patched image rather than the one the builder made, so the entry the
+        // override lands in is the one just described.
+        std::vector<std::uint8_t> tail_image = tail_rom.image;
+        put_u32(&tail_image, tail_rom.fat_offset, 0x3F0u);
+        put_u32(&tail_image, tail_rom.fat_offset + 4u, 0x400u);
+        const NdsNitroFs tail_parsed =
+            nds_nitrofs::nitrofs_parse(tail_image.data(), tail_image.size());
+        if (!require(tail_parsed.ok && tail_parsed.files.size() == 1u &&
+                     tail_parsed.files[0].offset == 0x3F0u))
+            return fail("the tail fixture parses", describe(tail_parsed));
+        ok("the tail fixture parses");
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                tail_image.data(), tail_image.size(), tail_parsed,
+                {{"TAIL.BIN", marker.string()}}, &diagnostics)))
+            return fail("a file at the end of the image takes a replacement",
+                        show(diagnostics));
+        ok("a file at the end of the image takes a replacement");
+        if (!require(read_range(tail_image, 0x3F0u, 16u) ==
+                     bytes_of("ABCDEFGHIJKLMNOP")))
+            return fail("the replacement lands in the last 16 bytes", "");
+        ok("the replacement lands in the last 16 bytes");
+    }
+
+    // ---- 15. Names a caller can match on. -------------------------------
+    {
+        const std::vector<NdsNitroFsRule> all = all_rules();
+        bool names_ok = true;
+        std::string bad_name;
+        for (const NdsNitroFsRule rule : all) {
+            const char* const name = nds_nitrofs::nitrofs_rule_name(rule);
+            if (name == nullptr || name[0] == '\0') {
+                names_ok = false;
+                bad_name = hex_text(static_cast<std::uint64_t>(rule));
+                break;
+            }
+            for (const char ch : std::string(name)) {
+                if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') ||
+                      ch == '_')) {
+                    names_ok = false;
+                    bad_name = name;
+                }
+            }
+            if (!names_ok) break;
+        }
+        if (!require(names_ok))
+            return fail("every rule has a lowercase token", bad_name);
+        ok("every rule has a lowercase token");
+
+        std::vector<std::string> names;
+        for (const NdsNitroFsRule rule : all) {
+            names.push_back(nds_nitrofs::nitrofs_rule_name(rule));
+        }
+        bool distinct = true;
+        for (std::size_t i = 0; i < names.size() && distinct; ++i) {
+            for (std::size_t j = i + 1; j < names.size(); ++j) {
+                if (names[i] == names[j]) distinct = false;
+            }
+        }
+        if (!require(distinct))
+            return fail("no two rules share a token", "");
+        ok("no two rules share a token");
+
+        if (!require(std::string(nds_nitrofs::nitrofs_rule_name(
+                         NdsNitroFsRule::DirectoryCycle)) == "directory_cycle"))
+            return fail("a rule's token is the spelling a log would grep",
+                        nds_nitrofs::nitrofs_rule_name(
+                            NdsNitroFsRule::DirectoryCycle));
+        ok("a rule's token is the spelling a log would grep");
+
+        if (!require(std::string(nds_nitrofs::nitrofs_rule_name(
+                         static_cast<NdsNitroFsRule>(999))) == "unknown"))
+            return fail("a value outside the enum still names something", "");
+        ok("a value outside the enum still names something");
+
+        // The text a launcher pane would show leads with the token, so a
+        // player can quote it, and names the file when there is one.
+        NdsNitroFsDiagnostic diagnostic;
+        diagnostic.rule = NdsNitroFsRule::FatEntryOutsideImage;
+        diagnostic.path = "DATA/ONE.BIN";
+        diagnostic.id = 7;
+        diagnostic.detail = "the file runs past the image";
+        const std::string text =
+            nds_nitrofs::nitrofs_diagnostic_text(diagnostic);
+        if (!require(text.find("fat_entry_outside_image") == 0u))
+            return fail("a diagnostic text leads with the rule token", text);
+        ok("a diagnostic text leads with the rule token");
+
+        if (!require(text.find("DATA/ONE.BIN") != std::string::npos))
+            return fail("a diagnostic text names the path", text);
+        ok("a diagnostic text names the path");
+
+        if (!require(text.find("id 7") != std::string::npos))
+            return fail("a diagnostic text names the id", text);
+        ok("a diagnostic text names the id");
+
+        diagnostic.path.clear();
+        diagnostic.id = -1;
+        const std::string bare =
+            nds_nitrofs::nitrofs_diagnostic_text(diagnostic);
+        if (!require(bare.find('(') == std::string::npos))
+            return fail("a diagnostic with no file has no trailing note", bare);
+        ok("a diagnostic with no file has no trailing note");
+
+        if (!require(!bare.empty() && bare.find("the file runs past") !=
+                                          std::string::npos))
+            return fail("a diagnostic with no file still carries its detail",
+                        bare);
+        ok("a diagnostic with no file still carries its detail");
+    }
+
+    // ---- 16. A wide tree. ------------------------------------------------
+    {
+        // Twelve files across six directories. The small fixtures above cannot
+        // catch a reader that counts file ids per directory instead of per
+        // tree, because in a one-file directory the two are the same number.
+        // Here every directory starts where the previous one stopped, so a
+        // wrong start shows up as a wrong path.
+        RomSpec wide;
+        wide.root.files.push_back(FileSpec{"R0.BIN", 0, 8u, 0x01u});
+        wide.root.files.push_back(FileSpec{"R1.BIN", 1, 16u, 0x02u});
+        wide.root.files.push_back(FileSpec{"R2.BIN", 2, 4u, 0x0Cu});
+
+        DirSpec a;
+        a.name = "A";
+        a.files.push_back(FileSpec{"A0.BIN", 3, 24u, 0x03u});
+        DirSpec ab;
+        ab.name = "B";
+        ab.files.push_back(FileSpec{"B0.BIN", 4, 4u, 0x04u});
+        ab.files.push_back(FileSpec{"B1.BIN", 5, 12u, 0x05u});
+        DirSpec abc;
+        abc.name = "C";
+        abc.files.push_back(FileSpec{"C0.BIN", 6, 20u, 0x06u});
+        ab.dirs.push_back(abc);
+        a.dirs.push_back(ab);
+        wide.root.dirs.push_back(a);
+
+        DirSpec d;
+        d.name = "D";
+        d.files.push_back(FileSpec{"D0.BIN", 7, 8u, 0x07u});
+        d.files.push_back(FileSpec{"D1.BIN", 8, 32u, 0x08u});
+        wide.root.dirs.push_back(d);
+
+        DirSpec e;
+        e.name = "E";
+        e.files.push_back(FileSpec{"E0.BIN", 9, 8u, 0x09u});
+        e.files.push_back(FileSpec{"E1.BIN", 10, 8u, 0x0Au});
+        e.files.push_back(FileSpec{"E2.BIN", 11, 8u, 0x0Bu});
+        wide.root.dirs.push_back(e);
+
+        const BuiltRom built = build_rom(wide);
+        const NdsNitroFs parsed = parse_of(built);
+        if (!require(parsed.ok))
+            return fail("the wide tree parses", describe(parsed));
+        ok("the wide tree parses");
+
+        if (!require(parsed.files.size() == 12u))
+            return fail("every file in the wide tree is listed",
+                        describe(parsed));
+        ok("every file in the wide tree is listed");
+
+        if (!require(parsed.directories == 6))
+            return fail("every directory in the wide tree is counted",
+                        describe(parsed));
+        ok("every directory in the wide tree is counted");
+
+        if (!require(parsed.fat_entries == 12))
+            return fail("the wide tree's allocation table is read whole",
+                        describe(parsed));
+        ok("the wide tree's allocation table is read whole");
+
+        struct Expect {
+            const char* path;
+            int id;
+            std::uint32_t size;
+        };
+        const Expect expected[] = {
+            {"R0.BIN", 0, 8u},        {"R1.BIN", 1, 16u},
+            {"R2.BIN", 2, 4u},        {"A/A0.BIN", 3, 24u},
+            {"A/B/B0.BIN", 4, 4u},    {"A/B/B1.BIN", 5, 12u},
+            {"A/B/C/C0.BIN", 6, 20u}, {"D/D0.BIN", 7, 8u},
+            {"D/D1.BIN", 8, 32u},     {"E/E0.BIN", 9, 8u},
+            {"E/E1.BIN", 10, 8u},     {"E/E2.BIN", 11, 8u},
+        };
+        for (const Expect& want : expected) {
+            const std::string name =
+                std::string("the wide tree lists ") + want.path +
+                " under its own id";
+            const NdsNitroFsEntry* const entry =
+                nds_nitrofs::nitrofs_file_by_id(parsed, want.id);
+            if (!require(entry != nullptr && entry->path == want.path &&
+                         entry->size == want.size))
+                return fail(name.c_str(), describe(parsed));
+            ok(name.c_str());
+        }
+
+        bool disjoint = true;
+        for (std::size_t i = 0; i < parsed.files.size() && disjoint; ++i) {
+            for (std::size_t j = i + 1; j < parsed.files.size(); ++j) {
+                const NdsNitroFsEntry& left = parsed.files[i];
+                const NdsNitroFsEntry& right = parsed.files[j];
+                if (static_cast<std::uint64_t>(left.offset) <
+                        static_cast<std::uint64_t>(right.offset) +
+                            right.size &&
+                    static_cast<std::uint64_t>(right.offset) <
+                        static_cast<std::uint64_t>(left.offset) + left.size) {
+                    disjoint = false;
+                    break;
+                }
+            }
+        }
+        if (!require(disjoint))
+            return fail("no two files in the wide tree overlap",
+                        describe(parsed));
+        ok("no two files in the wide tree overlap");
+
+        bool inside = true;
+        for (const NdsNitroFsEntry& entry : parsed.files) {
+            if (static_cast<std::uint64_t>(entry.offset) + entry.size >
+                built.image.size()) {
+                inside = false;
+            }
+        }
+        if (!require(inside))
+            return fail("every wide-tree file lies inside the image",
+                        describe(parsed));
+        ok("every wide-tree file lies inside the image");
+
+        NdsNitroFsEntry found;
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "a/b/c/c0.bin",
+                                                 &found) &&
+                     found.id == 6))
+            return fail("a deep wide-tree path is matched without regard to "
+                        "case",
+                        describe(parsed));
+        ok("a deep wide-tree path is matched without regard to case");
+
+        if (!require(nds_nitrofs::nitrofs_lookup(parsed, "E/E2.BIN", &found) &&
+                     found.id == 11))
+            return fail("the last wide-tree file is reachable",
+                        describe(parsed));
+        ok("the last wide-tree file is reachable");
+
+        const bool wrong_depth =
+            nds_nitrofs::nitrofs_lookup(parsed, "B/C/C0.BIN", &found);
+        if (!require(!wrong_depth))
+            return fail("a wide-tree path is not reachable from the wrong "
+                        "depth",
+                        describe(parsed));
+        ok("a wide-tree path is not reachable from the wrong depth");
+
+        if (!require(describe(parse_of(build_rom(wide))) == describe(parsed)))
+            return fail("the wide tree parses to the same answer twice",
+                        describe(parse_of(build_rom(wide))));
+        ok("the wide tree parses to the same answer twice");
+    }
+
+    // ---- 17. Every byte a name may not hold. -----------------------------
+    {
+        // The format lets a name hold any byte, so the reader has to decide
+        // which ones a path cannot carry. Each forbidden byte gets its own
+        // fixture, with a legal file on either side, so the check pins both
+        // that the entry is refused and that its neighbours survive.
+        const char forbidden[] = {'/', '\\', ':', '\x01', '\x1F', '\x7F'};
+        for (const char byte : forbidden) {
+            RomSpec spec;
+            spec.root.files.push_back(FileSpec{"BEFORE.BIN", 0, 8u, 0x11u});
+            spec.root.files.push_back(FileSpec{name_with(byte), 1, 8u, 0x22u});
+            spec.root.files.push_back(FileSpec{"AFTER.BIN", 2, 8u, 0x33u});
+            const BuiltRom built = build_rom(spec);
+            const NdsNitroFs parsed = parse_of(built);
+            const std::string named =
+                std::string("a name holding ") +
+                hex_text(static_cast<unsigned char>(byte)) + " is refused";
+            if (!require(first_rule(parsed, NdsNitroFsRule::InvalidName) !=
+                         nullptr))
+                return fail(named.c_str(), describe(parsed));
+            ok(named.c_str());
+            const std::string bounded =
+                std::string("a name holding ") +
+                hex_text(static_cast<unsigned char>(byte)) +
+                " costs only its own entry";
+            if (!require(parsed.files.size() == 2u &&
+                         nds_nitrofs::nitrofs_file_by_id(parsed, 0) !=
+                             nullptr &&
+                         nds_nitrofs::nitrofs_file_by_id(parsed, 2) !=
+                             nullptr))
+                return fail(bounded.c_str(), describe(parsed));
+            ok(bounded.c_str());
+        }
+
+        // The same fixture with a byte the format does allow must parse, so the
+        // loop above is measuring the forbidden byte and not the shape of the
+        // fixture.
+        RomSpec allowed;
+        allowed.root.files.push_back(FileSpec{"BEFORE.BIN", 0, 8u, 0x11u});
+        allowed.root.files.push_back(FileSpec{name_with('~'), 1, 8u, 0x22u});
+        allowed.root.files.push_back(FileSpec{"AFTER.BIN", 2, 8u, 0x33u});
+        const NdsNitroFs parsed = parse_of(build_rom(allowed));
+        if (!require(parsed.ok))
+            return fail("a name holding a printable byte parses",
+                        describe(parsed));
+        ok("a name holding a printable byte parses");
+
+        if (!require(parsed.files.size() == 3u))
+            return fail("a name holding a printable byte is listed whole",
+                        describe(parsed));
+        ok("a name holding a printable byte is listed whole");
+
+        // A multi-byte name is legal too: the format does not say the bytes
+        // are ASCII, and the real cartridge's names are not.
+        RomSpec wide_name;
+        wide_name.root.files.push_back(
+            FileSpec{"\xE3\x83\xA2\xE3\x83\x83\xE3\x83\x89.BIN", 0, 8u, 0x44u});
+        const NdsNitroFs multibyte = parse_of(build_rom(wide_name));
+        if (!require(multibyte.ok))
+            return fail("a name of multi-byte characters parses",
+                        describe(multibyte));
+        ok("a name of multi-byte characters parses");
+    }
+
+    // ---- 18. What a refusal leaves behind. -------------------------------
+    {
+        const BuiltRom built = build_rom(basic_spec());
+        const NdsNitroFs parsed = parse_of(built);
+
+        const fs::path over_long = root / "over_long.bin";
+        if (!write_file(over_long, bytes_of("0123456789abcdefghij")))
+            return fail("the over-long replacement could be written", "");
+        ok("the over-long replacement could be written");
+
+        std::vector<std::uint8_t> image = built.image;
+        std::vector<std::string> diagnostics;
+        const bool refused = nds_nitrofs::nitrofs_apply_overrides(
+            image.data(), image.size(), parsed,
+            {{"TITLE.BIN", over_long.string()}}, &diagnostics);
+        if (!require(!refused))
+            return fail("an over-long replacement is refused",
+                        show(diagnostics));
+        ok("an over-long replacement is refused");
+
+        if (!require(same_bytes(image, built.image)))
+            return fail("a refused replacement leaves every byte alone",
+                        show(diagnostics));
+        ok("a refused replacement leaves every byte alone");
+
+        // The same call with a replacement that fits, so the comparisons below
+        // are against a copy that really was written to.
+        const fs::path fits = root / "fits.bin";
+        if (!write_file(fits, bytes_of("ABCDEFGH")))
+            return fail("the fitting replacement could be written", "");
+        ok("the fitting replacement could be written");
+
+        std::vector<std::uint8_t> modded = built.image;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                modded.data(), modded.size(), parsed,
+                {{"DATA/TWO.BIN", fits.string()}}, &diagnostics)))
+            return fail("a fitting replacement is applied",
+                        show(diagnostics));
+        ok("a fitting replacement is applied");
+
+        if (!require(!same_bytes(modded, built.image)))
+            return fail("an applied replacement does change the image", "");
+        ok("an applied replacement does change the image");
+
+        // The file it replaces is 8 bytes at fat[2], and nothing outside that
+        // range may move. This is the property the whole module exists for.
+        const std::uint32_t start = built.fat[2].first;
+        const std::uint32_t stop = built.fat[2].second;
+        if (!require(same_bytes(read_range(modded, 0u, start),
+                                read_range(built.image, 0u, start))))
+            return fail("the bytes before the replaced file are untouched", "");
+        ok("the bytes before the replaced file are untouched");
+
+        const std::uint32_t tail = static_cast<std::uint32_t>(
+            built.image.size()) - stop;
+        if (!require(same_bytes(read_range(modded, stop, tail),
+                                read_range(built.image, stop, tail))))
+            return fail("the bytes after the replaced file are untouched",
+                        "");
+        ok("the bytes after the replaced file are untouched");
+
+        if (!require(same_bytes(read_range(modded, start, stop - start),
+                                bytes_of("ABCDEFGH"))))
+            return fail("the modded image holds the replacement bytes",
+                        hex_text(start));
+        ok("the modded image holds the replacement bytes");
+
+        // Writing into a live image must not move the tables, so the modded
+        // image has to describe exactly the same files as the original.
+        const NdsNitroFs after =
+            nds_nitrofs::nitrofs_parse(modded.data(), modded.size());
+        if (!require(describe(after) == describe(parsed)))
+            return fail("the modded image still describes the same files",
+                        describe(after));
+        ok("the modded image still describes the same files");
+
+        // Applying the same manifest to an already-modded image is a no-op, so
+        // a launcher that patches twice cannot corrupt anything.
+        std::vector<std::uint8_t> twice = modded;
+        diagnostics.clear();
+        if (!require(nds_nitrofs::nitrofs_apply_overrides(
+                twice.data(), twice.size(), after,
+                {{"DATA/TWO.BIN", fits.string()}}, &diagnostics)))
+            return fail("a second application is accepted",
+                        show(diagnostics));
+        ok("a second application is accepted");
+
+        if (!require(same_bytes(twice, modded)))
+            return fail("a second application changes nothing", "");
+        ok("a second application changes nothing");
+    }
+
+    return 0;
+}
+
+}  // namespace
+
+int main() {
+    const fs::path root = create_root();
+    const int code = run_checks(root);
+    std::error_code error;
+    fs::remove_all(root, error);
+    if (code == 0) {
+        std::printf("%d checks passed\n", g_checks);
+        return 0;
+    }
+    std::printf("%d checks, code %d\n", g_checks, code);
+    return code;
+}
diff --git a/runner/tests/screen_layouts_property_test.cpp b/runner/tests/screen_layouts_property_test.cpp
new file mode 100644
index 0000000..491d27c
--- /dev/null
+++ b/runner/tests/screen_layouts_property_test.cpp
@@ -0,0 +1,855 @@
+// Property sweep for the screen-layout geometry (screen_layouts.h).
+//
+// tests/screen_layouts_test.cpp pins numbers: named canvases, exact rectangles.
+// This file asks the complementary question -- does compute_layout() obey the
+// contract at the top of screen_layouts.h for EVERY canvas, or only for the
+// ones somebody thought to write down? A layout is arithmetic, and arithmetic
+// breaks in the gaps between the examples a person picks: a 4:3 monitor is easy
+// to get right and a 1366x768 one is not.
+//
+// The sweep is exhaustive over a box of canvas sizes rather than a random
+// sample, because a sampled test can pass forever while one canvas size fails.
+// Widths 200..800 and heights 180..900 are 433,321 canvases, which is 8,666,420
+// configurations once the five layouts, both scaling modes and both swap states
+// are included; the whole sweep runs in well under a second. Canvas sizes
+// outside that box are covered by named corner cases instead: zero, negative,
+// one pixel under the minimum, one pixel over the cap, and the cap itself.
+//
+// Eight properties are checked on every configuration:
+//   (a) every non-empty rectangle lies fully inside the canvas;
+//   (b) the two rectangles never overlap;
+//   (c) each rectangle keeps 4:3 exactly in integer mode and to within a pixel
+//       (-3 <= 4 * height - 3 * width <= 2) in fractional mode;
+//   (d) the used block is centred, with the odd pixel on the right/bottom;
+//   (e) unused_canvas_pixels is canvas_width * canvas_height minus exactly the
+//       area of the rectangles used, and never negative;
+//   (f) native_scale agrees with the rectangles (integer mode: exactly
+//       256 * scale by 192 * scale) and is at least 1 when valid;
+//   (g) a canvas is refused exactly when it is below the layout's minimum, and
+//       a refusal is all zeros;
+//   (h) the canvas echo is always the request, valid or not.
+// Each property is a separate check per layout and per scaling mode, so a
+// failure names both the rule and the mode before anyone opens a debugger.
+//
+// Two more things are pinned. The swap rule: for the two-screen layouts
+// exchanging the rectangles is the whole effect, and for the single-screen
+// layouts it must change nothing at all. And a determinism digest: the FNV-1a
+// hash of every field of every result over a fixed canvas table, a value
+// reproduced independently by a small model of the specification written from
+// the header prose before this file existed, so a drift shows up as a changed
+// number instead of as a moved picture.
+//
+// Each check has a distinct 1-based index; the first failing check's index
+// becomes the process exit code, and a failure prints what broke and where.
+
+#include "screen_layouts.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+static_assert(nds_screen_layout::kNativeScreenWidth == 256, "screen width");
+static_assert(nds_screen_layout::kNativeScreenHeight == 192, "screen height");
+static_assert(nds_screen_layout::kMaxCanvasDimension == 16384, "canvas cap");
+static_assert(nds_screen_layout::kNdsLayoutKindCount == 5, "five layouts");
+
+namespace {
+
+using nds_screen_layout::compute_layout;
+using nds_screen_layout::kMaxCanvasDimension;
+using nds_screen_layout::kNativeScreenHeight;
+using nds_screen_layout::kNativeScreenWidth;
+using nds_screen_layout::kNdsLayoutBottomOnly;
+using nds_screen_layout::kNdsLayoutKindCount;
+using nds_screen_layout::kNdsLayoutSideBySide;
+using nds_screen_layout::kNdsLayoutSquare;
+using nds_screen_layout::kNdsLayoutStacked;
+using nds_screen_layout::kNdsLayoutTopOnly;
+using nds_screen_layout::kNdsScreenBottom;
+using nds_screen_layout::kNdsScreenTop;
+using nds_screen_layout::NdsScreenLayoutKind;
+using nds_screen_layout::NdsScreenLayoutResult;
+using nds_screen_layout::NdsScreenRect;
+using nds_screen_layout::layout_is_single_window;
+using nds_screen_layout::layout_min_canvas;
+using nds_screen_layout::layout_name;
+
+int g_checks = 0;
+int g_failures = 0;
+int g_first_failure = 0;
+
+// Records one check. Returns the verdict so a caller can skip follow-up work
+// that would only produce noise after a failure.
+bool check(bool condition, const std::string& what,
+           const std::string& detail) {
+    ++g_checks;
+    if (condition) {
+        std::printf("OK   %s\n", what.c_str());
+        return true;
+    }
+    if (g_failures == 0) g_first_failure = g_checks;
+    ++g_failures;
+    std::fprintf(stderr, "FAIL %s\n     %s\n", what.c_str(), detail.c_str());
+    return false;
+}
+
+std::string number(int value) {
+    return std::to_string(value);
+}
+
+std::string rect_text(const NdsScreenRect& rect) {
+    return "{" + number(rect.x) + ", " + number(rect.y) + ", " +
+           number(rect.width) + ", " + number(rect.height) + "}";
+}
+
+std::string describe(const NdsScreenLayoutResult& result) {
+    return std::string("canvas ") + number(result.canvas_width) + "x" +
+           number(result.canvas_height) + " scale " +
+           number(result.native_scale) + " unused " +
+           number(result.unused_canvas_pixels) +
+           (result.valid ? " valid" : " REFUSED") + " top " +
+           rect_text(result.rects[kNdsScreenTop]) + " bottom " +
+           rect_text(result.rects[kNdsScreenBottom]);
+}
+
+bool rect_is_zero(const NdsScreenRect& rect) {
+    return rect.x == 0 && rect.y == 0 && rect.width == 0 && rect.height == 0;
+}
+
+bool rect_is_empty(const NdsScreenRect& rect) {
+    return rect.width <= 0 || rect.height <= 0;
+}
+
+bool rects_equal(const NdsScreenRect& left, const NdsScreenRect& right) {
+    return left.x == right.x && left.y == right.y &&
+           left.width == right.width && left.height == right.height;
+}
+
+const char* kind_label(int kind) {
+    return layout_name(static_cast<NdsScreenLayoutKind>(kind));
+}
+
+// A layout is a grid of cells, and the specification says how many: one column
+// by two rows for stacked, two columns by one row for the side-by-side pair, a
+// single cell for the single-screen layouts, and two 256x256 tiles for square.
+// This is the specification's own model, written from the header, not a copy of
+// the implementation's table.
+struct ExpectedShape {
+    int columns;
+    int rows;
+    int cell_height;
+};
+
+ExpectedShape shape_of(int kind) {
+    switch (kind) {
+        case kNdsLayoutStacked: return {1, 2, kNativeScreenHeight};
+        case kNdsLayoutSideBySide: return {2, 1, kNativeScreenHeight};
+        case kNdsLayoutTopOnly: return {1, 1, kNativeScreenHeight};
+        case kNdsLayoutBottomOnly: return {1, 1, kNativeScreenHeight};
+        case kNdsLayoutSquare: return {2, 1, 256};
+        default: return {1, 2, kNativeScreenHeight};
+    }
+}
+
+int block_width(int kind) {
+    return shape_of(kind).columns * kNativeScreenWidth;
+}
+
+int block_height(int kind) {
+    return shape_of(kind).rows * shape_of(kind).cell_height;
+}
+
+// The specification's own rule for "this layout shows one screen": a grid of
+// one column by one row. Checked against layout_is_single_window() separately
+// rather than assumed, so the two cannot drift apart silently.
+bool shape_is_single_screen(int kind) {
+    const ExpectedShape shape = shape_of(kind);
+    return shape.columns == 1 && shape.rows == 1;
+}
+
+bool single_window(int kind) {
+    return layout_is_single_window(
+        static_cast<NdsScreenLayoutKind>(kind));
+}
+
+// The largest whole scale that fits, which is also the floor of the fractional
+// scale: the module documents that the two modes agree on what fits.
+int whole_scale(int kind, int canvas_width, int canvas_height) {
+    const int by_width = canvas_width / block_width(kind);
+    const int by_height = canvas_height / block_height(kind);
+    return by_width < by_height ? by_width : by_height;
+}
+
+// The specification of validity, from the header: positive, inside the cap, and
+// at least large enough to hold the block at 1:1.
+bool request_is_valid(int kind, int canvas_width, int canvas_height) {
+    if (canvas_width <= 0 || canvas_height <= 0) return false;
+    if (canvas_width > kMaxCanvasDimension ||
+        canvas_height > kMaxCanvasDimension) {
+        return false;
+    }
+    return whole_scale(kind, canvas_width, canvas_height) >= 1;
+}
+
+// One property's violation count, with the first offending configuration kept
+// verbatim so a failure names a canvas that can be pasted into the pin table.
+struct Tally {
+    int count = 0;
+    std::string first;
+
+    void note(const std::string& example) {
+        ++count;
+        if (first.empty()) first = example;
+    }
+
+    bool clean() const { return count == 0; }
+
+    std::string detail() const {
+        return number(count) + " configurations broke it, first " + first;
+    }
+};
+
+enum Property {
+    kInside = 0,
+    kNoOverlap,
+    kAspect,
+    kCentring,
+    kUnused,
+    kScale,
+    kMinimum,
+    kEcho,
+    kPropertyCount
+};
+
+const char* property_name(int property) {
+    switch (property) {
+        case kInside:
+            return "every rectangle is inside the canvas";
+        case kNoOverlap:
+            return "the two rectangles never overlap";
+        case kAspect:
+            return "every rectangle keeps the 4:3 aspect ratio";
+        case kCentring:
+            return "the block is centred, odd pixel right/bottom";
+        case kUnused:
+            return "unused_canvas_pixels is the exact complement";
+        case kScale:
+            return "native_scale agrees with the rectangles";
+        case kMinimum:
+            return "refused exactly below the minimum, and zeroed";
+        case kEcho:
+            return "the canvas echo is always the request";
+        default:
+            return "unknown property";
+    }
+}
+
+// The eight properties, for one already-computed result.
+void evaluate_result(int kind, int canvas_width, int canvas_height,
+                     bool integer_scale,
+                     const NdsScreenLayoutResult& result, Tally* tallies) {
+    const std::string where =
+        std::string(kind_label(kind)) + " " + number(canvas_width) + "x" +
+        number(canvas_height) + (integer_scale ? " integer" : " fractional");
+
+    if (result.canvas_width != canvas_width ||
+        result.canvas_height != canvas_height) {
+        tallies[kEcho].note(where + ": " + describe(result));
+    }
+
+    if (result.valid != request_is_valid(kind, canvas_width, canvas_height)) {
+        tallies[kMinimum].note(where + ": " + describe(result));
+    }
+    if (!result.valid) {
+        if (result.native_scale != 0 || result.unused_canvas_pixels != 0 ||
+            !rect_is_zero(result.rects[kNdsScreenTop]) ||
+            !rect_is_zero(result.rects[kNdsScreenBottom])) {
+            tallies[kMinimum].note(where + " refused but populated: " +
+                                   describe(result));
+        }
+        return;
+    }
+
+    // (f) The scale: at least one, and in integer mode exactly what the
+    // rectangles are made of. The single-screen layouts use one cell, the
+    // others two, so the count is part of the contract as well.
+    const int expected_cells = single_window(kind) ? 1 : 2;
+    int visible_cells = 0;
+    for (int slot = 0; slot < 2; ++slot) {
+        if (!rect_is_empty(result.rects[slot])) ++visible_cells;
+    }
+    if (visible_cells != expected_cells) {
+        tallies[kScale].note(where + ": " + describe(result));
+    }
+    if (result.native_scale < 1) {
+        tallies[kScale].note(where + " scale below one: " + describe(result));
+    }
+
+    int block_left = 0;
+    int block_right = 0;
+    int block_top = 0;
+    int block_bottom = 0;
+    bool seen = false;
+    int64_t used_area = 0;
+    for (int slot = 0; slot < 2; ++slot) {
+        const NdsScreenRect& rect = result.rects[slot];
+        if (rect_is_empty(rect)) continue;
+        used_area += static_cast<int64_t>(rect.width) * rect.height;
+
+        // (a) inside the canvas.
+        if (rect.x < 0 || rect.y < 0 ||
+            rect.x + rect.width > canvas_width ||
+            rect.y + rect.height > canvas_height) {
+            tallies[kInside].note(where + ": " + describe(result));
+        }
+
+        // (c) aspect: exact in integer mode, within one pixel otherwise.
+        if (integer_scale) {
+            if (rect.width * kNativeScreenHeight !=
+                rect.height * kNativeScreenWidth) {
+                tallies[kAspect].note(where + ": " + describe(result));
+            }
+            if (rect.width != result.native_scale * kNativeScreenWidth ||
+                rect.height != result.native_scale * kNativeScreenHeight) {
+                tallies[kScale].note(
+                    where + " size disagrees with the scale: " +
+                    describe(result));
+            }
+        } else {
+            const int spread = 4 * rect.height - 3 * rect.width;
+            if (spread < -3 || spread > 2) {
+                tallies[kAspect].note(where + " spread " + number(spread) +
+                                      ": " + describe(result));
+            }
+            // A whole scale that fits must be reachable: the fractional
+            // rectangle can never be smaller than the integer one of the
+            // floor scale.
+            if (rect.width < result.native_scale * kNativeScreenWidth ||
+                rect.height < result.native_scale * kNativeScreenHeight) {
+                tallies[kScale].note(where + " smaller than the floor scale: " +
+                                     describe(result));
+            }
+        }
+
+        if (!seen) {
+            block_left = rect.x;
+            block_right = rect.x + rect.width;
+            block_top = rect.y;
+            block_bottom = rect.y + rect.height;
+            seen = true;
+        } else {
+            if (rect.x < block_left) block_left = rect.x;
+            if (rect.x + rect.width > block_right) {
+                block_right = rect.x + rect.width;
+            }
+            if (rect.y < block_top) block_top = rect.y;
+            if (rect.y + rect.height > block_bottom) {
+                block_bottom = rect.y + rect.height;
+            }
+        }
+    }
+
+    // (b) overlap.
+    const NdsScreenRect& top = result.rects[kNdsScreenTop];
+    const NdsScreenRect& bottom = result.rects[kNdsScreenBottom];
+    if (!rect_is_empty(top) && !rect_is_empty(bottom)) {
+        const bool apart = top.x + top.width <= bottom.x ||
+                           bottom.x + bottom.width <= top.x ||
+                           top.y + top.height <= bottom.y ||
+                           bottom.y + bottom.height <= top.y;
+        if (!apart) {
+            tallies[kNoOverlap].note(where + ": " + describe(result));
+        }
+    }
+
+    // (d) centring: the free space on the two sides differs by at most one
+    // pixel, and the odd pixel is the right/bottom one.
+    if (seen) {
+        const int slack_left = block_left;
+        const int slack_right = canvas_width - block_right;
+        const int slack_top = block_top;
+        const int slack_bottom = canvas_height - block_bottom;
+        const int across = slack_right - slack_left;
+        const int down = slack_bottom - slack_top;
+        if (across < 0 || across > 1 || down < 0 || down > 1) {
+            tallies[kCentring].note(where + " slack " + number(slack_left) +
+                                    "/" + number(slack_right) + " " +
+                                    number(slack_top) + "/" +
+                                    number(slack_bottom) + ": " +
+                                    describe(result));
+        }
+    }
+
+    // (e) unused pixels are exactly the complement of what is covered.
+    const int64_t canvas_area =
+        static_cast<int64_t>(canvas_width) * canvas_height;
+    if (result.unused_canvas_pixels != canvas_area - used_area) {
+        tallies[kUnused].note(where + " unused " +
+                              number(result.unused_canvas_pixels) +
+                              " expected " + number(static_cast<int>(
+                                  canvas_area - used_area)) + ": " +
+                              describe(result));
+    }
+    if (result.unused_canvas_pixels < 0) {
+        tallies[kUnused].note(where + " negative unused: " + describe(result));
+    }
+}
+
+const int kSweepMinWidth = 200;
+const int kSweepMaxWidth = 800;
+const int kSweepMinHeight = 180;
+const int kSweepMaxHeight = 900;
+
+// The canvases the digest and the swap sweep walk. One table, chosen so that it
+// holds exact multiples (256x384, 512x192), awkward ratios (1366x768,
+// 1920x1080), a 4:3 monitor, a 16:10 one, the largest canvas the module
+// accepts, the first one it refuses, a sub-minimum canvas, a non-positive one
+// and a large one.
+const int kDigestCanvases[][2] = {
+    {256, 192},     {256, 384},     {512, 192},     {512, 256},     {512, 384},
+    {640, 480},     {768, 576},     {800, 600},     {1024, 768},    {1280, 720},
+    {1366, 768},    {1920, 1080},   {2560, 1440},   {3840, 2160},   {200, 400},
+    {300, 384},     {448, 336},     {16384, 16384}, {16383, 16384}, {1, 1},
+    {0, 384},       {256, 0},       {-1, 384},      {16385, 384},
+};
+
+constexpr int kDigestCanvasCount =
+    static_cast<int>(sizeof(kDigestCanvases) / sizeof(kDigestCanvases[0]));
+
+// FNV-1a over 32-bit words: the standard offset basis and prime, so the value
+// can be reproduced from the prose in a few lines of any language.
+constexpr std::uint64_t kFnvOffsetBasis = 0xCBF29CE484222325ULL;
+constexpr std::uint64_t kFnvPrime = 0x100000001B3ULL;
+
+std::uint64_t fold_word(std::uint64_t hash, int word) {
+    hash ^= static_cast<std::uint64_t>(static_cast<std::uint32_t>(word));
+    hash *= kFnvPrime;
+    return hash;
+}
+
+struct DigestValue {
+    std::uint64_t hash;
+    int rows;
+};
+
+DigestValue compute_digest() {
+    std::uint64_t hash = kFnvOffsetBasis;
+    int rows = 0;
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int index = 0; index < kDigestCanvasCount; ++index) {
+            const int canvas_width = kDigestCanvases[index][0];
+            const int canvas_height = kDigestCanvases[index][1];
+            for (int integer_scale = 1; integer_scale >= 0; --integer_scale) {
+                for (int swap = 0; swap < 2; ++swap) {
+                    const NdsScreenLayoutResult result = compute_layout(
+                        static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                        canvas_height, integer_scale != 0, swap != 0);
+                    hash = fold_word(hash, canvas_width);
+                    hash = fold_word(hash, canvas_height);
+                    hash = fold_word(hash, result.native_scale);
+                    hash = fold_word(hash, result.unused_canvas_pixels);
+                    hash = fold_word(hash, result.valid ? 1 : 0);
+                    for (int slot = 0; slot < 2; ++slot) {
+                        hash = fold_word(hash, result.rects[slot].x);
+                        hash = fold_word(hash, result.rects[slot].y);
+                        hash = fold_word(hash, result.rects[slot].width);
+                        hash = fold_word(hash, result.rects[slot].height);
+                    }
+                    ++rows;
+                }
+            }
+        }
+    }
+    return {hash, rows};
+}
+
+std::string hex_digest(std::uint64_t value) {
+    char text[17] = {};
+    std::snprintf(text, sizeof(text), "%016llX",
+                  static_cast<unsigned long long>(value));
+    return text;
+}
+
+// A layout's minimum canvas, as the specification computes it.
+bool specification_minimum(int kind, int* width, int* height) {
+    *width = block_width(kind);
+    *height = block_height(kind);
+    return true;
+}
+
+// Runs the exhaustive sweep and emits one check per property per layout per
+// scaling mode.
+void check_sweep() {
+    Tally tallies[kNdsLayoutKindCount][2][kPropertyCount];
+    int canvas_count = 0;
+    int64_t configuration_count = 0;
+    for (int canvas_width = kSweepMinWidth; canvas_width <= kSweepMaxWidth;
+         ++canvas_width) {
+        for (int canvas_height = kSweepMinHeight;
+             canvas_height <= kSweepMaxHeight; ++canvas_height) {
+            ++canvas_count;
+            for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+                for (int mode = 0; mode < 2; ++mode) {
+                    for (int swap = 0; swap < 2; ++swap) {
+                        const NdsScreenLayoutResult result = compute_layout(
+                            static_cast<NdsScreenLayoutKind>(kind),
+                            canvas_width, canvas_height, mode == 1,
+                            swap == 1);
+                        evaluate_result(kind, canvas_width, canvas_height,
+                                        mode == 1, result,
+                                        tallies[kind][mode]);
+                        ++configuration_count;
+                    }
+                }
+            }
+        }
+    }
+
+    check(canvas_count == 433321,
+          "the sweep covers 433,321 canvases",
+          "covered " + number(canvas_count) +
+              " -- the sweep was quietly narrowed");
+    check(configuration_count == 8666420,
+          "the sweep covers 8,666,420 configurations",
+          "covered " + number(static_cast<int>(configuration_count)) +
+              " -- configurations went missing");
+
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int mode = 0; mode < 2; ++mode) {
+            for (int property = 0; property < kPropertyCount; ++property) {
+                const Tally& tally = tallies[kind][mode][property];
+                const std::string what =
+                    std::string(property_name(property)) + " (" +
+                    kind_label(kind) + ", " +
+                    (mode == 1 ? "integer" : "fractional") + ")";
+                check(tally.clean(), what, tally.detail());
+            }
+        }
+    }
+}
+
+// (b) as a rule of its own: swap exchanges the two rectangles for the
+// two-screen layouts and changes nothing else; for the single-screen layouts it
+// must change nothing at all, because it would otherwise silently change which
+// screen is visible instead of rearranging the view.
+void check_swap_rule() {
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        int exchange_problems = 0;
+        int refusal_problems = 0;
+        std::string exchange_example;
+        std::string refusal_example;
+        for (int index = 0; index < kDigestCanvasCount; ++index) {
+            const int canvas_width = kDigestCanvases[index][0];
+            const int canvas_height = kDigestCanvases[index][1];
+            for (int mode = 0; mode < 2; ++mode) {
+                const NdsScreenLayoutResult plain = compute_layout(
+                    static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                    canvas_height, mode == 1, false);
+                const NdsScreenLayoutResult swapped = compute_layout(
+                    static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                    canvas_height, mode == 1, true);
+
+                const bool same_frame =
+                    plain.canvas_width == swapped.canvas_width &&
+                    plain.canvas_height == swapped.canvas_height &&
+                    plain.native_scale == swapped.native_scale &&
+                    plain.unused_canvas_pixels ==
+                        swapped.unused_canvas_pixels &&
+                    plain.valid == swapped.valid;
+                bool rects_ok = false;
+                if (single_window(kind)) {
+                    rects_ok = rects_equal(swapped.rects[kNdsScreenTop],
+                                           plain.rects[kNdsScreenTop]) &&
+                               rects_equal(swapped.rects[kNdsScreenBottom],
+                                           plain.rects[kNdsScreenBottom]);
+                } else {
+                    rects_ok = rects_equal(swapped.rects[kNdsScreenTop],
+                                           plain.rects[kNdsScreenBottom]) &&
+                               rects_equal(swapped.rects[kNdsScreenBottom],
+                                           plain.rects[kNdsScreenTop]);
+                }
+                if (!same_frame || !rects_ok) {
+                    ++exchange_problems;
+                    if (exchange_example.empty()) {
+                        exchange_example = number(canvas_width) + "x" +
+                                           number(canvas_height) + ": " +
+                                           describe(plain) + " swapped " +
+                                           describe(swapped);
+                    }
+                }
+                // Swapping rearranges the view; it cannot make a canvas large
+                // enough. A refused request must stay refused and zeroed with
+                // swap set, or a player could switch the option and get a
+                // half-built geometry out of it.
+                if (!plain.valid) {
+                    const bool still_zeroed =
+                        !swapped.valid && swapped.native_scale == 0 &&
+                        swapped.unused_canvas_pixels == 0 &&
+                        rect_is_zero(swapped.rects[kNdsScreenTop]) &&
+                        rect_is_zero(swapped.rects[kNdsScreenBottom]);
+                    if (!still_zeroed) {
+                        ++refusal_problems;
+                        if (refusal_example.empty()) {
+                            refusal_example = number(canvas_width) + "x" +
+                                              number(canvas_height) + ": " +
+                                              describe(swapped);
+                        }
+                    }
+                }
+            }
+        }
+        const std::string what =
+            single_window(kind)
+                ? std::string("swap changes nothing for ") + kind_label(kind)
+                : std::string("swap only exchanges the two rectangles for ") +
+                      kind_label(kind);
+        check(exchange_problems == 0, what,
+              number(exchange_problems) + " canvases disagreed, first " +
+                  exchange_example);
+        check(refusal_problems == 0,
+              std::string("a refused canvas stays refused under swap for ") +
+                  kind_label(kind),
+              number(refusal_problems) + " canvases disagreed, first " +
+                  refusal_example);
+    }
+}
+
+// The minimum canvas, and one pixel less in each direction.
+void check_minimum_boundary() {
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        int minimum_width = 0;
+        int minimum_height = 0;
+        const bool have_minimum =
+            layout_min_canvas(static_cast<NdsScreenLayoutKind>(kind),
+                              &minimum_width, &minimum_height);
+        int spec_width = 0;
+        int spec_height = 0;
+        specification_minimum(kind, &spec_width, &spec_height);
+        const std::string label = kind_label(kind);
+
+        check(have_minimum && minimum_width == spec_width &&
+                  minimum_height == spec_height,
+              std::string("the minimum canvas for ") + label +
+                  " is the size of its block",
+              number(minimum_width) + "x" + number(minimum_height) +
+                  " expected " + number(spec_width) + "x" +
+                  number(spec_height));
+
+        const NdsScreenLayoutResult at_minimum = compute_layout(
+            static_cast<NdsScreenLayoutKind>(kind), minimum_width,
+            minimum_height, true, false);
+        check(at_minimum.valid && at_minimum.native_scale == 1,
+              std::string("the minimum canvas for ") + label +
+                  " is valid at scale 1",
+              describe(at_minimum));
+
+        const NdsScreenLayoutResult narrower = compute_layout(
+            static_cast<NdsScreenLayoutKind>(kind), minimum_width - 1,
+            minimum_height, true, false);
+        check(!narrower.valid && narrower.native_scale == 0 &&
+                  rect_is_zero(narrower.rects[kNdsScreenTop]) &&
+                  rect_is_zero(narrower.rects[kNdsScreenBottom]),
+              std::string("one pixel narrower than the minimum for ") + label +
+                  " is refused and zeroed",
+              describe(narrower));
+
+        const NdsScreenLayoutResult shorter = compute_layout(
+            static_cast<NdsScreenLayoutKind>(kind), minimum_width,
+            minimum_height - 1, true, false);
+        check(!shorter.valid && shorter.native_scale == 0 &&
+                  rect_is_zero(shorter.rects[kNdsScreenTop]) &&
+                  rect_is_zero(shorter.rects[kNdsScreenBottom]),
+              std::string("one pixel shorter than the minimum for ") + label +
+                  " is refused and zeroed",
+              describe(shorter));
+    }
+}
+
+// Canvases the module must refuse outright, whatever the layout.
+void check_degenerate_canvas() {
+    const int kDegenerate[][2] = {
+        {0, 384},  {256, 0},   {0, 0},      {-1, 384},
+        {256, -1}, {-384, -256}, {1, 1},    {255, 383},
+    };
+    constexpr int kDegenerateCount =
+        static_cast<int>(sizeof(kDegenerate) / sizeof(kDegenerate[0]));
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int index = 0; index < kDegenerateCount; ++index) {
+            const int canvas_width = kDegenerate[index][0];
+            const int canvas_height = kDegenerate[index][1];
+            const NdsScreenLayoutResult result = compute_layout(
+                static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                canvas_height, true, false);
+            const bool zeroed = result.native_scale == 0 &&
+                                result.unused_canvas_pixels == 0 &&
+                                rect_is_zero(result.rects[kNdsScreenTop]) &&
+                                rect_is_zero(result.rects[kNdsScreenBottom]);
+            const bool echo = result.canvas_width == canvas_width &&
+                              result.canvas_height == canvas_height;
+            check(!result.valid && zeroed && echo,
+                  std::string("a degenerate canvas is refused for ") +
+                      kind_label(kind),
+                  number(canvas_width) + "x" + number(canvas_height) + ": " +
+                      describe(result));
+        }
+    }
+}
+
+// Canvases beyond the accepted cap, and the cap itself.
+void check_oversize_canvas() {
+    const int kOversize[][2] = {
+        {16385, 384}, {256, 16385}, {16385, 16385}, {16384, 384},
+    };
+    constexpr int kOversizeCount =
+        static_cast<int>(sizeof(kOversize) / sizeof(kOversize[0]));
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int index = 0; index < kOversizeCount; ++index) {
+            const int canvas_width = kOversize[index][0];
+            const int canvas_height = kOversize[index][1];
+            const NdsScreenLayoutResult result = compute_layout(
+                static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                canvas_height, true, false);
+            const bool over = canvas_width > kMaxCanvasDimension ||
+                              canvas_height > kMaxCanvasDimension;
+            const bool zeroed = result.native_scale == 0 &&
+                                result.unused_canvas_pixels == 0 &&
+                                rect_is_zero(result.rects[kNdsScreenTop]) &&
+                                rect_is_zero(result.rects[kNdsScreenBottom]);
+            if (over) {
+                check(!result.valid && zeroed,
+                      std::string("a canvas over the cap is refused for ") +
+                          kind_label(kind),
+                      number(canvas_width) + "x" + number(canvas_height) +
+                          ": " + describe(result));
+            } else {
+                check(result.valid && result.native_scale >= 1,
+                      std::string("the largest accepted canvas works for ") +
+                          kind_label(kind),
+                      describe(result));
+            }
+        }
+    }
+}
+
+// The canvases the frontend actually meets on a desktop.
+void check_frontend_canvases() {
+    const int kFrontend[][2] = {
+        {1280, 720}, {1920, 1080}, {1024, 768}, {800, 600},
+        {1366, 768}, {2560, 1600}, {3840, 2160},
+    };
+    constexpr int kFrontendCount =
+        static_cast<int>(sizeof(kFrontend) / sizeof(kFrontend[0]));
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int index = 0; index < kFrontendCount; ++index) {
+            const int canvas_width = kFrontend[index][0];
+            const int canvas_height = kFrontend[index][1];
+            for (int mode = 0; mode < 2; ++mode) {
+                const NdsScreenLayoutResult result = compute_layout(
+                    static_cast<NdsScreenLayoutKind>(kind), canvas_width,
+                    canvas_height, mode == 1, false);
+                bool inside = true;
+                for (int slot = 0; slot < 2; ++slot) {
+                    const NdsScreenRect& rect = result.rects[slot];
+                    if (rect_is_empty(rect)) continue;
+                    if (rect.x < 0 || rect.y < 0 ||
+                        rect.x + rect.width > canvas_width ||
+                        rect.y + rect.height > canvas_height) {
+                        inside = false;
+                    }
+                }
+                check(result.valid && inside,
+                      std::string("a desktop canvas is laid out for ") +
+                          kind_label(kind),
+                      number(canvas_width) + "x" + number(canvas_height) + " " +
+                          (mode == 1 ? "integer" : "fractional") + ": " +
+                          describe(result));
+            }
+        }
+    }
+}
+
+// Out-of-range enum values fall back to stacked, every entry point.
+void check_totality() {
+    // "One screen" is a property of the layout's own shape, so the accessor and
+    // the shape table must agree on it for every layout -- a mismatch would let
+    // the presenter draw one rectangle where the geometry computed two.
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        check(single_window(kind) == shape_is_single_screen(kind),
+              std::string("the single-window accessor matches the shape of ") +
+                  kind_label(kind),
+              "accessor says " + number(single_window(kind) ? 1 : 0) +
+                  ", the grid says " +
+                  number(shape_is_single_screen(kind) ? 1 : 0));
+    }
+
+    const int kStrange[] = {-1, kNdsLayoutKindCount, 99};
+    for (int index = 0; index < 3; ++index) {
+        const int kind = kStrange[index];
+        const NdsScreenLayoutResult strange = compute_layout(
+            static_cast<NdsScreenLayoutKind>(kind), 1280, 720, true, false);
+        const NdsScreenLayoutResult stacked =
+            compute_layout(kNdsLayoutStacked, 1280, 720, true, false);
+        const bool same =
+            strange.valid == stacked.valid &&
+            strange.native_scale == stacked.native_scale &&
+            strange.unused_canvas_pixels == stacked.unused_canvas_pixels &&
+            rects_equal(strange.rects[kNdsScreenTop],
+                        stacked.rects[kNdsScreenTop]) &&
+            rects_equal(strange.rects[kNdsScreenBottom],
+                        stacked.rects[kNdsScreenBottom]);
+        check(same,
+              "an out-of-range layout behaves as stacked on 1280x720",
+              "kind " + number(kind) + ": strange " + describe(strange) +
+                  " stacked " + describe(stacked));
+    }
+}
+
+// Determinism: the digest, and the fact that repeated calls agree.
+void check_determinism() {
+    const DigestValue digest = compute_digest();
+    check(digest.rows == 480, "the digest covers 480 results",
+          "covered " + number(digest.rows));
+    check(digest.hash == 0x961D5E439E766CE5ULL,
+          "the geometry digest is unchanged",
+          "digest " + hex_digest(digest.hash) +
+              " expected 961D5E439E766CE5 -- the geometry moved");
+
+    const NdsScreenLayoutResult first =
+        compute_layout(kNdsLayoutSideBySide, 1280, 720, true, false);
+    for (int kind = 0; kind < kNdsLayoutKindCount; ++kind) {
+        for (int index = 0; index < kDigestCanvasCount; ++index) {
+            compute_layout(static_cast<NdsScreenLayoutKind>(kind),
+                           kDigestCanvases[index][0],
+                           kDigestCanvases[index][1], false, true);
+        }
+    }
+    const NdsScreenLayoutResult second =
+        compute_layout(kNdsLayoutSideBySide, 1280, 720, true, false);
+    check(rects_equal(first.rects[kNdsScreenTop],
+                      second.rects[kNdsScreenTop]) &&
+              rects_equal(first.rects[kNdsScreenBottom],
+                          second.rects[kNdsScreenBottom]) &&
+              first.native_scale == second.native_scale,
+          "an unrelated call in between does not move a layout",
+          describe(first) + " then " + describe(second));
+}
+
+}  // namespace
+
+int main() {
+    check_sweep();
+    check_swap_rule();
+    check_minimum_boundary();
+    check_degenerate_canvas();
+    check_oversize_canvas();
+    check_frontend_canvases();
+    check_totality();
+    check_determinism();
+
+    if (g_failures == 0) {
+        std::printf("%d checks passed\n", g_checks);
+        return 0;
+    }
+    std::printf("%d of %d checks failed\n", g_failures, g_checks);
+    return g_first_failure;
+}
