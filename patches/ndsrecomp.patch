+// ---------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------
+
+void check_pins() {
+    for (const PinCase& pin : kPins) {
+        const NdsScreenLayoutResult got =
+            compute_layout(pin.kind, pin.canvas_width, pin.canvas_height,
+                           pin.integer_scale, false);
+        const bool ok =
+            got.valid == pin.valid &&
+            got.canvas_width == pin.canvas_width &&
+            got.canvas_height == pin.canvas_height &&
+            got.native_scale == pin.native_scale &&
+            got.unused_canvas_pixels == pin.unused_canvas_pixels &&
+            rects_equal(got.rects[kNdsScreenTop], pin.top) &&
+            rects_equal(got.rects[kNdsScreenBottom], pin.bottom);
+        check(ok, pin.label, describe(got) + " want " + describe_pin(pin));
+    }
+}
+
+// Swapping exchanges the two screens and changes NOTHING else: the canvas echo,
+// the scale and the leftover pixels are identical either way. The single-window
+// layouts ignore it, because there is only one rectangle to swap into.
+void check_swap() {
+    for (const PinCase& pin : kPins) {
+        const NdsScreenLayoutResult got =
+            compute_layout(pin.kind, pin.canvas_width, pin.canvas_height,
+                           pin.integer_scale, true);
+        const bool single = layout_is_single_window(pin.kind);
+        const NdsScreenRect want_top = single ? pin.top : pin.bottom;
+        const NdsScreenRect want_bottom = single ? pin.bottom : pin.top;
+        const bool ok = got.valid == pin.valid &&
+                        got.native_scale == pin.native_scale &&
+                        got.unused_canvas_pixels == pin.unused_canvas_pixels &&
+                        rects_equal(got.rects[kNdsScreenTop], want_top) &&
+                        rects_equal(got.rects[kNdsScreenBottom], want_bottom);
+        check(ok, std::string(pin.label) + " swapped",
+              describe(got) + " want top " + rect_text(want_top) +
+                  " bottom " + rect_text(want_bottom));
+    }
+}
