+        empty_name.root.files.push_back(FileSpec{"TOP.BIN", 0, 8u, 0x60u});
+        DirSpec nameless;
+        nameless.name = "";
+        empty_name.root.dirs.push_back(nameless);
+        broken = build_rom(empty_name);
