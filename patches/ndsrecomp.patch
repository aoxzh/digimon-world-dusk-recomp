+        check(loaded && options.screen_layout == spelling.expected,
+              std::string("a file with ") + spelling.label + " loads",
+              loaded ? "loaded value " +
+                           std::to_string(
+                               static_cast<int>(options.screen_layout))
+                     : "error: " + quote_text(error));
+        if (!loaded) continue;
+        // And what the build writes back is a spelling it accepts, so a save
+        // followed by a load is not a one-way trip.
+        const std::string written =
