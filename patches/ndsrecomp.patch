new file mode 100644
index 0000000..b953ef9
--- /dev/null
+++ b/runner/tests/host_capture_test.cpp
@@ -0,0 +1,1334 @@
+// Pins the dependency-free PNG capture writer and the capture path helper
+// (host_capture.h) against an INDEPENDENT decoder written here.
+//
+// "The file opens in an image viewer" is not a test: a wrong CRC-32, a
+// byte-swapped Adler-32, an inverted LEN/NLEN or a stray stride byte all
+// survive a viewer, and those are exactly the mistakes a hand-rolled encoder
+// makes. So this file walks the container itself:
+//
+//   * the 8-byte signature, then every chunk, recomputing each CRC-32 with a
+//     bit-at-a-time implementation that shares no table with the writer;
+//   * IHDR first with the documented fields, one or more IDAT, IEND last, and
+//     no byte after IEND;
+//   * the zlib header (deflate method, FCHECK divisible by 31, no preset
+//     dictionary) and the Adler-32 trailer over the decompressed bytes;
+//   * the deflate "stored" blocks, checking each LEN/NLEN complement, which
+//     exercises the 65535-byte block splitting on a multi-block image;
+//   * the per-scanline filter byte, pinned to 0 by the writer's contract, and
+//     every pixel against the source ARGB buffer with alpha dropped;
+//   * strides wider than the row (padding garbage must never reach the file),
+//     widths whose RGB scanline is not a multiple of four bytes, the smallest
+//     and a presenter-sized image, and a full-range pixel set.
+//
+// The reader is itself mutation-tested first: a valid capture is corrupted in
+// each field in turn, chunk CRCs are re-stamped so the fault is semantic
+// rather than a CRC mismatch, and the decoder must reject it with a message
+// naming that field. A decoder that accepts anything cannot make the writer
+// appear correct.
+//
+// Every assertion prints OK with its own name; a failure prints FAIL plus one
+// detail line and exits with an error code outside 0..255, so a failing check
+// names itself without a debugger.
+
+#include "host_capture.h"
+
+#include <chrono>
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace {
+
+std::size_t g_checks = 0;
+
+bool require(bool value) {
+    return value;
+}
+
+void ok(const std::string& name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name.c_str());
+}
+
+// Reports the assertion that just failed. The exit code is the ordinal of that
+// assertion, so it is unique by construction and points at the OK numbering.
+int fail(const std::string& name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name.c_str(), detail.c_str());
+    return static_cast<int>(g_checks + 1u);
+}
+
+template <typename T>
+std::string number(T value) {
+    return std::to_string(value);
+}
+
+std::string hex(uint32_t value, int digits) {
+    char buffer[16];
+    std::snprintf(buffer, sizeof(buffer), "0x%0*X", digits,
+                  static_cast<unsigned>(value));
+    return buffer;
+}
+
+// ---- byte readers ---------------------------------------------------------
+
+bool read_be32(const std::vector<uint8_t>& bytes, std::size_t at,
+               uint32_t* out) {
+    if (at > bytes.size() || bytes.size() - at < 4u) return false;
+    *out = (static_cast<uint32_t>(bytes[at]) << 24u) |
+           (static_cast<uint32_t>(bytes[at + 1u]) << 16u) |
+           (static_cast<uint32_t>(bytes[at + 2u]) << 8u) |
+           static_cast<uint32_t>(bytes[at + 3u]);
+    return true;
+}
+
+void write_be32(std::vector<uint8_t>* bytes, std::size_t at, uint32_t value) {
+    (*bytes)[at] = static_cast<uint8_t>(value >> 24u);
+    (*bytes)[at + 1u] = static_cast<uint8_t>(value >> 16u);
+    (*bytes)[at + 2u] = static_cast<uint8_t>(value >> 8u);
+    (*bytes)[at + 3u] = static_cast<uint8_t>(value);
+}
+
+uint16_t read_le16(const std::vector<uint8_t>& bytes, std::size_t at) {
+    return static_cast<uint16_t>(
+        static_cast<uint16_t>(bytes[at]) |
+        static_cast<uint16_t>(static_cast<uint16_t>(bytes[at + 1u]) << 8u));
+}
+
+// Inverts the low bit of one byte: the smallest damage that changes a field
+// without changing the file's length, so chunk offsets stay valid.
+void flip_byte(std::vector<uint8_t>* bytes, std::size_t at) {
+    (*bytes)[at] = static_cast<uint8_t>((*bytes)[at] ^ 0x01u);
+}
+
+// ---- CRC-32 (PNG polynomial), bit-at-a-time -------------------------------
+//
+// Deliberately not table-driven and sharing nothing with the writer: a second
+// independent implementation is what makes a table-build bug inside
+// host_capture.cpp visible instead of self-confirming.
+
+uint32_t png_crc32(const uint8_t* data, std::size_t size) {
+    uint32_t crc = 0xFFFFFFFFu;
+    for (std::size_t i = 0; i < size; ++i) {
+        crc ^= data[i];
+        for (int bit = 0; bit < 8; ++bit) {
+            crc = (crc & 1u) ? (0xEDB88320u ^ (crc >> 1u)) : (crc >> 1u);
+        }
+    }
+    return ~crc;
+}
+
+// ---- Adler-32 -------------------------------------------------------------
+
+uint32_t adler32(const std::vector<uint8_t>& bytes) {
+    uint64_t low = 1u;
+    uint64_t high = 0u;
+    for (const uint8_t byte : bytes) {
+        low += byte;
+        high += low;
+        if (low >= 65521u) low -= 65521u;
+        if (high >= 65521u) high %= 65521u;
+    }
+    return static_cast<uint32_t>((high << 16u) | low);
+}
+
+// ---- zlib stream: stored blocks only --------------------------------------
+
+struct InflateResult {
+    std::vector<uint8_t> raw;
+    std::size_t blocks = 0;
+};
+
+// Empty string means success; otherwise the text names the defect.
+std::string inflate_stored(const std::vector<uint8_t>& stream,
+                           InflateResult* out) {
+    if (stream.size() < 6u) {
+        return "zlib stream of " + number(stream.size()) +
+               " bytes cannot hold a header and a trailer";
+    }
+
+    const unsigned cmf = stream[0];
+    const unsigned flg = stream[1];
+    const unsigned method = cmf & 0x0Fu;
+    const unsigned window = (cmf >> 4u) & 0x0Fu;
+    const unsigned dictionary = (flg >> 5u) & 0x1u;
+    const unsigned level = (flg >> 6u) & 0x3u;
+    if (method != 8u) {
+        return "zlib CM is " + number(method) + ", expected 8 (deflate)";
+    }
+    if (window > 7u) {
+        return "zlib CINFO is " + number(window) + ", maximum is 7";
+    }
+    if (dictionary != 0u) return "zlib stream declares a preset dictionary";
+    if (((cmf << 8u) | flg) % 31u != 0u) {
+        return "zlib FCHECK does not make CMF/FLG divisible by 31 (" +
+               hex(cmf, 2) + " " + hex(flg, 2) + ")";
+    }
+    // 0x78 0x01 is the framing the writer documents; FLEVEL is informational
+    // to zlib, so a change here means the header was touched.
+    if (level != 0u) {
+        return "zlib FLEVEL is " + number(level) + ", the writer emits 0";
+    }
+
+    const std::size_t body_end = stream.size() - 4u;
+    std::size_t cursor = 2u;
+    bool saw_final = false;
+    InflateResult result;
+    while (!saw_final) {
+        if (cursor > body_end || body_end - cursor < 5u) {
+            return "truncated deflate block header at offset " +
+                   number(cursor);
+        }
+        const unsigned header = stream[cursor];
+        const unsigned final_block = header & 0x1u;
+        const unsigned type = (header >> 1u) & 0x3u;
+        if (type != 0u) {
+            return "deflate block type " + number(type) + " at offset " +
+                   number(cursor) + ", the writer emits stored (0) blocks";
+        }
+        const uint16_t len = read_le16(stream, cursor + 1u);
+        const uint16_t nlen = read_le16(stream, cursor + 3u);
+        if (static_cast<uint16_t>(len ^ nlen) != 0xFFFFu) {
+            return "deflate LEN/NLEN are not complementary: " + hex(len, 4) +
+                   " / " + hex(nlen, 4);
+        }
+        cursor += 5u;
+        if (body_end - cursor < len) {
+            return "deflate block claims " + number(len) + " bytes but only " +
+                   number(body_end - cursor) + " remain before the Adler-32";
+        }
+        result.raw.insert(result.raw.end(), stream.begin() + cursor,
+                          stream.begin() + cursor + len);
+        cursor += len;
+        ++result.blocks;
+        saw_final = final_block != 0u;
+        if (!saw_final && body_end == cursor) {
+            return "deflate stream ends after a non-final block";
+        }
+    }
+    if (cursor != body_end) {
+        return "deflate stream has " + number(body_end - cursor) +
+               " extra bytes after the final block";
+    }
+
+    uint32_t stored = 0;
+    (void)read_be32(stream, body_end, &stored);
+    const uint32_t computed = adler32(result.raw);
+    if (stored != computed) {
+        return "Adler-32 trailer is " + hex(stored, 8) +
+               " but the data hashes to " + hex(computed, 8);
+    }
+
+    *out = std::move(result);
+    return std::string();
+}
+
+// ---- PNG container --------------------------------------------------------
+
+struct DecodedPng {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    std::size_t chunks = 0;
+    std::size_t idat_chunks = 0;
+    std::size_t blocks = 0;
+    std::vector<uint8_t> rgb;
+};
+
+const uint8_t kSignature[8] = {0x89u, 'P', 'N', 'G', 0x0Du, 0x0Au, 0x1Au,
+                               0x0Au};
+
+// Empty string means success; otherwise the text names the defect.
+std::string decode_png(const std::vector<uint8_t>& file, DecodedPng* out) {
+    if (file.size() < sizeof(kSignature) + 24u) {
+        return "file of " + number(file.size()) + " bytes is too small";
+    }
+    for (std::size_t i = 0; i < sizeof(kSignature); ++i) {
+        if (file[i] != kSignature[i]) {
+            return "byte " + number(i) + " is " + hex(file[i], 2) +
+                   ", not the PNG signature";
+        }
+    }
+
+    DecodedPng png;
+    std::vector<uint8_t> idat;
+    bool saw_ihdr = false;
+    bool saw_iend = false;
+    std::size_t pos = sizeof(kSignature);
+    while (pos < file.size()) {
+        uint32_t length = 0;
+        if (!read_be32(file, pos, &length)) {
+            return "truncated chunk header at offset " + number(pos);
+        }
+        if (file.size() - pos < 12u) {
+            return "chunk at offset " + number(pos) +
+                   " has no room for a CRC";
+        }
+        if (length > file.size() - pos - 12u) {
+            return "chunk at offset " + number(pos) + " claims " +
+                   number(length) + " bytes but only " +
+                   number(file.size() - pos - 12u) + " remain";
+        }
+        const std::string type(
+            reinterpret_cast<const char*>(&file[pos + 4u]), 4u);
+        const std::size_t data = pos + 8u;
+        uint32_t stored_crc = 0;
+        (void)read_be32(file, data + length, &stored_crc);
+        const uint32_t computed_crc = png_crc32(&file[pos + 4u], 4u + length);
+        if (stored_crc != computed_crc) {
+            return type + " CRC is " + hex(stored_crc, 8) + ", computed " +
+                   hex(computed_crc, 8);
+        }
+        ++png.chunks;
+
+        if (!saw_ihdr && type != "IHDR") {
+            return "first chunk is '" + type + "', not IHDR";
+        }
+        if (type == "IHDR") {
+            if (saw_ihdr) return "duplicate IHDR";
+            if (length != 13u) {
+                return "IHDR length is " + number(length) + ", expected 13";
+            }
+            saw_ihdr = true;
+            (void)read_be32(file, data, &png.width);
+            (void)read_be32(file, data + 4u, &png.height);
+            if (png.width == 0u || png.height == 0u) {
+                return "IHDR size is " + number(png.width) + "x" +
+                       number(png.height);
+            }
+            if (file[data + 8u] != 8u) {
+                return "bit depth is " + number(file[data + 8u]) +
+                       ", expected 8";
+            }
+            if (file[data + 9u] != 2u) {
+                return "colour type is " + number(file[data + 9u]) +
+                       ", expected 2 (truecolour)";
+            }
+            if (file[data + 10u] != 0u) {
+                return "compression method is " + number(file[data + 10u]) +
+                       ", expected 0";
+            }
+            if (file[data + 11u] != 0u) {
+                return "filter method is " + number(file[data + 11u]) +
+                       ", expected 0";
+            }
+            if (file[data + 12u] != 0u) {
+                return "interlace method is " + number(file[data + 12u]) +
+                       ", expected 0 (none)";
+            }
+        } else if (type == "IDAT") {
+            if (!saw_ihdr) return "IDAT before IHDR";
+            idat.insert(idat.end(), file.begin() + data,
+                        file.begin() + data + length);
+            ++png.idat_chunks;
+        } else if (type == "IEND") {
+            if (length != 0u) {
+                return "IEND length is " + number(length) + ", expected 0";
+            }
+            if (png.idat_chunks == 0u) return "IEND before any IDAT";
+            saw_iend = true;
+            pos = data + length + 4u;
+            break;
+        } else {
+            return "unexpected chunk type '" + type + "'";
+        }
+        pos = data + length + 4u;
+    }
+    if (!saw_iend) return "file ends without IEND";
+    if (pos != file.size()) {
+        return number(file.size() - pos) + " trailing bytes after IEND";
+    }
+
+    InflateResult inflated;
+    const std::string problem = inflate_stored(idat, &inflated);
+    if (!problem.empty()) return problem;
+    png.blocks = inflated.blocks;
+
+    // Scanline layout: one filter-type byte, then three bytes per pixel.
+    const std::size_t width = png.width;
+    const std::size_t height = png.height;
+    if (width > (SIZE_MAX - 1u) / 3u) return "row length overflows size_t";
+    const std::size_t row = 1u + 3u * width;
+    if (height > SIZE_MAX / row) return "image size overflows size_t";
+    if (inflated.raw.size() != row * height) {
+        return "unfiltered stream is " + number(inflated.raw.size()) +
+               " bytes, expected " + number(row * height) + " (" +
+               number(width) + "x" + number(height) +
+               ", filter byte plus RGB)";
+    }
+
+    png.rgb.reserve(3u * width * height);
+    for (std::size_t y = 0; y < height; ++y) {
+        const std::size_t at = y * row;
+        if (inflated.raw[at] != 0u) {
+            return "scanline " + number(y) + " uses filter type " +
+                   number(inflated.raw[at]) +
+                   ", the writer is pinned to 0 (None)";
+        }
+        png.rgb.insert(png.rgb.end(), inflated.raw.begin() + at + 1u,
+                       inflated.raw.begin() + at + row);
+    }
+
+    *out = std::move(png);
+    return std::string();
+}
+
+// Recomputes every chunk CRC in place, so a mutation that changes chunk data
+// is rejected for its semantic fault and not merely for a stale CRC.
+bool stamp_crcs(std::vector<uint8_t>* file) {
+    std::size_t pos = sizeof(kSignature);
+    while (pos + 12u <= file->size()) {
+        uint32_t length = 0;
+        if (!read_be32(*file, pos, &length)) return false;
+        if (pos + 12u + length > file->size()) return false;
+        const uint32_t crc = png_crc32(&(*file)[pos + 4u], 4u + length);
+        write_be32(file, pos + 8u + length, crc);
+        const char* type_bytes =
+            reinterpret_cast<const char*>(&(*file)[pos + 4u]);
+        const std::string type(type_bytes, 4u);
+        if (type == "IEND") return true;
+        pos += 12u + length;
+    }
+    return false;
+}
+
+// ---- pixel comparison -----------------------------------------------------
+
+// Every visible pixel must match the ARGB source with alpha dropped.
+std::string compare_pixels(const DecodedPng& png,
+                           const std::vector<uint32_t>& buffer,
+                           std::size_t width, std::size_t height,
+                           std::size_t pitch) {
+    for (std::size_t y = 0; y < height; ++y) {
+        const uint32_t* row = buffer.data() + y * pitch;
+        for (std::size_t x = 0; x < width; ++x) {
+            const uint32_t argb = row[x];
+            const std::size_t at = (y * width + x) * 3u;
+            const uint32_t got = (static_cast<uint32_t>(png.rgb[at]) << 16u) |
+                                 (static_cast<uint32_t>(png.rgb[at + 1u])
+                                  << 8u) |
+                                 static_cast<uint32_t>(png.rgb[at + 2u]);
+            if (got != (argb & 0xFFFFFFu)) {
+                return "pixel (" + number(x) + "," + number(y) + ") is " +
+                       hex(got, 6) + ", source ARGB " + hex(argb, 8) +
+                       " wants " + hex(argb & 0xFFFFFFu, 6);
+            }
+        }
+    }
+    return std::string();
+}
+
+// The RGB triplet at a pixel index, for the full-range image's explicit
+// channel assertions.
+uint32_t rgb_triplet(const DecodedPng& png, std::size_t index) {
+    const std::size_t at = index * 3u;
+    return (static_cast<uint32_t>(png.rgb[at]) << 16u) |
+           (static_cast<uint32_t>(png.rgb[at + 1u]) << 8u) |
+           static_cast<uint32_t>(png.rgb[at + 2u]);
+}
+
+// ---- buffers --------------------------------------------------------------
+
+// A recognisable gradient whose alpha byte is deliberately varied: alpha must
+// never reach the file, so a writer that emitted four bytes per pixel or
+// swapped a channel shows up as a mismatch. `padding` fills the stride
+// padding, where garbage must stay invisible.
+std::vector<uint32_t> make_buffer(std::size_t width, std::size_t height,
+                                  std::size_t pitch, uint32_t padding) {
+    std::vector<uint32_t> buffer(pitch * height, padding);
+    for (std::size_t y = 0; y < height; ++y) {
+        for (std::size_t x = 0; x < width; ++x) {
+            const uint32_t r = static_cast<uint32_t>(x * 17u) & 0xFFu;
+            const uint32_t g = static_cast<uint32_t>(y * 29u) & 0xFFu;
+            const uint32_t b = static_cast<uint32_t>((x + y) * 7u) & 0xFFu;
+            const uint32_t a = 0xFFu - static_cast<uint32_t>(x * 3u + y);
+            buffer[y * pitch + x] = (a << 24u) | (r << 16u) | (g << 8u) | b;
+        }
+    }
+    return buffer;
+}
+
+// ---- file helpers ---------------------------------------------------------
+
+bool read_bytes(const std::filesystem::path& path,
+                std::vector<uint8_t>* out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    out->assign(std::istreambuf_iterator<char>(in),
+                std::istreambuf_iterator<char>());
+    return true;
+}
+
+// Writes one capture and decodes the file back. `problem` is empty on success
+// and otherwise names the first thing that did not hold.
+struct Capture {
+    std::vector<uint8_t> file;
+    DecodedPng png;
+    std::string problem;
+};
+
+Capture capture(const std::filesystem::path& path,
+                const std::vector<uint32_t>& buffer, std::size_t width,
+                std::size_t height, std::size_t pitch) {
+    Capture result;
+    if (!nds_capture_write_png(buffer.data(), static_cast<int>(width),
+                               static_cast<int>(height),
+                               static_cast<int>(pitch), path.string())) {
+        result.problem = "write_png returned false: " +
+                         std::string(nds_capture_last_error());
+        return result;
+    }
+    if (!read_bytes(path, &result.file)) {
+        result.problem = "cannot read back the capture '" + path.string() + "'";
+        return result;
+    }
+    result.problem = decode_png(result.file, &result.png);
+    return result;
+}
+
+// Exact expected size of a capture: signature (8), IHDR (12 + 13), IDAT
+// (12 + zlib), IEND (12), with the zlib stream being a 2-byte header, 5 bytes
+// per stored block, the raw scanlines and a 4-byte Adler-32. Pinning the total
+// rules out a duplicate chunk, per-row padding or a missing IEND.
+std::size_t expected_png_bytes(std::size_t width, std::size_t height,
+                               std::size_t blocks) {
+    const std::size_t raw = (1u + 3u * width) * height;
+    return 8u + 25u + 12u + 6u + 5u * blocks + raw + 12u;
+}
+
+// Number of 65535-byte stored blocks the writer must emit for this shape.
+std::size_t expected_blocks(std::size_t width, std::size_t height) {
+    const std::size_t raw = (1u + 3u * width) * height;
+    return (raw + 65534u) / 65535u;
+}
+
+bool find_chunk(const std::vector<uint8_t>& file, const char* type,
+                std::size_t* data_offset, std::size_t* length) {
+    std::size_t pos = sizeof(kSignature);
+    while (pos + 12u <= file.size()) {
+        uint32_t chunk_length = 0;
+        if (!read_be32(file, pos, &chunk_length)) return false;
+        if (pos + 12u + chunk_length > file.size()) return false;
+        // Chunk type lives at pos + 4; the data follows the type and length.
+        const std::string name(reinterpret_cast<const char*>(&file[pos + 4u]),
+                               4u);
+        if (name == type) {
+            *data_offset = pos + 8u;
+            *length = chunk_length;
+            return true;
+        }
+        pos += 12u + chunk_length;
+    }
+    return false;
+}
+
+// ---- capture name parsing -------------------------------------------------
+
+bool is_digit(char ch) { return ch >= '0' && ch <= '9'; }
+
+// The path helper's documented shape is "<stem>-YYYYMMDD-HHMMSS[-N].png" with
+// forward slashes. `suffix` receives 0 for the first attempt and 2 or more for
+// the collision suffixes.
+bool parse_capture_name(const std::string& path, const std::string& stem,
+                        std::string* stamp, int* suffix) {
+    const std::size_t slash = path.find_last_of('/');
+    const std::string name =
+        slash == std::string::npos ? path : path.substr(slash + 1u);
+    const std::string prefix = stem + "-";
+    if (name.size() < prefix.size() + 15u + 4u) return false;
+    if (name.compare(0u, prefix.size(), prefix) != 0u) return false;
+    const std::string tail = name.substr(prefix.size());
+    *stamp = tail.substr(0u, 15u);
+    for (std::size_t i = 0; i < stamp->size(); ++i) {
+        const char ch = (*stamp)[i];
+        if (i == 8u ? ch != '-' : !is_digit(ch)) return false;
+    }
+    const std::string rest = tail.substr(15u);
+    if (rest == ".png") {
+        *suffix = 0;
+        return true;
+    }
+    if (rest.size() < 6u || rest.compare(0u, 1u, "-") != 0u) return false;
+    if (rest.compare(rest.size() - 4u, 4u, ".png") != 0u) return false;
+    const std::string digits = rest.substr(1u, rest.size() - 5u);
+    if (digits.size() > 4u) return false;
+    for (const char ch : digits) {
+        if (!is_digit(ch)) return false;
+    }
+    *suffix = std::stoi(digits);
+    return *suffix >= 2;
+}
+
+std::string local_timestamp() {
+    const std::time_t now = std::time(nullptr);
+    std::tm broken_down{};
+#if defined(_WIN32)
+    if (localtime_s(&broken_down, &now) != 0) return {};
+#else
+    if (localtime_r(&now, &broken_down) == nullptr) return {};
+#endif
+    char buffer[32] = {};
+    if (std::strftime(buffer, sizeof(buffer), "%Y%m%d-%H%M%S",
+                      &broken_down) == 0u) {
+        return {};
+    }
+    return buffer;
+}
+
+std::string forward_slashes(std::string text) {
+    for (char& ch : text) {
+        if (ch == '\\') ch = '/';
+    }
+    return text;
+}
+
+// The "-2" suffix only appears when the first name already exists, which the
+// test can force by writing a file there, so the suffix itself is
+// deterministic; the only non-determinism is the wall clock ticking between
+// the two calls, which is retried a bounded number of times.
+bool force_collision(const std::string& directory, const std::string& stem,
+                     std::string* first, std::string* second) {
+    for (int attempt = 0; attempt < 200; ++attempt) {
+        const std::string one = nds_capture_target_path(directory, stem);
+        if (one.empty()) return false;
+        {
+            std::ofstream placeholder(one, std::ios::binary);
+            if (!placeholder) return false;
+        }
+        const std::string two = nds_capture_target_path(directory, stem);
+        *first = one;
+        *second = two;
+        if (two.empty()) return false;
+        std::string stamp_a;
+        std::string stamp_b;
+        int suffix_a = 0;
+        int suffix_b = 0;
+        if (!parse_capture_name(one, stem, &stamp_a, &suffix_a)) return false;
+        if (!parse_capture_name(two, stem, &stamp_b, &suffix_b)) return false;
+        if (stamp_a != stamp_b) {
+            // The clock ticked mid-test; the placeholder would leak, so drop
+            // it and try again in a fresh second.
+            std::error_code ignored;
+            std::filesystem::remove(one, ignored);
+            continue;
+        }
+        return suffix_a == 0 && suffix_b == 2;
+    }
+    return false;
+}
+
+// ---- decoder self-controls ------------------------------------------------
+
+// Damages a copy of a valid capture, re-stamps the chunk CRCs unless the
+// damage is structural, then requires the decoder to reject it with a message
+// naming the damaged field.
+int expect_rejected(const std::vector<uint8_t>& valid, const char* name,
+                    const char* keyword,
+                    const std::function<void(std::vector<uint8_t>*)>& damage,
+                    bool restamp) {
+    std::vector<uint8_t> file = valid;
+    damage(&file);
+    if (restamp && !stamp_crcs(&file)) {
+        return fail(std::string("decoder control '") + name + "'",
+                    "could not re-stamp the chunk CRCs after the mutation, so "
+                    "the control would not isolate the field under test");
+    }
+    DecodedPng png;
+    const std::string problem = decode_png(file, &png);
+    if (!require(!problem.empty())) {
+        return fail(std::string("decoder rejects ") + name,
+                    "decode_png accepted the file, so the matching writer "
+                    "check cannot be trusted");
+    }
+    if (!require(problem.find(keyword) != std::string::npos)) {
+        return fail(std::string("decoder rejects ") + name,
+                    "rejected with '" + problem +
+                        "', which does not mention '" + std::string(keyword) +
+                        "'");
+    }
+    ok(std::string("decoder rejects ") + name);
+    return 0;
+}
+
+// ---- one image, every promise ---------------------------------------------
+
+// Writes, decodes and compares one capture, asserting each property the
+// writer promises for a successful write. `pitch` may exceed `width`, in which
+// case the stride padding holds garbage that must not appear in the file.
+int check_capture(const char* name, const std::filesystem::path& path,
+                  const std::vector<uint32_t>& buffer, std::size_t width,
+                  std::size_t height, std::size_t pitch) {
+    const std::string label(name);
+    const Capture got = capture(path, buffer, width, height, pitch);
+    if (!require(got.problem.empty())) return fail(label, got.problem);
+
+    const std::size_t blocks = expected_blocks(width, height);
+    if (!require(got.png.width == static_cast<uint32_t>(width) &&
+                 got.png.height == static_cast<uint32_t>(height))) {
+        return fail(label + " header", "IHDR says " + number(got.png.width) +
+                                           "x" + number(got.png.height) +
+                                           ", wrote " + number(width) + "x" +
+                                           number(height));
+    }
+    ok(label + " header");
+
+    if (!require(got.png.blocks == blocks)) {
+        return fail(label + " stored blocks",
+                    "inflated " + number(got.png.blocks) +
+                        " stored block(s), expected " + number(blocks) +
+                        " for " + number((1u + 3u * width) * height) +
+                        " raw bytes at the 65535-byte block size");
+    }
+    ok(label + " stored blocks");
+
+    if (!require(got.file.size() ==
+                 expected_png_bytes(width, height, blocks))) {
+        return fail(label + " byte count",
+                    "file is " + number(got.file.size()) + " bytes, expected " +
+                        number(expected_png_bytes(width, height, blocks)));
+    }
+    ok(label + " byte count");
+
+    if (!require(got.png.chunks == 2u + got.png.idat_chunks)) {
+        return fail(label + " chunk order",
+                    "saw " + number(got.png.chunks) + " chunk(s) with " +
+                        number(got.png.idat_chunks) +
+                        " IDAT, expected IHDR, IDAT and IEND only");
+    }
+    ok(label + " chunk order");
+
+    const std::string mismatch =
+        compare_pixels(got.png, buffer, width, height, pitch);
+    if (!require(mismatch.empty())) return fail(label + " pixels", mismatch);
+    ok(label + " pixels");
+
+    if (!require(nds_capture_last_error()[0] == '\0')) {
+        return fail(label + " clears the last error",
+                    std::string("last error after a successful write is '") +
+                        nds_capture_last_error() + "'");
+    }
+    ok(label + " clears the last error");
+    return 0;
+}
+
+// ---- the checks -----------------------------------------------------------
+
+int run_checks(const std::filesystem::path& root) {
+    // ---- 0. the decoder rejects what it claims to inspect ----------------
+    const std::vector<uint32_t> control_pixels = make_buffer(8u, 6u, 8u, 0u);
+    const Capture control =
+        capture(root / "control.png", control_pixels, 8u, 6u, 8u);
+    if (const int rc = (require(control.problem.empty())
+                            ? (ok("control capture decodes"), 0)
+                            : fail("control capture decodes",
+                                   control.problem))) {
+        return rc;
+    }
+
+    std::size_t ihdr_data = 0;
+    std::size_t ihdr_length = 0;
+    std::size_t idat_data = 0;
+    std::size_t idat_length = 0;
+    if (!require(find_chunk(control.file, "IHDR", &ihdr_data, &ihdr_length) &&
+                 find_chunk(control.file, "IDAT", &idat_data, &idat_length))) {
+        return fail("control chunks are locatable",
+                    "cannot find IHDR/IDAT in the control capture");
+    }
+    ok("control chunks are locatable");
+
+    // Small mutators, so each control lambda below only needs to capture the
+    // offset it damages.
+    const auto set_ihdr_byte = [ihdr_data](std::vector<uint8_t>* file,
+                                           std::size_t offset,
+                                           uint8_t value) {
+        (*file)[ihdr_data + offset] = value;
+    };
+
+    if (const int rc = expect_rejected(
+            control.file, "a bad signature", "signature",
+            [](std::vector<uint8_t>* file) {
+                (*file)[1] = static_cast<uint8_t>('X');
+            },
+            false)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a zero IHDR width", "size",
+            [ihdr_data](std::vector<uint8_t>* file) {
+                write_be32(file, ihdr_data, 0u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a 16-bit bit depth", "bit depth",
+            [&set_ihdr_byte](std::vector<uint8_t>* file) {
+                set_ihdr_byte(file, 8u, 16u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "colour type 6", "colour type",
+            [&set_ihdr_byte](std::vector<uint8_t>* file) {
+                set_ihdr_byte(file, 9u, 6u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "an interlace method", "interlace",
+            [&set_ihdr_byte](std::vector<uint8_t>* file) {
+                set_ihdr_byte(file, 12u, 1u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a stale IHDR CRC", "CRC",
+            [ihdr_data](std::vector<uint8_t>* file) {
+                (*file)[ihdr_data] = static_cast<uint8_t>(
+                    (*file)[ihdr_data] ^ 0x01u);
+            },
+            false)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "an IHDR-less file", "not IHDR",
+            [](std::vector<uint8_t>* file) {
+                // Drop the 25-byte IHDR chunk; the IDAT must not be accepted
+                // as the first chunk.
+                file->erase(file->begin() + 8, file->begin() + 8 + 25);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "an unexpected chunk type", "unexpected",
+            [idat_data](std::vector<uint8_t>* file) {
+                // Rename IDAT to tEXt: the length is untouched, so the chunk
+                // structure still parses and only the type is unknown.
+                (*file)[idat_data - 4u] = static_cast<uint8_t>('t');
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a broken zlib FCHECK", "divisible by 31",
+            [idat_data](std::vector<uint8_t>* file) {
+                flip_byte(file, idat_data + 1u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a non-stored deflate block", "block type",
+            [idat_data](std::vector<uint8_t>* file) {
+                (*file)[idat_data + 2u] = 0x03u;
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "an inverted LEN/NLEN", "complementary",
+            [idat_data](std::vector<uint8_t>* file) {
+                flip_byte(file, idat_data + 6u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a wrong Adler-32", "Adler-32",
+            [idat_data, idat_length](std::vector<uint8_t>* file) {
+                flip_byte(file, idat_data + idat_length - 1u);
+            },
+            true)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a missing IEND", "without IEND",
+            [](std::vector<uint8_t>* file) {
+                file->resize(file->size() - 12u);
+            },
+            false)) {
+        return rc;
+    }
+    if (const int rc = expect_rejected(
+            control.file, "a trailing byte", "trailing",
+            [](std::vector<uint8_t>* file) { file->push_back(0x00u); }, true)) {
+        return rc;
+    }
+
+    // ---- 1. the smallest image -------------------------------------------
+    const std::vector<uint32_t> one_pixel{0xFF123456u};
+    if (const int rc = check_capture("1x1", root / "one.png", one_pixel, 1u,
+                                     1u, 1u)) {
+        return rc;
+    }
+    {
+        const Capture single = capture(root / "one.png", one_pixel, 1u, 1u, 1u);
+        if (!require(single.problem.empty())) {
+            return fail("1x1 detail", single.problem);
+        }
+        if (!require(single.file.size() == 72u)) {
+            return fail("1x1 byte count is 72",
+                        "file is " + number(single.file.size()) + " bytes");
+        }
+        ok("1x1 byte count is 72");
+        if (!require(rgb_triplet(single.png, 0u) == 0x123456u)) {
+            return fail("1x1 alpha is dropped",
+                        "pixel is " + hex(rgb_triplet(single.png, 0u), 6) +
+                            ", expected 0x123456 (alpha 0xFF dropped)");
+        }
+        ok("1x1 alpha is dropped");
+    }
+
+    // ---- 2. presenter-sized images ---------------------------------------
+    const std::vector<uint32_t> small = make_buffer(256u, 192u, 256u, 0u);
+    if (const int rc = check_capture("256x192", root / "small.png", small, 256u,
+                                     192u, 256u)) {
+        return rc;
+    }
+    // 448x192 needs 258240 raw bytes, which forces four stored blocks: the
+    // 65535-byte splitting and the BFINAL bit on the last block are only
+    // exercised by an image this large.
+    const std::vector<uint32_t> large = make_buffer(448u, 192u, 448u, 0u);
+    if (const int rc = check_capture("448x192", root / "large.png", large, 448u,
+                                     192u, 448u)) {
+        return rc;
+    }
+
+    // ---- 3. scanlines whose byte count is not a multiple of four ---------
+    // A 3-pixel row is 1 + 9 = 10 bytes and a 5-pixel row is 1 + 15 = 16, so
+    // neither is aligned for a four-byte-at-a-time writer.
+    const std::vector<uint32_t> narrow = make_buffer(3u, 2u, 3u, 0u);
+    if (const int rc = check_capture("3x2 (10-byte rows)", root / "narrow.png",
+                                     narrow, 3u, 2u, 3u)) {
+        return rc;
+    }
+    const std::vector<uint32_t> odd = make_buffer(5u, 3u, 5u, 0u);
+    if (const int rc = check_capture("5x3 (15-byte rows)", root / "odd.png",
+                                     odd, 5u, 3u, 5u)) {
+        return rc;
+    }
+
+    // ---- 4. a stride wider than the image --------------------------------
+    // The padding holds 0xDEADBEEF: if the writer wrote the whole stride the
+    // pixel comparison fails, and if it wrote the padding as pixels the size
+    // and pixel checks both fail.
+    const std::vector<uint32_t> padded =
+        make_buffer(7u, 4u, 12u, 0xDEADBEEFu);
+    if (const int rc = check_capture("7x4 with a 12-pixel stride",
+                                     root / "padded.png", padded, 7u, 4u,
+                                     12u)) {
+        return rc;
+    }
+
+    // ---- 5. the full channel range ---------------------------------------
+    const std::vector<uint32_t> extremes{
+        0x00000000u, 0xFFFFFFFFu, 0x00FF0000u,
+        0x0000FF00u, 0x000000FFu, 0xFF123456u,
+    };
+    if (const int rc = check_capture("3x2 full range", root / "extremes.png",
+                                     extremes, 3u, 2u, 3u)) {
+        return rc;
+    }
+    {
+        const Capture range =
+            capture(root / "extremes.png", extremes, 3u, 2u, 3u);
+        if (!require(range.problem.empty())) {
+            return fail("extreme pixels", range.problem);
+        }
+        const uint32_t wanted[6] = {0x000000u, 0xFFFFFFu, 0xFF0000u,
+                                    0x00FF00u, 0x0000FFu, 0x123456u};
+        const char* names[6] = {"0x00000000 is black", "0xFFFFFFFF is white",
+                                "0x00FF0000 is red", "0x0000FF00 is green",
+                                "0x000000FF is blue", "0xFF123456 drops alpha"};
+        for (std::size_t i = 0; i < 6u; ++i) {
+            if (!require(rgb_triplet(range.png, i) == wanted[i])) {
+                return fail(names[i], "pixel " + number(i) + " is " +
+                                          hex(rgb_triplet(range.png, i), 6) +
+                                          ", expected " + hex(wanted[i], 6));
+            }
+            ok(names[i]);
+        }
+    }
+
+    // ---- 6. rejected arguments -------------------------------------------
+    // Every bad argument must return false AND leave a non-empty reason, so a
+    // silent `return false` with a stale or empty message is caught too.
+    const std::vector<uint32_t> tiny = make_buffer(4u, 4u, 4u, 0u);
+    const std::string tiny_path = (root / "rejected.png").string();
+    const std::filesystem::path rejected_dir = root / "rejected-dir";
+    std::error_code made;
+    std::filesystem::create_directories(rejected_dir, made);
+    const std::string rejected_dir_text = rejected_dir.string();
+    const std::string marker = (rejected_dir / "marker.txt").string();
+    {
+        std::ofstream out(marker, std::ios::binary);
+        out << "keep me\n";
+    }
+    struct Rejection {
+        const char* name;
+        const uint32_t* pixels;
+        int width;
+        int height;
+        int pitch;
+        std::string path;
+    };
+    const Rejection rejections[8] = {
+        {"null pixels", nullptr, 4, 4, 4, tiny_path},
+        {"zero width", tiny.data(), 0, 4, 4, tiny_path},
+        {"zero height", tiny.data(), 4, 0, 4, tiny_path},
+        {"negative width", tiny.data(), -3, 4, 4, tiny_path},
+        {"negative height", tiny.data(), 4, -1, 4, tiny_path},
+        {"pitch narrower than the row", tiny.data(), 4, 4, 2, tiny_path},
+        {"empty path", tiny.data(), 4, 4, 4, ""},
+        {"a directory as the destination", tiny.data(), 4, 4, 4,
+         rejected_dir_text},
+    };
+    for (const Rejection& rejection : rejections) {
+        const bool wrote = nds_capture_write_png(
+            rejection.pixels, rejection.width, rejection.height,
+            rejection.pitch, rejection.path);
+        const std::string label = std::string("rejects ") + rejection.name;
+        if (!require(!wrote)) {
+            return fail(label, "write_png returned true");
+        }
+        const std::string reason = nds_capture_last_error();
+        if (!require(!reason.empty())) {
+            return fail(label, "returned false but left last_error empty");
+        }
+        ok(label + " (" + reason + ")");
+    }
+    if (!require(std::filesystem::exists(marker))) {
+        return fail("a refused write leaves the destination directory intact",
+                    "the marker file inside '" + rejected_dir.string() +
+                        "' disappeared");
+    }
+    ok("a refused write leaves the destination directory intact");
+
+    // A size that cannot be addressed must fail rather than truncate.
+    if (!require(!nds_capture_write_png(tiny.data(), INT_MAX, INT_MAX, INT_MAX,
+                                        tiny_path))) {
+        return fail("rejects an unaddressable size",
+                    "write_png accepted INT_MAX x INT_MAX");
+    }
+    ok("rejects an unaddressable size (" +
+       std::string(nds_capture_last_error()) + ")");
+
+    // A failure must not poison later calls: the next success clears the text.
+    if (const int rc =
+            check_capture("a write after a failure", root / "again.png",
+                          tiny, 4u, 4u, 4u)) {
+        return rc;
+    }
+
+    // ---- 7. the capture path helper --------------------------------------
+    // The directory does not exist yet: the helper must create every parent.
+    const std::filesystem::path nested = root / "shots" / "session-1";
+    const std::string nested_text = nested.string();
+    const std::string before = local_timestamp();
+    const std::string shot = nds_capture_target_path(nested_text, "shot");
+    const std::string after = local_timestamp();
+    if (!require(!shot.empty())) {
+        return fail("creates the capture directory",
+                    "returned an empty path: " +
+                        std::string(nds_capture_last_error()));
+    }
+    ok("creates the capture directory");
+    if (!require(std::filesystem::is_directory(nested))) {
+        return fail("creates nested parents",
+                    "'" + nested_text + "' is not a directory");
+    }
+    ok("creates nested parents");
+    if (!require(nds_capture_last_error()[0] == '\0')) {
+        return fail("the path helper clears the last error",
+                    "last error is '" + std::string(nds_capture_last_error()) +
+                        "'");
+    }
+    ok("the path helper clears the last error");
+    if (!require(shot.find('\\') == std::string::npos)) {
+        return fail("uses forward slashes", "'" + shot + "' has a backslash");
+    }
+    ok("uses forward slashes");
+    if (!require(shot.compare(0u, forward_slashes(nested_text).size() + 1u,
+                              forward_slashes(nested_text) + "/") == 0u)) {
+        return fail("keeps the requested directory",
+                    "'" + shot + "' is not inside '" +
+                        forward_slashes(nested_text) + "'");
+    }
+    ok("keeps the requested directory");
+
+    std::string stamp;
+    int suffix = -1;
+    if (!require(parse_capture_name(shot, "shot", &stamp, &suffix))) {
+        return fail("names the file <stem>-YYYYMMDD-HHMMSS.png",
+                    "'" + shot + "' does not match the documented shape");
+    }
+    ok("names the file <stem>-YYYYMMDD-HHMMSS.png");
+    if (!require(suffix == 0)) {
+        return fail("the first name has no suffix",
+                    "'" + shot + "' carries suffix " + number(suffix));
+    }
+    ok("the first name has no suffix");
+    if (!require(stamp == before || stamp == after)) {
+        return fail("stamps the local time",
+                    "name carries '" + stamp + "', local time was '" + before +
+                        "' then '" + after + "'");
+    }
+    ok("stamps the local time");
+    if (!require(!std::filesystem::exists(shot))) {
+        return fail("returns a name without creating the file",
+                    "'" + shot + "' already exists");
+    }
+    ok("returns a name without creating the file");
+
+    // ---- 8. stem sanitising ----------------------------------------------
+    const std::string dirty = (root / "dirty").string();
+    const std::string sanitised =
+        nds_capture_target_path(dirty, "a b/c:d*e?f");
+    {
+        std::string sanitised_stamp;
+        int sanitised_suffix = -1;
+        if (!require(parse_capture_name(sanitised, "a_b_c_d_e_f",
+                                        &sanitised_stamp,
+                                        &sanitised_suffix))) {
+            return fail("replaces every unsupported character with '_'",
+                        "'" + sanitised + "' is not 'a_b_c_d_e_f-<time>.png'");
+        }
+        ok("replaces every unsupported character with '_'");
+        if (!require(forward_slashes(sanitised).find(
+                         forward_slashes(dirty) + "/") == 0u)) {
+            return fail("a sanitised stem cannot escape the directory",
+                        "'" + sanitised + "' left '" + forward_slashes(dirty) +
+                            "'");
+        }
+        ok("a sanitised stem cannot escape the directory");
+    }
+    {
+        // Multi-byte UTF-8 is sanitised per byte, so each continuation byte
+        // also becomes '_': this pins the byte-wise rule rather than a
+        // character-wise guess.
+        const std::string utf8_stem = "\xC3\xA9t\xC3\xA9";
+        const std::string path = nds_capture_target_path(dirty, utf8_stem);
+        std::string utf8_stamp;
+        int utf8_suffix = -1;
+        if (!require(parse_capture_name(path, "__t__", &utf8_stamp,
+                                        &utf8_suffix))) {
+            return fail("sanitises UTF-8 byte by byte",
+                        "'" + path + "' does not start with '__t__-'");
+        }
+        ok("sanitises UTF-8 byte by byte");
+    }
+    {
+        const std::string path = nds_capture_target_path(dirty, "");
+        std::string empty_stamp;
+        int empty_suffix = -1;
+        if (!require(parse_capture_name(path, "screenshot", &empty_stamp,
+                                        &empty_suffix))) {
+            return fail("an empty stem becomes 'screenshot'",
+                        "'" + path + "' does not start with 'screenshot-'");
+        }
+        ok("an empty stem becomes 'screenshot'");
+    }
+    {
+        // ".." and "." are kept, but as literal name components the directory
+        // separator check above already proved they cannot escape.
+        const std::string path = nds_capture_target_path(dirty, "a.b-c_9");
+        std::string dotted_stamp;
+        int dotted_suffix = -1;
+        if (!require(parse_capture_name(path, "a.b-c_9", &dotted_stamp,
+                                        &dotted_suffix))) {
+            return fail("keeps dots, hyphens and underscores",
+                        "'" + path + "' does not start with 'a.b-c_9-'");
+        }
+        ok("keeps dots, hyphens and underscores");
+    }
+
+    // ---- 9. same-second collisions ---------------------------------------
+    const std::string collide_dir = (root / "collide").string();
+    std::string first;
+    std::string second;
+    if (!require(force_collision(collide_dir, "shot", &first, &second))) {
+        return fail("a second capture in the same second gets '-2'",
+                    "observed '" + first + "' then '" + second + "'");
+    }
+    ok("a second capture in the same second gets '-2'");
+    {
+        std::string first_stamp;
+        std::string second_stamp;
+        int first_suffix = -1;
+        int second_suffix = -1;
+        (void)parse_capture_name(first, "shot", &first_stamp, &first_suffix);
+        (void)parse_capture_name(second, "shot", &second_stamp, &second_suffix);
+        if (!require(first_stamp == second_stamp)) {
+            return fail("both colliding names share one timestamp",
+                        "'" + first + "' vs '" + second + "'");
+        }
+        ok("both colliding names share one timestamp");
+        if (!require(second_suffix == first_suffix + 2)) {
+            return fail("the collision suffix is exactly '-2'",
+                        "'" + second + "' has suffix " +
+                            number(second_suffix));
+        }
+        ok("the collision suffix is exactly '-2'");
+        if (!require(first != second)) {
+            return fail("the colliding names differ", "'" + first + "'");
+        }
+        ok("the colliding names differ");
+        // Both names must be writable, so both are genuinely distinct targets
+        // and not just two spellings of one file.
+        const int rc_first =
+            check_capture("the first colliding name writes", first, tiny, 4u,
+                          4u, 4u);
+        if (rc_first != 0) return rc_first;
+        if (const int rc_second =
+                check_capture("the second colliding name writes", second, tiny,
+                              4u, 4u, 4u)) {
+            return rc_second;
+        }
+        if (!require(std::filesystem::file_size(first) ==
+                     std::filesystem::file_size(second))) {
+            return fail("both colliding files hold a full capture",
+                        "sizes differ");
+        }
+        ok("both colliding files hold a full capture");
+    }
+
+    // ---- 10. the path helper's failures ----------------------------------
+    const std::filesystem::path blocker = root / "blocker";
+    {
+        std::ofstream out(blocker, std::ios::binary);
+        out << "not a directory\n";
+    }
+    if (!require(nds_capture_target_path("", "shot").empty())) {
+        return fail("rejects an empty capture directory",
+                    "returned a path for an empty directory");
+    }
+    ok("rejects an empty capture directory (" +
+       std::string(nds_capture_last_error()) + ")");
+    {
+        const std::string blocked = (blocker / "shots").string();
+        if (!require(nds_capture_target_path(blocked, "shot").empty())) {
+            return fail("reports a directory it cannot create",
+                        "'" + blocked + "' was accepted although its parent is "
+                        "a regular file");
+        }
+        const std::string reason = nds_capture_last_error();
+        if (!require(reason.find("cannot create capture directory") !=
+                     std::string::npos)) {
+            return fail("names the directory it cannot create",
+                        "reason is '" + reason + "'");
+        }
+        ok("reports a directory it cannot create (" + reason + ")");
+    }
+
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// used first, but a sandboxed ctest run can refuse writes there because the
+// process working directory sits inside the tree under test, so the working
+// directory is tried second. Returns false only when neither location can hold
+// the tree, and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line that names both candidate
+    // paths stays unambiguous even when TEMP and the working directory are
+    // the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    const auto ticks =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    std::filesystem::path root;
+    if (!create_root("nds-host-capture-test", std::to_string(ticks), &root))
+        return 1;
+
+    const int result = run_checks(root);
+    std::error_code ignored;
+    std::filesystem::remove_all(root, ignored);
+    if (result != 0) {
+        std::fprintf(stderr, "%zu check(s) passed before the failure\n",
+                     g_checks);
+        return result;
+    }
+    std::printf("%zu checks passed\n", g_checks);
+    return 0;
+}
diff --git a/runner/tests/input_bindings_test.cpp b/runner/tests/input_bindings_test.cpp
new file mode 100644
index 0000000..d1c2638
--- /dev/null
+++ b/runner/tests/input_bindings_test.cpp
@@ -0,0 +1,805 @@
+// Pins the remappable-bindings data layer (input_bindings.h).
+//
+// This module is what makes the runner's keyboard and gamepad maps persist and
+// remappable, so the properties worth testing are the ones a rewrite could
+// quietly destroy:
+//
+//   * The shipped default table is exactly the map frontend.cpp hardcoded, so
+//     changing it here is a change to every player's out-of-the-box controls.
+//   * A binding travels as an SDL *name*, and an empty name means unbound: an
+//     unbound row has to persist as `controls.key.a=` and load back empty,
+//     because a player clears a binding on purpose and must not get it back.
+//   * The settings file is hand-edited and shared with the launcher, so only
+//     the `controls.key.*` / `controls.pad.*` rows may be touched; comments,
+//     blank lines, foreign keys and key order survive, and one corrupt row
+//     costs that row only -- the rest of the table still loads.
+//   * Lookups are case-insensitive and trimmed because the file may spell a
+//     name however the player typed it, and the lowest matching button wins
+//     because a live remap asks "which button fired" and needs one answer.
+//
+// Each assertion has its own nonzero return code and prints OK/FAIL with a
+// one-line detail, so a failure names itself without a debugger.
+
+#include "input_bindings.h"
+
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+int g_checks = 0;
+
+bool require(bool value) {
+    return value;
+}
+
+void ok(const char* name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name);
+}
+
+// Prints the failing check plus its detail and yields that check's exit code,
+// which is the ordinal of the check so it points at the OK numbering.
+int fail(const char* name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name, detail.c_str());
+    return g_checks + 1;
+}
+
+// Escapes a string so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\n') {
+            out += "\\n";
+        } else if (ch == '\r') {
+            out += "\\r";
+        } else if (ch == '\t') {
+            out += "\\t";
+        } else {
+            out.push_back(ch);
+        }
+    }
+    out += '"';
+    return out;
+}
+
+std::string show(const std::vector<std::string>& lines) {
+    std::string out = "[";
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        if (i != 0u) out += ", ";
+        out += quote(lines[i]);
+    }
+    out += ']';
+    return out;
+}
+
+std::string describe(const NdsInputBindings& bindings) {
+    std::string out;
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        out += nds_pad_button_name(static_cast<NdsPadButton>(i));
+        out += "=key:";
+        out += quote(bindings.key[i]);
+        out += " pad:";
+        out += quote(bindings.pad[i]);
+        out += ' ';
+    }
+    return out;
+}
+
+bool same_bindings(const NdsInputBindings& left,
+                   const NdsInputBindings& right) {
+    for (int i = 0; i < kNdsPadButtonCount; ++i) {
+        if (left.key[i] != right.key[i]) return false;
+        if (left.pad[i] != right.pad[i]) return false;
+    }
+    return true;
+}
+
+// Splits rendered contents into lines, ignoring the final newline's empty tail.
+std::vector<std::string> lines_of(const std::string& text) {
+    std::vector<std::string> lines;
+    std::string current;
+    for (const char ch : text) {
+        if (ch == '\n') {
+            lines.push_back(current);
+            current.clear();
+        } else {
+            current.push_back(ch);
+        }
+    }
+    if (!current.empty()) lines.push_back(current);
+    return lines;
+}
+
+// Raw bytes, so a fixture is not normalised by the CRT's text mode.
+std::string read_file(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return std::string();
+    return std::string((std::istreambuf_iterator<char>(in)),
+                       std::istreambuf_iterator<char>());
+}
+
+bool write_file(const std::filesystem::path& path, const std::string& text) {
+    std::error_code error;
+    if (!path.parent_path().empty()) {
+        std::filesystem::create_directories(path.parent_path(), error);
+    }
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.close();
+    return out.good();
+}
+
+bool contains_line(const std::vector<std::string>& lines,
+                   const std::string& wanted) {
+    for (const std::string& line : lines)
+        if (line == wanted) return true;
+    return false;
+}
+
+int index_of_line(const std::vector<std::string>& lines,
+                  const std::string& wanted) {
+    for (std::size_t i = 0; i < lines.size(); ++i)
+        if (lines[i] == wanted) return static_cast<int>(i);
+    return -1;
+}
+
+}  // namespace
+
+// Compile-time pins: the bit layout is the guest key mask, so a reordering
+// here would silently swap the buttons the emulator presses.
+static_assert(static_cast<int>(NdsPadButton::A) == 0, "A is bit 0");
+static_assert(static_cast<int>(NdsPadButton::B) == 1, "B is bit 1");
+static_assert(static_cast<int>(NdsPadButton::Select) == 2, "Select is bit 2");
+static_assert(static_cast<int>(NdsPadButton::Start) == 3, "Start is bit 3");
+static_assert(static_cast<int>(NdsPadButton::Right) == 4, "Right is bit 4");
+static_assert(static_cast<int>(NdsPadButton::Left) == 5, "Left is bit 5");
+static_assert(static_cast<int>(NdsPadButton::Up) == 6, "Up is bit 6");
+static_assert(static_cast<int>(NdsPadButton::Down) == 7, "Down is bit 7");
+static_assert(static_cast<int>(NdsPadButton::R) == 8, "R is bit 8");
+static_assert(static_cast<int>(NdsPadButton::L) == 9, "L is bit 9");
+static_assert(static_cast<int>(NdsPadButton::X) == 10, "X is bit 10");
+static_assert(static_cast<int>(NdsPadButton::Y) == 11, "Y is bit 11");
+static_assert(static_cast<int>(NdsPadButton::Count) == 12, "twelve buttons");
+static_assert(kNdsPadButtonCount == 12, "the mask is twelve bits wide");
+
+namespace {
+
+int run_checks(const std::filesystem::path& root) {
+    namespace fs = std::filesystem;
+
+    const fs::path missing = root / "absent" / "settings.txt";
+    const fs::path round = root / "round" / "settings.txt";
+    const fs::path fresh = root / "fresh" / "settings.txt";
+    const fs::path mixed = root / "mixed" / "settings.txt";
+    const fs::path damaged = root / "damaged" / "settings.txt";
+    const fs::path duplicates = root / "duplicates" / "settings.txt";
+    const fs::path rejected = root / "rejected" / "settings.txt";
+
+    // ---- 1. The shipped default table. -------------------------------
+    {
+        const NdsInputBindings defaults = nds_input_bindings_defaults();
+        const char* const want_key[kNdsPadButtonCount] = {
+            "Z", "X", "Backspace", "Return", "Right", "Left",
+            "Up", "Down", "W", "Q", "S", "A",
+        };
+        const char* const want_pad[kNdsPadButtonCount] = {
+            "a", "b", "back", "start", "dpright", "dpleft",
+            "dpup", "dpdown", "rightshoulder", "leftshoulder",
+            "x", "y",
+        };
+        bool keys_ok = true;
+        bool pads_ok = true;
+        for (int i = 0; i < kNdsPadButtonCount; ++i) {
+            if (defaults.key[i] != want_key[i]) keys_ok = false;
+            if (defaults.pad[i] != want_pad[i]) pads_ok = false;
+        }
+        if (!require(keys_ok))
+            return fail("the default key table is the shipped map",
+                        describe(defaults));
+        ok("the default key table is the shipped map");
+
+        if (!require(pads_ok))
+            return fail("the default pad table is position-based",
+                        describe(defaults));
+        ok("the default pad table is position-based");
+    }
+
+    {
+        // SDL3's SDL_GetGamepadStringForButton is the authority here: it prints
+        // "a","b","x","y","back","guide","start","leftstick","rightstick",
+        // "leftshoulder","rightshoulder","dpup","dpdown","dpleft","dpright",...
+        // and SDL_GetGamepadButtonFromString parses no underscore form at all.
+        // A default spelled the SDL2-ish way ("dpad_up", "left_shoulder")
+        // therefore resolves to SDL_GAMEPAD_BUTTON_INVALID and binds nothing,
+        // silently, so this check is the one that catches a dead default pad.
+        const NdsInputBindings defaults = nds_input_bindings_defaults();
+        bool underscores = false;
+        for (int i = 0; i < kNdsPadButtonCount; ++i)
+            if (defaults.pad[i].find('_') != std::string::npos)
+                underscores = true;
+        if (!require(!underscores))
+            return fail("no default pad name uses SDL3's underscore form",
+                        describe(defaults));
+        ok("no default pad name uses SDL3's underscore form");
+    }
+
+    {
+        const NdsInputBindings empty{};
+        bool all_empty = true;
+        for (int i = 0; i < kNdsPadButtonCount; ++i) {
+            if (!empty.key[i].empty()) all_empty = false;
+            if (!empty.pad[i].empty()) all_empty = false;
+        }
+        if (!require(all_empty))
+            return fail("a fresh NdsInputBindings is entirely unbound",
+                        describe(empty));
+        ok("a fresh NdsInputBindings is entirely unbound");
+    }
+
+    // ---- 2. Button identifiers round trip. ---------------------------
+    {
+        const char* const want[kNdsPadButtonCount] = {
+            "a", "b", "select", "start", "right", "left",
+            "up", "down", "r", "l", "x", "y",
+        };
+        bool stable = true;
+        bool round_trips = true;
+        for (int i = 0; i < kNdsPadButtonCount; ++i) {
+            const auto button = static_cast<NdsPadButton>(i);
+            const std::string name = nds_pad_button_name(button);
+            if (name != want[i]) stable = false;
+            if (nds_pad_button_from_name(name.c_str()) != i)
+                round_trips = false;
+        }
+        if (!require(stable))
+            return fail("every button has its stable settings name",
+                        nds_pad_button_name(NdsPadButton::A));
+        ok("every button has its stable settings name");
+
+        if (!require(round_trips))
+            return fail("name and from_name round trip all twelve",
+                        "a table row did not parse back to its index");
+        ok("name and from_name round trip all twelve");
+    }
+
+    if (!require(nds_pad_button_from_name("") == -1))
+        return fail("from_name() rejects the empty name", "\"\"");
+    ok("from_name() rejects the empty name");
+
+    if (!require(nds_pad_button_from_name("A") == -1))
+        return fail("from_name() is case-sensitive, so 'A' is unknown", "A");
+    ok("from_name() is case-sensitive, so 'A' is unknown");
+
+    if (!require(nds_pad_button_from_name("Z") == -1))
+        return fail("from_name() rejects a keyboard scancode name", "Z");
+    ok("from_name() rejects a keyboard scancode name");
+
+    if (!require(nds_pad_button_from_name("dpup") == -1))
+        return fail("from_name() rejects an SDL pad button name", "dpup");
+    ok("from_name() rejects an SDL pad button name");
+
+    if (!require(nds_pad_button_from_name(nullptr) == -1))
+        return fail("from_name() survives a null pointer", "nullptr");
+    ok("from_name() survives a null pointer");
+
+    if (!require(std::string(nds_pad_button_name(
+                     static_cast<NdsPadButton>(kNdsPadButtonCount)))
+                     .empty()))
+        return fail("name() of the Count sentinel is empty, not garbage",
+                    quote(nds_pad_button_name(
+                        static_cast<NdsPadButton>(kNdsPadButtonCount))));
+    ok("name() of the Count sentinel is empty, not garbage");
+
+    // ---- 3. Plausible-name validation. -------------------------------
+    if (!require(!nds_input_bindings_name_is_valid("", false)))
+        return fail("an empty name is not valid", "\"\"");
+    ok("an empty name is not valid");
+
+    if (!require(!nds_input_bindings_name_is_valid(std::string(32u, 'a'),
+                                                   false)))
+        return fail("a 32-character name is not valid",
+                    quote(std::string(32u, 'a')));
+    ok("a 32-character name is not valid");
+
+    if (!require(nds_input_bindings_name_is_valid(std::string(31u, 'a'),
+                                                  false)))
+        return fail("a 31-character name is valid",
+                    quote(std::string(31u, 'a')));
+    ok("a 31-character name is valid");
+
+    if (!require(!nds_input_bindings_name_is_valid("Bad=Name", false)))
+        return fail("a value containing '=' is not valid", "Bad=Name");
+    ok("a value containing '=' is not valid");
+
+    if (!require(!nds_input_bindings_name_is_valid("Z\n", false)))
+        return fail("a value containing a newline is not valid", "\"Z\\n\"");
+    ok("a value containing a newline is not valid");
+
+    if (!require(!nds_input_bindings_name_is_valid("a\rb", false)))
+        return fail("a value containing a carriage return is not valid",
+                    "\"a\\rb\"");
+    ok("a value containing a carriage return is not valid");
+
+    if (!require(!nds_input_bindings_name_is_valid("   ", false)))
+        return fail("a spaces-only value is not valid", "\"   \"");
+    ok("a spaces-only value is not valid");
+
+    if (!require(!nds_input_bindings_name_is_valid("123", false)))
+        return fail("a letters-free token is not valid", "123");
+    ok("a letters-free token is not valid");
+
+    {
+        const bool accepts =
+            nds_input_bindings_name_is_valid("Z", false) &&
+            nds_input_bindings_name_is_valid("Backspace", false) &&
+            nds_input_bindings_name_is_valid("dpup", true) &&
+            nds_input_bindings_name_is_valid("leftshoulder", true);
+        if (!require(accepts))
+            return fail("the real SDL names the module emits are valid",
+                        "Z/Backspace/dpup/leftshoulder");
+        ok("the real SDL names the module emits are valid");
+    }
+
+    // ---- 4. Menu labels. ---------------------------------------------
+    if (!require(std::string(nds_input_bindings_label("", false)) ==
+                 "unbound"))
+        return fail("an empty binding labels as unbound",
+                    quote(nds_input_bindings_label("", false)));
+    ok("an empty binding labels as unbound");
+
+    if (!require(std::string(nds_input_bindings_label("", true)) ==
+                 "unbound"))
+        return fail("an empty pad binding labels as unbound",
+                    quote(nds_input_bindings_label("", true)));
+    ok("an empty pad binding labels as unbound");
+
+    if (!require(std::string(nds_input_bindings_label("Backspace", false)) ==
+                 "Backspace"))
+        return fail("a key labels as its own name",
+                    quote(nds_input_bindings_label("Backspace", false)));
+    ok("a key labels as its own name");
+
+    if (!require(std::string(nds_input_bindings_label("dpup", true)) ==
+                 "Pad dpup"))
+        return fail("a pad button labels as \"Pad \" + name",
+                    quote(nds_input_bindings_label("dpup", true)));
+    ok("a pad button labels as \"Pad \" + name");
+
+    {
+        // A settings page collects every row's label and draws them after, so
+        // two pad labels taken in a row must both still be right at the end: a
+        // single reused buffer would leave both rows showing the newest name.
+        const std::string first_name = "a";
+        const std::string second_name = "leftshoulder";
+        const char* first = nds_input_bindings_label(first_name, true);
+        const char* second = nds_input_bindings_label(second_name, true);
+        if (!require(first != nullptr && second != nullptr))
+            return fail("a pad label is never null", "nullptr");
+        ok("a pad label is never null");
+
+        if (!require(first != second))
+            return fail("two pad labels do not alias one buffer",
+                        quote(first) + " then " + quote(second));
+        ok("two pad labels do not alias one buffer");
+
+        if (!require(std::string(first) == "Pad a" &&
+                     std::string(second) == "Pad leftshoulder"))
+            return fail("two pad labels held at once stay distinct",
+                        quote(first) + " then " + quote(second));
+        ok("two pad labels held at once stay distinct");
+    }
+
+    // ---- 5. Reverse lookup, which is what a live remap asks. ---------
+    {
+        const NdsInputBindings defaults = nds_input_bindings_defaults();
+        if (!require(nds_input_bindings_button_for_key(defaults, "Z") == 0))
+            return fail("button_for_key() finds Z at bit 0",
+                        std::to_string(
+                            nds_input_bindings_button_for_key(defaults, "Z")));
+        ok("button_for_key() finds Z at bit 0");
+
+        if (!require(nds_input_bindings_button_for_key(defaults, "z") == 0))
+            return fail("button_for_key() is case-insensitive",
+                        std::to_string(
+                            nds_input_bindings_button_for_key(defaults, "z")));
+        ok("button_for_key() is case-insensitive");
+
+        if (!require(nds_input_bindings_button_for_key(defaults, "  Z  ") ==
+                     0))
+            return fail("button_for_key() trims surrounding spaces",
+                        std::to_string(nds_input_bindings_button_for_key(
+                            defaults, "  Z  ")));
+        ok("button_for_key() trims surrounding spaces");
+
+        if (!require(nds_input_bindings_button_for_key(defaults, "") == -1))
+            return fail("button_for_key() rejects an empty name", "\"\"");
+        ok("button_for_key() rejects an empty name");
+
+        if (!require(nds_input_bindings_button_for_key(defaults, "Nope") ==
+                     -1))
+            return fail("button_for_key() returns -1 for an unknown name",
+                        "Nope");
+        ok("button_for_key() returns -1 for an unknown name");
+
+        if (!require(nds_input_bindings_button_for_pad(defaults, "DPUP") == 6))
+            return fail("button_for_pad() is case-insensitive",
+                        std::to_string(nds_input_bindings_button_for_pad(
+                            defaults, "DPUP")));
+        ok("button_for_pad() is case-insensitive");
+
+        if (!require(nds_input_bindings_button_for_pad(defaults, " dpup ") ==
+                     6))
+            return fail("button_for_pad() trims surrounding spaces",
+                        std::to_string(nds_input_bindings_button_for_pad(
+                            defaults, " dpup ")));
+        ok("button_for_pad() trims surrounding spaces");
+
+        if (!require(nds_input_bindings_button_for_pad(defaults, "") == -1))
+            return fail("button_for_pad() rejects an empty name", "\"\"");
+        ok("button_for_pad() rejects an empty name");
+
+        // The two devices are searched separately: a keyboard binding must
+        // never answer a pad event (their names overlap on "a"/"A" and "b").
+        if (!require(nds_input_bindings_button_for_pad(defaults, "Z") == -1))
+            return fail("button_for_pad() does not match a key binding", "Z");
+        ok("button_for_pad() does not match a key binding");
+
+        if (!require(nds_input_bindings_button_for_key(defaults, "dpup") ==
+                     -1))
+            return fail("button_for_key() does not match a pad binding",
+                        "dpup");
+        ok("button_for_key() does not match a pad binding");
+    }
+
+    {
+        // A remap can leave two buttons on one name; the lowest index wins
+        // because that is the first row the settings page offers.
+        NdsInputBindings shared{};
+        shared.key[3] = "Q";
+        shared.key[7] = "Q";
+        shared.pad[2] = "b";
+        shared.pad[9] = "b";
+        if (!require(nds_input_bindings_button_for_key(shared, "q") == 3))
+            return fail("a duplicate key binding resolves to the lowest index",
+                        std::to_string(
+                            nds_input_bindings_button_for_key(shared, "q")));
+        ok("a duplicate key binding resolves to the lowest index");
+
+        if (!require(nds_input_bindings_button_for_pad(shared, "B") == 2))
+            return fail("a duplicate pad binding resolves to the lowest index",
+                        std::to_string(
+                            nds_input_bindings_button_for_pad(shared, "B")));
+        ok("a duplicate pad binding resolves to the lowest index");
+    }
+
+    // ---- 6. A missing file keeps the caller's table. -----------------
+    {
+        const NdsInputBindings defaults = nds_input_bindings_defaults();
+        NdsInputBindings untouched = defaults;
+        untouched.key[0] = "K";
+        untouched.pad[11] = "";
+        const NdsInputBindings before = untouched;
+        if (!require(!nds_input_bindings_load(missing.string(), &untouched)))
+            return fail("load() of a missing file returns false",
+                        quote(missing.string()));
+        ok("load() of a missing file returns false");
+
+        if (!require(same_bindings(untouched, before)))
+            return fail("a failed load leaves the struct byte-identical",
+                        describe(untouched));
+        ok("a failed load leaves the struct byte-identical");
+    }
+
+    if (!require(!nds_input_bindings_load(missing.string(), nullptr)))
+        return fail("load() with a null output is false, not a crash",
+                    "nullptr");
+    ok("load() with a null output is false, not a crash");
+
+    // ---- 7. Round trip, including an unbound row. --------------------
+    {
+        NdsInputBindings written = nds_input_bindings_defaults();
+        written.key[0] = "Space";        // a multi-character scancode name
+        written.key[1] = "";             // deliberately unbound
+        written.pad[0] = "";
+        written.pad[1] = "leftshoulder";  // not the default ("b") for that row
+        if (!require(nds_input_bindings_store(round.string(), written)))
+            return fail("store() writes a full table", quote(round.string()));
+        ok("store() writes a full table");
+
+        NdsInputBindings loaded{};
+        if (!require(nds_input_bindings_load(round.string(), &loaded)))
+            return fail("the stored table loads back",
+                        quote(read_file(round)));
+        ok("the stored table loads back");
+
+        if (!require(same_bindings(loaded, written)))
+            return fail("every button/key/device value round trips",
+                        describe(loaded));
+        ok("every button/key/device value round trips");
+
+        if (!require(loaded.key[1].empty()))
+            return fail("an unbound key stays unbound, not the default",
+                        quote(loaded.key[1]));
+        ok("an unbound key stays unbound, not the default");
+
+        if (!require(loaded.pad[0].empty()))
+            return fail("an unbound pad stays unbound, not the default",
+                        quote(loaded.pad[0]));
+        ok("an unbound pad stays unbound, not the default");
+
+        const std::vector<std::string> lines = lines_of(read_file(round));
+        if (!require(contains_line(lines, "controls.key.b=")))
+            return fail("an unbound row persists as an empty value",
+                        show(lines));
+        ok("an unbound row persists as an empty value");
+    }
+
+    // ---- 8. A fresh file gains only the version and the rows. --------
+    {
+        NdsInputBindings defaults = nds_input_bindings_defaults();
+        if (!require(nds_input_bindings_store(fresh.string(), defaults)))
+            return fail("store() creates a missing file and its directory",
+                        quote(fresh.string()));
+        ok("store() creates a missing file and its directory");
+
+        const std::vector<std::string> lines = lines_of(read_file(fresh));
+        if (!require(!lines.empty() &&
+                     lines.front() == "settings_version=12"))
+            return fail("a fresh file gets settings_version first",
+                        show(lines));
+        ok("a fresh file gets settings_version first");
+
+        if (!require(lines.size() == 1u + 2u * kNdsPadButtonCount))
+            return fail("a fresh file holds the version plus 24 rows",
+                        "line count " + std::to_string(lines.size()));
+        ok("a fresh file holds the version plus 24 rows");
+    }
+
+    // ---- 9. Foreign lines, comments and order survive. ---------------
+    {
+        const std::string foreign = "# hand-edited, keep me\n"
+                                    "\n"
+                                    "launcher.theme=dark\n"
+                                    "controls.key.a=Space\n"
+                                    "audio.volume=37\n";
+        NdsInputBindings written = nds_input_bindings_defaults();
+        if (!require(write_file(mixed, foreign) &&
+                     nds_input_bindings_store(mixed.string(), written)))
+            return fail("store() over a hand-edited file succeeds",
+                        quote(read_file(mixed)));
+        ok("store() over a hand-edited file succeeds");
+
+        const std::vector<std::string> lines = lines_of(read_file(mixed));
+        if (!require(contains_line(lines, "# hand-edited, keep me")))
+            return fail("a comment survives a store", show(lines));
+        ok("a comment survives a store");
+
+        if (!require(contains_line(lines, "launcher.theme=dark")))
+            return fail("a foreign key survives a store", show(lines));
+        ok("a foreign key survives a store");
+
+        if (!require(contains_line(lines, "audio.volume=37")))
+            return fail("another foreign key survives a store", show(lines));
+        ok("another foreign key survives a store");
+
+        if (!require(contains_line(lines, "")))
+            return fail("a blank line survives a store", show(lines));
+        ok("a blank line survives a store");
+
+        // The file already had controls.key.a=Space, so that row keeps its
+        // position while the rows the file never held are appended.
+        const int comment_at = index_of_line(lines, "# hand-edited, keep me");
+        const int foreign_at = index_of_line(lines, "launcher.theme=dark");
+        const int a_at = index_of_line(lines, "controls.key.a=Z");
+        if (!require(comment_at >= 0 && foreign_at > comment_at &&
+                     a_at > foreign_at))
+            return fail("existing lines keep their order",
+                        show(lines));
+        ok("existing lines keep their order");
+
+        if (!require(lines.front() == "settings_version=12"))
+            return fail("the version line is written before the rest",
+                        show(lines));
+        ok("the version line is written before the rest");
+
+        NdsInputBindings loaded{};
+        if (!require(nds_input_bindings_load(mixed.string(), &loaded) &&
+                     loaded.key[0] == "Z" && loaded.key[1] == "X"))
+            return fail("the rewritten rows load back over the old value",
+                        describe(loaded));
+        ok("the rewritten rows load back over the old value");
+    }
+
+    // ---- 10. A damaged file costs one row, not the table. ------------
+    {
+        const std::string text =
+            "controls.key.a=Bad=Name\n"     // '=' cannot be in a value
+            "controls.key.b=Two Words\n"    // a real spaced SDL name is fine
+            "controls.pad.a=b\n"            // not the default, so it shows
+            "controls.key.zzz=Q\n"          // no such button
+            "controls.pad.nope=a\n"         // no such button either
+            "controls.key.l=   \n";         // empty once trimmed
+        NdsInputBindings loaded;
+        if (!require(write_file(damaged, text) &&
+                     nds_input_bindings_load(damaged.string(), &loaded)))
+            return fail("a damaged file still loads",
+                        quote(read_file(damaged)));
+        ok("a damaged file still loads");
+
+        if (!require(loaded.key[0] == "Z"))
+            return fail("an implausible value keeps the default",
+                        quote(loaded.key[0]));
+        ok("an implausible value keeps the default");
+
+        if (!require(loaded.key[1] == "Two Words"))
+            return fail("a valid spaced name is accepted as written",
+                        quote(loaded.key[1]));
+        ok("a valid spaced name is accepted as written");
+
+        if (!require(loaded.pad[0] == "b"))
+            return fail("an explicit row overrides the default",
+                        quote(loaded.pad[0]));
+        ok("an explicit row overrides the default");
+
+        if (!require(loaded.key[9].empty()))
+            return fail("an empty value is unbound, not the default",
+                        quote(loaded.key[9]));
+        ok("an empty value is unbound, not the default");
+
+        // The unknown rows must not have disturbed the rest of the table.
+        if (!require(loaded.key[2] == "Backspace" && loaded.key[11] == "A" &&
+                     loaded.pad[11] == "y"))
+            return fail("the other eleven buttons keep their defaults",
+                        describe(loaded));
+        ok("the other eleven buttons keep their defaults");
+    }
+
+    // ---- 11. Duplicates keep the first, matching the settings file. ---
+    {
+        const std::string text = "controls.key.a=Space\n"
+                                 "controls.key.a=Q\n"
+                                 "controls.key.b=X\n";
+        NdsInputBindings loaded;
+        if (!require(write_file(duplicates, text) &&
+                     nds_input_bindings_load(duplicates.string(), &loaded)))
+            return fail("the duplicate fixture loads",
+                        quote(read_file(duplicates)));
+        ok("the duplicate fixture loads");
+
+        if (!require(loaded.key[0] == "Space"))
+            return fail("a duplicate row keeps its first value",
+                        quote(loaded.key[0]));
+        ok("a duplicate row keeps its first value");
+    }
+
+    // ---- 12. store() refuses to write a file it would corrupt. -------
+    {
+        const std::string original = "launcher.theme=dark\n";
+        NdsInputBindings bad = nds_input_bindings_defaults();
+        bad.key[5] = "B\nad";
+        if (!require(write_file(rejected, original) &&
+                     !nds_input_bindings_store(rejected.string(), bad)))
+            return fail("store() rejects a value that would inject a line",
+                        quote(bad.key[5]));
+        ok("store() rejects a value that would inject a line");
+
+        if (!require(read_file(rejected) == original))
+            return fail("a rejected store leaves the file untouched",
+                        quote(read_file(rejected)));
+        ok("a rejected store leaves the file untouched");
+
+        NdsInputBindings unbound = nds_input_bindings_defaults();
+        unbound.key[5] = "";
+        if (!require(nds_input_bindings_store(rejected.string(), unbound)))
+            return fail("store() accepts an empty (unbound) value",
+                        quote(rejected.string()));
+        ok("store() accepts an empty (unbound) value");
+    }
+
+    return 0;
+}
+
+// Creates <base>/<leaf> and reports whether it is a usable directory. Only the
+// non-throwing filesystem overloads are used, so a confined base reports a
+// reason instead of terminating the test binary.
+bool create_tree(const std::filesystem::path& base, const std::string& leaf,
+                 std::filesystem::path* root, std::string* reason) {
+    const std::filesystem::path candidate = base / leaf;
+    std::error_code error;
+    std::filesystem::remove_all(candidate, error);
+    error.clear();
+    std::filesystem::create_directories(candidate, error);
+    if (error) {
+        *reason = error.message();
+        return false;
+    }
+    std::error_code probe;
+    const bool present = std::filesystem::is_directory(candidate, probe);
+    if (probe || !present) {
+        *reason = probe ? probe.message() : "the path is not a directory";
+        return false;
+    }
+    *root = candidate;
+    reason->clear();
+    return true;
+}
+
+// Picks the scratch base for the temporary tree. The system temp directory is
+// used first, but a sandboxed run can refuse writes there because the process
+// working directory sits inside the tree under test, so the working directory
+// is tried second. Returns false only when neither location can hold the tree,
+// and then names both paths and both reasons.
+bool create_root(const std::string& name, const std::string& ticks,
+                 std::filesystem::path* root) {
+    const std::string leaf = name + "-" + ticks;
+    std::error_code temp_error;
+    const std::filesystem::path temp_base =
+        std::filesystem::temp_directory_path(temp_error);
+    const std::filesystem::path temp_path =
+        (temp_base.empty() ? std::filesystem::path("(system temp)")
+                           : temp_base) /
+        leaf;
+    std::string temp_reason = temp_error.message();
+    if (!temp_error && create_tree(temp_base, leaf, root, &temp_reason))
+        return true;
+
+    // The fallback gets its own name so a log line that names both candidate
+    // paths stays unambiguous even when TEMP and the working directory are
+    // the same place.
+    const std::string fallback_leaf = name + "-tmp-" + ticks;
+    std::error_code cwd_error;
+    const std::filesystem::path cwd_base =
+        std::filesystem::current_path(cwd_error);
+    const std::filesystem::path cwd_path =
+        (cwd_base.empty() ? std::filesystem::path("(working directory)")
+                          : cwd_base) /
+        fallback_leaf;
+    std::string cwd_reason = cwd_error.message();
+    if (!cwd_error &&
+        create_tree(cwd_base, fallback_leaf, root, &cwd_reason)) {
+        // error_code::message() ends in a full stop on Windows, which reads
+        // badly inside parentheses; the note is one line either way.
+        std::string note = temp_reason;
+        if (!note.empty() && note.back() == '.') note.pop_back();
+        std::fprintf(stderr,
+                     "note: cannot use '%s' (%s); using '%s' instead\n",
+                     temp_path.string().c_str(), note.c_str(),
+                     root->string().c_str());
+        return true;
+    }
+
+    std::fprintf(stderr, "FAIL temp tree\n");
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 temp_path.string().c_str(), temp_reason.c_str());
+    std::fprintf(stderr, "     cannot create '%s': %s\n",
+                 cwd_path.string().c_str(), cwd_reason.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    namespace fs = std::filesystem;
+    const auto stamp = std::chrono::steady_clock::now()
+                           .time_since_epoch().count();
+    fs::path root;
+    if (!create_root("nds-input-bindings-test", std::to_string(stamp), &root))
+        return 1;
+
+    // Checks live in run_checks() so the temporary tree is removed on every
+    // exit path, including a failing one.
+    const int result = run_checks(root);
+    if (result == 0) std::printf("%d checks passed\n", g_checks);
+    std::error_code cleanup_error;
+    fs::remove_all(root, cleanup_error);
+    return result;
+}
diff --git a/runner/tests/mod_packs_test.cpp b/runner/tests/mod_packs_test.cpp
new file mode 100644
index 0000000..96f2a1b
--- /dev/null
+++ b/runner/tests/mod_packs_test.cpp
@@ -0,0 +1,1952 @@
+// Pins the mod-pack reader (mod_packs.h).
+//
+// A pack is a directory a player unzips next to the game, so everything here
+// is about the ways that can go wrong without the game noticing:
+//
+//   * A broken manifest must be *reported*, not fatal: a load always returns a
+//     table, and every rejected pack/edit becomes a diagnostic carrying the
+//     manifest path and the line the player has to fix.
+//   * Paths in a manifest are hostile input by construction. A pack may not
+//     name a file outside its own directory -- not with "../", not with a drive
+//     letter, not through a directory link -- because the alternative is a
+//     downloaded mod that reads or overwrites arbitrary files.
+//   * Discovery has to be deterministic: "the first pack in name order wins" is
+//     a rule a player can reason about, so directory iteration order must never
+//     leak into the result.
+//   * Names are real player names: spaces and non-ASCII survive a round trip
+//     from the filesystem into the override table and back out as a host path.
+//
+// Each assertion has its own nonzero return code and prints OK/FAIL with a
+// one-line detail, so a failure names itself without a debugger.
+
+#include "mod_packs.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <set>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+int g_checks = 0;
+
+bool require(bool value) {
+    return value;
+}
+
+void ok(const char* name) {
+    ++g_checks;
+    std::printf("OK   %s\n", name);
+}
+
+// Prints the failing check plus its detail and yields that check's exit code,
+// which is the ordinal of the check so it points at the OK numbering.
+int fail(const char* name, const std::string& detail) {
+    std::fprintf(stderr, "FAIL %s\n     %s\n", name, detail.c_str());
+    return g_checks + 1;
+}
+
+// Escapes a string so a detail line stays one line.
+std::string quote(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\n') {
+            out += "\\n";
+        } else if (ch == '\r') {
+            out += "\\r";
+        } else if (ch == '\t') {
+            out += "\\t";
+        } else {
+            out.push_back(ch);
+        }
+    }
+    out += '"';
+    return out;
+}
+
+// ---- UTF-8 <-> path ------------------------------------------------------
+//
+// The module's interface is UTF-8 std::string in both directions, so the test
+// has to be the second implementation of that conversion: a pack inside a
+// directory called "モッド" is exactly the case a lossy conversion destroys.
+
+std::filesystem::path from_utf8(const std::string& text) {
+    return std::filesystem::path(std::u8string(text.begin(), text.end()));
+}
+
+std::string to_utf8(const std::filesystem::path& path) {
+    const std::u8string text = path.generic_u8string();
+    return std::string(text.begin(), text.end());
+}
+
+// ---- Fixtures ------------------------------------------------------------
+
+// Raw bytes, so a fixture is not normalised by the CRT's text mode.
+bool write_file(const std::filesystem::path& path, const std::string& text) {
+    std::error_code error;
+    if (!path.parent_path().empty())
+        std::filesystem::create_directories(path.parent_path(), error);
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out.write(text.data(), static_cast<std::streamsize>(text.size()));
+    out.close();
+    return out.good();
+}
+
+// Writes a manifest from lines, with a fixed newline spelling.
+bool write_manifest(const std::filesystem::path& path,
+                    const std::vector<std::string>& lines,
+                    const std::string& eol = "\n") {
+    std::string text;
+    for (const std::string& line : lines) {
+        text += line;
+        text += eol;
+    }
+    return write_file(path, text);
+}
+
+// 1-based line number of the first line holding `needle`, or 0. The expected
+// line for a diagnostic is derived from the fixture this way rather than being
+// hardcoded, so a test can still prove the parser reports the *right* line --
+// the path row rather than the table header, for instance.
+int line_of(const std::vector<std::string>& lines, const std::string& needle) {
+    for (std::size_t index = 0; index < lines.size(); ++index)
+        if (lines[index].find(needle) != std::string::npos)
+            return static_cast<int>(index) + 1;
+    return 0;
+}
+
+std::string manifest_text(const std::vector<std::string>& lines) {
+    std::string text;
+    for (const std::string& line : lines) {
+        text += line;
+        text += '\n';
+    }
+    return text;
+}
+
+// Escapes a value for embedding in a manifest string. The path cases include
+// raw backslashes, and a manifest string needs them doubled -- the parser must
+// see '\W', not a broken escape.
+std::string string_value(const std::string& text) {
+    std::string out = "\"";
+    for (const char ch : text) {
+        if (ch == '\\' || ch == '"') out.push_back('\\');
+        out.push_back(ch);
+    }
+    out += '"';
+    return out;
+}
+
+// ---- Diagnostics and results ---------------------------------------------
+
+int count_rule(const nds_mod_packs::NdsModPacksResult& result,
+               nds_mod_packs::NdsModPackRule rule) {
+    int total = 0;
+    for (const nds_mod_packs::NdsModPackDiagnostic& diagnostic :
+         result.diagnostics) {
+        if (diagnostic.rule == rule) ++total;
+    }
+    return total;
+}
+
+int count_severity(const nds_mod_packs::NdsModPacksResult& result,
+                   nds_mod_packs::NdsModPackSeverity severity) {
+    int total = 0;
+    for (const nds_mod_packs::NdsModPackDiagnostic& diagnostic :
+         result.diagnostics) {
+        if (diagnostic.severity == severity) ++total;
+    }
+    return total;
+}
+
+const nds_mod_packs::NdsModPackDiagnostic* first_rule(
+    const nds_mod_packs::NdsModPacksResult& result,
+    nds_mod_packs::NdsModPackRule rule) {
+    for (const nds_mod_packs::NdsModPackDiagnostic& diagnostic :
+         result.diagnostics) {
+        if (diagnostic.rule == rule) return &diagnostic;
+    }
+    return nullptr;
+}
+
+// Every diagnostic rendered, for a failure detail that says what *did* happen.
+std::string describe(const nds_mod_packs::NdsModPacksResult& result) {
+    std::string out = "[";
+    for (std::size_t index = 0; index < result.diagnostics.size(); ++index) {
+        if (index != 0u) out += " | ";
+        out += nds_mod_packs::nds_mod_pack_diagnostic_text(
+            result.diagnostics[index]);
+    }
+    out += "] files=" + std::to_string(result.files.size());
+    out += " music=" + std::to_string(result.music.size());
+    out += " packs=" + std::to_string(result.packs.size());
+    return out;
+}
+
+std::string describe_entries(
+    const std::vector<nds_mod_packs::NdsModPackOverride>& entries) {
+    std::string out = "[";
+    for (std::size_t index = 0; index < entries.size(); ++index) {
+        if (index != 0u) out += ", ";
+        out += std::to_string(entries[index].key);
+        out += "->" + entries[index].pack + ":" + entries[index].path;
+    }
+    out += ']';
+    return out;
+}
+
+// Strips the scratch root off a path so two trees built in different places
+// (and therefore in different creation order) compare equal.
+std::string shade(const std::string& text, const std::string& root) {
+    const std::string prefix = root + "/";
+    if (text.compare(0, prefix.size(), prefix) == 0)
+        return text.substr(prefix.size());
+    return text;
+}
+
+// One comparable rendering of everything a caller can observe. Determinism is
+// tested by comparing these, so it has to cover the ordering of every vector,
+// not just the values in them.
+std::string dump(const nds_mod_packs::NdsModPacksResult& result,
+                 const std::string& root) {
+    std::string out;
+    for (const nds_mod_packs::NdsModPackOverride& entry : result.files)
+        out += "file " + std::to_string(entry.key) + " " + entry.pack + " " +
+               shade(entry.path, root) + "\n";
+    for (const nds_mod_packs::NdsModPackOverride& entry : result.music)
+        out += "music " + std::to_string(entry.key) + " " + entry.pack + " " +
+               shade(entry.path, root) + "\n";
+    for (const nds_mod_packs::NdsModPackInfo& pack : result.packs) {
+        out += "pack " + pack.directory + " " + pack.name + " " + pack.id +
+               " " + pack.version + " " + pack.description + " " +
+               (pack.enabled ? "on" : "off") + "\n";
+    }
+    for (const nds_mod_packs::NdsModPackDiagnostic& diagnostic :
+         result.diagnostics) {
+        out += "diag " +
+               std::string(nds_mod_packs::nds_mod_pack_severity_name(
+                   diagnostic.severity)) +
+               " " +
+               std::string(
+                   nds_mod_packs::nds_mod_pack_rule_name(diagnostic.rule)) +
+               " " + diagnostic.pack + " " + shade(diagnostic.file, root) +
+               " " + std::to_string(diagnostic.line) + " " +
+               diagnostic.detail + "\n";
+    }
+    out += "summary " + std::to_string(result.summary.packs) + " " +
+           std::to_string(result.summary.enabled_packs) + " " +
+           std::to_string(result.summary.file_overrides) + " " +
+           std::to_string(result.summary.music_overrides) + " " +
+           std::to_string(result.summary.warnings) + " " +
+           std::to_string(result.summary.errors) + "\n";
+    return out;
+}
+
+// ---- Scratch tree --------------------------------------------------------
+
+std::filesystem::path make_pack(const std::filesystem::path& mods,
+                                const std::string& name) {
+    const std::filesystem::path directory = mods / from_utf8(name);
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    return directory;
+}
+
+// A directory that reports its own creation failure, so a fixture problem is
+// never mistaken for a module bug.
+bool make_mods_dir(const std::filesystem::path& root, const std::string& name,
+                   std::filesystem::path* out) {
+    const std::filesystem::path directory = root / name / "mods";
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    if (error) {
+        std::fprintf(stderr, "     cannot create '%s': %s\n",
+                     to_utf8(directory).c_str(), error.message().c_str());
+        return false;
+    }
+    *out = directory;
+    return true;
+}
+
+// A load whose input is the UTF-8 spelling a real caller passes.
+nds_mod_packs::NdsModPacksResult load_utf8(
+    const std::filesystem::path& mods_directory) {
+    return nds_mod_packs::nds_mod_packs_load(to_utf8(mods_directory));
+}
+
+// ---- Directory links -----------------------------------------------------
+//
+// The only way a relative path can leave its pack without containing ".." is a
+// link, so the containment rule cannot be exercised without creating one.
+// std::filesystem refuses on Windows without Developer Mode; a junction does
+// not need that privilege but only the shell command can make one.
+
+bool create_directory_link(const std::filesystem::path& link,
+                           const std::filesystem::path& target) {
+    std::error_code error;
+    std::filesystem::create_directory_symlink(target, link, error);
+    if (!error) return true;
+    std::error_code ignored;
+    std::filesystem::remove(link, ignored);
+    const std::string command = "cmd /c mklink /J \"" + link.string() +
+                                "\" \"" + target.string() + "\" >nul 2>&1";
+    return std::system(command.c_str()) == 0;
+}
+
+bool path_is_link(const std::filesystem::path& path) {
+    std::error_code error;
+    return std::filesystem::is_symlink(path, error) ||
+           std::filesystem::is_directory(path, error);
+}
+
+}  // namespace
+
+namespace {
+
+int run_checks(const std::filesystem::path& root) {
+    namespace fs = std::filesystem;
+    using nds_mod_packs::NdsModPackRule;
+    using nds_mod_packs::NdsModPackSeverity;
+    using nds_mod_packs::NdsModPacksResult;
+
+    const std::string root_text = to_utf8(root);
+
+    // ---- 1. The default directory beside the executable. --------------
+    {
+        // Pure string work: the value is decided before anything is on disk, so
+        // it has to be right for a path that does not exist yet.
+        const struct {
+            const char* input;
+            const char* expected;
+            const char* name;
+        } cases[] = {
+            {"C:\\games\\nds\\runner.exe", "C:/games/nds/mods",
+             "a Windows executable path yields 'mods' beside it"},
+            {"/usr/local/bin/runner", "/usr/local/bin/mods",
+             "a POSIX executable path keeps its separator"},
+            {"C:/games/runner.exe", "C:/games/mods",
+             "a forward-slash Windows path keeps its separator"},
+            {"runner.exe", "mods",
+             "a bare executable name yields a plain relative 'mods'"},
+            {"", "mods", "an empty executable path yields 'mods'"},
+            {"C:\\games\\nds\\", "C:/games/nds/mods",
+             "a trailing separator does not produce a doubled one"},
+        };
+        for (const auto& probe : cases) {
+            const std::string got =
+                nds_mod_packs::nds_mod_packs_default_directory(probe.input);
+            if (!require(got == probe.expected))
+                return fail(probe.name,
+                            quote(probe.input) + " -> " + quote(got) +
+                                ", expected " + quote(probe.expected));
+            ok(probe.name);
+        }
+    }
+
+    // ---- 2. No mods directory at all. ---------------------------------
+    {
+        // The ordinary install. It must be a warning, not an error, and an
+        // absent directory must not be distinguishable from "no packs" by
+        // anything except that warning.
+        const std::string missing =
+            to_utf8(root / "case-missing" / "mods");
+        const NdsModPacksResult result =
+            nds_mod_packs::nds_mod_packs_load(missing);
+
+        if (!require(result.files.empty() && result.music.empty()))
+            return fail("a missing mods directory yields no overrides",
+                        describe(result));
+        ok("a missing mods directory yields no overrides");
+
+        if (!require(result.packs.empty()))
+            return fail("a missing mods directory yields no pack entries",
+                        describe(result));
+        ok("a missing mods directory yields no pack entries");
+
+        if (!require(result.summary.packs == 0 &&
+                     result.summary.enabled_packs == 0 &&
+                     result.summary.file_overrides == 0 &&
+                     result.summary.music_overrides == 0 &&
+                     result.summary.errors == 0))
+            return fail("a missing mods directory leaves the summary at zero",
+                        describe(result));
+        ok("a missing mods directory leaves the summary at zero");
+
+        const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+            first_rule(result, NdsModPackRule::MissingModsDirectory);
+        if (!require(diagnostic != nullptr))
+            return fail("a missing mods directory is reported",
+                        describe(result));
+        ok("a missing mods directory is reported");
+
+        if (!require(diagnostic->severity == NdsModPackSeverity::Warning))
+            return fail("a missing mods directory is only a warning",
+                        describe(result));
+        ok("a missing mods directory is only a warning");
+
+        // Nothing about a missing directory belongs to a manifest or a line.
+        if (!require(diagnostic->file.empty() && diagnostic->line == 0 &&
+                     diagnostic->pack.empty()))
+            return fail("a missing mods directory names no manifest",
+                        nds_mod_packs::nds_mod_pack_diagnostic_text(
+                            *diagnostic));
+        ok("a missing mods directory names no manifest");
+
+        if (!require(result.summary.warnings == 1))
+            return fail("a missing mods directory is exactly one warning",
+                        std::to_string(result.summary.warnings));
+        ok("a missing mods directory is exactly one warning");
+    }
+
+    // ---- 3. `mods` exists but is not a directory. ---------------------
+    {
+        const fs::path base = root / "case-not-a-dir";
+        std::error_code error;
+        fs::create_directories(base, error);
+        if (!write_file(base / "mods", "not a directory\n"))
+            return fail("the fixture wrote a 'mods' file", "write failed");
+
+        const NdsModPacksResult result =
+            load_utf8(base / "mods");
+        if (!require(count_rule(result, NdsModPackRule::DirectoryUnreadable) ==
+                     1))
+            return fail("a 'mods' file is an unreadable directory",
+                        describe(result));
+        ok("a 'mods' file is an unreadable directory");
+
+        if (!require(result.summary.errors == 1 &&
+                     result.summary.warnings == 0))
+            return fail("a 'mods' file is an error, not a warning",
+                        describe(result));
+        ok("a 'mods' file is an error, not a warning");
+    }
+
+    // ---- 4. An empty mods directory and a stray readme. ---------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-empty", &mods))
+            return fail("the fixture made an empty mods directory",
+                        "create failed");
+        if (!write_file(mods / "README.txt", "put packs here\n"))
+            return fail("the fixture wrote a readme", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        // A plain file in `mods` is a readme, not a pack: reporting it would
+        // train players to ignore the diagnostics.
+        if (!require(result.diagnostics.empty()))
+            return fail("a file in the mods directory is ignored",
+                        describe(result));
+        ok("a file in the mods directory is ignored");
+
+        if (!require(result.summary.packs == 0 && result.packs.empty()))
+            return fail("a file in the mods directory is not a pack",
+                        describe(result));
+        ok("a file in the mods directory is not a pack");
+    }
+
+    // ---- 5. One well-formed pack. -------------------------------------
+    const std::vector<std::string> good_manifest = {
+        "# A pack that does everything right.",
+        "",
+        "[pack]",
+        "name = \"Better Font\"",
+        "id = \"better-font\"",
+        "version = \"1.2\"",
+        "description = \"Readable text\"   # a comment after a value",
+        "",
+        "[[file]]",
+        "id = 7",
+        "path = \"data/font.ntf\"",
+        "",
+        "[[file]]",
+        "id = 4660",
+        "path = \"data/\"  # a directory, not a file: must be refused",
+        "",
+        "[[music]]",
+        "track = 12",
+        "path = \"music/theme_12.bin\"",
+    };
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-good", &mods))
+            return fail("the fixture made the good pack tree",
+                        "create failed");
+        const fs::path pack = make_pack(mods, "Better Font");
+        if (!write_file(pack / "data" / "font.ntf", "font bytes\n") ||
+            !write_file(pack / "music" / "theme_12.bin", "music bytes\n") ||
+            !write_manifest(pack / "mod.toml", good_manifest))
+            return fail("the fixture wrote the good pack", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+
+        if (!require(result.summary.packs == 1 &&
+                     result.summary.enabled_packs == 1))
+            return fail("a well-formed pack is counted and enabled",
+                        describe(result));
+        ok("a well-formed pack is counted and enabled");
+
+        if (!require(result.files.size() == 1 && result.music.size() == 1))
+            return fail("the [[file]] and [[music]] entries are both kept",
+                        describe(result));
+        ok("the [[file]] and [[music]] entries are both kept");
+
+        if (!require(result.files[0].key == 7))
+            return fail("the file override keeps its content id",
+                        describe_entries(result.files));
+        ok("the file override keeps its content id");
+
+        if (!require(result.files[0].pack == "Better Font"))
+            return fail("the file override names its pack directory",
+                        describe_entries(result.files));
+        ok("the file override names its pack directory");
+
+        // The reported path is the host path a caller opens, so it is absolute,
+        // forward-slashed and complete -- not the manifest's relative spelling.
+        const std::string want_file = to_utf8(pack / "data" / "font.ntf");
+        if (!require(result.files[0].path == want_file))
+            return fail("the file override names the absolute host path",
+                        quote(result.files[0].path) + " != " +
+                            quote(want_file));
+        ok("the file override names the absolute host path");
+
+        if (!require(result.music[0].key == 12 &&
+                     result.music[0].path ==
+                         to_utf8(pack / "music" / "theme_12.bin")))
+            return fail("the music override keeps its track and path",
+                        describe_entries(result.music));
+        ok("the music override keeps its track and path");
+
+        if (!require(result.summary.file_overrides == 1 &&
+                     result.summary.music_overrides == 1))
+            return fail("the summary counts both override tables",
+                        describe(result));
+        ok("the summary counts both override tables");
+
+        // The [[file]] pointing at a directory is refused, and that is the only
+        // diagnostic in this tree.
+        if (!require(result.summary.errors == 1 &&
+                     count_rule(result, NdsModPackRule::PathNotAFile) == 1))
+            return fail("an entry pointing at a directory is refused",
+                        describe(result));
+        ok("an entry pointing at a directory is refused");
+
+        const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+            first_rule(result, NdsModPackRule::PathNotAFile);
+        const int want_line = line_of(good_manifest, "path = \"data/\"");
+        if (!require(diagnostic->line == want_line))
+            return fail("a path diagnostic names the path row's line",
+                        std::to_string(diagnostic->line) + " != " +
+                            std::to_string(want_line));
+        ok("a path diagnostic names the path row's line");
+
+        if (!require(diagnostic->file == to_utf8(pack / "mod.toml")))
+            return fail("a path diagnostic names the manifest",
+                        quote(diagnostic->file));
+        ok("a path diagnostic names the manifest");
+
+        if (!require(!result.packs.empty() && result.packs[0].enabled &&
+                     result.packs[0].name == "Better Font" &&
