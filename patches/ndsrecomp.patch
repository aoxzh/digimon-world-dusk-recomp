+    }
+
+    {
+        // The id is the identity a progress file refers to, so its shape is
+        // pinned: kebab-case lowercase, no leading digit, one separator.
+        const char* const shapes[] = {
+            "{\"achievements\": [{\"id\": \"First Save\", \"name\": \"x\","
+            " \"counter\": \"c\", \"target\": 1}]}",
+            "{\"achievements\": [{\"id\": \"1up\", \"name\": \"x\","
+            " \"counter\": \"c\", \"target\": 1}]}",
+            "{\"achievements\": [{\"id\": \"first--save\", \"name\": \"x\","
