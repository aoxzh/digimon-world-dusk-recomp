+    }
+
+    // ---- 8. Every syntax error names its file and line. ---------------
+    {
+        struct Case {
+            const char* name;
+            std::vector<std::string> lines;
+            NdsModPackRule rule;
+            const char* needle;  // the line the diagnostic has to point at
+        };
+        // A typo must never load and quietly do nothing, so each of these is
+        // checked for the rule it reports *and* the line it names.
+        const std::vector<Case> cases = {
+            {"an unknown table is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "", "[[files]]",
+              "id = 1"},
+             NdsModPackRule::UnknownSection, "[[files]]"},
+            {"a misspelled key is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "naem = \"typo\""},
+             NdsModPackRule::UnknownKey, "naem"},
+            {"a hexadecimal id is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "", "[[file]]",
+              "id = 0x10", "path = \"a.bin\""},
+             NdsModPackRule::BadInteger, "id = 0x10"},
+            {"a negative id is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "", "[[file]]",
+              "id = -1", "path = \"a.bin\""},
+             NdsModPackRule::BadInteger, "id = -1"},
+            {"an unclosed string is refused",
+             {"[pack]", "name = \"x", "id = \"x\""},
+             NdsModPackRule::BadString, "name = \"x"},
+            {"an unknown escape is refused",
+             {"[pack]", "name = \"x\\q\"", "id = \"x\""},
+             NdsModPackRule::BadString, "name = \"x\\q\""},
+            {"a missing '=' is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "stray"},
+             NdsModPackRule::ManifestSyntax, "stray"},
+            {"a key before any table is refused",
+             {"name = \"x\"", "[pack]", "id = \"x\""},
+             NdsModPackRule::ManifestSyntax, "name = \"x\""},
+            {"a repeated key in one table is refused",
+             {"[pack]", "name = \"x\"", "name = \"y\"", "id = \"x\""},
+             NdsModPackRule::DuplicateKey, "name = \"y\""},
+            {"a second [pack] table is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"",
+              "[pack]  # the second one"},
+             NdsModPackRule::DuplicateSection, "# the second one"},
+            {"a single-bracket file table is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[file]"},
+             NdsModPackRule::UnknownSection, "[file]"},
+            {"a double-bracket pack table is refused",
+             {"[[pack]]", "name = \"x\"", "id = \"x\""},
+             NdsModPackRule::UnknownSection, "[[pack]]"},
+            {"an unclosed table header is refused",
+             {"[pack", "name = \"x\"", "id = \"x\""},
+             NdsModPackRule::ManifestSyntax, "[pack"},
+            {"a stray closing bracket is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[]"},
+             NdsModPackRule::ManifestSyntax, "[]"},
+            {"text after a closing quote is refused",
+             {"[pack]", "name = \"x\" junk", "id = \"x\""},
+             NdsModPackRule::BadString, "junk"},
+        };
+        for (std::size_t index = 0; index < cases.size(); ++index) {
+            const Case& probe = cases[index];
+            fs::path mods;
+            if (!make_mods_dir(root, "case-syntax-" + std::to_string(index),
+                               &mods))
+                return fail("the fixture made a syntax case", "create failed");
+            const fs::path pack = make_pack(mods, "P");
+            if (!write_file(pack / "a.bin", "x\n") ||
+                !write_manifest(pack / "mod.toml", probe.lines))
+                return fail("the fixture wrote a syntax case", "write failed");
+
+            const NdsModPacksResult result = load_utf8(mods);
+            const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+                first_rule(result, probe.rule);
+            if (!require(diagnostic != nullptr))
+                return fail(probe.name, describe(result));
+            ok(probe.name);
+
+            const int want_line = line_of(probe.lines, probe.needle);
+            if (!require(diagnostic->line == want_line))
+                return fail("that diagnostic names the offending line",
+                            quote(std::string(probe.name) + ": got line " +
+                                  std::to_string(diagnostic->line) +
+                                  ", want " + std::to_string(want_line) +
+                                  " (" + probe.needle + ")"));
+            ok("that diagnostic names the offending line");
+
+            if (!require(diagnostic->file == to_utf8(pack / "mod.toml")))
+                return fail("that diagnostic names the manifest",
+                            quote(diagnostic->file));
+            ok("that diagnostic names the manifest");
+
+            // A structural problem rejects the pack: a half-applied pack is
+            // worse than none, and the player has to edit the file anyway.
+            if (!require(result.files.empty() &&
+                         result.summary.enabled_packs == 0))
+                return fail("a structural error rejects the whole pack",
+                            describe(result));
+            ok("a structural error rejects the whole pack");
+        }
+    }
+
+    // ---- 9. Required fields. ------------------------------------------
+    {
+        struct Case {
+            const char* name;
+            std::vector<std::string> lines;
+            // The line the diagnostic has to point at, or nullptr when the
+            // problem belongs to no line at all.
+            const char* needle;
+            // What the explanation has to say. "invalid manifest" is not
+            // something a player can act on, and a missing key has to read
+            // differently from a key that is present but empty.
+            const char* detail;
+        };
+        const std::vector<Case> cases = {
+            {"a [pack] without an id is refused",
+             {"[pack]", "name = \"x\"", "[[file]]", "id = 1",
+              "path = \"a.bin\""},
+             "[pack]", "no id"},
+            {"a [pack] without a name is refused",
+             {"[pack]", "id = \"x\""}, "[pack]", "no name"},
+            {"an empty [pack] id is refused",
+             {"[pack]", "name = \"x\"", "id = \"\""}, "[pack]", "is empty"},
+            {"an empty [pack] name is refused",
+             {"[pack]", "name = \"\"", "id = \"x\""}, "[pack]", "is empty"},
+            {"a [[file]] without a path is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[[file]]", "id = 1"},
+             "[[file]]", "no path"},
+            {"a [[file]] without an id is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[[file]]",
+              "path = \"a.bin\""},
+             "[[file]]", "no id"},
+            {"a [[music]] without a track is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[[music]]",
+              "path = \"a.bin\""},
+             "[[music]]", "no track"},
+            {"a [[music]] without a path is refused",
+             {"[pack]", "name = \"x\"", "id = \"x\"", "[[music]]",
+              "track = 1"},
+             "[[music]]", "no path"},
+            // A manifest with no [pack] table is a whole-file problem, so it
+            // names no line; everything else points at its table header.
+            {"a manifest with no [pack] table is refused",
+             {"[[file]]", "id = 1", "path = \"a.bin\""}, nullptr, "no [pack]"},
+        };
+        for (std::size_t index = 0; index < cases.size(); ++index) {
+            const Case& probe = cases[index];
+            fs::path mods;
+            if (!make_mods_dir(root, "case-fields-" + std::to_string(index),
+                               &mods))
+                return fail("the fixture made a field case", "create failed");
+            const fs::path pack = make_pack(mods, "P");
+            if (!write_file(pack / "a.bin", "x\n") ||
+                !write_manifest(pack / "mod.toml", probe.lines))
+                return fail("the fixture wrote a field case", "write failed");
+
+            const NdsModPacksResult result = load_utf8(mods);
+            const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+                first_rule(result, NdsModPackRule::MissingField);
+            if (!require(diagnostic != nullptr))
+                return fail(probe.name, describe(result));
+            ok(probe.name);
+
+            if (!require(result.summary.enabled_packs == 0))
+                return fail("a pack with a missing field is not enabled",
+                            describe(result));
+            ok("a pack with a missing field is not enabled");
+
+            // The detail has to name the field and which way it is wrong:
+            // "invalid manifest" is not something a player can act on, and an
+            // absent key has to read differently from one that is present but
+            // empty.
+            if (!require(diagnostic->detail.find(probe.detail) !=
+                         std::string::npos))
+                return fail("a missing field is explained by name",
+                            quote(std::string(probe.name) + ": got " +
+                                  quote(diagnostic->detail) + ", want '" +
+                                  probe.detail + "'"));
+            ok("a missing field is explained by name");
+
+            if (probe.needle == nullptr) {
+                // A whole-file problem: naming line 1 would accuse a line that
+                // is perfectly well formed.
+                if (!require(diagnostic->line == 0))
+                    return fail("a whole-file problem names no line",
+                                quote(std::string(probe.name) + ": got line " +
+                                      std::to_string(diagnostic->line)));
+                ok("a whole-file problem names no line");
+            } else {
+                const int want_line = line_of(probe.lines, probe.needle);
+                if (!require(diagnostic->line == want_line))
+                    return fail("a missing field names its table header",
+                                quote(std::string(probe.name) +
+                                      ": got line " +
+                                      std::to_string(diagnostic->line) +
+                                      ", want " + std::to_string(want_line)));
+                ok("a missing field names its table header");
+            }
+        }
+    }
+
+    // ---- 10. The path rules, one by one. ------------------------------
+    {
+        struct Case {
+            const char* name;
+            const char* path;
+            NdsModPackRule rule;
+        };
+        // Ordered by the rule that has to win, because a path can break
+        // several at once and the *reported* rule is what a player is told.
+        const std::vector<Case> cases = {
+            {"an empty path is refused", "", NdsModPackRule::PathEmpty},
+            {"a leading slash is refused", "/etc/passwd",
+             NdsModPackRule::PathLeadingSeparator},
+            {"a leading backslash is refused", "\\Windows\\win.ini",
+             NdsModPackRule::PathLeadingSeparator},
+            {"a UNC share is refused", "\\\\server\\share\\x.bin",
+             NdsModPackRule::PathLeadingSeparator},
+            {"a drive letter is refused", "C:\\Windows\\win.ini",
+             NdsModPackRule::PathDriveLetter},
+            {"a drive-relative path is refused", "C:x.bin",
+             NdsModPackRule::PathDriveLetter},
+            {"an alternate data stream is refused", "a.bin:stream",
+             NdsModPackRule::PathDriveLetter},
+            {"a parent traversal is refused", "../escape.bin",
+             NdsModPackRule::PathParentTraversal},
+            {"a buried parent traversal is refused", "data/../../escape.bin",
+             NdsModPackRule::PathParentTraversal},
+            {"a backslash parent traversal is refused", "data\\..\\..\\x.bin",
+             NdsModPackRule::PathParentTraversal},
+            {"a missing file is refused", "absent.bin",
+             NdsModPackRule::PathMissing},
+            {"a missing file deep in the pack is refused", "data/absent.bin",
+             NdsModPackRule::PathMissing},
+            {"a directory is refused", "sub",
+             NdsModPackRule::PathNotAFile},
+        };
+        for (std::size_t index = 0; index < cases.size(); ++index) {
+            const Case& probe = cases[index];
+            fs::path mods;
+            if (!make_mods_dir(root, "case-path-" + std::to_string(index),
+                               &mods))
+                return fail("the fixture made a path case", "create failed");
+            const fs::path pack = make_pack(mods, "P");
+            // The path is escaped for the manifest, so a case can carry a raw
+            // backslash and still reach the path rules instead of the string
+            // parser.
+            const std::string path_row =
+                "path = " + string_value(probe.path);
+            const std::vector<std::string> manifest = {
+                "[pack]", "name = \"P\"", "id = \"p\"", "",
+                "[[file]]", "id = 1", path_row,
+            };
+            if (!write_file(pack / "a.bin", "x\n") ||
+                !write_file(pack / "sub" / "inside.bin", "x\n") ||
+                !write_manifest(pack / "mod.toml", manifest))
+                return fail("the fixture wrote a path case", "write failed");
+
+            const NdsModPacksResult result = load_utf8(mods);
+            const nds_mod_packs::NdsModPackDiagnostic* diagnostic =
+                first_rule(result, probe.rule);
+            if (!require(diagnostic != nullptr))
+                return fail(probe.name, describe(result));
+            ok(probe.name);
+
+            // The entry is dead, the pack is not: one stale file name must not
+            // disable a pack that is otherwise fine.
+            if (!require(result.files.empty() &&
+                         result.summary.enabled_packs == 1))
+                return fail("a rejected path costs only its own entry",
+                            describe(result));
+            ok("a rejected path costs only its own entry");
+
+            const int want_line = line_of(manifest, path_row);
+            if (!require(diagnostic->line == want_line))
+                return fail("a rejected path names the path row",
+                            std::to_string(diagnostic->line) + " != " +
+                                std::to_string(want_line));
+            ok("a rejected path names the path row");
+        }
+
+        // The escape that only exists on disk: same lexical spelling as a legal
+        // relative path, resolved through a link out of the pack.
+        fs::path mods;
+        if (!make_mods_dir(root, "case-link", &mods))
+            return fail("the fixture made the link tree", "create failed");
+        const fs::path pack = make_pack(mods, "P");
+        const fs::path outside = root / "case-link" / "outside";
+        std::error_code error;
+        fs::create_directories(outside, error);
+        if (!write_file(outside / "escape.bin", "outside the pack\n") ||
+            !write_file(pack / "a.bin", "x\n"))
+            return fail("the fixture wrote the link tree", "write failed");
+
+        const bool linked =
+            create_directory_link(pack / "escape", outside) &&
+            path_is_link(pack / "escape");
+        const std::vector<std::string> manifest = {
+            "[pack]", "name = \"P\"", "id = \"p\"", "",
+            "[[file]]", "id = 1", "path = \"escape/escape.bin\"",
+        };
+        if (!write_manifest(pack / "mod.toml", manifest))
+            return fail("the fixture wrote the link manifest", "write failed");
+
+        const NdsModPacksResult result = load_utf8(mods);
+        // Without the link the file is simply absent, which is the same refusal
+        // for a different reason; either way no override may reach it.
+        const NdsModPackRule want =
+            linked ? NdsModPackRule::PathOutsidePack
+                   : NdsModPackRule::PathMissing;
+        if (!linked)
