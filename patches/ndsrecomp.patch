+
+    // ---- 6. Header refusals. --------------------------------------------
+    {
+        if (!require(count_rule(nds_nitrofs::nitrofs_parse(nullptr, 0),
+                                NdsNitroFsRule::ImageTooSmall) == 1))
+            return fail("a null image is refused as too small", "");
