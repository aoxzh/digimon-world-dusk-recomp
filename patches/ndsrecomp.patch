+
+    // ---- 7. Tree refusals. ----------------------------------------------
+    {
+        // A subtable that points back into the directory table itself.
+        BuiltRom broken = build_rom(basic_spec());
+        patch_directory_subtable(&broken, 1, 8u);
+        NdsNitroFs parsed = parse_of(broken);
+        if (!require(first_rule(parsed,
+                                NdsNitroFsRule::DirectoryTableTruncated) !=
+                     nullptr))
+            return fail("a subtable pointing into the directory table is "
