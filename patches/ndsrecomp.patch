+                             first > 0u && diagnostics.empty(),
+                             join(diagnostics)))
+            return code;
+    }
+
+    // ==== 3. Unlock semantics. =========================================
+    {
+        ach::NdsAchievementState state;
+        diagnostics.clear();
+        if (int code = check("the three-definition set installs",
+                             install(root, "three.json", kThreeDefinitions,
