+        broken = build_rom(basic_spec());
+        broken.image[broken.fnt_offset + subtable_of(broken, 0) + 1] = '/';
+        parsed = parse_of(broken);
+        if (!require(first_rule(parsed, NdsNitroFsRule::InvalidName) !=
