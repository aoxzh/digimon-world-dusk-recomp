+    }
+
+    {
+        // counter_ge_all: every counter listed, each at the target.
+        ach::NdsAchievementState state;
+        const std::string text = R"json({"achievements": [
+          {"id": "all-tools", "name": "All tools", "kind": "counter_ge_all",
