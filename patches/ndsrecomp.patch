diff --git a/bios/biosnds9.toml b/bios/biosnds9.toml
index 4773f27..3eea2af 100644
--- a/bios/biosnds9.toml
+++ b/bios/biosnds9.toml
@@ -254,3 +254,13 @@ format       = "abs32"
 entries_mode = "auto"  # bit 0 of each entry encodes Thumb/ARM
 name         = "swi_jump_table"
 
+
+# ── Local additions carried by this port ───
+# Interior landing pad of the RLUnComp/BIOS copy path reached by a
+# computed branch from overlay code during the intro cutscene
+# (observed as a dispatch miss: lr=0x0221AC51).
+[[entry_point]]
+addr = 0xFFFFFF70
+mode = "thumb"
+name = "rluncomp_interior_FFFFFF70"
+kind = "indirect_handler"
