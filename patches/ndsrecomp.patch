+              " boot " + std::to_string(static_cast<int>(defaults.boot_mode)) +
+              " interpolation " +
+              std::to_string(static_cast<int>(defaults.frame_interpolation)) +
+              " adaptive " +
+              std::to_string(static_cast<int>(defaults.adaptive_screens)));
