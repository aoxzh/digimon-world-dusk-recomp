+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a file of broken definitions still loads",
+                             parse_text(root, "broken.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("no broken definition is accepted",
+                             parsed.empty(), describe(parsed)))
+            return code;
+        if (int code = check("every broken definition is reported",
+                             diagnostics.size() == 9u, join(diagnostics)))
+            return code;
+        if (int code = check("a counter kind without a counter is named",
+                             diagnostics_mention(diagnostics, "no-counter"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a flag kind without a flag is named",
+                             diagnostics_mention(diagnostics, "no-flag"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an unknown kind is named",
+                             diagnostics_mention(diagnostics, "bad-kind"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a zero target is rejected",
+                             diagnostics_mention(diagnostics, "zero-target"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a negative target is rejected",
+                             diagnostics_mention(diagnostics, "neg-target"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a fractional target is rejected",
+                             diagnostics_mention(diagnostics, "float-target"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        const std::string text = R"json({"achievements": [
+          {"id": "no-list", "name": "x", "kind": "counter_ge_all",
+           "target": 1},
+          {"id": "empty-list", "name": "x", "kind": "counter_ge_all",
+           "counters": [], "target": 1},
+          {"id": "bad-entry", "name": "x", "kind": "counter_ge_all",
+           "counters": ["ok_one", 7], "target": 1},
+          {"id": "twice", "name": "x", "kind": "counter_ge_all",
+           "counters": ["same_one", "same_one"], "target": 1}]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a broken counter_ge_all file still loads",
+                             parse_text(root, "geallbad.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("no broken counter_ge_all is accepted",
+                             parsed.empty(), describe(parsed)))
+            return code;
+        if (int code = check("a missing counters array is named",
+                             diagnostics_mention(diagnostics, "no-list"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("an empty counters array is named",
+                             diagnostics_mention(diagnostics, "empty-list"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a non-string counter entry is named",
+                             diagnostics_mention(diagnostics, "bad-entry"),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a repeated counter is rejected",
+                             diagnostics_mention(diagnostics, "twice"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        // Two definitions with one id: the second would be unreachable and the
+        // progress file could not say which one an unlock meant.
+        const std::string text = R"json({"achievements": [
+          {"id": "same", "name": "First", "counter": "a_one", "target": 1},
+          {"id": "same", "name": "Second", "counter": "a_one",
+           "target": 2}]})json";
+        parsed.clear();
+        diagnostics.clear();
+        if (int code = check("a duplicate id still loads the file",
+                             parse_text(root, "dup.json", text, &parsed,
+                                        &diagnostics),
+                             join(diagnostics)))
+            return code;
+        if (int code = check("a duplicate id keeps the first definition",
+                             parsed.size() == 1u && parsed[0].name == "First",
+                             describe(parsed)))
+            return code;
+        if (int code = check("a duplicate id is reported",
+                             diagnostics_mention(diagnostics, "same"),
+                             join(diagnostics)))
+            return code;
+    }
+
+    {
+        // Damage that is not entry-level: the reader must report rather than
+        // accept a half-understood document.
+        const char* const texts[] = {
+            "{\"achievements\": []} trailing",
+            "{\"achievements\": [{\"id\": \"a\", \"name\": \"\\q\"}]}",
+            "{\"achievements\": [{\"id\": \"a\nb\", \"name\": \"x\"}]}",
+            "",
