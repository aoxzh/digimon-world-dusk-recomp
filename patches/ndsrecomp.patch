+          "the default stylus sensitivity is 20",
+          "value " + std::to_string(defaults.virtual_stylus.sensitivity));
+    check(defaults.virtual_stylus.pad_sensitivity == 100,
+          "the default pad stylus sensitivity is 100",
+          "value " + std::to_string(defaults.virtual_stylus.pad_sensitivity));
