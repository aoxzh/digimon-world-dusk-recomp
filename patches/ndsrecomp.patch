+        broken = built;
+        put_u32(&broken.image, 0x40u,
+                static_cast<std::uint32_t>(broken.image.size()) - 0x10u);
+        put_u32(&broken.image, 0x44u, 0x200u);
+        parsed = parse_of(broken);
+        if (!require(first_rule(parsed,
+                                NdsNitroFsRule::FileTableOutsideImage) !=
