+// Written per presented frame by the frontend loop, read from the same
+// thread by the `frontend_stats` debug command at the debug_pump() safe
+// point. Stays all-zero (active=0) when no frontend is running.
+NdsFrontendLiveStats g_live_stats{};
+NdsFrontendBlackBandCapture g_black_band{};
+NdsFrontendInputDebugState g_input_debug{};
+// The geometry the debug and self-test injectors translate through. It is a
+// copy of the live presentation's geometry, republished every frame: a synthetic
+// SDL event has to carry WINDOW pixels, and the window is resizable, so a
+// remembered multiplier would drift. A copy, not a pointer, because the
+// injectors are callable from the debug server's safe point.
+nds_screen_presentation::NdsPresentationGeometry g_inject_geometry{};
