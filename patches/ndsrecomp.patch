+            return fail("a '#' inside a string does not truncate the line",
+                        describe(result));
+        ok("a '#' inside a string does not truncate the line");
+    }
+
+    // ---- 7. CRLF and a byte order mark. -------------------------------
+    {
+        fs::path mods;
+        if (!make_mods_dir(root, "case-crlf", &mods))
+            return fail("the fixture made the CRLF tree", "create failed");
+        const fs::path pack = make_pack(mods, "Crlf");
