+            }
+        }
+        if (int code = check("a malformed id is rejected with a diagnostic",
+                             all_rejected, help))
+            return code;
+    }
+
+    {
+        const std::string text = R"json({"achievements": [
+          {"id": "no-counter", "name": "x", "target": 1},
+          {"id": "bad-counter", "name": "x", "counter": "In Game", "target": 1},
+          {"id": "no-flag", "name": "x", "kind": "flag"},
+          {"id": "bad-flag", "name": "x", "kind": "flag", "flag": "Saw It"},
