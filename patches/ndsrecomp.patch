+void pause_audio(const NdsAudioDevice& device, bool paused) {
+    if (!device) return;
+#if defined(NDS_HAVE_SDL3)
+    if (paused) SDL_PauseAudioStreamDevice(device.stream);
+    else SDL_ResumeAudioStreamDevice(device.stream);
+#else
+    SDL_PauseAudioDevice(device, paused ? 1 : 0);
+#endif
+}
+
+// The settings menu's volume and mute rows. Gain is applied on the output
+// stream, not inside the mixer: scaling samples before drain_audio would change
+// what the queue holds and therefore corrupt both the pacing floor and the
+// underrun count, which are the frontend's audio health signal. SDL2 has no
+// stream gain, so those rows are simply not offered there.
+bool set_audio_gain(const NdsAudioDevice& device, int volume_percent,
+                    bool enabled) {
+#if defined(NDS_HAVE_SDL3)
+    if (!device) return false;
+    const float gain = enabled
+        ? static_cast<float>(std::clamp(volume_percent, 0, 100)) / 100.0f
+        : 0.0f;
+    return SDL_SetAudioStreamGain(device.stream, gain);
+#else
+    (void)device;
+    (void)volume_percent;
+    (void)enabled;
+    return false;
+#endif
+}
