+            // held vs 161.3/s with V-Sync already off). Restore the player's
+            // own choice on release rather than assuming it was on.
+            for (int screen = 0; screen < 2; ++screen) {
+                if (!presentation.renderers[screen]) continue;
+                if (screen == 1 && !presentation.separate) break;
+                set_render_vsync(
+                    presentation.renderers[screen],
+                    !turbo_active && runtime_menu_state.snapshot.vsync != 0);
